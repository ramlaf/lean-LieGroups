import LieGroups.OneParameterSubgroup

/-!
# The Lie exponential: construction and identities along lines

Define the exponential by evaluating the unique one-parameter subgroup at time one.
Time rescaling identifies `lieExp (t • v)` with `oneParameterCurve v t`.
This proves smoothness along each line and its initial velocity, but does not yet prove
smoothness of the full exponential map or its total differential at zero.

References: Lee, *Introduction to Smooth Manifolds*, second edition (2013),
Proposition 20.5 and Proposition 20.8(b–d), pp. 518–519.

AI-assistance disclosure: generated by OpenAI Codex on 2026-09-28.
-/

open scoped ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [CompleteSpace E] [BoundarylessManifold I G] [T2Space G]

/-- The exponential of a Lie-algebra element is its one-parameter subgroup at time one. -/
noncomputable def lieExp (v : GroupLieAlgebra I G) : G := oneParameterCurve v 1

/-- The exponential takes each line through zero to the corresponding one-parameter subgroup. -/
theorem lieExp_smul (v : GroupLieAlgebra I G) (t : ℝ) :
    lieExp (t • v) = oneParameterCurve v t := by
  simp only [lieExp, oneParameterCurve_smul, one_mul]

/-- The exponential maps zero to the group identity. -/
@[simp] theorem lieExp_zero : lieExp (0 : GroupLieAlgebra I G) = 1 :=
  oneParameterCurve_zero_velocity 1

/-- Exponentials on the same line obey the additive time law. -/
theorem lieExp_add_smul (v : GroupLieAlgebra I G) (s t : ℝ) :
    lieExp ((s + t) • v) = lieExp (s • v) * lieExp (t • v) := by
  simp only [lieExp_smul, oneParameterCurve_add]

/-- Negating the Lie-algebra element inverts its exponential. -/
@[simp] theorem lieExp_neg (v : GroupLieAlgebra I G) : lieExp (-v) = (lieExp v)⁻¹ := by
  simpa only [neg_one_smul, lieExp, oneParameterCurve_neg] using lieExp_smul v (-1)

/-- Integer multiples exponentiate to integer powers. -/
theorem lieExp_int_smul (v : GroupLieAlgebra I G) (k : ℤ) :
    lieExp ((k : ℝ) • v) = (lieExp v) ^ k := by
  rw [lieExp_smul]
  simpa only [← ofAdd_zsmul, zsmul_eq_mul, mul_one, oneParameterSubgroup_apply, lieExp] using
    map_zpow (oneParameterSubgroup v) (Multiplicative.ofAdd (1 : ℝ)) k

/-- Each line through zero exponentiates to a smooth curve. -/
theorem lieExp_smul_contMDiff (v : GroupLieAlgebra I G) :
    ContMDiff 𝓘(ℝ, ℝ) I ∞ (fun t : ℝ => lieExp (t • v)) := by
  simpa only [lieExp_smul] using oneParameterCurve_contMDiff v

set_option backward.isDefEq.respectTransparency false in
/-- The derivative of `t ↦ exp (t v)` at zero is `v`, in the tangent space at the identity.
This is a derivative of a curve, not yet a statement about the full differential of `lieExp`. -/
theorem lieExp_smul_hasMFDerivAt_zero (v : GroupLieAlgebra I G) :
    HasMFDerivAt 𝓘(ℝ, ℝ) I (fun t : ℝ => lieExp (t • v)) 0
      ((1 : ℝ →L[ℝ] ℝ).smulRight
        (tangentSpaceCast I (1 : G) (lieExp ((0 : ℝ) • v)) v)) := by
  have h := oneParameterCurve_hasMFDerivAt_zero v
  have heq : (fun t : ℝ => lieExp (t • v)) = oneParameterCurve v :=
    funext (lieExp_smul v)
  rw [← heq] at h
  exact h

end LieGroups

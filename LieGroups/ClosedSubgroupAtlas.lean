import LieGroups.ClosedSubgroupChart
import LieGroups.ImmersedLieSubgroup
import Mathlib.Geometry.Manifold.ContMDiff.Atlas
import Mathlib.Topology.Algebra.Group.SubmonoidClosure
import Mathlib.Topology.Bases

/-!
# The embedded subgroup atlas from a local slice

Left translates of a local subgroup slice construct a smooth atlas on the
subgroup's existing subspace topology. Smoothness into this atlas is exactly
smoothness of the ambient inclusion.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups.ClosedSubgroupChart

variable {E P Q : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {K : Subgroup G} (C : ClosedSubgroupChart I K P Q)

private def translation (a : K) : Diffeomorph I I G G ∞ where
  toEquiv := Equiv.mulLeft (a : G)⁻¹
  contMDiff_toFun := contMDiff_mul_left
  contMDiff_invFun := contMDiff_mul_left

/-- The ambient slice chart translated to a subgroup element. -/
def ambientChart (a : K) : PartialDiffeomorph I 𝓘(ℝ, P × Q) G (P × Q) ∞ :=
  (translation (I := I) a).toPartialDiffeomorph.trans C.chart

theorem mem_ambientChart_source (a : K) : (a : G) ∈ (C.ambientChart a).source := by
  change (a : G) ∈ univ ∧ (a : G)⁻¹ * a ∈ C.chart.source
  simpa using C.one_mem_source

theorem ambientChart_mem_iff (a : K) (g : G) (hg : g ∈ (C.ambientChart a).source) :
    g ∈ K ↔ ((C.ambientChart a) g).2 = 0 := by
  change g ∈ K ↔ (C.chart ((a : G)⁻¹ * g)).2 = 0
  have h := C.mem_iff ((a : G)⁻¹ * g) hg.2
  rw [← h]
  exact (K.mul_mem_cancel_left (K.inv_mem a.property)).symm

theorem ambientChart_symm_mem (a : K) (u : P)
    (hu : (u, (0 : Q)) ∈ (C.ambientChart a).target) :
    (C.ambientChart a).symm (u, 0) ∈ K := by
  apply (C.ambientChart_mem_iff a _ ((C.ambientChart a).map_target hu)).mpr
  rw [(C.ambientChart a).right_inv hu]

/-- The same subgroup, with its original topology and the atlas constructed below. -/
def Space (_C : ClosedSubgroupChart I K P Q) : Type _ := K

instance : Group C.Space := inferInstanceAs (Group K)
instance : TopologicalSpace C.Space := inferInstanceAs (TopologicalSpace K)
instance : IsTopologicalGroup C.Space := by
  let := topologicalGroup_of_lieGroup (I := I) (n := ∞) (G := G)
  exact inferInstanceAs (IsTopologicalGroup K)
instance [T2Space G] : T2Space C.Space := inferInstanceAs (T2Space K)
instance [SecondCountableTopology G] : SecondCountableTopology C.Space :=
  TopologicalSpace.Subtype.secondCountableTopology (K : Set G)

/-- Inclusion into the ambient group, retaining the subspace topology. -/
def inclusion : C.Space →* G := K.subtype

omit [LieGroup I ∞ G] in
theorem isEmbedding_inclusion : Topology.IsEmbedding C.inclusion :=
  Topology.IsEmbedding.subtypeVal

private def chartInv (a : K) (u : P) : C.Space := by
  classical
  exact if h : (u, (0 : Q)) ∈ (C.ambientChart a).target then
    ⟨(C.ambientChart a).symm (u, 0), C.ambientChart_symm_mem a u h⟩ else 1

set_option backward.isDefEq.respectTransparency false in
private theorem inclusion_chartInv (a : K) {u : P}
    (hu : (u, (0 : Q)) ∈ (C.ambientChart a).target) :
    C.inclusion (C.chartInv a u) = (C.ambientChart a).symm (u, 0) := by
  unfold chartInv
  rw [dite_eq_left hu]
  rfl

/-- A genuine open chart for the subspace topology. -/
def subgroupChart (a : K) : OpenPartialHomeomorph C.Space P where
  toFun x := ((C.ambientChart a) (C.inclusion x)).1
  invFun := C.chartInv a
  source := C.inclusion ⁻¹' (C.ambientChart a).source
  target := {u | (u, (0 : Q)) ∈ (C.ambientChart a).target}
  map_source' x hx := by
    have hz := (C.ambientChart_mem_iff a _ hx).mp x.property
    have hp : (((C.ambientChart a) (C.inclusion x)).1, (0 : Q)) =
        (C.ambientChart a) (C.inclusion x) := Prod.ext rfl hz.symm
    change (((C.ambientChart a) (C.inclusion x)).1, (0 : Q)) ∈ (C.ambientChart a).target
    rw [hp]
    exact (C.ambientChart a).map_source hx
  map_target' u hu := by
    change C.inclusion (C.chartInv a u) ∈ (C.ambientChart a).source
    rw [C.inclusion_chartInv a hu]
    exact (C.ambientChart a).map_target hu
  left_inv' x hx := by
    have hz := (C.ambientChart_mem_iff a _ hx).mp x.property
    have hp : (((C.ambientChart a) (C.inclusion x)).1, (0 : Q)) =
        (C.ambientChart a) (C.inclusion x) := Prod.ext rfl hz.symm
    have hu : (((C.ambientChart a) (C.inclusion x)).1, (0 : Q)) ∈
        (C.ambientChart a).target := by rw [hp]; exact (C.ambientChart a).map_source hx
    apply Subtype.ext
    change C.inclusion (C.chartInv a _) = C.inclusion x
    rw [C.inclusion_chartInv a hu, hp]
    exact (C.ambientChart a).left_inv hx
  right_inv' u hu := by
    rw [C.inclusion_chartInv a hu]
    exact congrArg Prod.fst ((C.ambientChart a).right_inv hu)
  open_source := (C.ambientChart a).open_source.preimage C.isEmbedding_inclusion.continuous
  open_target := (C.ambientChart a).open_target.preimage (continuous_id.prodMk continuous_const)
  continuousOn_toFun := continuous_fst.comp_continuousOn
    ((C.ambientChart a).contMDiffOn_toFun.continuousOn.comp
      C.isEmbedding_inclusion.continuous.continuousOn
      (fun _ hx => hx))
  continuousOn_invFun := by
    apply C.isEmbedding_inclusion.isInducing.continuousOn_iff.mpr
    apply ((C.ambientChart a).contMDiffOn_invFun.continuousOn.comp
      (continuous_id.prodMk continuous_const).continuousOn (fun _ hu => hu)).congr
    intro u hu
    exact C.inclusion_chartInv a hu

@[simp] theorem subgroupChart_apply (a : K) (x : C.Space) :
    C.subgroupChart a x = ((C.ambientChart a) (C.inclusion x)).1 := rfl

theorem inclusion_subgroupChart_symm (a : K) {u : P} (hu : u ∈ (C.subgroupChart a).target) :
    C.inclusion ((C.subgroupChart a).symm u) = (C.ambientChart a).symm (u, 0) :=
  C.inclusion_chartInv a hu

instance : ChartedSpace P C.Space where
  atlas := range C.subgroupChart
  chartAt := C.subgroupChart
  mem_chart_source x := C.mem_ambientChart_source x
  chart_mem_atlas x := ⟨x, rfl⟩

theorem subgroupChart_mem_atlas (a : K) : C.subgroupChart a ∈ atlas P C.Space := ⟨a, rfl⟩

private theorem contMDiffAt_inclusion_chartInv (a : K) {u : P}
    (hu : u ∈ (C.subgroupChart a).target) :
    ContMDiffAt 𝓘(ℝ, P) I ∞ (C.inclusion ∘ (C.subgroupChart a).symm) u := by
  have h := ((C.ambientChart a).contMDiffOn_invFun.contMDiffAt
    ((C.ambientChart a).open_target.mem_nhds hu)).comp u
      ((contDiff_id.prodMk contDiff_const).contMDiff.contMDiffAt :
        ContMDiffAt 𝓘(ℝ, P) 𝓘(ℝ, P × Q) ∞ (fun v : P => (v, (0 : Q))) u)
  apply h.congr_of_eventuallyEq
  filter_upwards [(C.subgroupChart a).open_target.mem_nhds hu] with v hv
  exact C.inclusion_subgroupChart_symm a hv

instance : IsManifold 𝓘(ℝ, P) ∞ C.Space := by
  apply isManifold_of_contDiffOn
  rintro e e' ⟨a, rfl⟩ ⟨b, rfl⟩
  simp only [modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm,
    Function.comp_id, Function.id_comp, Set.range_id, Set.preimage_id, Set.inter_univ]
  intro u hu
  have h := ((C.ambientChart b).contMDiffOn_toFun.contMDiffAt
    ((C.ambientChart b).open_source.mem_nhds hu.2)).comp u
      (C.contMDiffAt_inclusion_chartInv a hu.1)
  exact ((contDiff_fst.contMDiff.contMDiffAt.comp u h).contDiffAt).contDiffWithinAt

/-- Inclusion of the constructed manifold is smooth. -/
theorem contMDiff_inclusion : ContMDiff 𝓘(ℝ, P) I ∞ C.inclusion := by
  intro x
  let c := C.subgroupChart x
  have hx : x ∈ c.source := C.mem_ambientChart_source x
  have hc := contMDiffAt_of_mem_maximalAtlas (I := 𝓘(ℝ, P)) (n := ∞)
    (IsManifold.subset_maximalAtlas (C.subgroupChart_mem_atlas x)) hx
  have hi := C.contMDiffAt_inclusion_chartInv x (c.map_source hx)
  apply (hi.comp x hc).congr_of_eventuallyEq
  filter_upwards [c.open_source.mem_nhds hx] with y hy
  exact congrArg C.inclusion (c.left_inv hy).symm

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M]

/-- The subgroup atlas is initial for smooth maps: an ambient smooth map taking
values in the subgroup is smooth as a map into the subgroup. -/
theorem contMDiffAt_of_inclusion {f : M → C.Space} {x : M}
    (hf : ContMDiffAt J I ∞ (C.inclusion ∘ f) x) :
    ContMDiffAt J 𝓘(ℝ, P) ∞ f x := by
  let a : K := f x
  let c := C.subgroupChart a
  have hx : f x ∈ c.source := C.mem_ambientChart_source a
  have hfc : ContinuousAt f x :=
    C.isEmbedding_inclusion.isInducing.continuousAt_iff.mpr hf.continuousAt
  have hc : ContMDiffAt J 𝓘(ℝ, P) ∞ (c ∘ f) x := by
    have h := ((C.ambientChart a).contMDiffOn_toFun.contMDiffAt
      ((C.ambientChart a).open_source.mem_nhds hx)).comp x hf
    exact contDiff_fst.contMDiff.contMDiffAt.comp x h
  have hi := contMDiffAt_symm_of_mem_maximalAtlas (I := 𝓘(ℝ, P)) (n := ∞)
    (IsManifold.subset_maximalAtlas (C.subgroupChart_mem_atlas a)) (c.map_source hx)
  apply (hi.comp x hc).congr_of_eventuallyEq
  filter_upwards [hfc.preimage_mem_nhds (c.open_source.mem_nhds hx)] with y hy
  exact (c.left_inv hy).symm

theorem contMDiff_iff_inclusion {f : M → C.Space} :
    ContMDiff J 𝓘(ℝ, P) ∞ f ↔ ContMDiff J I ∞ (C.inclusion ∘ f) :=
  ⟨C.contMDiff_inclusion.comp, fun h x => C.contMDiffAt_of_inclusion (h x)⟩

/-- Smooth multiplication and inversion follow from their ambient counterparts. -/
instance : LieGroup 𝓘(ℝ, P) ∞ C.Space where
  contMDiff_mul := C.contMDiff_iff_inclusion.mpr
    ((C.contMDiff_inclusion.comp contMDiff_fst).mul
      (C.contMDiff_inclusion.comp contMDiff_snd))
  contMDiff_inv := C.contMDiff_iff_inclusion.mpr C.contMDiff_inclusion.inv

private def modelDiffeomorph [I.Boundaryless] : Diffeomorph I 𝓘(ℝ, E) H E ∞ where
  toEquiv := I.toHomeomorph.toEquiv
  contMDiff_toFun := I.contMDiff
  contMDiff_invFun := by
    have h := I.contMDiffOn_symm (n := ∞)
    rw [I.range_eq_univ] at h
    exact contMDiffOn_univ.mp h

private def immersionChart [I.Boundaryless] (L : (P × Q) ≃L[ℝ] E) (a : K) :
    PartialDiffeomorph I I G H ∞ :=
  (C.ambientChart a).trans
    (L.toDiffeomorph.trans (modelDiffeomorph (I := I)).symm).toPartialDiffeomorph

/-- The constructed inclusion has the actual immersion normal form. -/
theorem isImmersionOfComplement_inclusion [I.Boundaryless] (L : (P × Q) ≃L[ℝ] E) :
    _root_.Manifold.IsImmersionOfComplement Q 𝓘(ℝ, P) I ∞ C.inclusion := by
  intro x
  let c := C.subgroupChart x
  let d := C.immersionChart L x
  have hx : x ∈ c.source := C.mem_ambientChart_source x
  have hd : C.inclusion x ∈ d.source := ⟨hx, mem_univ _⟩
  refine _root_.Manifold.IsImmersionAtOfComplement.mk_of_charts L c
    d.toOpenPartialHomeomorph hx hd
    (IsManifold.subset_maximalAtlas (C.subgroupChart_mem_atlas x))
    (d.toOpenPartialHomeomorph.mem_maximalAtlas_of_contMDiffOn
      d.contMDiffOn_toFun d.contMDiffOn_invFun) ?_ ?_
  · intro y hy
    exact ⟨hy, mem_univ _⟩
  · intro u hu
    have hu' : u ∈ c.target := by simpa only [mfld_simps] using hu
    change I (I.toHomeomorph.symm
      (L ((C.ambientChart x) (C.inclusion (c.symm u))))) = L (u, 0)
    calc
      _ = L ((C.ambientChart x) (C.inclusion (c.symm u))) :=
        I.toHomeomorph.apply_symm_apply _
      _ = L (u, 0) := by
        rw [C.inclusion_subgroupChart_symm x hu']
        exact congrArg L ((C.ambientChart x).right_inv hu')

/-- The ambient chart identifies the horizontal and transverse models with the
ambient model, so no dimension equivalence is an extra hypothesis. -/
theorem isImmersion_inclusion [I.Boundaryless] :
    _root_.Manifold.IsImmersion 𝓘(ℝ, P) I ∞ C.inclusion := by
  have hc : IsLocalDiffeomorphAt I 𝓘(ℝ, P × Q) ∞ C.chart (1 : G) :=
    ⟨C.chart, C.one_mem_source, Set.eqOn_refl _ _⟩
  let L : (P × Q) ≃L[ℝ] E := (hc.mfderivToContinuousLinearEquiv (by simp)).symm
  exact (C.isImmersionOfComplement_inclusion L).isImmersion

/-- The original subgroup, with its constructed Lie group structure, is embedded. -/
def embeddedLieSubgroup [I.Boundaryless] : EmbeddedLieSubgroup I G 𝓘(ℝ, P) C.Space where
  toMonoidHom := C.inclusion
  injective := Subtype.val_injective
  isImmersion := C.isImmersion_inclusion
  isEmbedding := C.isEmbedding_inclusion

end LieGroups.ClosedSubgroupChart

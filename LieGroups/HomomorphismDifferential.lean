import LieGroups.Exponential

/-!
# Differentials of smooth group homomorphisms

The differential at the identity is a continuous linear map between the existing Mathlib
group Lie algebras. It transports left-invariant fields and one-parameter subgroups,
and therefore commutes with the Lie exponential. Applied to conjugation, it defines
the adjoint linear map and proves its compatibility with exponentials and smooth
homomorphisms.

`mulInvariantVectorField` uses left translation, so the conjugation convention here is
`g * x * g⁻¹`. Mathlib's bracket is the bracket of these left-invariant fields at
the identity; in coordinates its sign is `D W(V) - D V(W)`. Bracket preservation
and the bundled Lie algebra maps are provided in `HomomorphismLieAlgebra.lean`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-05; updated on 2026-10-16.
-/

open scoped ContDiff Manifold
namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]

/-- The tangent map of a group homomorphism at the identity. Its useful compatibility
properties require the homomorphism to be smooth. -/
noncomputable def homLieDifferential (f : G →* K) :
    GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra J K :=
  mfderiv I J (fun g => f g) (1 : G)

set_option backward.isDefEq.respectTransparency false in
/-- A smooth homomorphism relates the corresponding left-invariant vector fields. -/
theorem homLieDifferential_mulInvariantVectorField (f : G →* K)
    (hf : ContMDiff I J ∞ (fun g => f g)) (v : GroupLieAlgebra I G) (g : G) :
    mfderiv I J (fun x => f x) g (mulInvariantVectorField v g) =
      mulInvariantVectorField (homLieDifferential (I := I) (J := J) f v) (f g) := by
  have hf' : MDifferentiable I J (fun x => f x) := hf.mdifferentiable (by simp)
  have hleft : MDifferentiableAt I I (fun x => g * x) 1 := mdifferentiableAt_mul_left
  have hleft' : MDifferentiableAt J J (fun x => f g * x) 1 :=
    mdifferentiableAt_mul_left
  have h₁ := mfderiv_comp_apply_of_eq (I := I) (I' := I) (I'' := J)
    (x := (1 : G)) (f := fun x => g * x) (g := fun x => f x)
    (hf' g) hleft (by simp) v
  have h₂ := mfderiv_comp_apply_of_eq (I := I) (I' := J) (I'' := J)
    (x := (1 : G)) (f := fun x => f x) (g := fun x => f g * x)
    hleft' (hf' 1) (map_one f) v
  have hcomp : (fun x : G => f (g * x)) =
      (fun x : G => f g * f x) := by
    funext x
    exact map_mul f g x
  simp only [mulInvariantVectorField, homLieDifferential] at *
  change (mfderiv I J (fun x => f (g * x)) 1) v = _ at h₁
  change (mfderiv I J (fun x => f g * f x) 1) v = _ at h₂
  rw [hcomp] at h₁
  exact h₁.symm.trans h₂

omit [LieGroup I ∞ G] in
/-- The identity homomorphism has identity differential. -/
theorem homLieDifferential_id :
    homLieDifferential (I := I) (J := I) (MonoidHom.id G) =
      ContinuousLinearMap.id ℝ (GroupLieAlgebra I G) := by
  ext v
  change (mfderiv I I (@id G) 1) v = v
  rw [mfderiv_id]
  rfl

variable {D : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
  {H'' : Type*} [TopologicalSpace H''] {L : ModelWithCorners ℝ D H''}
  {Q : Type*} [Group Q] [TopologicalSpace Q] [ChartedSpace H'' Q] [LieGroup L ∞ Q]

omit [LieGroup I ∞ G] [LieGroup J ∞ K] [LieGroup L ∞ Q] in
/-- Differentiation at the identity respects composition of smooth homomorphisms. -/
theorem homLieDifferential_comp (f : G →* K) (g : K →* Q)
    (hf : ContMDiff I J ∞ (fun x => f x))
    (hg : ContMDiff J L ∞ (fun y => g y)) :
    homLieDifferential (I := I) (J := L) (g.comp f) =
      (homLieDifferential (I := J) (J := L) g).comp
        (homLieDifferential (I := I) (J := J) f) := by
  apply ContinuousLinearMap.ext
  intro v
  have h := mfderiv_comp_apply_of_eq (I := I) (I' := J) (I'' := L)
    (x := (1 : G)) (f := fun x => f x) (g := fun y => g y)
    (hg.mdifferentiable (by simp) 1)
    (hf.mdifferentiable (by simp) 1) (map_one f) v
  exact h

omit [LieGroup I ∞ G] [LieGroup J ∞ K] in
/-- The differential of a smooth group equivalence has inverse the differential of
the inverse equivalence. -/
theorem homLieDifferential_symm_comp (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y)) :
    (homLieDifferential (I := J) (J := I) e.symm.toMonoidHom).comp
      (homLieDifferential (I := I) (J := J) e.toMonoidHom) =
        ContinuousLinearMap.id ℝ (GroupLieAlgebra I G) := by
  rw [← homLieDifferential_comp e.toMonoidHom e.symm.toMonoidHom he hi]
  have hcomp : e.symm.toMonoidHom.comp e.toMonoidHom = MonoidHom.id G := by
    ext x
    exact e.symm_apply_apply x
  rw [hcomp, homLieDifferential_id]

/-- The identity differential of a group equivalence smooth in both directions,
bundled as a continuous linear equivalence. -/
noncomputable def equivLieDifferential (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y)) :
    GroupLieAlgebra I G ≃L[ℝ] GroupLieAlgebra J K :=
  ContinuousLinearEquiv.equivOfInverse'
    (homLieDifferential (I := I) (J := J) e.toMonoidHom)
    (homLieDifferential (I := J) (J := I) e.symm.toMonoidHom)
    (homLieDifferential_symm_comp e.symm hi he)
    (homLieDifferential_symm_comp e he hi)

omit [LieGroup I ∞ G] [LieGroup J ∞ K] in
@[simp] theorem equivLieDifferential_apply (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y)) (v : GroupLieAlgebra I G) :
    equivLieDifferential e he hi v = homLieDifferential (I := I) (J := J) e.toMonoidHom v :=
  rfl

omit [LieGroup I ∞ G] [LieGroup J ∞ K] in
@[simp] theorem equivLieDifferential_symm (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y)) :
    (equivLieDifferential e he hi).symm = equivLieDifferential e.symm hi he := by
  ext v
  rfl

/-- Conjugation by a fixed group element is smooth. -/
theorem contMDiff_conjugation (g : G) :
    ContMDiff I I ∞ (fun x : G => (MulAut.conj g) x) := by
  have hleft : ContMDiff I I ∞ (fun x : G => g * x) := contMDiff_mul_left
  have hright : ContMDiff I I ∞ (fun x : G => x * g⁻¹) := contMDiff_mul_right
  simpa only [Function.comp_def, MulAut.conj_apply] using hright.comp hleft

/-- The adjoint linear map is the differential of conjugation by `g`. -/
noncomputable def lieAdjoint (g : G) :
    GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra I G :=
  homLieDifferential (I := I) (J := I) (MulAut.conj g).toMonoidHom

omit [LieGroup I ∞ G] in
/-- The identity acts trivially on the Lie algebra. -/
theorem lieAdjoint_one : lieAdjoint (I := I) (1 : G) =
    ContinuousLinearMap.id ℝ (GroupLieAlgebra I G) := by
  have hc : (MulAut.conj (1 : G)).toMonoidHom = MonoidHom.id G := by
    ext x
    simp
  rw [lieAdjoint, hc, homLieDifferential_id]

/-- The adjoint maps form a representation, with the left-conjugation convention. -/
theorem lieAdjoint_mul (g h : G) :
    lieAdjoint (I := I) (g * h) =
      (lieAdjoint (I := I) g).comp (lieAdjoint (I := I) h) := by
  have hc : (MulAut.conj (g * h)).toMonoidHom =
      ((MulAut.conj g).toMonoidHom).comp (MulAut.conj h).toMonoidHom := by
    ext x
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    group
  rw [lieAdjoint, hc]
  exact homLieDifferential_comp (I := I) (J := I) (L := I)
    (MulAut.conj h).toMonoidHom (MulAut.conj g).toMonoidHom
    (contMDiff_conjugation (I := I) h) (contMDiff_conjugation (I := I) g)

/-- The differential of a smooth homomorphism intertwines conjugation adjoints. -/
theorem homLieDifferential_adjoint (f : G →* K)
    (hf : ContMDiff I J ∞ (fun x => f x)) (g : G) (v : GroupLieAlgebra I G) :
    homLieDifferential (I := I) (J := J) f (lieAdjoint (I := I) g v) =
      lieAdjoint (I := J) (f g) (homLieDifferential (I := I) (J := J) f v) := by
  let cG := (MulAut.conj g).toMonoidHom
  let cK := (MulAut.conj (f g)).toMonoidHom
  have hcomm : f.comp cG = cK.comp f := by
    ext x
    simp [cG, cK, MulAut.conj_apply]
  have h₁ := homLieDifferential_comp (I := I) (J := I) (L := J)
    cG f (contMDiff_conjugation (I := I) g) hf
  have h₂ := homLieDifferential_comp (I := I) (J := J) (L := J)
    f cK hf (contMDiff_conjugation (I := J) (f g))
  rw [hcomm] at h₁
  have h := congrArg (fun T : GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra J K => T v)
    (h₁.symm.trans h₂)
  simpa only [ContinuousLinearMap.comp_apply, lieAdjoint, cG, cK] using h

variable [CompleteSpace E] [BoundarylessManifold I G] [T2Space G]
  [CompleteSpace F] [BoundarylessManifold J K] [T2Space K]

set_option backward.isDefEq.respectTransparency false in
/-- Smooth homomorphisms carry one-parameter subgroups to those determined by their
identity differentials. -/
theorem oneParameterCurve_map (f : G →* K)
    (hf : ContMDiff I J ∞ (fun g => f g)) (v : GroupLieAlgebra I G) (t : ℝ) :
    f (oneParameterCurve v t) =
      oneParameterCurve (homLieDifferential (I := I) (J := J) f v) t := by
  have hf' : MDifferentiable I J (fun x => f x) := hf.mdifferentiable (by simp)
  have hcurve : IsMIntegralCurve (fun t => f (oneParameterCurve v t))
      (mulInvariantVectorField (homLieDifferential (I := I) (J := J) f v)) := by
    intro s
    have hc := (hf' (oneParameterCurve v s)).hasMFDerivAt.comp s
      (oneParameterCurve_isMIntegralCurve v s)
    convert hc using 1
    · rfl
    apply ContinuousLinearMap.ext
    intro r
    simp [ContinuousLinearMap.comp_apply,
      homLieDifferential_mulInvariantVectorField f hf v (oneParameterCurve v s)]
  have heq := oneParameterCurve_unique hcurve (by simp)
  exact congrFun heq t

/-- The Lie exponential is natural under smooth group homomorphisms. -/
theorem lieExp_map (f : G →* K)
    (hf : ContMDiff I J ∞ (fun g => f g)) (v : GroupLieAlgebra I G) :
    f (lieExp v) = lieExp (homLieDifferential (I := I) (J := J) f v) := by
  exact oneParameterCurve_map f hf v 1

/-- Exponentiating the adjoint action agrees with conjugating the exponential. -/
theorem lieExp_adjoint (g : G) (v : GroupLieAlgebra I G) :
    lieExp (lieAdjoint (I := I) g v) = g * lieExp v * g⁻¹ := by
  have h := lieExp_map (I := I) (J := I)
    (MulAut.conj g).toMonoidHom (contMDiff_conjugation (I := I) g) v
  simpa only [lieAdjoint, MulAut.conj_apply, MulEquiv.coe_toMonoidHom] using h.symm

end LieGroups

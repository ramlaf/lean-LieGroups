import LieGroups.HomomorphismDifferential
import LieGroups.Manifold.RelatedVectorFields

/-!
# Lie algebra maps induced by smooth group homomorphisms

Naturality of the vector-field bracket shows that `homLieDifferential` preserves
Mathlib's bracket of left-invariant fields. We bundle it as `homLieHom`, and bundle
the differential of an equivalence smooth in both directions as `equivLieEquiv`.
Conjugation therefore acts by Lie algebra automorphisms, `lieAdjointEquiv`.

The statement anchors are Lee, *Introduction to Smooth Manifolds*, second edition
(2013), Theorem 8.44 and Proposition 8.45, pp. 195–196. The results here allow
complete real model spaces of different dimensions. They do not construct a group
homomorphism integrating a prescribed Lie algebra homomorphism.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-16.
-/

open scoped ContDiff Manifold

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]

set_option backward.isDefEq.respectTransparency false in
/-- The identity differential of a smooth group homomorphism preserves Lie brackets. -/
theorem homLieDifferential_map_lie (f : G →* K)
    (hf : ContMDiff I J ∞ (fun g => f g)) (v w : GroupLieAlgebra I G) :
    homLieDifferential (I := I) (J := J) f ⁅v, w⁆ =
      ⁅homLieDifferential (I := I) (J := J) f v,
        homLieDifferential (I := I) (J := J) f w⁆ := by
  have h := Manifold.mfderiv_mlieBracket_of_related hf
    (contMDiff_infty_mulInvariantVectorField v)
    (contMDiff_infty_mulInvariantVectorField w)
    (contMDiff_infty_mulInvariantVectorField (homLieDifferential (I := I) (J := J) f v))
    (contMDiff_infty_mulInvariantVectorField (homLieDifferential (I := I) (J := J) f w))
    (homLieDifferential_mulInvariantVectorField f hf v)
    (homLieDifferential_mulInvariantVectorField f hf w) (1 : G)
  convert! h using 1
  rw [GroupLieAlgebra.bracket_def, f.map_one]

/-- Differentiation at the identity, bundled as a homomorphism of Mathlib Lie algebras. -/
noncomputable def homLieHom (f : G →* K) (hf : ContMDiff I J ∞ (fun g => f g)) :
    GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J K :=
  { (homLieDifferential (I := I) (J := J) f).toLinearMap with
    map_lie' := homLieDifferential_map_lie f hf _ _ }

@[simp] theorem homLieHom_apply (f : G →* K)
    (hf : ContMDiff I J ∞ (fun g => f g)) (v : GroupLieAlgebra I G) :
    homLieHom f hf v = homLieDifferential (I := I) (J := J) f v := rfl

/-- The bundled differential respects identity homomorphisms. -/
@[simp] theorem homLieHom_id :
    homLieHom (I := I) (J := I) (MonoidHom.id G) contMDiff_id = LieHom.id := by
  ext v
  exact congrArg (fun T : GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra I G => T v)
    homLieDifferential_id

variable {D : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D] [CompleteSpace D]
  {H'' : Type*} [TopologicalSpace H''] {L : ModelWithCorners ℝ D H''}
  {Q : Type*} [Group Q] [TopologicalSpace Q] [ChartedSpace H'' Q] [LieGroup L ∞ Q]

/-- The bundled differential respects composition. -/
theorem homLieHom_comp (f : G →* K) (g : K →* Q)
    (hf : ContMDiff I J ∞ (fun x => f x))
    (hg : ContMDiff J L ∞ (fun y => g y)) :
    homLieHom (g.comp f) (hg.comp hf) = (homLieHom g hg).comp (homLieHom f hf) := by
  ext v
  exact congrArg (fun T : GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra L Q => T v)
    (homLieDifferential_comp f g hf hg)

/-- A group equivalence smooth in both directions induces a Lie algebra equivalence. -/
noncomputable def equivLieEquiv (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y)) :
    GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ GroupLieAlgebra J K :=
  { (equivLieDifferential e he hi).toLinearEquiv with
    map_lie' := homLieDifferential_map_lie e.toMonoidHom he _ _ }

@[simp] theorem equivLieEquiv_apply (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y)) (v : GroupLieAlgebra I G) :
    equivLieEquiv e he hi v = homLieDifferential (I := I) (J := J) e.toMonoidHom v := rfl

/-- Differentiating the identity group equivalence gives the identity Lie equivalence. -/
@[simp] theorem equivLieEquiv_refl :
    equivLieEquiv (I := I) (J := I) (MulEquiv.refl G) contMDiff_id contMDiff_id =
      LieEquiv.refl := by
  ext v
  exact congrArg (fun T : GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra I G => T v)
    homLieDifferential_id

/-- Differentiation respects composition of smooth group equivalences. -/
theorem equivLieEquiv_trans (e : G ≃* K) (f : K ≃* Q)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hei : ContMDiff J I ∞ (fun y => e.symm y))
    (hf : ContMDiff J L ∞ (fun y => f y))
    (hfi : ContMDiff L J ∞ (fun z => f.symm z)) :
    equivLieEquiv (e.trans f) (hf.comp he) (hei.comp hfi) =
      (equivLieEquiv e he hei).trans (equivLieEquiv f hf hfi) := by
  ext v
  exact congrArg (fun T : GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra L Q => T v)
    (homLieDifferential_comp e.toMonoidHom f.toMonoidHom he hf)

@[simp] theorem equivLieEquiv_symm (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y)) :
    (equivLieEquiv e he hi).symm = equivLieEquiv e.symm hi he := by
  ext v
  rfl

section Coordinates

variable {A : Type*} [LieRing A] [LieAlgebra ℝ A]
  {B : Type*} [LieRing B] [LieAlgebra ℝ B]

/-- Express the differentiated group equivalence in supplied Lie algebra coordinates. -/
noncomputable def coordinateLieEquiv (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y))
    (iG : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ A) (iK : GroupLieAlgebra J K ≃ₗ⁅ℝ⁆ B) :
    A ≃ₗ⁅ℝ⁆ B :=
  (iG.symm.trans (equivLieEquiv e he hi)).trans iK

@[simp] theorem coordinateLieEquiv_apply (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y))
    (iG : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ A) (iK : GroupLieAlgebra J K ≃ₗ⁅ℝ⁆ B) (x : A) :
    coordinateLieEquiv e he hi iG iK x =
      iK (homLieDifferential (I := I) (J := J) e.toMonoidHom (iG.symm x)) := rfl

/-- The induced equivalence has the differentiated map as its coordinate compatibility. -/
theorem coordinateLieEquiv_compat (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y))
    (iG : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ A) (iK : GroupLieAlgebra J K ≃ₗ⁅ℝ⁆ B)
    (v : GroupLieAlgebra I G) :
    iK (homLieDifferential (I := I) (J := J) e.toMonoidHom v) =
      coordinateLieEquiv e he hi iG iK (iG v) := by
  simp only [coordinateLieEquiv_apply, LieEquiv.symm_apply_apply]

/-- A prescribed Lie equivalence is induced by the supplied group equivalence exactly
when the differential compatibility holds in the supplied coordinates. -/
theorem coordinateLieEquiv_eq_iff (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun y => e.symm y))
    (iG : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ A) (iK : GroupLieAlgebra J K ≃ₗ⁅ℝ⁆ B)
    (φ : A ≃ₗ⁅ℝ⁆ B) :
    coordinateLieEquiv e he hi iG iK = φ ↔
      ∀ v, iK (homLieDifferential (I := I) (J := J) e.toMonoidHom v) = φ (iG v) := by
  constructor
  · intro h v
    rw [← h]
    exact coordinateLieEquiv_compat e he hi iG iK v
  · intro h
    ext x
    simpa only [coordinateLieEquiv_apply, LieEquiv.apply_symm_apply] using h (iG.symm x)

end Coordinates

/-- The adjoint action preserves the Lie bracket with the left-conjugation convention. -/
theorem lieAdjoint_map_lie (g : G) (v w : GroupLieAlgebra I G) :
    lieAdjoint (I := I) g ⁅v, w⁆ = ⁅lieAdjoint (I := I) g v, lieAdjoint (I := I) g w⁆ :=
  homLieDifferential_map_lie (MulAut.conj g).toMonoidHom (contMDiff_conjugation g) v w

/-- Conjugation by a group element induces a Lie algebra automorphism. -/
noncomputable def lieAdjointEquiv (g : G) : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ GroupLieAlgebra I G :=
  equivLieEquiv (MulAut.conj g) (contMDiff_conjugation g)
    (by simpa only [MulAut.conj_apply, MulAut.conj_symm_apply, inv_inv] using
      contMDiff_conjugation (I := I) g⁻¹)

@[simp] theorem lieAdjointEquiv_apply (g : G) (v : GroupLieAlgebra I G) :
    lieAdjointEquiv (I := I) g v = lieAdjoint (I := I) g v := rfl

@[simp] theorem lieAdjointEquiv_one :
    lieAdjointEquiv (I := I) (1 : G) = LieEquiv.refl := by
  ext v
  exact congrArg (fun T : GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra I G => T v)
    lieAdjoint_one

/-- With left conjugation, `Ad (g * h)` applies `Ad h` before `Ad g`. -/
theorem lieAdjointEquiv_mul (g h : G) :
    lieAdjointEquiv (I := I) (g * h) =
      (lieAdjointEquiv (I := I) h).trans (lieAdjointEquiv (I := I) g) := by
  ext v
  exact congrArg (fun T : GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra I G => T v)
    (lieAdjoint_mul g h)

@[simp] theorem lieAdjointEquiv_inv (g : G) :
    lieAdjointEquiv (I := I) g⁻¹ = (lieAdjointEquiv (I := I) g).symm := by
  ext v
  apply (lieAdjointEquiv (I := I) g).injective
  change lieAdjointEquiv (I := I) g (lieAdjointEquiv (I := I) g⁻¹ v) =
    lieAdjointEquiv (I := I) g ((lieAdjointEquiv (I := I) g).symm v)
  have h := congrArg (fun e : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ GroupLieAlgebra I G => e v)
    (lieAdjointEquiv_mul (I := I) g g⁻¹)
  simpa only [mul_inv_cancel, lieAdjointEquiv_one, LieEquiv.refl_apply,
    LieEquiv.trans_apply, LieEquiv.apply_symm_apply] using h.symm

end LieGroups

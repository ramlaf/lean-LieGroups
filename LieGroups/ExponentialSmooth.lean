import LieGroups.Exponential
import LieGroups.InvariantFieldCoordinates
import LieGroups.Analysis.ParametricIntegralCurve

/-!
# Smooth dependence of one-parameter subgroups on velocity

Apply a parametric Euclidean ODE theorem to the invariant field in identity-chart
coordinates, then identify its local solutions with the previously constructed global
one-parameter curves by uniqueness.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-05.
-/

open Set Filter
open scoped Topology ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G] [T2Space G]

set_option backward.isDefEq.respectTransparency false in
/-- Near any model-space velocity, the corresponding one-parameter curves depend
smoothly on both the velocity and sufficiently small time. -/
theorem exists_contMDiffOn_oneParameterCurve_near (v₀ : E) :
    ∃ r ε : ℝ, 0 < r ∧ 0 < ε ∧
      ContMDiffOn 𝓘(ℝ, E × ℝ) I ∞
        (fun p : E × ℝ => oneParameterCurve
          ((lieAlgebraModelEquiv (I := I) (G := G)).symm p.1) p.2)
        (Metric.ball v₀ r ×ˢ Ioo (-ε) ε) := by
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  let x₀ := extChartAt I (1 : G) 1
  let s : Set (E × E) := univ ×ˢ interior (extChartAt I (1 : G)).target
  have hs : IsOpen s := isOpen_univ.prod isOpen_interior
  have h₀ : (v₀, x₀) ∈ s :=
    ⟨mem_univ _, I.isInteriorPoint_iff.mp BoundarylessManifold.isInteriorPoint⟩
  obtain ⟨r, ε, φ, hr, hε, hφsmooth, hφ₀, hφode⟩ :=
    Analysis.exists_contDiffOn_parametricIntegralCurve hs
      ((contDiffOn_mulInvariantVectorFieldInChart (I := I) (G := G) 1).mono
        (prod_mono Subset.rfl interior_subset)) h₀
  let U : Set (E × ℝ) := Metric.ball v₀ r ×ˢ Ioo (-ε) ε
  have hφrange : ∀ p ∈ U, φ p ∈ (extChartAt I (1 : G)).target := by
    intro p hp
    exact interior_subset (hφode p.1 hp.1 p.2 hp.2).1.2
  have hlift : ContMDiffOn 𝓘(ℝ, E × ℝ) I ∞
      (fun p : E × ℝ => (extChartAt I (1 : G)).symm (φ p)) U := by
    exact (contMDiffOn_extChartAt_symm (I := I) (n := ∞) (1 : G)).comp
      hφsmooth.contMDiffOn hφrange
  refine ⟨r, ε, hr, hε, ?_⟩
  apply hlift.congr
  intro p hp
  let v := p.1
  have hv : v ∈ Metric.ball v₀ r := hp.1
  let γ : ℝ → G := fun t => (extChartAt I (1 : G)).symm (φ (v, t))
  have hγ : IsMIntegralCurveOn γ (mulInvariantVectorField (e.symm v)) (Ioo (-ε) ε) := by
    intro t ht
    have hode := hφode v hv t ht
    exact (hasMFDerivAt_of_invariantFieldInChart (I := I) (G := G)
      (g₀ := (1 : G)) (v := v) hode.1.2 hode.2).hasMFDerivWithinAt
  have hγ₀ : γ 0 = 1 := by
    change (extChartAt I (1 : G)).symm (φ (v, 0)) = 1
    rw [hφ₀ v hv]
    exact (extChartAt I (1 : G)).left_inv (mem_extChartAt_source (I := I) (1 : G))
  have heq := isMIntegralCurveOn_Ioo_eqOn_of_contMDiff_boundaryless
    (t₀ := 0) (a := -ε) (b := ε)
    (by constructor <;> linarith)
    ((contMDiff_infty_mulInvariantVectorField (I := I) (G := G) (e.symm v)).of_le (by simp))
    ((oneParameterCurve_isMIntegralCurve (e.symm v)).isMIntegralCurveOn _)
    hγ (by simpa only [oneParameterCurve_zero] using hγ₀.symm)
  exact heq hp.2

/-- Natural multiples of time become powers along a one-parameter subgroup. -/
theorem oneParameterCurve_nat_mul (v : GroupLieAlgebra I G) (n : ℕ) (t : ℝ) :
    oneParameterCurve v ((n : ℝ) * t) = (oneParameterCurve v t) ^ n := by
  simpa only [← ofAdd_nsmul, nsmul_eq_mul, oneParameterSubgroup_apply] using
    map_pow (oneParameterSubgroup v) (Multiplicative.ofAdd t) n

/-- In Lie-algebra coordinates, the exponential is smooth at every velocity. -/
theorem lieExp_contMDiffAt_model (v₀ : E) :
    ContMDiffAt 𝓘(ℝ, E) I ∞
      (fun v : E => lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)) v₀ := by
  obtain ⟨r, ε, hr, hε, hcurve⟩ :=
    exists_contMDiffOn_oneParameterCurve_near (I := I) (G := G) v₀
  obtain ⟨n, hn⟩ := exists_nat_one_div_lt hε
  let k : ℕ := n + 1
  let t : ℝ := 1 / (k : ℝ)
  have htpos : 0 < t := by dsimp [t, k]; positivity
  have htlt : t < ε := by simpa only [t, k, Nat.cast_add, Nat.cast_one] using hn
  have ht : t ∈ Ioo (-ε) ε := ⟨by linarith, htlt⟩
  have hkt : (k : ℝ) * t = 1 := by
    dsimp [t, k]
    field_simp
  have hU : Metric.ball v₀ r ×ˢ Ioo (-ε) ε ∈ 𝓝 (v₀, t) :=
    (Metric.isOpen_ball.prod isOpen_Ioo).mem_nhds ⟨Metric.mem_ball_self hr, ht⟩
  have htime : ContMDiffAt 𝓘(ℝ, E) I ∞
      (fun v : E => oneParameterCurve
        ((lieAlgebraModelEquiv (I := I) (G := G)).symm v) t) v₀ :=
    by
      have hfixed : ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, E × ℝ) ∞ (fun v : E => (v, t)) v₀ :=
        (contDiff_id.prodMk contDiff_const).contMDiff.contMDiffAt
      have hc := (hcurve.contMDiffAt hU).comp v₀ hfixed
      have heq : ((fun p : E × ℝ => oneParameterCurve
          ((lieAlgebraModelEquiv (I := I) (G := G)).symm p.1) p.2) ∘
          (fun v : E => (v, t))) =
          (fun v : E => oneParameterCurve
            ((lieAlgebraModelEquiv (I := I) (G := G)).symm v) t) := rfl
      rw [heq] at hc
      exact hc
  have heq : (fun v : E => lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)) =
      (fun v : E => (oneParameterCurve
        ((lieAlgebraModelEquiv (I := I) (G := G)).symm v) t) ^ k) := by
    funext v
    rw [lieExp, ← hkt, oneParameterCurve_nat_mul]
  rw [heq]
  exact (contMDiff_pow k).contMDiffAt.comp v₀ htime

/-- The Lie exponential is smooth in the preferred coordinates on the Lie algebra. -/
theorem lieExp_contMDiff_model :
    ContMDiff 𝓘(ℝ, E) I ∞
      (fun v : E => lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)) :=
  lieExp_contMDiffAt_model

end LieGroups

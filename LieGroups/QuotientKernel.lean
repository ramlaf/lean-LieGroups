import LieGroups.QuotientBundle

/-!
# The kernel of the homogeneous quotient differential

The subgroup differential is annihilated by the quotient projection. Surjectivity of the
quotient differential, injectivity of the subgroup differential, and the complementary model
dimensions identify this inclusion with the full kernel.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Function
open scoped ContDiff Manifold

noncomputable section

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]

namespace ImmersedLieSubgroup

variable (S : ImmersedLieSubgroup I G J K)

/-- Subgroup tangent vectors are annihilated by the quotient differential. -/
theorem lieAlgebra_le_ker_quotientDifferential
    (Q : HomogeneousQuotient I G S.subgroup) :
    letI := Q.chartedSpace
    S.lieAlgebra.toSubmodule ≤
      (mfderiv I 𝓘(ℝ, Q.model) (QuotientGroup.mk : G → G ⧸ S.subgroup) (1 : G)).ker := by
  let := Q.chartedSpace
  intro v hv
  obtain ⟨w, rfl⟩ := (S.mem_lieAlgebra v).mp hv
  have hc := mfderiv_comp_apply_of_eq (I := J) (I' := I) (I'' := 𝓘(ℝ, Q.model))
    (x := (1 : K)) (f := fun k => S.toMonoidHom k)
    (g := (QuotientGroup.mk : G → G ⧸ S.subgroup))
    (Q.projection_smooth (1 : G) |>.mdifferentiableAt (by simp))
    (S.contMDiff (1 : K) |>.mdifferentiableAt (by simp)) S.toMonoidHom.map_one w
  have heq : (fun k : K => (QuotientGroup.mk (S.toMonoidHom k) : G ⧸ S.subgroup)) =
      fun _ => QuotientGroup.mk (1 : G) := by
    funext k
    apply QuotientGroup.eq.mpr
    simpa only [mul_one] using S.subgroup.inv_mem (show S.toMonoidHom k ∈ S.subgroup from ⟨k, rfl⟩)
  change mfderiv J 𝓘(ℝ, Q.model)
    (fun k => QuotientGroup.mk (S.toMonoidHom k)) (1 : K) w = _ at hc
  rw [heq, mfderiv_const] at hc
  exact hc.symm

/-- For the expected complementary model dimension, the kernel is exactly the subgroup
tangent Lie algebra. The quotient manifold itself has already been constructed. -/
theorem ker_quotientDifferential_eq_lieAlgebra [J.Boundaryless]
    (Q : HomogeneousQuotient I G S.subgroup) (L : (Q.model × F) ≃L[ℝ] E) :
    letI := Q.chartedSpace
    (mfderiv I 𝓘(ℝ, Q.model) (QuotientGroup.mk : G → G ⧸ S.subgroup) (1 : G)).ker =
      S.lieAlgebra.toSubmodule := by
  let := Q.chartedSpace
  let d := mfderiv I 𝓘(ℝ, Q.model) (QuotientGroup.mk : G → G ⧸ S.subgroup) (1 : G)
  let : FiniteDimensional ℝ (GroupLieAlgebra I G) :=
    (lieAlgebraModelEquiv (I := I) (G := G)).symm.toLinearEquiv.finiteDimensional
  let : FiniteDimensional ℝ (GroupLieAlgebra J K) :=
    (lieAlgebraModelEquiv (I := J) (G := K)).symm.toLinearEquiv.finiteDimensional
  have hle := S.lieAlgebra_le_ker_quotientDifferential Q
  apply (Submodule.eq_of_le_of_finrank_eq hle ?_).symm
  have hsubdim := S.lieAlgebraEquiv.toLinearEquiv.finrank_eq
  have hsrcdim := (lieAlgebraModelEquiv (I := J) (G := K)).toLinearEquiv.finrank_eq
  have hambientdim := (lieAlgebraModelEquiv (I := I) (G := G)).toLinearEquiv.finrank_eq
  have htargetdim := (tangentSpaceCastModel 𝓘(ℝ, Q.model)
    (QuotientGroup.mk (1 : G) : G ⧸ S.subgroup)).toLinearEquiv.finrank_eq
  have hnull := d.toLinearMap.finrank_range_add_finrank_ker
  have hrange : LinearMap.range d.toLinearMap = ⊤ :=
    LinearMap.range_eq_top.mpr (Q.differential_surjective 1)
  rw [hrange, finrank_top] at hnull
  have hsplit := L.toLinearEquiv.finrank_eq
  rw [Module.finrank_prod] at hsplit
  change Module.finrank ℝ S.lieAlgebra = Module.finrank ℝ d.ker
  change Module.finrank ℝ (TangentSpace I (1 : G)) = Module.finrank ℝ E at hambientdim
  omega

end ImmersedLieSubgroup

end LieGroups

import Mathlib.Geometry.Manifold.Algebra.SMul
import Mathlib.Geometry.Manifold.MFDeriv.SpecificFunctions

/-!
# Tangent transport by a smooth group action

The differential of each action map is a continuous linear equivalence. Its
composition laws are the differentiated action laws, with no metric supplied.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false

namespace LieGroups

variable {E F H H' G M : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H}
  [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'}
  [Group G] [TopologicalSpace G] [ChartedSpace H G]
  [TopologicalSpace M] [ChartedSpace H' M]
  [MulAction G M] [hsmooth : ContMDiffSMul I J ∞ G M]

/-- Differential of the action by a fixed group element. -/
def actionTangent (g : G) (x : M) :
    TangentSpace J x →L[ℝ] TangentSpace J (g • x) :=
  mfderiv J J (fun y : M => g • y) x

omit [TopologicalSpace G] in
@[simp]
theorem actionTangent_one (x : M) :
    actionTangent (J := J) (1 : G) x =
      ContinuousLinearMap.id ℝ (TangentSpace J x) := by
  unfold actionTangent
  have h : (fun y : M => (1 : G) • y) = id := funext (one_smul G)
  rw [h, mfderiv_id]

include hsmooth

theorem actionTangent_mul (g h : G) (x : M) :
    actionTangent (J := J) (g * h) x =
      (actionTangent (J := J) g (h • x)).comp
        (actionTangent (J := J) h x) := by
  have hg := (ContMDiffSMul.contMDiff_const_smul (I := I) (I' := J) (M := M) g).mdifferentiable
    (by simp : (∞ : ℕ∞ω) ≠ 0)
  have hh := (ContMDiffSMul.contMDiff_const_smul (I := I) (I' := J) (M := M) h).mdifferentiable
    (by simp : (∞ : ℕ∞ω) ≠ 0)
  have hc := mfderiv_comp x (hg (h • x)) (hh x)
  have heq : (fun y : M => (g * h) • y) = (fun y : M => g • h • y) :=
    funext (mul_smul g h)
  unfold actionTangent
  rw [heq]
  exact hc

@[simp]
theorem actionTangent_inv_apply (g : G) (x : M) (v : TangentSpace J x) :
    actionTangent (J := J) g⁻¹ (g • x)
      (actionTangent (J := J) g x v) = v := by
  have h := congrArg (fun f => f v) (actionTangent_mul (I := I) (J := J) g⁻¹ g x)
  rw [inv_mul_cancel, actionTangent_one] at h
  exact h.symm

@[simp]
theorem actionTangent_apply_inv (g : G) (x : M) (v : TangentSpace J (g • x)) :
    actionTangent (J := J) g x
      (actionTangent (J := J) g⁻¹ (g • x) v) = v := by
  have h := actionTangent_inv_apply (I := I) (J := J) g⁻¹ (g • x) v
  rw [inv_inv, inv_smul_smul] at h
  exact h

/-- Tangent transport by an action map, with the differentiated inverse action. -/
def actionTangentEquiv (g : G) (x : M) :
    TangentSpace J x ≃L[ℝ] TangentSpace J (g • x) :=
  ContinuousLinearEquiv.equivOfInverse'
    (actionTangent (J := J) g x)
    (actionTangent (J := J) g⁻¹ (g • x))
    (by ext v; exact actionTangent_apply_inv (I := I) (J := J) g x v)
    (by ext v; exact actionTangent_inv_apply (I := I) (J := J) g x v)

@[simp]
theorem actionTangentEquiv_apply (g : G) (x : M) (v : TangentSpace J x) :
    actionTangentEquiv (I := I) (J := J) g x v =
      actionTangent (J := J) g x v := rfl

@[simp]
theorem actionTangentEquiv_symm_apply (g : G) (x : M) (v : TangentSpace J (g • x)) :
    (actionTangentEquiv (I := I) (J := J) g x).symm v =
      actionTangent (J := J) g⁻¹ (g • x) v := rfl

end LieGroups

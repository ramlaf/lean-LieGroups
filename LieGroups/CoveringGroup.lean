import Mathlib.Topology.Covering.Quotient
import Mathlib.Topology.Algebra.OpenSubgroup
import Mathlib.Topology.OpenPartialHomeomorph.Constructions
import Mathlib.GroupTheory.Subgroup.Center

/-!
# Covering homomorphisms of topological groups

A group homomorphism which is a local homeomorphism at the identity is a local
homeomorphism everywhere. Its kernel is discrete, and, when it is surjective,
it is a covering map. A connected target supplies surjectivity automatically.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Set
open scoped Topology

namespace LieGroups

variable {G G' : Type*} [Group G] [Group G']
  [TopologicalSpace G] [TopologicalSpace G']
  [IsTopologicalGroup G] [IsTopologicalGroup G']

/-- Translate an identity neighborhood to obtain a local homeomorphism at every
point of a group homomorphism. -/
theorem isLocalHomeomorph_hom_of_at_one (f : G →* G')
    (e : OpenPartialHomeomorph G G') (h1 : (1 : G) ∈ e.source)
    (he : EqOn f e e.source) : IsLocalHomeomorph f := by
  apply IsLocalHomeomorph.mk
  intro x
  let ex := ((Homeomorph.mulLeft x⁻¹).toOpenPartialHomeomorph.trans e).transHomeomorph
    (Homeomorph.mulLeft (f x))
  refine ⟨ex, ?_, ?_⟩
  · change x ∈ Set.univ ∩ (fun y => x⁻¹ * y) ⁻¹' e.source
    simpa using h1
  · intro y hy
    change f y = f x * e (x⁻¹ * y)
    have hy' : x⁻¹ * y ∈ e.source := hy.2
    rw [← he hy', map_mul, map_inv, ← mul_assoc, mul_inv_cancel, one_mul]

omit [IsTopologicalGroup G] [IsTopologicalGroup G'] in
/-- A local homeomorphism homomorphism has discrete kernel. -/
theorem isDiscrete_ker_of_isLocalHomeomorph (f : G →* G')
    (hf : IsLocalHomeomorph f) : IsDiscrete (f.ker : Set G) := by
  apply (hf.isLocalHomeomorphOn.mono (Set.subset_univ _)).isDiscrete_of_image
  apply Set.Subsingleton.isDiscrete
  rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
  exact (show f x = 1 from hx).trans (show f y = 1 from hy).symm

omit [IsTopologicalGroup G'] in
/-- A surjective local homeomorphism homomorphism is the quotient covering by
its discrete kernel, acting by left multiplication. -/
theorem isQuotientCoveringMap_hom_of_isLocalHomeomorph (f : G →* G')
    (hf : IsLocalHomeomorph f) (hs : Function.Surjective f) :
    IsQuotientCoveringMap f f.ker := by
  have hq := hf.isOpenMap.isQuotientMap hf.continuous hs
  exact hq.isQuotientCoveringMap_of_isDiscrete_ker_monoidHom
      (isDiscrete_ker_of_isLocalHomeomorph f hf)

omit [IsTopologicalGroup G'] in
/-- A surjective group homomorphism which is a local homeomorphism is a covering
map; no compactness or properness assumption is needed. -/
theorem isCoveringMap_hom_of_isLocalHomeomorph (f : G →* G')
    (hf : IsLocalHomeomorph f) (hs : Function.Surjective f) : IsCoveringMap f :=
  (isQuotientCoveringMap_hom_of_isLocalHomeomorph f hf hs).isCoveringMap

omit [IsTopologicalGroup G] in
/-- The image of a local homeomorphism homomorphism is an open subgroup, hence
is the whole group if the target is connected. -/
theorem surjective_hom_of_isLocalHomeomorph [ConnectedSpace G'] (f : G →* G')
    (hf : IsLocalHomeomorph f) : Function.Surjective f := by
  have ho : IsOpen (f.range : Set G') := by
    change IsOpen (Set.range f)
    simpa only [Set.image_univ] using hf.isOpenMap Set.univ isOpen_univ
  have hu : (f.range : Set G') = Set.univ :=
    (show IsClopen (f.range : Set G') from ⟨f.range.isClosed_of_isOpen ho, ho⟩).eq_univ
      ⟨1, f.range.one_mem⟩
  intro y
  have hy : y ∈ (f.range : Set G') := by rw [hu]; exact Set.mem_univ y
  exact hy

/-- A group homomorphism locally homeomorphic at the identity covers its
connected target. -/
theorem isCoveringMap_hom_of_at_one [ConnectedSpace G'] (f : G →* G')
    (e : OpenPartialHomeomorph G G') (h1 : (1 : G) ∈ e.source)
    (he : EqOn f e e.source) : IsCoveringMap f := by
  have hf := isLocalHomeomorph_hom_of_at_one f e h1 he
  exact isCoveringMap_hom_of_isLocalHomeomorph f hf
    (surjective_hom_of_isLocalHomeomorph f hf)

omit [IsTopologicalGroup G'] in
/-- The kernel of a covering homomorphism with connected source is central.
Conjugation of a kernel element is a continuous map into one discrete fiber. -/
theorem ker_le_center_of_isCoveringMap [PreconnectedSpace G] (f : G →* G')
    (hf : IsCoveringMap f) : f.ker ≤ Subgroup.center G := by
  intro k hk
  rw [Subgroup.mem_center_iff]
  intro g
  have hfk : f k = 1 := hk
  have hc : Continuous (fun x : G => x * k * x⁻¹) := by fun_prop
  have he : ∀ a b : G, f (a * k * a⁻¹) = f (b * k * b⁻¹) := by
    intro a b
    simp [map_mul, map_inv, hfk]
  have hh : g * k * g⁻¹ = k := by
    simpa using hf.const_of_comp hc he g 1
  simpa [mul_assoc] using congrArg (fun x : G => x * g) hh

end LieGroups

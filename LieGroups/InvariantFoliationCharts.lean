import LieGroups.Analysis.FrobeniusFlow
import LieGroups.InvariantFrameInvolutive
import LieGroups.Manifold.InteriorChartHomeomorph
import LieGroups.Manifold.FoliationDistribution

/-!
# Foliation charts for a Lie subalgebra

The local Frobenius theorem applied to the invariant frame gives an adapted
chart at the identity. Left translations then give a cover by adapted charts
with fixed horizontal and transverse model spaces.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Set Filter
open scoped Topology ContDiff Manifold

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G]

/-- The invariant distribution of any real Lie subalgebra has a genuine adapted
smooth chart near each point. The transverse model and chart are constructed by
Frobenius from smoothness, constant rank, and bracket closure. -/
theorem exists_invariantDistribution_foliationChart
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (g₀ : G) :
    ∃ (T : Submodule ℝ E)
      (c : PartialDiffeomorph I 𝓘(ℝ, lieSubalgebraModelSubmodule S × T)
        G (lieSubalgebraModelSubmodule S × T) ∞),
      g₀ ∈ c.source ∧ ∀ g ∈ c.source,
        (invariantDistribution S g).map
            (mfderiv I 𝓘(ℝ, lieSubalgebraModelSubmodule S × T) c g).toLinearMap =
          LinearMap.range
            (ContinuousLinearMap.inl ℝ (lieSubalgebraModelSubmodule S) T).toLinearMap := by
  let P := lieSubalgebraModelSubmodule S
  let B := invariantFrameInChart (I := I) P g₀
  let x₀ := extChartAt I g₀ g₀
  have hx₀ : x₀ ∈ interior (extChartAt I g₀).target :=
    I.isInteriorPoint_iff.mp BoundarylessManifold.isInteriorPoint
  have hB : ContDiffOn ℝ ∞ B (interior (extChartAt I g₀).target) :=
    (contDiffOn_invariantFrameInChart P g₀).mono interior_subset
  have hinj : Function.Injective (B x₀) :=
    invariantFrameInChart_injective P g₀ (interior_subset hx₀)
  obtain ⟨T, e, he0, heval, hetarget, he, hei, hehor⟩ :=
    Analysis.exists_foliationChart_of_involutiveFrame isOpen_interior hx₀ hB hinj
      (fun y hy V W hV hW hVS hWS =>
        lieBracket_mem_range_invariantFrameInChart S g₀ (interior_subset hy) hV hW hVS hWS)
  let D : PartialDiffeomorph 𝓘(ℝ, E) 𝓘(ℝ, P × T) E (P × T) ∞ := {
    toPartialEquiv := e.symm.toPartialEquiv
    open_source := e.open_target
    open_target := e.open_source
    contMDiffOn_toFun := hei.contMDiffOn
    contMDiffOn_invFun := he.contMDiffOn
  }
  let C := Manifold.extChartAtInteriorPartialDiffeomorph (I := I) g₀
  let c := C.trans D
  have hg₀C : g₀ ∈ C.source := ⟨mem_extChartAt_source (I := I) g₀, hx₀⟩
  have hx₀D : x₀ ∈ D.source := by
    change x₀ ∈ e.target
    rw [← heval]
    exact e.map_source he0
  refine ⟨T, c, ⟨hg₀C, hx₀D⟩, ?_⟩
  intro g hg
  have hgC : g ∈ C.source := hg.1
  have hgD : C g ∈ D.source := hg.2
  have hgchart : g ∈ (extChartAt I g₀).source := hgC.1
  have hCd := (C.contMDiffOn_toFun.contMDiffAt
    (C.open_source.mem_nhds hgC)).mdifferentiableAt (by simp)
  have hDd := (D.contMDiffOn_toFun.contMDiffAt
    (D.open_source.mem_nhds hgD)).mdifferentiableAt (by simp)
  have hderiv : mfderiv I 𝓘(ℝ, P × T) c g =
      (fderiv ℝ e.symm (extChartAt I g₀ g)).comp
        (mfderiv I 𝓘(ℝ, E) (extChartAt I g₀) g) := by
    change mfderiv I 𝓘(ℝ, P × T) (D ∘ C) g = _
    rw [mfderiv_comp g hDd hCd, mfderiv_eq_fderiv]
    rfl
  rw [hderiv]
  change (invariantDistribution S g).map
    ((fderiv ℝ e.symm (extChartAt I g₀ g)).toLinearMap.comp
      (mfderiv I 𝓘(ℝ, E) (extChartAt I g₀) g).toLinearMap) = _
  erw [Submodule.map_comp]
  erw [← range_invariantFrameInChart_at_chart S g₀ hgchart]
  exact hehor (extChartAt I g₀ g) hgD

/-- Left translations cover the group with foliation charts sharing one fixed
transverse model, and every chart identifies the invariant distribution with
the horizontal tangent subspace. -/
theorem exists_invariantDistribution_foliationCharts
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    ∃ (T : Submodule ℝ E)
      (c : G → PartialDiffeomorph I 𝓘(ℝ, lieSubalgebraModelSubmodule S × T)
        G (lieSubalgebraModelSubmodule S × T) ∞),
      (∀ g, g ∈ (c g).source) ∧ ∀ a g, g ∈ (c a).source →
        (invariantDistribution S g).map
            (mfderiv I 𝓘(ℝ, lieSubalgebraModelSubmodule S × T) (c a) g).toLinearMap =
          LinearMap.range
            (ContinuousLinearMap.inl ℝ (lieSubalgebraModelSubmodule S) T).toLinearMap := by
  obtain ⟨T, c₀, h1, hc₀⟩ := exists_invariantDistribution_foliationChart S (1 : G)
  let L (a : G) : Diffeomorph I I G G ∞ := {
    toEquiv := Equiv.mulLeft a⁻¹
    contMDiff_toFun := contMDiff_mul_left
    contMDiff_invFun := contMDiff_mul_left
  }
  let c (a : G) := (L a).toPartialDiffeomorph.trans c₀
  refine ⟨T, c, ?_, ?_⟩
  · intro a
    change a ∈ Set.univ ∧ a⁻¹ * a ∈ c₀.source
    simpa only [mem_univ, inv_mul_cancel, true_and] using h1
  · intro a g hg
    have hg₀ : a⁻¹ * g ∈ c₀.source := hg.2
    have hcd := (c₀.contMDiffOn_toFun.contMDiffAt
      (c₀.open_source.mem_nhds hg₀)).mdifferentiableAt (by simp)
    have hld : MDifferentiableAt I I (a⁻¹ * ·) g :=
      (contMDiff_mul_left (I := I) (n := ∞)).mdifferentiableAt (by simp)
    change (invariantDistribution S g).map
      (mfderiv I 𝓘(ℝ, lieSubalgebraModelSubmodule S × T)
        (c₀ ∘ (a⁻¹ * ·)) g).toLinearMap = _
    rw [mfderiv_comp g hcd hld]
    change (invariantDistribution S g).map
      ((mfderiv I 𝓘(ℝ, lieSubalgebraModelSubmodule S × T) c₀ (a⁻¹ * g)).toLinearMap.comp
        (mfderiv I I (a⁻¹ * ·) g).toLinearMap) = _
    rw [Submodule.map_comp, invariantDistribution_map_mul_left]
    exact hc₀ (a⁻¹ * g) hg₀

/-- Every finite-dimensional real Lie subalgebra gives a compatible foliation
atlas on its ambient Lie group. Neither the atlas nor its plaque compatibility
is assumed: both are consequences of the invariant distribution. -/
theorem exists_invariantDistribution_foliationAtlas
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    ∃ (T : Submodule ℝ E)
      (A : Manifold.FoliationAtlas (P := lieSubalgebraModelSubmodule S) (Q := T) I G),
      ∀ a g, g ∈ (A.chart a).source →
        (invariantDistribution S g).map
            (mfderiv I 𝓘(ℝ, lieSubalgebraModelSubmodule S × T) (A.chart a) g).toLinearMap =
          LinearMap.range
            (ContinuousLinearMap.inl ℝ (lieSubalgebraModelSubmodule S) T).toLinearMap := by
  obtain ⟨T, c, hcover, hD⟩ := exists_invariantDistribution_foliationCharts S
  exact ⟨T, Manifold.FoliationAtlas.of_distributionCharts (invariantDistribution S)
    c hcover hD, hD⟩

end LieGroups

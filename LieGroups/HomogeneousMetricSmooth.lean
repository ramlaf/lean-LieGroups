import LieGroups.HomogeneousMetric
import Mathlib.Geometry.Manifold.Algebra.LieGroup
import LieGroups.Manifold.LocalSections
import LieGroups.Manifold.ParametricMFDeriv
import LieGroups.Manifold.RiemannianMetric

/-!
# Smooth invariant metrics from an origin inner product

Local smooth sections of the orbit map make the transported origin form smooth.
Together with stabilizer invariance and positivity, this constructs an actual
smooth Riemannian metric on the given homogeneous manifold.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section
open Bundle Filter
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false

namespace LieGroups

variable {E F H H' G M : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H}
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [TopologicalSpace M] [ChartedSpace H' M] [IsManifold J ∞ M] [T2Space M]
  [MulAction G M] [ContMDiffSMul I J ∞ G M] [MulAction.IsPretransitive G M]

omit [FiniteDimensional ℝ F] [T2Space M] in
/-- Pairings of the transported origin form are smooth; representative choices
are replaced locally by actual smooth sections of the orbit map. -/
theorem contMDiff_homogeneousInner_pairings
    (o : M) (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) o B)
    (hsections : Manifold.HasContMDiffLocalSections I J ∞ (fun g : G => g • o))
    (Y Z : Cₛ^∞⟮J; F, (TangentSpace J : M → Type _)⟯) :
    ContMDiff J 𝓘(ℝ, ℝ) ∞ (fun x => homogeneousInner (G := G) o B x (Y x) (Z x)) := by
  intro x
  obtain ⟨s, hs, hsec⟩ := hsections x
  let f : M → M → M := fun y z => (s y)⁻¹ • z
  have hf : ContMDiffAt (J.prod J) J ∞ (Function.uncurry f) (x, x) := by
    exact (hs.comp (x, x) contMDiffAt_fst).inv.smul contMDiffAt_snd
  have ho : (fun y => f y y) =ᶠ[𝓝 x] fun _ => o := by
    filter_upwards [hsec] with y hy
    change (s y)⁻¹ • y = o
    change s y • o = y at hy
    calc
      (s y)⁻¹ • y = (s y)⁻¹ • (s y • o) := congrArg (fun z => (s y)⁻¹ • z) hy.symm
      _ = o := inv_smul_smul (s y) o
  have hY : ContMDiffAt J 𝓘(ℝ, F) ∞
      (fun y => mfderiv J J (f y) y (Y y)) x :=
    Manifold.contMDiffAt_parametricMFDeriv_apply_const f id (fun y => Y y) x o
      hf contMDiffAt_id (Y.contMDiff x) ho
  have hZ : ContMDiffAt J 𝓘(ℝ, F) ∞
      (fun y => mfderiv J J (f y) y (Z y)) x :=
    Manifold.contMDiffAt_parametricMFDeriv_apply_const f id (fun y => Z y) x o
      hf contMDiffAt_id (Z.contMDiff x) ho
  let B' : F →L[ℝ] F →L[ℝ] ℝ := B
  have hp := ((contMDiffAt_const (c := B')).clm_apply hY).clm_apply hZ
  apply hp.congr_of_eventuallyEq
  filter_upwards [hsec] with y hy
  exact homogeneousInner_apply_of_smul_eq (I := I) o B hB hy (Y y) (Z y)

/-- A positive symmetric stabilizer-invariant origin form constructs a smooth
Riemannian metric, using the existing manifold and tangent topologies. -/
def homogeneousRiemannianMetric
    (o : M) (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) o B)
    (hsymm : ∀ v w, B v w = B w v)
    (hpos : ∀ v, v ≠ 0 → 0 < B v v)
    (hsections : Manifold.HasContMDiffLocalSections I J ∞ (fun g : G => g • o)) :
    DifferentialGeometry.SmoothRiemannianMetric J M :=
  Manifold.smoothRiemannianMetricOfPairings (homogeneousInner (G := G) o B)
    (homogeneousInner_symm o B hsymm)
    (homogeneousInner_pos (I := I) o B hpos)
    (contMDiff_homogeneousInner_pairings o B hB hsections)

@[simp]
theorem homogeneousRiemannianMetric_inner
    (o : M) (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) o B)
    (hsymm : ∀ v w, B v w = B w v)
    (hpos : ∀ v, v ≠ 0 → 0 < B v v)
    (hsections : Manifold.HasContMDiffLocalSections I J ∞ (fun g : G => g • o))
    (x : M) (v w : TangentSpace J x) :
    (homogeneousRiemannianMetric o B hB hsymm hpos hsections).inner x v w =
      homogeneousInner (G := G) o B x v w := rfl

@[simp]
theorem homogeneousRiemannianMetric_origin
    (o : M) (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) o B)
    (hsymm : ∀ v w, B v w = B w v)
    (hpos : ∀ v, v ≠ 0 → 0 < B v v)
    (hsections : Manifold.HasContMDiffLocalSections I J ∞ (fun g : G => g • o))
    (v w : TangentSpace J o) :
    (homogeneousRiemannianMetric o B hB hsymm hpos hsections).inner o v w = B v w :=
  homogeneousInner_origin (I := I) o B hB v w

/-- The constructed smooth metric is invariant under the full group action. -/
theorem homogeneousRiemannianMetric_invariant
    (o : M) (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) o B)
    (hsymm : ∀ v w, B v w = B w v)
    (hpos : ∀ v, v ≠ 0 → 0 < B v v)
    (hsections : Manifold.HasContMDiffLocalSections I J ∞ (fun g : G => g • o))
    (g : G) (x : M) (v w : TangentSpace J x) :
    (homogeneousRiemannianMetric o B hB hsymm hpos hsections).inner (g • x)
      (actionTangent (J := J) g x v) (actionTangent (J := J) g x w) =
        (homogeneousRiemannianMetric o B hB hsymm hpos hsections).inner x v w :=
  homogeneousInner_invariant (I := I) o B hB g x v w

end LieGroups

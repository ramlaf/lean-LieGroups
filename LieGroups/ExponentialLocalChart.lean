/-!
# The Lie exponential near zero

The coordinate differential of the Lie exponential at zero is the identity. This
is proved by comparing its directional derivatives with the initial velocities of
the one-parameter subgroups.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-05.
-/

open Set
open scoped Topology ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G] [T2Space G]

omit [FiniteDimensional ℝ E] [BoundarylessManifold I G] [T2Space G] in
set_option backward.isDefEq.respectTransparency false in
/-- In the preferred identity chart, the invariant field at the identity has
the specified model-space velocity. -/
theorem invariantFieldInChart_one (v : E) :
    mulInvariantVectorFieldInChart (I := I) (G := G) 1
      (v, extChartAt I (1 : G) 1) = v := by
  rw [mulInvariantVectorFieldInChart_apply _ _ _ (mem_extChartAt_source (I := I) (1 : G))]
  rw [mulInvariantVectorField_one]
  change (lieAlgebraModelEquiv (I := I) (G := G))
    ((lieAlgebraModelEquiv (I := I) (G := G)).symm v) = v
  exact (lieAlgebraModelEquiv (I := I) (G := G)).apply_symm_apply v

set_option backward.isDefEq.respectTransparency false in
/-- The total differential at zero of the Lie exponential, expressed in the
preferred model-space and identity-chart coordinates, is the identity. -/
theorem lieExp_fderiv_chart_zero_model :
    fderiv ℝ (fun v : E => extChartAt I (1 : G)
      (lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm v))) 0 =
      ContinuousLinearMap.id ℝ E := by
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  let F : E → E := fun v => extChartAt I (1 : G) (lieExp (e.symm v))
  have hF : DifferentiableAt ℝ F 0 := by
    have hExp : ContMDiffAt 𝓘(ℝ, E) I ∞
        (fun v : E => lieExp (e.symm v)) 0 :=
      (lieExp_contMDiff_model (I := I) (G := G)).contMDiffAt
    have hzero : lieExp (e.symm (0 : E)) = (1 : G) := by simp
    have hChart : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I (1 : G)) 1 :=
      contMDiffAt_extChartAt
    have hChart' : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I (1 : G))
        (lieExp (e.symm (0 : E))) := by rw [hzero]; exact hChart
    have h := hChart'.comp (0 : E) hExp
    have hDiff : DifferentiableAt ℝ F 0 := by
      exact (show MDifferentiableAt 𝓘(ℝ, E) 𝓘(ℝ, E) F 0 from
        (by simpa only [F, Function.comp_def] using h.mdifferentiableAt (by simp))).differentiableAt
    exact hDiff
  apply ContinuousLinearMap.ext
  intro v
  have hline : HasDerivAt (fun t : ℝ => t • v) v 0 := by
    simpa using (hasDerivAt_id (0 : ℝ)).smul_const v
  have hF' : HasFDerivAt F (fderiv ℝ F 0) ((fun t : ℝ => t • v) 0) := by
    have hz : (fun t : ℝ => t • v) 0 = (0 : E) := by simp
    rw [hz]
    exact hF.hasFDerivAt
  have hcomp := hF'.comp_hasDerivAt 0 hline
  have heq : (F ∘ fun t : ℝ => t • v) =
      (extChartAt I (1 : G)) ∘ (oneParameterCurve (e.symm v)) := by
    funext t
    simp only [Function.comp_apply, F, map_smul, lieExp_smul]
  rw [heq] at hcomp
  have hcurve : HasDerivAt
      ((extChartAt I (1 : G)) ∘ oneParameterCurve (e.symm v)) v 0 := by
    have hsrc : oneParameterCurve (e.symm v) 0 ∈
        (extChartAt I (oneParameterCurve (e.symm v) 0)).source :=
      mem_extChartAt_source (I := I) _
    have hd := hasDerivWithinAt_invariantFieldInChart (I := I) (G := G)
      ((oneParameterCurve_isMIntegralCurve (e.symm v)).isMIntegralCurveOn Set.univ)
      (t₀ := 0) (t := 0) (Set.mem_univ _) hsrc
    simpa only [oneParameterCurve_zero, invariantFieldInChart_one,
      hasDerivWithinAt_univ] using hd
  have he := hcomp.unique hcurve
  simpa only [ContinuousLinearMap.id_apply] using he

set_option backward.isDefEq.respectTransparency false in
/-- The exponential in Lie-algebra model coordinates restricts to a homeomorphism
from an open neighborhood of zero onto an open neighborhood of the identity. -/
theorem exists_lieExp_localHomeomorph_model :
    ∃ Φ : OpenPartialHomeomorph E G,
      (0 : E) ∈ Φ.source ∧ Φ 0 = 1 ∧
      Set.EqOn (fun v : E => lieExp
        ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)) Φ Φ.source := by
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  let X : E → G := fun v => lieExp (e.symm v)
  let F : E → E := fun v => extChartAt I (1 : G) (X v)
  have hExp : ContMDiffAt 𝓘(ℝ, E) I ∞ X 0 :=
    (lieExp_contMDiff_model (I := I) (G := G)).contMDiffAt
  have hX0 : X 0 = 1 := by simp [X]
  have hChart : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I (1 : G)) (X 0) := by
    rw [hX0]
    exact contMDiffAt_extChartAt
  have hF : ContDiffAt ℝ ∞ F 0 := by
    have h := hChart.comp (0 : E) hExp
    exact (show ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, E) ∞ F 0 from
      (by simpa only [F, Function.comp_def] using h)).contDiffAt
  have hDeriv : HasFDerivAt F
      ((ContinuousLinearEquiv.refl ℝ E) : E →L[ℝ] E) 0 := by
    have hd : fderiv ℝ F 0 = ContinuousLinearMap.id ℝ E :=
      lieExp_fderiv_chart_zero_model (I := I) (G := G)
    have hD := (hF.differentiableAt (by simp)).hasFDerivAt
    rw [hd] at hD
    simpa using hD
  let φ : OpenPartialHomeomorph E E :=
    hF.toOpenPartialHomeomorph F (f' := ContinuousLinearEquiv.refl ℝ E) hDeriv (by simp)
  have hφ0 : (0 : E) ∈ φ.source :=
    hF.mem_toOpenPartialHomeomorph_source hDeriv (by simp)
  let W : Set E := X ⁻¹' (extChartAt I (1 : G)).source
  have hW : IsOpen W := (isOpen_extChartAt_source (I := I) (1 : G)).preimage
    (lieExp_contMDiff_model (I := I) (G := G)).continuous
  have hW0 : (0 : E) ∈ W := by
    change X 0 ∈ (extChartAt I (1 : G)).source
    rw [hX0]
    exact mem_extChartAt_source (I := I) _
  let ψ := φ.restrOpen W hW
  let C : OpenPartialHomeomorph G E := Manifold.extChartAtInterior (I := I) (1 : G)
  let Φ : OpenPartialHomeomorph E G := ψ.trans C.symm
  have hΦ0 : (0 : E) ∈ Φ.source := by
    rw [OpenPartialHomeomorph.trans_source]
    constructor
    · change (0 : E) ∈ φ.source ∩ W
      exact ⟨hφ0, hW0⟩
    · change ψ 0 ∈ C.target
      change F 0 ∈ interior (extChartAt I (1 : G)).target
      rw [show F 0 = extChartAt I (1 : G) 1 by simp [F, hX0]]
      exact I.isInteriorPoint_iff.mp BoundarylessManifold.isInteriorPoint
  refine ⟨Φ, hΦ0, ?_, ?_⟩
  · change (extChartAt I (1 : G)).symm (F 0) = 1
    rw [show F 0 = extChartAt I (1 : G) 1 by simp [F, hX0]]
    exact (extChartAt I (1 : G)).left_inv (mem_extChartAt_source (I := I) _)
  · intro v hv
    have hvW : v ∈ W := by
      have hv' : v ∈ ψ.source ∩ ψ ⁻¹' C.symm.source := by
        simpa only [Φ, OpenPartialHomeomorph.trans_source] using hv
      have hvψ : v ∈ ψ.source := hv'.1
      exact hvψ.2
    change X v = (extChartAt I (1 : G)).symm (F v)
    exact ((extChartAt I (1 : G)).left_inv hvW).symm

set_option backward.isDefEq.respectTransparency false in
/-- In preferred Lie-algebra coordinates, the exponential restricts to a smooth
diffeomorphism between open neighborhoods of zero and the group identity. -/
theorem exists_lieExp_localDiffeomorph_model :
    ∃ Φ : PartialDiffeomorph 𝓘(ℝ, E) I E G ∞,
      (0 : E) ∈ Φ.source ∧ Φ 0 = 1 ∧
      Set.EqOn (fun v : E => lieExp
        ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)) Φ Φ.source := by
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  let X : E → G := fun v => lieExp (e.symm v)
  let F : E → E := fun v => extChartAt I (1 : G) (X v)
  let W : Set E := X ⁻¹' (extChartAt I (1 : G)).source
  have hW : IsOpen W := (isOpen_extChartAt_source (I := I) (1 : G)).preimage
    (lieExp_contMDiff_model (I := I) (G := G)).continuous
  have hX0 : X 0 = 1 := by simp [X]
  have hW0 : (0 : E) ∈ W := by
    change X 0 ∈ (extChartAt I (1 : G)).source
    rw [hX0]
    exact mem_extChartAt_source (I := I) _
  have hFOn : ContDiffOn ℝ ∞ F W := by
    intro v hv
    have hExpAt : ContMDiffAt 𝓘(ℝ, E) I ∞ X v :=
      (lieExp_contMDiff_model (I := I) (G := G)).contMDiffAt
    have hChartAt : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I (1 : G)) (X v) := by
      apply contMDiffAt_extChartAt'
      have hv' : X v ∈ (extChartAt I (1 : G)).source := hv
      simpa only [extChartAt_source] using hv'
    have h := hChartAt.comp v hExpAt
    have hFAt : ContDiffAt ℝ ∞ F v :=
      (show ContMDiffAt 𝓘(ℝ, E) 𝓘(ℝ, E) ∞ F v from
        (by simpa only [F, Function.comp_def] using h)).contDiffAt
    exact hFAt.contDiffWithinAt
  have hd : fderiv ℝ F 0 = ContinuousLinearMap.id ℝ E :=
    lieExp_fderiv_chart_zero_model (I := I) (G := G)
  obtain ⟨D, hD0, hDW, hDEq⟩ :=
    Analysis.exists_partialDiffeomorph_of_fderiv_zero_id hW hW0 hFOn hd
  let C : PartialDiffeomorph I 𝓘(ℝ, E) G E ∞ :=
    Manifold.extChartAtInteriorPartialDiffeomorph (I := I) (1 : G)
  let Φ : PartialDiffeomorph 𝓘(ℝ, E) I E G ∞ := D.trans C.symm
  have hD0eq : D 0 = F 0 := (hDEq hD0).symm
  have hΦ0 : (0 : E) ∈ Φ.source := by
    change (0 : E) ∈ D.source ∩ D ⁻¹' C.symm.source
    refine ⟨hD0, ?_⟩
    change D 0 ∈ interior (extChartAt I (1 : G)).target
    rw [hD0eq, show F 0 = extChartAt I (1 : G) 1 by simp [F, hX0]]
    exact I.isInteriorPoint_iff.mp BoundarylessManifold.isInteriorPoint
  refine ⟨Φ, hΦ0, ?_, ?_⟩
  · change (extChartAt I (1 : G)).symm (D 0) = 1
    rw [hD0eq, show F 0 = extChartAt I (1 : G) 1 by simp [F, hX0]]
    exact (extChartAt I (1 : G)).left_inv (mem_extChartAt_source (I := I) _)
  · intro v hv
    have hvD : v ∈ D.source := by
      have hv' : v ∈ D.source ∩ D ⁻¹' C.symm.source := hv
      exact hv'.1
    have hvW : v ∈ W := hDW hvD
    have hvEq : F v = D v := hDEq hvD
    change X v = (extChartAt I (1 : G)).symm (D v)
    rw [← hvEq]
    exact ((extChartAt I (1 : G)).left_inv hvW).symm

/-- The Lie exponential is a smooth local diffeomorphism at zero when its domain
is expressed in preferred model-space coordinates. -/
theorem lieExp_isLocalDiffeomorphAt_model :
    IsLocalDiffeomorphAt 𝓘(ℝ, E) I ∞
      (fun v : E => lieExp
        ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)) 0 := by
  obtain ⟨Φ, h0, _, hEq⟩ := exists_lieExp_localDiffeomorph_model (I := I) (G := G)
  exact ⟨Φ, h0, hEq⟩

end LieGroups

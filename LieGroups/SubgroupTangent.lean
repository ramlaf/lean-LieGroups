import LieGroups.HomomorphismDifferential

/-!
# Ambient curve velocities of subgroups

`subgroupTangentSet` records velocities of differentiable ambient curves whose entire image
lies in a subgroup. No topology or smooth structure on the subgroup is chosen. Smooth group
homomorphisms map these velocities into the corresponding set for the image subgroup.

The differential range of a smooth homomorphism is contained in the ambient curve tangent
set of its image. The converse is not asserted: an ambient differentiable curve in the
image need not lift to a differentiable curve in the source.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open scoped ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K]

/-- Velocities at the identity of ambient differentiable curves lying in a subgroup.
The model space underlying the tangent space is independent of its base point, so the
derivative can be used directly after recording that the curve starts at the identity. -/
def subgroupTangentSet (S : Subgroup G) : Set (GroupLieAlgebra I G) :=
  {v | ∃ γ : ℝ → G, γ 0 = 1 ∧ (∀ t, γ t ∈ S) ∧
    MDifferentiableAt 𝓘(ℝ, ℝ) I γ 0 ∧
    mfderiv 𝓘(ℝ, ℝ) I γ 0 ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1) = v}

/-- The equivalent formulation with an explicit transport of the derivative to the identity
matches interfaces that retain the tangent base point in their notation. -/
theorem mem_subgroupTangentSet_iff_cast (S : Subgroup G) (v : GroupLieAlgebra I G) :
    v ∈ subgroupTangentSet (I := I) S ↔
      ∃ (γ : ℝ → G) (hγ : γ 0 = 1), (∀ t, γ t ∈ S) ∧
        MDifferentiableAt 𝓘(ℝ, ℝ) I γ 0 ∧
        (hγ ▸ mfderiv 𝓘(ℝ, ℝ) I γ 0)
          ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1) = v := by
  have hcast (x : G) (hx : x = 1)
      (T : TangentSpace 𝓘(ℝ, ℝ) (0 : ℝ) →L[ℝ] TangentSpace I x) :
      (hx ▸ T : TangentSpace 𝓘(ℝ, ℝ) (0 : ℝ) →L[ℝ] GroupLieAlgebra I G) = T := by
    cases hx
    rfl
  constructor
  · rintro ⟨γ, hγ, hmem, hdiff, hderiv⟩
    refine ⟨γ, hγ, hmem, hdiff, ?_⟩
    exact (congrArg (fun T : TangentSpace 𝓘(ℝ, ℝ) (0 : ℝ) →L[ℝ]
      GroupLieAlgebra I G => T ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1))
      (hcast (γ 0) hγ _)).trans hderiv
  · rintro ⟨γ, hγ, hmem, hdiff, hderiv⟩
    refine ⟨γ, hγ, hmem, hdiff, ?_⟩
    exact (congrArg (fun T : TangentSpace 𝓘(ℝ, ℝ) (0 : ℝ) →L[ℝ]
      GroupLieAlgebra I G => T ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1))
      (hcast (γ 0) hγ _)).symm.trans hderiv

/-- Passing to a larger subgroup preserves every ambient curve velocity. -/
theorem subgroupTangentSet_mono {S T : Subgroup G} (hST : S ≤ T) :
    subgroupTangentSet (I := I) S ⊆ subgroupTangentSet (I := I) T := by
  rintro v ⟨γ, hγ, hmem, hdiff, hderiv⟩
  exact ⟨γ, hγ, fun t => hST (hmem t), hdiff, hderiv⟩

/-- Every subgroup contains the zero velocity, witnessed by the constant identity curve. -/
theorem zero_mem_subgroupTangentSet (S : Subgroup G) :
    (0 : GroupLieAlgebra I G) ∈ subgroupTangentSet (I := I) S := by
  refine ⟨fun _ => 1, rfl, fun _ => S.one_mem, mdifferentiableAt_const, ?_⟩
  simp

set_option backward.isDefEq.respectTransparency false in
/-- The trivial subgroup has only the zero ambient curve velocity. -/
@[simp] theorem subgroupTangentSet_bot :
    subgroupTangentSet (I := I) (⊥ : Subgroup G) = {0} := by
  ext v
  constructor
  · rintro ⟨γ, hγ, hmem, hdiff, hderiv⟩
    have heq : γ = fun _ => (1 : G) := funext (fun t => hmem t)
    subst γ
    simpa using hderiv.symm
  · intro hv
    rcases hv with rfl
    exact zero_mem_subgroupTangentSet _

set_option backward.isDefEq.respectTransparency false in
/-- The identity differential of a smooth homomorphism maps ambient curve velocities into
the corresponding set of velocities for the image subgroup. -/
theorem homLieDifferential_mem_subgroupTangentSet_map (f : G →* K)
    (hf : ContMDiff I J ∞ (fun x => f x)) (S : Subgroup G)
    {v : GroupLieAlgebra I G} (hv : v ∈ subgroupTangentSet (I := I) S) :
    homLieDifferential (I := I) (J := J) f v ∈
      subgroupTangentSet (I := J) (S.map f) := by
  obtain ⟨γ, hγ, hmem, hdiff, hderiv⟩ := hv
  refine ⟨(fun x => f x) ∘ γ, by simp [hγ], ?_, ?_, ?_⟩
  · intro t
    exact Subgroup.mem_map.mpr ⟨γ t, hmem t, rfl⟩
  · exact (hf.mdifferentiable (by simp) (γ 0)).comp 0 hdiff
  · have hc := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, ℝ)) (I' := I) (I'' := J)
      (x := (0 : ℝ)) (f := γ) (g := fun x => f x)
      (hf.mdifferentiable (by simp) 1) hdiff hγ
      ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)
    rw [hderiv] at hc
    exact hc

/-- The pointwise image under the differential is contained in the curve tangent set of
the subgroup image. -/
theorem homLieDifferential_image_subgroupTangentSet_subset (f : G →* K)
    (hf : ContMDiff I J ∞ (fun x => f x)) (S : Subgroup G) :
    homLieDifferential (I := I) (J := J) f '' subgroupTangentSet (I := I) S ⊆
      subgroupTangentSet (I := J) (S.map f) := by
  rintro _ ⟨v, hv, rfl⟩
  exact homLieDifferential_mem_subgroupTangentSet_map f hf S hv

/-- A group equivalence smooth in both directions carries the entire ambient curve tangent
set onto that of the image subgroup. -/
theorem subgroupTangentSet_map_equiv (e : G ≃* K)
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun x => e.symm x)) (S : Subgroup G) :
    subgroupTangentSet (I := J) (S.map e.toMonoidHom) =
      homLieDifferential (I := I) (J := J) e.toMonoidHom ''
        subgroupTangentSet (I := I) S := by
  have hS : (S.map e.toMonoidHom).map e.symm.toMonoidHom = S := by
    ext x
    simp only [Subgroup.mem_map]
    constructor
    · rintro ⟨y, ⟨z, hz, rfl⟩, rfl⟩
      simpa using hz
    · intro hx
      exact ⟨e x, ⟨x, hx, rfl⟩, e.symm_apply_apply x⟩
  apply Set.Subset.antisymm
  · intro v hv
    refine ⟨homLieDifferential (I := J) (J := I) e.symm.toMonoidHom v, ?_, ?_⟩
    · rw [← hS]
      exact homLieDifferential_mem_subgroupTangentSet_map e.symm.toMonoidHom hi _ hv
    · exact congrArg (fun T : GroupLieAlgebra J K →L[ℝ] GroupLieAlgebra J K => T v)
        (homLieDifferential_symm_comp e.symm hi he)
  · exact homLieDifferential_image_subgroupTangentSet_subset e.toMonoidHom he S

section OneParameter

variable [LieGroup I ∞ G] [CompleteSpace E] [BoundarylessManifold I G] [T2Space G]

set_option backward.isDefEq.respectTransparency false in
/-- A subgroup containing the one-parameter curve of `v` contains `v` in its ambient
curve tangent set. -/
theorem mem_subgroupTangentSet_of_oneParameterCurve (S : Subgroup G)
    (v : GroupLieAlgebra I G) (hv : ∀ t, oneParameterCurve v t ∈ S) :
    v ∈ subgroupTangentSet (I := I) S := by
  refine ⟨oneParameterCurve v, oneParameterCurve_zero v, hv,
    oneParameterCurve_mdifferentiable v 0, ?_⟩
  rw [(oneParameterCurve_hasMFDerivAt_zero v).mfderiv]
  change (1 : ℝ) • v = v
  exact one_smul ℝ v

/-- All tangent vectors are realized by ambient curves in the whole group. -/
@[simp] theorem subgroupTangentSet_top :
    subgroupTangentSet (I := I) (⊤ : Subgroup G) = Set.univ := by
  apply Set.eq_univ_of_forall
  intro v
  exact mem_subgroupTangentSet_of_oneParameterCurve ⊤ v (fun _ => Subgroup.mem_top _)

/-- A smooth homomorphism realizes each vector in its identity differential range by a
curve lying in its image subgroup. Only the source needs the hypotheses for constructing
global one-parameter curves. -/
theorem homLieDifferential_mem_subgroupTangentSet_range (f : G →* K)
    (hf : ContMDiff I J ∞ (fun x => f x)) (v : GroupLieAlgebra I G) :
    homLieDifferential (I := I) (J := J) f v ∈
      subgroupTangentSet (I := J) f.range := by
  have hv : v ∈ subgroupTangentSet (I := I) (⊤ : Subgroup G) := by simp
  simpa only [← f.range_eq_map] using
    homLieDifferential_mem_subgroupTangentSet_map f hf ⊤ hv

/-- The differential range is contained in the ambient curve tangent set of the image. -/
theorem range_homLieDifferential_subset_subgroupTangentSet (f : G →* K)
    (hf : ContMDiff I J ∞ (fun x => f x)) :
    Set.range (homLieDifferential (I := I) (J := J) f) ⊆
      subgroupTangentSet (I := J) f.range := by
  rintro _ ⟨v, rfl⟩
  exact homLieDifferential_mem_subgroupTangentSet_range f hf v

end OneParameter

end LieGroups

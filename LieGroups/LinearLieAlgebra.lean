import LieGroups.HomomorphismLieAlgebra
import LieGroups.OneParameterSubgroup
import Mathlib.Geometry.Manifold.Instances.UnitsOfNormedAlgebra
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-!
# Lie algebras of groups of units

The identity tangent space of the units of a complete normed real algebra is
identified with the algebra, with its commutator bracket.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open scoped ContDiff Manifold

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

attribute [local instance] LieRing.ofAssociativeRing

variable {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]

set_option backward.isDefEq.respectTransparency false in
/-- In the units chart, the preferred identity tangent coordinates are the
derivative of the inclusion into the ambient algebra. -/
theorem units_lieAlgebraModelEquiv_eq_mfderiv_val :
    (lieAlgebraModelEquiv (I := 𝓘(ℝ, A)) (G := Aˣ) :
      GroupLieAlgebra 𝓘(ℝ, A) Aˣ →L[ℝ] A) =
    mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) 1 := by
  unfold lieAlgebraModelEquiv VectorBundle.continuousLinearEquivAt
  rw [Bundle.Trivialization.coe_continuousLinearEquivAt_eq']
  rw [TangentBundle.continuousLinearMapAt_trivializationAt (mem_chart_source A (1 : Aˣ))]
  rfl

/-- The ambient linear vector field associated with a velocity by left translation. -/
def algebraLeftInvariantField (v : A) (a : A) : TangentSpace 𝓘(ℝ, A) a :=
  (NormedSpace.fromTangentSpace a).symm (a * v)

set_option backward.isDefEq.respectTransparency false in
omit [CompleteSpace A] in
theorem contMDiff_algebraLeftInvariantField (v : A) :
    ContMDiff 𝓘(ℝ, A) (𝓘(ℝ, A).prod 𝓘(ℝ, A)) ∞
      (T% (algebraLeftInvariantField v)) := by
  rw [contMDiff_vectorSpace_iff_contDiff]
  change ContDiff ℝ ∞ (fun a : A => a * v)
  exact contDiff_id.mul contDiff_const

set_option backward.isDefEq.respectTransparency false in
omit [CompleteSpace A] in
theorem mlieBracket_algebraLeftInvariantField (v w a : A) :
    VectorField.mlieBracket 𝓘(ℝ, A) (algebraLeftInvariantField v)
      (algebraLeftInvariantField w) a =
    (NormedSpace.fromTangentSpace a).symm (a * (v * w - w * v)) := by
  rw [← VectorField.mlieBracketWithin_univ,
    VectorField.mlieBracketWithin_eq_lieBracketWithin,
    VectorField.lieBracketWithin_univ]
  change VectorField.lieBracket ℝ (fun b : A => b * v) (fun b : A => b * w) a =
    a * (v * w - w * v)
  rw [VectorField.lieBracket_eq]
  change fderiv ℝ ((ContinuousLinearMap.mul ℝ A).flip w) a (a * v) -
    fderiv ℝ ((ContinuousLinearMap.mul ℝ A).flip v) a (a * w) = _
  rw [ContinuousLinearMap.fderiv, ContinuousLinearMap.fderiv]
  simp only [ContinuousLinearMap.flip_apply, ContinuousLinearMap.mul_apply']
  rw [mul_sub, mul_assoc, mul_assoc]

set_option backward.isDefEq.respectTransparency false in
/-- Inclusion of units relates its invariant field to the ambient linear field. -/
theorem mfderiv_val_mulInvariantVectorField
    (v : GroupLieAlgebra 𝓘(ℝ, A) Aˣ) (g : Aˣ) :
    mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) g
      (mulInvariantVectorField v g) =
    algebraLeftInvariantField (lieAlgebraModelEquiv v) (g : A) := by
  have hv : MDifferentiable 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) :=
    (Units.contMDiff_val (𝕜 := ℝ) (n := ∞)).mdifferentiable (by simp)
  have hl : MDifferentiable 𝓘(ℝ, A) 𝓘(ℝ, A) (fun a : A => (g : A) * a) :=
    ((ContinuousLinearMap.mul ℝ A (g : A)).contDiff (n := ∞)).contMDiff.mdifferentiable
      (by simp)
  have hc := mfderiv_comp (I := 𝓘(ℝ, A)) (I' := 𝓘(ℝ, A)) (I'' := 𝓘(ℝ, A))
    (1 : Aˣ) (hv (g * 1))
    (mdifferentiableAt_mul_left (I := 𝓘(ℝ, A)) (a := g) (b := (1 : Aˣ)))
  have he : (Units.val : Aˣ → A) ∘ (fun h : Aˣ => g * h) =
      (fun a : A => (g : A) * a) ∘ Units.val := by
    funext h
    rfl
  rw [he, mfderiv_comp (1 : Aˣ) (hl _) (hv _)] at hc
  have h := congrArg (fun T => T v) hc
  change (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (fun a : A => (g : A) * a) (1 : A))
      (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) Units.val 1 v) =
    (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) Units.val (g * 1))
      (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (fun h : Aˣ => g * h) 1 v) at h
  rw [mfderiv_eq_fderiv] at h
  change fderiv ℝ ((ContinuousLinearMap.mul ℝ A) (g : A)) 1
      ((mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) 1) v) =
    (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) Units.val (g * 1))
      (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (fun h : Aˣ => g * h) 1 v) at h
  rw [ContinuousLinearMap.fderiv] at h
  have hev := congrArg (fun T : GroupLieAlgebra 𝓘(ℝ, A) Aˣ →L[ℝ] A => T v)
    (units_lieAlgebraModelEquiv_eq_mfderiv_val (A := A))
  change lieAlgebraModelEquiv v =
    (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) 1) v at hev
  change (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) g)
      (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (fun b : Aˣ => g * b) 1 v) =
    (g : A) * lieAlgebraModelEquiv v
  convert! h.symm using 1
  · congr 2
    exact (mul_one g).symm
  · change (g : A) * lieAlgebraModelEquiv v =
      (g : A) * (NormedSpace.fromTangentSpace (1 : A))
        ((mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) 1) v)
    congr 1

set_option backward.isDefEq.respectTransparency false in
/-- The actual bracket of invariant fields on the group of units is the
commutator in its ambient algebra. -/
theorem units_lieAlgebraModelEquiv_map_lie
    (v w : GroupLieAlgebra 𝓘(ℝ, A) Aˣ) :
    lieAlgebraModelEquiv ⁅v, w⁆ = ⁅lieAlgebraModelEquiv v, lieAlgebraModelEquiv w⁆ := by
  have h := Manifold.mfderiv_mlieBracket_of_related
    (Units.contMDiff_val (𝕜 := ℝ) (n := ∞))
    (contMDiff_infty_mulInvariantVectorField v)
    (contMDiff_infty_mulInvariantVectorField w)
    (contMDiff_algebraLeftInvariantField (lieAlgebraModelEquiv v))
    (contMDiff_algebraLeftInvariantField (lieAlgebraModelEquiv w))
    (mfderiv_val_mulInvariantVectorField v) (mfderiv_val_mulInvariantVectorField w) (1 : Aˣ)
  have he := congrArg (fun T : GroupLieAlgebra 𝓘(ℝ, A) Aˣ →L[ℝ] A => T ⁅v, w⁆)
    (units_lieAlgebraModelEquiv_eq_mfderiv_val (A := A))
  change lieAlgebraModelEquiv ⁅v, w⁆ =
    (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) 1) ⁅v, w⁆ at he
  rw [he, GroupLieAlgebra.bracket_def]
  rw [h, mlieBracket_algebraLeftInvariantField]
  change (1 : A) * (lieAlgebraModelEquiv v * lieAlgebraModelEquiv w -
    lieAlgebraModelEquiv w * lieAlgebraModelEquiv v) = _
  rw [one_mul, Ring.lie_def]

/-- The Lie algebra of the actual smooth group of units, identified with the
commutator Lie algebra of the ambient complete normed real algebra. -/
def unitsLieAlgebraEquiv : GroupLieAlgebra 𝓘(ℝ, A) Aˣ ≃ₗ⁅ℝ⁆ A :=
  { (lieAlgebraModelEquiv (I := 𝓘(ℝ, A)) (G := Aˣ)).toLinearEquiv with
    map_lie' := fun {v w} => units_lieAlgebraModelEquiv_map_lie v w }

@[simp] theorem unitsLieAlgebraEquiv_apply (v : GroupLieAlgebra 𝓘(ℝ, A) Aˣ) :
    unitsLieAlgebraEquiv v = lieAlgebraModelEquiv v := rfl

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]

/-- In finite dimension, giving continuity to an endomorphism preserves its
commutator Lie bracket. -/
def endContinuousLieEquiv : Module.End ℝ V ≃ₗ⁅ℝ⁆ (V →L[ℝ] V) :=
  { (LinearMap.toContinuousLinearMap : Module.End ℝ V ≃ₗ[ℝ] (V →L[ℝ] V)) with
    map_lie' := fun {f g} => by
      ext v
      rfl }

@[simp] theorem endContinuousLieEquiv_apply (f : Module.End ℝ V) (v : V) :
    endContinuousLieEquiv f v = f v := rfl

/-- The Lie algebra of the general linear group is the endomorphism Lie algebra
with the usual commutator bracket. -/
def generalLinearLieAlgebraEquiv :
    GroupLieAlgebra 𝓘(ℝ, V →L[ℝ] V) (V →L[ℝ] V)ˣ ≃ₗ⁅ℝ⁆ Module.End ℝ V :=
  (unitsLieAlgebraEquiv (A := V →L[ℝ] V)).trans endContinuousLieEquiv.symm

end LieGroups

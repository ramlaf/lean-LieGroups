/-!
# Local smooth inversion from local smooth multiplication

The inverse function theorem applied to `(x, y) ↦ (x, x * y)` constructs the
inverse operation near the identity without assuming it is continuous.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set
open scoped Manifold ContDiff Topology

namespace LieGroups.Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

private def additionShear : (E × E) ≃L[ℝ] (E × E) where
  toFun p := (p.1, p.1 + p.2)
  invFun p := (p.1, p.2 - p.1)
  left_inv p := by ext <;> simp
  right_inv p := by ext <;> simp
  map_add' p q := by ext <;> simp [add_add_add_comm]
  map_smul' c p := by ext <;> simp [smul_add]
  continuous_toFun := continuous_fst.prodMk (continuous_fst.add continuous_snd)
  continuous_invFun := continuous_fst.prodMk (continuous_snd.sub continuous_fst)

/-- A smooth multiplication with a local two-sided identity has a smooth local right
inverse. The inverse is constructed by the inverse function theorem. -/
theorem exists_contDiffAt_local_right_inverse {m : E × E → E} {z : E}
    (hm : ContDiffAt ℝ ∞ m (z, z))
    (hleft : ∀ᶠ x in 𝓝 z, m (z, x) = x)
    (hright : ∀ᶠ x in 𝓝 z, m (x, z) = x) :
    ∃ k : E → E, k z = z ∧ ContDiffAt ℝ ∞ k z ∧
      ∀ᶠ x in 𝓝 z, m (x, k x) = z := by
  let F : E × E → E × E := fun p => (p.1, m p)
  have hmz : m (z, z) = z := hleft.self_of_nhds
  have hF : ContDiffAt ℝ ∞ F (z, z) := contDiffAt_fst.prodMk hm
  have hD := (hm.differentiableAt (by simp)).hasFDerivAt
  have hDl : (fderiv ℝ m (z, z)).comp (ContinuousLinearMap.inl ℝ E E) =
      ContinuousLinearMap.id ℝ E := by
    exact (hD.comp (f := fun x : E => (x, z)) z (hasFDerivAt_prodMk_left z z)).unique
      ((hasFDerivAt_id z).congr_of_eventuallyEq hright)
  have hDr : (fderiv ℝ m (z, z)).comp (ContinuousLinearMap.inr ℝ E E) =
      ContinuousLinearMap.id ℝ E := by
    exact (hD.comp z (hasFDerivAt_prodMk_right z z)).unique
      ((hasFDerivAt_id z).congr_of_eventuallyEq hleft)
  have hmap : (ContinuousLinearMap.fst ℝ E E).prod (fderiv ℝ m (z, z)) =
      (additionShear (E := E) : (E × E) →L[ℝ] (E × E)) := by
    apply ContinuousLinearMap.ext
    intro p
    apply Prod.ext
    · rfl
    · change fderiv ℝ m (z, z) p = p.1 + p.2
      have hl := congrArg (fun A : E →L[ℝ] E => A p.1) hDl
      have hr := congrArg (fun A : E →L[ℝ] E => A p.2) hDr
      calc
        fderiv ℝ m (z, z) p = fderiv ℝ m (z, z) ((p.1, 0) + (0, p.2)) := by
          congr 1; ext <;> simp
        _ = p.1 + p.2 := by rw [map_add]; exact congrArg₂ (· + ·) hl hr
  have hd : HasFDerivAt F (additionShear (E := E) : (E × E) →L[ℝ] (E × E))
      (z, z) := by
    rw [← hmap]
    exact hasFDerivAt_fst.prodMk hD
  let e := hF.toOpenPartialHomeomorph F hd (by simp)
  have he : (z, z) ∈ e.target := by
    simpa [F, hmz] using hF.image_mem_toOpenPartialHomeomorph_target hd (by simp)
  have he0 : e.symm (z, z) = (z, z) := by
    have hh := e.left_inv (hF.mem_toOpenPartialHomeomorph_source hd (by simp))
    have hz : e (z, z) = (z, z) := Prod.ext rfl hmz
    rwa [hz] at hh
  have hei : ContDiffAt ℝ ∞ e.symm (z, z) := by
    apply e.contDiffAt_symm he
    · rw [he0]; exact hd
    · rw [he0]; exact hF
  refine ⟨fun x => (e.symm (x, z)).2, congrArg Prod.snd he0, ?_, ?_⟩
  · exact contDiffAt_snd.comp z
      (hei.comp (f := fun x : E => (x, z)) z (contDiffAt_id.prodMk contDiffAt_const))
  · have hnear : ∀ᶠ x in 𝓝 z, (x, z) ∈ e.target :=
      (continuousAt_id.prodMk continuousAt_const).preimage_mem_nhds (e.open_target.mem_nhds he)
    filter_upwards [hnear] with x hx
    have hh := e.right_inv hx
    change ((e.symm (x, z)).1, m (e.symm (x, z))) = (x, z) at hh
    have hfirst := congrArg Prod.fst hh
    have hsecond := congrArg Prod.snd hh
    calc
      m (x, (e.symm (x, z)).2) = m (e.symm (x, z)) :=
        congrArg m (Prod.ext hfirst.symm rfl)
      _ = z := hsecond

variable {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G]

/-- In a smooth coordinate neighborhood of the identity, smooth multiplication alone
implies smooth inversion at the identity. -/
theorem contMDiffAt_inv_of_mul_at_one
    (c : PartialDiffeomorph I 𝓘(ℝ, E) G E ∞) (hc : (1 : G) ∈ c.source)
    (hmul : ContMDiffAt (I.prod I) I ∞ (fun p : G × G => p.1 * p.2) (1, 1)) :
    ContMDiffAt I I ∞ (fun x : G => x⁻¹) 1 := by
  let z := c (1 : G)
  have hz : z ∈ c.target := c.map_source hc
  have hci : c.toPartialEquiv.symm z = 1 := c.left_inv hc
  have hc' : ContMDiffAt I 𝓘(ℝ, E) ∞ c 1 :=
    c.contMDiffOn_toFun.contMDiffAt (c.open_source.mem_nhds hc)
  have hci' : ContMDiffAt 𝓘(ℝ, E) I ∞ c.toPartialEquiv.symm z :=
    c.contMDiffOn_invFun.contMDiffAt (c.open_target.mem_nhds hz)
  let m : E × E → E := fun p => c (c.toPartialEquiv.symm p.1 * c.toPartialEquiv.symm p.2)
  have hm : ContDiffAt ℝ ∞ m (z, z) := by
    apply contMDiffAt_iff_contDiffAt.mp
    have hp : ContMDiffAt 𝓘(ℝ, E × E) (I.prod I) ∞
        (fun p : E × E => (c.toPartialEquiv.symm p.1, c.toPartialEquiv.symm p.2)) (z, z) := by
      rw [modelWithCornersSelf_prod, ← chartedSpaceSelf_prod]
      exact (hci'.comp (z, z) contMDiffAt_fst).prodMk
        (hci'.comp (z, z) contMDiffAt_snd)
    have hh := hmul.comp_of_eq hp (by simp [hci])
    exact hc'.comp_of_eq hh (by simp [hci])
  have hl : ∀ᶠ x in 𝓝 z, m (z, x) = x := by
    filter_upwards [c.open_target.mem_nhds hz] with x hx
    simpa only [m, hci, one_mul] using c.right_inv hx
  have hr : ∀ᶠ x in 𝓝 z, m (x, z) = x := by
    filter_upwards [c.open_target.mem_nhds hz] with x hx
    simpa only [m, hci, mul_one] using c.right_inv hx
  obtain ⟨k, hkz, hk, hmk⟩ := exists_contDiffAt_local_right_inverse hm hl hr
  have hκ : ContMDiffAt I I ∞ (fun x => c.toPartialEquiv.symm (k (c x))) 1 :=
    hci'.comp_of_eq (hk.contMDiffAt.comp 1 hc') hkz
  have hκ1 : c.toPartialEquiv.symm (k (c 1)) = 1 := by rw [show c 1 = z from rfl, hkz, hci]
  have hp : ContMDiffAt I I ∞ (fun x => x * c.toPartialEquiv.symm (k (c x))) 1 :=
    hmul.comp_of_eq (contMDiffAt_id.prodMk hκ) (by simp [hκ1])
  have hnear := hc'.continuousAt.preimage_mem_nhds hmk
  have hsource := hp.continuousAt.preimage_mem_nhds
    (show c.source ∈ 𝓝 ((1 : G) * c.toPartialEquiv.symm (k (c 1))) by
      simpa [hκ1] using c.open_source.mem_nhds hc)
  apply hκ.congr_of_eventuallyEq
  filter_upwards [hnear, hsource, c.open_source.mem_nhds hc] with x hx hxs hxc
  have hxe : c (x * c.toPartialEquiv.symm (k (c x))) = c 1 := by
    change m (c x, k (c x)) = z at hx
    simpa only [m, c.left_inv hxc] using hx
  have hprod : x * c.toPartialEquiv.symm (k (c x)) = 1 := c.injOn hxs hc hxe
  apply mul_left_cancel (a := x)
  simpa only [mul_inv_cancel] using hprod.symm

/-- A connected boundaryless manifold group is a Lie group if left translations are
smooth and multiplication is smooth on a neighborhood of the identity. -/
theorem lieGroup_of_local_mul [IsManifold I ∞ G] [BoundarylessManifold I G]
    [PreconnectedSpace G]
    (hleft : ∀ g : G, ContMDiff I I ∞ (fun x : G => g * x))
    {U : Set G} (hU : U ∈ 𝓝 (1 : G))
    (hmul : ContMDiffOn (I.prod I) I ∞ (fun p : G × G => p.1 * p.2) (U ×ˢ U)) :
    LieGroup I ∞ G := by
  apply lieGroup_of_local_operations hleft hU hmul
  apply contMDiffAt_inv_of_mul_at_one (extChartAtInteriorPartialDiffeomorph (I := I) 1)
  · exact ⟨mem_extChartAt_source 1,
      I.isInteriorPoint_iff.mp BoundarylessManifold.isInteriorPoint⟩
  · exact (hmul _ ⟨mem_of_mem_nhds hU, mem_of_mem_nhds hU⟩).contMDiffAt
      (prod_mem_nhds hU hU)

end LieGroups.Manifold

import Mathlib.Geometry.Manifold.LocalDiffeomorph

/-!
# Extended charts on the interior of their targets

The extended chart of a manifold with corners is a partial equivalence, whose
target need not be open. Restricting to its target interior gives an open partial
homeomorphism, suitable for local inverse constructions.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-05.
-/

open Set
open scoped ContDiff Manifold

namespace LieGroups.Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G]

/-- The extended chart restricted to the interior of its target is an open
partial homeomorphism. -/
noncomputable def extChartAtInterior (x : G) : OpenPartialHomeomorph G E where
  toPartialEquiv := {
    toFun := extChartAt I x
    invFun := (extChartAt I x).symm
    source := (extChartAt I x).source ∩ (extChartAt I x) ⁻¹' interior (extChartAt I x).target
    target := interior (extChartAt I x).target
    map_source' := by intro y hy; exact hy.2
    map_target' := by
      intro y hy
      have hy' := interior_subset hy
      refine ⟨(extChartAt I x).map_target hy', ?_⟩
      change extChartAt I x ((extChartAt I x).symm y) ∈ interior (extChartAt I x).target
      rwa [(extChartAt I x).right_inv hy']
    left_inv' := by intro y hy; exact (extChartAt I x).left_inv hy.1
    right_inv' := by intro y hy; exact (extChartAt I x).right_inv (interior_subset hy)
  }
  open_source := isOpen_extChartAt_preimage' x isOpen_interior
  open_target := isOpen_interior
  continuousOn_toFun := (continuousOn_extChartAt x).mono inter_subset_left
  continuousOn_invFun := (continuousOn_extChartAt_symm x).mono interior_subset

end LieGroups.Manifold

namespace LieGroups.Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [IsManifold I ∞ G]

/-- The restriction of a smooth extended chart to the interior of its target
is a smooth partial diffeomorphism. -/
noncomputable def extChartAtInteriorPartialDiffeomorph (x : G) :
    PartialDiffeomorph I 𝓘(ℝ, E) G E ∞ := by
  let χ := extChartAtInterior (I := I) x
  exact {
    toPartialEquiv := χ.toPartialEquiv
    open_source := χ.open_source
    open_target := χ.open_target
    contMDiffOn_toFun := by
      change ContMDiffOn I 𝓘(ℝ, E) ∞ (extChartAt I x) χ.source
      apply (contMDiffOn_extChartAt (I := I) (n := ∞)).mono
      intro y hy
      simpa only [extChartAt_source] using hy.1
    contMDiffOn_invFun := by
      change ContMDiffOn 𝓘(ℝ, E) I ∞ (extChartAt I x).symm χ.target
      exact (contMDiffOn_extChartAt_symm (I := I) (n := ∞) x).mono interior_subset
  }

end LieGroups.Manifold

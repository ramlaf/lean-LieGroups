import LieGroups.Manifold.FoliationAtlas
import Mathlib.Geometry.Manifold.Immersion

/-!
# Immersed inclusion of the intrinsic leafwise manifold

The plaque coordinates constructed in `FoliationAtlas` put the inclusion in the exact
immersion normal form. The supplied continuous linear equivalence only identifies the
horizontal and transverse model product with the ambient model.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups.Manifold.FoliationAtlas

variable {E P Q : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  (A : FoliationAtlas (P := P) (Q := Q) I M)

private def transverseShift (z : Q) : Diffeomorph 𝓘(ℝ, P × Q) 𝓘(ℝ, P × Q)
    (P × Q) (P × Q) ∞ where
  toEquiv := (Homeomorph.subRight (0, z)).toEquiv
  contMDiff_toFun := (contDiff_id.sub contDiff_const).contMDiff
  contMDiff_invFun := (contDiff_id.add contDiff_const).contMDiff

private def modelDiffeomorph [I.Boundaryless] : Diffeomorph I 𝓘(ℝ, E) H E ∞ where
  toEquiv := I.toHomeomorph.toEquiv
  contMDiff_toFun := I.contMDiff
  contMDiff_invFun := by
    have h := I.contMDiffOn_symm (n := ∞)
    rw [I.range_eq_univ] at h
    exact contMDiffOn_univ.mp h

private def transverseModel [I.Boundaryless] (L : (P × Q) ≃L[ℝ] E) (z : Q) :
    Diffeomorph 𝓘(ℝ, P × Q) I (P × Q) H ∞ :=
  ((transverseShift z).trans L.toDiffeomorph).trans (modelDiffeomorph (I := I)).symm

private def immersionChart [I.Boundaryless] (L : (P × Q) ≃L[ℝ] E) (a : M) (z : Q) :
    PartialDiffeomorph I I M H ∞ :=
  (A.chart a).trans (transverseModel (I := I) L z).toPartialDiffeomorph

private theorem immersionChart_source [I.Boundaryless] (L : (P × Q) ≃L[ℝ] E)
    (a : M) (z : Q) : (A.immersionChart L a z).source = (A.chart a).source := by
  ext y
  change (y ∈ (A.chart a).source ∧ (A.chart a) y ∈ (Set.univ : Set (P × Q))) ↔ _
  simp

private theorem immersionChart_extend_apply [I.Boundaryless] (L : (P × Q) ≃L[ℝ] E)
    (a : M) (z : Q) (y : M) :
    I ((A.immersionChart L a z) y) = L ((A.chart a) y - (0, z)) := by
  exact I.toHomeomorph.apply_symm_apply _

/-- The canonical inclusion has the actual immersion normal form in plaque coordinates. -/
theorem isImmersionOfComplement_toAmbient [IsManifold I ∞ M] [I.Boundaryless]
    (L : (P × Q) ≃L[ℝ] E) :
    _root_.Manifold.IsImmersionOfComplement Q 𝓘(ℝ, P) I ∞ A.toAmbient := by
  intro x
  let a : M := A.toAmbient x
  let z := ((A.chart a) a).2
  let c := A.plaqueChart a z
  let d := A.immersionChart L a z
  have hc : x ∈ c.source := ⟨A.mem_source a, rfl⟩
  have hd : A.toAmbient x ∈ d.source := by
    change A.toAmbient x ∈ (A.immersionChart L a z).source
    rw [A.immersionChart_source]
    exact A.mem_source a
  refine _root_.Manifold.IsImmersionAtOfComplement.mk_of_charts L c
    d.toOpenPartialHomeomorph hc hd
    (IsManifold.subset_maximalAtlas (A.plaqueChart_mem_atlas a z))
    (d.toOpenPartialHomeomorph.mem_maximalAtlas_of_contMDiffOn
      d.contMDiffOn_toFun d.contMDiffOn_invFun) ?_ ?_
  · intro y hy
    change A.toAmbient y ∈ (A.immersionChart L a z).source
    rw [A.immersionChart_source]
    exact hy.1
  · intro u hu
    have hu' : u ∈ c.target := by simpa only [mfld_simps] using hu
    change I ((A.immersionChart L a z) (A.toAmbient (c.symm u))) = L (u, 0)
    rw [A.immersionChart_extend_apply]
    have hright : (A.chart a) ((A.chart a).symm (u, z)) = (u, z) :=
      (A.chart a).right_inv hu'
    change L ((A.chart a) ((A.chart a).symm (u, z)) - (0, z)) = L (u, 0)
    rw [hright]
    simp

/-- The leafwise inclusion is an immersion, with no subspace-topology assumption. -/
theorem isImmersion_toAmbient [IsManifold I ∞ M] [I.Boundaryless]
    (L : (P × Q) ≃L[ℝ] E) :
    _root_.Manifold.IsImmersion 𝓘(ℝ, P) I ∞ A.toAmbient :=
  (A.isImmersionOfComplement_toAmbient L).isImmersion

/-- Restricting to a connected intrinsic leaf preserves the immersion normal form. -/
theorem isImmersionOfComplement_leafInclusion [IsManifold I ∞ M] [I.Boundaryless]
    (L : (P × Q) ≃L[ℝ] E) (x : A.Leafwise) :
    _root_.Manifold.IsImmersionOfComplement Q 𝓘(ℝ, P) I ∞ (A.leafInclusion x) := by
  intro y
  let a := A.leafInclusion x y
  let z := ((A.chart a) a).2
  let c := A.plaqueChart a z
  let e := c.subtypeRestr (s := A.leaf x) ⟨y⟩
  let d := A.immersionChart L a z
  have hc : (y : A.Leafwise) ∈ c.source := ⟨A.mem_source a, rfl⟩
  have he : y ∈ e.source := by
    change y ∈ (c.subtypeRestr (s := A.leaf x) ⟨y⟩).source
    erw [OpenPartialHomeomorph.subtypeRestr_source]
    exact hc
  have hd : A.leafInclusion x y ∈ d.source := by
    change a ∈ (A.immersionChart L a z).source
    rw [A.immersionChart_source]
    exact A.mem_source a
  refine _root_.Manifold.IsImmersionAtOfComplement.mk_of_charts L e
    d.toOpenPartialHomeomorph he hd ?_
    (d.toOpenPartialHomeomorph.mem_maximalAtlas_of_contMDiffOn
      d.contMDiffOn_toFun d.contMDiffOn_invFun) ?_ ?_
  · exact StructureGroupoid.subtypeRestr_mem_maximalAtlas (A.plaqueChart_mem_atlas a z) ⟨y⟩
  · intro v hv
    change A.leafInclusion x v ∈ (A.immersionChart L a z).source
    rw [A.immersionChart_source]
    have hv' : (v : A.Leafwise) ∈ c.source := by
      change v ∈ (c.subtypeRestr (s := A.leaf x) ⟨y⟩).source at hv
      erw [OpenPartialHomeomorph.subtypeRestr_source] at hv
      exact hv
    exact hv'.1
  · intro u hu
    have hu' : u ∈ e.target := by simpa only [mfld_simps] using hu
    have hcu : u ∈ c.target := c.subtypeRestr_target_subset ⟨y⟩ hu'
    change I ((A.immersionChart L a z) (A.leafInclusion x (e.symm u))) = L (u, 0)
    rw [A.immersionChart_extend_apply]
    have hi : A.leafInclusion x (e.symm u) = A.toAmbient (c.symm u) :=
      congrArg A.toAmbient (c.subtypeRestr_symm_apply ⟨y⟩ hu')
    rw [hi]
    change L ((A.chart a) ((A.chart a).symm (u, z)) - (0, z)) = L (u, 0)
    have hright : (A.chart a) ((A.chart a).symm (u, z)) = (u, z) :=
      (A.chart a).right_inv hcu
    rw [hright]
    simp

/-- Every connected intrinsic leaf includes immersively into the ambient manifold. -/
theorem isImmersion_leafInclusion [IsManifold I ∞ M] [I.Boundaryless]
    (L : (P × Q) ≃L[ℝ] E) (x : A.Leafwise) :
    _root_.Manifold.IsImmersion 𝓘(ℝ, P) I ∞ (A.leafInclusion x) :=
  (A.isImmersionOfComplement_leafInclusion L x).isImmersion

end LieGroups.Manifold.FoliationAtlas

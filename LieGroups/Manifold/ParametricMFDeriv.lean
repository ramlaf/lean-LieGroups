import Mathlib.Geometry.Manifold.ContMDiffMFDeriv

/-!
# Applying derivatives of smooth families

The derivative in the second variable of a smooth family can be applied to a smooth
tangent vector along a parameter-dependent base point. When the output base point is
locally constant, the resulting vectors are smooth in its fixed tangent space.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section

open Bundle Filter
open scoped ContDiff Manifold Topology

namespace LieGroups.Manifold

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners 𝕜 F H'}
  {M' : Type*} [TopologicalSpace M'] [ChartedSpace H' M'] [IsManifold I' ∞ M']
  {P : Type*} [NormedAddCommGroup P] [NormedSpace 𝕜 P]
  {H'' : Type*} [TopologicalSpace H''] {J : ModelWithCorners 𝕜 P H''}
  {N : Type*} [TopologicalSpace N] [ChartedSpace H'' N] [IsManifold J ∞ N]

set_option backward.isDefEq.respectTransparency false in
/-- Applying the second-variable derivative of a smooth family to a smooth tangent
vector along its input base map gives a smooth map into the output tangent bundle. -/
theorem contMDiffAt_parametricMFDeriv_apply
    (f : N → M → M') (g : N → M)
    (v : ∀ a : N, TangentSpace I (g a)) (a : N)
    (hf : ContMDiffAt (J.prod I) I' ∞ (Function.uncurry f) (a, g a))
    (hg : ContMDiffAt J I ∞ g a)
    (hv : ContMDiffAt J I.tangent ∞
      (fun b => TotalSpace.mk' E (g b) (v b)) a) :
    ContMDiffAt J I'.tangent ∞
      (fun b => TotalSpace.mk' F (f b (g b)) (mfderiv I I' (f b) (g b) (v b))) a := by
  have hderiv : ContMDiffAt J 𝓘(𝕜, E →L[𝕜] F) ∞
      (inTangentCoordinates I I' g (fun b => f b (g b))
        (fun b => mfderiv I I' (f b) (g b)) a) a :=
    hf.mfderiv (m := (∞ : ℕ∞ω)) f g hg (by simp)
  have hbase : ContMDiffAt J I' ∞ (fun b => f b (g b)) a :=
    hf.comp a (contMDiffAt_id.prodMk hg)
  exact ContMDiffAt.clm_apply_of_inCoordinates
    (E₁ := TangentSpace I) (E₂ := TangentSpace I')
    (F₁ := E) (F₂ := F) (b₁ := g) (b₂ := fun b => f b (g b))
    (ϕ := fun b => mfderiv I I' (f b) (g b)) (v := v) hderiv hv hbase

/-- Global version of `contMDiffAt_parametricMFDeriv_apply`. -/
theorem contMDiff_parametricMFDeriv_apply
    (f : N → M → M') (g : N → M)
    (v : ∀ a : N, TangentSpace I (g a))
    (hf : ContMDiff (J.prod I) I' ∞ (Function.uncurry f))
    (hg : ContMDiff J I ∞ g)
    (hv : ContMDiff J I.tangent ∞ (fun b => TotalSpace.mk' E (g b) (v b))) :
    ContMDiff J I'.tangent ∞
      (fun b => TotalSpace.mk' F (f b (g b)) (mfderiv I I' (f b) (g b) (v b))) := by
  intro a
  exact contMDiffAt_parametricMFDeriv_apply f g v a (hf (a, g a)) (hg a) (hv a)

/-- In the trivialization centered at its own base point, a tangent vector is unchanged. -/
theorem tangentTrivialization_self (x : M) (v : TangentSpace I x) :
    (trivializationAt E (TangentSpace I) x (TotalSpace.mk' E x v)).2 = v := by
  rw [← Trivialization.continuousLinearMapAt_apply_of_mem 𝕜
    (trivializationAt E (TangentSpace I) x)
    (FiberBundle.mem_baseSet_trivializationAt' x) v]
  rw [TangentBundle.continuousLinearMapAt_trivializationAt (mem_chart_source H x),
    mfderiv_extChartAt_self]
  rfl

omit [IsManifold J ∞ N] in
/-- If a smooth tangent-bundle map has locally constant base point, its vector component
is smooth as a map into that fixed tangent space. -/
theorem contMDiffAt_tangentVector_of_eventuallyConst
    (b : N → M) (v : ∀ a : N, TangentSpace I (b a)) (a : N) (o : M)
    (hv : ContMDiffAt J I.tangent ∞ (fun c => TotalSpace.mk' E (b c) (v c)) a)
    (hb : b =ᶠ[𝓝 a] fun _ => o) :
    ContMDiffAt J 𝓘(𝕜, E) ∞ (fun c => v c) a := by
  have hcoords := (contMDiffAt_totalSpace.mp hv).2
  have hba : b a = o := hb.self_of_nhds
  change ContMDiffAt J 𝓘(𝕜, E) ∞
    (fun c => (trivializationAt E (TangentSpace I) (b a)
      (TotalSpace.mk' E (b c) (v c))).2) a at hcoords
  rw [hba] at hcoords
  apply hcoords.congr_of_eventuallyEq
  filter_upwards [hb] with c hc
  have hp : (TotalSpace.mk' E (b c) (v c) : TangentBundle I M) =
      TotalSpace.mk' E o (v c) := by
    apply TotalSpace.ext hc
    rfl
  rw [hp]
  exact (tangentTrivialization_self (I := I) o (v c)).symm

/-- When the output of a smooth family at its varying input is locally constant, its
applied derivative is smooth into that fixed output tangent space. -/
theorem contMDiffAt_parametricMFDeriv_apply_const
    (f : N → M → M') (g : N → M)
    (v : ∀ a : N, TangentSpace I (g a)) (a : N) (o : M')
    (hf : ContMDiffAt (J.prod I) I' ∞ (Function.uncurry f) (a, g a))
    (hg : ContMDiffAt J I ∞ g a)
    (hv : ContMDiffAt J I.tangent ∞
      (fun b => TotalSpace.mk' E (g b) (v b)) a)
    (ho : (fun b => f b (g b)) =ᶠ[𝓝 a] fun _ => o) :
    ContMDiffAt J 𝓘(𝕜, F) ∞
      (fun b => mfderiv I I' (f b) (g b) (v b)) a := by
  exact contMDiffAt_tangentVector_of_eventuallyConst
    (fun b => f b (g b)) (fun b => mfderiv I I' (f b) (g b) (v b)) a o
    (contMDiffAt_parametricMFDeriv_apply f g v a hf hg hv) ho

end LieGroups.Manifold

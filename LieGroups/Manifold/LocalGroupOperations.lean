import Mathlib.Geometry.Manifold.Algebra.LieGroup
import Mathlib.Topology.Connected.Clopen

/-!
# Globalizing local smooth group operations

On a connected manifold group, smooth left translations and smooth group operations
near the identity suffice to make all group operations smooth. No continuity of the
group operations is assumed in advance.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open scoped Manifold ContDiff Topology
open Set

namespace LieGroups.Manifold

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G]

/-- Smooth right translations, together with their inverses, form a subgroup. -/
def smoothRightTranslations : Subgroup G where
  carrier := {g | ContMDiff I I ∞ (fun x : G => x * g) ∧
    ContMDiff I I ∞ (fun x : G => x * g⁻¹)}
  one_mem' := by
    constructor <;> intro x <;> simp only [inv_one, mul_one] <;> exact contMDiffAt_id
  mul_mem' := by
    intro a b ha hb
    exact ⟨by simpa [Function.comp_def, mul_assoc] using hb.1.comp ha.1,
      by simpa [Function.comp_def, mul_assoc] using ha.2.comp hb.2⟩
  inv_mem' := by intro a ha; simpa using And.intro ha.2 ha.1

/-- Left translations are homeomorphisms once they are smooth. -/
def leftTranslationHomeomorph
    (hleft : ∀ g : G, ContMDiff I I ∞ (fun x : G => g * x)) (g : G) : G ≃ₜ G where
  toEquiv := Equiv.mulLeft g
  continuous_toFun := (hleft g).continuous
  continuous_invFun := (hleft g⁻¹).continuous

/-- Smoothness of a right translation at the identity propagates by left translations. -/
theorem contMDiff_mul_right_of_at_one
    (hleft : ∀ g : G, ContMDiff I I ∞ (fun x : G => g * x)) {b : G}
    (hb : ContMDiffAt I I ∞ (fun x : G => x * b) 1) :
    ContMDiff I I ∞ (fun x : G => x * b) := by
  intro x
  have h := (hleft x).contMDiffAt.comp x
    (hb.comp_of_eq (hleft x⁻¹).contMDiffAt (by simp))
  simpa [Function.comp_def, mul_assoc] using h

/-- A subgroup containing an identity neighborhood is clopen if left translations are
homeomorphisms; joint continuity of multiplication is unnecessary. -/
theorem isClopen_subgroup_of_mem_nhds
    (hleft : ∀ g : G, ContMDiff I I ∞ (fun x : G => g * x))
    (K : Subgroup G) (hK : (K : Set G) ∈ 𝓝 (1 : G)) : IsClopen (K : Set G) := by
  have hopen : IsOpen (K : Set G) := isOpen_iff_mem_nhds.mpr fun x hx => by
    have h := (leftTranslationHomeomorph hleft x).isOpenMap.image_mem_nhds hK
    change (fun y : G => x * y) '' (K : Set G) ∈ 𝓝 (x * 1) at h
    rw [mul_one] at h
    exact Filter.mem_of_superset h (by rintro _ ⟨y, hy, rfl⟩; exact K.mul_mem hx hy)
  refine ⟨isOpen_compl_iff.mp (isOpen_iff_mem_nhds.mpr fun x hx => ?_), hopen⟩
  have h := (leftTranslationHomeomorph hleft x).isOpenMap.image_mem_nhds hK
  change (fun y : G => x * y) '' (K : Set G) ∈ 𝓝 (x * 1) at h
  rw [mul_one] at h
  exact Filter.mem_of_superset h (by
    rintro _ ⟨y, hy, rfl⟩ hxy
    exact hx (by simpa using K.mul_mem hxy (K.inv_mem hy)))

/-- Local multiplication and inversion globalize on a connected manifold group with
smooth left translations. -/
theorem lieGroup_of_local_operations [IsManifold I ∞ G] [PreconnectedSpace G]
    (hleft : ∀ g : G, ContMDiff I I ∞ (fun x : G => g * x))
    {U : Set G} (hU : U ∈ 𝓝 (1 : G))
    (hmul : ContMDiffOn (I.prod I) I ∞ (fun p : G × G => p.1 * p.2) (U ×ˢ U))
    (hinv : ContMDiffAt I I ∞ (fun x : G => x⁻¹) 1) : LieGroup I ∞ G := by
  have hright₀ : ∀ b ∈ U, ContMDiff I I ∞ (fun x : G => x * b) := by
    intro b hb
    apply contMDiff_mul_right_of_at_one hleft
    exact ((hmul (1, b) ⟨mem_of_mem_nhds hU, hb⟩).comp (f := fun x : G => (x, b)) 1
      (show ContMDiffWithinAt I (I.prod I) ∞ (fun x : G => (x, b)) U 1 from
        contMDiffWithinAt_id.prodMk contMDiffWithinAt_const)
      (by intro x hx; exact ⟨hx, hb⟩)).contMDiffAt hU
  have hK : ((smoothRightTranslations (I := I) : Subgroup G) : Set G) ∈ 𝓝 (1 : G) := by
    have hi : (fun x : G => x⁻¹) ⁻¹' U ∈ 𝓝 (1 : G) := by
      simpa using hinv.continuousAt.preimage_mem_nhds (by simpa using hU)
    exact Filter.mem_of_superset (Filter.inter_mem hU hi) (fun x hx =>
      ⟨hright₀ x hx.1, hright₀ x⁻¹ hx.2⟩)
  have hall := (isClopen_subgroup_of_mem_nhds hleft
    (smoothRightTranslations (I := I)) hK).eq_univ ⟨1, Subgroup.one_mem _⟩
  have hright : ∀ b : G, ContMDiff I I ∞ (fun x : G => x * b) := by
    intro b
    have hb : b ∈ smoothRightTranslations (I := I) := by
      change b ∈ ((smoothRightTranslations (I := I) : Subgroup G) : Set G)
      rw [hall]; trivial
    exact hb.1
  have hm : ContMDiffAt (I.prod I) I ∞ (fun p : G × G => p.1 * p.2) (1, 1) :=
    (hmul _ ⟨mem_of_mem_nhds hU, mem_of_mem_nhds hU⟩).contMDiffAt (prod_mem_nhds hU hU)
  refine { contMDiff_mul := ?_, contMDiff_inv := ?_ }
  · intro p
    have hnormalize : ContMDiffAt (I.prod I) (I.prod I) ∞
        (fun q : G × G => (p.1⁻¹ * q.1, q.2 * p.2⁻¹)) p :=
      ((hleft p.1⁻¹).comp contMDiff_fst).contMDiffAt.prodMk
        ((hright p.2⁻¹).comp contMDiff_snd).contMDiffAt
    have h := (hright p.2).contMDiffAt.comp p
      ((hleft p.1).contMDiffAt.comp p
        (hm.comp_of_eq hnormalize (by simp)))
    simpa [Function.comp_def, mul_assoc] using h
  · intro x
    have h := (hright x⁻¹).contMDiffAt.comp x
      (hinv.comp_of_eq (hleft x⁻¹).contMDiffAt (by simp))
    simpa [Function.comp_def, mul_assoc] using h

end LieGroups.Manifold

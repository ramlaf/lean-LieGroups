import LieGroups.HomomorphismLieAlgebra
import Mathlib.Geometry.Manifold.Diffeomorph
import Mathlib.AlgebraicTopology.FundamentalGroupoid.SimplyConnected

/-!
# Changing a manifold's vector-space model

Postcomposing charts with a continuous linear equivalence changes a self-modeled
manifold to an equivalent vector-space model. The carrier, topology, and group
operations are retained; the identity is smooth in both directions.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Set Function Filter
open scoped ContDiff Manifold Topology

namespace LieGroups.Manifold

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {P E : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P]
  [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The same carrier with charts postcomposed by a change of vector-space model. -/
def Recharted (_e : P ≃L[ℝ] E) (M : Type*) : Type _ := M

namespace Recharted

variable (e : P ≃L[ℝ] E) (M : Type*)

instance [Group M] : Group (Recharted e M) := inferInstanceAs (Group M)
instance [TopologicalSpace M] : TopologicalSpace (Recharted e M) :=
  inferInstanceAs (TopologicalSpace M)
instance [TopologicalSpace M] [T2Space M] : T2Space (Recharted e M) :=
  inferInstanceAs (T2Space M)
instance [TopologicalSpace M] [SecondCountableTopology M] :
    SecondCountableTopology (Recharted e M) := inferInstanceAs (SecondCountableTopology M)
instance [TopologicalSpace M] [ConnectedSpace M] : ConnectedSpace (Recharted e M) :=
  inferInstanceAs (ConnectedSpace M)
instance [TopologicalSpace M] [SimplyConnectedSpace M] :
    SimplyConnectedSpace (Recharted e M) := inferInstanceAs (SimplyConnectedSpace M)

/-- Identity on the underlying carrier. -/
def toOriginal : Recharted e M → M := id

/-- The inverse identity on the underlying carrier. -/
def fromOriginal : M → Recharted e M := id

variable [TopologicalSpace M] [ChartedSpace P M]

private def chart (a : M) : OpenPartialHomeomorph (Recharted e M) E :=
  (chartAt P a).transHomeomorph e.toHomeomorph

instance : ChartedSpace E (Recharted e M) where
  atlas := range (chart e M)
  chartAt := chart e M
  mem_chart_source a := mem_chart_source P (toOriginal e M a)
  chart_mem_atlas a := ⟨a, rfl⟩

@[simp] theorem extChartAt_apply (a x : Recharted e M) :
    extChartAt 𝓘(ℝ, E) a x = e (extChartAt 𝓘(ℝ, P) (toOriginal e M a)
      (toOriginal e M x)) := rfl

@[simp] theorem extChartAt_symm_apply (a : Recharted e M) (u : E) :
    (extChartAt 𝓘(ℝ, E) a).symm u =
      fromOriginal e M ((extChartAt 𝓘(ℝ, P) (toOriginal e M a)).symm (e.symm u)) := rfl

/-- The identity to the original manifold is smooth. -/
theorem contMDiff_toOriginal :
    ContMDiff 𝓘(ℝ, E) 𝓘(ℝ, P) ∞ (toOriginal e M) := by
  intro a
  rw [contMDiffAt_iff]
  refine ⟨continuousAt_id, ?_⟩
  apply ContDiffAt.contDiffWithinAt
  apply e.symm.contDiff.contDiffAt.congr_of_eventuallyEq
  filter_upwards [(chartAt E a).open_target.mem_nhds (mem_chart_target E a)] with u hu
  change (chartAt P (toOriginal e M a))
    ((chartAt P (toOriginal e M a)).symm (e.symm u)) = e.symm u
  exact (chartAt P (toOriginal e M a)).right_inv hu

/-- The identity from the original manifold is smooth. -/
theorem contMDiff_fromOriginal :
    ContMDiff 𝓘(ℝ, P) 𝓘(ℝ, E) ∞ (fromOriginal e M) := by
  intro a
  rw [contMDiffAt_iff]
  refine ⟨continuousAt_id, ?_⟩
  apply ContDiffAt.contDiffWithinAt
  apply e.contDiff.contDiffAt.congr_of_eventuallyEq
  filter_upwards [(chartAt P a).open_target.mem_nhds (mem_chart_target P a)] with u hu
  change e ((chartAt P a) ((chartAt P a).symm u)) = e u
  exact congrArg e ((chartAt P a).right_inv hu)

instance [IsManifold 𝓘(ℝ, P) ∞ M] : IsManifold 𝓘(ℝ, E) ∞ (Recharted e M) := by
  apply isManifold_of_contDiffOn
  rintro c c' ⟨a, rfl⟩ ⟨b, rfl⟩
  have h : ContDiffOn ℝ ∞ ((chartAt P a).symm ≫ₕ chartAt P b)
      ((chartAt P a).symm ≫ₕ chartAt P b).source := by
    have h := ((contDiffGroupoid ∞ 𝓘(ℝ, P)).compatible
      (chart_mem_atlas P a) (chart_mem_atlas P b)).1
    change ContDiffOn ℝ ∞
      (𝓘(ℝ, P) ∘ ((chartAt P a).symm ≫ₕ chartAt P b) ∘ 𝓘(ℝ, P).symm)
      (𝓘(ℝ, P).symm ⁻¹' ((chartAt P a).symm ≫ₕ chartAt P b).source ∩
        range 𝓘(ℝ, P)) at h
    simpa only [modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm,
      Function.comp_id, Function.id_comp, Set.range_id, Set.preimage_id, Set.inter_univ]
      using h
  simp only [modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm,
    Function.comp_id, Function.id_comp, Set.range_id, Set.preimage_id, Set.inter_univ] at h ⊢
  exact e.contDiff.comp_contDiffOn (h.comp e.symm.contDiff.contDiffOn (fun _ hu => hu))

/-- The actual diffeomorphism underlying the change of model. -/
def diffeomorph [IsManifold 𝓘(ℝ, P) ∞ M] :
    Diffeomorph 𝓘(ℝ, E) 𝓘(ℝ, P) (Recharted e M) M ∞ where
  toEquiv := Equiv.refl M
  contMDiff_toFun := contMDiff_toOriginal e M
  contMDiff_invFun := contMDiff_fromOriginal e M

variable [Group M] [LieGroup 𝓘(ℝ, P) ∞ M]

instance : LieGroup 𝓘(ℝ, E) ∞ (Recharted e M) where
  contMDiff_mul := by
    have ht : ContMDiff (𝓘(ℝ, E).prod 𝓘(ℝ, E))
        (𝓘(ℝ, P).prod 𝓘(ℝ, P)) ∞
        (fun p : Recharted e M × Recharted e M =>
          (toOriginal e M p.1, toOriginal e M p.2)) :=
      ((contMDiff_toOriginal e M).comp contMDiff_fst).prodMk
        ((contMDiff_toOriginal e M).comp contMDiff_snd)
    have hm : ContMDiff (𝓘(ℝ, P).prod 𝓘(ℝ, P)) 𝓘(ℝ, P) ∞
        (fun p : M × M => p.1 * p.2) := contMDiff_mul 𝓘(ℝ, P) ∞
    exact (contMDiff_fromOriginal e M).comp (hm.comp ht)
  contMDiff_inv := by
    have hi : ContMDiff 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ (fun x : M => x⁻¹) :=
      contMDiff_inv 𝓘(ℝ, P) ∞
    exact (contMDiff_fromOriginal e M).comp (hi.comp (contMDiff_toOriginal e M))

/-- Identity as a group equivalence. -/
def mulEquiv : Recharted e M ≃* M := MulEquiv.refl M

set_option backward.isDefEq.respectTransparency false in
/-- The actual differential Lie equivalence induced by changing the model. -/
def lieEquiv [CompleteSpace P] [CompleteSpace E] :
    GroupLieAlgebra 𝓘(ℝ, E) (Recharted e M) ≃ₗ⁅ℝ⁆ GroupLieAlgebra 𝓘(ℝ, P) M :=
  equivLieEquiv (mulEquiv e M) (contMDiff_toOriginal e M) (contMDiff_fromOriginal e M)

end Recharted

end LieGroups.Manifold

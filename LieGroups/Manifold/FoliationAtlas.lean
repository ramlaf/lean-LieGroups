import Mathlib.Geometry.Manifold.ContMDiff.Atlas
import Mathlib.Geometry.Manifold.LocalDiffeomorph
import Mathlib.Geometry.Manifold.Instances.Real

/-!
# Intrinsic chart gluing for a foliated atlas

Horizontal slices of compatible foliation charts are partial equivalences with open smooth
overlaps. They therefore construct a new topology and smooth atlas on the underlying set:
the leafwise topology. The ambient subspace topology is not used for the leafwise manifold.

The input consists of actual smooth ambient charts and their local preservation of plaques;
no topology or smooth structure on leaves is supplied.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups.Manifold

variable {E P Q : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
  (M : Type*) [TopologicalSpace M] [ChartedSpace H M]

/-- Smooth ambient coordinate charts whose horizontal slices are locally preserved on
overlaps. This is local foliation data, without a supplied leaf topology. -/
structure FoliationAtlas where
  chart : M → PartialDiffeomorph I 𝓘(ℝ, P × Q) M (P × Q) ∞
  mem_source : ∀ x, x ∈ (chart x).source
  transverse_locally_constant : ∀ (a b : M) (u : P) (z : Q),
    (u, z) ∈ (chart a).target → (chart a).symm (u, z) ∈ (chart b).source →
      ∀ᶠ v in 𝓝 u,
        ((chart b) ((chart a).symm (v, z))).2 =
          ((chart b) ((chart a).symm (u, z))).2

variable {I M}

namespace FoliationAtlas

variable (A : FoliationAtlas (P := P) (Q := Q) I M)

/-- A horizontal plaque, as a partial equivalence on the ambient underlying set. -/
def plaque (a : M) (z : Q) : PartialEquiv M P where
  toFun x := ((A.chart a) x).1
  invFun u := (A.chart a).symm (u, z)
  source := {x | x ∈ (A.chart a).source ∧ ((A.chart a) x).2 = z}
  target := {u | (u, z) ∈ (A.chart a).target}
  map_source' x hx := by
    have hpair : (((A.chart a) x).1, z) = (A.chart a) x :=
      Prod.ext rfl hx.2.symm
    change (((A.chart a) x).1, z) ∈ (A.chart a).target
    rw [hpair]
    exact (A.chart a).map_source hx.1
  map_target' u hu :=
    ⟨(A.chart a).map_target hu, congrArg Prod.snd ((A.chart a).right_inv hu)⟩
  left_inv' x hx := by
    have hpair : (((A.chart a) x).1, z) = (A.chart a) x :=
      Prod.ext rfl hx.2.symm
    rw [hpair]
    exact (A.chart a).left_inv hx.1
  right_inv' u hu := congrArg Prod.fst ((A.chart a).right_inv hu)

@[simp] theorem plaque_apply (a : M) (z : Q) (x : M) :
    A.plaque a z x = ((A.chart a) x).1 := rfl

@[simp] theorem plaque_symm_apply (a : M) (z : Q) (u : P) :
    (A.plaque a z).symm u = (A.chart a).symm (u, z) := rfl

/-- Plaque coordinate domains are open in the horizontal model. -/
theorem plaque_open_target (a : M) (z : Q) : IsOpen (A.plaque a z).target :=
  (A.chart a).open_target.preimage (continuous_id.prodMk continuous_const)

private theorem contMDiffAt_plaque_symm (a : M) (z : Q) (u : P)
    (hu : u ∈ (A.plaque a z).target) :
    ContMDiffAt 𝓘(ℝ, P) I ∞ (fun v => (A.plaque a z).symm v) u := by
  change ContMDiffAt 𝓘(ℝ, P) I ∞ (fun v : P => (A.chart a).symm (v, z)) u
  have hi : ContMDiffAt 𝓘(ℝ, P) 𝓘(ℝ, P × Q) ∞ (fun v : P => (v, z)) u :=
    (contDiff_id.prodMk contDiff_const).contMDiff.contMDiffAt
  exact ((A.chart a).contMDiffOn_invFun.contMDiffAt
    ((A.chart a).open_target.mem_nhds hu)).comp u hi

/-- Local preservation of transverse coordinates makes overlaps of plaques open. -/
theorem plaque_overlap_open (a b : M) (z w : Q) :
    IsOpen ((A.plaque a z).symm.trans (A.plaque b w)).source := by
  rw [isOpen_iff_mem_nhds]
  intro u hu
  change u ∈ (A.plaque a z).target ∧
    (A.plaque a z).symm u ∈ (A.plaque b w).source at hu
  have ht : ∀ᶠ v in 𝓝 u, v ∈ (A.plaque a z).target :=
    (A.plaque_open_target a z).mem_nhds hu.1
  have hs : ∀ᶠ v in 𝓝 u, (A.plaque a z).symm v ∈ (A.chart b).source :=
    (A.contMDiffAt_plaque_symm a z u hu.1).continuousAt.preimage_mem_nhds
      ((A.chart b).open_source.mem_nhds hu.2.1)
  have he := A.transverse_locally_constant a b u z hu.1 hu.2.1
  filter_upwards [ht, hs, he] with v hv hvs hve
  exact ⟨hv, hvs, hve.trans hu.2.2⟩

/-- Plaque coordinate changes are restrictions of smooth ambient coordinate changes. -/
theorem plaque_overlap_contDiff (a b : M) (z w : Q) :
    ContDiffOn ℝ ∞ ((A.plaque a z).symm.trans (A.plaque b w))
      ((A.plaque a z).symm.trans (A.plaque b w)).source := by
  intro u hu
  change u ∈ (A.plaque a z).target ∧
    (A.plaque a z).symm u ∈ (A.plaque b w).source at hu
  have hfirst : ContMDiffAt 𝓘(ℝ, P × Q) 𝓘(ℝ, P) ∞ Prod.fst
      ((A.chart b) ((A.plaque a z).symm u)) := contDiff_fst.contMDiff.contMDiffAt
  have hsecond := ((A.chart b).contMDiffOn_toFun.contMDiffAt
    ((A.chart b).open_source.mem_nhds hu.2.1)).comp u
      (A.contMDiffAt_plaque_symm a z u hu.1)
  have h := hfirst.comp u hsecond
  exact (contMDiffAt_iff_contDiffAt.mp h).contDiffWithinAt

/-- The horizontal plaques construct a charted-space core on the bare underlying set. -/
def core : ChartedSpaceCore P M where
  atlas := Set.range (fun p : M × Q => A.plaque p.1 p.2)
  chartAt x := A.plaque x ((A.chart x) x).2
  mem_chart_source x := ⟨A.mem_source x, rfl⟩
  chart_mem_atlas x := ⟨(x, ((A.chart x) x).2), rfl⟩
  open_source := by
    rintro e e' ⟨⟨a, z⟩, rfl⟩ ⟨⟨b, w⟩, rfl⟩
    exact A.plaque_overlap_open a b z w
  continuousOn_toFun := by
    rintro e e' ⟨⟨a, z⟩, rfl⟩ ⟨⟨b, w⟩, rfl⟩
    exact (A.plaque_overlap_contDiff a b z w).continuousOn

/-- The ambient underlying set equipped below with its intrinsic leafwise topology. -/
def Leafwise (_A : FoliationAtlas (P := P) (Q := Q) I M) := M

private def leafwiseCore : ChartedSpaceCore P A.Leafwise := A.core

instance : TopologicalSpace A.Leafwise := A.leafwiseCore.toTopologicalSpace

instance : ChartedSpace P A.Leafwise := A.leafwiseCore.toChartedSpace

/-- Smoothness of ambient chart transitions induces a genuine smooth manifold structure
for the topology generated by plaques. -/
instance : IsManifold 𝓘(ℝ, P) ∞ A.Leafwise := by
  apply isManifold_of_contDiffOn
  intro e e' he he'
  change e ∈ ⋃ (p : PartialEquiv A.Leafwise P) (hp : p ∈ A.leafwiseCore.atlas),
    {A.leafwiseCore.openPartialHomeomorph p hp} at he
  change e' ∈ ⋃ (p : PartialEquiv A.Leafwise P) (hp : p ∈ A.leafwiseCore.atlas),
    {A.leafwiseCore.openPartialHomeomorph p hp} at he'
  simp only [Set.mem_iUnion, Set.mem_singleton_iff] at he he'
  obtain ⟨p, hp, rfl⟩ := he
  obtain ⟨q, hq, rfl⟩ := he'
  obtain ⟨⟨a, z⟩, rfl⟩ := hp
  obtain ⟨⟨b, w⟩, rfl⟩ := hq
  simp only [modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm,
    Function.comp_id, Function.id_comp, Set.range_id, Set.preimage_id, Set.inter_univ]
  convert A.plaque_overlap_contDiff a b z w using 1 <;> rfl

/-- A plaque is a genuine open coordinate chart for the constructed topology. -/
def plaqueChart (a : M) (z : Q) : OpenPartialHomeomorph A.Leafwise P :=
  A.leafwiseCore.openPartialHomeomorph (A.plaque a z) ⟨(a, z), rfl⟩

theorem plaqueChart_mem_atlas (a : M) (z : Q) :
    A.plaqueChart a z ∈ atlas P A.Leafwise := by
  change A.plaqueChart a z ∈ ⋃ (p : PartialEquiv A.Leafwise P)
    (hp : p ∈ A.leafwiseCore.atlas), {A.leafwiseCore.openPartialHomeomorph p hp}
  simp only [Set.mem_iUnion, Set.mem_singleton_iff]
  exact ⟨A.plaque a z, ⟨(a, z), rfl⟩, rfl⟩

/-- The identity on underlying points, from the leafwise manifold to the ambient manifold. -/
def toAmbient : A.Leafwise → M := id

theorem toAmbient_injective : Function.Injective A.toAmbient := fun _ _ h => h

/-- Inclusion of the constructed leafwise manifold is smooth in its plaque coordinates. -/
theorem contMDiff_toAmbient : ContMDiff 𝓘(ℝ, P) I ∞ A.toAmbient := by
  intro x
  let z := ((A.chart x) x).2
  let c := A.plaqueChart x z
  have hx : x ∈ c.source := ⟨A.mem_source x, rfl⟩
  have hc : ContMDiffAt 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ c x :=
    contMDiffAt_of_mem_maximalAtlas
      (IsManifold.subset_maximalAtlas (A.plaqueChart_mem_atlas x z)) hx
  have hi := A.contMDiffAt_plaque_symm x z (c x) (c.map_source hx)
  apply (hi.comp x hc).congr_of_eventuallyEq
  filter_upwards [c.open_source.mem_nhds hx] with y hy
  exact (c.left_inv hy).symm

instance [T2Space M] : T2Space A.Leafwise :=
  T2Space.of_injective_continuous A.toAmbient_injective A.contMDiff_toAmbient.continuous

instance : LocallyConnectedSpace A.Leafwise := ChartedSpace.locallyConnectedSpace P A.Leafwise

/-- An intrinsic leaf is an open connected component of the constructed leafwise manifold. -/
def leaf (x : A.Leafwise) : TopologicalSpace.Opens A.Leafwise :=
  ⟨connectedComponent x, isOpen_connectedComponent⟩

instance (x : A.Leafwise) : ConnectedSpace (A.leaf x) :=
  isConnected_iff_connectedSpace.mp isConnected_connectedComponent

instance (x : A.Leafwise) : ChartedSpace P (A.leaf x) := inferInstance

instance (x : A.Leafwise) : IsManifold 𝓘(ℝ, P) ∞ (A.leaf x) := inferInstance

/-- The canonical inclusion of an intrinsic leaf into the ambient manifold. -/
def leafInclusion (x : A.Leafwise) : A.leaf x → M := fun y => A.toAmbient y

theorem leafInclusion_injective (x : A.Leafwise) : Function.Injective (A.leafInclusion x) :=
  A.toAmbient_injective.comp Subtype.val_injective

theorem contMDiff_leafInclusion (x : A.Leafwise) :
    ContMDiff 𝓘(ℝ, P) I ∞ (A.leafInclusion x) :=
  A.contMDiff_toAmbient.comp contMDiff_subtype_val

end FoliationAtlas

end LieGroups.Manifold

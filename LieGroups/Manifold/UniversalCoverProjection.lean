import DifferentialGeometry.Topology.Covering.Manifold
import Mathlib.Geometry.Manifold.LocalDiffeomorph

/-!
# Smooth lifting through the universal-cover projection

The existing universal-cover atlas makes the projection a local diffeomorphism.
The proof reads this directly from its charts and needs no inverse function
theorem. Continuous maps into the cover are smooth precisely when their
compositions with the projection are smooth.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open Set Function Filter
open scoped Topology ContDiff Manifold

namespace LieGroups.Manifold

open DifferentialGeometry.Geometry.Riemannian.Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [LocallyPathConnectedSpace M] [SemilocallySimplyConnectedSpace M] [Inhabited M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {N : Type*} [TopologicalSpace N] [ChartedSpace H' N]

omit [IsManifold I ∞ M] in
/-- A continuous lift into the actual universal cover is smooth if its
projection is smooth. -/
theorem contMDiffAt_universalCover_of_comp_projection
    {f : N → UniversalCover M} {x : N} (hc : ContinuousAt f x)
    (hf : ContMDiffAt J I ∞ (UniversalCover.proj ∘ f) x) :
    ContMDiffAt J I ∞ f x := by
  rw [contMDiffAt_iff_target]
  refine ⟨hc, ?_⟩
  have he : (extChartAt I (f x) : UniversalCover M → E) ∘ f =
      extChartAt I (UniversalCover.proj (f x)) ∘ (UniversalCover.proj ∘ f) := by
    funext y
    exact UniversalCover.extChartAt_proj_eq (I := I) (f x) (f y)
  rw [he]
  exact contMDiffAt_extChartAt.comp x hf

omit [IsManifold I ∞ M] in
/-- Smoothness of a continuous map into the universal cover can be checked
after projection. -/
theorem contMDiff_universalCover_of_comp_projection
    {f : N → UniversalCover M} (hc : Continuous f)
    (hf : ContMDiff J I ∞ (UniversalCover.proj ∘ f)) : ContMDiff J I ∞ f :=
  fun x => contMDiffAt_universalCover_of_comp_projection hc.continuousAt (hf x)

omit [IsManifold I ∞ M] in
/-- Every inverse sheet of the covering projection is smooth. -/
theorem contMDiffOn_universalCover_localSection_symm (a : UniversalCover M) :
    ContMDiffOn I I ∞ (UniversalCover.localSection a).symm
      (UniversalCover.localSection a).target := by
  intro y hy
  apply ContMDiffAt.contMDiffWithinAt
  apply contMDiffAt_universalCover_of_comp_projection
    ((UniversalCover.localSection a).symm.continuousAt hy)
  apply contMDiffAt_id.congr_of_eventuallyEq
  filter_upwards [(UniversalCover.localSection a).open_target.mem_nhds hy] with z hz
  change UniversalCover.proj ((UniversalCover.localSection a).symm z) = z
  rw [UniversalCover.proj_eq_localSection a]
  exact (UniversalCover.localSection a).right_inv hz

/-- The universal-cover projection is an actual smooth local diffeomorphism
for the atlas pulled back along its covering sheets. -/
theorem universalCoverProjection_isLocalDiffeomorph :
    IsLocalDiffeomorph I I ∞ (UniversalCover.proj : UniversalCover M → M) := by
  intro a
  let e := UniversalCover.localSection a
  let d : PartialDiffeomorph I I (UniversalCover M) M ∞ := {
    toPartialEquiv := e.toPartialEquiv
    open_source := e.open_source
    open_target := e.open_target
    contMDiffOn_toFun := by
      change ContMDiffOn I I ∞ (UniversalCover.localSection a)
        (UniversalCover.localSection a).source
      rw [← UniversalCover.proj_eq_localSection a]
      exact (UniversalCover.proj_contMDiff (I := I)).contMDiffOn
    contMDiffOn_invFun := contMDiffOn_universalCover_localSection_symm a
  }
  refine ⟨d, UniversalCover.mem_source_localSection a, ?_⟩
  intro x _
  exact congrFun (UniversalCover.proj_eq_localSection a) x

end LieGroups.Manifold

import LieGroups.Manifold.QuotientSlice
import LieGroups.Manifold.QuotientAtlas
import Mathlib.Topology.Algebra.Group.Quotient

/-!
# Quotient slices from embedded Lie subgroup data

Embeddedness shrinks a transverse multiplication chart so that different transverse
parameters represent different cosets. The resulting slice constructs quotient charts
without assuming a smooth quotient structure.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open Function Filter Set
open scoped Topology Manifold ContDiff

namespace LieGroups.Manifold

variable {E F Q : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]

/-- Embeddedness makes the transverse slice injective modulo the entire subgroup,
after shrinking its neighborhood. -/
theorem exists_transverse_neighborhood_injective_mod_subgroup
    (S : EmbeddedLieSubgroup I G J K) {σ : Q → G}
    (hσ : Continuous σ) (hσ0 : σ 0 = 1)
    (e : PartialDiffeomorph ((𝓘(ℝ, Q)).prod J) I (Q × K) G ∞)
    (he0 : (0, (1 : K)) ∈ e.source)
    (he : EqOn (fun p => σ p.1 * S.toMonoidHom p.2) e e.source) :
    ∃ V : Set Q, ∃ W : Set K,
      IsOpen V ∧ IsOpen W ∧ (0 : Q) ∈ V ∧ (1 : K) ∈ W ∧
      V ×ˢ W ⊆ e.source ∧
      ∀ p ∈ V, ∀ q ∈ V,
        (σ q)⁻¹ * σ p ∈ S.toImmersedLieSubgroup.subgroup → p = q := by
  let : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  obtain ⟨V₀, W, hV₀, hV₀0, hW, hW1, hVW⟩ :=
    mem_nhds_prod_iff'.mp (e.open_source.mem_nhds he0)
  have hWnhds := hW.mem_nhds hW1
  rw [S.isEmbedding.isInducing.nhds_eq_comap, S.toMonoidHom.map_one] at hWnhds
  obtain ⟨T, hT, hTW⟩ := Filter.mem_comap.mp hWnhds
  have hpair : ContinuousAt (fun p : Q × Q => (σ p.2)⁻¹ * σ p.1) (0, 0) :=
    ((hσ.comp continuous_snd).inv.mul (hσ.comp continuous_fst)).continuousAt
  have hnear : (fun p : Q × Q => (σ p.2)⁻¹ * σ p.1) ⁻¹' T ∈ 𝓝 (0, 0) :=
    hpair.preimage_mem_nhds (by simpa only [hσ0, inv_one, one_mul] using hT)
  obtain ⟨V₁, V₂, hV₁, hV₁0, hV₂, hV₂0, hV₁₂⟩ := mem_nhds_prod_iff'.mp hnear
  let V := V₀ ∩ V₁ ∩ V₂
  have hsub : V ×ˢ W ⊆ e.source := fun p hp => hVW ⟨hp.1.1.1, hp.2⟩
  refine ⟨V, W, (hV₀.inter hV₁).inter hV₂, hW, ⟨⟨hV₀0, hV₁0⟩, hV₂0⟩,
    hW1, hsub, ?_⟩
  intro p hp q hq hmem
  obtain ⟨k, hk⟩ := hmem
  have hkW : k ∈ W := hTW (by
    change S.toMonoidHom k ∈ T
    rw [hk]
    exact hV₁₂ (show (p, q) ∈ V₁ ×ˢ V₂ from ⟨hp.1.2, hq.2⟩))
  have hp1 : (p, (1 : K)) ∈ e.source := hsub ⟨hp, hW1⟩
  have hqk : (q, k) ∈ e.source := hsub ⟨hq, hkW⟩
  have heq : e (p, 1) = e (q, k) := by
    rw [← he hp1, ← he hqk]
    dsimp only
    rw [S.toMonoidHom.map_one, mul_one, hk]
    simp only [← mul_assoc, mul_inv_cancel, one_mul]
  exact congrArg Prod.fst (e.injOn hp1 hqk heq)

/-- A transverse multiplication chart and its embedded subgroup produce an actual
quotient slice for the ordinary coset projection. -/
theorem exists_quotientSlice_of_multiplication_chart
    (S : EmbeddedLieSubgroup I G J K) {σ : Q → G}
    (hσ : ContMDiff 𝓘(ℝ, Q) I ∞ σ) (hσ0 : σ 0 = 1)
    (e : PartialDiffeomorph ((𝓘(ℝ, Q)).prod J) I (Q × K) G ∞)
    (he0 : (0, (1 : K)) ∈ e.source)
    (he : EqOn (fun p => σ p.1 * S.toMonoidHom p.2) e e.source) :
    ∃ A : QuotientSlice (I := I) (P := Q)
        (QuotientGroup.mk : G → G ⧸ S.toImmersedLieSubgroup.subgroup),
      (1 : G) ∈ A.source ∧ (0 : Q) ∈ A.target ∧
      A.section_ = σ ∧ A.coordinate 1 = 0 := by
  obtain ⟨V, W, hV, hW, hV0, hW1, hVW, hinj⟩ :=
    exists_transverse_neighborhood_injective_mod_subgroup S hσ.continuous hσ0 e he0 he
  let U : Set G := e.target ∩ e.toPartialEquiv.symm ⁻¹' (V ×ˢ W)
  have hU : IsOpen U := e.toOpenPartialHomeomorph.isOpen_inter_preimage_symm (hV.prod hW)
  have hσe (p : Q) (hp : p ∈ V) : σ p = e (p, 1) := by
    simpa only [S.toMonoidHom.map_one, mul_one] using
      he (hVW (show (p, (1 : K)) ∈ V ×ˢ W from ⟨hp, hW1⟩))
  have hσinv (p : Q) (hp : p ∈ V) : e.toPartialEquiv.symm (σ p) = (p, 1) := by
    rw [hσe p hp]
    exact e.left_inv (hVW ⟨hp, hW1⟩)
  have hσmem (p : Q) (hp : p ∈ V) : σ p ∈ U := by
    refine ⟨?_, ?_⟩
    · rw [hσe p hp]
      exact e.map_source (hVW ⟨hp, hW1⟩)
    · change e.toPartialEquiv.symm (σ p) ∈ V ×ˢ W
      rw [hσinv p hp]
      exact ⟨hp, hW1⟩
  have hπ (x : G) (hx : x ∈ U) :
      (QuotientGroup.mk (σ (e.toPartialEquiv.symm x).1) :
        G ⧸ S.toImmersedLieSubgroup.subgroup) = QuotientGroup.mk x := by
    have heq : σ (e.toPartialEquiv.symm x).1 *
        S.toMonoidHom (e.toPartialEquiv.symm x).2 = x :=
      (he (e.map_target hx.1)).trans (e.right_inv hx.1)
    exact ((QuotientGroup.mk_mul_of_mem _
      (show S.toMonoidHom (e.toPartialEquiv.symm x).2 ∈ S.toImmersedLieSubgroup.subgroup
        from ⟨_, rfl⟩)).symm).trans (congrArg QuotientGroup.mk heq)
  let A : QuotientSlice (I := I) (P := Q)
      (QuotientGroup.mk : G → G ⧸ S.toImmersedLieSubgroup.subgroup) := {
    source := U
    target := V
    open_source := hU
    open_target := hV
    coordinate := fun x => (e.toPartialEquiv.symm x).1
    section_ := σ
    coordinate_smooth :=
      (contMDiff_fst.comp_contMDiffOn e.contMDiffOn_invFun).mono inter_subset_left
    section_smooth := hσ.contMDiffOn
    coordinate_mem := fun x hx => hx.2.1
    section_mem := hσmem
    coordinate_section := fun p hp => congrArg Prod.fst (hσinv p hp)
    section_coordinate := hπ
    coordinate_fiber := by
      intro x hx y hy hxy
      apply hinj _ hx.2.1 _ hy.2.1
      exact QuotientGroup.eq.mp ((hπ y hy).trans (hxy.symm.trans (hπ x hx).symm)) }
  refine ⟨A, ?_, hV0, rfl, ?_⟩
  · simpa only [hσ0] using hσmem 0 hV0
  · change (e.toPartialEquiv.symm 1).1 = 0
    simpa only [hσ0] using congrArg Prod.fst (hσinv 0 hV0)

variable [FiniteDimensional ℝ E] [FiniteDimensional ℝ F]
  [BoundarylessManifold I G] [T2Space G]
  [BoundarylessManifold J K] [T2Space K]

/-- A prescribed complement to an embedded subgroup gives a smooth quotient slice
whose section is the transverse exponential. -/
theorem exists_quotientSlice_of_embeddedLieSubgroup_complement
    (S : EmbeddedLieSubgroup I G J K) (L : (Q × F) ≃L[ℝ] E)
    (hL : ∀ v : F, L (0, v) = subgroupDifferentialModel S.toImmersedLieSubgroup v) :
    ∃ A : QuotientSlice (I := I) (P := Q)
        (QuotientGroup.mk : G → G ⧸ S.toImmersedLieSubgroup.subgroup),
      (1 : G) ∈ A.source ∧ (0 : Q) ∈ A.target ∧
      A.section_ = (fun q =>
        lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (L (q, 0)))) ∧
      A.coordinate 1 = 0 := by
  let : CompleteSpace E := FiniteDimensional.complete ℝ E
  obtain ⟨e, he0, _, he⟩ := exists_subgroup_multiplication_chart
    S.toImmersedLieSubgroup L hL
  let B := (L : (Q × F) →L[ℝ] E).comp (ContinuousLinearMap.inl ℝ Q F)
  exact exists_quotientSlice_of_multiplication_chart S
    ((lieExp_contMDiff_model (I := I) (G := G)).comp B.contDiff.contMDiff)
    (by change lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (B 0)) = 1
        simp) e he0 he

/-- Every finite-dimensional embedded Lie subgroup has an actual transverse quotient
slice at the identity; its model is constructed as a linear complement. -/
theorem exists_quotientSlice_of_embeddedLieSubgroup [J.Boundaryless]
    (S : EmbeddedLieSubgroup I G J K) :
    ∃ Q : Submodule ℝ E, ∃ A : QuotientSlice (I := I) (P := Q)
        (QuotientGroup.mk : G → G ⧸ S.toImmersedLieSubgroup.subgroup),
      (1 : G) ∈ A.source ∧ (0 : Q) ∈ A.target ∧
      A.section_ 0 = 1 ∧ A.coordinate 1 = 0 := by
  obtain ⟨Q, L, hL⟩ := exists_subgroup_transverse_model S.toImmersedLieSubgroup
  obtain ⟨A, hA1, hA0, hAsec, hAcoord⟩ :=
    exists_quotientSlice_of_embeddedLieSubgroup_complement S L hL
  refine ⟨Q, A, hA1, hA0, ?_, hAcoord⟩
  rw [hAsec]
  change lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (L 0)) = 1
  simp

end LieGroups.Manifold

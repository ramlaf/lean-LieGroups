/-!
# Smooth lifting to the intrinsic leafwise manifold

An ambient smooth map lifts smoothly to the leafwise topology if its transverse
coordinates are locally constant. Vanishing transverse differential supplies
this local constancy on a boundaryless source manifold.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

namespace LieGroups.Manifold

variable {E P Q : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {K : Type*} [TopologicalSpace K] {J : ModelWithCorners ℝ F K}
  {N : Type*} [TopologicalSpace N] [ChartedSpace K N]

namespace FoliationAtlas

variable (A : FoliationAtlas (P := P) (Q := Q) I M)

set_option backward.isDefEq.respectTransparency false in
/-- The transverse differential vanishes when the ambient differential has
horizontal image in the given foliation chart. -/
theorem transverse_mfderiv_eq_zero_of_horizontal
    {f : N → M} {x : N} (a : M) (ha : f x ∈ (A.chart a).source)
    (hf : MDifferentiableAt J I f x)
    (hhor : ∀ v : TangentSpace J x,
      (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) (f x) (mfderiv J I f x v)).2 = 0) :
    mfderiv J 𝓘(ℝ, Q) (fun y => ((A.chart a) (f y)).2) x = 0 := by
  have hc := ((A.chart a).contMDiffOn_toFun.contMDiffAt
    ((A.chart a).open_source.mem_nhds ha)).mdifferentiableAt (by simp)
  have hd := hc.hasMFDerivAt.comp x hf.hasMFDerivAt
  have hs : HasMFDerivAt 𝓘(ℝ, P × Q) 𝓘(ℝ, Q) Prod.snd ((A.chart a) (f x))
      (ContinuousLinearMap.snd ℝ P Q) := hasFDerivAt_snd.hasMFDerivAt
  have h := hs.comp x hd
  have hz : (ContinuousLinearMap.snd ℝ P Q).comp
      ((mfderiv I 𝓘(ℝ, P × Q) (A.chart a) (f x)).comp (mfderiv J I f x)) = 0 := by
    ext v
    exact hhor v
  rw [hz] at h
  exact h.mfderiv

/-- The identity on points, directed from the ambient type to the intrinsic leafwise type. -/
def toLeafwise : M → A.Leafwise := id

/-- Ambient smoothness and locally constant transverse coordinates give smoothness
for the topology and atlas actually constructed from plaques. -/
theorem contMDiffAt_leafwise_of_transverse_eventuallyEq
    {f : N → M} {x : N} (a : M) (ha : f x ∈ (A.chart a).source)
    (hf : ContMDiffAt J I ∞ f x)
    (ht : ∀ᶠ y in 𝓝 x, ((A.chart a) (f y)).2 = ((A.chart a) (f x)).2) :
    ContMDiffAt J 𝓘(ℝ, P) ∞ (A.toLeafwise ∘ f) x := by
  let z := ((A.chart a) (f x)).2
  let c := A.plaqueChart a z
  have hx : (f x : A.Leafwise) ∈ c.source := ⟨ha, rfl⟩
  have hc : ContMDiffAt 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ c.symm (c (f x)) :=
    contMDiffAt_symm_of_mem_maximalAtlas
      (IsManifold.subset_maximalAtlas (A.plaqueChart_mem_atlas a z)) (c.map_source hx)
  have hchart := ((A.chart a).contMDiffOn_toFun.contMDiffAt
    ((A.chart a).open_source.mem_nhds ha)).comp x hf
  have hfirst : ContMDiffAt J 𝓘(ℝ, P) ∞ (fun y => ((A.chart a) (f y)).1) x :=
    contDiff_fst.contMDiff.contMDiffAt.comp x hchart
  apply (hc.comp x hfirst).congr_of_eventuallyEq
  filter_upwards [ht, hf.continuousAt.preimage_mem_nhds
    ((A.chart a).open_source.mem_nhds ha)] with y hy hya
  exact (c.left_inv ⟨hya, hy⟩).symm

end FoliationAtlas

/-- If a Euclidean differential vanishes near a point, a differentiable function
is constant near that point. -/
theorem eventuallyEq_const_of_eventually_fderiv_eq_zero {f : F → Q} {x : F}
    (hf : ∀ᶠ y in 𝓝 x, DifferentiableAt ℝ f y)
    (hzero : ∀ᶠ y in 𝓝 x, fderiv ℝ f y = 0) :
    ∀ᶠ y in 𝓝 x, f y = f x := by
  obtain ⟨s, hs, hopen, hxs⟩ := mem_nhds_iff.mp (hf.and hzero)
  have hdiff : DifferentiableOn ℝ f s := fun y hy => (hs hy).1.differentiableWithinAt
  have hz : s.EqOn (fderiv ℝ f) 0 := fun y hy => (hs hy).2
  have ho := hopen.isOpen_inter_preimage_of_fderiv_eq_zero hdiff hz {f x}
  filter_upwards [ho.mem_nhds ⟨hxs, rfl⟩] with y hy
  exact hy.2

set_option backward.isDefEq.respectTransparency false in
/-- A smooth map to a normed space whose manifold differential vanishes near an
interior point is locally constant there. -/
theorem eventuallyEq_const_of_eventually_mfderiv_eq_zero [IsManifold J ∞ N]
    [BoundarylessManifold J N] {f : N → Q} {x : N}
    (hf : ContMDiffAt J 𝓘(ℝ, Q) ∞ f x)
    (hzero : ∀ᶠ y in 𝓝 x, mfderiv J 𝓘(ℝ, Q) f y = 0) :
    ∀ᶠ y in 𝓝 x, f y = f x := by
  let c := extChartAtInteriorPartialDiffeomorph (I := J) x
  have hx : x ∈ c.source :=
    ⟨mem_extChartAt_source x,
      (J.isInteriorPoint_iff (x := x)).mp BoundarylessManifold.isInteriorPoint⟩
  have ht := c.map_source hx
  have hi : ContMDiffAt 𝓘(ℝ, F) J ∞ c.symm (c x) :=
    c.contMDiffOn_invFun.contMDiffAt (c.open_target.mem_nhds ht)
  have hs : ∀ᶠ y in 𝓝 x, ContMDiffAt J 𝓘(ℝ, Q) 1 f y :=
    (contMDiffAt_iff_contMDiffAt_nhds (by simp)).mp (hf.of_le (by simp))
  have himap : Tendsto c.symm (𝓝 (c x)) (𝓝 x) := by
    have hleft : c.symm (c x) = x := c.left_inv hx
    simpa only [hleft] using hi.continuousAt.tendsto
  have hcoord : ∀ᶠ y in 𝓝 (c x), HasFDerivAt (f ∘ c.symm) (0 : F →L[ℝ] Q) y := by
    filter_upwards [himap hs, himap hzero, c.open_target.mem_nhds ht] with y hys hyzero hyt
    have hiy : ContMDiffAt 𝓘(ℝ, F) J ∞ c.symm y :=
      c.contMDiffOn_invFun.contMDiffAt (c.open_target.mem_nhds hyt)
    have hd := (hys.mdifferentiableAt (by simp)).hasMFDerivAt.comp y
      (hiy.mdifferentiableAt (by simp)).hasMFDerivAt
    rw [hyzero, ContinuousLinearMap.zero_comp] at hd
    exact hd.hasFDerivAt
  have hlocal := eventuallyEq_const_of_eventually_fderiv_eq_zero
    (hcoord.mono (fun _ h => h.differentiableAt)) (hcoord.mono (fun _ h => h.fderiv))
  have hc : ContinuousAt c x :=
    (c.contMDiffOn_toFun.contMDiffAt (c.open_source.mem_nhds hx)).continuousAt
  filter_upwards [hc.tendsto hlocal, c.open_source.mem_nhds hx] with y hy hys
  change f (c.symm (c y)) = f (c.symm (c x)) at hy
  have hlefty : c.symm (c y) = y := c.left_inv hys
  have hleftx : c.symm (c x) = x := c.left_inv hx
  simpa only [hlefty, hleftx] using hy

namespace FoliationAtlas

variable (A : FoliationAtlas (P := P) (Q := Q) I M)

/-- A vanishing transverse differential near the source point lifts an ambient
smooth map smoothly into the constructed leafwise manifold. -/
theorem contMDiffAt_leafwise_of_transverse_mfderiv_eq_zero
    [IsManifold J ∞ N] [BoundarylessManifold J N]
    {f : N → M} {x : N} (a : M) (ha : f x ∈ (A.chart a).source)
    (hf : ContMDiffAt J I ∞ f x)
    (hzero : ∀ᶠ y in 𝓝 x,
      mfderiv J 𝓘(ℝ, Q) (fun w => ((A.chart a) (f w)).2) y = 0) :
    ContMDiffAt J 𝓘(ℝ, P) ∞ (A.toLeafwise ∘ f) x := by
  apply A.contMDiffAt_leafwise_of_transverse_eventuallyEq a ha hf
  apply eventuallyEq_const_of_eventually_mfderiv_eq_zero _ hzero
  exact contDiff_snd.contMDiff.contMDiffAt.comp x
    (((A.chart a).contMDiffOn_toFun.contMDiffAt
      ((A.chart a).open_source.mem_nhds ha)).comp x hf)

/-- An ambient smooth map with horizontal differential near the source point
is smooth for the intrinsic topology generated by plaques. -/
theorem contMDiffAt_leafwise_of_horizontal
    [IsManifold J ∞ N] [BoundarylessManifold J N] [IsManifold I ∞ M]
    {f : N → M} {x : N} (a : M) (ha : f x ∈ (A.chart a).source)
    (hf : ContMDiffAt J I ∞ f x)
    (hhor : ∀ᶠ y in 𝓝 x, ∀ v : TangentSpace J y,
      (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) (f y) (mfderiv J I f y v)).2 = 0) :
    ContMDiffAt J 𝓘(ℝ, P) ∞ (A.toLeafwise ∘ f) x := by
  apply A.contMDiffAt_leafwise_of_transverse_mfderiv_eq_zero a ha hf
  have hs : ∀ᶠ y in 𝓝 x, ContMDiffAt J I 1 f y :=
    (contMDiffAt_iff_contMDiffAt_nhds (by simp)).mp (hf.of_le (by simp))
  filter_upwards [hhor, hs, hf.continuousAt.preimage_mem_nhds
    ((A.chart a).open_source.mem_nhds ha)] with y hy hys hya
  exact A.transverse_mfderiv_eq_zero_of_horizontal a hya
    (hys.mdifferentiableAt (by simp)) hy

/-- Distribution-valued differentials lift smoothly whenever the chosen chart
sends the distribution to horizontal vectors. -/
theorem contMDiffAt_leafwise_of_distribution
    [IsManifold J ∞ N] [BoundarylessManifold J N] [IsManifold I ∞ M]
    (D : (p : M) → Submodule ℝ (TangentSpace I p))
    (hD : ∀ a p, p ∈ (A.chart a).source → ∀ v ∈ D p,
      (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) p v).2 = 0)
    {f : N → M} {x : N} (hf : ContMDiffAt J I ∞ f x)
    (hhor : ∀ᶠ y in 𝓝 x, ∀ v : TangentSpace J y, mfderiv J I f y v ∈ D (f y)) :
    ContMDiffAt J 𝓘(ℝ, P) ∞ (A.toLeafwise ∘ f) x := by
  apply A.contMDiffAt_leafwise_of_horizontal (f x) (A.mem_source (f x)) hf
  filter_upwards [hhor, hf.continuousAt.preimage_mem_nhds
    ((A.chart (f x)).open_source.mem_nhds (A.mem_source (f x)))] with y hy hya
  exact fun v => hD (f x) (f y) hya _ (hy v)

/-- Global smooth lifting of a smooth horizontal map into the constructed
leafwise manifold. -/
theorem contMDiff_leafwise_of_distribution
    [IsManifold J ∞ N] [BoundarylessManifold J N] [IsManifold I ∞ M]
    (D : (p : M) → Submodule ℝ (TangentSpace I p))
    (hD : ∀ a p, p ∈ (A.chart a).source → ∀ v ∈ D p,
      (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) p v).2 = 0)
    {f : N → M} (hf : ContMDiff J I ∞ f)
    (hhor : ∀ y (v : TangentSpace J y), mfderiv J I f y v ∈ D (f y)) :
    ContMDiff J 𝓘(ℝ, P) ∞ (A.toLeafwise ∘ f) :=
  fun _ => A.contMDiffAt_leafwise_of_distribution D hD hf.contMDiffAt
    (Filter.Eventually.of_forall hhor)

/-- Exact straightening of a distribution implies that all its chart vectors
have zero transverse component. -/
theorem snd_mfderiv_eq_zero_of_distribution_map
    (D : (p : M) → Submodule ℝ (TangentSpace I p))
    (hD : ∀ a p, p ∈ (A.chart a).source →
      (D p).map (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) p).toLinearMap =
        LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap)
    (a p : M) (hp : p ∈ (A.chart a).source) (v : TangentSpace I p) (hv : v ∈ D p) :
    (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) p v).2 = 0 := by
  have hmem : mfderiv I 𝓘(ℝ, P × Q) (A.chart a) p v ∈
      LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap := by
    rw [← hD a p hp]
    exact ⟨v, hv, rfl⟩
  obtain ⟨u, hu⟩ := hmem
  exact congrArg Prod.snd hu.symm

/-- Smooth horizontal lifting with the exact chart-map equality used by
distribution-adapted foliation charts. -/
theorem contMDiff_leafwise_of_distribution_map
    [IsManifold J ∞ N] [BoundarylessManifold J N] [IsManifold I ∞ M]
    (D : (p : M) → Submodule ℝ (TangentSpace I p))
    (hD : ∀ a p, p ∈ (A.chart a).source →
      (D p).map (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) p).toLinearMap =
        LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap)
    {f : N → M} (hf : ContMDiff J I ∞ f)
    (hhor : ∀ y (v : TangentSpace J y), mfderiv J I f y v ∈ D (f y)) :
    ContMDiff J 𝓘(ℝ, P) ∞ (A.toLeafwise ∘ f) :=
  A.contMDiff_leafwise_of_distribution D (A.snd_mfderiv_eq_zero_of_distribution_map D hD)
    hf hhor

end FoliationAtlas


import Mathlib.Geometry.Manifold.ContMDiff.Atlas
import Mathlib.Geometry.Manifold.Instances.Real
import Mathlib.Topology.Maps.OpenQuotient
import LieGroups.Manifold.LocalSections
import LieGroups.Manifold.SubmersionCriterion

/-!
# Smooth quotient charts from transverse slices

The topology on the quotient is supplied by an actual open quotient map. Smooth transverse
slices, with local uniqueness modulo its fibers, construct its charts. Smooth transports
along fibers then prove chart compatibility and smooth local sections.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups.Manifold

variable {E P : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M X : Type*} [TopologicalSpace M] [ChartedSpace H M] [TopologicalSpace X]
  (π : M → X)

/-- Local transverse coordinates for the fibers of a quotient map. All smooth maps are
defined on the original manifold; no quotient atlas is assumed. -/
structure QuotientSlice where
  source : Set M
  target : Set P
  open_source : IsOpen source
  open_target : IsOpen target
  coordinate : M → P
  section_ : P → M
  coordinate_smooth : ContMDiffOn I 𝓘(ℝ, P) ∞ coordinate source
  section_smooth : ContMDiffOn 𝓘(ℝ, P) I ∞ section_ target
  coordinate_mem : MapsTo coordinate source target
  section_mem : MapsTo section_ target source
  coordinate_section : ∀ p ∈ target, coordinate (section_ p) = p
  section_coordinate : ∀ x ∈ source, π (section_ (coordinate x)) = π x
  coordinate_fiber : ∀ x ∈ source, ∀ y ∈ source, π x = π y → coordinate x = coordinate y

variable {π}

namespace QuotientSlice

variable (S : QuotientSlice (I := I) (P := P) π) [Nonempty M]

private def representative (q : X) : M := by
  classical
  exact if h : q ∈ π '' S.source then Classical.choose h else Classical.choice inferInstance

omit [TopologicalSpace X] in
private theorem representative_mem {q : X} (hq : q ∈ π '' S.source) :
    S.representative q ∈ S.source := by
  simp only [representative, dite_eq_left hq]
  exact (Classical.choose_spec hq).1

omit [TopologicalSpace X] in
private theorem representative_eq {q : X} (hq : q ∈ π '' S.source) :
    π (S.representative q) = q := by
  simp only [representative, dite_eq_left hq]
  exact (Classical.choose_spec hq).2

/-- The quotient chart as a partial equivalence, before proving continuity. -/
def partialEquiv : PartialEquiv X P where
  toFun q := S.coordinate (S.representative q)
  invFun p := π (S.section_ p)
  source := π '' S.source
  target := S.target
  map_source' _ hq := S.coordinate_mem (S.representative_mem hq)
  map_target' p hp := ⟨S.section_ p, S.section_mem hp, rfl⟩
  left_inv' q hq := (S.section_coordinate _ (S.representative_mem hq)).trans
    (S.representative_eq hq)
  right_inv' p hp := by
    have hq : π (S.section_ p) ∈ π '' S.source := ⟨_, S.section_mem hp, rfl⟩
    exact (S.coordinate_fiber _ (S.representative_mem hq) _ (S.section_mem hp)
      (S.representative_eq hq)).trans (S.coordinate_section p hp)

omit [TopologicalSpace X] in
theorem partialEquiv_apply_mk {x : M} (hx : x ∈ S.source) :
    S.partialEquiv (π x) = S.coordinate x :=
  S.coordinate_fiber _ (S.representative_mem ⟨x, hx, rfl⟩) x hx
    (S.representative_eq ⟨x, hx, rfl⟩)

/-- The transverse coordinates are continuous for the original quotient topology. -/
theorem continuousOn_partialEquiv (hπ : IsOpenQuotientMap π) :
    ContinuousOn S.partialEquiv S.partialEquiv.source := by
  rintro q ⟨x, hx, rfl⟩
  apply ContinuousAt.continuousWithinAt
  apply hπ.continuousAt_comp_iff.mp
  have hc := (S.coordinate_smooth.continuousOn).continuousAt
    (S.open_source.mem_nhds hx)
  apply hc.congr_of_eventuallyEq
  filter_upwards [S.open_source.mem_nhds hx] with y hy
  exact S.partialEquiv_apply_mk hy

/-- A slice produces a genuine coordinate chart for the given quotient topology. -/
def chart (hπ : IsOpenQuotientMap π) : OpenPartialHomeomorph X P where
  toPartialEquiv := S.partialEquiv
  open_source := hπ.isOpenMap S.source S.open_source
  open_target := S.open_target
  continuousOn_toFun := S.continuousOn_partialEquiv hπ
  continuousOn_invFun := hπ.continuous.comp_continuousOn S.section_smooth.continuousOn

@[simp] theorem chart_apply_mk (hπ : IsOpenQuotientMap π) {x : M} (hx : x ∈ S.source) :
    S.chart hπ (π x) = S.coordinate x := S.partialEquiv_apply_mk hx

@[simp] theorem chart_symm_apply (hπ : IsOpenQuotientMap π) (p : P) :
    (S.chart hπ).symm p = π (S.section_ p) := rfl

end QuotientSlice

/-- A covering family of transverse slices, together with smooth maps transporting any
point to any other point of the same fiber. For a group quotient, right translations
by subgroup elements provide these transports. -/
structure SmoothQuotientAtlas (π : M → X) where
  isOpenQuotientMap : IsOpenQuotientMap π
  slice : M → QuotientSlice (I := I) (P := P) π
  mem_source : ∀ x, x ∈ (slice x).source
  transport : ∀ x y, π x = π y → ∃ f : M → M,
    ContMDiff I I ∞ f ∧ f x = y ∧ ∀ z, π (f z) = π z

namespace SmoothQuotientAtlas

variable (A : SmoothQuotientAtlas (I := I) (P := P) π) [Nonempty M]

/-- Each slice gives a chart for the existing quotient topology. -/
def chart (x : M) : OpenPartialHomeomorph X P :=
  (A.slice x).chart A.isOpenQuotientMap

/-- The quotient atlas is constructed from the transverse slices. -/
@[instance_reducible] def chartedSpace : ChartedSpace P X where
  atlas := Set.range A.chart
  chartAt q := A.chart (Classical.choose (A.isOpenQuotientMap.surjective q))
  mem_chart_source q := ⟨_, A.mem_source _,
    Classical.choose_spec (A.isOpenQuotientMap.surjective q)⟩
  chart_mem_atlas _q := ⟨_, rfl⟩

/-- The quotient with the atlas selected by the transverse slices. Its topology is exactly
the supplied quotient topology. -/
def Space (_A : SmoothQuotientAtlas (I := I) (P := P) π) := X

instance : TopologicalSpace A.Space := inferInstanceAs (TopologicalSpace X)

instance : ChartedSpace P A.Space := A.chartedSpace

/-- The original quotient projection, into the quotient equipped with its constructed atlas. -/
def projection : M → A.Space := π

theorem chart_mem_atlas (x : M) : A.chart x ∈ atlas P A.Space := ⟨x, rfl⟩

/-- Fiber transport makes quotient coordinates smooth after composition with the projection,
including at representatives outside the original slice neighborhood. -/
theorem contMDiffAt_chart_comp {a x : M} (hx : π x ∈ (A.chart a).source) :
    ContMDiffAt I 𝓘(ℝ, P) ∞ (A.chart a ∘ π) x := by
  obtain ⟨y, hy, heq⟩ := hx
  obtain ⟨f, hf, hfx, hfπ⟩ := A.transport x y heq.symm
  have hc : ContMDiffAt I 𝓘(ℝ, P) ∞ ((A.slice a).coordinate ∘ f) x := by
    apply ((A.slice a).coordinate_smooth.contMDiffAt _).comp x hf.contMDiffAt
    rw [hfx]
    exact (A.slice a).open_source.mem_nhds hy
  apply hc.congr_of_eventuallyEq
  have hm : ∀ᶠ z in 𝓝 x, f z ∈ (A.slice a).source :=
    hf.continuous.continuousAt.preimage_mem_nhds (hfx ▸ (A.slice a).open_source.mem_nhds hy)
  filter_upwards [hm] with z hz
  change A.chart a (π z) = (A.slice a).coordinate (f z)
  rw [← hfπ z]
  exact (A.slice a).chart_apply_mk A.isOpenQuotientMap hz

/-- Compatibility of the quotient charts follows from smooth sections and fiber transports. -/
theorem chart_transition_contDiff (a b : M) :
    ContDiffOn ℝ ∞ ((A.chart a).symm.trans (A.chart b))
      ((A.chart a).symm.trans (A.chart b)).source := by
  intro p hp
  have hs : ContMDiffAt 𝓘(ℝ, P) I ∞ (A.slice a).section_ p :=
    (A.slice a).section_smooth.contMDiffAt ((A.slice a).open_target.mem_nhds hp.1)
  have hc := (A.contMDiffAt_chart_comp hp.2).comp p hs
  exact (contMDiffAt_iff_contDiffAt.mp hc).contDiffWithinAt

/-- The constructed quotient atlas is smooth. -/
instance isManifold : IsManifold 𝓘(ℝ, P) ∞ A.Space := by
  apply isManifold_of_contDiffOn
  rintro e e' ⟨a, rfl⟩ ⟨b, rfl⟩
  simp only [modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm,
    Function.comp_id, Function.id_comp, Set.range_id, Set.preimage_id, Set.inter_univ]
  exact A.chart_transition_contDiff a b

/-- The actual quotient projection is smooth for the atlas constructed above. -/
theorem contMDiff_projection : ContMDiff I 𝓘(ℝ, P) ∞ A.projection := by
  intro x
  let c : OpenPartialHomeomorph A.Space P := A.chart x
  have hx : A.projection x ∈ c.source := ⟨x, A.mem_source x, rfl⟩
  have hc := IsManifold.subset_maximalAtlas (I := 𝓘(ℝ, P)) (n := ∞)
    (A.chart_mem_atlas x)
  have hi : ContMDiffAt 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ c.symm (c (A.projection x)) :=
    contMDiffAt_symm_of_mem_maximalAtlas hc (c.map_source hx)
  have h := hi.comp x (A.contMDiffAt_chart_comp hx)
  apply h.congr_of_eventuallyEq
  have hm : ∀ᶠ y in 𝓝 x, π y ∈ c.source :=
    A.isOpenQuotientMap.continuous.continuousAt.preimage_mem_nhds
      (c.open_source.mem_nhds hx)
  filter_upwards [hm] with y hy
  exact (c.left_inv hy).symm

/-- The transverse slices give smooth local sections of the constructed quotient projection. -/
theorem hasContMDiffLocalSections :
    HasContMDiffLocalSections I 𝓘(ℝ, P) ∞ A.projection := by
  intro q
  obtain ⟨x, rfl⟩ := A.isOpenQuotientMap.surjective q
  let c : OpenPartialHomeomorph A.Space P := A.chart x
  have hx : A.projection x ∈ c.source := ⟨x, A.mem_source x, rfl⟩
  refine ⟨(A.slice x).section_ ∘ c, ?_, ?_⟩
  · have hc : ContMDiffAt 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ c (A.projection x) :=
      contMDiffAt_of_mem_maximalAtlas
        (IsManifold.subset_maximalAtlas (A.chart_mem_atlas x)) hx
    exact ((A.slice x).section_smooth.contMDiffAt
      ((A.slice x).open_target.mem_nhds (c.map_source hx))).comp (A.projection x) hc
  · filter_upwards [c.open_source.mem_nhds hx] with z hz
    exact c.left_inv hz

/-- Fiber transport moves a local section through any prescribed representative. -/
theorem exists_localSection_through (x : M) :
    ∃ s : A.Space → M, s (A.projection x) = x ∧
      ContMDiffAt 𝓘(ℝ, P) I ∞ s (A.projection x) ∧
      (A.projection ∘ s) =ᶠ[𝓝 (A.projection x)] id := by
  obtain ⟨s, hs, hsec⟩ := A.hasContMDiffLocalSections (A.projection x)
  obtain ⟨f, hf, hfx, hfπ⟩ := A.transport (s (A.projection x)) x hsec.self_of_nhds
  refine ⟨f ∘ s, hfx, hf.contMDiffAt.comp (A.projection x) hs, ?_⟩
  filter_upwards [hsec] with q hq
  exact (hfπ (s q)).trans hq

/-- The constructed projection has surjective differentials, since its sections can pass
through any chosen representative. -/
theorem mfderiv_projection_surjective (x : M) :
    Function.Surjective (mfderiv I 𝓘(ℝ, P) A.projection x) := by
  obtain ⟨s, hsx, hs, hsec⟩ := A.exists_localSection_through x
  have hcomp := mfderiv_comp (A.projection x)
    (A.contMDiff_projection (s (A.projection x)) |>.mdifferentiableAt (by simp))
    (hs.mdifferentiableAt (by simp))
  have heq := hsec.mfderiv_eq (I := 𝓘(ℝ, P)) (I' := 𝓘(ℝ, P))
  have hsurj : Function.Surjective
      (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) (A.projection ∘ s) (A.projection x)) := by
    rw [heq, mfderiv_id]
    exact (tangentSpaceCast 𝓘(ℝ, P) _ _).surjective
  rw [hcomp] at hsurj
  change Function.Surjective
    ((mfderiv I 𝓘(ℝ, P) A.projection (s (A.projection x))) ∘
      mfderiv 𝓘(ℝ, P) I s (A.projection x)) at hsurj
  have hout : Function.Surjective
      (mfderiv I 𝓘(ℝ, P) A.projection (s (A.projection x))) :=
    Function.Surjective.of_comp hsurj
  rw [hsx] at hout
  exact hout

/-- On complete boundaryless source models and finite-dimensional quotient models, the
projection has genuine submersion normal-form charts. -/
theorem isSubmersionAt_projection [CompleteSpace E] [I.Boundaryless]
    [IsManifold I ∞ M] [FiniteDimensional ℝ P] (x : M) :
    _root_.Manifold.IsSubmersionAt I 𝓘(ℝ, P) ∞ A.projection x := by
  exact isSubmersionAt_of_surjective_mfderiv A.contMDiff_projection (by simp)
    (A.mfderiv_projection_surjective x)

/-- In finite dimensions the submersion complements at different points are isomorphic,
so the projection satisfies Mathlib's global fixed-complement submersion definition. -/
theorem isSubmersion_projection [FiniteDimensional ℝ E] [I.Boundaryless]
    [IsManifold I ∞ M] [FiniteDimensional ℝ P] :
    _root_.Manifold.IsSubmersion I 𝓘(ℝ, P) ∞ A.projection := by
  let x₀ : M := Classical.choice inferInstance
  let h₀ := A.isSubmersionAt_projection x₀
  let F := h₀.complement
  let : FiniteDimensional ℝ (P × F) := h₀.equiv.toLinearEquiv.finiteDimensional
  let : FiniteDimensional ℝ F :=
    FiniteDimensional.of_injective (LinearMap.inr ℝ P F) (fun _ _ h => congrArg Prod.snd h)
  refine ⟨F, inferInstance, inferInstance, fun x => ?_⟩
  let hx := A.isSubmersionAt_projection x
  let : FiniteDimensional ℝ (P × hx.complement) := hx.equiv.toLinearEquiv.finiteDimensional
  let : FiniteDimensional ℝ hx.complement :=
    FiniteDimensional.of_injective (LinearMap.inr ℝ P hx.complement)
      (fun _ _ h => congrArg Prod.snd h)
  have hdim : Module.finrank ℝ hx.complement = Module.finrank ℝ F := by
    have h₀dim := h₀.equiv.toLinearEquiv.finrank_eq
    have hxdim := hx.equiv.toLinearEquiv.finrank_eq
    rw [Module.finrank_prod] at h₀dim hxdim
    exact Nat.add_left_cancel (hxdim.symm.trans h₀dim)
  exact hx.isSubmersionAtOfComplement_complement.trans_F
    (ContinuousLinearEquiv.ofFinrankEq hdim)

end SmoothQuotientAtlas

end LieGroups.Manifold

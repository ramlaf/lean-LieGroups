noncomputable section
open Function Set Filter
open scoped Topology Manifold ContDiff

namespace LieGroups.Manifold

variable {E D : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  [NormedAddCommGroup D] [NormedSpace ℝ D]

/-- A smooth map into a boundaryless manifold is a local diffeomorphism when its
coordinate differential is an isomorphism. -/
theorem exists_partialDiffeomorph_of_chart_fderiv
    {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
    {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
    [BoundarylessManifold I M]
    {f : D → M} (hf : ContMDiff 𝓘(ℝ, D) I ∞ f)
    (L : D ≃L[ℝ] E)
    (hd : fderiv ℝ (fun v => extChartAt I (f 0) (f v)) 0 = L) :
    ∃ Φ : PartialDiffeomorph 𝓘(ℝ, D) I D M ∞,
      (0 : D) ∈ Φ.source ∧ EqOn f Φ Φ.source := by
  let X : E → M := f ∘ L.symm
  let F : E → E := fun v => extChartAt I (f 0) (X v)
  let W : Set E := X ⁻¹' (extChartAt I (f 0)).source
  have hX : ContMDiff 𝓘(ℝ, E) I ∞ X := hf.comp L.symm.contDiff.contMDiff
  have hW : IsOpen W := (isOpen_extChartAt_source (f 0)).preimage hX.continuous
  have hX0 : X 0 = f 0 := by simp [X]
  have hW0 : (0 : E) ∈ W := by
    change X 0 ∈ (extChartAt I (f 0)).source
    rw [hX0]
    exact mem_extChartAt_source _
  have hF : ContDiffOn ℝ ∞ F W := by
    intro v hv
    have hc : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I (f 0)) (X v) := by
      apply contMDiffAt_extChartAt'
      have hv' : X v ∈ (extChartAt I (f 0)).source := hv
      simpa only [extChartAt_source] using hv'
    exact ((hc.comp v hX.contMDiffAt).contDiffAt).contDiffWithinAt
  have hd0 : fderiv ℝ F 0 = ContinuousLinearMap.id ℝ E := by
    have hc : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I (f 0)) (f 0) :=
      contMDiffAt_extChartAt
    have hd' := (hc.comp 0 hf.contMDiffAt).contDiffAt.differentiableAt (by simp)
    have hdz : HasFDerivAt (fun v => extChartAt I (f 0) (f v))
        (L : D →L[ℝ] E) (L.symm 0) := by
      have hh : HasFDerivAt (fun v => extChartAt I (f 0) (f v))
          (fderiv ℝ (fun v => extChartAt I (f 0) (f v)) 0) 0 := hd'.hasFDerivAt
      rw [hd] at hh
      simpa only [map_zero] using hh
    have he := hdz.comp 0 L.symm.hasFDerivAt
    have he' : HasFDerivAt F (ContinuousLinearMap.id ℝ E) 0 := by
      change HasFDerivAt F ((L : D →L[ℝ] E).comp (L.symm : E →L[ℝ] D)) 0 at he
      convert he using 1
      ext v
      exact (L.apply_symm_apply v).symm
    exact he'.fderiv
  obtain ⟨B, hB0, hBW, hBF⟩ :=
    LieGroups.Analysis.exists_partialDiffeomorph_of_fderiv_zero_id hW hW0 hF hd0
  let C := extChartAtInteriorPartialDiffeomorph (I := I) (f 0)
  let A := B.trans C.symm
  have hA0 : (0 : E) ∈ A.source := by
    refine ⟨hB0, ?_⟩
    change B 0 ∈ interior (extChartAt I (f 0)).target
    rw [← hBF hB0]
    change extChartAt I (f 0) (X 0) ∈ interior (extChartAt I (f 0)).target
    rw [hX0]
    exact I.isInteriorPoint_iff.mp BoundarylessManifold.isInteriorPoint
  have hAX : EqOn X A A.source := by
    intro v hv
    change X v = (extChartAt I (f 0)).symm (B v)
    rw [← hBF hv.1]
    exact ((extChartAt I (f 0)).left_inv (hBW hv.1)).symm
  let Φ := L.toDiffeomorph.toPartialDiffeomorph.trans A
  refine ⟨Φ, ⟨mem_univ _, ?_⟩, ?_⟩
  · change L 0 ∈ A.source
    simpa using hA0
  intro v hv
  change f v = A (L v)
  have hh := hAX hv.2
  change f (L.symm (L v)) = A (L v) at hh
  simpa using hh

section Product

variable {F Q : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {N : Type*} [TopologicalSpace N] [ChartedSpace H' N]

omit [CompleteSpace E] in
/-- Taking the product with a Euclidean identity preserves partial diffeomorphisms. -/
def partialDiffeomorph_prod_id (e : PartialDiffeomorph I J M N ∞) :
    PartialDiffeomorph ((𝓘(ℝ, Q)).prod I) ((𝓘(ℝ, Q)).prod J)
      (Q × M) (Q × N) ∞ where
  toPartialEquiv := (PartialEquiv.refl Q).prod e.toPartialEquiv
  open_source := isOpen_univ.prod e.open_source
  open_target := isOpen_univ.prod e.open_target
  contMDiffOn_toFun := contMDiffOn_id.prodMap e.contMDiffOn_toFun
  contMDiffOn_invFun := contMDiffOn_id.prodMap e.contMDiffOn_invFun

end Product

section Multiplication

variable {P Q : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G]

/-- Multiplication of two smooth transverse parameterizations gives a local product
chart. Its differential hypotheses concern only the two coordinate maps at zero. -/
theorem exists_multiplication_chart_of_chart_fderiv
    {a : P → G} {b : Q → G}
    (ha : ContMDiff 𝓘(ℝ, P) I ∞ a) (hb : ContMDiff 𝓘(ℝ, Q) I ∞ b)
    (ha0 : a 0 = 1) (hb0 : b 0 = 1) (L : (P × Q) ≃L[ℝ] E)
    (hda : fderiv ℝ (fun p => extChartAt I (1 : G) (a p)) 0 =
      (L : (P × Q) →L[ℝ] E).comp (ContinuousLinearMap.inl ℝ P Q))
    (hdb : fderiv ℝ (fun q => extChartAt I (1 : G) (b q)) 0 =
      (L : (P × Q) →L[ℝ] E).comp (ContinuousLinearMap.inr ℝ P Q)) :
    ∃ e : PartialDiffeomorph 𝓘(ℝ, P × Q) I (P × Q) G ∞,
      (0 : P × Q) ∈ e.source ∧ e 0 = 1 ∧
      EqOn (fun p => a p.1 * b p.2) e e.source := by
  let f : P × Q → G := fun p => a p.1 * b p.2
  have hf : ContMDiff 𝓘(ℝ, P × Q) I ∞ f :=
    (ha.comp (ContinuousLinearMap.fst ℝ P Q).contDiff.contMDiff).mul
      (hb.comp (ContinuousLinearMap.snd ℝ P Q).contDiff.contMDiff)
  have hf0 : f 0 = 1 := by simp [f, ha0, hb0]
  let F : P × Q → E := fun p => extChartAt I (1 : G) (f p)
  have hF : DifferentiableAt ℝ F 0 := by
    have hc : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I (1 : G)) (f 0) := by
      rw [hf0]
      exact contMDiffAt_extChartAt
    exact (hc.comp 0 hf.contMDiffAt).contDiffAt.differentiableAt (by simp)
  have hD := hF.hasFDerivAt
  have hDl : (fderiv ℝ F 0).comp (ContinuousLinearMap.inl ℝ P Q) =
      (L : (P × Q) →L[ℝ] E).comp (ContinuousLinearMap.inl ℝ P Q) := by
    have hd' := hD.comp (f := fun p : P => (p, (0 : Q))) (0 : P)
      (hasFDerivAt_prodMk_left (0 : P) (0 : Q))
    have he : (F ∘ fun p : P => (p, (0 : Q))) =
        (fun p => extChartAt I (1 : G) (a p)) := by
      funext p
      simp [F, f, hb0]
    rw [he] at hd'
    exact hd'.fderiv.symm.trans hda
  have hDr : (fderiv ℝ F 0).comp (ContinuousLinearMap.inr ℝ P Q) =
      (L : (P × Q) →L[ℝ] E).comp (ContinuousLinearMap.inr ℝ P Q) := by
    have hd' := hD.comp (f := fun q : Q => ((0 : P), q)) (0 : Q)
      (hasFDerivAt_prodMk_right (0 : P) (0 : Q))
    have he : (F ∘ fun q : Q => ((0 : P), q)) =
        (fun q => extChartAt I (1 : G) (b q)) := by
      funext q
      simp [F, f, ha0]
    rw [he] at hd'
    exact hd'.fderiv.symm.trans hdb
  have hd : fderiv ℝ F 0 = L := by
    apply ContinuousLinearMap.ext
    intro p
    have hl := congrArg (fun A : P →L[ℝ] E => A p.1) hDl
    have hr := congrArg (fun A : Q →L[ℝ] E => A p.2) hDr
    calc
      fderiv ℝ F 0 p = fderiv ℝ F 0 ((p.1, 0) + (0, p.2)) := by
        congr 1
        ext <;> simp
      _ = L (p.1, 0) + L (0, p.2) := by rw [map_add]; exact congrArg₂ (· + ·) hl hr
      _ = L p := by rw [← map_add]; congr 1; ext <;> simp
  obtain ⟨e, he0, he⟩ := exists_partialDiffeomorph_of_chart_fderiv hf L (by
    simpa only [hf0] using hd)
  exact ⟨e, he0, (he he0).symm.trans hf0, he⟩

variable [FiniteDimensional ℝ E] [T2Space G]

/-- The exponential along any continuous linear map has the expected coordinate
differential at zero. -/
theorem lieExp_model_comp_fderiv_zero (A : P →L[ℝ] E) :
    fderiv ℝ (fun p => extChartAt I (1 : G)
      (lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (A p)))) 0 = A := by
  let X : E → G := fun v => lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)
  have hX : ContMDiff 𝓘(ℝ, E) I ∞ X := lieExp_contMDiff_model
  have hc : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I (1 : G)) (X 0) := by
    simpa [X] using (contMDiffAt_extChartAt (I := I) (x := (1 : G)))
  have hh := (hc.comp 0 hX.contMDiffAt).contDiffAt.differentiableAt (by simp)
  have hd : HasFDerivAt (fun v => extChartAt I (1 : G) (X v))
      (ContinuousLinearMap.id ℝ E) 0 := by
    have hd' : HasFDerivAt (fun v => extChartAt I (1 : G) (X v))
        (fderiv ℝ (fun v => extChartAt I (1 : G) (X v)) 0) 0 := hh.hasFDerivAt
    rw [show fderiv ℝ (fun v => extChartAt I (1 : G) (X v)) 0 =
      ContinuousLinearMap.id ℝ E from lieExp_fderiv_chart_zero_model] at hd'
    exact hd'
  have hz : HasFDerivAt (fun v => extChartAt I (1 : G) (X v))
      (ContinuousLinearMap.id ℝ E) (A 0) := by simpa using hd
  simpa only [ContinuousLinearMap.id_comp, Function.comp_def, X] using
    (hz.comp 0 A.hasFDerivAt).fderiv

/-- Exponentials in complementary linear directions give a smooth product chart. -/
theorem exists_lieExp_multiplication_chart_model (L : (P × Q) ≃L[ℝ] E) :
    ∃ e : PartialDiffeomorph 𝓘(ℝ, P × Q) I (P × Q) G ∞,
      (0 : P × Q) ∈ e.source ∧ e 0 = 1 ∧
      EqOn (fun p =>
        lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (L (p.1, 0))) *
        lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (L (0, p.2))))
        e e.source := by
  let A := (L : (P × Q) →L[ℝ] E).comp (ContinuousLinearMap.inl ℝ P Q)
  let B := (L : (P × Q) →L[ℝ] E).comp (ContinuousLinearMap.inr ℝ P Q)
  apply exists_multiplication_chart_of_chart_fderiv
    ((lieExp_contMDiff_model (I := I) (G := G)).comp A.contDiff.contMDiff)
    ((lieExp_contMDiff_model (I := I) (G := G)).comp B.contDiff.contMDiff)
    (by simp) (by simp) L
  · exact lieExp_model_comp_fderiv_zero A
  · exact lieExp_model_comp_fderiv_zero B

end Multiplication

section Subgroup

variable {F Q : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  [FiniteDimensional ℝ E] [FiniteDimensional ℝ F]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]

/-- The derivative of the subgroup inclusion in the preferred Lie-algebra models. -/
def subgroupDifferentialModel (S : ImmersedLieSubgroup I G J K) : F →L[ℝ] E :=
  (lieAlgebraModelEquiv (I := I) (G := G)).toContinuousLinearMap.comp
    ((homLieDifferential (I := J) (J := I) S.toMonoidHom).comp
      (lieAlgebraModelEquiv (I := J) (G := K)).symm.toContinuousLinearMap)

omit [CompleteSpace E] in
/-- A complement to the subgroup tangent space is constructed from the immersion. -/
theorem exists_subgroup_transverse_model [J.Boundaryless]
    (S : ImmersedLieSubgroup I G J K) :
    ∃ Q : Submodule ℝ E, ∃ L : (Q × F) ≃L[ℝ] E,
      ∀ v : F, L (0, v) = subgroupDifferentialModel S v := by
  have hinj : Function.Injective (subgroupDifferentialModel S) :=
    (lieAlgebraModelEquiv (I := I) (G := G)).injective.comp
      (S.homLieDifferential_injective.comp
        (lieAlgebraModelEquiv (I := J) (G := K)).symm.injective)
  obtain ⟨π, hπ⟩ := Analysis.exists_projection_of_injective_frame
    (subgroupDifferentialModel S) hinj
  obtain ⟨L, hL, _⟩ := Analysis.exists_prod_equiv_of_projection
    (subgroupDifferentialModel S) π hπ
  exact ⟨LinearMap.ker π.toLinearMap, (ContinuousLinearEquiv.prodComm ℝ _ _).trans L,
    fun v => hL v⟩

variable [BoundarylessManifold I G] [T2Space G]
  [BoundarylessManifold J K] [T2Space K]

/-- Multiplication of the transverse exponential slice with the intrinsic subgroup
is a local diffeomorphism at the identity. -/
theorem exists_subgroup_multiplication_chart
    (S : ImmersedLieSubgroup I G J K) (L : (Q × F) ≃L[ℝ] E)
    (hL : ∀ v : F, L (0, v) = subgroupDifferentialModel S v) :
    ∃ e : PartialDiffeomorph ((𝓘(ℝ, Q)).prod J) I (Q × K) G ∞,
      (0, (1 : K)) ∈ e.source ∧ e (0, 1) = 1 ∧
      EqOn (fun p =>
        lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (L (p.1, 0))) *
          S.toMonoidHom p.2) e e.source := by
  obtain ⟨B, hB0, hB1, hBEq⟩ := exists_lieExp_multiplication_chart_model
    (I := I) (G := G) L
  obtain ⟨C, hC0, hC1, hCEq⟩ := exists_lieExp_localDiffeomorph_model (I := J) (G := K)
  let A : PartialDiffeomorph ((𝓘(ℝ, Q)).prod J) 𝓘(ℝ, Q × F) (Q × K) (Q × F) ∞ := {
    toPartialEquiv := (PartialEquiv.refl Q).prod C.toPartialEquiv.symm
    open_source := isOpen_univ.prod C.open_target
    open_target := isOpen_univ.prod C.open_source
    contMDiffOn_toFun := by
      rw [modelWithCornersSelf_prod, ← chartedSpaceSelf_prod]
      exact contMDiffOn_id.prodMap C.contMDiffOn_invFun
    contMDiffOn_invFun := by
      rw [modelWithCornersSelf_prod, ← chartedSpaceSelf_prod]
      exact contMDiffOn_id.prodMap C.contMDiffOn_toFun }
  have hA0 : (0, (1 : K)) ∈ A.source := by
    change (0 : Q) ∈ univ ∧ (1 : K) ∈ C.target
    exact ⟨mem_univ _, hC1 ▸ C.map_source hC0⟩
  have hCinv : C.symm (1 : K) = 0 := by
    rw [← hC1]
    exact C.left_inv hC0
  have hAone : A (0, (1 : K)) = 0 := by
    change ((0 : Q), C.symm 1) = 0
    rw [hCinv]
    rfl
  let e := A.trans B
  have he0 : (0, (1 : K)) ∈ e.source := ⟨hA0, by
    change A (0, 1) ∈ B.source
    rw [hAone]
    exact hB0⟩
  refine ⟨e, he0, ?_, ?_⟩
  · change B (A (0, 1)) = 1
    rw [hAone, hB1]
  · intro p hp
    have hpC : p.2 ∈ C.target := hp.1.2
    have hpB : A p ∈ B.source := hp.2
    have hright : lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm
        (L (0, C.symm p.2))) = S.toMonoidHom p.2 := by
      rw [hL]
      change lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm
        ((lieAlgebraModelEquiv (I := I) (G := G))
          (homLieDifferential (I := J) (J := I) S.toMonoidHom
            ((lieAlgebraModelEquiv (I := J) (G := K)).symm (C.symm p.2))))) = _
      rw [ContinuousLinearEquiv.symm_apply_apply, ← lieExp_map S.toMonoidHom S.contMDiff]
      have hh := hCEq (C.map_target hpC)
      change lieExp ((lieAlgebraModelEquiv (I := J) (G := K)).symm (C.symm p.2)) =
        C (C.symm p.2) at hh
      rw [hh]
      exact congrArg S.toMonoidHom (C.right_inv hpC)
    have hh := hBEq hpB
    change lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (L (p.1, 0))) *
      lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (L (0, C.symm p.2))) = e p at hh
    rwa [hright] at hh

end Subgroup

end LieGroups.Manifold

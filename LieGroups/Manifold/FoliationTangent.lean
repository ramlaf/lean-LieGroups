open Function Filter Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups.Manifold.FoliationAtlas

variable {E P Q : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  (A : FoliationAtlas (P := P) (Q := Q) I M)

set_option backward.isDefEq.respectTransparency false in
/-- The leafwise ambient inclusion has exactly the prescribed differential range. -/
theorem range_mfderiv_toAmbient
    (D : ∀ x : M, Submodule ℝ (TangentSpace I x))
    (hD : ∀ a x, x ∈ (A.chart a).source →
      (D x).map (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) x).toLinearMap =
        LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap)
    (x : A.Leafwise) :
    LinearMap.range (mfderiv 𝓘(ℝ, P) I A.toAmbient x).toLinearMap = D (A.toAmbient x) := by
  let a := A.toAmbient x
  let z := ((A.chart a) a).2
  let p := A.plaqueChart a z
  let u := p x
  have hx : x ∈ p.source := ⟨A.mem_source a, rfl⟩
  have hu : u ∈ p.target := p.map_source hx
  have hpair : (u, z) = (A.chart a) a := Prod.ext rfl rfl
  have hax : (A.chart a).symm (u, z) = a := by
    rw [hpair]
    exact (A.chart a).left_inv (A.mem_source a)
  have hp := mdifferentiable_of_mem_atlas (I := 𝓘(ℝ, P)) (A.plaqueChart_mem_atlas a z)
  have hsurj : Function.Surjective (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) p.symm u) :=
    hp.symm.mfderiv_surjective hu
  have hchain := mfderiv_comp u
    (A.contMDiff_toAmbient.contMDiffAt.mdifferentiableAt (by simp))
    (hp.mdifferentiableAt_symm hu)
  have hpx : p.symm u = x := p.left_inv hx
  erw [hpx] at hchain
  have hs := ((A.chart a).symm.mdifferentiableAt (by simp) hu).hasMFDerivAt.comp u
    (hasFDerivAt_prodMk_left (𝕜 := ℝ) u z).hasMFDerivAt
  have hparam : mfderiv 𝓘(ℝ, P) I (A.toAmbient ∘ p.symm) u =
      (mfderiv 𝓘(ℝ, P × Q) I (A.chart a).symm (u, z)).comp
        (ContinuousLinearMap.inl ℝ P Q) := hs.mfderiv
  have happly (v : P) : mfderiv 𝓘(ℝ, P) I A.toAmbient x
      (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) p.symm u v) =
      mfderiv 𝓘(ℝ, P × Q) I (A.chart a).symm (u, z) (v, 0) := by
    have hh := hchain.symm.trans hparam
    exact congrArg (fun L : P →L[ℝ] E => L v) hh
  apply le_antisymm
  · rintro w ⟨v, rfl⟩
    obtain ⟨v', hv'⟩ := hsurj v
    erw [← hv', happly]
    have hm := mfderiv_symm_horizontal_mem D (A.chart a) (hD a) (u, z) hu v'
    erw [hax] at hm
    exact hm
  · intro w hw
    have hm : mfderiv I 𝓘(ℝ, P × Q) (A.chart a) a w ∈
        LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap := by
      erw [← hD a a (A.mem_source a)]
      exact ⟨w, hw, rfl⟩
    obtain ⟨v, hv⟩ := hm
    refine ⟨mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) p.symm u v, ?_⟩
    change mfderiv 𝓘(ℝ, P) I A.toAmbient x
      (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) p.symm u v) = w
    rw [happly]
    have hc : (A.chart a).toOpenPartialHomeomorph.MDifferentiable I 𝓘(ℝ, P × Q) :=
      ⟨(A.chart a).mdifferentiableOn (by simp),
        (A.chart a).symm.mdifferentiableOn (by simp)⟩
    have hleft := hc.symm_comp_deriv (A.mem_source a)
    have hw' := congrArg (fun L : E →L[ℝ] E => L w) hleft
    change mfderiv 𝓘(ℝ, P × Q) I (A.chart a).symm ((A.chart a) a)
      (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) a w) = w at hw'
    erw [← hv, ← hpair] at hw'
    exact hw'

set_option backward.isDefEq.respectTransparency false in
/-- Each finite-dimensional connected intrinsic leaf has precisely the original
distribution as the differential image of its ambient inclusion. -/
theorem range_mfderiv_leafInclusion [FiniteDimensional ℝ P]
    (D : ∀ x : M, Submodule ℝ (TangentSpace I x))
    (hD : ∀ a x, x ∈ (A.chart a).source →
      (D x).map (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) x).toLinearMap =
        LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap)
    (x : A.Leafwise) (y : A.leaf x) :
    LinearMap.range (mfderiv 𝓘(ℝ, P) I (A.leafInclusion x) y).toLinearMap =
      D (A.leafInclusion x y) := by
  let j : A.leaf x → A.Leafwise := Subtype.val
  have hj : Function.Injective (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) j y) :=
    mfderiv_injective_of_isImmersionAt
      (_root_.Manifold.IsImmersionAt.of_opens (I := 𝓘(ℝ, P)) (n := ∞) (A.leaf x) y.property)
  have hjs : Function.Surjective (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) j y) :=
    LinearMap.surjective_of_injective (f :=
      (show P →L[ℝ] P from mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) j y).toLinearMap) hj
  have hcomp := mfderiv_comp y
    (A.contMDiff_toAmbient.contMDiffAt.mdifferentiableAt (by simp))
    ((contMDiff_subtype_val (I := 𝓘(ℝ, P)) (n := ∞)).contMDiffAt.mdifferentiableAt (by simp))
  change LinearMap.range (mfderiv 𝓘(ℝ, P) I (A.toAmbient ∘ j) y).toLinearMap = _
  rw [hcomp]
  change LinearMap.range ((mfderiv 𝓘(ℝ, P) I A.toAmbient (j y)).toLinearMap.comp
    (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) j y).toLinearMap) = _
  rw [LinearMap.range_comp_of_range_eq_top _ (LinearMap.range_eq_top.mpr hjs)]
  exact A.range_mfderiv_toAmbient D hD (j y)

end LieGroups.Manifold.FoliationAtlas

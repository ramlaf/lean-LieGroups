import DifferentialGeometry.Bundle.PartialMfderiv.Basic
import Mathlib.Analysis.Normed.Module.Dual

/-!
# Lie brackets of related vector fields

Smooth maps preserve brackets of related smooth vector fields. The proof tests tangent
vectors against scalar functions, using the commutator identity for directional derivatives.
Continuous linear functionals composed with a chart suffice to separate tangent vectors.
This is the naturality theorem in Lee, *Introduction to Smooth Manifolds*, Proposition 8.30.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-16.
-/

open scoped Topology Manifold ContDiff

namespace LieGroups.Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {N : Type*} [TopologicalSpace N] [ChartedSpace H' N] [IsManifold J ∞ N]
  {f : M → N} {X Y : (x : M) → TangentSpace I x}
  {X' Y' : (y : N) → TangentSpace J y}

set_option backward.isDefEq.respectTransparency false in
private theorem scalar_mfderiv_mlieBracket_of_related
    (hf : ContMDiff I J ∞ f)
    (hX : ContMDiff I (I.prod 𝓘(ℝ, E)) ∞ (T% X))
    (hY : ContMDiff I (I.prod 𝓘(ℝ, E)) ∞ (T% Y))
    (hX' : ContMDiff J (J.prod 𝓘(ℝ, F)) ∞ (T% X'))
    (hY' : ContMDiff J (J.prod 𝓘(ℝ, F)) ∞ (T% Y'))
    (hrelatedX : ∀ x, mfderiv I J f x (X x) = X' (f x))
    (hrelatedY : ∀ x, mfderiv I J f x (Y x) = Y' (f x))
    (x : M) (q : N → ℝ) (hq : ContMDiffAt J 𝓘(ℝ, ℝ) ∞ q (f x)) :
    mvfderiv J q (f x) (mfderiv I J f x (VectorField.mlieBracket I X Y x)) =
      mvfderiv J q (f x) (VectorField.mlieBracket J X' Y' (f x)) := by
  have hfd : MDifferentiable I J f := hf.mdifferentiable (by simp)
  have hqd : MDifferentiableAt J 𝓘(ℝ, ℝ) q (f x) := hq.mdifferentiableAt (by simp)
  have hq_near : ∀ᶠ y in 𝓝 (f x), MDifferentiableAt J 𝓘(ℝ, ℝ) q y := by
    filter_upwards [(contMDiffAt_iff_contMDiffAt_nhds (n := 1) (by simp)).mp
      (hq.of_le (by simp))] with y hy
    exact hy.mdifferentiableAt (by simp)
  have hchain (Z : (x : M) → TangentSpace I x) (Z' : (y : N) → TangentSpace J y)
      (hZ : ∀ y, mfderiv I J f y (Z y) = Z' (f y)) :
      (fun y => mvfderiv I (q ∘ f) y (Z y)) =ᶠ[𝓝 x]
        (fun y => mvfderiv J q (f y) (Z' (f y))) := by
    filter_upwards [hf.continuous.continuousAt.eventually hq_near] with y hy
    rw [mvfderiv_comp_apply y hy (hfd y), hZ y]
  have hchainX : mvfderiv I (fun y => mvfderiv I (q ∘ f) y (X y)) x =
      mvfderiv I (fun y => mvfderiv J q (f y) (X' (f y))) x := by
    exact (hchain X X' hrelatedX).mfderiv_eq (I := I) (I' := 𝓘(ℝ, ℝ))
  have hchainY : mvfderiv I (fun y => mvfderiv I (q ∘ f) y (Y y)) x =
      mvfderiv I (fun y => mvfderiv J q (f y) (Y' (f y))) x := by
    exact (hchain Y Y' hrelatedY).mfderiv_eq (I := I) (I' := 𝓘(ℝ, ℝ))
  have hqX : MDifferentiableAt J 𝓘(ℝ, ℝ)
      (fun y => mvfderiv J q y (X' y)) (f x) :=
    (DifferentialGeometry.mvfderiv_apply_contMDiffAt J hq
      (⟨X', hX'⟩ : ContMDiffSection J F ∞ (TangentSpace J))).mdifferentiableAt (by simp)
  have hqY : MDifferentiableAt J 𝓘(ℝ, ℝ)
      (fun y => mvfderiv J q y (Y' y)) (f x) :=
    (DifferentialGeometry.mvfderiv_apply_contMDiffAt J hq
      (⟨Y', hY'⟩ : ContMDiffSection J F ∞ (TangentSpace J))).mdifferentiableAt (by simp)
  rw [← mvfderiv_comp_apply x hqd (hfd x)]
  rw [DifferentialGeometry.mvfderiv_apply_mlieBracket X Y (q ∘ f) x
    ((hX x).of_le (by simp)) ((hY x).of_le (by simp))
    ((hq.comp x (hf x)).of_le (by simp))]
  rw [hchainY, hchainX]
  rw [show (fun y => mvfderiv J q (f y) (Y' (f y))) =
      (fun y => mvfderiv J q y (Y' y)) ∘ f from rfl,
    show (fun y => mvfderiv J q (f y) (X' (f y))) =
      (fun y => mvfderiv J q y (X' y)) ∘ f from rfl]
  rw [mvfderiv_comp_apply x hqY (hfd x), mvfderiv_comp_apply x hqX (hfd x),
    hrelatedX x, hrelatedY x]
  exact (DifferentialGeometry.mvfderiv_apply_mlieBracket X' Y' q (f x)
    ((hX' (f x)).of_le (by simp)) ((hY' (f x)).of_le (by simp))
    (hq.of_le (by simp))).symm

set_option backward.isDefEq.respectTransparency false in
/-- The brackets of smooth vector fields related by a smooth map are again related. -/
theorem mfderiv_mlieBracket_of_related
    (hf : ContMDiff I J ∞ f)
    (hX : ContMDiff I (I.prod 𝓘(ℝ, E)) ∞ (T% X))
    (hY : ContMDiff I (I.prod 𝓘(ℝ, E)) ∞ (T% Y))
    (hX' : ContMDiff J (J.prod 𝓘(ℝ, F)) ∞ (T% X'))
    (hY' : ContMDiff J (J.prod 𝓘(ℝ, F)) ∞ (T% Y'))
    (hrelatedX : ∀ x, mfderiv I J f x (X x) = X' (f x))
    (hrelatedY : ∀ x, mfderiv I J f x (Y x) = Y' (f x))
    (x : M) :
    mfderiv I J f x (VectorField.mlieBracket I X Y x) =
      VectorField.mlieBracket J X' Y' (f x) := by
  apply (isInvertible_mfderiv_extChartAt (I := J) (mem_extChartAt_source (f x))).injective
  apply (NormedSpace.fromTangentSpace (extChartAt J (f x) (f x))).injective
  apply (SeparatingDual.eq_iff_forall_dual_eq (R := ℝ)).mpr
  intro ℓ
  have hq : ContMDiffAt J 𝓘(ℝ, ℝ) ∞ (ℓ ∘ extChartAt J (f x)) (f x) :=
    ℓ.contMDiff.contMDiffAt.comp (f x) contMDiffAt_extChartAt
  have h := scalar_mfderiv_mlieBracket_of_related hf hX hY hX' hY'
    hrelatedX hrelatedY x (ℓ ∘ extChartAt J (f x)) hq
  change (mfderiv J 𝓘(ℝ, ℝ) (ℓ ∘ extChartAt J (f x)) (f x))
      (mfderiv I J f x (VectorField.mlieBracket I X Y x)) =
    (mfderiv J 𝓘(ℝ, ℝ) (ℓ ∘ extChartAt J (f x)) (f x))
      (VectorField.mlieBracket J X' Y' (f x)) at h
  rw [mfderiv_comp (f x) ((ℓ.contMDiff (n := ∞)).mdifferentiable (by simp) _)
    ((contMDiffAt_extChartAt (n := ∞)).mdifferentiableAt (by simp)),
    mfderiv_eq_fderiv, ℓ.fderiv] at h
  exact h

end LieGroups.Manifold

import LieGroups.Manifold.FoliationAtlas
import Mathlib.Analysis.Calculus.MeanValue
import Mathlib.Geometry.Manifold.MFDeriv.FDeriv

/-!
# Foliation atlases from charts straightening a distribution

The differential horizontal-space condition implies the locally constant transverse
transition condition needed for intrinsic plaque gluing.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups.Manifold

variable {E P Q : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]

set_option backward.isDefEq.respectTransparency false in
/-- Inverse coordinates send horizontal vectors into the straightened distribution. -/
theorem mfderiv_symm_horizontal_mem
    (D : ∀ x : M, Submodule ℝ (TangentSpace I x))
    (c : PartialDiffeomorph I 𝓘(ℝ, P × Q) M (P × Q) ∞)
    (hc : ∀ x ∈ c.source,
      (D x).map (mfderiv I 𝓘(ℝ, P × Q) c x).toLinearMap =
        LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap)
    (y : P × Q) (hy : y ∈ c.target) (v : P) :
    mfderiv 𝓘(ℝ, P × Q) I c.symm y (v, 0) ∈ D (c.symm y) := by
  have hx := c.map_target hy
  have hmem : (v, 0) ∈ (D (c.symm y)).map
      (mfderiv I 𝓘(ℝ, P × Q) c (c.symm y)).toLinearMap := by
    erw [hc _ hx]
    exact ⟨v, rfl⟩
  obtain ⟨w, hw, hweq⟩ := hmem
  have heq : (fun x : M => c.symm (c x)) =ᶠ[𝓝 (c.symm y)] id := by
    filter_upwards [c.open_source.mem_nhds hx] with x hx'
    exact c.left_inv hx'
  have hcs : MDifferentiableAt 𝓘(ℝ, P × Q) I c.symm (c (c.symm y)) := by
    erw [c.right_inv hy]
    exact c.symm.mdifferentiableAt (by simp) hy
  have hder := heq.mfderiv_eq (I := I) (I' := I)
  erw [mfderiv_comp _ hcs (c.mdifferentiableAt (by simp) hx), mfderiv_id,
    c.right_inv hy] at hder
  have hinv := congrArg (fun L : TangentSpace I (c.symm y) →L[ℝ]
      TangentSpace I (c.symm y) => L w) hder
  change mfderiv 𝓘(ℝ, P × Q) I c.symm y
    (mfderiv I 𝓘(ℝ, P × Q) c (c.symm y) w) = w at hinv
  erw [hweq] at hinv
  exact hinv.symm ▸ hw

namespace FoliationAtlas

set_option backward.isDefEq.respectTransparency false in
/-- Differential chart data suffice for an actual compatible foliation atlas; plaque
compatibility is a conclusion of the zero transverse derivative argument. -/
def of_distributionCharts
    (D : ∀ x : M, Submodule ℝ (TangentSpace I x))
    (c : M → PartialDiffeomorph I 𝓘(ℝ, P × Q) M (P × Q) ∞)
    (hcover : ∀ a, a ∈ (c a).source)
    (hD : ∀ a x, x ∈ (c a).source →
      (D x).map (mfderiv I 𝓘(ℝ, P × Q) (c a) x).toLinearMap =
        LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap) :
    FoliationAtlas (P := P) (Q := Q) I M where
  chart := c
  mem_source := hcover
  transverse_locally_constant := by
    intro a b u z hu hub
    let W : Set P := {v | (v, z) ∈ (c a).target ∧ (c a).symm (v, z) ∈ (c b).source}
    let f : P → Q := fun v => ((c b) ((c a).symm (v, z))).2
    have hsmooth : ∀ v ∈ W, ContDiffAt ℝ ∞ f v := by
      intro v hv
      have hi : ContMDiffAt 𝓘(ℝ, P) 𝓘(ℝ, P × Q) ∞ (fun p : P => (p, z)) v :=
        (contDiff_id.prodMk contDiff_const).contMDiff.contMDiffAt
      have ha := ((c a).contMDiffOn_invFun.contMDiffAt
        ((c a).open_target.mem_nhds hv.1)).comp v hi
      have hb := ((c b).contMDiffOn_toFun.contMDiffAt
        ((c b).open_source.mem_nhds hv.2)).comp v ha
      exact contMDiffAt_iff_contDiffAt.mp (contDiff_snd.contMDiff.contMDiffAt.comp v hb)
    have hW : IsOpen W := by
      rw [isOpen_iff_mem_nhds]
      intro v hv
      have ht := ((c a).open_target.preimage
        (continuous_id.prodMk continuous_const)).mem_nhds hv.1
      have hi₁ : ContinuousAt (fun p : P × Q => (c a).symm p) (v, z) :=
        ((c a).contMDiffOn_invFun.contMDiffAt
          ((c a).open_target.mem_nhds hv.1)).continuousAt
      have hi : ContinuousAt (fun p : P => (c a).symm (p, z)) v :=
        ContinuousAt.comp (g := fun p : P × Q => (c a).symm p)
          (f := fun p : P => (p, z)) hi₁
            (continuous_id.prodMk continuous_const).continuousAt
      have hs := hi.preimage_mem_nhds ((c b).open_source.mem_nhds hv.2)
      exact inter_mem ht hs
    have hzero : W.EqOn (fderiv ℝ f) 0 := by
      intro v hv
      have hi := (hasFDerivAt_prodMk_left (𝕜 := ℝ) v z).hasMFDerivAt
      have ha := ((c a).symm.mdifferentiableAt (by simp) hv.1).hasMFDerivAt.comp v hi
      have hb := ((c b).mdifferentiableAt (by simp) hv.2).hasMFDerivAt.comp v ha
      have hf := (hasFDerivAt_snd (𝕜 := ℝ)
        (p := (c b) ((c a).symm (v, z)))).hasMFDerivAt.comp v hb
      have hf' : HasFDerivAt f ((ContinuousLinearMap.snd ℝ P Q).comp
          ((mfderiv I 𝓘(ℝ, P × Q) (c b) ((c a).symm (v, z))).comp
            ((mfderiv 𝓘(ℝ, P × Q) I (c a).symm (v, z)).comp
              (ContinuousLinearMap.inl ℝ P Q)))) v := hf.hasFDerivAt
      have hfd := hf'.fderiv
      rw [hfd]
      ext w
      have haD := mfderiv_symm_horizontal_mem D (c a) (hD a) (v, z) hv.1 w
      have hbD : mfderiv I 𝓘(ℝ, P × Q) (c b) ((c a).symm (v, z))
          (mfderiv 𝓘(ℝ, P × Q) I (c a).symm (v, z) (w, 0)) ∈
          LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap := by
        erw [← hD b _ hv.2]
        exact ⟨_, haD, rfl⟩
      obtain ⟨w', hw'⟩ := hbD
      change (mfderiv I 𝓘(ℝ, P × Q) (c b) ((c a).symm (v, z))
        (mfderiv 𝓘(ℝ, P × Q) I (c a).symm (v, z) (w, 0))).2 = 0
      exact (congrArg Prod.snd hw').symm
    have hopen := hW.isOpen_inter_preimage_of_fderiv_eq_zero
      (fun v hv => (hsmooth v hv).differentiableAt (by simp) |>.differentiableWithinAt)
      hzero {f u}
    have huW : u ∈ W := ⟨hu, hub⟩
    filter_upwards [hopen.mem_nhds ⟨huW, rfl⟩] with v hv
    exact hv.2

end FoliationAtlas

end LieGroups.Manifold

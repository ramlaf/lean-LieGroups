import LieGroups.Manifold.FoliationAtlas
import Mathlib.Algebra.Group.Subgroup.Basic

/-!
# The identity leaf as a group

Continuity of left translations alone implies that the connected component of the identity
is a subgroup. Applied to the constructed leafwise topology, this equips the intrinsic
identity leaf with its group structure, without assuming continuity of inversion.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups.Manifold

/-- The identity component is a subgroup whenever all left translations are continuous. -/
def identityComponentSubgroupOfContinuousLeft {G : Type*} [Group G] [TopologicalSpace G]
    (hL : ∀ a : G, Continuous (fun b : G => a * b)) : Subgroup G where
  carrier := connectedComponent (1 : G)
  one_mem' := mem_connectedComponent
  mul_mem' := by
    intro a b ha hb
    have h := (hL a).mapsTo_connectedComponent (1 : G) hb
    simpa only [mul_one, connectedComponent_eq ha] using h
  inv_mem' := by
    intro a ha
    have h := (hL a⁻¹).mapsTo_connectedComponent a
      (show (1 : G) ∈ connectedComponent a by
        rw [← connectedComponent_eq ha]
        exact mem_connectedComponent)
    simpa only [mul_one, inv_mul_cancel] using h

namespace FoliationAtlas

variable {E P Q : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [Group M] [TopologicalSpace M] [ChartedSpace H M]
  (A : FoliationAtlas (P := P) (Q := Q) I M)

instance : Group A.Leafwise := inferInstanceAs (Group M)

/-- The subgroup on the ambient underlying group selected by the intrinsic identity leaf. -/
def identityLeafSubgroup
    (hL : ∀ a : A.Leafwise, Continuous (fun b : A.Leafwise => a * b)) :
    Subgroup A.Leafwise := identityComponentSubgroupOfContinuousLeft hL

/-- The group structure on the actual open connected identity leaf. -/
@[instance_reducible]
def identityLeafGroup
    (hL : ∀ a : A.Leafwise, Continuous (fun b : A.Leafwise => a * b)) :
    Group (A.leaf 1) := inferInstanceAs (Group (A.identityLeafSubgroup hL))

end FoliationAtlas

end LieGroups.Manifold

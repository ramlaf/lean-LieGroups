import Mathlib.Geometry.Manifold.Immersion
import Mathlib.Geometry.Manifold.MFDeriv.SpecificFunctions

/-!
# Local left inverses of immersions

Projecting an immersion's adapted target chart onto the source coordinates gives a smooth
local left inverse. This uses the chart normal form, with no assumption on the differential.
For a boundaryless source model, the chain rule then proves that differential is injective.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter
open scoped Topology ContDiff Manifold

namespace LieGroups.Manifold

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  {E' : Type*} [NormedAddCommGroup E'] [NormedSpace 𝕜 E']
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners 𝕜 E' H'}
  {N : Type*} [TopologicalSpace N] [ChartedSpace H' N]
  {n : ℕ∞ω} [I.Boundaryless]

/-- An immersion from a boundaryless model has a local `C^n` left inverse through its
base point. The map is a total function, but smoothness and the left-inverse law are local. -/
theorem exists_contMDiffAt_localLeftInverse_of_isImmersionAt {f : M → N} {x : M}
    (h : _root_.Manifold.IsImmersionAt I J n f x) :
    ∃ g : N → M, g (f x) = x ∧ ContMDiffAt J I n g (f x) ∧
      (g ∘ f) =ᶠ[𝓝 x] id := by
  let a := h.domChart.extend I
  let b := h.codChart.extend J
  let p : N → E := fun y => (h.equiv.symm (b y)).1
  have hx : x ∈ a.source := by simpa [a] using h.mem_domChart_source
  have ha : a x ∈ a.target := a.map_source hx
  have hcoordinate : ∀ y ∈ a.source, p (f y) = a y := by
    intro y hy
    have hw := h.writtenInCharts (a.map_source hy)
    change b (f (a.symm (a y))) = h.equiv (a y, 0) at hw
    rw [a.left_inv hy] at hw
    simp only [p, hw, h.equiv.symm_apply_apply]
  have hb : ContMDiffAt J 𝓘(𝕜, E') n b (f x) :=
    h.codChart.contMDiffAt_extend h.codChart_mem_maximalAtlas h.mem_codChart_source
  have hp : ContMDiffAt J 𝓘(𝕜, E) n p (f x) := by
    have hlinear : ContMDiff 𝓘(𝕜, E') 𝓘(𝕜, E) n
        (fun z : E' => (h.equiv.symm z).1) := by
      rw [contMDiff_iff_contDiff]
      fun_prop
    exact hlinear.contMDiffAt.comp (f x) hb
  have hai : ContMDiffAt 𝓘(𝕜, E) I n a.symm (p (f x)) := by
    rw [hcoordinate x hx]
    apply (contMDiffOn_extend_symm h.domChart_mem_maximalAtlas).contMDiffAt
    simpa only [← h.domChart.extend_target'] using
      h.domChart.isOpen_extend_target.mem_nhds ha
  refine ⟨a.symm ∘ p, ?_, hai.comp (f x) hp, ?_⟩
  · simpa only [comp_apply, hcoordinate x hx] using a.left_inv hx
  · filter_upwards [h.domChart.isOpen_extend_source.mem_nhds hx] with y hy
    change a.symm (p (f y)) = y
    rw [hcoordinate y hy, a.left_inv hy]

/-- The differential of a smooth immersion from a boundaryless model is injective. -/
theorem mfderiv_injective_of_isImmersionAt {f : M → N} {x : M}
    (h : _root_.Manifold.IsImmersionAt I J ∞ f x) :
    Function.Injective (mfderiv I J f x) := by
  obtain ⟨g, hgx, hg, hgf⟩ := exists_contMDiffAt_localLeftInverse_of_isImmersionAt h
  have hcomp := mfderiv_comp x (hg.mdifferentiableAt (by simp))
    (h.contMDiffAt.mdifferentiableAt (by simp))
  have heq := hgf.mfderiv_eq (I := I) (I' := I)
  have hid : Function.Injective (mfderiv I I (g ∘ f) x) := by
    rw [heq, mfderiv_id]
    intro v w hvw
    exact (tangentSpaceCast I x (g (f x))).injective hvw
  rw [hcomp] at hid
  exact Function.Injective.of_comp hid

/-- If the source topology is induced by the immersion, its smooth local left inverse
is also a right inverse locally within the image. This applies in particular to embedded
submanifolds and permits lifting ambient curves that stay in their image. -/
theorem exists_contMDiffAt_localInverseWithinRange_of_isImmersionAt
    {f : M → N} {x : M} (h : _root_.Manifold.IsImmersionAt I J n f x)
    (hind : Topology.IsInducing f) :
    ∃ g : N → M, g (f x) = x ∧ ContMDiffAt J I n g (f x) ∧
      (g ∘ f) =ᶠ[𝓝 x] id ∧ (f ∘ g) =ᶠ[𝓝[Set.range f] (f x)] id := by
  obtain ⟨g, hgx, hg, hgf⟩ := exists_contMDiffAt_localLeftInverse_of_isImmersionAt h
  refine ⟨g, hgx, hg, hgf, ?_⟩
  rw [← hind.map_nhds_eq x]
  change ∀ᶠ z in 𝓝 x, f (g (f z)) = f z
  exact hgf.mono fun z hz => congrArg f hz

end LieGroups.Manifold

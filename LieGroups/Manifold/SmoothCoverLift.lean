import Mathlib.Geometry.Manifold.LocalDiffeomorph

/-!
# Smooth lifts through a local diffeomorphism

A continuous lift of a smooth map through a local diffeomorphism is smooth.
This applies, in particular, to the continuous lifts used to construct covering
Lie groups.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

namespace LieGroups.Manifold

variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E F V : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  [NormedAddCommGroup V] [NormedSpace 𝕜 V]
  {H K L : Type*} [TopologicalSpace H] [TopologicalSpace K] [TopologicalSpace L]
  {I : ModelWithCorners 𝕜 E H} {J : ModelWithCorners 𝕜 F K}
  {W : ModelWithCorners 𝕜 V L}
  {M N A : Type*} [TopologicalSpace M] [ChartedSpace H M]
  [TopologicalSpace N] [ChartedSpace K N]
  [TopologicalSpace A] [ChartedSpace L A]
  {n : ℕ∞ω} {p : M → N} {f : A → M} {x : A}

/-- A continuous lift through a local diffeomorphism is smooth at a point
whenever its projection is smooth there. -/
theorem contMDiffAt_of_comp_localDiffeomorph
    (hp : IsLocalDiffeomorphAt I J n p (f x))
    (hf : ContinuousAt f x) (hpf : ContMDiffAt W J n (p ∘ f) x) :
    ContMDiffAt W I n f x := by
  have hi := hp.localInverse_contMDiffAt.comp x hpf
  apply hi.congr_of_eventuallyEq
  filter_upwards [hf.preimage_mem_nhds
    (hp.localInverse.open_target.mem_nhds hp.localInverse_mem_target)] with y hy
  exact (hp.localInverse_left_inv hy).symm

/-- Smoothness of a continuous lift can be checked after projection through a
local diffeomorphism. -/
theorem contMDiff_of_comp_localDiffeomorph (hp : IsLocalDiffeomorph I J n p)
    (hf : Continuous f) (hpf : ContMDiff W J n (p ∘ f)) :
    ContMDiff W I n f :=
  fun x => contMDiffAt_of_comp_localDiffeomorph (hp (f x)) hf.continuousAt (hpf x)

end LieGroups.Manifold

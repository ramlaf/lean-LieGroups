import Mathlib.Geometry.Manifold.IntegralCurve.Basic
import Mathlib.Geometry.Manifold.VectorBundle.Tangent
import Mathlib.Analysis.Calculus.ContDiff.Operations

/-!
# Smoothness of integral curves

The integral equation bootstraps regularity in local coordinates: if a curve is `C^n`,
the smooth vector field along it is `C^n`, so its coordinate derivative is `C^n` and the
curve is `C^(n+1)`. This concerns time regularity, not dependence on initial conditions.

AI-assistance disclosure: generated by OpenAI Codex on 2026-09-28.
-/

open Function Set
open scoped Topology ContDiff Manifold

namespace LieGroups.Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]

set_option backward.isDefEq.respectTransparency false in
/-- A global integral curve of a smooth vector field is smooth in time. -/
theorem contMDiff_isMIntegralCurve {γ : ℝ → M} {V : (x : M) → TangentSpace I x}
    (hγ : IsMIntegralCurve γ V)
    (hV : ContMDiff I I.tangent ∞ (fun x => (⟨x, V x⟩ : TangentBundle I M))) :
    ContMDiff 𝓘(ℝ, ℝ) I ∞ γ := by
  rw [contMDiff_infty]
  intro n
  induction n with
  | zero => exact contMDiff_zero_iff.mpr hγ.continuous
  | succ n hn =>
    intro t₀
    rw [contMDiffAt_iff_target]
    refine ⟨hγ.continuous.continuousAt, ?_⟩
    rw [contMDiffAt_iff_contDiffAt]
    have hcoord := (contMDiffAt_iff_target.mp
      (((hV.of_le (by simp)).comp hn).contMDiffAt (x := t₀))).2.contDiffAt.snd
    have hs : ContDiffAt ℝ n
        (fun t => tangentCoordChange I (γ t) (γ t₀) (γ t) (V (γ t))) t₀ := by
      simp only [Function.comp_apply, FiberBundle.extChartAt, PartialEquiv.trans_apply] at hcoord
      exact hcoord
    rw [show ((n + 1 : ℕ) : ℕ∞ω) = (n : ℕ∞ω) + 1 by simp,
      contDiffAt_succ_iff_hasFDerivAt]
    refine ⟨fun t => (1 : ℝ →L[ℝ] ℝ).smulRight
      (tangentCoordChange I (γ t) (γ t₀) (γ t) (V (γ t))), ?_, ?_⟩
    · obtain ⟨u, hu, hd⟩ := Filter.eventually_iff_exists_mem.mp
        (hγ.isMIntegralCurveAt t₀).eventually_hasDerivAt
      exact ⟨u, hu, fun t ht => (hd t ht).hasFDerivAt⟩
    · exact contDiffAt_const.smulRight hs

end LieGroups.Manifold

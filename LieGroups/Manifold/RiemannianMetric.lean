import DifferentialGeometry.Geometry.Metric.Basic
import DifferentialGeometry.Geometry.Metric.TensorInner.PosDefBilinBoundedUnitBall
import DifferentialGeometry.Bundle.ClmSectionSmooth

/-!
# Constructing smooth metrics from scalar pairings

In finite dimension, positivity supplies the boundedness condition needed by an actual
Riemannian metric. Smoothness can be checked by pairing with two smooth vector fields.
The existing tangent-space topology is retained throughout.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section

open Bundle
open scoped ContDiff Manifold Topology

namespace LieGroups.Manifold

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  [FiniteDimensional ℝ F]

/-- A positive continuous bilinear form has a bounded open unit ball in finite dimension,
including when the vector space is zero-dimensional. -/
theorem finiteDimensional_posDef_isVonNBounded
    (B : F →L[ℝ] F →L[ℝ] ℝ)
    (hpos : ∀ v : F, v ≠ 0 → 0 < B v v) :
    Bornology.IsVonNBounded ℝ {v : F | B v v < 1} := by
  classical
  rw [NormedSpace.isVonNBounded_iff]
  by_cases hF : Nontrivial F
  · let := hF
    apply DifferentialGeometry.Tensor.Tensor0SRiemannian.posDef_bilin_unit_ball_isBounded
      B hpos
    · intro v
      by_cases hv : v = 0
      · simp [hv]
      · exact le_of_lt (hpos v hv)
    · intro c v w
      simp
    · intro c v w
      simp
  · let : Subsingleton F := not_nontrivial_iff_subsingleton.mp hF
    apply (Metric.isBounded_iff_subset_ball (0 : F)).mpr
    refine ⟨1, fun v _ => ?_⟩
    have hv : v = 0 := Subsingleton.elim v 0
    simp [hv]

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [T2Space M]

/-- A bilinear tensor is smooth if all its evaluations on pairs of smooth vector fields
are smooth scalar functions. -/
theorem contMDiff_bilinearSection_of_pairings
    (q : ∀ x : M, TangentSpace I x →L[ℝ] TangentSpace I x →L[ℝ] ℝ)
    (hsmooth : ∀ (Y Z : Cₛ^∞⟮I; E, (TangentSpace I : M → Type _)⟯),
      ContMDiff I 𝓘(ℝ, ℝ) ∞ (fun x => q x (Y x) (Z x))) :
    ContMDiff I (I.prod 𝓘(ℝ, E →L[ℝ] E →L[ℝ] ℝ)) ∞
      (fun x => TotalSpace.mk' (E →L[ℝ] E →L[ℝ] ℝ) x (q x)) := by
  apply DifferentialGeometry.cotangentCov_clmSection_smooth_aux
    (V₂ := fun x : M => TangentSpace I x →L[ℝ] ℝ) q
  intro Y
  apply DifferentialGeometry.cotangentCov_clmSection_smooth_aux
    (V₂ := fun _ : M => ℝ) (fun x => q x (Y x))
  intro Z x
  rw [contMDiffAt_section]
  refine (hsmooth Y Z x).congr_of_eventuallyEq ?_
  filter_upwards with y
  rfl

/-- Construct an actual smooth Riemannian metric from a positive symmetric bilinear
field whose pairings with smooth vector fields are smooth. -/
def smoothRiemannianMetricOfPairings
    (q : ∀ x : M, TangentSpace I x →L[ℝ] TangentSpace I x →L[ℝ] ℝ)
    (hsymm : ∀ x v w, q x v w = q x w v)
    (hpos : ∀ x v, v ≠ 0 → 0 < q x v v)
    (hsmooth : ∀ (Y Z : Cₛ^∞⟮I; E, (TangentSpace I : M → Type _)⟯),
      ContMDiff I 𝓘(ℝ, ℝ) ∞ (fun x => q x (Y x) (Z x))) :
    DifferentialGeometry.SmoothRiemannianMetric I M where
  inner := q
  symm := hsymm
  pos := hpos
  isVonNBounded x := finiteDimensional_posDef_isVonNBounded (q x) (hpos x)
  contMDiff := contMDiff_bilinearSection_of_pairings q hsmooth

@[simp]
theorem smoothRiemannianMetricOfPairings_inner
    (q : ∀ x : M, TangentSpace I x →L[ℝ] TangentSpace I x →L[ℝ] ℝ)
    (hsymm : ∀ x v w, q x v w = q x w v)
    (hpos : ∀ x v, v ≠ 0 → 0 < q x v v)
    (hsmooth : ∀ (Y Z : Cₛ^∞⟮I; E, (TangentSpace I : M → Type _)⟯),
      ContMDiff I 𝓘(ℝ, ℝ) ∞ (fun x => q x (Y x) (Z x)))
    (x : M) (v w : TangentSpace I x) :
    (smoothRiemannianMetricOfPairings q hsymm hpos hsmooth).inner x v w = q x v w := rfl

end LieGroups.Manifold

import LieGroups.UniversalCoverGroup

/-!
# Smooth universal covering groups from ordinary Lie group data

The construction takes a connected Hausdorff finite-dimensional real Lie group.
Its output lies on the actual based-path universal cover with its covering-space
topology. Local path connectedness, semilocal simple connectedness, the group
operations, and their smoothness are all derived in the construction.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Function
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
  (G : Type*) [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

/-- A smooth covering Lie group on the actual identity-based universal covering
space, with its original covering topology. The group and atlas are outputs. -/
structure UniversalCoverLieGroup where
  [group : Group (UniversalCoverGroup G)]
  [chartedSpace : ChartedSpace H (UniversalCoverGroup G)]
  [lieGroup : LieGroup I ∞ (UniversalCoverGroup G)]
  [t2Space : T2Space (UniversalCoverGroup G)]
  [simplyConnectedSpace : SimplyConnectedSpace (UniversalCoverGroup G)]
  /-- The covering homomorphism is the ordinary endpoint projection. -/
  projection : UniversalCoverGroup G →* G
  projection_eq : (projection : UniversalCoverGroup G → G) = UniversalCoverGroup.projection
  projection_surjective : Surjective projection
  projection_isCoveringMap : IsCoveringMap (projection : UniversalCoverGroup G → G)
  projection_isLocalDiffeomorph : IsLocalDiffeomorph I I ∞
    (projection : UniversalCoverGroup G → G)
  projection_smooth : ContMDiff I I ∞ (projection : UniversalCoverGroup G → G)
  /-- The Lie-algebra identification is the differential of the projection. -/
  lieEquiv : GroupLieAlgebra I (UniversalCoverGroup G) ≃ₗ⁅ℝ⁆ GroupLieAlgebra I G
  lieEquiv_eq : lieEquiv.toLieHom = homLieHom projection projection_smooth

variable {I G}

namespace UniversalCoverLieGroup

/-- The constructed covering group, retaining the original universal-cover
topology and carrying the bundle's constructed group and manifold instances. -/
def Space (_C : UniversalCoverLieGroup I G) : Type _ := UniversalCoverGroup G

instance (C : UniversalCoverLieGroup I G) : TopologicalSpace C.Space :=
  inferInstanceAs (TopologicalSpace (UniversalCoverGroup G))
instance (C : UniversalCoverLieGroup I G) : Group C.Space := C.group
instance (C : UniversalCoverLieGroup I G) : ChartedSpace H C.Space := C.chartedSpace
instance (C : UniversalCoverLieGroup I G) : LieGroup I ∞ C.Space := C.lieGroup
instance (C : UniversalCoverLieGroup I G) : T2Space C.Space := C.t2Space
instance (C : UniversalCoverLieGroup I G) : SimplyConnectedSpace C.Space := C.simplyConnectedSpace

/-- The constructed smooth covering homomorphism. -/
def coveringHom (C : UniversalCoverLieGroup I G) : C.Space →* G := C.projection

theorem coveringHom_smooth (C : UniversalCoverLieGroup I G) :
    ContMDiff I I ∞ (C.coveringHom : C.Space → G) := C.projection_smooth

theorem coveringHom_isCoveringMap (C : UniversalCoverLieGroup I G) :
    IsCoveringMap (C.coveringHom : C.Space → G) := C.projection_isCoveringMap

theorem coveringHom_surjective (C : UniversalCoverLieGroup I G) :
    Surjective C.coveringHom := C.projection_surjective

/-- The tangent Lie-algebra identification of the constructed cover. -/
def differentialLieEquiv (C : UniversalCoverLieGroup I G) :
    GroupLieAlgebra I C.Space ≃ₗ⁅ℝ⁆ GroupLieAlgebra I G := C.lieEquiv

theorem differentialLieEquiv_eq (C : UniversalCoverLieGroup I G) :
    C.differentialLieEquiv.toLieHom = homLieHom C.coveringHom C.coveringHom_smooth :=
  C.lieEquiv_eq

end UniversalCoverLieGroup

/-- Every connected Hausdorff finite-dimensional real Lie group with boundaryless
model has a constructed smooth group structure on its actual universal cover.
No smooth covering group or continuous group law is supplied as input. -/
theorem nonempty_universalCoverLieGroup [I.Boundaryless] [T2Space G] [ConnectedSpace G] :
    Nonempty (UniversalCoverLieGroup I G) := by
  let : IsTopologicalGroup G := topologicalGroup_of_lieGroup (I := I) (n := ∞) (G := G)
  let : LocallyPathConnectedSpace H :=
    I.toHomeomorph.symm.isQuotientMap.locallyPathConnectedSpace
  let : LocallyPathConnectedSpace G := ChartedSpace.locallyPathConnectedSpace H G
  let : DifferentialGeometry.Geometry.Riemannian.Topology.SemilocallySimplyConnectedSpace G :=
    DifferentialGeometry.Geometry.Riemannian.Topology.manifold_semilocallySimplyConnectedSpace
      (I := I)
  let : PathConnectedSpace G := PathConnectedSpace.of_locallyPathConnectedSpace
  have hs : Surjective (UniversalCoverGroup.projection : UniversalCoverGroup G → G) := by
    intro g
    exact ⟨⟨g, Path.Homotopic.Quotient.mk (PathConnectedSpace.somePath 1 g)⟩, rfl⟩
  exact ⟨{
    group := inferInstance
    chartedSpace := inferInstance
    lieGroup := inferInstance
    t2Space := inferInstance
    simplyConnectedSpace := inferInstance
    projection := UniversalCoverGroup.projectionHom
    projection_eq := rfl
    projection_surjective := hs
    projection_isCoveringMap := UniversalCoverGroup.isCoveringMap_projection
    projection_isLocalDiffeomorph := UniversalCoverGroup.isLocalDiffeomorph_projection
    projection_smooth := UniversalCoverGroup.contMDiff_projection
    lieEquiv := UniversalCoverGroup.projectionLieEquiv
    lieEquiv_eq := by ext v; rfl
  }⟩

end LieGroups

import LieGroups.InvariantFoliationCharts
import LieGroups.ImmersedLieSubgroup
import LieGroups.InvariantLeafOperations
import LieGroups.Manifold.FoliationImmersion
import LieGroups.Manifold.FoliationTangent

/-!
# Connected immersed integrations of real Lie subalgebras

An integration retains its intrinsic connected Hausdorff Lie group and an actual
injective immersion into the ambient group. Its tangent Lie algebra is required
to be exactly the specified subalgebra. The underlying subgroup is consequently
the subgroup generated by that subalgebra's exponentials.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open scoped Topology ContDiff Manifold

namespace LieGroups

universe uG

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type uG} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

/-- A connected immersed integration, with its own topology and smooth structure.
The source model is the given Lie subalgebra in ambient model coordinates. -/
structure LieSubalgebraIntegration (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) where
  /-- The intrinsic integrating group. -/
  Carrier : Type uG
  [group : Group Carrier]
  [topology : TopologicalSpace Carrier]
  [chartedSpace : ChartedSpace (lieSubalgebraModelSubmodule S) Carrier]
  [lieGroup : LieGroup 𝓘(ℝ, lieSubalgebraModelSubmodule S) ∞ Carrier]
  [connectedSpace : ConnectedSpace Carrier]
  [t2Space : T2Space Carrier]
  /-- The injective immersive group homomorphism into the ambient group. -/
  presentation : ImmersedLieSubgroup I G 𝓘(ℝ, lieSubalgebraModelSubmodule S) Carrier
  /-- The differentiated inclusion has exactly the prescribed image. -/
  lieAlgebra_eq : presentation.lieAlgebra = S

attribute [instance] LieSubalgebraIntegration.group LieSubalgebraIntegration.topology
  LieSubalgebraIntegration.chartedSpace LieSubalgebraIntegration.lieGroup
  LieSubalgebraIntegration.connectedSpace LieSubalgebraIntegration.t2Space

namespace LieSubalgebraIntegration

variable {S : LieSubalgebra ℝ (GroupLieAlgebra I G)}

/-- Every connected immersed integration has the canonical exponential-generated image. -/
theorem subgroup_eq_lieSubalgebraSubgroup [BoundarylessManifold I G] [T2Space G]
    (J : LieSubalgebraIntegration S) :
    J.presentation.subgroup = lieSubalgebraSubgroup S := by
  rw [J.presentation.subgroup_eq_lieSubalgebraSubgroup, J.lieAlgebra_eq]

/-- The ambient subgroup is unique among connected immersed integrations.
This does not assert that its intrinsic topology is the ambient subspace topology. -/
theorem subgroup_eq [BoundarylessManifold I G] [T2Space G]
    (J K : LieSubalgebraIntegration S) :
    J.presentation.subgroup = K.presentation.subgroup := by
  rw [J.subgroup_eq_lieSubalgebraSubgroup, K.subgroup_eq_lieSubalgebraSubgroup]

end LieSubalgebraIntegration

set_option backward.isDefEq.respectTransparency false in
/-- Every Lie subalgebra of a finite-dimensional real Lie group with a
boundaryless model has a connected Hausdorff immersed integration. Its group,
intrinsic topology, smooth structure, and inclusion are all constructed from
the subalgebra; no integrating manifold is supplied as a hypothesis. -/
theorem nonempty_lieSubalgebraIntegration [I.Boundaryless] [T2Space G]
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    Nonempty (LieSubalgebraIntegration S) := by
  obtain ⟨T, A, hD⟩ := exists_invariantDistribution_foliationAtlas S
  let P := lieSubalgebraModelSubmodule S
  have hleft (a : G) : ContMDiff 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ (A.leafwiseLeftMul a) :=
    A.contMDiff_leafwiseLeftMul_of_distribution_map S hD a
  let hL := A.continuous_mul_left_leafwise hleft
  let := A.identityLeafGroup hL
  let : LieGroup 𝓘(ℝ, P) ∞ (A.leaf 1) := A.lieGroup_identityLeaf hleft
  let f : A.leaf 1 →* G := {
    toFun := A.leafInclusion 1
    map_one' := rfl
    map_mul' := fun _ _ => rfl
  }
  have hc : IsLocalDiffeomorphAt I 𝓘(ℝ, P × T) ∞ (A.chart 1) (1 : G) :=
    ⟨A.chart 1, A.mem_source 1, Set.eqOn_refl _ _⟩
  let L : (P × T) ≃L[ℝ] E := (hc.mfderivToContinuousLinearEquiv (by simp)).symm
  let J : ImmersedLieSubgroup I G 𝓘(ℝ, P) (A.leaf 1) := {
    toMonoidHom := f
    injective := A.leafInclusion_injective 1
    isImmersion := A.isImmersion_leafInclusion L 1
  }
  have hr : LinearMap.range
      (mfderiv 𝓘(ℝ, P) I (A.leafInclusion 1) (1 : A.leaf 1)).toLinearMap =
        S.toSubmodule := by
    exact (A.range_mfderiv_leafInclusion (invariantDistribution S) hD 1 (1 : A.leaf 1)).trans
      (invariantDistribution_one S)
  have hJ : J.lieAlgebra = S := by
    ext v
    change v ∈ LinearMap.range
      (mfderiv 𝓘(ℝ, P) I (A.leafInclusion 1) (1 : A.leaf 1)).toLinearMap ↔ v ∈ S
    rw [hr]
    rfl
  exact ⟨{
    Carrier := A.leaf 1
    group := inferInstance
    topology := inferInstance
    chartedSpace := inferInstance
    lieGroup := inferInstance
    connectedSpace := inferInstance
    t2Space := inferInstance
    presentation := J
    lieAlgebra_eq := hJ
  }⟩

end LieGroups

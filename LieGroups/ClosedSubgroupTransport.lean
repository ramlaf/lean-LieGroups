import LieGroups.ConnectedSubgroup

/-!
# Closedness under smooth group equivalences

Closedness of isotropy is preserved by a supplied smooth group equivalence.
The canonical exponential-generated subgroup is natural under smooth group
homomorphisms, so this also transports the closedness condition on integrated
Lie subalgebras. Closedness is retained as a hypothesis, not inferred from
integration alone.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Set
open scoped ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {G' : Type*} [Group G'] [TopologicalSpace G'] [ChartedSpace H' G']

/-- A smooth group equivalence preserves and reflects closed subgroup images. -/
theorem isClosed_subgroup_map_iff (e : G ≃* G')
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun x => e.symm x)) (K : Subgroup G) :
    IsClosed (K.map e.toMonoidHom : Set G') ↔ IsClosed (K : Set G) := by
  let h : G ≃ₜ G' := {
    toEquiv := e.toEquiv
    continuous_toFun := he.continuous
    continuous_invFun := hi.continuous
  }
  exact h.isClosed_image

variable [LieGroup I ∞ G] [LieGroup J ∞ G'] [CompleteSpace E] [CompleteSpace F]
  [BoundarylessManifold I G] [BoundarylessManifold J G'] [T2Space G] [T2Space G']

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

/-- Smooth homomorphisms carry the canonical exponential-generated subgroup
onto the subgroup generated by the image Lie algebra. -/
theorem lieSubalgebraSubgroup_map (f : G →* G')
    (hf : ContMDiff I J ∞ (fun x => f x))
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    (lieSubalgebraSubgroup S).map f = lieSubalgebraSubgroup (S.map (homLieHom f hf)) := by
  rw [lieSubalgebraSubgroup, MonoidHom.map_closure, lieSubalgebraSubgroup]
  congr 1
  rw [image_image]
  ext g
  constructor
  · rintro ⟨v, hv, hg⟩
    exact ⟨homLieHom f hf v, ⟨v, hv, rfl⟩, (lieExp_map f hf v).symm.trans hg⟩
  · rintro ⟨w, ⟨v, hv, rfl⟩, hg⟩
    exact ⟨v, hv, (lieExp_map f hf v).trans hg⟩

/-- The closedness requirement on the integration of a Lie subalgebra is
preserved under an actual integrated smooth group isomorphism. -/
theorem isClosed_lieSubalgebraSubgroup_map_iff (e : G ≃* G')
    (he : ContMDiff I J ∞ (fun x => e x))
    (hi : ContMDiff J I ∞ (fun x => e.symm x))
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    IsClosed (lieSubalgebraSubgroup (S.map (homLieHom e.toMonoidHom he)) : Set G') ↔
      IsClosed (lieSubalgebraSubgroup S : Set G) := by
  rw [← lieSubalgebraSubgroup_map e.toMonoidHom he]
  exact isClosed_subgroup_map_iff e he hi _

end LieGroups

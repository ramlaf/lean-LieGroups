import LieGroups.FundamentalVectorField
import LieGroups.Analysis.MetricFlowVariation

/-!
# Fundamental fields of isometric actions are Killing

An invariant smooth metric has zero Lie derivative in every fundamental action
direction. We apply the genuine metric variation formula to the one-parameter
action flow, translated in time so the identity occurs at an interior positive time.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

open Function Set DifferentialGeometry
open scoped ContDiff Manifold Topology

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G] [T2Space G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [IsManifold J ∞ M]
  [MulAction G M] [ContMDiffSMul I J ∞ G M]
  [BoundarylessManifold J M] [J.Boundaryless] [T2Space M]

/-- The actual fundamental field, bundled as a smooth tangent section. -/
noncomputable def fundamentalVectorFieldSection (v : GroupLieAlgebra I G) :
    Cₛ^∞⟮J; F, (TangentSpace J : M → Type _)⟯ :=
  ⟨fundamentalVectorField (I := I) (J := J) v,
    contMDiff_fundamentalVectorField v⟩

set_option backward.isDefEq.respectTransparency false in
/-- Every fundamental field of a smooth metric-preserving action has zero metric
Lie derivative, the Killing equation. Metric invariance is an equality for the
actual differential of the action. -/
theorem lieDerivMetric_fundamentalVectorField_eq_zero
    (g : SmoothRiemannianMetric J M)
    (hg : ∀ (a : G) (x : M) (u z : TangentSpace J x),
      g.inner (a • x) (mfderiv J J (fun y : M => a • y) x u)
        (mfderiv J J (fun y : M => a • y) x z) = g.inner x u z)
    (v : GroupLieAlgebra I G) (x : M) (u z : TangentSpace J x) :
    PDE.DeTurck.lieDerivMetric g (fundamentalVectorFieldSection (I := I) v) x u z = 0 := by
  let Φ : ℝ → M ≃ₘ⟮J, J⟯ M :=
    fun s => Diffeomorph.smul I J ∞ (oneParameterCurve v (s + (-1)))
  let Y : Cₛ^∞⟮J; F, (TangentSpace J : M → Type _)⟯ :=
    fundamentalVectorFieldSection (I := I) v
  have hode : ∀ y : M, ∀ t ∈ Set.Ioo (0 : ℝ) 2,
      HasMFDerivWithinAt 𝓘(ℝ, ℝ) J (fun s : ℝ => (Φ s : M → M) y)
        (Set.Ici 0) t ((1 : ℝ →L[ℝ] ℝ).smulRight (Y ((Φ t : M → M) y))) := by
    intro y t _
    have hc := (oneParameterCurve_smul_isMIntegralCurve (I := I) (J := J) v y).comp_add (-1) t
    change HasMFDerivWithinAt 𝓘(ℝ, ℝ) J
      (fun s => oneParameterCurve v (s + (-1)) • y) (Set.Ici 0) t
      ((1 : ℝ →L[ℝ] ℝ).smulRight
        (fundamentalVectorField (I := I) (J := J) v (oneParameterCurve v (t + (-1)) • y)))
    exact hc.hasMFDerivWithinAt
  have hjoint : ContMDiff (𝓘(ℝ, ℝ).prod J) J ∞
      (fun q : ℝ × M => (Φ q.1 : M → M) q.2) := by
    exact ((oneParameterCurve_contMDiff v).comp
      (contMDiff_fst.add (contMDiff_const (c := (-1 : ℝ))))).smul contMDiff_snd
  have hd := Analysis.flow_slot_pos g (fun _ => Y) 2 Φ hode
    hjoint.contMDiffOn 1 (by norm_num) x u z
  have hconst : (fun s : ℝ => g.inner ((Φ s : M → M) x)
      (mfderiv J J (Φ s : M → M) x u) (mfderiv J J (Φ s : M → M) x z)) =
      (fun _ : ℝ => g.inner x u z) := by
    funext s
    exact hg (oneParameterCurve v (s + (-1))) x u z
  rw [hconst] at hd
  have hzero := (hd.hasDerivAt (Ici_mem_nhds (by norm_num : (0 : ℝ) < 1))).unique
    (hasDerivAt_const 1 (g.inner x u z))
  have hΦ : (Φ 1 : M → M) = id := by
    funext y
    simp [Φ]
  rw [hΦ, mfderiv_id] at hzero
  exact hzero

end LieGroups

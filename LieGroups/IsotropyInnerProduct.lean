/-!
# Integrating infinitesimal preservation of an inner product

For a differentiable linear representation of a connected Lie group, skew-adjointness
of its differential implies that every group element preserves the inner product.
The proof differentiates along the constructed one-parameter subgroups and then
uses generation by exponentials. No global invariance is assumed.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section

open scoped Topology ContDiff Manifold InnerProductSpace

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {G : Type*} [Group G] [TopologicalSpace G]
  [ChartedSpace H G] [LieGroup I ∞ G] [BoundarylessManifold I G] [T2Space G]

section Bilinear

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]

/-- The infinitesimal action of a continuous linear representation. -/
def representationDifferential (ρ : G →* (V →L[ℝ] V)) :
    GroupLieAlgebra I G →L[ℝ] (V →L[ℝ] V) :=
  mfderiv I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g) 1

set_option backward.isDefEq.respectTransparency false in
/-- A one-parameter subgroup is sent to a differentiable operator curve whose
initial derivative is the infinitesimal action. -/
theorem hasDerivAt_representation_oneParameterCurve_zero
    (ρ : G →* (V →L[ℝ] V))
    (hρ : MDifferentiable I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g))
    (X : GroupLieAlgebra I G) :
    HasDerivAt (fun t => ρ (oneParameterCurve X t)) (representationDifferential ρ X) 0 := by
  have h := (hρ (oneParameterCurve X 0)).hasMFDerivAt.comp 0
    (oneParameterCurve_hasMFDerivAt_zero X)
  have heq : (mfderiv I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g) (oneParameterCurve X 0))
      (tangentSpaceCast I (1 : G) (oneParameterCurve X 0) X) =
        representationDifferential ρ X := by
    rw [oneParameterCurve_zero]
    rfl
  have hd := h.hasFDerivAt.hasDerivAt
  change HasDerivAt (fun t => ρ (oneParameterCurve X t))
    ((mfderiv I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g) (oneParameterCurve X 0))
      (((1 : ℝ →L[ℝ] ℝ).smulRight
        (tangentSpaceCast I (1 : G) (oneParameterCurve X 0) X)) 1)) 0 at hd
  simpa only [ContinuousLinearMap.smulRight_apply, one_apply_eq_self, one_smul, heq] using hd

/-- The representation curve solves the constant-coefficient linear equation
given by the differential of the representation. -/
theorem hasDerivAt_representation_oneParameterCurve
    (ρ : G →* (V →L[ℝ] V))
    (hρ : MDifferentiable I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g))
    (X : GroupLieAlgebra I G) (t : ℝ) :
    HasDerivAt (fun s => ρ (oneParameterCurve X s))
      (representationDifferential ρ X * ρ (oneParameterCurve X t)) t := by
  have hzero := hasDerivAt_representation_oneParameterCurve_zero ρ hρ X
  have hshift := (show HasDerivAt (fun s => ρ (oneParameterCurve X s))
      (representationDifferential ρ X) (t - t) by simpa using hzero).comp_sub_const t t
  have h := hshift.mul_const (ρ (oneParameterCurve X t))
  have heq : (fun s => ρ (oneParameterCurve X (s - t)) * ρ (oneParameterCurve X t)) =
      (fun s => ρ (oneParameterCurve X s)) := by
    funext s
    rw [← map_mul, ← oneParameterCurve_add, sub_add_cancel]
  rwa [heq] at h

/-- Infinitesimal invariance of a continuous bilinear form integrates along
one-parameter subgroups. Symmetry and positive definiteness are unnecessary. -/
theorem bilinear_representation_oneParameterCurve_of_infinitesimal
    (ρ : G →* (V →L[ℝ] V))
    (hρ : MDifferentiable I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g))
    (B : V →L[ℝ] V →L[ℝ] ℝ)
    (hB : ∀ (X : GroupLieAlgebra I G) (u v : V),
      B (representationDifferential ρ X u) v +
        B u (representationDifferential ρ X v) = 0)
    (X : GroupLieAlgebra I G) (t : ℝ) (u v : V) :
    B (ρ (oneParameterCurve X t) u) (ρ (oneParameterCurve X t) v) = B u v := by
  have hd (s : ℝ) (w : V) :=
    (hasDerivAt_representation_oneParameterCurve ρ hρ X s).clm_apply
      (hasDerivAt_const s w)
  have hb (s : ℝ) : HasDerivAt
      (fun r => B (ρ (oneParameterCurve X r) u) (ρ (oneParameterCurve X r) v)) 0 s := by
    apply (B.hasDerivAt_of_bilinear (fun _ => hd s u) (fun _ => hd s v)).congr_deriv
    simpa only [mul_apply_eq_comp, zero_apply, map_zero, zero_add, add_zero, add_comm]
      using hB X (ρ (oneParameterCurve X s) u) (ρ (oneParameterCurve X s) v)
  have heq := is_const_of_deriv_eq_zero (fun s => (hb s).differentiableAt)
    (fun s => (hb s).deriv) t 0
  simpa only [oneParameterCurve_zero, map_one, one_apply_eq_self] using heq

/-- The subgroup preserving a prescribed continuous bilinear form. -/
def bilinearPreservingSubgroup (ρ : G →* (V →L[ℝ] V))
    (B : V →L[ℝ] V →L[ℝ] ℝ) : Subgroup G where
  carrier := {g | ∀ u v : V, B (ρ g u) (ρ g v) = B u v}
  one_mem' := by simp
  mul_mem' {g h} hg hh := by
    intro u v
    simpa only [map_mul, mul_apply_eq_comp] using
      (hg (ρ h u) (ρ h v)).trans (hh u v)
  inv_mem' {g} hg := by
    intro u v
    have h := hg (ρ g⁻¹ u) (ρ g⁻¹ v)
    rw [← mul_apply_eq_comp, ← mul_apply_eq_comp,
      ← map_mul, mul_inv_cancel, map_one] at h
    exact h.symm

/-- Infinitesimal invariance of a continuous bilinear form implies invariance
under every element of a connected Lie group. -/
theorem bilinear_representation_of_infinitesimal [ConnectedSpace G]
    (ρ : G →* (V →L[ℝ] V))
    (hρ : MDifferentiable I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g))
    (B : V →L[ℝ] V →L[ℝ] ℝ)
    (hB : ∀ (X : GroupLieAlgebra I G) (u v : V),
      B (representationDifferential ρ X u) v +
        B u (representationDifferential ρ X v) = 0)
    (g : G) (u v : V) : B (ρ g u) (ρ g v) = B u v := by
  have htop : bilinearPreservingSubgroup ρ B = ⊤ := by
    apply subgroup_eq_top_of_oneParameterCurve_mem (I := I)
    intro X t
    exact bilinear_representation_oneParameterCurve_of_infinitesimal ρ hρ B hB X t
  exact (show g ∈ bilinearPreservingSubgroup ρ B by rw [htop]; trivial) u v

end Bilinear

section InnerProduct

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- Infinitesimal skew-adjointness forces preservation along every one-parameter
subgroup. -/
theorem inner_representation_oneParameterCurve_of_skew
    (ρ : G →* (V →L[ℝ] V))
    (hρ : MDifferentiable I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g))
    (hskew : ∀ (X : GroupLieAlgebra I G) (u v : V),
      ⟪representationDifferential ρ X u, v⟫_ℝ +
        ⟪u, representationDifferential ρ X v⟫_ℝ = 0)
    (X : GroupLieAlgebra I G) (t : ℝ) (u v : V) :
    ⟪ρ (oneParameterCurve X t) u, ρ (oneParameterCurve X t) v⟫_ℝ = ⟪u, v⟫_ℝ := by
  exact bilinear_representation_oneParameterCurve_of_infinitesimal
    ρ hρ (innerSL ℝ) hskew X t u v

/-- The subgroup of a representation that preserves the given real inner product. -/
def innerPreservingSubgroup (ρ : G →* (V →L[ℝ] V)) : Subgroup G where
  carrier := {g | ∀ u v : V, ⟪ρ g u, ρ g v⟫_ℝ = ⟪u, v⟫_ℝ}
  one_mem' := by simp
  mul_mem' {g h} hg hh := by
    intro u v
    simpa only [map_mul, mul_apply_eq_comp] using
      (hg (ρ h u) (ρ h v)).trans (hh u v)
  inv_mem' {g} hg := by
    intro u v
    have h := hg (ρ g⁻¹ u) (ρ g⁻¹ v)
    rw [← mul_apply_eq_comp, ← mul_apply_eq_comp,
      ← map_mul, mul_inv_cancel, map_one] at h
    exact h.symm

/-- A differentiable linear representation of a connected Lie group preserves a
real inner product whenever its infinitesimal action is skew-adjoint. -/
theorem inner_representation_of_skew [ConnectedSpace G]
    (ρ : G →* (V →L[ℝ] V))
    (hρ : MDifferentiable I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g))
    (hskew : ∀ (X : GroupLieAlgebra I G) (u v : V),
      ⟪representationDifferential ρ X u, v⟫_ℝ +
        ⟪u, representationDifferential ρ X v⟫_ℝ = 0)
    (g : G) (u v : V) : ⟪ρ g u, ρ g v⟫_ℝ = ⟪u, v⟫_ℝ := by
  exact bilinear_representation_of_infinitesimal ρ hρ (innerSL ℝ) hskew g u v

/-- The isometric linear equivalence supplied by infinitesimal skew-adjointness.
Its inverse is the original representation evaluated at the inverse group element. -/
def representationLinearIsometryEquivOfSkew [ConnectedSpace G]
    (ρ : G →* (V →L[ℝ] V))
    (hρ : MDifferentiable I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g))
    (hskew : ∀ (X : GroupLieAlgebra I G) (u v : V),
      ⟪representationDifferential ρ X u, v⟫_ℝ +
        ⟪u, representationDifferential ρ X v⟫_ℝ = 0)
    (g : G) : V ≃ₗᵢ[ℝ] V := by
  let e : V ≃ₗ[ℝ] V := {
    (ρ g).toLinearMap with
    invFun := ρ g⁻¹
    left_inv u := by
      change (ρ g⁻¹ * ρ g) u = u
      rw [← map_mul, inv_mul_cancel, map_one, one_apply_eq_self]
    right_inv u := by
      change (ρ g * ρ g⁻¹) u = u
      rw [← map_mul, mul_inv_cancel, map_one, one_apply_eq_self]
  }
  exact e.isometryOfInner (inner_representation_of_skew ρ hρ hskew g)

@[simp]
theorem representationLinearIsometryEquivOfSkew_apply [ConnectedSpace G]
    (ρ : G →* (V →L[ℝ] V))
    (hρ : MDifferentiable I 𝓘(ℝ, V →L[ℝ] V) (fun g => ρ g))
    (hskew : ∀ (X : GroupLieAlgebra I G) (u v : V),
      ⟪representationDifferential ρ X u, v⟫_ℝ +
        ⟪u, representationDifferential ρ X v⟫_ℝ = 0)
    (g : G) (u : V) : representationLinearIsometryEquivOfSkew ρ hρ hskew g u = ρ g u := rfl

end InnerProduct


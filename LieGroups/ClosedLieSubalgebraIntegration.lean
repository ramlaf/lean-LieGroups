import LieGroups.LieSubalgebraIntegration
import LieGroups.EmbeddedSubgroupTangent
import Mathlib.Topology.Algebra.Group.OpenMapping
import Mathlib.Topology.Baire.LocallyCompactRegular

/-!
# Closed connected integrations of Lie subalgebras

A connected finite-dimensional Lie group is sigma-compact, because finite
products of its exponentials cover it. The topological open mapping theorem
then shows that an injective immersion with closed image is an embedding.
Consequently, closedness of the canonical exponential-generated subgroup is
enough to identify its ambient curve tangents with the original Lie subalgebra.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-27.
-/

noncomputable section
open scoped Topology ContDiff Manifold
set_option backward.isDefEq.respectTransparency false

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {G : Type*} [Group G] [TopologicalSpace G]
  [ChartedSpace H G] [LieGroup I ∞ G] [BoundarylessManifold I G] [T2Space G]

private def expWord (v : List E) : G :=
  (v.map fun x => lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm x)).prod

private theorem expWord_append (v w : List E) :
    expWord (I := I) (G := G) (v ++ w) =
      expWord (I := I) (G := G) v * expWord (I := I) (G := G) w := by
  simp [expWord, List.map_append, List.prod_append]

private theorem expWord_neg_reverse (v : List E) :
    expWord (I := I) (G := G) (v.reverse.map fun x => -x) =
      (expWord (I := I) (G := G) v)⁻¹ := by
  simp only [expWord, List.map_map, List.map_reverse, Function.comp_def, map_neg,
    lieExp_neg, List.prod_inv_reverse]

private theorem continuous_expWord_ofFn (n : ℕ) :
    Continuous (fun v : Fin n → E => expWord (I := I) (G := G) (List.ofFn v)) := by
  let : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  induction n with
  | zero => simpa [expWord] using (continuous_const : Continuous (fun _ : Fin 0 → E => (1 : G)))
  | succ n ih =>
    have hExp : Continuous (fun v : Fin (n + 1) → E =>
        lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (v 0))) :=
      (lieExp_contMDiff_model (I := I) (G := G)).continuous.comp (continuous_apply 0)
    have hTail : Continuous (fun v : Fin (n + 1) → E =>
        expWord (I := I) (G := G) (List.ofFn fun i => v i.succ)) :=
      ih.comp (continuous_pi fun i => continuous_apply i.succ)
    simp only [List.ofFn_succ, expWord, List.map_cons, List.prod_cons]
    exact continuous_mul.comp (hExp.prodMk hTail)

include I in
/-- A connected finite-dimensional real Lie group is sigma-compact. No global
countability hypothesis on its atlas is needed. -/
theorem sigmaCompactSpace_of_connected_lieGroup [ConnectedSpace G] : SigmaCompactSpace G := by
  let W : (Σ n : ℕ, Fin n → E) → G := fun v =>
    expWord (I := I) (G := G) (List.ofFn v.2)
  have hW : Continuous W := continuous_sigma (continuous_expWord_ofFn (I := I) (G := G))
  have hList (x : G) : ∃ v : List E, expWord (I := I) (G := G) v = x := by
    have hx : x ∈ Subgroup.closure (Set.range (lieExp (I := I) (G := G))) := by
      rw [closure_range_lieExp_eq_top]
      exact Subgroup.mem_top x
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨v, rfl⟩ := hx
      exact ⟨[lieAlgebraModelEquiv (I := I) (G := G) v], by simp [expWord]⟩
    | one => exact ⟨[], rfl⟩
    | mul x y _ _ hx hy =>
      obtain ⟨v, rfl⟩ := hx
      obtain ⟨w, rfl⟩ := hy
      exact ⟨v ++ w, expWord_append v w⟩
    | inv x _ hx =>
      obtain ⟨v, rfl⟩ := hx
      exact ⟨v.reverse.map fun x => -x, expWord_neg_reverse v⟩
  have hsurj : Function.Surjective W := by
    intro x
    obtain ⟨v, hv⟩ := hList x
    refine ⟨⟨v.length, v.get⟩, ?_⟩
    simpa only [W, List.ofFn_get] using hv
  refine ⟨?_⟩
  simpa only [Set.image_univ, hsurj.range_eq] using
    IsSigmaCompact.image hW (isSigmaCompact_univ (X := Σ n : ℕ, Fin n → E))

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  [FiniteDimensional ℝ F] {H' : Type*} [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'} {K : Type*} [Group K] [TopologicalSpace K]
  [ChartedSpace H' K] [LieGroup J ∞ K] [BoundarylessManifold J K]
  [T2Space K] [ConnectedSpace K]

omit [BoundarylessManifold I G] in
/-- An injective immersion from a connected finite-dimensional Lie group with
closed image induces the ambient subspace topology. -/
theorem ImmersedLieSubgroup.isEmbedding_of_isClosed
    (S : ImmersedLieSubgroup I G J K) (hS : IsClosed (S.subgroup : Set G)) :
    Topology.IsEmbedding (fun x => S.toMonoidHom x) := by
  let : IsTopologicalGroup K := topologicalGroup_of_lieGroup J ∞
  let : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  let : SigmaCompactSpace K := sigmaCompactSpace_of_connected_lieGroup (I := J)
  let : LocallyCompactSpace H := I.locallyCompactSpace
  let : LocallyCompactSpace G := ChartedSpace.locallyCompactSpace H G
  let : LocallyCompactSpace S.subgroup := hS.locallyCompactSpace
  let f : K →* S.subgroup := S.toMonoidHom.rangeRestrict
  have hf : Continuous f := S.contMDiff.continuous.subtype_mk _
  have hsurj : Function.Surjective f := by
    rintro ⟨x, y, rfl⟩
    exact ⟨y, rfl⟩
  let e : K ≃ S.subgroup := Equiv.ofBijective f
    ⟨fun _ _ h => S.injective (congrArg Subtype.val h), hsurj⟩
  have he : Topology.IsEmbedding (fun x => f x) :=
    (e.toHomeomorphOfContinuousOpen hf (f.isOpenMap_of_sigmaCompact hsurj hf)).isEmbedding
  exact Topology.IsEmbedding.subtypeVal.comp he

variable [I.Boundaryless]

/-- Closedness of the canonical exponential-generated subgroup identifies all
of its ambient differentiable curve velocities with the prescribed subalgebra. -/
theorem subgroupTangentSet_lieSubalgebraSubgroup_of_isClosed
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (hS : IsClosed (lieSubalgebraSubgroup S : Set G)) :
    subgroupTangentSet (I := I) (lieSubalgebraSubgroup S) =
      (S : Set (GroupLieAlgebra I G)) := by
  obtain ⟨A⟩ := nonempty_lieSubalgebraIntegration S
  have hA := A.subgroup_eq_lieSubalgebraSubgroup
  let T : EmbeddedLieSubgroup I G
      𝓘(ℝ, lieSubalgebraModelSubmodule S) A.Carrier := {
    toImmersedLieSubgroup := A.presentation
    isEmbedding := A.presentation.isEmbedding_of_isClosed (hA ▸ hS)
  }
  simpa only [← hA, T, A.lieAlgebra_eq] using T.subgroupTangentSet_eq_lieAlgebra

end LieGroups

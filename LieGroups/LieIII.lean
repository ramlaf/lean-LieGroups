import LieGroups.Algebra.Ado
import LieGroups.RepresentationIntegration

/-!
# Lie's third theorem

Ado's theorem constructs a faithful finite-dimensional representation from the
Lie algebra alone. Integrating its image, taking a smooth universal cover, and
changing the model gives an actual Hausdorff simply connected integrating group.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

universe uL

variable (L : Type uL) [LieRing L] [LieAlgebra ℝ L] [FiniteDimensional ℝ L]

/-- Every finite-dimensional real Lie algebra has a Hausdorff simply connected
Lie group with the specified Lie-algebra identification. -/
theorem nonempty_lieAlgebraIntegration : Nonempty (LieAlgebraIntegration.{uL, 0} L) :=
  nonempty_lieAlgebraIntegration_of_faithful_representation
    (adoRepresentation ℝ L) (adoRepresentation_injective ℝ L)

/-- A chosen actual integration supplied by Lie's third theorem. -/
def lieAlgebraIntegration : LieAlgebraIntegration.{uL, 0} L :=
  (nonempty_lieAlgebraIntegration L).some

end LieGroups

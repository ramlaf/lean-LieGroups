import LieGroups.InvariantFieldCoordinates
import LieGroups.InvariantDistribution
import Mathlib.Analysis.Calculus.ContDiff.FiniteDimension

/-!
# Continuous-linear invariant frames in an ambient chart

A subspace of the Lie-algebra model gives a family of injective linear frame maps
on each chart target. The family is smooth as a map into continuous linear maps.
For the model image of a Lie subalgebra, its range is exactly the coordinate
image of the corresponding invariant distribution.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Set
open scoped ContDiff Manifold Topology

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

/-- The chart coordinate map on tangent vectors at the inverse-chart point. -/
noncomputable def tangentCoordinatesInChart (g₀ : G) (x : E) :
    TangentSpace I ((extChartAt I g₀).symm x) →L[ℝ] E :=
  (trivializationAt E (TangentSpace I) g₀).continuousLinearMapAt ℝ _

/-- The continuous-linear map taking model-subspace vectors to invariant-field
values in the chart at `g₀`. -/
noncomputable def invariantFrameInChart (P : Submodule ℝ E) (g₀ : G) (x : E) : P →L[ℝ] E :=
  (tangentCoordinatesInChart (I := I) g₀ x).comp
    ((leftTranslationTangentEquiv (I := I) ((extChartAt I g₀).symm x)).toContinuousLinearMap.comp
      ((lieAlgebraModelEquiv (I := I) (G := G)).symm.toContinuousLinearMap.comp P.subtypeL))

omit [FiniteDimensional ℝ E] in
private theorem inverseChart_mem_trivialization_baseSet (g₀ : G) {x : E}
    (hx : x ∈ (extChartAt I g₀).target) :
    (extChartAt I g₀).symm x ∈ (trivializationAt E (TangentSpace I) g₀).baseSet := by
  change (extChartAt I g₀).symm x ∈ (chartAt H g₀).source
  rw [← extChartAt_source I]
  exact (extChartAt I g₀).map_target hx

omit [FiniteDimensional ℝ E] in
/-- On the chart target, the bundled frame evaluates to the previously constructed
jointly smooth coordinate vector field. -/
theorem invariantFrameInChart_apply (P : Submodule ℝ E) (g₀ : G) {x : E}
    (hx : x ∈ (extChartAt I g₀).target) (v : P) :
    invariantFrameInChart (I := I) P g₀ x v =
      mulInvariantVectorFieldInChart (I := I) g₀ ((v : E), x) := by
  change (trivializationAt E (TangentSpace I) g₀).continuousLinearMapAt ℝ _
    (mulInvariantVectorField ((lieAlgebraModelEquiv (I := I) (G := G)).symm (v : E))
      ((extChartAt I g₀).symm x)) = _
  rw [Bundle.Trivialization.continuousLinearMapAt_apply_of_mem ℝ _
    (inverseChart_mem_trivialization_baseSet g₀ hx)]
  rfl

/-- Smooth dependence of the entire frame map, including its continuous-linear-map topology. -/
theorem contDiffOn_invariantFrameInChart (P : Submodule ℝ E) (g₀ : G) :
    ContDiffOn ℝ ∞ (invariantFrameInChart (I := I) P g₀) (extChartAt I g₀).target := by
  apply contDiffOn_clm_apply.mpr
  intro v
  have hp : ContDiff ℝ ∞ (fun x : E => ((v : E), x)) :=
    contDiff_const.prodMk contDiff_id
  have h := (contDiffOn_mulInvariantVectorFieldInChart (I := I) g₀).comp
    hp.contDiffOn
    (fun x (hx : x ∈ (extChartAt I g₀).target) => ⟨Set.mem_univ _, hx⟩)
  exact h.congr (fun x hx => invariantFrameInChart_apply P g₀ hx v)

omit [FiniteDimensional ℝ E] in
/-- The coordinate frame has no kernel anywhere in its chart target. -/
theorem invariantFrameInChart_injective (P : Submodule ℝ E) (g₀ : G) {x : E}
    (hx : x ∈ (extChartAt I g₀).target) :
    Function.Injective (invariantFrameInChart (I := I) P g₀ x) := by
  have hc : Function.Injective (tangentCoordinatesInChart (I := I) g₀ x) := by
    unfold tangentCoordinatesInChart
    rw [← Bundle.Trivialization.coe_continuousLinearEquivAt_eq' _
      (inverseChart_mem_trivialization_baseSet g₀ hx)]
    exact ContinuousLinearEquiv.injective _
  exact hc.comp ((leftTranslationTangentEquiv (I := I) ((extChartAt I g₀).symm x)).injective.comp
    ((lieAlgebraModelEquiv (I := I) (G := G)).symm.injective.comp Subtype.val_injective))

/-- The Lie subalgebra expressed as a normed subspace of the identity model. -/
noncomputable def lieSubalgebraModelSubmodule (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    Submodule ℝ E := S.toSubmodule.map (lieAlgebraModelEquiv (I := I) (G := G)).toLinearMap

/-- The range of the chart frame is precisely the chart image of the invariant distribution. -/
theorem range_invariantFrameInChart (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (g₀ : G) (x : E) :
    LinearMap.range (invariantFrameInChart (I := I)
      (lieSubalgebraModelSubmodule S) g₀ x).toLinearMap =
      (invariantDistribution S ((extChartAt I g₀).symm x)).map
        (tangentCoordinatesInChart (I := I) g₀ x).toLinearMap := by
  ext w
  constructor
  · rintro ⟨p, rfl⟩
    obtain ⟨v, hv, hp⟩ := p.property
    change lieAlgebraModelEquiv (I := I) (G := G) v = (p : E) at hp
    refine ⟨mulInvariantVectorField v ((extChartAt I g₀).symm x),
      mulInvariantVectorField_mem_invariantDistribution S hv _, ?_⟩
    change tangentCoordinatesInChart g₀ x (mulInvariantVectorField v _) =
      tangentCoordinatesInChart g₀ x
        (mulInvariantVectorField ((lieAlgebraModelEquiv (I := I) (G := G)).symm (p : E)) _)
    rw [← hp, ContinuousLinearEquiv.symm_apply_apply]
  · rintro ⟨z, hz, hzw⟩
    obtain ⟨v, hv, rfl⟩ := (mem_invariantDistribution_iff S _ z).mp hz
    let p : lieSubalgebraModelSubmodule S :=
      ⟨lieAlgebraModelEquiv v, ⟨v, hv, rfl⟩⟩
    refine ⟨p, ?_⟩
    change tangentCoordinatesInChart g₀ x
      (mulInvariantVectorField ((lieAlgebraModelEquiv (I := I) (G := G)).symm
        (lieAlgebraModelEquiv v)) _) = w
    rw [ContinuousLinearEquiv.symm_apply_apply]
    exact hzw

end LieGroups

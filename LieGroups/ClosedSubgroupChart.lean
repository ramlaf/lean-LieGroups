import LieGroups.ExponentialLocalChart

/-!
# A local smooth slice for a subgroup

This local structure is constructed from ordinary closed-subgroup data in
`ClosedSubgroupSlice`. It records a genuine ambient chart in which subgroup
membership is exactly the vanishing of the transverse coordinate.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open scoped ContDiff Manifold

namespace LieGroups

variable {E P Q : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G]

/-- An ambient smooth chart straightening a subgroup near the identity. -/
structure ClosedSubgroupChart (K : Subgroup G) (P Q : Type*)
    [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q] where
  chart : PartialDiffeomorph I 𝓘(ℝ, P × Q) G (P × Q) ∞
  one_mem_source : (1 : G) ∈ chart.source
  chart_one : chart 1 = 0
  mem_iff : ∀ g ∈ chart.source, g ∈ K ↔ (chart g).2 = 0

end LieGroups

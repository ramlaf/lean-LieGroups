import LieGroups.HomomorphismUniqueness

/-!
# Integration data for a prescribed Lie-algebra homomorphism

The differential compatibility is part of the output: the smooth homomorphism
must integrate the prescribed map. On a connected source these data are unique.
Existence for simply connected sources is proved in `LieII`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open scoped ContDiff Manifold

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]

/-- A smooth group homomorphism integrating a specified Lie-algebra homomorphism. -/
structure LieHomomorphismIntegration
    (φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J K) where
  toMonoidHom : G →* K
  contMDiff : ContMDiff I J ∞ (fun x => toMonoidHom x)
  homLieHom_eq : homLieHom toMonoidHom contMDiff = φ

namespace LieHomomorphismIntegration

variable {φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J K}

@[ext] theorem ext (f g : LieHomomorphismIntegration φ)
    (h : ∀ x, f.toMonoidHom x = g.toMonoidHom x) : f = g := by
  have he : f.toMonoidHom = g.toMonoidHom := MonoidHom.ext h
  cases f
  cases g
  cases he
  rfl

instance [BoundarylessManifold I G] [T2Space G] [ConnectedSpace G]
    [BoundarylessManifold J K] [T2Space K] : Subsingleton (LieHomomorphismIntegration φ) where
  allEq f g := by
    apply ext
    have he := hom_eq_of_homLieHom_eq f.toMonoidHom g.toMonoidHom f.contMDiff g.contMDiff
      (f.homLieHom_eq.trans g.homLieHom_eq.symm)
    exact fun x => congrArg (fun h : G →* K => h x) he

/-- The identity group homomorphism integrates the identity Lie-algebra map. -/
def refl : LieHomomorphismIntegration (LieHom.id : GroupLieAlgebra I G →ₗ⁅ℝ⁆ _) where
  toMonoidHom := MonoidHom.id G
  contMDiff := contMDiff_id
  homLieHom_eq := homLieHom_id

variable {D : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D] [FiniteDimensional ℝ D]
  {H'' : Type*} [TopologicalSpace H''] {L : ModelWithCorners ℝ D H''}
  {Q : Type*} [Group Q] [TopologicalSpace Q] [ChartedSpace H'' Q] [LieGroup L ∞ Q]
  {ψ : GroupLieAlgebra J K →ₗ⁅ℝ⁆ GroupLieAlgebra L Q}

/-- Composition integrates the composition of the prescribed Lie-algebra maps. -/
def comp (g : LieHomomorphismIntegration ψ) (f : LieHomomorphismIntegration φ) :
    LieHomomorphismIntegration (ψ.comp φ) where
  toMonoidHom := g.toMonoidHom.comp f.toMonoidHom
  contMDiff := g.contMDiff.comp f.contMDiff
  homLieHom_eq := by
    rw [homLieHom_comp (I := I) (J := J) (L := L)
      f.toMonoidHom g.toMonoidHom f.contMDiff g.contMDiff,
      f.homLieHom_eq, g.homLieHom_eq]

end LieHomomorphismIntegration

end LieGroups

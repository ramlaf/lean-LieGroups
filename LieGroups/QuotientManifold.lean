import LieGroups.Manifold.QuotientAtlas
import Mathlib.Geometry.Manifold.Algebra.LieGroup
import Mathlib.Geometry.Manifold.Algebra.SMul
import Mathlib.Topology.Algebra.Group.Quotient
import Mathlib.Topology.Algebra.ProperAction.Basic

/-!
# Homogeneous quotient manifolds from a transverse identity slice

Left translates of one actual transverse slice cover the quotient. Right subgroup
translations transport representatives smoothly. The general quotient-atlas construction
therefore supplies a manifold with its original quotient topology and local sections.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups

variable {E P : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {K : Subgroup G}

namespace Manifold.QuotientSlice

variable (S : QuotientSlice (I := I) (P := P) (QuotientGroup.mk : G → G ⧸ K))

/-- Left translating an identity slice gives a slice through any group element. -/
def leftTranslate (g : G) :
    QuotientSlice (I := I) (P := P) (QuotientGroup.mk : G → G ⧸ K) := by
  letI : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  exact {
  source := (fun x => g⁻¹ * x) ⁻¹' S.source
  target := S.target
  open_source := S.open_source.preimage (continuous_const.mul continuous_id)
  open_target := S.open_target
  coordinate x := S.coordinate (g⁻¹ * x)
  section_ p := g * S.section_ p
  coordinate_smooth := S.coordinate_smooth.comp
    (contMDiff_const.mul contMDiff_id).contMDiffOn (fun _ hx => hx)
  section_smooth := contMDiffOn_const.mul S.section_smooth
  coordinate_mem _ hx := S.coordinate_mem hx
  section_mem _ hp := by simpa only [mem_preimage, inv_mul_cancel_left] using S.section_mem hp
  coordinate_section p hp := by simpa only [inv_mul_cancel_left] using S.coordinate_section p hp
  section_coordinate x hx := by
    have h := congrArg (fun q : G ⧸ K => g • q) (S.section_coordinate _ hx)
    change QuotientGroup.mk (g * S.section_ (S.coordinate (g⁻¹ * x))) =
      QuotientGroup.mk (g * (g⁻¹ * x)) at h
    simpa only [mul_inv_cancel_left] using h
  coordinate_fiber x hx y hy hxy := by
    apply S.coordinate_fiber _ hx _ hy
    exact congrArg (fun q : G ⧸ K => g⁻¹ • q) hxy
  }

/-- A transverse identity slice constructs the full quotient atlas. -/
def quotientAtlas (h1 : (1 : G) ∈ S.source) :
    SmoothQuotientAtlas (I := I) (P := P) (QuotientGroup.mk : G → G ⧸ K) := by
  letI : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  exact {
  isOpenQuotientMap := QuotientGroup.isOpenQuotientMap_mk
  slice := S.leftTranslate
  mem_source x := by simpa only [leftTranslate, mem_preimage, inv_mul_cancel] using h1
  transport x y hxy := by
    refine ⟨fun z => z * (x⁻¹ * y), contMDiff_id.mul contMDiff_const, ?_, ?_⟩
    · exact mul_inv_cancel_left x y
    · intro z
      exact QuotientGroup.mk_mul_of_mem z (QuotientGroup.eq.mp hxy)
  }

/-- The homogeneous quotient equipped with the atlas constructed from a transverse slice. -/
abbrev QuotientSpace (h1 : (1 : G) ∈ S.source) := (S.quotientAtlas h1).Space

variable (h1 : (1 : G) ∈ S.source)

instance : MulAction G (S.QuotientSpace h1) := inferInstanceAs (MulAction G (G ⧸ K))

instance : MulAction.IsPretransitive G (S.QuotientSpace h1) :=
  inferInstanceAs (MulAction.IsPretransitive G (G ⧸ K))

instance [SecondCountableTopology G] : SecondCountableTopology (S.QuotientSpace h1) := by
  let : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  exact inferInstanceAs (SecondCountableTopology (G ⧸ K))

instance [IsClosed (K : Set G)] : T2Space (S.QuotientSpace h1) := by
  let : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  exact inferInstanceAs (T2Space (G ⧸ K))

/-- The left action on the constructed homogeneous quotient is smooth. -/
instance contMDiffSMul : ContMDiffSMul I 𝓘(ℝ, P) ∞ G (S.QuotientSpace h1) where
  contMDiff_smul := by
    intro p
    obtain ⟨s, hs, hsec⟩ := (S.quotientAtlas h1).hasContMDiffLocalSections p.2
    have hm : ContMDiffAt (I.prod 𝓘(ℝ, P)) I ∞
        (fun z : G × S.QuotientSpace h1 => z.1 * s z.2) p :=
      contMDiffAt_fst.mul (hs.comp p contMDiffAt_snd)
    have hc := (S.quotientAtlas h1).contMDiff_projection.contMDiffAt.comp p hm
    apply hc.congr_of_eventuallyEq
    have he : ∀ᶠ z : G × S.QuotientSpace h1 in 𝓝 p,
        (S.quotientAtlas h1).projection (s z.2) = z.2 :=
      continuous_snd.continuousAt hsec
    filter_upwards [he] with z hz
    change z.1 • z.2 = (S.quotientAtlas h1).projection (z.1 * s z.2)
    exact congrArg (fun q : S.QuotientSpace h1 => z.1 • q) hz.symm

end Manifold.QuotientSlice

end LieGroups

import LieGroups.LieSubalgebraIntegration
import LieGroups.UniversalCoverLieGroup
import LieGroups.Manifold.Rechart
import LieGroups.Analysis.FiniteDimensionalModel

/-!
# Simply connected integrations from injective Lie homomorphisms

An integration records an actual Hausdorff simply connected Lie group modeled on
the original Lie algebra, together with its tangent Lie-algebra identification.
An injective homomorphism into the Lie algebra of a finite-dimensional real Lie
group constructs such an integration: integrate its image as an immersed subgroup,
take the smooth universal cover, and change the vector-space model.

This does not assert the existence of a faithful representation of every Lie
algebra. That algebraic existence theorem is a separate prerequisite for general
Lie III.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open scoped ContDiff Manifold

namespace LieGroups

universe uL uG

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable (L : Type uL) [LieRing L] [LieAlgebra ℝ L] [FiniteDimensional ℝ L]

/-- A finite-dimensional Lie algebra receives a norm from coordinates in a finite
basis. Its additive operations are those of the original Lie ring. This is a
chosen structure, not a global instance. -/
abbrev lieAlgebraNormedAddCommGroup : NormedAddCommGroup L :=
  finiteDimensionalNormedAddCommGroup L

attribute [local instance] lieAlgebraNormedAddCommGroup

/-- The coordinate norm is compatible with the original Lie-algebra scalar action.
This is a chosen structure, not a global instance. -/
abbrev lieAlgebraNormedSpace : NormedSpace ℝ L :=
  finiteDimensionalNormedSpace L

attribute [local instance] lieAlgebraNormedSpace

/-- An actual simply connected Hausdorff Lie group integrating `L`, with model `L`.
The carrier and all its group and manifold structures are outputs. -/
structure LieAlgebraIntegration where
  Carrier : Type uG
  [group : Group Carrier]
  [topology : TopologicalSpace Carrier]
  [chartedSpace : ChartedSpace L Carrier]
  [lieGroup : LieGroup 𝓘(ℝ, L) ∞ Carrier]
  [t2Space : T2Space Carrier]
  [simplyConnectedSpace : SimplyConnectedSpace Carrier]
  /-- The identification is with the actual tangent Lie algebra at the identity. -/
  lieEquiv : GroupLieAlgebra 𝓘(ℝ, L) Carrier ≃ₗ⁅ℝ⁆ L

attribute [instance] LieAlgebraIntegration.group LieAlgebraIntegration.topology
  LieAlgebraIntegration.chartedSpace LieAlgebraIntegration.lieGroup
  LieAlgebraIntegration.t2Space LieAlgebraIntegration.simplyConnectedSpace

variable {L}

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type uG} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

set_option backward.isDefEq.respectTransparency false in
/-- An injective Lie homomorphism into a finite-dimensional Lie group's Lie algebra
constructs a simply connected integrating group; no integrating manifold for `L`
is supplied as an input. -/
theorem nonempty_lieAlgebraIntegration_of_injective_lieHom [I.Boundaryless] [T2Space G]
    (ρ : L →ₗ⁅ℝ⁆ GroupLieAlgebra I G) (hρ : Function.Injective ρ) :
    Nonempty (LieAlgebraIntegration.{uL, uG} L) := by
  obtain ⟨A⟩ := nonempty_lieSubalgebraIntegration ρ.range
  let P := lieSubalgebraModelSubmodule ρ.range
  obtain ⟨C⟩ := nonempty_universalCoverLieGroup (I := 𝓘(ℝ, P)) (G := A.Carrier)
  let α : GroupLieAlgebra 𝓘(ℝ, P) C.Space ≃ₗ⁅ℝ⁆ L :=
    C.differentialLieEquiv.trans (A.presentation.lieAlgebraEquiv.trans
      ((LieEquiv.ofEq A.presentation.lieAlgebra ρ.range
        (by rw [A.lieAlgebra_eq])).trans (ρ.equivRangeOfInjective hρ).symm))
  let e : P ≃L[ℝ] L :=
    ((lieAlgebraModelEquiv (I := 𝓘(ℝ, P)) (G := C.Space)).symm.toLinearEquiv.trans
      α.toLinearEquiv).toContinuousLinearEquiv
  exact ⟨{
    Carrier := Manifold.Recharted e C.Space
    group := inferInstance
    topology := inferInstance
    chartedSpace := inferInstance
    lieGroup := inferInstance
    t2Space := inferInstance
    simplyConnectedSpace := inferInstance
    lieEquiv := (Manifold.Recharted.lieEquiv e C.Space).trans α
  }⟩

end LieGroups

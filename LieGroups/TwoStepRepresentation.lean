import Mathlib.Algebra.Lie.Nilpotent
import Mathlib.Data.Real.Basic
import Mathlib.Tactic.Module

/-!
# Faithful representations of two-step nilpotent Lie algebras

When all triple brackets vanish, the map
`x ↦ ((t, y) ↦ (0, t • x + (1 / 2) • ⁅x, y⁆))`
is a faithful representation on `ℝ × L`. This construction requires neither
an integrating group nor the general finite-dimensional representation theorem.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

namespace LieGroups

noncomputable section

variable {L : Type*} [LieRing L] [LieAlgebra ℝ L]

attribute [local instance] LieRing.ofAssociativeRing

/-- The affine endomorphism used in the faithful two-step representation. -/
def twoStepEndomorphism (x : L) : Module.End ℝ (ℝ × L) where
  toFun p := (0, p.1 • x + (1 / 2 : ℝ) • ⁅x, p.2⁆)
  map_add' p q := by
    ext <;> simp [add_smul, lie_add, smul_add]
    abel
  map_smul' t p := by
    apply Prod.ext
    · simp
    change (t * p.1) • x + (1 / 2 : ℝ) • ⁅x, t • p.2⁆ =
      t • (p.1 • x + (1 / 2 : ℝ) • ⁅x, p.2⁆)
    rw [lie_smul]
    module

@[simp]
theorem twoStepEndomorphism_apply (x : L) (p : ℝ × L) :
    twoStepEndomorphism x p = (0, p.1 • x + (1 / 2 : ℝ) • ⁅x, p.2⁆) := rfl

/-- Every real Lie algebra with vanishing triple brackets has an explicit
representation on `ℝ × L`. -/
def twoStepRepresentation (h₂ : ∀ x y z : L, ⁅x, ⁅y, z⁆⁆ = 0) :
    L →ₗ⁅ℝ⁆ Module.End ℝ (ℝ × L) where
  toFun := twoStepEndomorphism
  map_add' x y := by
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · simp
    change p.1 • (x + y) + (1 / 2 : ℝ) • ⁅x + y, p.2⁆ =
      (p.1 • x + (1 / 2 : ℝ) • ⁅x, p.2⁆) +
        (p.1 • y + (1 / 2 : ℝ) • ⁅y, p.2⁆)
    rw [smul_add, add_lie, smul_add]
    abel
  map_smul' t x := by
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · simp
    change p.1 • (t • x) + (1 / 2 : ℝ) • ⁅t • x, p.2⁆ =
      t • (p.1 • x + (1 / 2 : ℝ) • ⁅x, p.2⁆)
    rw [smul_lie]
    module
  map_lie' {x y} := by
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · simp [LieRing.of_associative_ring_bracket, Module.End.mul_apply]
    · have hcentral : ⁅⁅x, y⁆, p.2⁆ = 0 := by
        rw [← lie_skew, h₂, neg_zero]
      change p.1 • ⁅x, y⁆ + (1 / 2 : ℝ) • ⁅⁅x, y⁆, p.2⁆ =
        ((0 : ℝ) • x + (1 / 2 : ℝ) •
          ⁅x, p.1 • y + (1 / 2 : ℝ) • ⁅y, p.2⁆⁆) -
        ((0 : ℝ) • y + (1 / 2 : ℝ) •
          ⁅y, p.1 • x + (1 / 2 : ℝ) • ⁅x, p.2⁆⁆)
      simp only [zero_smul, zero_add, lie_add, lie_smul, h₂, hcentral,
        smul_zero, add_zero]
      rw [← lie_skew x y]
      module

@[simp]
theorem twoStepRepresentation_apply
    (h₂ : ∀ x y z : L, ⁅x, ⁅y, z⁆⁆ = 0) (x : L) (p : ℝ × L) :
    twoStepRepresentation h₂ x p = (0, p.1 • x + (1 / 2 : ℝ) • ⁅x, p.2⁆) := rfl

/-- Evaluation at `(1, 0)` recovers the represented Lie-algebra element. -/
@[simp]
theorem twoStepRepresentation_apply_one_zero
    (h₂ : ∀ x y z : L, ⁅x, ⁅y, z⁆⁆ = 0) (x : L) :
    (twoStepRepresentation h₂ x (1, 0)).2 = x := by
  simp

/-- The explicit two-step representation is faithful. -/
theorem twoStepRepresentation_injective
    (h₂ : ∀ x y z : L, ⁅x, ⁅y, z⁆⁆ = 0) :
    Function.Injective (twoStepRepresentation h₂) := by
  intro x y hxy
  simpa using congrArg (fun f : Module.End ℝ (ℝ × L) => (f (1, 0)).2) hxy

/-- The ordinary lower-central-series bound for a two-step nilpotent Lie
algebra implies the triple-bracket identity used by the explicit representation. -/
theorem tripleLie_eq_zero_of_lowerCentralSeries_two_eq_bot
    (h₂ : LieModule.lowerCentralSeries ℝ L L 2 = ⊥) (x y z : L) :
    ⁅x, ⁅y, z⁆⁆ = 0 := by
  have hyz : ⁅y, z⁆ ∈ LieModule.lowerCentralSeries ℝ L L 1 := by
    rw [show 1 = 0 + 1 from rfl, LieModule.lowerCentralSeries_succ]
    exact LieSubmodule.lie_mem_lie (LieSubmodule.mem_top y)
      (by simp only [LieModule.lowerCentralSeries_zero, LieSubmodule.mem_top])
  have hxyz : ⁅x, ⁅y, z⁆⁆ ∈ LieModule.lowerCentralSeries ℝ L L 2 := by
    rw [show 2 = 1 + 1 from rfl, LieModule.lowerCentralSeries_succ]
    exact LieSubmodule.lie_mem_lie (LieSubmodule.mem_top x) hyz
  simpa only [h₂, LieSubmodule.mem_bot] using hxyz

end

end LieGroups

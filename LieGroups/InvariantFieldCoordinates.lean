import LieGroups.OneParameterSubgroup
import LieGroups.Analysis.LocalSmoothExtension

/-!
# The parameterized invariant field in local coordinates

The velocity parameter is expressed using `lieAlgebraModelEquiv`; the state variable
is expressed in an extended chart. This gives a jointly smooth Euclidean ODE on the
chart target, without requiring a globally defined extension of the coordinate field.

AI-assistance disclosure: generated by OpenAI Codex on 2026-09-29.
-/

open Function Set
open scoped Topology ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

/-- The left-invariant field in the chart at `g₀`, with inputs `(velocity, state)`.
Only its values on the chart target represent the original vector field. -/
noncomputable def mulInvariantVectorFieldInChart (g₀ : G) (p : E × E) : E :=
  (trivializationAt E (TangentSpace I) g₀
    ⟨(extChartAt I g₀).symm p.2,
      mulInvariantVectorField ((lieAlgebraModelEquiv (I := I) (G := G)).symm p.1)
        ((extChartAt I g₀).symm p.2)⟩).2

set_option backward.isDefEq.respectTransparency false in
/-- On the chart source, the coordinate field is exactly the coordinate velocity. -/
theorem mulInvariantVectorFieldInChart_apply (g₀ g : G) (v : E)
    (hg : g ∈ (extChartAt I g₀).source) :
    mulInvariantVectorFieldInChart (I := I) g₀ (v, extChartAt I g₀ g) =
      tangentCoordChange I g g₀ g
        (mulInvariantVectorField ((lieAlgebraModelEquiv (I := I) (G := G)).symm v) g) := by
  unfold mulInvariantVectorFieldInChart
  rw [(extChartAt I g₀).left_inv hg]
  rfl

/-- An invariant-field integral curve satisfies the parameterized coordinate ODE
whenever it remains in the chosen chart. -/
theorem hasDerivWithinAt_invariantFieldInChart {γ : ℝ → G} {v : E} {s : Set ℝ}
    (hγ : IsMIntegralCurveOn γ
      (mulInvariantVectorField ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)) s)
    {t₀ t : ℝ} (ht : t ∈ s) (hsrc : γ t ∈ (extChartAt I (γ t₀)).source) :
    HasDerivWithinAt (extChartAt I (γ t₀) ∘ γ)
      (mulInvariantVectorFieldInChart (I := I) (γ t₀)
        (v, extChartAt I (γ t₀) (γ t))) s t := by
  rw [mulInvariantVectorFieldInChart_apply _ _ _ hsrc]
  exact hγ.hasDerivWithinAt ht hsrc

set_option backward.isDefEq.respectTransparency false in
/-- A solution of the coordinate ODE lifts to a solution of the invariant equation.
The state is required to lie in the interior of the chart target. -/
theorem hasMFDerivAt_of_invariantFieldInChart {α : ℝ → E} (g₀ : G) (v : E) {t : ℝ}
    (ht : α t ∈ interior (extChartAt I g₀).target)
    (hα : HasDerivAt α (mulInvariantVectorFieldInChart (I := I) g₀ (v, α t)) t) :
    HasMFDerivAt 𝓘(ℝ, ℝ) I (fun u => (extChartAt I g₀).symm (α u)) t
      ((1 : ℝ →L[ℝ] ℝ).smulRight
        (mulInvariantVectorField ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)
          ((extChartAt I g₀).symm (α t)))) := by
  let x : G := (extChartAt I g₀).symm (α t)
  let V := mulInvariantVectorField ((lieAlgebraModelEquiv (I := I) (G := G)).symm v)
  have htar := interior_subset ht
  have hx : x ∈ (extChartAt I g₀).source := (extChartAt I g₀).map_target htar
  have hx' := mem_extChartAt_source (I := I) x
  have hd : HasDerivAt α (tangentCoordChange I x g₀ x (V x)) t := hα
  refine ⟨(continuousAt_extChartAt_symm'' htar).comp hα.continuousAt, ?_⟩
  apply HasDerivWithinAt.hasFDerivWithinAt
  simp only [mfld_simps, hasDerivWithinAt_univ]
  change HasDerivAt ((extChartAt I x ∘ (extChartAt I g₀).symm) ∘ α) (V x) t
  rw [← tangentCoordChange_self (I := I) (x := x) (z := x) (v := V x) hx',
    ← tangentCoordChange_comp (x := g₀) ⟨⟨hx', hx⟩, hx'⟩]
  apply HasFDerivAt.comp_hasDerivAt _ _ hd
  apply HasFDerivWithinAt.hasFDerivAt (s := range I) _
    (Filter.mem_of_superset (isOpen_interior.mem_nhds ht)
      (interior_subset.trans (extChartAt_target_subset_range ..)))
  rw [← (extChartAt I g₀).right_inv htar]
  exact hasFDerivWithinAt_tangentCoordChange ⟨hx, hx'⟩

set_option backward.isDefEq.respectTransparency false in
/-- The coordinate field is jointly smooth in velocity and state on the chart target. -/
theorem contDiffOn_mulInvariantVectorFieldInChart (g₀ : G) :
    ContDiffOn ℝ ∞ (mulInvariantVectorFieldInChart (I := I) g₀)
      (univ ×ˢ (extChartAt I g₀).target) := by
  have hi : ContMDiffOn (𝓘(ℝ, E).prod 𝓘(ℝ, E)) (I.prod 𝓘(ℝ, E)) ∞
      (fun p : E × E => ((extChartAt I g₀).symm p.2, p.1))
      (univ ×ˢ (extChartAt I g₀).target) := by
    apply ContMDiffOn.prodMk _ contMDiffOn_fst
    exact (contMDiffOn_extChartAt_symm (I := I) g₀).comp contMDiffOn_snd
      (fun _ hp => hp.2)
  have hs := (contMDiff_mulInvariantVectorField_joint (I := I) (G := G)).comp_contMDiffOn hi
  have hc := contMDiff_snd.comp_contMDiffOn
    ((trivializationAt E (TangentSpace I) g₀).contMDiffOn (IB := I) (n := ∞))
  have h := hc.comp hs (fun p hp => by
    change (extChartAt I g₀).symm p.2 ∈ (chartAt H g₀).source
    rw [← extChartAt_source I]
    exact (extChartAt I g₀).map_target hp.2)
  rw [← modelWithCornersSelf_prod, chartedSpaceSelf_prod] at h
  exact h.contDiffOn

/-- In finite dimensions, the coordinate field agrees near any initial data with a
globally smooth field, as required by global-field versions of smooth ODE dependence. -/
theorem exists_contDiff_mulInvariantVectorFieldInChart
    [FiniteDimensional ℝ E] [BoundarylessManifold I G] (g₀ : G) (v₀ : E) :
    ∃ F : E × E → E, ContDiff ℝ ∞ F ∧
      F =ᶠ[𝓝 (v₀, extChartAt I g₀ g₀)] mulInvariantVectorFieldInChart (I := I) g₀ := by
  apply Analysis.exists_contDiff_eventuallyEq
    (isOpen_univ.prod isOpen_interior)
    (s := univ ×ˢ interior (extChartAt I g₀).target)
  · exact ⟨mem_univ _, I.isInteriorPoint_iff.mp BoundarylessManifold.isInteriorPoint⟩
  · exact (contDiffOn_mulInvariantVectorFieldInChart g₀).mono
      (prod_mono Subset.rfl interior_subset)

end LieGroups

import Mathlib.Geometry.Manifold.GroupLieAlgebra
import Mathlib.Geometry.Manifold.IntegralCurve.UniformTime
import Mathlib.Topology.Algebra.ContinuousMonoidHom
import LieGroups.Manifold.IntegralCurveSmooth

/-!
# Integral curves of left-invariant vector fields

Left translation transports integral curves of `mulInvariantVectorField v`. Local existence
at the identity therefore gives a uniform existence interval at every group point, and
Mathlib's uniform-time theorem gives global existence. Uniqueness implies the subgroup law.

The completeness argument follows Lee, *Introduction to Smooth Manifolds*, second edition
(2013), Theorem 9.18; the subgroup-law argument is part of Theorem 20.1. The construction
works for smooth real Lie groups with complete model space on Hausdorff boundaryless
manifolds. The curve is bundled as a continuous homomorphism and proved smooth in time.
Smooth dependence on the initial velocity is separate work.

AI-assistance disclosure: generated by OpenAI Codex on 2026-09-28; updated on 2026-09-29.
-/

open Function Filter Set
open scoped Topology ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

set_option backward.isDefEq.respectTransparency false in
omit [LieGroup I ∞ G] in
/-- The left-invariant vector field has the prescribed value at the identity. -/
@[simp] theorem mulInvariantVectorField_one (v : GroupLieAlgebra I G) :
    mulInvariantVectorField v (1 : G) = v := by
  unfold mulInvariantVectorField
  have h : (fun g : G => (1 : G) * g) = id := by ext g; exact one_mul g
  rw [h, mfderiv_id]
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- The differential of left translation transports a left-invariant vector field. -/
theorem mfderiv_mul_left_mulInvariantVectorField (g h : G) (v : GroupLieAlgebra I G) :
    mfderiv I I (g * ·) h (mulInvariantVectorField v h) =
      mulInvariantVectorField v (g * h) := by
  have hd := mfderiv_comp_apply_of_eq (I := I) (I' := I) (I'' := I)
    (f := (h * ·)) (g := (g * ·)) (x := (1 : G))
    mdifferentiableAt_mul_left mdifferentiableAt_mul_left (mul_one h) v
  have hcomp : (g * ·) ∘ (h * ·) = ((g * h) * ·) := by
    ext k
    exact (mul_assoc g h k).symm
  rw [hcomp] at hd
  exact hd.symm

set_option backward.isDefEq.respectTransparency false in
/-- Left translation preserves integral curves on their time domain. -/
theorem isMIntegralCurveOn_mul_left {γ : ℝ → G} {v : GroupLieAlgebra I G} {s : Set ℝ}
    (hγ : IsMIntegralCurveOn γ (mulInvariantVectorField v) s) (g : G) :
    IsMIntegralCurveOn (fun t => g * γ t) (mulInvariantVectorField v) s := by
  intro t ht
  have hc := (mdifferentiableAt_mul_left (I := I) (a := g) (b := γ t)).hasMFDerivAt
    |>.comp_hasMFDerivWithinAt t (hγ t ht)
  simp only [ContinuousLinearMap.smulRight_one_eq_toSpanSingleton,
    ContinuousLinearMap.comp_toSpanSingleton, mfderiv_mul_left_mulInvariantVectorField] at hc
  exact hc

/-- Left translation preserves global integral curves. -/
theorem isMIntegralCurve_mul_left {γ : ℝ → G} {v : GroupLieAlgebra I G}
    (hγ : IsMIntegralCurve γ (mulInvariantVectorField v)) (g : G) :
    IsMIntegralCurve (fun t => g * γ t) (mulInvariantVectorField v) := by
  rw [isMIntegralCurve_iff_isMIntegralCurveOn] at hγ ⊢
  exact isMIntegralCurveOn_mul_left hγ g

/-- Coordinates on the Lie algebra from the preferred tangent-bundle trivialization at one.
This equivalence depends on the chosen chart; it does not impose a norm on the tangent space. -/
noncomputable def lieAlgebraModelEquiv : GroupLieAlgebra I G ≃L[ℝ] E :=
  VectorBundle.continuousLinearEquivAt ℝ E (TangentSpace I) (1 : G)

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- The invariant field is jointly smooth in the group point and initial velocity.
Velocities are expressed in the model space using the identity chart. -/
theorem contMDiff_mulInvariantVectorField_joint :
    ContMDiff (I.prod 𝓘(ℝ, E)) I.tangent ∞
      (fun p : G × E => (⟨p.1, mulInvariantVectorField
        ((lieAlgebraModelEquiv (I := I) (G := G)).symm p.2) p.1⟩ : TangentBundle I G)) := by
  let fg : G × E → TangentBundle I G := fun p => Bundle.TotalSpace.mk' E p.1 0
  have sfg : ContMDiff (I.prod 𝓘(ℝ, E)) I.tangent ∞ fg :=
    (Bundle.contMDiff_zeroSection _ _).comp contMDiff_fst
  let fv : G × E → TangentBundle I G := fun p =>
    Bundle.TotalSpace.mk' E 1 ((lieAlgebraModelEquiv (I := I) (G := G)).symm p.2)
  have sfv : ContMDiff (I.prod 𝓘(ℝ, E)) I.tangent ∞ fv := by
    intro p
    rw [Bundle.contMDiffAt_totalSpace]
    refine ⟨contMDiffAt_const, ?_⟩
    change ContMDiffAt _ _ ∞ (fun q : G × E => lieAlgebraModelEquiv
      ((lieAlgebraModelEquiv (I := I) (G := G)).symm q.2)) p
    simpa only [ContinuousLinearEquiv.apply_symm_apply] using
      (contMDiffAt_snd : ContMDiffAt (I.prod 𝓘(ℝ, E)) 𝓘(ℝ, E) ∞ Prod.snd p)
  let F₂ := (equivTangentBundleProd I G I G).symm
  let F₃ := tangentMap (I.prod I) I (fun p : G × G => p.1 * p.2)
  have S₂ : ContMDiff (I.tangent.prod I.tangent) (I.prod I).tangent ∞ F₂ :=
    contMDiff_equivTangentBundleProd_symm
  have S₃ : ContMDiff (I.prod I).tangent I.tangent ∞ F₃ :=
    (contMDiff_mul I ∞).contMDiff_tangentMap (by simp)
  convert! (S₃.comp S₂).comp (sfg.prodMk sfv) with p
  · simp [F₂, F₃, fg, fv]
  · simp only [comp_apply, tangentMap, F₃, F₂, fg, fv]
    rw [mfderiv_prod_eq_add_apply ((contMDiff_mul I ∞).mdifferentiableAt (by simp))]
    simp +instances [mulInvariantVectorField]

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Left-invariant vector fields on a smooth Lie group are smooth.
This extends Mathlib's `C²` statement using the same tangent-map construction. -/
theorem contMDiff_infty_mulInvariantVectorField (v : GroupLieAlgebra I G) :
    ContMDiff I I.tangent ∞ (fun g => (⟨g, mulInvariantVectorField v g⟩ : TangentBundle I G)) := by
  have h := (contMDiff_mulInvariantVectorField_joint (I := I) (G := G)).comp
    (contMDiff_id.prodMk (contMDiff_const (c := lieAlgebraModelEquiv v)))
  simpa only [Function.comp_def, id_eq, ContinuousLinearEquiv.symm_apply_apply] using h

private theorem contMDiff_one_mulInvariantVectorField (v : GroupLieAlgebra I G) :
    ContMDiff I I.tangent 1 (fun g => (⟨g, mulInvariantVectorField v g⟩ : TangentBundle I G)) :=
  (contMDiff_infty_mulInvariantVectorField v).of_le (by simp)

variable [CompleteSpace E] [BoundarylessManifold I G] [T2Space G]

/-- Left-invariant vector fields are complete: their integral curves exist for all real time. -/
theorem exists_isMIntegralCurve_mulInvariantVectorField (v : GroupLieAlgebra I G) (g : G) :
    ∃ γ : ℝ → G, γ 0 = g ∧ IsMIntegralCurve γ (mulInvariantVectorField v) := by
  have hv := contMDiff_one_mulInvariantVectorField v
  obtain ⟨γ, hγ0, hγ⟩ := exists_isMIntegralCurveAt_of_contMDiffAt_boundaryless
    (I := I) (x₀ := (1 : G)) 0 hv.contMDiffAt
  obtain ⟨ε, hε, hγ⟩ := isMIntegralCurveAt_iff'.mp hγ
  have hγ' : IsMIntegralCurveOn γ (mulInvariantVectorField v) (Ioo (-ε) ε) := by
    simpa only [Real.ball_eq_Ioo, zero_sub, zero_add] using hγ
  apply exists_isMIntegralCurve_of_isMIntegralCurveOn hv hε ?_ g
  intro h
  exact ⟨fun t => h * γ t, by simp [hγ0], isMIntegralCurveOn_mul_left hγ' h⟩

omit [CompleteSpace E] in
/-- Global integral curves of a fixed left-invariant field are determined by their value at zero. -/
theorem isMIntegralCurve_mulInvariantVectorField_unique {v : GroupLieAlgebra I G}
    {γ η : ℝ → G} (hγ : IsMIntegralCurve γ (mulInvariantVectorField v))
    (hη : IsMIntegralCurve η (mulInvariantVectorField v)) (h0 : γ 0 = η 0) : γ = η :=
  isMIntegralCurve_Ioo_eq_of_contMDiff_boundaryless
    (contMDiff_one_mulInvariantVectorField v) hγ hη h0

omit [CompleteSpace E] in
/-- An integral curve through the identity obeys the one-parameter subgroup law. -/
theorem isMIntegralCurve_mulInvariantVectorField_add {v : GroupLieAlgebra I G}
    {γ : ℝ → G} (hγ : IsMIntegralCurve γ (mulInvariantVectorField v)) (h0 : γ 0 = 1)
    (s t : ℝ) : γ (s + t) = γ s * γ t := by
  have heq := isMIntegralCurve_mulInvariantVectorField_unique
    (hγ.comp_add s) (isMIntegralCurve_mul_left hγ (γ s)) (by simp [h0])
  simpa only [Function.comp_apply, add_comm t s] using congrFun heq t

/-- The global integral curve through the identity with initial velocity `v`.
Uniqueness makes this independent of the choice in the existence proof. -/
noncomputable def oneParameterCurve (v : GroupLieAlgebra I G) : ℝ → G :=
  Classical.choose (exists_isMIntegralCurve_mulInvariantVectorField v 1)

/-- The constructed curve starts at the identity. -/
@[simp] theorem oneParameterCurve_zero (v : GroupLieAlgebra I G) :
    oneParameterCurve v 0 = 1 :=
  (Classical.choose_spec (exists_isMIntegralCurve_mulInvariantVectorField v 1)).1

/-- The constructed curve solves the left-invariant differential equation for all time. -/
theorem oneParameterCurve_isMIntegralCurve (v : GroupLieAlgebra I G) :
    IsMIntegralCurve (oneParameterCurve v) (mulInvariantVectorField v) :=
  (Classical.choose_spec (exists_isMIntegralCurve_mulInvariantVectorField v 1)).2

/-- Any global solution with the same initial value is the constructed curve. -/
theorem oneParameterCurve_unique {v : GroupLieAlgebra I G} {γ : ℝ → G}
    (hγ : IsMIntegralCurve γ (mulInvariantVectorField v)) (h0 : γ 0 = 1) :
    γ = oneParameterCurve v :=
  isMIntegralCurve_mulInvariantVectorField_unique hγ (oneParameterCurve_isMIntegralCurve v)
    (h0.trans (oneParameterCurve_zero v).symm)

/-- Addition of time corresponds to multiplication in the group. -/
theorem oneParameterCurve_add (v : GroupLieAlgebra I G) (s t : ℝ) :
    oneParameterCurve v (s + t) = oneParameterCurve v s * oneParameterCurve v t :=
  isMIntegralCurve_mulInvariantVectorField_add
    (oneParameterCurve_isMIntegralCurve v) (oneParameterCurve_zero v) s t

/-- The constructed curve is continuous on the whole real line. -/
theorem oneParameterCurve_continuous (v : GroupLieAlgebra I G) :
    Continuous (oneParameterCurve v) :=
  (oneParameterCurve_isMIntegralCurve v).continuous

/-- The constructed curve is manifold-differentiable for every time. -/
theorem oneParameterCurve_mdifferentiable (v : GroupLieAlgebra I G) :
    MDifferentiable 𝓘(ℝ, ℝ) I (oneParameterCurve v) :=
  fun t => (oneParameterCurve_isMIntegralCurve v t).mdifferentiableAt

/-- The constructed one-parameter curve is smooth in time. -/
theorem oneParameterCurve_contMDiff (v : GroupLieAlgebra I G) :
    ContMDiff 𝓘(ℝ, ℝ) I ∞ (oneParameterCurve v) :=
  Manifold.contMDiff_isMIntegralCurve (oneParameterCurve_isMIntegralCurve v)
    (contMDiff_infty_mulInvariantVectorField v)

set_option backward.isDefEq.respectTransparency false in
/-- The velocity at time zero is `v`, using `oneParameterCurve_zero` to identify its base point. -/
theorem oneParameterCurve_hasMFDerivAt_zero (v : GroupLieAlgebra I G) :
    HasMFDerivAt 𝓘(ℝ, ℝ) I (oneParameterCurve v) 0
      ((1 : ℝ →L[ℝ] ℝ).smulRight
        (tangentSpaceCast I (1 : G) (oneParameterCurve v 0) v)) := by
  have h := oneParameterCurve_isMIntegralCurve v 0
  have hv : mulInvariantVectorField v (oneParameterCurve v 0) =
      tangentSpaceCast I (1 : G) (oneParameterCurve v 0) v := by
    rw [oneParameterCurve_zero]
    exact mulInvariantVectorField_one v
  rw [hv] at h
  exact h

/-- Scaling the initial velocity rescales time, including the zero scalar. -/
theorem oneParameterCurve_smul (v : GroupLieAlgebra I G) (c t : ℝ) :
    oneParameterCurve (c • v) t = oneParameterCurve v (t * c) := by
  have h : IsMIntegralCurve (oneParameterCurve v ∘ (· * c))
      (mulInvariantVectorField (c • v)) := by
    rw [mulInvariantVectorField_smul]
    exact (oneParameterCurve_isMIntegralCurve v).comp_mul c
  have heq := oneParameterCurve_unique h (by simp)
  exact (congrFun heq t).symm

/-- Zero initial velocity gives the constant identity curve. -/
@[simp] theorem oneParameterCurve_zero_velocity (t : ℝ) :
    oneParameterCurve (0 : GroupLieAlgebra I G) t = 1 := by
  have h : IsMIntegralCurve (fun _ : ℝ => (1 : G))
      (mulInvariantVectorField (0 : GroupLieAlgebra I G)) :=
    isMIntegralCurve_const (by simp)
  exact (congrFun (oneParameterCurve_unique h rfl) t).symm

/-- The one-parameter curve packaged using Mathlib's continuous homomorphism type.
`Multiplicative ℝ` records that real addition corresponds to multiplication in `G`. -/
noncomputable def oneParameterSubgroup (v : GroupLieAlgebra I G) : Multiplicative ℝ →ₜ* G where
  toFun t := oneParameterCurve v (Multiplicative.toAdd t)
  map_one' := oneParameterCurve_zero v
  map_mul' s t := oneParameterCurve_add v (Multiplicative.toAdd s) (Multiplicative.toAdd t)
  continuous_toFun := oneParameterCurve_continuous v

/-- The bundled homomorphism has the previously constructed integral curve as its values. -/
@[simp] theorem oneParameterSubgroup_apply (v : GroupLieAlgebra I G) (t : ℝ) :
    oneParameterSubgroup v (Multiplicative.ofAdd t) = oneParameterCurve v t := rfl

/-- Negating time inverts the group element. -/
@[simp] theorem oneParameterCurve_neg (v : GroupLieAlgebra I G) (t : ℝ) :
    oneParameterCurve v (-t) = (oneParameterCurve v t)⁻¹ :=
  map_inv (oneParameterSubgroup v) (Multiplicative.ofAdd t)

end LieGroups

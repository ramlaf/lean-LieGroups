import LieGroups.ConnectedGeneration
import LieGroups.HomomorphismLieAlgebra
import LieGroups.SubgroupTangent
import Mathlib.Algebra.Lie.Subalgebra
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Topology.Connected.PathConnected

/-!
# Connected subgroup images are determined by their Lie algebras

The subgroup generated by the exponentials of a Lie subalgebra is a canonical
algebraic subgroup. For a smooth homomorphism from a connected finite-dimensional
Lie group, its image is precisely the subgroup generated by the exponentials of
its differential image. Consequently, two such homomorphisms with the same
differential image have the same group image.

This file does not put a manifold structure on the canonical subgroup or prove
that an arbitrary Lie subalgebra integrates to an immersed Lie subgroup.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Set
open scoped Topology ContDiff Manifold Pointwise

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G] [T2Space G]

/-- The algebraic subgroup generated by the exponentials of a Lie subalgebra.
This definition alone does not supply a Lie-subgroup manifold structure. -/
noncomputable def lieSubalgebraSubgroup (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    Subgroup G := Subgroup.closure (lieExp '' (S : Set (GroupLieAlgebra I G)))

/-- Exponentials of elements of the Lie subalgebra belong to its generated subgroup. -/
theorem lieExp_mem_lieSubalgebraSubgroup (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    {v : GroupLieAlgebra I G} (hv : v ∈ S) : lieExp v ∈ lieSubalgebraSubgroup S :=
  Subgroup.subset_closure ⟨v, hv, rfl⟩

/-- The generated subgroup is the least subgroup containing these exponentials. -/
theorem lieSubalgebraSubgroup_le_iff (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (K : Subgroup G) : lieSubalgebraSubgroup S ≤ K ↔
      ∀ v ∈ S, lieExp v ∈ K := by
  rw [lieSubalgebraSubgroup, Subgroup.closure_le]
  exact Set.image_subset_iff

/-- Enlarging a Lie subalgebra enlarges its generated subgroup. -/
theorem lieSubalgebraSubgroup_mono {S T : LieSubalgebra ℝ (GroupLieAlgebra I G)}
    (hST : S ≤ T) : lieSubalgebraSubgroup S ≤ lieSubalgebraSubgroup T := by
  apply (lieSubalgebraSubgroup_le_iff S _).2
  intro v hv
  exact lieExp_mem_lieSubalgebraSubgroup T (hST hv)

/-- The entire one-parameter curve of an element of a Lie subalgebra stays in
the generated subgroup. -/
theorem oneParameterCurve_mem_lieSubalgebraSubgroup
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) {v : GroupLieAlgebra I G}
    (hv : v ∈ S) (t : ℝ) : oneParameterCurve v t ∈ lieSubalgebraSubgroup S := by
  rw [← lieExp_smul]
  exact lieExp_mem_lieSubalgebraSubgroup S (S.smul_mem t hv)

/-- The generated subgroup is path-connected in the ambient topology. This does
not supply a smooth manifold structure on it. -/
theorem isPathConnected_lieSubalgebraSubgroup
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    IsPathConnected (lieSubalgebraSubgroup S : Set G) := by
  let : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  refine ⟨1, (lieSubalgebraSubgroup S).one_mem, ?_⟩
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨v, hv, rfl⟩ := hx
    apply JoinedIn.ofLine (oneParameterCurve_contMDiff v).continuous.continuousOn
      (oneParameterCurve_zero v) rfl
    rintro _ ⟨t, _, rfl⟩
    exact oneParameterCurve_mem_lieSubalgebraSubgroup S hv t
  | one => exact JoinedIn.refl (lieSubalgebraSubgroup S).one_mem
  | mul x y _ _ hx hy =>
    have h := (hx.mul hy).mono (show
        (lieSubalgebraSubgroup S : Set G) * (lieSubalgebraSubgroup S : Set G) ⊆
          (lieSubalgebraSubgroup S : Set G) from by
      rintro _ ⟨a, ha, b, hb, rfl⟩
      exact (lieSubalgebraSubgroup S).mul_mem ha hb)
    simpa only [one_mul] using h
  | inv x _ hx =>
    simpa only [inv_one, inv_coe_set] using hx.inv

/-- The generated subgroup is connected as a subset of the ambient group. -/
theorem isConnected_lieSubalgebraSubgroup
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    IsConnected (lieSubalgebraSubgroup S : Set G) :=
  (isPathConnected_lieSubalgebraSubgroup S).isConnected

/-- Every vector of a Lie subalgebra is realized by an ambient differentiable
curve lying in its generated subgroup. No converse is asserted here. -/
theorem lieSubalgebra_subset_subgroupTangentSet
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    (S : Set (GroupLieAlgebra I G)) ⊆
      subgroupTangentSet (I := I) (lieSubalgebraSubgroup S) := by
  intro v hv
  exact mem_subgroupTangentSet_of_oneParameterCurve _ v
    (oneParameterCurve_mem_lieSubalgebraSubgroup S hv)

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]
  [BoundarylessManifold J K] [T2Space K] [ConnectedSpace K]

/-- The image of a smooth homomorphism from a connected finite-dimensional Lie
group is generated by the exponentials of its differential image. -/
theorem range_eq_lieSubalgebraSubgroup (f : K →* G)
    (hf : ContMDiff J I ∞ (fun k => f k)) :
    f.range = lieSubalgebraSubgroup (homLieHom f hf).range := by
  rw [f.range_eq_map, ← closure_range_lieExp_eq_top (I := J) (G := K),
    MonoidHom.map_closure, lieSubalgebraSubgroup]
  congr 1
  ext x
  constructor
  · rintro ⟨k, ⟨v, rfl⟩, rfl⟩
    exact ⟨homLieHom f hf v, ⟨v, rfl⟩, (lieExp_map f hf v).symm⟩
  · rintro ⟨w, ⟨v, rfl⟩, rfl⟩
    exact ⟨lieExp v, ⟨v, rfl⟩, lieExp_map f hf v⟩

variable {D : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D] [FiniteDimensional ℝ D]
  {H'' : Type*} [TopologicalSpace H''] {L : ModelWithCorners ℝ D H''}
  {Q : Type*} [Group Q] [TopologicalSpace Q] [ChartedSpace H'' Q] [LieGroup L ∞ Q]
  [BoundarylessManifold L Q] [T2Space Q] [ConnectedSpace Q]

/-- Connected smooth subgroup images with the same differential image coincide.
The two source Lie groups may have different model spaces and dimensions. -/
theorem range_eq_of_homLieHom_range_eq (f : K →* G) (g : Q →* G)
    (hf : ContMDiff J I ∞ (fun k => f k)) (hg : ContMDiff L I ∞ (fun q => g q))
    (hfg : (homLieHom f hf).range = (homLieHom g hg).range) :
    f.range = g.range := by
  rw [range_eq_lieSubalgebraSubgroup f hf, range_eq_lieSubalgebraSubgroup g hg, hfg]

end LieGroups

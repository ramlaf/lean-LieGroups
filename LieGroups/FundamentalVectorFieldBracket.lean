import LieGroups.FundamentalVectorField
import LieGroups.Manifold.RelatedVectorFields

/-!
# The bracket convention for fundamental fields

For a left action, the positive-time orbit derivative is an antihomomorphism:
the bracket of two fundamental fields is minus the field of the Lie bracket.
The proof relates left-invariant fields to fundamental fields by the inverse orbit map.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

open Function
open scoped ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

set_option backward.isDefEq.respectTransparency false in
/-- The differential of group inversion at the identity is negation. -/
theorem mfderiv_inv_one_apply (v : GroupLieAlgebra I G) :
    mfderiv I I (fun g : G => g⁻¹) 1 v = -v := by
  have hi : MDifferentiableAt I I (fun g : G => g⁻¹) 1 :=
    (contMDiff_inv (I := I) (n := ∞)).mdifferentiableAt (by simp)
  have hm : MDifferentiableAt (I.prod I) I (fun p : G × G => p.1 * p.2) (1, 1) :=
    (contMDiff_mul I ∞).mdifferentiableAt (by simp)
  have hc := mfderiv_comp_apply_of_eq (I := I) (I' := I.prod I) (I'' := I)
    (f := fun g : G => (g, g⁻¹)) (g := fun p : G × G => p.1 * p.2)
    (x := (1 : G)) hm (mdifferentiableAt_id.prodMk hi) (by simp) v
  have he : (fun g : G => g * g⁻¹) = (fun _ : G => (1 : G)) := by
    funext g
    exact mul_inv_cancel g
  simp only [Function.comp_def] at hc
  have hp := mfderiv_prodMk (I := I) (I' := I) (I'' := I)
    (f := fun g : G => g) (g := fun g : G => g⁻¹) mdifferentiableAt_id hi
  rw [hp] at hc
  rw [show mfderiv I I (fun g : G => g) (1 : G) =
    ContinuousLinearMap.id ℝ (GroupLieAlgebra I G) from mfderiv_id] at hc
  change mfderiv I I (fun g : G => g * g⁻¹) 1 v =
    mfderiv (I.prod I) I (fun p : G × G => p.1 * p.2) (1, 1)
      (v, mfderiv I I (fun g : G => g⁻¹) 1 v) at hc
  rw [mfderiv_prod_eq_add_apply hm] at hc
  have hright : (fun g : G => g * 1) = id := by ext g; exact mul_one g
  have hleft : (fun g : G => 1 * g) = id := by ext g; exact one_mul g
  rw [hright, hleft, mfderiv_id] at hc
  rw [he, mfderiv_const] at hc
  let di : GroupLieAlgebra I G := mfderiv I I (fun g : G => g⁻¹) 1 v
  change (0 : GroupLieAlgebra I G) = v + di at hc
  have hd : di = -v := (eq_neg_iff_add_eq_zero).mpr (by simpa [add_comm] using hc.symm)
  exact hd

set_option backward.isDefEq.respectTransparency false in
/-- Inversion sends left-invariant velocities to negative right-invariant velocities. -/
theorem mfderiv_inv_mulInvariantVectorField (v : GroupLieAlgebra I G) (g : G) :
    mfderiv I I (fun h : G => h⁻¹) g (mulInvariantVectorField v g) =
      -mfderiv I I (fun h : G => h * g⁻¹) 1 v := by
  have hi : MDifferentiable I I (fun h : G => h⁻¹) :=
    (contMDiff_inv (I := I) (n := ∞)).mdifferentiable (by simp)
  have hl := mfderiv_comp_apply_of_eq (I := I) (I' := I) (I'' := I)
    (f := fun h : G => g * h) (g := fun h : G => h⁻¹) (x := (1 : G))
    (hi g) mdifferentiableAt_mul_left (mul_one g) v
  have hr := mfderiv_comp_apply_of_eq (I := I) (I' := I) (I'' := I)
    (f := fun h : G => h⁻¹) (g := fun h : G => h * g⁻¹) (x := (1 : G))
    mdifferentiableAt_mul_right (hi 1) (inv_one) v
  have he : (fun h : G => (g * h)⁻¹) = (fun h : G => h⁻¹ * g⁻¹) := by
    funext h
    exact mul_inv_rev g h
  simp only [Function.comp_def] at hl hr
  rw [he] at hl
  rw [mfderiv_inv_one_apply, map_neg] at hr
  exact hl.symm.trans hr

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [MulAction G M]
  [ContMDiffSMul I J ∞ G M]

set_option backward.isDefEq.respectTransparency false in
/-- The inverse orbit map relates left-invariant fields to negative fundamental fields. -/
theorem mfderiv_inverseOrbitMap_mulInvariantVectorField
    (x : M) (v : GroupLieAlgebra I G) (g : G) :
    mfderiv I J (fun h : G => h⁻¹ • x) g (mulInvariantVectorField v g) =
      -fundamentalVectorField (I := I) (J := J) v (g⁻¹ • x) := by
  have hc := mfderiv_comp_apply (I := I) (I' := I) (I'' := J)
    (f := fun h : G => h⁻¹) (g := fun h : G => h • x) g
    ((contMDiff_orbitMap x).mdifferentiable (by simp) g⁻¹)
    ((contMDiff_inv (I := I) (n := ∞)).mdifferentiable (by simp) g)
    (mulInvariantVectorField v g)
  rw [mfderiv_inv_mulInvariantVectorField, map_neg, mfderiv_orbitMap_mul_right] at hc
  exact hc

variable [CompleteSpace E] [CompleteSpace F] [IsManifold J ∞ M]

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

set_option backward.isDefEq.respectTransparency false in
/-- With the positive-time convention, fundamental fields of a left action reverse
the sign of the Lie bracket. -/
theorem mlieBracket_fundamentalVectorField (v w : GroupLieAlgebra I G) (x : M) :
    VectorField.mlieBracket J
      (fundamentalVectorField (I := I) (J := J) v)
      (fundamentalVectorField (I := I) (J := J) w) x =
        -fundamentalVectorField (I := I) (J := J) ⁅v, w⁆ x := by
  have hv := contMDiff_fundamentalVectorField (I := I) (J := J) (M := M) v
  have hw := contMDiff_fundamentalVectorField (I := I) (J := J) (M := M) w
  have h := Manifold.mfderiv_mlieBracket_of_related
    ((contMDiff_inv (I := I) (n := ∞)).smul (contMDiff_const (c := x)))
    (contMDiff_infty_mulInvariantVectorField v)
    (contMDiff_infty_mulInvariantVectorField w)
    hv.neg_section hw.neg_section
    (fun g => mfderiv_inverseOrbitMap_mulInvariantVectorField x v g)
    (fun g => mfderiv_inverseOrbitMap_mulInvariantVectorField x w g) (1 : G)
  change mfderiv I J (fun h : G => h⁻¹ • x) 1
      (VectorField.mlieBracket I (mulInvariantVectorField v) (mulInvariantVectorField w) 1) =
    VectorField.mlieBracket J
      (-(fundamentalVectorField (I := I) (J := J) v))
      (-(fundamentalVectorField (I := I) (J := J) w)) ((1 : G)⁻¹ • x) at h
  rw [← mulInvariantVector_mlieBracket v w,
    mfderiv_inverseOrbitMap_mulInvariantVectorField] at h
  have hneg (a : GroupLieAlgebra I G) :
      -(fundamentalVectorField (I := I) (J := J) (M := M) a) =
        (-1 : ℝ) • fundamentalVectorField (I := I) (J := J) a := by
    simp
  rw [hneg v, hneg w] at h
  rw [VectorField.mlieBracket_const_smul_left
    (hv.mdifferentiable (by simp) _),
    VectorField.mlieBracket_const_smul_right
      (hw.mdifferentiable (by simp) _)] at h
  rw [inv_one, one_smul] at h
  have he : -fundamentalVectorField (I := I) (J := J) ⁅v, w⁆ x =
      VectorField.mlieBracket J
        (fundamentalVectorField (I := I) (J := J) v)
        (fundamentalVectorField (I := I) (J := J) w) x := by
    simpa only [inv_one, one_smul, neg_smul, one_smul, neg_neg,
      GroupLieAlgebra.bracket_def] using h
  exact he.symm

end LieGroups

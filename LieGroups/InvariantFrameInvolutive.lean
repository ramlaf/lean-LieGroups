import LieGroups.InvariantFrameCoordinates
import LieGroups.InvariantDistributionInvolutive
import Mathlib.Geometry.Manifold.MFDeriv.Tangent

/-!
# Involutivity of invariant frames in coordinates

Pullback by an ambient chart transfers arbitrary smooth Euclidean fields into
the invariant distribution. Naturality of the Lie bracket then proves local
involutivity of the coordinate-frame range.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Set Filter
open scoped ContDiff Manifold Topology

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

omit [FiniteDimensional ℝ E] in
/-- Tangent trivialization in a chart is its manifold differential. -/
theorem tangentCoordinatesInChart_eq_mfderiv (g₀ : G) {x : E}
    (hx : x ∈ (extChartAt I g₀).target) :
    tangentCoordinatesInChart (I := I) g₀ x =
      mfderiv I 𝓘(ℝ, E) (extChartAt I g₀) ((extChartAt I g₀).symm x) := by
  have hg : (extChartAt I g₀).symm x ∈ (chartAt H g₀).source := by
    rw [← extChartAt_source I]
    exact (extChartAt I g₀).map_target hx
  rw [(hasMFDerivAt_extChartAt hg).mfderiv, mfderiv_chartAt_eq_tangentCoordChange hg]
  ext v
  exact Bundle.Trivialization.continuousLinearMapAt_apply_of_mem ℝ _ hg v

/-- At a charted group point, the frame range is the differential image of the distribution. -/
theorem range_invariantFrameInChart_at_chart (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (g₀ : G) {g : G} (hg : g ∈ (extChartAt I g₀).source) :
    LinearMap.range (invariantFrameInChart (I := I) (lieSubalgebraModelSubmodule S)
      g₀ (extChartAt I g₀ g)).toLinearMap =
      (invariantDistribution S g).map (mfderiv I 𝓘(ℝ, E) (extChartAt I g₀) g).toLinearMap := by
  rw [range_invariantFrameInChart, tangentCoordinatesInChart_eq_mfderiv g₀
    ((extChartAt I g₀).map_source hg), (extChartAt I g₀).left_inv hg]
  rfl

/-- Pulling back a coordinate-frame value gives a value in the invariant distribution. -/
theorem mpullback_mem_invariantDistribution_of_mem_range_invariantFrame
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (g₀ : G) {g : G}
    (hg : g ∈ (extChartAt I g₀).source) {V : E → E}
    (hV : V (extChartAt I g₀ g) ∈ LinearMap.range
      (invariantFrameInChart (I := I) (lieSubalgebraModelSubmodule S)
        g₀ (extChartAt I g₀ g)).toLinearMap) :
    VectorField.mpullback I 𝓘(ℝ, E) (extChartAt I g₀) V g ∈ invariantDistribution S g := by
  rw [range_invariantFrameInChart_at_chart S g₀ hg] at hV
  obtain ⟨v, hv, heq⟩ := hV
  have hinv := isInvertible_mfderiv_extChartAt (I := I) hg
  have hp : VectorField.mpullback I 𝓘(ℝ, E) (extChartAt I g₀) V g = v := by
    exact hinv.inverse_apply_eq.mpr heq.symm
  rwa [hp]

set_option backward.isDefEq.respectTransparency false in
/-- The range of the invariant frame is involutive for arbitrary locally smooth
Euclidean fields whose values belong to the frame range near the given point. -/
theorem lieBracket_mem_range_invariantFrameInChart
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (g₀ : G) {x : E}
    (hx : x ∈ (extChartAt I g₀).target) {V W : E → E}
    (hV : ContDiffAt ℝ ∞ V x) (hW : ContDiffAt ℝ ∞ W x)
    (hVS : ∀ᶠ y in 𝓝 x, V y ∈ LinearMap.range
      (invariantFrameInChart (I := I) (lieSubalgebraModelSubmodule S) g₀ y).toLinearMap)
    (hWS : ∀ᶠ y in 𝓝 x, W y ∈ LinearMap.range
      (invariantFrameInChart (I := I) (lieSubalgebraModelSubmodule S) g₀ y).toLinearMap) :
    VectorField.lieBracket ℝ V W x ∈ LinearMap.range
      (invariantFrameInChart (I := I) (lieSubalgebraModelSubmodule S) g₀ x).toLinearMap := by
  let g := (extChartAt I g₀).symm x
  have hg : g ∈ (extChartAt I g₀).source := (extChartAt I g₀).map_target hx
  have hcg : extChartAt I g₀ g = x := (extChartAt I g₀).right_inv hx
  have hc : ContMDiffAt I 𝓘(ℝ, E) ∞ (extChartAt I g₀) g :=
    contMDiffAt_extChartAt' (by rwa [← extChartAt_source I])
  have hi := isInvertible_mfderiv_extChartAt (I := I) hg
  have hV' : ContMDiffAt 𝓘(ℝ, E) (𝓘(ℝ, E)).tangent ∞
      (fun y => (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, E) E)) (extChartAt I g₀ g) := by
    rw [hcg]
    exact contMDiffAt_vectorSpace_iff_contDiffAt.mpr hV
  have hW' : ContMDiffAt 𝓘(ℝ, E) (𝓘(ℝ, E)).tangent ∞
      (fun y => (⟨y, W y⟩ : TangentBundle 𝓘(ℝ, E) E)) (extChartAt I g₀ g) := by
    rw [hcg]
    exact contMDiffAt_vectorSpace_iff_contDiffAt.mpr hW
  have hPV := hV'.mpullback_vectorField_preimage hc hi (by simp)
  have hPW := hW'.mpullback_vectorField_preimage hc hi (by simp)
  have hmem (Y : E → E) (hY : ∀ᶠ y in 𝓝 x, Y y ∈ LinearMap.range
      (invariantFrameInChart (I := I) (lieSubalgebraModelSubmodule S) g₀ y).toLinearMap) :
      ∀ᶠ y in 𝓝 g, VectorField.mpullback I 𝓘(ℝ, E) (extChartAt I g₀) Y y ∈
        invariantDistribution S y := by
    have he := hc.continuousAt.tendsto
    rw [hcg] at he
    filter_upwards [he hY, (extChartAt_source_mem_nhds' hg)] with y hy hys
    exact mpullback_mem_invariantDistribution_of_mem_range_invariantFrame S g₀ hys hy
  have hb := mlieBracket_mem_invariantDistribution_of_eventually S hPV hPW
    (hmem V hVS) (hmem W hWS)
  have hn := VectorField.mpullback_mlieBracket
    (hV'.mdifferentiableAt (by simp)) (hW'.mdifferentiableAt (by simp)) hc (by simp)
  have hval := hi.inverse_apply_eq.mp hn
  have hEuclid : VectorField.mlieBracket 𝓘(ℝ, E) V W = VectorField.lieBracket ℝ V W := by
    simpa only [VectorField.mlieBracketWithin_univ, VectorField.lieBracketWithin_univ] using
      (VectorField.mlieBracketWithin_eq_lieBracketWithin (𝕜 := ℝ) (V := V) (W := W)
        (s := Set.univ))
  have he : VectorField.lieBracket ℝ V W x =
      mfderiv I 𝓘(ℝ, E) (extChartAt I g₀) g
        (VectorField.mlieBracket I
          (VectorField.mpullback I 𝓘(ℝ, E) (extChartAt I g₀) V)
          (VectorField.mpullback I 𝓘(ℝ, E) (extChartAt I g₀) W) g) := by
    simpa only [hEuclid, hcg] using hval
  rw [← hcg, range_invariantFrameInChart_at_chart S g₀ hg, hcg]
  exact ⟨_, hb, he.symm⟩

end LieGroups

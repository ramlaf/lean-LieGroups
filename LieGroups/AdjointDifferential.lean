import LieGroups.LieII
import LieGroups.Algebra.Ado
import LieGroups.LinearLieAlgebra

/-!
# Differentiating the adjoint action

The adjoint action is differentiated through a faithful finite-dimensional
linear representation. Ado and Lie II construct that representation for a
simply connected group; injectivity of its differential detects the result.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-22.
-/

noncomputable section
open scoped ContDiff Manifold

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩
attribute [local instance] LieRing.ofAssociativeRing

section Units

variable {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]

set_option backward.isDefEq.respectTransparency false in
/-- In the ambient algebra, conjugation acts on tangent vectors by conjugation. -/
theorem units_lieAlgebraModelEquiv_lieAdjoint
    (g : Aˣ) (v : GroupLieAlgebra 𝓘(ℝ, A) Aˣ) :
    lieAlgebraModelEquiv (lieAdjoint (I := 𝓘(ℝ, A)) g v) =
      (g : A) * lieAlgebraModelEquiv v * (g⁻¹ : Aˣ) := by
  let c : A →L[ℝ] A := ((ContinuousLinearMap.mul ℝ A).flip (g⁻¹ : Aˣ)).comp
    (ContinuousLinearMap.mul ℝ A (g : A))
  have hv : MDifferentiable 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) :=
    (Units.contMDiff_val (𝕜 := ℝ) (n := ∞)).mdifferentiable (by simp)
  have hc := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, A)) (I' := 𝓘(ℝ, A))
    (I'' := 𝓘(ℝ, A)) (x := (1 : Aˣ))
    (f := fun h : Aˣ => (MulAut.conj g) h) (g := Units.val)
    (hv 1) ((contMDiff_conjugation g).mdifferentiable (by simp) 1)
    (by simp) v
  have hc' := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, A)) (I' := 𝓘(ℝ, A))
    (I'' := 𝓘(ℝ, A)) (x := (1 : Aˣ)) (y := (1 : A))
    (f := Units.val) (g := c)
    c.differentiableAt.mdifferentiableAt (hv 1) (by simp) v
  have he : (fun h : Aˣ => ((MulAut.conj g) h : A)) =
      (fun h : Aˣ => c (h : A)) := by
    funext h
    rfl
  simp only [Function.comp_def] at hc hc'
  rw [he] at hc
  rw [mfderiv_eq_fderiv, ContinuousLinearMap.fderiv] at hc'
  have hev (z : GroupLieAlgebra 𝓘(ℝ, A) Aˣ) : lieAlgebraModelEquiv z =
      mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) 1 z :=
    congrArg (fun T : GroupLieAlgebra 𝓘(ℝ, A) Aˣ →L[ℝ] A => T z)
      units_lieAlgebraModelEquiv_eq_mfderiv_val
  rw [hev, hev]
  exact hc.symm.trans hc'

end Units

section Faithful

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {G : Type*} [Group G] [TopologicalSpace G]
  [ChartedSpace H G] [LieGroup I ∞ G] [BoundarylessManifold I G] [T2Space G]
  {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]

local instance : CompleteSpace E := FiniteDimensional.complete ℝ E

set_option backward.isDefEq.respectTransparency false in
/-- The initial velocity of a smooth representation, in its ambient algebra. -/
theorem hasDerivAt_unitsHom_oneParameterCurve_zero
    (f : G →* Aˣ) (hf : ContMDiff I 𝓘(ℝ, A) ∞ (fun g => f g))
    (X : GroupLieAlgebra I G) :
    HasDerivAt (fun t => (f (oneParameterCurve X t) : A))
      (lieAlgebraModelEquiv (homLieDifferential (I := I) (J := 𝓘(ℝ, A)) f X)) 0 := by
  have hv : MDifferentiable 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) :=
    (Units.contMDiff_val (𝕜 := ℝ) (n := ∞)).mdifferentiable (by simp)
  have h := (hv (oneParameterCurve
    (homLieDifferential (I := I) (J := 𝓘(ℝ, A)) f X) 0)).hasMFDerivAt.comp 0
    (oneParameterCurve_hasMFDerivAt_zero (homLieDifferential (I := I) (J := 𝓘(ℝ, A)) f X))
  have hd := h.hasFDerivAt.hasDerivAt
  have hev := congrArg (fun T : GroupLieAlgebra 𝓘(ℝ, A) Aˣ →L[ℝ] A =>
    T (homLieDifferential (I := I) (J := 𝓘(ℝ, A)) f X))
    (units_lieAlgebraModelEquiv_eq_mfderiv_val (A := A))
  let v := homLieDifferential (I := I) (J := 𝓘(ℝ, A)) f X
  change HasDerivAt (fun t => ((oneParameterCurve v t : Aˣ) : A))
    ((mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A) (oneParameterCurve v 0))
      (((1 : ℝ →L[ℝ] ℝ).smulRight
        (tangentSpaceCast 𝓘(ℝ, A) (1 : Aˣ) (oneParameterCurve v 0) v)) 1)) 0 at hd
  have heq : (mfderiv 𝓘(ℝ, A) 𝓘(ℝ, A) (Units.val : Aˣ → A)
      (oneParameterCurve v 0))
        (tangentSpaceCast 𝓘(ℝ, A) (1 : Aˣ) (oneParameterCurve v 0) v) =
      lieAlgebraModelEquiv v := by
    rw [oneParameterCurve_zero]
    exact hev.symm
  simp only [ContinuousLinearMap.smulRight_apply, one_apply_eq_self, one_smul, heq] at hd
  convert hd using 1
  funext t
  exact congrArg (fun g : Aˣ => (g : A)) (oneParameterCurve_map f hf X t)

variable [FiniteDimensional ℝ A]

set_option backward.isDefEq.respectTransparency false in
/-- A representation with injective differential detects the derivative of the
adjoint action. The representation itself need not be injective. -/
theorem hasDerivAt_lieAdjoint_oneParameterCurve_zero_of_faithful_differential
    (f : G →* Aˣ) (hf : ContMDiff I 𝓘(ℝ, A) ∞ (fun g => f g))
    (hinj : Function.Injective (homLieDifferential (I := I) (J := 𝓘(ℝ, A)) f))
    (X Y : GroupLieAlgebra I G) :
    HasDerivAt (fun t => lieAlgebraModelEquiv
      (lieAdjoint (I := I) (oneParameterCurve X t) Y))
      (lieAlgebraModelEquiv ⁅X, Y⁆) 0 := by
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  let a := lieAlgebraModelEquiv (I := 𝓘(ℝ, A)) (G := Aˣ)
  let df := homLieDifferential (I := I) (J := 𝓘(ℝ, A)) f
  let D : E →L[ℝ] A := a.toContinuousLinearMap.comp (df.comp e.symm.toContinuousLinearMap)
  have hD (Z : GroupLieAlgebra I G) : D (e Z) = a (df Z) := by simp [D]
  have hDi : Function.Injective D := a.injective.comp (hinj.comp e.symm.injective)
  obtain ⟨L, hL⟩ := D.toLinearMap.exists_leftInverse_of_injective
    (LinearMap.ker_eq_bot.mpr hDi)
  let Lc : A →L[ℝ] E := L.toContinuousLinearMap
  have hLD (z : E) : Lc (D z) = z :=
    congrArg (fun T : E →ₗ[ℝ] E => T z) hL
  have hp := hasDerivAt_unitsHom_oneParameterCurve_zero f hf X
  have hn := (show HasDerivAt (fun t => (f (oneParameterCurve X t) : A))
    (a (df X)) (-(0 : ℝ)) by simpa using hp).scomp 0 (hasDerivAt_neg (0 : ℝ))
  have hc := (hp.mul_const (a (df Y))).mul hn
  have hbr : a (df ⁅X, Y⁆) = a (df X) * a (df Y) - a (df Y) * a (df X) := by
    rw [homLieDifferential_map_lie f hf, units_lieAlgebraModelEquiv_map_lie, Ring.lie_def]
  have hc' : HasDerivAt
      (fun t => (f (oneParameterCurve X t) : A) * a (df Y) *
        (f (oneParameterCurve X (-t)) : A)) (a (df ⁅X, Y⁆)) 0 := by
    convert! hc using 1
    simp only [Function.comp_def, oneParameterCurve_zero, map_one, Units.val_one,
      one_mul, mul_one, mul_neg, sub_eq_add_neg, neg_zero, neg_one_smul] at *
    exact hbr
  have hcov (t : ℝ) : D (e (lieAdjoint (I := I) (oneParameterCurve X t) Y)) =
      (f (oneParameterCurve X t) : A) * a (df Y) *
        (f (oneParameterCurve X (-t)) : A) := by
    rw [hD, homLieDifferential_adjoint f hf, units_lieAlgebraModelEquiv_lieAdjoint,
      oneParameterCurve_neg, map_inv]
  have hd : HasDerivAt (fun t => D (e (lieAdjoint (I := I) (oneParameterCurve X t) Y)))
      (D (e ⁅X, Y⁆)) 0 := by
    simpa only [hcov, hD] using hc'
  have h := Lc.hasFDerivAt.comp_hasDerivAt 0 hd
  simpa only [Function.comp_def, hLD] using h

end Faithful

section SimplyConnected

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G]
  [LieGroup I ∞ G] [T2Space G] [SimplyConnectedSpace G]

local instance : CompleteSpace E := FiniteDimensional.complete ℝ E

set_option backward.isDefEq.respectTransparency false in
/-- For a simply connected finite-dimensional group, the actual derivative of
`Ad (exp (tX)) Y` at zero is `[X,Y]`. Ado and Lie II supply the faithful
differential used to check this identity. -/
theorem hasDerivAt_lieAdjoint_oneParameterCurve_zero (X Y : GroupLieAlgebra I G) :
    HasDerivAt (fun t => lieAlgebraModelEquiv
      (lieAdjoint (I := I) (oneParameterCurve X t) Y))
      (lieAlgebraModelEquiv ⁅X, Y⁆) 0 := by
  let : FiniteDimensional ℝ (GroupLieAlgebra I G) :=
    FiniteDimensional.of_injective (lieAlgebraModelEquiv (I := I) (G := G)).toLinearMap
      (lieAlgebraModelEquiv (I := I) (G := G)).injective
  obtain ⟨n, ρ, hρ⟩ := exists_faithful_finiteDimensional_representation ℝ (GroupLieAlgebra I G)
  let V := Fin n → ℝ
  let φ := (generalLinearLieAlgebraEquiv (V := V)).symm.toLieHom.comp ρ
  obtain ⟨f⟩ := nonempty_lieHomomorphismIntegration φ
  have hi : Function.Injective
      (homLieDifferential (I := I) (J := 𝓘(ℝ, V →L[ℝ] V)) f.toMonoidHom) := by
    intro u v huv
    apply ((generalLinearLieAlgebraEquiv (V := V)).symm.injective.comp hρ)
    change φ u = φ v
    rw [← f.homLieHom_eq]
    exact huv
  exact hasDerivAt_lieAdjoint_oneParameterCurve_zero_of_faithful_differential
    f.toMonoidHom f.contMDiff hi X Y

end SimplyConnected

end LieGroups

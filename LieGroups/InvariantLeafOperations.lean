/-!
# Group operations in the intrinsic foliation topology

Left-invariance lifts left translations to the leafwise manifold. Continuity of
these translations and connected small plaques imply actual local smoothness of
multiplication at the identity. No joint continuity of the leafwise group law
is assumed.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E P Q : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup Q] [NormedSpace ℝ Q]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

namespace Manifold.FoliationAtlas

variable (A : FoliationAtlas (P := P) (Q := Q) I G)

/-- Ambient left multiplication viewed on the intrinsically constructed leafwise type. -/
def leafwiseLeftMul (a : G) : A.Leafwise → A.Leafwise :=
  fun x => A.toLeafwise (a * A.toAmbient x)

/-- Ambient multiplication viewed on the intrinsically constructed leafwise type. -/
def leafwiseMul : A.Leafwise × A.Leafwise → A.Leafwise :=
  fun p => A.toLeafwise (A.toAmbient p.1 * A.toAmbient p.2)

omit [Group G] [LieGroup I ∞ G] [CompleteSpace E] in
/-- Transverse chart coordinates are locally constant for the constructed
leafwise topology on the ambient chart source. -/
theorem eventually_transverse_eq (a : G) (x : A.Leafwise)
    (hx : A.toAmbient x ∈ (A.chart a).source) :
    ∀ᶠ y in 𝓝 x, ((A.chart a) (A.toAmbient y)).2 = ((A.chart a) (A.toAmbient x)).2 := by
  let c := A.plaqueChart a (((A.chart a) (A.toAmbient x)).2)
  have hxc : x ∈ c.source := ⟨hx, rfl⟩
  filter_upwards [c.open_source.mem_nhds hxc] with y hy
  exact hy.2

/-- Invariant-distribution preservation gives smooth left translations in the
intrinsic leafwise topology. -/
theorem contMDiff_leafwiseLeftMul
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (hD : ∀ a p, p ∈ (A.chart a).source → ∀ v ∈ invariantDistribution S p,
      (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) p v).2 = 0)
    (hinc : ∀ (x : A.Leafwise) (v : TangentSpace 𝓘(ℝ, P) x),
      mfderiv 𝓘(ℝ, P) I A.toAmbient x v ∈ invariantDistribution S (A.toAmbient x))
    (a : G) : ContMDiff 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ (A.leafwiseLeftMul a) := by
  have hleft : ContMDiff I I ∞ (a * ·) := contMDiff_mul_left
  apply A.contMDiff_leafwise_of_distribution (invariantDistribution S) hD
    (hleft.comp A.contMDiff_toAmbient)
  intro x v
  rw [mfderiv_comp x (hleft.contMDiffAt.mdifferentiableAt (by simp))
    (A.contMDiff_toAmbient.contMDiffAt.mdifferentiableAt (by simp)),
    ContinuousLinearMap.comp_apply]
  dsimp only [Function.comp_apply]
  rw [← invariantDistribution_map_mul_left S a (A.toAmbient x)]
  exact ⟨_, hinc x v, rfl⟩

/-- Exact chart straightening alone gives smooth leafwise left translations;
the inclusion differential range is a theorem of the constructed atlas. -/
theorem contMDiff_leafwiseLeftMul_of_distribution_map
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (hD : ∀ a p, p ∈ (A.chart a).source →
      (invariantDistribution S p).map
          (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) p).toLinearMap =
        LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap)
    (a : G) : ContMDiff 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ (A.leafwiseLeftMul a) := by
  apply A.contMDiff_leafwiseLeftMul S
    (A.snd_mfderiv_eq_zero_of_distribution_map (invariantDistribution S) hD) _ a
  intro x v
  rw [← A.range_mfderiv_toAmbient (invariantDistribution S) hD x]
  exact ⟨v, rfl⟩

omit [CompleteSpace E] in
/-- Genuine local smooth multiplication follows from left-translation continuity
and the compatible plaque topology. In particular, leafwise joint continuity is
proved locally rather than assumed. -/
theorem exists_contMDiffOn_leafwiseMul_nhds_one
    (hleft : ∀ a : G, Continuous (A.leafwiseLeftMul a)) :
    ∃ U : Set A.Leafwise, IsOpen U ∧ A.toLeafwise 1 ∈ U ∧ IsConnected U ∧
      ContMDiffOn (𝓘(ℝ, P).prod 𝓘(ℝ, P)) 𝓘(ℝ, P) ∞ A.leafwiseMul (U ×ˢ U) := by
  let e := A.toLeafwise 1
  let c := A.plaqueChart 1 (((A.chart 1) 1).2)
  have hec : e ∈ c.source := ⟨A.mem_source 1, rfl⟩
  let F : A.Leafwise × A.Leafwise → G :=
    fun p => A.toAmbient p.1 * A.toAmbient p.2
  have hfst : ContMDiff (𝓘(ℝ, P).prod 𝓘(ℝ, P)) 𝓘(ℝ, P) ∞
      (Prod.fst : A.Leafwise × A.Leafwise → A.Leafwise) := contMDiff_fst
  have hsnd : ContMDiff (𝓘(ℝ, P).prod 𝓘(ℝ, P)) 𝓘(ℝ, P) ∞
      (Prod.snd : A.Leafwise × A.Leafwise → A.Leafwise) := contMDiff_snd
  have hpair : ContMDiff (𝓘(ℝ, P).prod 𝓘(ℝ, P)) (I.prod I) ∞
      (fun p : A.Leafwise × A.Leafwise => (A.toAmbient p.1, A.toAmbient p.2)) :=
    (A.contMDiff_toAmbient.comp hfst).prodMk (A.contMDiff_toAmbient.comp hsnd)
  have hF : ContMDiff (𝓘(ℝ, P).prod 𝓘(ℝ, P)) I ∞ F :=
    (contMDiff_mul I ∞).comp hpair
  have hFone : F (e, e) = 1 := by
    change (1 : G) * 1 = 1
    exact one_mul 1
  have hnhds : F ⁻¹' (A.chart 1).source ∈ 𝓝 (e, e) := by
    have hFc : ContinuousAt F (e, e) := hF.continuous.continuousAt
    apply hFc.preimage_mem_nhds
    exact hFone.symm ▸ (A.chart 1).open_source.mem_nhds (A.mem_source 1)
  obtain ⟨U, hU, V, hV, hUV⟩ := mem_nhds_prod_iff.mp hnhds
  have hsmall : U ∩ V ∩ c.source ∈ 𝓝 e := inter_mem (inter_mem hU hV)
    (c.open_source.mem_nhds hec)
  obtain ⟨W, ⟨hWo, heW, hWc⟩, hW⟩ :=
    (LocallyConnectedSpace.open_connected_basis e).mem_iff.mp hsmall
  have hproduct (x y : A.Leafwise) (hx : x ∈ W) (hy : y ∈ W) :
      F (x, y) ∈ (A.chart 1).source := hUV ⟨(hW hx).1.1, (hW hy).1.2⟩
  have htransverse : ∀ x ∈ W, ∀ y ∈ W,
      ((A.chart 1) (F (x, y))).2 = ((A.chart 1) 1).2 := by
    intro x hx y hy
    let : PreconnectedSpace W := isPreconnected_iff_preconnectedSpace.mp hWc.isPreconnected
    let q : W → Q := fun z => ((A.chart 1) (F (x, z))).2
    have hq : IsLocallyConstant q := by
      rw [IsLocallyConstant.iff_eventually_eq]
      intro z
      have hz := A.eventually_transverse_eq 1
        (A.leafwiseLeftMul (A.toAmbient x) z) (hproduct x z hx z.property)
      exact ((hleft (A.toAmbient x)).comp continuous_subtype_val).continuousAt.tendsto hz
    have hqeq := hq.apply_eq_of_preconnectedSpace (⟨y, hy⟩ : W) ⟨e, heW⟩
    change ((A.chart 1) (F (x, y))).2 = ((A.chart 1) (F (x, e))).2 at hqeq
    have hxe : F (x, e) = A.toAmbient x := by
      change A.toAmbient x * (1 : G) = A.toAmbient x
      exact mul_one _
    rw [hxe] at hqeq
    exact hqeq.trans (hW hx).2.2
  refine ⟨W, hWo, heW, hWc, ?_⟩
  intro p hp
  apply ContMDiffAt.contMDiffWithinAt
  apply A.contMDiffAt_leafwise_of_transverse_eventuallyEq 1
    (hproduct p.1 p.2 hp.1 hp.2) hF.contMDiffAt
  filter_upwards [(hWo.prod hWo).mem_nhds hp] with q hq
  exact (htransverse q.1 hq.1 q.2 hq.2).trans
    (htransverse p.1 hp.1 p.2 hp.2).symm

omit [CompleteSpace E] [LieGroup I ∞ G] in
/-- Smooth lifted translations provide the continuity hypothesis for the
constructed identity-leaf group. -/
theorem continuous_mul_left_leafwise
    (hleft : ∀ a : G, ContMDiff 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ (A.leafwiseLeftMul a)) :
    ∀ a : A.Leafwise, Continuous (fun b : A.Leafwise => a * b) :=
  fun a => (hleft (A.toAmbient a)).continuous

omit [CompleteSpace E] in
/-- The actual intrinsic identity leaf is a Lie group: local product smoothness
is constructed from plaques, and local inversion follows from the inverse
function theorem before the operations are globalized. -/
theorem lieGroup_identityLeaf [CompleteSpace P]
    (hleft : ∀ a : G, ContMDiff 𝓘(ℝ, P) 𝓘(ℝ, P) ∞ (A.leafwiseLeftMul a)) :
    letI := A.identityLeafGroup (A.continuous_mul_left_leafwise hleft)
    LieGroup 𝓘(ℝ, P) ∞ (A.leaf 1) := by
  let := A.identityLeafGroup (A.continuous_mul_left_leafwise hleft)
  have hl : ∀ a : A.leaf 1, ContMDiff 𝓘(ℝ, P) 𝓘(ℝ, P) ∞
      (fun b : A.leaf 1 => a * b) := by
    intro a
    apply (ContMDiff.subtypeVal_comp_iff (A.leaf 1) (fun b : A.leaf 1 => a * b)).mp
    exact (hleft (A.toAmbient a.val)).comp contMDiff_subtype_val
  obtain ⟨U, hUo, hU1, _, hmul⟩ :=
    A.exists_contMDiffOn_leafwiseMul_nhds_one (fun a => (hleft a).continuous)
  let V : Set (A.leaf 1) := Subtype.val ⁻¹' U
  have hV : V ∈ 𝓝 (1 : A.leaf 1) :=
    continuous_subtype_val.continuousAt.preimage_mem_nhds (hUo.mem_nhds hU1)
  apply lieGroup_of_local_mul hl hV
  have hfst : ContMDiff (𝓘(ℝ, P).prod 𝓘(ℝ, P)) 𝓘(ℝ, P) ∞
      (Prod.fst : A.leaf 1 × A.leaf 1 → A.leaf 1) := contMDiff_fst
  have hsnd : ContMDiff (𝓘(ℝ, P).prod 𝓘(ℝ, P)) 𝓘(ℝ, P) ∞
      (Prod.snd : A.leaf 1 × A.leaf 1 → A.leaf 1) := contMDiff_snd
  have hpair : ContMDiff (𝓘(ℝ, P).prod 𝓘(ℝ, P)) (𝓘(ℝ, P).prod 𝓘(ℝ, P)) ∞
      (fun p : A.leaf 1 × A.leaf 1 => (p.1.val, p.2.val)) :=
    (contMDiff_subtype_val.comp hfst).prodMk (contMDiff_subtype_val.comp hsnd)
  intro p hp
  apply (ContMDiffWithinAt.subtypeVal_comp_iff (A.leaf 1)
    (fun p : A.leaf 1 × A.leaf 1 => p.1 * p.2) (V ×ˢ V) p).mp
  exact ((hmul (p.1.val, p.2.val) hp).contMDiffAt
    ((hUo.prod hUo).mem_nhds hp)).comp p hpair.contMDiffAt |>.contMDiffWithinAt

/-- A foliation atlas straightening a Lie-subalgebra distribution constructs
a genuine Lie-group structure on its actual connected identity leaf. -/
theorem lieGroup_identityLeaf_of_distribution_map [CompleteSpace P]
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (hD : ∀ a p, p ∈ (A.chart a).source →
      (invariantDistribution S p).map
          (mfderiv I 𝓘(ℝ, P × Q) (A.chart a) p).toLinearMap =
        LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap) :
    let hleft := A.contMDiff_leafwiseLeftMul_of_distribution_map S hD
    letI := A.identityLeafGroup (A.continuous_mul_left_leafwise hleft)
    LieGroup 𝓘(ℝ, P) ∞ (A.leaf 1) :=
  A.lieGroup_identityLeaf (A.contMDiff_leafwiseLeftMul_of_distribution_map S hD)


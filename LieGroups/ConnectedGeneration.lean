import LieGroups.ExponentialLocalChart
import Mathlib.Topology.Algebra.OpenSubgroup
import Mathlib.Topology.Connected.Clopen

/-!
# Connected Lie groups are generated by exponentials

The local inverse of the exponential supplies an identity neighborhood contained
in its range. A subgroup containing all exponentials is therefore open, and in a
connected group it is the whole group. Here `Subgroup.closure` denotes algebraic
generation, not topological closure.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Set
open scoped Topology ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {G : Type*} [Group G] [TopologicalSpace G]
  [ChartedSpace H G] [LieGroup I ∞ G] [BoundarylessManifold I G] [T2Space G]

/-- The range of the exponential contains a neighborhood of the identity. -/
theorem range_lieExp_mem_nhds_one :
    Set.range (lieExp (I := I) (G := G)) ∈ 𝓝 (1 : G) := by
  obtain ⟨Φ, h0, hΦ0, hEq⟩ := exists_lieExp_localHomeomorph_model (I := I) (G := G)
  have h1 : (1 : G) ∈ Φ.target := hΦ0 ▸ Φ.map_source h0
  refine Filter.mem_of_superset (Φ.open_target.mem_nhds h1) ?_
  intro g hg
  refine ⟨(lieAlgebraModelEquiv (I := I) (G := G)).symm (Φ.symm g), ?_⟩
  exact (hEq (Φ.map_target hg)).trans (Φ.right_inv hg)

/-- Any subgroup containing all exponentials is open. -/
theorem subgroup_isOpen_of_lieExp_mem (S : Subgroup G)
    (hS : ∀ v : GroupLieAlgebra I G, lieExp v ∈ S) : IsOpen (S : Set G) := by
  let : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  apply S.isOpen_of_mem_nhds (g := 1)
  refine Filter.mem_of_superset (range_lieExp_mem_nhds_one (I := I) (G := G)) ?_
  rintro g ⟨v, rfl⟩
  exact hS v

/-- A connected Lie group has no proper subgroup containing all exponentials. -/
theorem subgroup_eq_top_of_lieExp_mem [ConnectedSpace G] (S : Subgroup G)
    (hS : ∀ v : GroupLieAlgebra I G, lieExp v ∈ S) : S = ⊤ := by
  let : IsTopologicalGroup G := topologicalGroup_of_lieGroup I ∞
  have hOpen := subgroup_isOpen_of_lieExp_mem (I := I) S hS
  have hUniv : (S : Set G) = Set.univ :=
    (show IsClopen (S : Set G) from ⟨S.isClosed_of_isOpen hOpen, hOpen⟩).eq_univ
      ⟨1, S.one_mem⟩
  exact SetLike.coe_injective hUniv

/-- A connected Lie group is algebraically generated by its exponentials. -/
theorem closure_range_lieExp_eq_top [ConnectedSpace G] :
    Subgroup.closure (Set.range (lieExp (I := I) (G := G))) = ⊤ := by
  apply subgroup_eq_top_of_lieExp_mem (I := I)
  intro v
  exact Subgroup.subset_closure ⟨v, rfl⟩

/-- Equivalently, a subgroup containing every one-parameter subgroup of a
connected Lie group is the whole group. -/
theorem subgroup_eq_top_of_oneParameterCurve_mem [ConnectedSpace G] (S : Subgroup G)
    (hS : ∀ (v : GroupLieAlgebra I G) (t : ℝ), oneParameterCurve v t ∈ S) :
    S = ⊤ := by
  exact subgroup_eq_top_of_lieExp_mem (I := I) S (fun v => hS v 1)

end LieGroups

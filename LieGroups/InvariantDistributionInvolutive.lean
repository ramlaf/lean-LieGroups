import LieGroups.InvariantDistribution
import Mathlib.LinearAlgebra.Projection
import Mathlib.LinearAlgebra.Dimension.Free
import Mathlib.Geometry.Manifold.VectorBundle.ContMDiffSection

/-!
# Local involutivity of a left-invariant distribution

Left translation back to the identity provides smooth coordinates for arbitrary smooth
vector fields. In finite dimensions, linear coordinate extensions then give smooth coefficients
in any finite invariant frame. The Leibniz rules prove local bracket closure from smoothness at
the point and distribution membership near it. No integral-leaf existence is assumed or asserted.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Set Module Filter
open scoped ContDiff Manifold Topology

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

/-- Translate a vector field back to the identity, using the differential of left multiplication
by the inverse group element. -/
noncomputable def leftTrivializedField (V : (g : G) → TangentSpace I g) (g : G) :
    GroupLieAlgebra I G := mfderiv I I (g⁻¹ * ·) g (V g)

omit [CompleteSpace E] in
@[simp] theorem leftTrivializedField_invariant (v : GroupLieAlgebra I G) (g : G) :
    leftTrivializedField (mulInvariantVectorField v) g = v := by
  unfold leftTrivializedField
  rw [mfderiv_mul_left_mulInvariantVectorField, inv_mul_cancel, mulInvariantVectorField_one]

omit [CompleteSpace E] in
/-- Translating back to the identity and then forwards recovers the original vector. -/
theorem mulInvariantVectorField_leftTrivializedField
    (V : (g : G) → TangentSpace I g) (g : G) :
    mulInvariantVectorField (leftTrivializedField V g) g = V g := by
  obtain ⟨v, hv⟩ := (leftTranslationTangentEquiv (I := I) g).surjective (V g)
  change mulInvariantVectorField v g = V g at hv
  change mulInvariantVectorField (mfderiv I I (g⁻¹ * ·) g (V g)) g = V g
  rw [← hv]
  change mulInvariantVectorField (leftTrivializedField (mulInvariantVectorField v) g) g = _
  rw [leftTrivializedField_invariant]

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
omit [CompleteSpace E] in
/-- The identity coordinates of a smooth vector field depend smoothly on the group point. -/
theorem contMDiffAt_leftTrivializedField_model {V : (g : G) → TangentSpace I g} {g₀ : G}
    (hV : ContMDiffAt I I.tangent ∞ (fun g => (⟨g, V g⟩ : TangentBundle I G)) g₀) :
    ContMDiffAt I 𝓘(ℝ, E) ∞ (fun g =>
      lieAlgebraModelEquiv (I := I) (G := G) (leftTrivializedField V g)) g₀ := by
  let fg : G → TangentBundle I G := fun g => Bundle.TotalSpace.mk' E g⁻¹ 0
  have sfg : ContMDiff I I.tangent ∞ fg :=
    (Bundle.contMDiff_zeroSection _ _).comp (contMDiff_inv I ∞)
  let F₂ := (equivTangentBundleProd I G I G).symm
  let F₃ := tangentMap (I.prod I) I (fun p : G × G => p.1 * p.2)
  have S₂ : ContMDiff (I.tangent.prod I.tangent) (I.prod I).tangent ∞ F₂ :=
    contMDiff_equivTangentBundleProd_symm
  have S₃ : ContMDiff (I.prod I).tangent I.tangent ∞ F₃ :=
    (contMDiff_mul I ∞).contMDiff_tangentMap (by simp)
  have h : ContMDiffAt I I.tangent ∞ (fun g =>
      (⟨1, leftTrivializedField V g⟩ : TangentBundle I G)) g₀ := by
    convert! (S₃.comp S₂).contMDiffAt.comp g₀ (sfg.contMDiffAt.prodMk hV) with g
    · simp [F₂, F₃, fg]
    · simp only [comp_apply, tangentMap, F₃, F₂, fg]
      rw [mfderiv_prod_eq_add_apply ((contMDiff_mul I ∞).mdifferentiableAt (by simp))]
      simp +instances [leftTrivializedField]
  have hc := (Bundle.contMDiffAt_totalSpace.mp h).2
  exact hc

omit [CompleteSpace E] in
/-- Global version of smoothness of left-trivialized field coordinates. -/
theorem contMDiff_leftTrivializedField_model {V : (g : G) → TangentSpace I g}
    (hV : ContMDiff I I.tangent ∞ (fun g => (⟨g, V g⟩ : TangentBundle I G))) :
    ContMDiff I 𝓘(ℝ, E) ∞ (fun g =>
      lieAlgebraModelEquiv (I := I) (G := G) (leftTrivializedField V g)) :=
  fun g => contMDiffAt_leftTrivializedField_model (hV g)

/-- A smooth section of the distribution has smooth global coefficients in any finite
invariant frame. The coefficients are constructed by extending the algebraic coordinate
functionals to the finite-dimensional ambient model space. -/
theorem exists_contMDiff_invariantFrame_coefficients [FiniteDimensional ℝ E]
    {ι : Type*} [Fintype ι] (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (b : Basis ι ℝ S) {V : (g : G) → TangentSpace I g}
    (hV : ContMDiff I I.tangent ∞ (fun g => (⟨g, V g⟩ : TangentBundle I G)))
    (hVS : ∀ g, V g ∈ invariantDistribution S g) :
    ∃ a : ι → G → ℝ, (∀ i, ContMDiff I 𝓘(ℝ, ℝ) ∞ (a i)) ∧
      ∀ g, V g = ∑ i, a i g • mulInvariantVectorField (b i : GroupLieAlgebra I G) g := by
  classical
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  let inclusion : S →ₗ[ℝ] E := e.toLinearMap.comp S.toSubmodule.subtype
  have hinj : Function.Injective inclusion := e.injective.comp Subtype.val_injective
  obtain ⟨r, hr⟩ := inclusion.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr hinj)
  let c (i : ι) : E →ₗ[ℝ] ℝ := (b.coord i).comp r
  let a (i : ι) (g : G) : ℝ := c i (e (leftTrivializedField V g))
  refine ⟨a, ?_, ?_⟩
  · intro i
    exact ((c i).toContinuousLinearMap.contDiff.contMDiff).comp
      (contMDiff_leftTrivializedField_model hV)
  · intro g
    have hm : leftTrivializedField V g ∈ S := by
      obtain ⟨v, hv, heq⟩ := (mem_invariantDistribution_iff S g (V g)).1 (hVS g)
      unfold leftTrivializedField
      rw [← heq]
      change leftTrivializedField (mulInvariantVectorField v) g ∈ S
      rwa [leftTrivializedField_invariant]
    let v : S := ⟨leftTrivializedField V g, hm⟩
    have hrw : r (e (leftTrivializedField V g)) = v := by
      have hh := DFunLike.congr_fun hr v
      exact hh
    have ha : ∀ i, a i g = b.repr v i := by
      intro i
      change b.coord i (r (e (leftTrivializedField V g))) = b.repr v i
      rw [hrw]
      rfl
    let L : S →ₗ[ℝ] TangentSpace I g :=
      (leftTranslationTangentEquiv (I := I) g).toLinearMap.comp S.toSubmodule.subtype
    have hsum := congrArg L (b.sum_repr v)
    simp only [map_sum, map_smul] at hsum
    have hLv : L v = V g := mulInvariantVectorField_leftTrivializedField V g
    rw [hLv] at hsum
    calc
      V g = ∑ i, b.repr v i • L (b i) := hsum.symm
      _ = ∑ i, a i g • mulInvariantVectorField (b i : GroupLieAlgebra I G) g := by
        apply Finset.sum_congr rfl
        intro i _
        rw [ha i]
        rfl

/-- Local coefficient extraction: smoothness at one point and distribution membership
near that point suffice to obtain a smooth-at-the-point invariant-frame expansion as a germ. -/
theorem exists_contMDiffAt_invariantFrame_coefficients [FiniteDimensional ℝ E]
    {ι : Type*} [Fintype ι] (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (b : Basis ι ℝ S) {V : (g : G) → TangentSpace I g} {g₀ : G}
    (hV : ContMDiffAt I I.tangent ∞ (fun g => (⟨g, V g⟩ : TangentBundle I G)) g₀)
    (hVS : ∀ᶠ g in 𝓝 g₀, V g ∈ invariantDistribution S g) :
    ∃ a : ι → G → ℝ, (∀ i, ContMDiffAt I 𝓘(ℝ, ℝ) ∞ (a i) g₀) ∧
      V =ᶠ[𝓝 g₀] (fun g => ∑ i, a i g •
        mulInvariantVectorField (b i : GroupLieAlgebra I G) g) := by
  classical
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  let inclusion : S →ₗ[ℝ] E := e.toLinearMap.comp S.toSubmodule.subtype
  have hinj : Function.Injective inclusion := e.injective.comp Subtype.val_injective
  obtain ⟨r, hr⟩ := inclusion.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr hinj)
  let c (i : ι) : E →ₗ[ℝ] ℝ := (b.coord i).comp r
  let a (i : ι) (g : G) : ℝ := c i (e (leftTrivializedField V g))
  refine ⟨a, ?_, ?_⟩
  · intro i
    exact ((c i).toContinuousLinearMap.contDiff.contMDiff.contMDiffAt).comp g₀
      (contMDiffAt_leftTrivializedField_model hV)
  · filter_upwards [hVS] with g hg
    have hm : leftTrivializedField V g ∈ S := by
      obtain ⟨v, hv, heq⟩ := (mem_invariantDistribution_iff S g (V g)).1 hg
      unfold leftTrivializedField
      rw [← heq]
      change leftTrivializedField (mulInvariantVectorField v) g ∈ S
      rwa [leftTrivializedField_invariant]
    let v : S := ⟨leftTrivializedField V g, hm⟩
    have hrw : r (e (leftTrivializedField V g)) = v := DFunLike.congr_fun hr v
    have ha : ∀ i, a i g = b.repr v i := by
      intro i
      change b.coord i (r (e (leftTrivializedField V g))) = b.repr v i
      rw [hrw]
      rfl
    let L : S →ₗ[ℝ] TangentSpace I g :=
      (leftTranslationTangentEquiv (I := I) g).toLinearMap.comp S.toSubmodule.subtype
    have hsum := congrArg L (b.sum_repr v)
    simp only [map_sum, map_smul] at hsum
    have hLv : L v = V g := mulInvariantVectorField_leftTrivializedField V g
    rw [hLv] at hsum
    calc
      V g = ∑ i, b.repr v i • L (b i) := hsum.symm
      _ = ∑ i, a i g • mulInvariantVectorField (b i : GroupLieAlgebra I G) g := by
        apply Finset.sum_congr rfl
        intro i _
        rw [ha i]
        rfl

/-- The vector-field bracket distributes over a finite sum of differentiable fields
in its first argument. -/
theorem mlieBracket_finset_sum_left {ι : Type*} (s : Finset ι)
    (V : ι → (g : G) → TangentSpace I g) (W : (g : G) → TangentSpace I g) (g : G)
    (hV : ∀ i ∈ s, MDifferentiableAt I I.tangent
      (fun g => (⟨g, V i g⟩ : TangentBundle I G)) g) :
    VectorField.mlieBracket I (fun g => ∑ i ∈ s, V i g) W g =
      ∑ i ∈ s, VectorField.mlieBracket I (V i) W g := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    change VectorField.mlieBracket I 0 W g = 0
    exact congrFun (VectorField.mlieBracket_zero_left (I := I) (W := W)) g
  | insert i s hi ih =>
    have hv := hV i (Finset.mem_insert_self i s)
    have hs := fun j hj => hV j (Finset.mem_insert_of_mem hj)
    have hsum := MDifferentiableAt.sum_section hs
    simp only [Finset.sum_insert hi]
    change VectorField.mlieBracket I (V i + (fun g => ∑ j ∈ s, V j g)) W g = _
    rw [VectorField.mlieBracket_add_left hv hsum, ih hs]

/-- The vector-field bracket distributes over a finite sum of differentiable fields
in its second argument. -/
theorem mlieBracket_finset_sum_right {ι : Type*} (s : Finset ι)
    (V : (g : G) → TangentSpace I g) (W : ι → (g : G) → TangentSpace I g) (g : G)
    (hW : ∀ i ∈ s, MDifferentiableAt I I.tangent
      (fun g => (⟨g, W i g⟩ : TangentBundle I G)) g) :
    VectorField.mlieBracket I V (fun g => ∑ i ∈ s, W i g) g =
      ∑ i ∈ s, VectorField.mlieBracket I V (W i) g := by
  rw [VectorField.mlieBracket_swap_apply, mlieBracket_finset_sum_left s W V g hW,
    ← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro i _
  exact (VectorField.mlieBracket_swap_apply (I := I) (V := V) (W := W i) (x := g)).symm

/-- Local involutivity of the left-invariant distribution of a Lie subalgebra: fields smooth
at a point and valued in the distribution near that point have bracket in its fiber there.
The smooth coefficient functions are constructed from the given fields. -/
theorem mlieBracket_mem_invariantDistribution_of_eventually [FiniteDimensional ℝ E]
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) {V W : (g : G) → TangentSpace I g}
    {g : G}
    (hV : ContMDiffAt I I.tangent ∞ (fun g => (⟨g, V g⟩ : TangentBundle I G)) g)
    (hW : ContMDiffAt I I.tangent ∞ (fun g => (⟨g, W g⟩ : TangentBundle I G)) g)
    (hVS : ∀ᶠ y in 𝓝 g, V y ∈ invariantDistribution S y)
    (hWS : ∀ᶠ y in 𝓝 g, W y ∈ invariantDistribution S y) :
    VectorField.mlieBracket I V W g ∈ invariantDistribution S g := by
  classical
  let : FiniteDimensional ℝ (GroupLieAlgebra I G) :=
    FiniteDimensional.of_injective (lieAlgebraModelEquiv (I := I) (G := G)).toLinearMap
      (lieAlgebraModelEquiv (I := I) (G := G)).injective
  let b := Module.finBasis ℝ S
  obtain ⟨a, ha, hVa⟩ := exists_contMDiffAt_invariantFrame_coefficients S b hV hVS
  obtain ⟨c, hc, hWc⟩ := exists_contMDiffAt_invariantFrame_coefficients S b hW hWS
  let X := fun i => mulInvariantVectorField (b i : GroupLieAlgebra I G)
  have hA (i) : ContMDiffAt I I.tangent ∞
      (fun g => (⟨g, (a i • X i) g⟩ : TangentBundle I G)) g :=
    (ha i).smul_section
      (contMDiff_infty_mulInvariantVectorField (b i : GroupLieAlgebra I G)).contMDiffAt
  have hC (i) : ContMDiffAt I I.tangent ∞
      (fun g => (⟨g, (c i • X i) g⟩ : TangentBundle I G)) g :=
    (hc i).smul_section
      (contMDiff_infty_mulInvariantVectorField (b i : GroupLieAlgebra I G)).contMDiffAt
  have heqV : V =ᶠ[𝓝 g] (fun g => ∑ i, (a i • X i) g) := hVa
  have heqW : W =ᶠ[𝓝 g] (fun g => ∑ i, (c i • X i) g) := hWc
  have heq := heqV.mlieBracketWithin_vectorField_eq_nhds (I := I) (s := univ) heqW
  change VectorField.mlieBracketWithin I V W univ g ∈ _
  rw [heq]
  change VectorField.mlieBracket I (fun g => ∑ i, (a i • X i) g)
    (fun g => ∑ i, (c i • X i) g) g ∈ _
  rw [mlieBracket_finset_sum_left _ _ _ g
    (fun i _ => (hA i).mdifferentiableAt (by simp))]
  apply (invariantDistribution S g).sum_mem
  intro i _
  rw [mlieBracket_finset_sum_right _ _ _ g
    (fun j _ => (hC j).mdifferentiableAt (by simp))]
  apply (invariantDistribution S g).sum_mem
  intro j _
  exact mlieBracket_smul_invariant_mem_invariantDistribution S (b i).property (b j).property
    ((ha i).mdifferentiableAt (by simp)) ((hc j).mdifferentiableAt (by simp))

/-- Global smooth sections of a Lie-subalgebra distribution are closed under the bracket. -/
theorem mlieBracket_mem_invariantDistribution [FiniteDimensional ℝ E]
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) {V W : (g : G) → TangentSpace I g}
    (hV : ContMDiff I I.tangent ∞ (fun g => (⟨g, V g⟩ : TangentBundle I G)))
    (hW : ContMDiff I I.tangent ∞ (fun g => (⟨g, W g⟩ : TangentBundle I G)))
    (hVS : ∀ g, V g ∈ invariantDistribution S g)
    (hWS : ∀ g, W g ∈ invariantDistribution S g) (g : G) :
    VectorField.mlieBracket I V W g ∈ invariantDistribution S g :=
  mlieBracket_mem_invariantDistribution_of_eventually S (hV g) (hW g)
    (Filter.Eventually.of_forall hVS) (Filter.Eventually.of_forall hWS)

end LieGroups

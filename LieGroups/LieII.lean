import LieGroups.LieEquivalenceIntegration
import LieGroups.GraphIntegrationLocalDiffeomorph
import LieGroups.CoveringGroup
import DifferentialGeometry.Topology.Covering.SimplyConnected

/-!
# Lie's second theorem

The connected immersed integration of the graph of a Lie-algebra homomorphism
projects locally diffeomorphically onto its source group. This projection is a
covering homomorphism. A simply connected source makes it invertible, giving
the required smooth homomorphism with the prescribed identity differential.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open scoped ContDiff Manifold

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {HE : Type*} [TopologicalSpace HE] {I : ModelWithCorners ℝ E HE} [I.Boundaryless]
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace HE G] [LieGroup I ∞ G]
  [T2Space G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {HF : Type*} [TopologicalSpace HF] {J : ModelWithCorners ℝ F HF} [J.Boundaryless]
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace HF K] [LieGroup J ∞ K]
  [T2Space K]

/-- Every Lie-algebra homomorphism from the Lie algebra of a simply connected
finite-dimensional real Lie group integrates to a smooth group homomorphism. -/
theorem nonempty_lieHomomorphismIntegration [SimplyConnectedSpace G]
    (φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J K) :
    Nonempty (LieHomomorphismIntegration φ) := by
  let : LocallyPathConnectedSpace HE := I.toHomeomorph.symm.locallyPathConnectedSpace
  let : LocallyPathConnectedSpace G := ChartedSpace.locallyPathConnectedSpace HE G
  obtain ⟨A⟩ := nonempty_lieHomomorphismGraphIntegration φ
  let L := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ))
  have hp : IsLocalDiffeomorph L I ∞ A.sourceHom := A.isLocalDiffeomorph_sourceHom
  let := topologicalGroup_of_lieGroup (I := I) (n := ∞) (G := G)
  let := topologicalGroup_of_lieGroup (I := L) (n := ∞) (G := A.Carrier)
  have hc : IsCoveringMap A.sourceHom :=
    isCoveringMap_hom_of_isLocalHomeomorph A.sourceHom hp.isLocalHomeomorph
      A.sourceHom_surjective
  have hb := hc.bijective_sc
  let D := hp.diffeomorphOfBijective hb
  let e : A.Carrier ≃* G := MulEquiv.ofBijective A.sourceHom hb
  have he : ContMDiff L I ∞ (fun x => e x) := A.contMDiff_sourceHom
  have hi : ContMDiff I L ∞ (fun x => e.symm x) := by
    have heq : (fun x => e.symm x) = D.symm := by
      funext x
      apply hb.injective
      exact (e.apply_symm_apply x).trans (D.apply_symm_apply x).symm
    rw [heq]
    exact D.contMDiff_invFun
  let f := A.targetHom.comp e.symm.toMonoidHom
  have hf : ContMDiff I J ∞ (fun x => f x) := A.contMDiff_targetHom.comp hi
  refine ⟨⟨f, hf, ?_⟩⟩
  ext v
  change homLieDifferential (I := I) (J := J) f v = φ v
  rw [show f = A.targetHom.comp e.symm.toMonoidHom from rfl,
    homLieDifferential_comp e.symm.toMonoidHom A.targetHom hi A.contMDiff_targetHom,
    ContinuousLinearMap.comp_apply, A.differential_relation]
  have hinv := congrArg (fun T : GroupLieAlgebra I G →L[ℝ] GroupLieAlgebra I G => T v)
    (homLieDifferential_symm_comp (I := I) (J := L) e.symm hi he)
  change homLieDifferential (I := L) (J := I) A.sourceHom
    (homLieDifferential (I := I) (J := L) e.symm.toMonoidHom v) = v at hinv
  rw [hinv]

/-- Lie II with uniqueness expressed directly for bundled smooth group
homomorphisms and the prescribed Lie-algebra differential. -/
theorem existsUnique_smoothHom_of_lieHom [SimplyConnectedSpace G]
    (φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J K) :
    ∃! f : ContMDiffMonoidMorphism I J ∞ G K,
      homLieHom f.toMonoidHom f.contMDiff_toFun = φ := by
  obtain ⟨A⟩ := nonempty_lieHomomorphismIntegration φ
  refine ⟨{ toMonoidHom := A.toMonoidHom, contMDiff_toFun := A.contMDiff },
    A.homLieHom_eq, ?_⟩
  intro f hf
  apply DFunLike.ext
  intro x
  have he := hom_eq_of_homLieHom_eq f.toMonoidHom A.toMonoidHom f.contMDiff_toFun A.contMDiff
    (hf.trans A.homLieHom_eq.symm)
  exact congrArg (fun q : G →* K => q x) he

/-- A chosen integration of a prescribed Lie-algebra homomorphism. -/
def integrateLieHom [SimplyConnectedSpace G]
    (φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J K) : LieHomomorphismIntegration φ :=
  Classical.choice (nonempty_lieHomomorphismIntegration φ)

/-- A Lie-algebra equivalence between simply connected finite-dimensional real
Lie groups integrates to a smooth group equivalence with that differential. -/
theorem nonempty_lieEquivalenceIntegration [SimplyConnectedSpace G] [SimplyConnectedSpace K]
    (e : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ GroupLieAlgebra J K) :
    Nonempty (LieEquivalenceIntegration e) := by
  obtain ⟨f⟩ := nonempty_lieHomomorphismIntegration e.toLieHom
  obtain ⟨g⟩ := nonempty_lieHomomorphismIntegration e.symm.toLieHom
  exact ⟨LieEquivalenceIntegration.ofInverseIntegrations f g⟩

/-- A chosen smooth integration of a prescribed Lie-algebra equivalence. -/
def integrateLieEquiv [SimplyConnectedSpace G] [SimplyConnectedSpace K]
    (e : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ GroupLieAlgebra J K) : LieEquivalenceIntegration e :=
  Classical.choice (nonempty_lieEquivalenceIntegration e)

end LieGroups

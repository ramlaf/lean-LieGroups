import LieGroups.UniversalCoverGroup

/-!
# Countability of the constructed universal covering group

A connected second-countable finite-dimensional Lie group has a second-countable
universal covering group. The proof uses countability of the fundamental group
of the base, as established for the actual path-class cover in the pinned library.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open scoped Manifold ContDiff

namespace LieGroups.UniversalCoverGroup

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℝ E H) [I.Boundaryless]
  (G : Type*) [Group G] [TopologicalSpace G] [ChartedSpace H G]
  [LieGroup I ∞ G] [T2Space G] [ConnectedSpace G] [SecondCountableTopology G]
  [LocallyPathConnectedSpace G]
  [DifferentialGeometry.Geometry.Riemannian.Topology.SemilocallySimplyConnectedSpace G]

include I

omit [I.Boundaryless] [LieGroup I ∞ G] in
/-- The actual universal cover has a countable union of compact subsets whenever
the connected finite-dimensional base Lie group is second countable. -/
theorem sigmaCompactSpace : SigmaCompactSpace (UniversalCoverGroup G) := by
  let : LocallyCompactSpace G := Manifold.locallyCompact_of_finiteDimensional I
  let : SigmaCompactSpace G := inferInstance
  let : Inhabited G := ⟨1⟩
  exact DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.instSigmaCompactSpace

omit [LieGroup I ∞ G] in
/-- The constructed universal covering group retains second countability. -/
theorem secondCountableTopology : SecondCountableTopology (UniversalCoverGroup G) := by
  let : SecondCountableTopology H := I.toHomeomorph.secondCountableTopology
  let : SigmaCompactSpace (UniversalCoverGroup G) := sigmaCompactSpace I G
  exact ChartedSpace.secondCountable_of_sigmaCompact H (UniversalCoverGroup G)

end LieGroups.UniversalCoverGroup

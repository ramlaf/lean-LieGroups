import LieGroups.Analysis.LocalSmoothExtension
import DifferentialGeometry.Analysis.ODE.TimeDependentFlow.SmoothDependence.Parameter

/-!
# Smooth local solutions for parameterized fields on open sets

Use a smooth cutoff to apply DifferentialGeometry's smooth-dependence theorem to
fields given only on an open coordinate domain. Shrink the parameter and time
neighborhoods so that the resulting solutions solve the original equation.

AI-assistance disclosure: generated by OpenAI Codex on 2026-09-29.
-/

open Set Filter Metric
open scoped Topology ContDiff

namespace LieGroups.Analysis

variable {E P : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [FiniteDimensional ℝ P]

/-- A smooth parameterized field on an open domain has local solutions jointly smooth
in parameter and time, starting at the fixed state `x₀` and remaining in that domain. -/
theorem exists_contDiffOn_parametricIntegralCurve {f : P × E → E} {s : Set (P × E)}
    (hs : IsOpen s) (hf : ContDiffOn ℝ ∞ f s) {v₀ : P} {x₀ : E} (h₀ : (v₀, x₀) ∈ s) :
    ∃ (r ε : ℝ) (φ : P × ℝ → E), 0 < r ∧ 0 < ε ∧
      ContDiffOn ℝ ∞ φ (ball v₀ r ×ˢ Ioo (-ε) ε) ∧
      (∀ v ∈ ball v₀ r, φ (v, 0) = x₀) ∧
      (∀ v ∈ ball v₀ r, ∀ t ∈ Ioo (-ε) ε,
        (v, φ (v, t)) ∈ s ∧ HasDerivAt (fun u => φ (v, u)) (f (v, φ (v, t))) t) := by
  obtain ⟨F, hF, hFeq⟩ := exists_contDiff_eventuallyEq hs h₀ hf
  have hFt : ContDiff ℝ ∞ (fun q : ℝ × P × E => F (q.2.1, q.2.2)) :=
    hF.comp contDiff_snd
  obtain ⟨rP, rE, ε, Φ, hrP, hrE, hε, hinit, hode, hsmooth⟩ :=
    DifferentialGeometry.Analysis.ODE.exists_isLocalFlow_param_contDiffOn_top
      (f := fun _ v x => F (v, x)) (t₀ := 0) (x₀ := x₀) (lam₀ := v₀) hFt
  simp only [zero_sub, zero_add] at hode hsmooth
  let φ : P × ℝ → E := fun q => Φ (q.1, x₀, q.2)
  let U : Set (P × ℝ) := ball v₀ rP ×ˢ Ioo (-ε) ε
  have hU : IsOpen U := isOpen_ball.prod isOpen_Ioo
  have hmem : (v₀, (0 : ℝ)) ∈ U := ⟨mem_ball_self hrP, by constructor <;> linarith⟩
  have hφ : ContDiffOn ℝ ∞ φ U :=
    hsmooth.comp (contDiff_fst.prodMk (contDiff_const.prodMk contDiff_snd)).contDiffOn
      (fun q hq => ⟨hq.1, mem_ball_self hrE, hq.2⟩)
  have hφ₀ : φ (v₀, 0) = x₀ := hinit v₀ (mem_ball_self hrP) x₀ (mem_ball_self hrE)
  have hΓ : ContinuousAt (fun q : P × ℝ => (q.1, φ q)) (v₀, 0) :=
    continuousAt_fst.prodMk (hφ.continuousOn.continuousAt (hU.mem_nhds hmem))
  have hgood : ∀ᶠ q : P × ℝ in 𝓝 (v₀, 0),
      q ∈ U ∧ (q.1, φ q) ∈ s ∧ F (q.1, φ q) = f (q.1, φ q) := by
    have hΓ' : Tendsto (fun q : P × ℝ => (q.1, φ q)) (𝓝 (v₀, 0)) (𝓝 (v₀, x₀)) := by
      change Tendsto (fun q : P × ℝ => (q.1, φ q)) (𝓝 (v₀, 0))
        (𝓝 (v₀, φ (v₀, 0))) at hΓ
      rw [hφ₀] at hΓ
      exact hΓ
    have hUev : ∀ᶠ q in 𝓝 (v₀, 0), q ∈ U := hU.mem_nhds hmem
    have hsEv : ∀ᶠ q in 𝓝 (v₀, x₀), q ∈ s := hs.mem_nhds h₀
    exact hUev.and (hΓ' (hsEv.and hFeq))
  obtain ⟨δ, hδ, hδsub⟩ := Metric.mem_nhds_iff.mp hgood
  have hrect : ∀ v ∈ ball v₀ δ, ∀ t ∈ Ioo (-δ) δ,
      (v, t) ∈ U ∧ (v, φ (v, t)) ∈ s ∧ F (v, φ (v, t)) = f (v, φ (v, t)) := by
    intro v hv t ht
    apply hδsub
    rw [← ball_prod_same]
    exact ⟨hv, by simpa only [Real.ball_eq_Ioo, zero_sub, zero_add] using ht⟩
  refine ⟨δ, δ, φ, hδ, hδ, hφ.mono (fun q hq => (hrect q.1 hq.1 q.2 hq.2).1), ?_, ?_⟩
  · intro v hv
    exact hinit v (hrect v hv 0 (by constructor <;> linarith)).1.1 x₀ (mem_ball_self hrE)
  · intro v hv t ht
    obtain ⟨hUq, hsq, heq⟩ := hrect v hv t ht
    refine ⟨hsq, ?_⟩
    have hd := hode v hUq.1 x₀ (mem_ball_self hrE) t hUq.2
    change HasDerivAt (fun u => φ (v, u)) (F (v, φ (v, t))) t at hd
    rwa [heq] at hd

end LieGroups.Analysis

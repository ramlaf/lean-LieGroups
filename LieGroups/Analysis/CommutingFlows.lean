import DifferentialGeometry.Analysis.ODE.TimeDependentFlow.SmoothInSpace.VariationalODE.EuclideanVariationalODE
import Mathlib.Analysis.Calculus.VectorField

/-!
# Preservation of commuting vector fields by local flows

The differential of a smooth local flow transports a commuting vector field to itself.
Both transported vectors solve the same variational linear ODE, so uniqueness proves
the identity. Commutation and differentiability are needed only along the orbit.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set Metric
open scoped Topology ContDiff NNReal
open DifferentialGeometry.Analysis.ODE.Flow

namespace LieGroups.Analysis

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- A local flow preserves a vector field commuting with its generator. The identity holds
on any time interval through zero on which the flow is jointly smooth and the commutation
condition holds along the orbit. -/
theorem fderiv_flow_apply_eq_of_lieBracket_zero
    {X Y : E → E} {x₀ x : E} {r : ℝ≥0} {tmin tmax a b : ℝ}
    {Φ : E × ℝ → E} {U : Set (E × ℝ)}
    (hΦ : IsLocalFlow (fun _ => X) 0 x₀ r tmin tmax Φ)
    (hX : ContDiff ℝ ∞ X) (hU : IsOpen U) (hsmooth : ContDiffOn ℝ ∞ Φ U)
    (hx : x ∈ ball x₀ r) (hzero : (0 : ℝ) ∈ Ioo a b)
    (htime : Ioo a b ⊆ Ioo tmin tmax)
    (hUorbit : ∀ t ∈ Ioo a b, (x, t) ∈ U)
    (hY : ∀ t ∈ Ioo a b, DifferentiableAt ℝ Y (Φ (x, t)))
    (hcomm : ∀ t ∈ Ioo a b, VectorField.lieBracket ℝ X Y (Φ (x, t)) = 0) :
    ∀ t ∈ Ioo a b,
      fderiv ℝ (fun y => Φ (y, t)) x (Y x) = Y (Φ (x, t)) := by
  have hflowX : ContDiff ℝ ∞ (uncurry (fun _ : ℝ => X)) := hX.comp contDiff_snd
  have hcurve (t : ℝ) (ht : t ∈ Ioo a b) :
      HasDerivAt (fun u => Φ (x, u)) (X (Φ (x, t))) t :=
    (hΦ.hasDerivWithinAt x (ball_subset_closedBall hx) t
      (Ioo_subset_Icc_self (htime ht))).hasDerivAt
        (Icc_mem_nhds (htime ht).1 (htime ht).2)
  let A : ℝ → E →L[ℝ] E := fun t => fderiv ℝ X (Φ (x, t))
  have hA : ContinuousOn A (Ioo a b) :=
    (hX.continuous_fderiv (by simp)).comp_continuousOn
      ((hΦ.orbit_continuousOn x (ball_subset_closedBall hx)).mono
        (fun _ ht => Ioo_subset_Icc_self (htime ht)))
  have hleft (t : ℝ) (ht : t ∈ Ioo a b) :
      HasDerivAt (fun u => fderiv ℝ (fun y => Φ (y, u)) x (Y x))
        (A t (fderiv ℝ (fun y => Φ (y, t)) x (Y x))) t :=
    hΦ.hasDerivAt_partial_spatial_fderiv_apply hflowX hU hsmooth
      (hUorbit t ht) hx (htime ht) (Y x)
  have hright (t : ℝ) (ht : t ∈ Ioo a b) :
      HasDerivAt (fun u => Y (Φ (x, u))) (A t (Y (Φ (x, t)))) t := by
    have hc : fderiv ℝ Y (Φ (x, t)) (X (Φ (x, t))) =
        fderiv ℝ X (Φ (x, t)) (Y (Φ (x, t))) :=
      sub_eq_zero.mp (hcomm t ht)
    have hd := (hY t ht).hasFDerivAt.comp_hasDerivAt t (hcurve t ht)
    rwa [hc] at hd
  have hinitial : (fun y => Φ (y, 0)) =ᶠ[𝓝 x] id := by
    filter_upwards [isOpen_ball.mem_nhds hx] with y hy
    exact hΦ.apply_initial y (ball_subset_closedBall hy)
  have heq : fderiv ℝ (fun y => Φ (y, 0)) x (Y x) = Y (Φ (x, 0)) := by
    rw [hinitial.fderiv_eq, fderiv_id, ContinuousLinearMap.id_apply,
      hΦ.apply_initial x (ball_subset_closedBall hx)]
  exact linearODE_unique_on_Ioo hzero hA hleft hright heq

end LieGroups.Analysis

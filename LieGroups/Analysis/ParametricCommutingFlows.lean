import LieGroups.Analysis.CommutingFlows
import Mathlib.Analysis.Calculus.FDeriv.Symmetric

/-!
# Parameter derivatives of flows of a commuting frame

Mixed derivatives of a jointly smooth solution give its parameter variational equation.
For a frame linear in its velocity parameter and with commuting fields, uniqueness of
that equation identifies the parameter differential explicitly.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set
open scoped Topology ContDiff
open DifferentialGeometry.Analysis.ODE.Flow

namespace LieGroups.Analysis

variable {P E : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P]
  [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The parameter derivative is the joint differential restricted to the parameter factor. -/
theorem parameter_fderiv_eq_comp_inl {Φ : P × ℝ → E} {p : P} {t : ℝ}
    (hΦ : DifferentiableAt ℝ Φ (p, t)) :
    fderiv ℝ (fun q => Φ (q, t)) p =
      (fderiv ℝ Φ (p, t)).comp (ContinuousLinearMap.inl ℝ P ℝ) :=
  (hΦ.hasFDerivAt.comp p (hasFDerivAt_prodMk_left p t)).fderiv

/-- The parameter differential of a jointly smooth solution satisfies the variational
equation obtained by differentiating its ODE. The ODE is required on an open neighborhood. -/
theorem hasDerivAt_parameter_fderiv_of_ode
    {Φ : P × ℝ → E} {F : P × E → E} {U : Set (P × ℝ)}
    (hU : IsOpen U) (hΦ : ContDiffOn ℝ ∞ Φ U)
    (hODE : ∀ q ∈ U, HasDerivAt (fun t => Φ (q.1, t)) (F (q.1, Φ q)) q.2)
    {p : P} {t : ℝ} (hpt : (p, t) ∈ U)
    (hF : DifferentiableAt ℝ F (p, Φ (p, t))) (v : P) :
    HasDerivAt (fun u => fderiv ℝ (fun q => Φ (q, u)) p v)
      (fderiv ℝ F (p, Φ (p, t)) (v, fderiv ℝ (fun q => Φ (q, t)) p v)) t := by
  have hAt : ∀ q ∈ U, ContDiffAt ℝ ∞ Φ q :=
    fun q hq => hΦ.contDiffAt (hU.mem_nhds hq)
  have hdiff : ∀ q ∈ U, DifferentiableAt ℝ Φ q :=
    fun q hq => (hAt q hq).differentiableAt (by simp)
  have hsecond := ((hAt (p, t) hpt).fderiv_right (m := 1) (by decide)).differentiableAt
    (by simp)
  let B := fderiv ℝ (fderiv ℝ Φ) (p, t)
  let eP : P × ℝ := (v, 0)
  let eT : P × ℝ := (0, 1)
  have hsymm : B eT eP = B eP eT :=
    (hAt (p, t) hpt).isSymmSndFDerivAt (by simp) eT eP
  have htime : HasDerivAt (fun u : ℝ => (p, u)) eT t :=
    (hasDerivAt_const t p).prodMk (hasDerivAt_id t)
  have hDt : HasDerivAt (fun u => fderiv ℝ Φ (p, u)) (B eT) t :=
    hsecond.hasFDerivAt.comp_hasDerivAt t htime
  have hDtApply : HasDerivAt (fun u => fderiv ℝ Φ (p, u) eP) (B eT eP) t :=
    (ContinuousLinearMap.apply ℝ E eP).hasFDerivAt.comp_hasDerivAt t hDt
  have hparamEq : (fun u => fderiv ℝ Φ (p, u) eP) =ᶠ[𝓝 t]
      (fun u => fderiv ℝ (fun q => Φ (q, u)) p v) := by
    filter_upwards [((hU.preimage (by fun_prop : Continuous (fun u : ℝ => (p, u)))).mem_nhds hpt)]
      with u hu
    rw [parameter_fderiv_eq_comp_inl (hdiff _ hu)]
    rfl
  have hleft := hparamEq.hasDerivAt_iff.mp hDtApply
  have hline : HasDerivAt (fun s : ℝ => (p + s • v, t)) eP 0 := by
    simpa using (((hasDerivAt_id (0 : ℝ)).smul_const v).const_add p).prodMk
      (hasDerivAt_const 0 t)
  have hDline : HasDerivAt (fun s : ℝ => fderiv ℝ Φ (p + s • v, t)) (B eP) 0 :=
    hsecond.hasFDerivAt.comp_hasDerivAt_of_eq 0 hline (by simp)
  have hDlineApply : HasDerivAt (fun s : ℝ => fderiv ℝ Φ (p + s • v, t) eT)
      (B eP eT) 0 :=
    (ContinuousLinearMap.apply ℝ E eT).hasFDerivAt.comp_hasDerivAt 0 hDline
  have htimeEq (q : P × ℝ) (hq : q ∈ U) :
      fderiv ℝ Φ q eT = F (q.1, Φ q) := by
    have h := (hdiff q hq).hasFDerivAt.comp_hasDerivAt q.2
      ((hasDerivAt_const q.2 q.1).prodMk (hasDerivAt_id q.2))
    exact h.unique (hODE q hq)
  have hlineEq : (fun s : ℝ => fderiv ℝ Φ (p + s • v, t) eT) =ᶠ[𝓝 0]
      (fun s : ℝ => F (p + s • v, Φ (p + s • v, t))) := by
    have hneigh : ∀ᶠ s in 𝓝 (0 : ℝ), (p + s • v, t) ∈ U :=
      hline.continuousAt.preimage_mem_nhds (by simpa using hU.mem_nhds hpt)
    filter_upwards [hneigh] with s hs
    exact htimeEq _ hs
  have hright := hlineEq.hasDerivAt_iff.mp hDlineApply
  have hPhiLine : HasDerivAt (fun s : ℝ => Φ (p + s • v, t))
      (fderiv ℝ Φ (p, t) eP) 0 :=
    (hdiff _ hpt).hasFDerivAt.comp_hasDerivAt_of_eq 0 hline (by simp)
  have hchain : HasDerivAt (fun s : ℝ => F (p + s • v, Φ (p + s • v, t)))
      (fderiv ℝ F (p, Φ (p, t)) (v, fderiv ℝ Φ (p, t) eP)) 0 :=
    hF.hasFDerivAt.comp_hasDerivAt_of_eq 0
      (by simpa only [one_smul, id_eq] using
        (((hasDerivAt_id (0 : ℝ)).smul_const v).const_add p).prodMk hPhiLine) (by simp)
  have hvalue := hright.unique hchain
  have hspatial : fderiv ℝ (fun q => Φ (q, t)) p v = fderiv ℝ Φ (p, t) eP := by
    rw [parameter_fderiv_eq_comp_inl (hdiff _ hpt)]
    rfl
  rwa [hsymm, hvalue, ← hspatial] at hleft

/-- Differentiation of a linear frame at a fixed parameter commutes with evaluation. -/
theorem fderiv_frame_apply {N : E → P →L[ℝ] E} {x : E}
    (hN : DifferentiableAt ℝ N x) (p : P) :
    fderiv ℝ (fun y => N y p) x = (fderiv ℝ N x).flip p := by
  simpa using (hN.hasFDerivAt.clm_apply (hasFDerivAt_const p x)).fderiv

/-- The differential of a frame with both its parameter and base point varying. -/
theorem fderiv_frame_joint_apply {N : E → P →L[ℝ] E} {x : E}
    (hN : DifferentiableAt ℝ N x) (p v : P) (w : E) :
    fderiv ℝ (fun q : P × E => N q.2 q.1) (p, x) (v, w) =
      N x v + fderiv ℝ (fun y => N y p) x w := by
  have hdN : HasFDerivAt (fun q : P × E => N q.2)
      ((fderiv ℝ N x).comp (ContinuousLinearMap.snd ℝ P E)) (p, x) :=
    hN.hasFDerivAt.comp (p, x) hasFDerivAt_snd
  have hd := hdN.clm_apply hasFDerivAt_fst
  rw [hd.fderiv, fderiv_frame_apply hN]
  rfl

/-- For a linear family of commuting fields, the parameter differential of its flow is
time multiplied by the corresponding field. The initial state is independent of the parameter.
Only smoothness on the visited open set and commutation along the orbit are needed. -/
theorem parameter_fderiv_eq_smul_of_lieBracket_zero
    {N : E → P →L[ℝ] E} {Φ : P × ℝ → E} {V : Set P} {s : Set E}
    {a b : ℝ} {p : P} {x₀ : E}
    (hV : IsOpen V) (hs : IsOpen s) (hN : ContDiffOn ℝ ∞ N s)
    (hΦ : ContDiffOn ℝ ∞ Φ (V ×ˢ Ioo a b))
    (hODE : ∀ q ∈ V ×ˢ Ioo a b,
      HasDerivAt (fun t => Φ (q.1, t)) (N (Φ q) q.1) q.2)
    (hinitial : ∀ q ∈ V, Φ (q, 0) = x₀)
    (hp : p ∈ V) (hzero : (0 : ℝ) ∈ Ioo a b)
    (hmem : ∀ t ∈ Ioo a b, Φ (p, t) ∈ s) (v : P)
    (hcomm : ∀ t ∈ Ioo a b,
      VectorField.lieBracket ℝ (fun y => N y p) (fun y => N y v) (Φ (p, t)) = 0) :
    ∀ t ∈ Ioo a b,
      fderiv ℝ (fun q => Φ (q, t)) p v = t • N (Φ (p, t)) v := by
  let A : ℝ → E →L[ℝ] E := fun t => fderiv ℝ (fun y => N y p) (Φ (p, t))
  let B : ℝ → E := fun t => N (Φ (p, t)) v
  have hNAt (t : ℝ) (ht : t ∈ Ioo a b) : ContDiffAt ℝ ∞ N (Φ (p, t)) :=
    hN.contDiffAt (hs.mem_nhds (hmem t ht))
  have hNd (t : ℝ) (ht : t ∈ Ioo a b) : DifferentiableAt ℝ N (Φ (p, t)) :=
    (hNAt t ht).differentiableAt (by simp)
  have hcurve (t : ℝ) (ht : t ∈ Ioo a b) :
      HasDerivAt (fun u => Φ (p, u)) (N (Φ (p, t)) p) t :=
    hODE (p, t) ⟨hp, ht⟩
  have hA : ContinuousOn A (Ioo a b) := by
    intro t ht
    have hNp : ContDiffAt ℝ ∞ (fun y => N y p) (Φ (p, t)) :=
      (hNAt t ht).clm_apply contDiffAt_const
    have hAc : ContinuousAt (fderiv ℝ (fun y => N y p)) (Φ (p, t)) :=
      hNp.continuousAt_fderiv (by simp)
    exact hAc.comp_continuousWithinAt (f := fun u : ℝ => Φ (p, u))
      (hcurve t ht).continuousAt.continuousWithinAt
  have hleft (t : ℝ) (ht : t ∈ Ioo a b) :
      HasDerivAt (fun u => fderiv ℝ (fun q => Φ (q, u)) p v)
        (A t (fderiv ℝ (fun q => Φ (q, t)) p v) + B t) t := by
    have hF : DifferentiableAt ℝ (fun q : P × E => N q.2 q.1) (p, Φ (p, t)) :=
      ((hNd t ht).comp (p, Φ (p, t)) differentiableAt_snd).clm_apply differentiableAt_fst
    have h := hasDerivAt_parameter_fderiv_of_ode (hV.prod isOpen_Ioo) hΦ hODE
      ⟨hp, ht⟩ hF v
    rw [fderiv_frame_joint_apply (hNd t ht)] at h
    simpa only [A, B, add_comm] using h
  have hright (t : ℝ) (ht : t ∈ Ioo a b) :
      HasDerivAt (fun u => u • B u) (A t (t • B t) + B t) t := by
    have hNv : DifferentiableAt ℝ (fun y => N y v) (Φ (p, t)) :=
      (hNd t ht).clm_apply (differentiableAt_const v)
    have hB := hNv.hasFDerivAt.comp_hasDerivAt t (hcurve t ht)
    have hc : fderiv ℝ (fun y => N y v) (Φ (p, t)) (N (Φ (p, t)) p) =
        A t (B t) := sub_eq_zero.mp (hcomm t ht)
    rw [hc] at hB
    have hB' : HasDerivAt B (A t (B t)) t := hB
    have hh := (hasDerivAt_id t).smul hB'
    change HasDerivAt (fun u : ℝ => u • B u) (t • A t (B t) + 1 • B t) t at hh
    simpa only [one_smul, map_smul, add_comm] using hh
  have hinit : (fun q => Φ (q, 0)) =ᶠ[𝓝 p] (fun _ => x₀) := by
    filter_upwards [hV.mem_nhds hp] with q hq
    exact hinitial q hq
  have heq : fderiv ℝ (fun q => Φ (q, 0)) p v = (0 : ℝ) • B 0 := by
    rw [hinit.fderiv_eq]
    simp
  exact inhomogLinearODE_unique_on_Ioo hzero hA hleft hright heq

end LieGroups.Analysis

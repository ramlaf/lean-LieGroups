import LieGroups.Analysis.FrobeniusChart
import LieGroups.Analysis.LocalSmoothExtension
import LieGroups.Analysis.ParametricCommutingFlows
import DifferentialGeometry.Analysis.ODE.TimeDependentFlow.SmoothDependence.Parameter

/-!
# Local charts from a commuting smooth frame

The parameterized ODE for the linear family of frame fields constructs a smooth
endpoint map. Commutation determines its parameter differential. Flowing a
transverse affine slice and applying the inverse function theorem then produces
local coordinates with the frame distribution as the horizontal distribution.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set Metric
open scoped Topology ContDiff

namespace LieGroups.Analysis

variable {E P Q : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P] [FiniteDimensional ℝ P]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q] [FiniteDimensional ℝ Q]

/-- A smooth commuting frame together with transverse linear coordinates gives
genuine local foliation coordinates. The flow and coordinate inverse are both
constructed in the proof. -/
theorem exists_foliationChart_of_commutingFrame
    {N : E → P →L[ℝ] E} {s : Set E} {x₀ : E}
    (hs : IsOpen s) (hx₀ : x₀ ∈ s) (hN : ContDiffOn ℝ ∞ N s)
    (hcomm : ∀ x ∈ s, ∀ u v : P,
      VectorField.lieBracket ℝ (fun y => N y u) (fun y => N y v) x = 0)
    (L : (P × Q) ≃L[ℝ] E) (hL : ∀ u : P, L (u, 0) = N x₀ u) :
    ∃ e : OpenPartialHomeomorph (P × Q) E,
      (0 : P × Q) ∈ e.source ∧ e 0 = x₀ ∧ e.target ⊆ s ∧
      ContDiffOn ℝ ∞ e e.source ∧ ContDiffOn ℝ ∞ e.symm e.target ∧
      ∀ x ∈ e.target,
        (LinearMap.range (N x).toLinearMap).map (fderiv ℝ e.symm x).toLinearMap =
          LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap := by
  obtain ⟨M, hM, hMN⟩ := exists_contDiff_eventuallyEq hs hx₀ hN
  obtain ⟨q, hqsub, hqopen, hxq⟩ := _root_.mem_nhds_iff.mp
    (Filter.inter_mem (hs.mem_nhds hx₀) hMN)
  have hqN (x : E) (hx : x ∈ q) : M x = N x := (hqsub hx).2
  have hqcomm (x : E) (hx : x ∈ q) (u v : P) :
      VectorField.lieBracket ℝ (fun y => M y u) (fun y => M y v) x = 0 := by
    have he (w : P) : (fun y => M y w) =ᶠ[𝓝 x] fun y => N y w := by
      filter_upwards [hqopen.mem_nhds hx] with y hy
      rw [hqN y hy]
    simp only [VectorField.lieBracket, (he u).fderiv_eq, (he v).fderiv_eq,
      (he u).self_of_nhds, (he v).self_of_nhds]
    exact hcomm x (hqsub hx).1 u v
  have hF : ContDiff ℝ ∞ (fun w : ℝ × P × E => M w.2.2 w.2.1) :=
    (hM.comp contDiff_snd.snd).clm_apply contDiff_snd.fst
  obtain ⟨ρP, ρE, ε, Φ, hρP, hρE, hε, hinit, hode, hΦ⟩ :=
    DifferentialGeometry.Analysis.ODE.exists_isLocalFlow_param_contDiffOn_top
      (f := fun _ p x => M x p) (t₀ := 0) (x₀ := x₀) (lam₀ := (0 : P)) hF
  simp only [zero_sub, zero_add] at hode hΦ
  let D := ball (0 : P) ρP ×ˢ ball x₀ ρE ×ˢ Ioo (-ε) ε
  have hD : IsOpen D := isOpen_ball.prod (isOpen_ball.prod isOpen_Ioo)
  have hcenter : (0, x₀, (0 : ℝ)) ∈ D :=
    ⟨mem_ball_self hρP, mem_ball_self hρE, by constructor <;> linarith⟩
  have hΦcenter : Φ (0, x₀, 0) = x₀ :=
    hinit 0 (mem_ball_self hρP) x₀ (mem_ball_self hρE)
  have hgood : D ∩ Φ ⁻¹' q ∈ 𝓝 (0, x₀, (0 : ℝ)) := by
    apply Filter.inter_mem (hD.mem_nhds hcenter)
    apply (hΦ.continuousOn.continuousAt (hD.mem_nhds hcenter)).preimage_mem_nhds
    rw [hΦcenter]
    exact hqopen.mem_nhds hxq
  obtain ⟨δ, hδ, hδsub⟩ := Metric.mem_nhds_iff.mp hgood
  have hsmall (p : P) (x : E) (t : ℝ)
      (hp : p ∈ ball 0 δ) (hx : x ∈ ball x₀ δ) (ht : t ∈ Ioo (-δ) δ) :
      (p, x, t) ∈ D ∧ Φ (p, x, t) ∈ q := by
    apply hδsub
    rw [← ball_prod_same, ← ball_prod_same]
    exact ⟨hp, hx, by simpa only [mem_ball, dist_zero_right, Real.norm_eq_abs,
      abs_lt, mem_Ioo] using ht⟩
  have hδzero : (0 : ℝ) ∈ Ioo (-δ) δ := by constructor <;> linarith
  have hpzero : (0 : P) ∈ ball 0 δ := mem_ball_self hδ
  have hxzero : x₀ ∈ ball x₀ δ := mem_ball_self hδ
  have hparam (p : P) (hp : p ∈ ball 0 δ) : p ∈ ball 0 ρP :=
    (hsmall p x₀ 0 hp hxzero hδzero).1.1
  have hstate (x : E) (hx : x ∈ ball x₀ δ) : x ∈ ball x₀ ρE :=
    (hsmall 0 x 0 hpzero hx hδzero).1.2.1
  have htime (t : ℝ) (ht : t ∈ Ioo (-δ) δ) : t ∈ Ioo (-ε) ε :=
    (hsmall 0 x₀ t hpzero hxzero ht).1.2.2
  have hΦslice (x : E) (hx : x ∈ ball x₀ δ) :
      ContDiffOn ℝ ∞ (fun w : P × ℝ => Φ (w.1, x, w.2))
        (ball 0 δ ×ˢ Ioo (-δ) δ) := by
    apply hΦ.comp ((contDiff_fst.prodMk (contDiff_const.prodMk contDiff_snd)).contDiffOn)
    intro w hw
    exact (hsmall w.1 x w.2 hw.1 hx hw.2).1
  have hΦzero (x : E) (hx : x ∈ ball x₀ δ) (t : ℝ) (ht : t ∈ Ioo (-δ) δ) :
      Φ (0, x, t) = x := by
    have hd (u : ℝ) (hu : u ∈ Ioo (-δ) δ) :
        HasDerivAt (fun u => Φ (0, x, u)) 0 u := by
      simpa only [map_zero] using hode 0 (hparam 0 hpzero) x (hstate x hx) u (htime u hu)
    have hh := isOpen_Ioo.is_const_of_deriv_eq_zero (convex_Ioo (-δ) δ).isPreconnected
      (fun u hu => (hd u hu).differentiableAt.differentiableWithinAt)
      (fun u hu => (hd u hu).deriv) ht hδzero
    rw [hh, hinit 0 (hparam 0 hpzero) x (hstate x hx)]
  let τ : ℝ := δ / 2
  have hτ : 0 < τ := by dsimp [τ]; positivity
  have hτmem : τ ∈ Ioo (-δ) δ := by dsimp [τ]; constructor <;> linarith
  let a : Q → E := fun z => x₀ + L (0, z)
  let ψ : P × Q → E := fun p => Φ (p.1, a p.2, τ)
  let U : Set (P × Q) := ball 0 δ ×ˢ (a ⁻¹' ball x₀ δ)
  have ha : ContDiff ℝ ∞ a :=
    contDiff_const.add (L.contDiff.comp (contDiff_const.prodMk contDiff_id))
  have ha0 : a 0 = x₀ := by simp [a]
  have hU : IsOpen U := isOpen_ball.prod (isOpen_ball.preimage ha.continuous)
  have h0U : (0 : P × Q) ∈ U := by
    refine ⟨hpzero, ?_⟩
    change a 0 ∈ ball x₀ δ
    rwa [ha0]
  have hψ : ContDiffOn ℝ ∞ ψ U := by
    apply hΦ.comp
      ((contDiff_fst.prodMk ((ha.comp contDiff_snd).prodMk contDiff_const)).contDiffOn)
    intro p hp
    exact (hsmall p.1 (a p.2) τ hp.1 hp.2 hτmem).1
  have hψq (p : P × Q) (hp : p ∈ U) : ψ p ∈ q :=
    (hsmall p.1 (a p.2) τ hp.1 hp.2 hτmem).2
  have hψzero : ψ 0 = x₀ := by
    change Φ (0, a 0, τ) = x₀
    rw [ha0]
    exact hΦzero x₀ hxzero τ hτmem
  have hψdiff (p : P × Q) (hp : p ∈ U) : DifferentiableAt ℝ ψ p :=
    (hψ.contDiffAt (hU.mem_nhds hp)).differentiableAt (by simp)
  have hhor (p : P × Q) (hp : p ∈ U) (v : P) :
      fderiv ℝ ψ p (v, 0) = τ • N (ψ p) v := by
    have hpar := parameter_fderiv_eq_smul_of_lieBracket_zero
      isOpen_ball hqopen (hM.contDiffOn : ContDiffOn ℝ ∞ M q)
      (hΦslice (a p.2) hp.2)
      (fun w hw => hode w.1 (hparam w.1 hw.1) (a p.2) (hstate (a p.2) hp.2)
        w.2 (htime w.2 hw.2))
      (fun u hu => hinit u (hparam u hu) (a p.2) (hstate (a p.2) hp.2))
      hp.1 hδzero
      (fun t ht => (hsmall p.1 (a p.2) t hp.1 hp.2 ht).2) v
      (fun t ht => hqcomm _ (hsmall p.1 (a p.2) t hp.1 hp.2 ht).2 p.1 v)
      τ hτmem
    have hd : HasFDerivAt (fun u => ψ (u, p.2))
        ((fderiv ℝ ψ p).comp (ContinuousLinearMap.inl ℝ P Q)) p.1 := by
      simpa only [Function.comp_def] using (hψdiff p hp).hasFDerivAt.comp p.1
        (hasFDerivAt_prodMk_left (𝕜 := ℝ) p.1 p.2)
    have heq := congrArg (fun A : P →L[ℝ] E => A v) hd.fderiv
    change fderiv ℝ (fun u => Φ (u, a p.2, τ)) p.1 v = fderiv ℝ ψ p (v, 0) at heq
    rw [← heq, hpar, hqN _ (hψq p hp)]
  have hinitial : (fun z : Q => ψ (0, z)) =ᶠ[𝓝 0] a := by
    have hn : ∀ᶠ z in 𝓝 (0 : Q), a z ∈ ball x₀ δ := by
      apply ha.continuous.continuousAt.preimage_mem_nhds
      rw [ha0]
      exact ball_mem_nhds _ hδ
    filter_upwards [hn] with z hz
    exact hΦzero (a z) hz τ hτmem
  have haDeriv : HasFDerivAt a
      ((L : (P × Q) →L[ℝ] E).comp (ContinuousLinearMap.inr ℝ P Q)) 0 :=
    ((L : (P × Q) →L[ℝ] E).hasFDerivAt.comp 0
      (hasFDerivAt_prodMk_right (0 : P) (0 : Q))).const_add x₀
  have hvertical : (fderiv ℝ ψ 0).comp (ContinuousLinearMap.inr ℝ P Q) =
      (L : (P × Q) →L[ℝ] E).comp (ContinuousLinearMap.inr ℝ P Q) :=
    ((hψdiff 0 h0U).hasFDerivAt.comp 0
      (hasFDerivAt_prodMk_right (0 : P) (0 : Q))).unique
        (haDeriv.congr_of_eventuallyEq hinitial)
  let scale : P ≃L[ℝ] P := (LinearEquiv.smulOfNeZero ℝ P τ hτ.ne').toContinuousLinearEquiv
  let Lτ : (P × Q) ≃L[ℝ] E := (scale.prodCongr (ContinuousLinearEquiv.refl ℝ Q)).trans L
  have hLτ (u : P) (z : Q) : Lτ (u, z) = L (τ • u, z) := rfl
  have hDψ : fderiv ℝ ψ 0 = (Lτ : (P × Q) →L[ℝ] E) := by
    apply ContinuousLinearMap.ext
    rintro ⟨u, z⟩
    have hz := congrArg (fun A : Q →L[ℝ] E => A z) hvertical
    change fderiv ℝ ψ 0 (0, z) = L (0, z) at hz
    have hu := hhor 0 h0U u
    rw [hψzero, ← hL u] at hu
    rw [show (u, z) = (u, 0) + (0, z) by simp, map_add, hu, hz]
    simp only [Prod.mk_add_mk, add_zero, zero_add]
    change τ • L (u, 0) + L (0, z) = Lτ (u, z)
    rw [hLτ, ← map_smul, ← map_add]
    congr 1
    simp
  have hdψ : HasFDerivAt ψ (Lτ : (P × Q) →L[ℝ] E) 0 :=
    hDψ ▸ (hψdiff 0 h0U).hasFDerivAt
  obtain ⟨e, he0, hesub, heq, he, hei, hehor⟩ :=
    exists_foliationChart_of_horizontalEndpoint hτ.ne' hU h0U hψ Lτ hdψ hhor
  refine ⟨e, he0, by rw [heq, hψzero], ?_, he, hei, hehor⟩
  intro x hx
  have hh := (hqsub (hψq (e.symm x) (hesub (e.map_target hx)))).1
  rwa [← heq (e.symm x), e.right_inv hx] at hh

/-- Local Frobenius theorem for a finite-dimensional smooth frame. Injectivity
is needed at the base point only; the projection, normalization, transverse
space, ODE solutions, and smooth local inverse are all constructed. -/
theorem exists_foliationChart_of_involutiveFrame
    {B : E → P →L[ℝ] E} {s : Set E} {x₀ : E}
    (hs : IsOpen s) (hx₀ : x₀ ∈ s) (hB : ContDiffOn ℝ ∞ B s)
    (hinj : Function.Injective (B x₀))
    (hInv : ∀ y ∈ s, ∀ V W : E → E,
      ContDiffAt ℝ ∞ V y → ContDiffAt ℝ ∞ W y →
      (∀ᶠ z in 𝓝 y, V z ∈ LinearMap.range (B z).toLinearMap) →
      (∀ᶠ z in 𝓝 y, W z ∈ LinearMap.range (B z).toLinearMap) →
      VectorField.lieBracket ℝ V W y ∈ LinearMap.range (B y).toLinearMap) :
    ∃ (T : Submodule ℝ E) (e : OpenPartialHomeomorph (P × T) E),
      (0 : P × T) ∈ e.source ∧ e 0 = x₀ ∧ e.target ⊆ s ∧
      ContDiffOn ℝ ∞ e e.source ∧ ContDiffOn ℝ ∞ e.symm e.target ∧
      ∀ x ∈ e.target,
        (LinearMap.range (B x).toLinearMap).map (fderiv ℝ e.symm x).toLinearMap =
          LinearMap.range (ContinuousLinearMap.inl ℝ P T).toLinearMap := by
  obtain ⟨π, hπ⟩ := exists_projection_of_injective_frame (B x₀) hinj
  have hi : (π.comp (B x₀)).IsInvertible := by
    rw [hπ]
    exact ⟨ContinuousLinearEquiv.refl ℝ P, rfl⟩
  obtain ⟨U, hU, hxU, hUs, hN, hproj, hrange, hcomm⟩ :=
    exists_open_normalized_commutingFrame hs hx₀ hB hi hInv
  have hproj0 : π.comp (normalizedFrame B π x₀) = ContinuousLinearMap.id ℝ P := by
    ext v
    exact hproj x₀ hxU v
  obtain ⟨L, hL, _⟩ := exists_prod_equiv_of_projection
    (normalizedFrame B π x₀) π hproj0
  obtain ⟨e, he0, heval, hetarget, he, hei, hehor⟩ :=
    exists_foliationChart_of_commutingFrame hU hxU hN hcomm L hL
  refine ⟨LinearMap.ker π.toLinearMap, e, he0, heval, hetarget.trans hUs, he, hei, ?_⟩
  intro x hx
  rw [← hrange x (hetarget hx)]
  exact hehor x hx

end LieGroups.Analysis

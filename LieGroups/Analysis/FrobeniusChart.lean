import LieGroups.Analysis.FrobeniusFrame
import LieGroups.Manifold.SubmersionDifferential
import Mathlib.Geometry.Manifold.LocalDiffeomorph

/-!
# Converting a horizontal endpoint map into local foliation coordinates

These lemmas apply the inverse function theorem to a smooth endpoint map and
identify the distribution in the resulting coordinates. The endpoint map and its
horizontal derivative identity are inputs here; the ODE construction of that map
is separate.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set
open scoped Topology ContDiff Manifold

namespace LieGroups.Analysis

variable {E P Q : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P]
  [NormedAddCommGroup Q] [NormedSpace ℝ Q]

/-- The differential of the inverse of a smooth coordinate map sends a frame
to horizontal vectors when the forward differential has the specified frame as
its horizontal part. -/
theorem fderiv_symm_map_frame_eq_horizontal
    (e : OpenPartialHomeomorph (P × Q) E) (N : E → P →L[ℝ] E)
    {c : ℝ} (hc : c ≠ 0)
    (he : ContDiffOn ℝ ∞ e e.source) (heinv : ContDiffOn ℝ ∞ e.symm e.target)
    (hhor : ∀ p ∈ e.source, ∀ v : P,
      fderiv ℝ e p (v, 0) = c • N (e p) v)
    {x : E} (hx : x ∈ e.target) :
    (LinearMap.range (N x).toLinearMap).map (fderiv ℝ e.symm x).toLinearMap =
      LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap := by
  have hp : e.symm x ∈ e.source := e.map_target hx
  have hd := (he.contDiffAt (e.open_source.mem_nhds hp)).differentiableAt (by simp)
  have hdi := (heinv.contDiffAt (e.open_target.mem_nhds hx)).differentiableAt (by simp)
  have hid : (fun p => e.symm (e p)) =ᶠ[𝓝 (e.symm x)] id :=
    e.eventually_left_inverse hp
  have hcomp : (fderiv ℝ e.symm x).comp (fderiv ℝ e (e.symm x)) =
      ContinuousLinearMap.id ℝ (P × Q) := by
    have hdi' : HasFDerivAt e.symm (fderiv ℝ e.symm x) (e (e.symm x)) := by
      simpa only [e.right_inv hx] using hdi.hasFDerivAt
    have hh := hdi'.comp (e.symm x) hd.hasFDerivAt
    exact hh.unique ((hasFDerivAt_id (e.symm x)).congr_of_eventuallyEq hid)
  have hinv (v : P) : fderiv ℝ e.symm x (N x v) = (c⁻¹ • v, 0) := by
    have hh := congrArg (fun A : (P × Q) →L[ℝ] (P × Q) => A (c⁻¹ • v, 0)) hcomp
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at hh
    simp only [hhor _ hp, e.right_inv hx, map_smul, smul_smul, mul_inv_cancel₀ hc,
      one_smul] at hh
    exact hh
  ext w
  constructor
  · rintro ⟨_, ⟨v, rfl⟩, rfl⟩
    exact ⟨c⁻¹ • v, (hinv v).symm⟩
  · rintro ⟨v, rfl⟩
    refine ⟨N x (c • v), ⟨c • v, rfl⟩, ?_⟩
    change fderiv ℝ e.symm x (N x (c • v)) = (v, 0)
    simp only [hinv, smul_smul, inv_mul_cancel₀ hc, one_smul]

/-- The inverse function theorem turns a smooth horizontal endpoint map into
local coordinates. Both directions of the resulting coordinates are smooth,
and the differential carries the frame range exactly onto the horizontal space. -/
theorem exists_foliationChart_of_horizontalEndpoint
    [CompleteSpace (P × Q)] {f : P × Q → E} {N : E → P →L[ℝ] E}
    {s : Set (P × Q)} {c : ℝ} (hc : c ≠ 0)
    (hs : IsOpen s) (hzero : (0 : P × Q) ∈ s) (hf : ContDiffOn ℝ ∞ f s)
    (L : (P × Q) ≃L[ℝ] E) (hL : HasFDerivAt f (L : (P × Q) →L[ℝ] E) 0)
    (hhor : ∀ p ∈ s, ∀ v : P, fderiv ℝ f p (v, 0) = c • N (f p) v) :
    ∃ e : OpenPartialHomeomorph (P × Q) E,
      (0 : P × Q) ∈ e.source ∧ e.source ⊆ s ∧
      (∀ p, e p = f p) ∧ ContDiffOn ℝ ∞ e e.source ∧
      ContDiffOn ℝ ∞ e.symm e.target ∧
      ∀ x ∈ e.target,
        (LinearMap.range (N x).toLinearMap).map (fderiv ℝ e.symm x).toLinearMap =
          LinearMap.range (ContinuousLinearMap.inl ℝ P Q).toLinearMap := by
  obtain ⟨e, hezero, hesub, heq, he, hei⟩ :=
    Manifold.exists_contDiffOn_localInverse hs hzero hf L hL (by simp)
  refine ⟨e, hezero, hesub, heq, he, hei, ?_⟩
  apply fun x hx => fderiv_symm_map_frame_eq_horizontal e N hc he hei ?_ hx
  intro p hp v
  have hfun : (e : (P × Q) → E) = f := funext heq
  rw [hfun]
  exact hhor p (hesub hp) v

end LieGroups.Analysis

import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.Analysis.SpecificLimits.Basic
import Mathlib.Topology.Sequences

/-!
# Excluding transverse accumulation from limiting directions

In finite dimension, if every limiting direction of a set at zero lies in `P`,
then a complementary subspace `Q` meets the set only at zero in a neighborhood.
This is the compactness step in the closed-subgroup theorem.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Filter Set
open scoped Topology

namespace LieGroups.Analysis

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- Limiting normalized directions exclude nonzero transverse points near zero. -/
theorem exists_ball_inter_submodule_eq_zero_of_direction_limits
    (P Q : Submodule ℝ E) (hPQ : Disjoint P Q) (s : Set E)
    (hdir : ∀ (u : ℕ → E) (v : E), (∀ n, u n ∈ s) → (∀ n, u n ≠ 0) →
      Tendsto u atTop (𝓝 0) →
      Tendsto (fun n => ‖u n‖⁻¹ • u n) atTop (𝓝 v) → v ∈ P) :
    ∃ ε > 0, ∀ x ∈ Q, ‖x‖ < ε → x ∈ s → x = 0 := by
  by_contra! h
  have hex (n : ℕ) : ∃ x : E, x ∈ Q ∧ ‖x‖ < 1 / ((n : ℝ) + 1) ∧ x ∈ s ∧ x ≠ 0 :=
    h (1 / ((n : ℝ) + 1)) (by positivity)
  choose u huQ huNorm hus hu0 using hex
  have hu : Tendsto u atTop (𝓝 0) := by
    apply squeeze_zero_norm (fun n => (huNorm n).le)
    exact tendsto_one_div_add_atTop_nhds_zero_nat
  have hunit (n : ℕ) : ‖‖u n‖⁻¹ • u n‖ = 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr (hu0 n))]
  obtain ⟨v, hv, φ, hφ, hvlim⟩ := (isCompact_sphere (0 : E) 1).tendsto_subseq
    (fun n => show ‖u n‖⁻¹ • u n ∈ Metric.sphere (0 : E) 1 by
      simpa only [Metric.mem_sphere, dist_zero_right] using hunit n)
  have hvQ : v ∈ Q := Q.closed_of_finiteDimensional.mem_of_tendsto hvlim
    (Eventually.of_forall (fun n => Q.smul_mem _ (huQ (φ n))))
  have hvP : v ∈ P := hdir (u ∘ φ) v (fun n => hus (φ n)) (fun n => hu0 (φ n))
    (hu.comp hφ.tendsto_atTop) hvlim
  have hv0 : v = 0 := (Submodule.disjoint_def.mp hPQ) v hvP hvQ
  simp [hv0] at hv

end LieGroups.Analysis

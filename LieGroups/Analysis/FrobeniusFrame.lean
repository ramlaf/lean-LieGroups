import Mathlib.Analysis.Calculus.ContDiff.Operations
import Mathlib.Analysis.Calculus.VectorField
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.LinearAlgebra.Basis.VectorSpace

/-!
# Normalizing an involutive frame

A fixed projection which is invertible on a smooth frame at one point stays
invertible nearby. Composing the frame with the inverse of its projected matrix
gives a frame whose projection is constant. Involutivity then forces its fields
to commute. This is the normalization step in the local Frobenius construction;
the hypotheses here do not include integral manifolds or adapted charts.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Set
open scoped Topology ContDiff

namespace LieGroups.Analysis

variable {E P : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P]

/-- An injective frame in finite dimension has a continuous linear left inverse;
thus a suitable fixed projection is constructed from the frame itself. -/
theorem exists_projection_of_injective_frame [FiniteDimensional ℝ E]
    (B : P →L[ℝ] E) (hB : Function.Injective B) :
    ∃ π : E →L[ℝ] P, π.comp B = ContinuousLinearMap.id ℝ P := by
  obtain ⟨r, hr⟩ := B.toLinearMap.exists_leftInverse_of_injective
    (LinearMap.ker_eq_bot.mpr hB)
  exact ⟨r.toContinuousLinearMap, DFunLike.ext _ _ fun v => congrArg (fun f => f v) hr⟩

/-- A linear section of a projection supplies transverse coordinates in its
kernel. This constructs the complementary model space used by the flow chart. -/
theorem exists_prod_equiv_of_projection [FiniteDimensional ℝ E]
    [FiniteDimensional ℝ P] (B : P →L[ℝ] E) (π : E →L[ℝ] P)
    (h : π.comp B = ContinuousLinearMap.id ℝ P) :
    ∃ L : (P × LinearMap.ker π.toLinearMap) ≃L[ℝ] E,
      (∀ p, L (p, 0) = B p) ∧ (∀ z, L (0, z) = (z : E)) := by
  have hπ (p : P) : π (B p) = p := congrArg (fun A : P →L[ℝ] P => A p) h
  let A : (P × LinearMap.ker π.toLinearMap) →ₗ[ℝ] E := {
    toFun := fun p => B p.1 + p.2
    map_add' := by
      intros
      simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, map_add]
      abel
    map_smul' := by intros; simp [smul_add]
  }
  have hA : Function.Bijective A := by
    constructor
    · intro p q hpq
      have hp : π (p.2 : E) = 0 := p.2.property
      have hq : π (q.2 : E) = 0 := q.2.property
      have hp₁ : p.1 = q.1 := by
        have hh := congrArg π hpq
        simpa only [A, LinearMap.coe_mk, AddHom.coe_mk, map_add, hπ, hp, hq,
          add_zero] using hh
      apply Prod.ext hp₁
      apply Subtype.ext
      change B p.1 + (p.2 : E) = B q.1 + (q.2 : E) at hpq
      rw [hp₁] at hpq
      exact add_left_cancel hpq
    · intro x
      refine ⟨(π x, ⟨x - B (π x), ?_⟩), ?_⟩
      · change π (x - B (π x)) = 0
        simp [hπ]
      · change B (π x) + (x - B (π x)) = x
        abel
  refine ⟨(LinearEquiv.ofBijective A hA).toContinuousLinearEquiv, ?_, ?_⟩
  · intro p
    change B p + (0 : E) = B p
    simp
  · intro z
    change B 0 + (z : E) = (z : E)
    simp

/-- A frame normalized by a fixed projection. Its useful properties hold where
the projection restricted to the original frame is invertible. -/
noncomputable def normalizedFrame (B : E → P →L[ℝ] E) (π : E →L[ℝ] P)
    (x : E) : P →L[ℝ] E :=
  (B x).comp (π.comp (B x)).inverse

/-- The normalized frame projects to the identity. -/
theorem normalizedFrame_projection (B : E → P →L[ℝ] E) (π : E →L[ℝ] P)
    {x : E} (h : (π.comp (B x)).IsInvertible) (v : P) :
    π (normalizedFrame B π x v) = v := by
  exact h.self_apply_inverse v

/-- Normalization preserves the subspace spanned by the frame. -/
theorem normalizedFrame_range (B : E → P →L[ℝ] E) (π : E →L[ℝ] P)
    {x : E} (h : (π.comp (B x)).IsInvertible) :
    LinearMap.range (normalizedFrame B π x).toLinearMap =
      LinearMap.range (B x).toLinearMap := by
  ext w
  constructor
  · rintro ⟨v, rfl⟩
    exact ⟨(π.comp (B x)).inverse v, rfl⟩
  · rintro ⟨v, rfl⟩
    refine ⟨π (B x v), ?_⟩
    change B x ((π.comp (B x)).inverse ((π.comp (B x)) v)) = B x v
    rw [h.inverse_apply_self]

/-- The fixed projection is injective on the frame range. -/
theorem eq_zero_of_mem_frame_range_of_projection_eq_zero
    (B : P →L[ℝ] E) (π : E →L[ℝ] P) (h : (π.comp B).IsInvertible)
    {w : E} (hw : w ∈ LinearMap.range B.toLinearMap) (hπw : π w = 0) :
    w = 0 := by
  obtain ⟨v, rfl⟩ := hw
  have hv : v = 0 := h.injective (by simpa using hπw)
  simp [hv]

/-- Normalization is smooth wherever the projected frame is invertible. -/
theorem contDiffAt_normalizedFrame [CompleteSpace P]
    {B : E → P →L[ℝ] E} {π : E →L[ℝ] P} {x : E}
    (hB : ContDiffAt ℝ ∞ B x) (h : (π.comp (B x)).IsInvertible) :
    ContDiffAt ℝ ∞ (normalizedFrame B π) x := by
  have hp : ContDiffAt ℝ ∞ (fun y => π.comp (B y)) x :=
    contDiffAt_const.clm_comp hB
  have hi' : ContDiffAt ℝ ∞
      (ContinuousLinearMap.inverse : (P →L[ℝ] P) → (P →L[ℝ] P)) (π.comp (B x)) :=
    h.contDiffAt_map_inverse
  have hi : ContDiffAt ℝ ∞ (fun y => (π.comp (B y)).inverse) x :=
    by simpa only [Function.comp_def] using hi'.comp x hp
  exact hB.clm_comp hi

/-- Invertibility of the projected frame persists near the basepoint. -/
theorem eventually_isInvertible_projectedFrame [CompleteSpace P]
    {B : E → P →L[ℝ] E} {π : E →L[ℝ] P} {x : E}
    (hB : ContinuousAt B x) (h : (π.comp (B x)).IsInvertible) :
    ∀ᶠ y in 𝓝 x, (π.comp (B y)).IsInvertible := by
  have ho : IsOpen {A : P →L[ℝ] P | A.IsInvertible} :=
    ContinuousLinearEquiv.isOpen
  exact (continuousAt_const.clm_comp hB) (ho.mem_nhds h)

/-- If a projected field is locally constant, every directional derivative of
the field has zero projection. -/
theorem projection_fderiv_eq_zero {V : E → E} (π : E →L[ℝ] P)
    {x : E} {v : P} (hV : DifferentiableAt ℝ V x)
    (hπV : (fun y => π (V y)) =ᶠ[𝓝 x] fun _ => v) (w : E) :
    π (fderiv ℝ V x w) = 0 := by
  have hd : HasFDerivAt (fun y => π (V y)) (π.comp (fderiv ℝ V x)) x :=
    π.hasFDerivAt.comp x hV.hasFDerivAt
  have heq : π.comp (fderiv ℝ V x) = 0 :=
    hd.unique ((hasFDerivAt_const v x).congr_of_eventuallyEq hπV)
  exact congrArg (fun A : E →L[ℝ] P => A w) heq

/-- Involutivity and constant projection imply commutation of the normalized
fields. Membership of arbitrary local smooth sections is the only bracket
hypothesis. -/
theorem lieBracket_normalizedFrame_eq_zero [CompleteSpace P]
    {B : E → P →L[ℝ] E} {π : E →L[ℝ] P} {x : E}
    (hB : ContDiffAt ℝ ∞ B x) (h : (π.comp (B x)).IsInvertible)
    (hInv : ∀ V W : E → E, ContDiffAt ℝ ∞ V x → ContDiffAt ℝ ∞ W x →
      (∀ᶠ y in 𝓝 x, V y ∈ LinearMap.range (B y).toLinearMap) →
      (∀ᶠ y in 𝓝 x, W y ∈ LinearMap.range (B y).toLinearMap) →
      VectorField.lieBracket ℝ V W x ∈ LinearMap.range (B x).toLinearMap)
    (u v : P) :
    VectorField.lieBracket ℝ (fun y => normalizedFrame B π y u)
      (fun y => normalizedFrame B π y v) x = 0 := by
  have hN := contDiffAt_normalizedFrame hB h
  have hu : ContDiffAt ℝ ∞ (fun y => normalizedFrame B π y u) x :=
    hN.clm_apply contDiffAt_const
  have hv : ContDiffAt ℝ ∞ (fun y => normalizedFrame B π y v) x :=
    hN.clm_apply contDiffAt_const
  have hi := eventually_isInvertible_projectedFrame hB.continuousAt h
  have hmem (w : P) : ∀ᶠ y in 𝓝 x,
      normalizedFrame B π y w ∈ LinearMap.range (B y).toLinearMap :=
    Filter.Eventually.of_forall fun y => ⟨(π.comp (B y)).inverse w, rfl⟩
  apply eq_zero_of_mem_frame_range_of_projection_eq_zero (B x) π h
    (hInv _ _ hu hv (hmem u) (hmem v))
  have hp (w : P) : (fun y => π (normalizedFrame B π y w)) =ᶠ[𝓝 x] fun _ => w :=
    hi.mono fun y hy => normalizedFrame_projection B π hy w
  rw [VectorField.lieBracket, map_sub,
    projection_fderiv_eq_zero π (hv.differentiableAt (by simp)) (hp v),
    projection_fderiv_eq_zero π (hu.differentiableAt (by simp)) (hp u), sub_self]

/-- A smooth involutive frame can be normalized on an open neighborhood of any
point where a fixed projection is invertible on the frame. -/
theorem exists_open_normalized_commutingFrame [CompleteSpace P]
    {B : E → P →L[ℝ] E} {π : E →L[ℝ] P} {s : Set E} {x : E}
    (hs : IsOpen s) (hx : x ∈ s) (hB : ContDiffOn ℝ ∞ B s)
    (h : (π.comp (B x)).IsInvertible)
    (hInv : ∀ y ∈ s, ∀ V W : E → E,
      ContDiffAt ℝ ∞ V y → ContDiffAt ℝ ∞ W y →
      (∀ᶠ z in 𝓝 y, V z ∈ LinearMap.range (B z).toLinearMap) →
      (∀ᶠ z in 𝓝 y, W z ∈ LinearMap.range (B z).toLinearMap) →
      VectorField.lieBracket ℝ V W y ∈ LinearMap.range (B y).toLinearMap) :
    ∃ U : Set E, IsOpen U ∧ x ∈ U ∧ U ⊆ s ∧
      ContDiffOn ℝ ∞ (normalizedFrame B π) U ∧
      (∀ y ∈ U, ∀ v : P, π (normalizedFrame B π y v) = v) ∧
      (∀ y ∈ U, LinearMap.range (normalizedFrame B π y).toLinearMap =
        LinearMap.range (B y).toLinearMap) ∧
      ∀ y ∈ U, ∀ u v : P,
        VectorField.lieBracket ℝ (fun z => normalizedFrame B π z u)
          (fun z => normalizedFrame B π z v) y = 0 := by
  have hi := eventually_isInvertible_projectedFrame
    ((hB x hx).contDiffAt (hs.mem_nhds hx)).continuousAt h
  obtain ⟨U, hUsub, hUopen, hxU⟩ := mem_nhds_iff.mp (Filter.inter_mem (hs.mem_nhds hx) hi)
  have hUs : U ⊆ s := fun y hy => (hUsub hy).1
  have hUi (y : E) (hy : y ∈ U) : (π.comp (B y)).IsInvertible := (hUsub hy).2
  refine ⟨U, hUopen, hxU, hUs, ?_, ?_, ?_, ?_⟩
  · intro y hy
    exact (contDiffAt_normalizedFrame
      ((hB y (hUs hy)).contDiffAt (hs.mem_nhds (hUs hy))) (hUi y hy)).contDiffWithinAt
  · exact fun y hy v => normalizedFrame_projection B π (hUi y hy) v
  · exact fun y hy => normalizedFrame_range B π (hUi y hy)
  · intro y hy u v
    exact lieBracket_normalizedFrame_eq_zero
      ((hB y (hUs hy)).contDiffAt (hs.mem_nhds (hUs hy))) (hUi y hy)
      (hInv y (hUs hy)) u v

end LieGroups.Analysis

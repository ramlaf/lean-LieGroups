import Mathlib.Analysis.Calculus.BumpFunction.FiniteDimension

/-!
# Global smooth extensions near one point

Multiplying a function on an open set by a smooth cutoff gives a globally smooth
function agreeing with it near any chosen point. This is used to pass coordinate
vector fields to ODE theorems stated for globally smooth fields.

AI-assistance disclosure: generated by OpenAI Codex on 2026-09-29.
-/

open Set Filter Metric
open scoped Topology ContDiff

namespace LieGroups.Analysis

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [HasContDiffBump E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- A smooth function on an open set has a globally smooth extension of its germ at each point.
Finite-dimensional real normed spaces satisfy `HasContDiffBump` automatically. -/
theorem exists_contDiff_eventuallyEq {f : E → F} {s : Set E} {x : E}
    (hs : IsOpen s) (hx : x ∈ s) (hf : ContDiffOn ℝ ∞ f s) :
    ∃ g : E → F, ContDiff ℝ ∞ g ∧ g =ᶠ[𝓝 x] f := by
  obtain ⟨ε, hε, hsub⟩ := Metric.mem_nhds_iff.mp (hs.mem_nhds hx)
  let c : ContDiffBump x :=
    { rIn := ε / 4
      rOut := ε / 2
      rIn_pos := by positivity
      rIn_lt_rOut := by linarith }
  have hc : tsupport c ⊆ s := by
    rw [c.tsupport_eq]
    exact (closedBall_subset_ball (by dsimp [c]; linarith)).trans hsub
  refine ⟨fun y => c y • f y, ?_, ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ s
    · exact c.contDiff.contDiffAt.smul ((hf y hy).contDiffAt (hs.mem_nhds hy))
    · have hn : y ∉ tsupport c := fun h => hy (hc h)
      apply (contDiffAt_const (c := (0 : F))).congr_of_eventuallyEq
      filter_upwards [(isClosed_tsupport c).isOpen_compl.mem_nhds hn] with z hz
      simp only [image_eq_zero_of_notMem_tsupport hz, zero_smul]
  · filter_upwards [c.eventuallyEq_one] with y hy
    simp only [hy, Pi.one_apply, one_smul]

end LieGroups.Analysis

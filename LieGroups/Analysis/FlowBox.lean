import LieGroups.Analysis.LocalSmoothExtension
import LieGroups.Manifold.SubmersionDifferential
import Mathlib.LinearAlgebra.Dual.Lemmas
import DifferentialGeometry.Analysis.ODE.TimeDependentFlow.SmoothInSpace.VariationalODE.BanachIC

/-!
# Smooth local straightening of a nonvanishing vector field

A nonzero vector field at the base point determines a linear splitting with that first
coordinate vector. Flowing a transverse affine slice gives local coordinates in which that
coordinate direction is the field. The flow is constructed from the smooth ODE existence
theorem; the inverse function theorem constructs the coordinate inverse. A version with a
prescribed splitting retains the full initial coordinate differential.

The splitting is constructed by finite-dimensional linear algebra. The nonvanishing-field
theorem requires no supplied flow or integral manifold.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter Set Metric
open scoped ContDiff Topology

namespace LieGroups.Analysis

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F]
  [FiniteDimensional ℝ F]

local instance : CompleteSpace E := FiniteDimensional.complete ℝ E
local instance : CompleteSpace F := FiniteDimensional.complete ℝ F

/-- A nonzero vector in a finite-dimensional real normed space can be chosen as the first
coordinate vector, with a subspace supplying the transverse coordinates. -/
theorem exists_prod_equiv_of_ne_zero {v : E} (hv : v ≠ 0) :
    ∃ (S : Submodule ℝ E) (L : (ℝ × S) ≃L[ℝ] E), L (1, 0) = v := by
  obtain ⟨f, hf⟩ := Module.Projective.exists_dual_eq_one ℝ hv
  let A : (ℝ × LinearMap.ker f) →ₗ[ℝ] E := {
    toFun := fun p => p.1 • v + p.2
    map_add' := by
      intro p q
      simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, add_smul]
      abel
    map_smul' := by
      intro t p
      simp [smul_add, smul_smul]
  }
  have hA : Function.Bijective A := by
    constructor
    · intro p q hpq
      have hp : f (p.2 : E) = 0 := p.2.property
      have hq : f (q.2 : E) = 0 := q.2.property
      have ht : p.1 = q.1 := by
        have h := congrArg f hpq
        simpa only [A, LinearMap.coe_mk, AddHom.coe_mk, map_add, map_smul,
          hf, hp, hq, smul_eq_mul, mul_one, add_zero] using h
      apply Prod.ext ht
      apply Subtype.ext
      change p.1 • v + (p.2 : E) = q.1 • v + (q.2 : E) at hpq
      rw [ht] at hpq
      exact add_left_cancel hpq
    · intro x
      refine ⟨(f x, ⟨x - f x • v, ?_⟩), ?_⟩
      · change f (x - f x • v) = 0
        simp [hf]
      · change f x • v + (x - f x • v) = x
        abel
  refine ⟨LinearMap.ker f, (LinearEquiv.ofBijective A hA).toContinuousLinearEquiv, ?_⟩
  change (1 : ℝ) • v + (0 : E) = v
  simp

/-- A smooth vector field admits a smooth local flow box with prescribed initial linear
coordinates. The first coordinate vector is carried to the field at every point of the
coordinate domain, and the entire target lies in the original open set. -/
theorem exists_contDiffOn_flowBox_of_equiv {X : E → E} {s : Set E} {x₀ : E}
    (hs : IsOpen s) (hx₀ : x₀ ∈ s) (hX : ContDiffOn ℝ ∞ X s)
    (L : (ℝ × F) ≃L[ℝ] E) (hL : L (1, 0) = X x₀) :
    ∃ e : OpenPartialHomeomorph (ℝ × F) E,
      (0 : ℝ × F) ∈ e.source ∧ e 0 = x₀ ∧ e.target ⊆ s ∧
      ContDiffOn ℝ ∞ e e.source ∧ ContDiffOn ℝ ∞ e.symm e.target ∧
      HasFDerivAt e (L : (ℝ × F) →L[ℝ] E) 0 ∧
      ∀ p ∈ e.source, fderiv ℝ e p (1, 0) = X (e p) := by
  obtain ⟨Y, hY, hYX⟩ := exists_contDiff_eventuallyEq hs hx₀ hX
  have hYt : ContDiff ℝ ∞ (Function.uncurry (fun _ : ℝ => Y)) :=
    hY.comp contDiff_snd
  obtain ⟨r, ε, hr, hε, Φ, hflow, ρ, T, hρ, hT, hρr, hTε, hΦ⟩ :=
    DifferentialGeometry.Analysis.ODE.exists_isLocalFlow_contDiffOn_top
      (t₀ := 0) (x₀ := x₀) hYt
  simp only [zero_sub, zero_add] at hflow hΦ
  let a : F → E := fun z => x₀ + L (0, z)
  let ψ : ℝ × F → E := fun p => Φ (a p.2, p.1)
  let U₀ : Set (ℝ × F) :=
    (fun p : ℝ × F => (a p.2, p.1)) ⁻¹' (ball x₀ ρ ×ˢ Ioo (-T) T)
  have ha : ContDiff ℝ ∞ a :=
    contDiff_const.add (L.contDiff.comp (contDiff_const.prodMk contDiff_id))
  have hinput : ContDiff ℝ ∞ (fun p : ℝ × F => (a p.2, p.1)) :=
    (ha.comp contDiff_snd).prodMk contDiff_fst
  have hU₀ : IsOpen U₀ := (isOpen_ball.prod isOpen_Ioo).preimage hinput.continuous
  have hzero : (0 : ℝ × F) ∈ U₀ := by
    change (a 0, (0 : ℝ)) ∈ ball x₀ ρ ×ˢ Ioo (-T) T
    simp only [a, Prod.mk_zero_zero, map_zero, add_zero]
    exact ⟨mem_ball_self hρ, by constructor <;> linarith⟩
  have hψ : ContDiffOn ℝ ∞ ψ U₀ :=
    hΦ.comp hinput.contDiffOn (fun _ hp => hp)
  have hψzero : ψ 0 = x₀ := by
    change Φ (x₀ + L (0, 0), 0) = x₀
    simpa only [Prod.mk_zero_zero, map_zero, add_zero] using
      hflow.apply_initial x₀ (mem_closedBall_self hr.le)
  have hψdiff : ∀ p ∈ U₀, DifferentiableAt ℝ ψ p :=
    fun p hp => (hψ.contDiffAt (hU₀.mem_nhds hp)).differentiableAt (by simp)
  have htime : ∀ p ∈ U₀, fderiv ℝ ψ p (1, 0) = Y (ψ p) := by
    intro p hp
    have ht : p.1 ∈ Ioo (-ε) ε :=
      ⟨lt_of_le_of_lt (neg_le_neg hTε) hp.2.1, lt_of_lt_of_le hp.2.2 hTε⟩
    have hc : HasDerivAt (fun t => ψ (t, p.2)) (Y (ψ p)) p.1 :=
      (hflow.hasDerivWithinAt (a p.2)
        (ball_subset_closedBall (ball_subset_ball hρr hp.1)) p.1
        ⟨ht.1.le, ht.2.le⟩).hasDerivAt (Icc_mem_nhds ht.1 ht.2)
    have hd := (hψdiff p hp).hasFDerivAt.comp_hasDerivAt p.1
      ((hasDerivAt_id p.1).prodMk (hasDerivAt_const p.1 p.2))
    exact hd.unique hc
  have hinitial : (fun z : F => ψ (0, z)) =ᶠ[𝓝 0] a := by
    have haa : a 0 = x₀ := by simp [a]
    have hevent : ∀ᶠ z in 𝓝 (0 : F), a z ∈ ball x₀ ρ := by
      apply ha.continuous.continuousAt.preimage_mem_nhds
      rw [haa]
      exact ball_mem_nhds _ hρ
    filter_upwards [hevent] with z hz
    exact hflow.apply_initial (a z) (ball_subset_closedBall (ball_subset_ball hρr hz))
  have haDeriv : HasFDerivAt a
      ((L : (ℝ × F) →L[ℝ] E).comp (ContinuousLinearMap.inr ℝ ℝ F)) 0 := by
    exact ((L : (ℝ × F) →L[ℝ] E).hasFDerivAt.comp 0
      (hasFDerivAt_prodMk_right (0 : ℝ) (0 : F))).const_add x₀
  have hspatial : (fderiv ℝ ψ 0).comp (ContinuousLinearMap.inr ℝ ℝ F) =
      (L : (ℝ × F) →L[ℝ] E).comp (ContinuousLinearMap.inr ℝ ℝ F) :=
    ((hψdiff 0 hzero).hasFDerivAt.comp 0
      (hasFDerivAt_prodMk_right (0 : ℝ) (0 : F))).unique
        (haDeriv.congr_of_eventuallyEq hinitial)
  have htimezero : fderiv ℝ ψ 0 (1, 0) = L (1, 0) := by
    rw [htime 0 hzero, hψzero, hYX.self_of_nhds, ← hL]
  have hD : fderiv ℝ ψ 0 = (L : (ℝ × F) →L[ℝ] E) := by
    apply ContinuousLinearMap.ext
    rintro ⟨t, z⟩
    have hp : (t, z) = t • (1, (0 : F)) + (0, z) := by ext <;> simp
    have hz := congrArg (fun A : F →L[ℝ] E => A z) hspatial
    change fderiv ℝ ψ 0 (0, z) = L (0, z) at hz
    rw [hp, map_add, map_smul, htimezero, hz, ← map_smul, ← map_add, ← hp]
    rfl
  have hderiv : HasFDerivAt ψ (L : (ℝ × F) →L[ℝ] E) 0 :=
    hD ▸ (hψdiff 0 hzero).hasFDerivAt
  have hgoodx : {x | x ∈ s ∧ Y x = X x} ∈ 𝓝 x₀ :=
    Filter.inter_mem (hs.mem_nhds hx₀) hYX
  obtain ⟨q, hq, hqopen, hxq⟩ := _root_.mem_nhds_iff.mp hgoodx
  have hgood : ∀ᶠ p in 𝓝 (0 : ℝ × F), p ∈ U₀ ∧ ψ p ∈ q := by
    apply Filter.inter_mem (hU₀.mem_nhds hzero)
    apply (hψ.continuousOn.continuousAt (hU₀.mem_nhds hzero)).preimage_mem_nhds
    rw [hψzero]
    exact hqopen.mem_nhds hxq
  obtain ⟨U, hUsub, hU, hzeroU⟩ := _root_.mem_nhds_iff.mp hgood
  obtain ⟨e, hezero, hesource, he, hesmooth, heinv⟩ :=
    Manifold.exists_contDiffOn_localInverse hU hzeroU
      (hψ.mono (fun p hp => (hUsub hp).1)) L hderiv (by simp)
  have heq : (e : (ℝ × F) → E) = ψ := funext he
  refine ⟨e, hezero, by rw [he, hψzero], ?_, hesmooth, heinv, ?_, ?_⟩
  · intro y hy
    have hsource := e.map_target hy
    have hmem := (hq (hUsub (hesource hsource)).2).1
    rwa [← he (e.symm y), e.right_inv hy] at hmem
  · simpa only [heq] using hderiv
  · intro p hp
    rw [heq, htime p (hUsub (hesource hp)).1]
    exact (hq (hUsub (hesource hp)).2).2

/-- A smooth vector field nonzero at the base point admits smooth local coordinates in
which it is the first coordinate direction. The transverse subspace and the chart are both
constructed, and the chart's target remains inside the original open domain. -/
theorem exists_contDiffOn_flowBox {X : E → E} {s : Set E} {x₀ : E}
    (hs : IsOpen s) (hx₀ : x₀ ∈ s) (hX : ContDiffOn ℝ ∞ X s) (hne : X x₀ ≠ 0) :
    ∃ (S : Submodule ℝ E) (e : OpenPartialHomeomorph (ℝ × S) E),
      (0 : ℝ × S) ∈ e.source ∧ e 0 = x₀ ∧ e.target ⊆ s ∧
      ContDiffOn ℝ ∞ e e.source ∧ ContDiffOn ℝ ∞ e.symm e.target ∧
      ∀ p ∈ e.source, fderiv ℝ e p (1, 0) = X (e p) := by
  obtain ⟨S, L, hL⟩ := exists_prod_equiv_of_ne_zero hne
  obtain ⟨e, he0, heval, hetarget, he, heinv, _, hefield⟩ :=
    exists_contDiffOn_flowBox_of_equiv hs hx₀ hX L hL
  exact ⟨S, e, he0, heval, hetarget, he, heinv, hefield⟩

end LieGroups.Analysis

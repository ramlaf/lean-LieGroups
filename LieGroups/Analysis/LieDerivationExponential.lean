import LieGroups.Algebra.NilpotentIdeals
import LieGroups.Analysis.FiniteDimensionalModel
import Mathlib.Algebra.Lie.Derivation.Basic
import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.Analysis.Calculus.MeanValue

/-!
# Exponentiating real Lie derivations and preserving the nilradical

The exponential of a derivation on a finite-dimensional real Lie algebra is a
Lie algebra automorphism. Differentiating its preservation of the classical
nilradical proves that the nilradical is invariant under every derivation.
All analytic structures are constructed from the original algebraic data.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Set Filter
open scoped Topology

namespace LieGroups

variable {L : Type*} [LieRing L] [LieAlgebra ℝ L] [FiniteDimensional ℝ L]

attribute [local instance] finiteDimensionalNormedAddCommGroup finiteDimensionalNormedSpace

/-- A derivation as a continuous endomorphism in the chosen finite-dimensional norm. -/
def lieDerivationContinuousEnd (D : LieDerivation ℝ L L) : L →L[ℝ] L :=
  D.toLinearMap.toContinuousLinearMap

private def lieBracketContinuous : L →L[ℝ] L →L[ℝ] L := by
  let f : L →ₗ[ℝ] (L →L[ℝ] L) := {
    toFun x := LinearMap.toContinuousLinearMap (LieAlgebra.ad ℝ L x)
    map_add' x y := by ext z; exact add_lie x y z
    map_smul' r x := by ext z; exact smul_lie r x z
  }
  exact f.toContinuousLinearMap

private theorem lieBracketContinuous_apply (x y : L) : lieBracketContinuous x y = ⁅x, y⁆ := rfl

/-- The exponential curve of a real Lie derivation. -/
def lieDerivationExp (D : LieDerivation ℝ L L) (t : ℝ) : L →L[ℝ] L :=
  NormedSpace.exp (t • lieDerivationContinuousEnd D)

theorem hasDerivAt_lieDerivationExp_apply (D : LieDerivation ℝ L L) (x : L) (t : ℝ) :
    HasDerivAt (fun s => lieDerivationExp D s x) (D (lieDerivationExp D t x)) t := by
  have h := (hasDerivAt_exp_smul_const' (lieDerivationContinuousEnd D) t).clm_apply
    (hasDerivAt_const t x)
  simpa [lieDerivationExp, lieDerivationContinuousEnd, mul_apply_eq_comp] using h

private theorem exp_smul_mul_exp_smul_neg (A : L →L[ℝ] L) (t : ℝ) :
    NormedSpace.exp (t • A) * NormedSpace.exp (t • (-A)) = 1 := by
  have hball (x : L →L[ℝ] L) :
      x ∈ Metric.eball 0 (NormedSpace.expSeries ℝ (L →L[ℝ] L)).radius := by
    simp [NormedSpace.expSeries_radius_eq_top]
  rw [smul_neg, ← NormedSpace.exp_add_of_commute_of_mem_ball
    (Commute.refl (t • A)).neg_right (hball _) (hball _),
    add_neg_cancel, NormedSpace.exp_zero]

private theorem exp_smul_neg_mul_exp_smul (A : L →L[ℝ] L) (t : ℝ) :
    NormedSpace.exp (t • (-A)) * NormedSpace.exp (t • A) = 1 := by
  have hball (x : L →L[ℝ] L) :
      x ∈ Metric.eball 0 (NormedSpace.expSeries ℝ (L →L[ℝ] L)).radius := by
    simp [NormedSpace.expSeries_radius_eq_top]
  rw [smul_neg, ← NormedSpace.exp_add_of_commute_of_mem_ball
    (Commute.refl (t • A)).neg_left (hball _) (hball _),
    neg_add_cancel, NormedSpace.exp_zero]

/-- Exponentiating a real finite-dimensional derivation preserves the bracket. -/
theorem lieDerivationExp_map_lie (D : LieDerivation ℝ L L) (t : ℝ) (x y : L) :
    lieDerivationExp D t ⁅x, y⁆ = ⁅lieDerivationExp D t x, lieDerivationExp D t y⁆ := by
  let A := lieDerivationContinuousEnd D
  let B : ℝ → L := fun s => ⁅lieDerivationExp D s x, lieDerivationExp D s y⁆
  have hB (s : ℝ) : HasDerivAt B (D (B s)) s := by
    have h := (lieBracketContinuous (L := L)).hasDerivAt_of_bilinear
      (fun _ => hasDerivAt_lieDerivationExp_apply D x s)
      (fun _ => hasDerivAt_lieDerivationExp_apply D y s)
    simpa only [lieBracketContinuous_apply, ← LieDerivation.apply_lie_eq_add] using h
  let F : ℝ → L := fun s => NormedSpace.exp (s • (-A)) (B s)
  have hF (s : ℝ) : HasDerivAt F 0 s := by
    have h := (hasDerivAt_exp_smul_const (-A) s).clm_apply (hB s)
    simpa [F, A, lieDerivationContinuousEnd, mul_apply_eq_comp] using h
  have heq := is_const_of_deriv_eq_zero (fun s => (hF s).differentiableAt)
    (fun s => (hF s).deriv) t 0
  have hvalue : NormedSpace.exp (t • (-A)) (B t) = ⁅x, y⁆ := by
    simpa only [F, B, lieDerivationExp, zero_smul, NormedSpace.exp_zero,
      one_apply_eq_self] using heq
  have h := congrArg (fun z => NormedSpace.exp (t • A) z) hvalue
  change (NormedSpace.exp (t • A) * NormedSpace.exp (t • (-A))) (B t) =
    NormedSpace.exp (t • A) ⁅x, y⁆ at h
  rw [exp_smul_mul_exp_smul_neg, one_apply_eq_self] at h
  exact h.symm

/-- The exponential of a real finite-dimensional derivation is an actual
Lie equivalence, with inverse the negative-time exponential. -/
def lieDerivationExpLieEquiv (D : LieDerivation ℝ L L) (t : ℝ) : L ≃ₗ⁅ℝ⁆ L where
  toLinearMap := (lieDerivationExp D t).toLinearMap
  invFun x := (NormedSpace.exp (t • (-lieDerivationContinuousEnd D)) : L →L[ℝ] L) x
  left_inv x := by
    change (NormedSpace.exp (t • (-lieDerivationContinuousEnd D)) *
      NormedSpace.exp (t • lieDerivationContinuousEnd D)) x = x
    rw [exp_smul_neg_mul_exp_smul, one_apply_eq_self]
  right_inv x := by
    change (NormedSpace.exp (t • lieDerivationContinuousEnd D) *
      NormedSpace.exp (t • (-lieDerivationContinuousEnd D))) x = x
    rw [exp_smul_mul_exp_smul_neg, one_apply_eq_self]
  map_lie' {x y} := lieDerivationExp_map_lie D t x y

@[simp]
theorem lieDerivationExpLieEquiv_apply (D : LieDerivation ℝ L L) (t : ℝ) (x : L) :
    lieDerivationExpLieEquiv D t x = lieDerivationExp D t x := rfl

/-- The classical nilradical of a finite-dimensional real Lie algebra is
invariant under every Lie derivation. -/
theorem lieDerivation_mem_classicalNilradical (D : LieDerivation ℝ L L) {x : L}
    (hx : x ∈ classicalNilradical ℝ L) : D x ∈ classicalNilradical ℝ L := by
  let N := classicalNilradical ℝ L
  have hc (t : ℝ) : lieDerivationExp D t x ∈ N :=
    (mem_classicalNilradical_lieEquiv_iff (lieDerivationExpLieEquiv D t) x).mpr hx
  have hd : HasDerivAt (fun t => lieDerivationExp D t x) (D x) 0 := by
    simpa only [lieDerivationExp, zero_smul, NormedSpace.exp_zero,
      one_apply_eq_self] using hasDerivAt_lieDerivationExp_apply D x 0
  have hclosed : IsClosed (N.toSubmodule : Set L) := N.toSubmodule.closed_of_finiteDimensional
  apply hclosed.mem_of_tendsto hd.tendsto_slope_zero
  exact Eventually.of_forall fun t => N.smul_mem _ (N.sub_mem (hc (0 + t)) (hc 0))

end LieGroups

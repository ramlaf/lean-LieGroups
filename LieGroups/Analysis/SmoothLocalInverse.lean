import Mathlib.Geometry.Manifold.LocalDiffeomorph
import Mathlib.Analysis.Calculus.InverseFunctionTheorem.ContDiff

/-!
# Smooth local inverse near an identity differential

An open partial homeomorphism from the inverse-function theorem becomes a
partial diffeomorphism after restricting to a neighborhood where the derivative
remains invertible.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-05.
-/

open Set
open scoped Topology ContDiff Manifold

namespace LieGroups.Analysis

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- A smooth Euclidean map with identity derivative at zero has a smooth local
inverse there. -/
theorem exists_partialDiffeomorph_of_fderiv_zero_id
    {F : E → E} {W : Set E} (hW : IsOpen W) (hW0 : (0 : E) ∈ W)
    (hF : ContDiffOn ℝ ∞ F W)
    (hd : fderiv ℝ F 0 = ContinuousLinearMap.id ℝ E) :
    ∃ Φ : PartialDiffeomorph 𝓘(ℝ, E) 𝓘(ℝ, E) E E ∞,
      (0 : E) ∈ Φ.source ∧ Φ.source ⊆ W ∧ Set.EqOn F Φ Φ.source := by
  have hF0 : ContDiffAt ℝ ∞ F 0 := hF.contDiffAt (hW.mem_nhds hW0)
  have hD0 : HasFDerivAt F
      ((ContinuousLinearEquiv.refl ℝ E) : E →L[ℝ] E) 0 := by
    have h := (hF0.differentiableAt (by simp)).hasFDerivAt
    rw [hd] at h
    simpa using h
  let φ : OpenPartialHomeomorph E E :=
    hF0.toOpenPartialHomeomorph F (f' := ContinuousLinearEquiv.refl ℝ E) hD0 (by simp)
  have hφ0 : (0 : E) ∈ φ.source :=
    hF0.mem_toOpenPartialHomeomorph_source hD0 (by simp)
  let Inv : Set (E →L[ℝ] E) :=
    Set.range ((↑) : (E ≃L[ℝ] E) → (E →L[ℝ] E))
  have hInv : Inv ∈ 𝓝 (fderiv ℝ F 0) := by
    rw [hd]
    exact (ContinuousLinearEquiv.refl ℝ E).nhds
  have hInvPre : (fderiv ℝ F) ⁻¹' Inv ∈ 𝓝 (0 : E) :=
    (hF0.continuousAt_fderiv (by simp)).preimage_mem_nhds hInv
  let S : Set E := W ∩ interior ((fderiv ℝ F) ⁻¹' Inv)
  have hS : IsOpen S := hW.inter isOpen_interior
  have hS0 : (0 : E) ∈ S := ⟨hW0, mem_interior_iff_mem_nhds.mpr hInvPre⟩
  let ψ : OpenPartialHomeomorph E E := φ.restrOpen S hS
  have hψ0 : (0 : E) ∈ ψ.source := by
    change (0 : E) ∈ φ.source ∩ S
    exact ⟨hφ0, hS0⟩
  have hψforward : ContDiffOn ℝ ∞ ψ ψ.source := by
    change ContDiffOn ℝ ∞ F ψ.source
    apply hF.mono
    intro x hx
    have hx' : x ∈ φ.source ∩ S := hx
    exact hx'.2.1
  have hψinv : ContDiffOn ℝ ∞ ψ.symm ψ.target := by
    intro y hy
    let x := ψ.symm y
    have hx : x ∈ ψ.source := ψ.map_target hy
    have hxS : x ∈ S := by
      have hx' : x ∈ φ.source ∩ S := hx
      exact hx'.2
    have hxW : x ∈ W := hxS.1
    have hxInv : fderiv ℝ F x ∈ Inv := by
      exact (interior_subset : interior ((fderiv ℝ F) ⁻¹' Inv) ⊆
        (fderiv ℝ F) ⁻¹' Inv) hxS.2
    obtain ⟨L, hL⟩ := hxInv
    have hFx : ContDiffAt ℝ ∞ F x := (hF x hxW).contDiffAt (hW.mem_nhds hxW)
    have hψfun : (ψ : E → E) = F := rfl
    have hderiv : HasFDerivAt ψ (L : E →L[ℝ] E) x := by
      have h := (hFx.differentiableAt (by simp)).hasFDerivAt
      rw [← hL] at h
      rw [hψfun]
      exact h
    have hψx : ContDiffAt ℝ ∞ ψ x := by
      rw [hψfun]
      exact hFx
    exact (ψ.contDiffAt_symm hy hderiv hψx).contDiffWithinAt
  let Φ : PartialDiffeomorph 𝓘(ℝ, E) 𝓘(ℝ, E) E E ∞ := {
    toPartialEquiv := ψ.toPartialEquiv
    open_source := ψ.open_source
    open_target := ψ.open_target
    contMDiffOn_toFun := hψforward.contMDiffOn
    contMDiffOn_invFun := hψinv.contMDiffOn
  }
  refine ⟨Φ, hψ0, ?_, fun x hx => rfl⟩
  intro x hx
  have hx' : x ∈ φ.source ∩ S := hx
  exact hx'.2.1

end LieGroups.Analysis

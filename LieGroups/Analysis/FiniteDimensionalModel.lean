import Mathlib.Analysis.Normed.Module.FiniteDimension

/-!
# Choosing a norm on a finite-dimensional real vector space

Coordinates in a finite basis induce a norm compatible with the given addition
and scalar action. These are named choices rather than global instances, so an
existing topology on the same vector space is never replaced by typeclass search.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

variable (V : Type*) [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]

/-- A coordinate norm on a finite-dimensional real vector space, retaining its
given additive operations. This is not a global instance. -/
abbrev finiteDimensionalNormedAddCommGroup : NormedAddCommGroup V :=
  NormedAddCommGroup.induced V (Fin (Module.finrank ℝ V) → ℝ)
    (Module.finBasis ℝ V).equivFun (Module.finBasis ℝ V).equivFun.injective

attribute [local instance] finiteDimensionalNormedAddCommGroup

/-- The coordinate norm is compatible with the given module structure.
This is not a global instance. -/
abbrev finiteDimensionalNormedSpace : NormedSpace ℝ V :=
  NormedSpace.induced ℝ V (Fin (Module.finrank ℝ V) → ℝ) (Module.finBasis ℝ V).equivFun

end LieGroups

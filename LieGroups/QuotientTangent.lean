import LieGroups.QuotientManifold
import LieGroups.Manifold.QuotientSliceConstruction

/-!
# Tangent coordinates of homogeneous quotients

The transverse section of a constructed quotient slice gives its tangent-space
identification. No quotient differential or tangent isomorphism is assumed.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open Function Filter Set
open scoped Topology Manifold ContDiff

namespace LieGroups.Manifold.QuotientSlice

variable {E P : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {K : Subgroup G}
  (S : QuotientSlice (I := I) (P := P) (QuotientGroup.mk : G → G ⧸ K))
  (h1 : (1 : G) ∈ S.source) (h0 : (0 : P) ∈ S.target)

include h0 in
/-- The quotient projection composed with its transverse section is a local
diffeomorphism, as the inverse of the quotient's constructed identity chart. -/
theorem isLocalDiffeomorphAt_projection_section :
    IsLocalDiffeomorphAt 𝓘(ℝ, P) 𝓘(ℝ, P) ∞
      ((S.quotientAtlas h1).projection ∘ S.section_) 0 := by
  let A := S.quotientAtlas h1
  let c : OpenPartialHomeomorph A.Space P := A.chart (1 : G)
  have hc : c ∈ IsManifold.maximalAtlas 𝓘(ℝ, P) ∞ A.Space :=
    IsManifold.subset_maximalAtlas (A.chart_mem_atlas 1)
  let e : PartialDiffeomorph 𝓘(ℝ, P) 𝓘(ℝ, P) P A.Space ∞ := {
    toPartialEquiv := c.toPartialEquiv.symm
    open_source := c.open_target
    open_target := c.open_source
    contMDiffOn_toFun := contMDiffOn_symm_of_mem_maximalAtlas hc
    contMDiffOn_invFun := contMDiffOn_of_mem_maximalAtlas hc }
  refine ⟨e, h0, ?_⟩
  intro p _hp
  change QuotientGroup.mk (S.section_ p) = QuotientGroup.mk (1 * S.section_ p)
  rw [one_mul]

/-- The tangent coordinates induced by the transverse quotient section. -/
def sectionTangentEquiv (_hs0 : S.section_ 0 = 1) :
    P ≃L[ℝ] TangentSpace 𝓘(ℝ, P) ((S.quotientAtlas h1).projection 1) :=
  (NormedSpace.fromTangentSpace (0 : P)).symm.trans
    ((S.isLocalDiffeomorphAt_projection_section h1 h0).mfderivToContinuousLinearEquiv
      (by simp))

/-- Differentiating the quotient projection along the transverse section gives
the constructed tangent identification. -/
theorem mfderiv_projection_section (hs0 : S.section_ 0 = 1) (p : P) :
    mfderiv I 𝓘(ℝ, P) (S.quotientAtlas h1).projection 1
      (mfderiv 𝓘(ℝ, P) I S.section_ 0
        ((NormedSpace.fromTangentSpace (0 : P)).symm p)) =
      S.sectionTangentEquiv h1 h0 hs0 p := by
  have hs : MDifferentiableAt 𝓘(ℝ, P) I S.section_ 0 :=
    (S.section_smooth.contMDiffAt (S.open_target.mem_nhds h0)).mdifferentiableAt (by simp)
  have hp : MDifferentiableAt I 𝓘(ℝ, P) (S.quotientAtlas h1).projection 1 :=
    (S.quotientAtlas h1).contMDiff_projection.mdifferentiableAt (by simp)
  have hh := mfderiv_comp_of_eq (x := (0 : P)) hp hs hs0
  change _ = mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P)
    ((S.quotientAtlas h1).projection ∘ S.section_) 0
      ((NormedSpace.fromTangentSpace (0 : P)).symm p)
  rw [hh, hs0]
  rfl

end LieGroups.Manifold.QuotientSlice

namespace LieGroups

section Splitting

variable {E F K P : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  [NormedAddCommGroup K] [NormedSpace ℝ K] [FiniteDimensional ℝ K]
  [NormedAddCommGroup P] [NormedSpace ℝ P]

omit [FiniteDimensional ℝ K] in
/-- An injective subgroup differential whose range is the first summand gives a
product splitting with the prescribed second summand as its transverse factor. -/
theorem exists_transverse_equiv_of_range
    (B : F →L[ℝ] E) (hB : Function.Injective B) (D : E ≃L[ℝ] K × P)
    (hrange : ∀ y : E, y ∈ LinearMap.range B.toLinearMap ↔ (D y).2 = 0) :
    ∃ L : (P × F) ≃L[ℝ] E,
      (∀ f, L (0, f) = B f) ∧ (∀ p, L (p, 0) = D.symm (0, p)) := by
  let T : F →ₗ[ℝ] K := (LinearMap.fst ℝ K P).comp (D.toLinearMap.comp B.toLinearMap)
  have hz (f : F) : (D (B f)).2 = 0 := (hrange _).mp ⟨f, rfl⟩
  have hinj : Function.Injective T := by
    intro f g hfg
    apply hB
    apply D.injective
    exact Prod.ext hfg ((hz f).trans (hz g).symm)
  have hsurj : Function.Surjective T := by
    intro k
    obtain ⟨f, hf⟩ := (hrange (D.symm (k, 0))).mpr (by simp)
    refine ⟨f, ?_⟩
    change (D (B f)).1 = k
    change B f = D.symm (k, 0) at hf
    rw [hf, D.apply_symm_apply]
  let T' := (LinearEquiv.ofBijective T ⟨hinj, hsurj⟩).toContinuousLinearEquiv
  let L : (P × F) ≃L[ℝ] E :=
    ((ContinuousLinearEquiv.prodComm ℝ P F).trans
      (T'.prodCongr (ContinuousLinearEquiv.refl ℝ P))).trans D.symm
  refine ⟨L, ?_, ?_⟩
  · intro f
    apply D.injective
    change D (D.symm (T' f, 0)) = D (B f)
    rw [D.apply_symm_apply]
    exact Prod.ext rfl (hz f).symm
  · intro p
    change D.symm (T' 0, p) = D.symm (0, p)
    rw [map_zero]

end Splitting

variable {E P : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup P] [NormedSpace ℝ P]
  [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G] [T2Space G]

set_option backward.isDefEq.respectTransparency false in
/-- The manifold derivative of a linearly parameterized exponential at zero is
the prescribed tangent parameter. -/
theorem mfderiv_lieExp_model_comp_zero_apply (A : P →L[ℝ] E) (p : P) :
    mfderiv 𝓘(ℝ, P) I
      (fun q => lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (A q))) 0
      ((NormedSpace.fromTangentSpace (0 : P)).symm p) =
      (lieAlgebraModelEquiv (I := I) (G := G)).symm (A p) := by
  let X : P → G := fun q => lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm (A q))
  have hX : ContMDiff 𝓘(ℝ, P) I ∞ X :=
    (lieExp_contMDiff_model (I := I) (G := G)).comp A.contDiff.contMDiff
  have hX0 : X 0 = 1 := by simp [X]
  have hc : MDifferentiableAt I 𝓘(ℝ, E) (extChartAt I (1 : G)) 1 :=
    (contMDiffAt_extChartAt (n := ∞)).mdifferentiableAt (by simp)
  have hh := mfderiv_comp_of_eq (x := (0 : P)) hc
    (hX.mdifferentiableAt (by simp)) hX0
  rw [mfderiv_eq_fderiv, hX0, mfderiv_extChartAt_self] at hh
  have hd : fderiv ℝ (extChartAt I (1 : G) ∘ X) 0 = A :=
    Manifold.lieExp_model_comp_fderiv_zero A
  rw [hd, ContinuousLinearMap.id_comp] at hh
  have hmodel (v : GroupLieAlgebra I G) :
      lieAlgebraModelEquiv (I := I) (G := G) v = tangentSpaceCastModel I (1 : G) v := by
    change tangentCoordChange I (1 : G) (1 : G) (1 : G) v = v
    exact tangentCoordChange_self (mem_extChartAt_source (I := I) (1 : G))
  apply (lieAlgebraModelEquiv (I := I) (G := G)).injective
  rw [ContinuousLinearEquiv.apply_symm_apply]
  rw [hmodel]
  exact congrArg (fun B : P →L[ℝ] E => B p) hh.symm

namespace Manifold.QuotientSlice

variable {K : Subgroup G}
  (S : QuotientSlice (I := I) (P := P) (QuotientGroup.mk : G → G ⧸ K))
  (h1 : (1 : G) ∈ S.source) (h0 : (0 : P) ∈ S.target)

/-- For an exponential transverse section, the quotient differential on its
prescribed tangent directions is exactly the constructed tangent equivalence. -/
theorem mfderiv_projection_exp_section
    (A : P →L[ℝ] E)
    (hsec : S.section_ = fun p => lieExp
      ((lieAlgebraModelEquiv (I := I) (G := G)).symm (A p)))
    (hs0 : S.section_ 0 = 1) (p : P) :
    mfderiv I 𝓘(ℝ, P) (S.quotientAtlas h1).projection 1
      ((lieAlgebraModelEquiv (I := I) (G := G)).symm (A p)) =
      S.sectionTangentEquiv h1 h0 hs0 p := by
  have h := S.mfderiv_projection_section h1 h0 hs0 p
  have hd : mfderiv 𝓘(ℝ, P) I S.section_ 0
      ((NormedSpace.fromTangentSpace (0 : P)).symm p) =
      (lieAlgebraModelEquiv (I := I) (G := G)).symm (A p) := by
    rw [hsec]
    exact mfderiv_lieExp_model_comp_zero_apply A p
  rwa [hd] at h

end Manifold.QuotientSlice

end LieGroups

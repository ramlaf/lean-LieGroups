import LieGroups.ActionTangent
import Mathlib.Analysis.Normed.Operator.Bilinear

/-!
# Invariant inner products on homogeneous manifolds

An isotropy-invariant bilinear form at the origin extends to a well-defined
bilinear form on every tangent space. This construction chooses representatives,
then proves independence of that choice and invariance under the full action.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false

namespace LieGroups

variable {E F H H' G M : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H}
  [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'}
  [Group G] [TopologicalSpace G] [ChartedSpace H G]
  [TopologicalSpace M] [ChartedSpace H' M]
  [MulAction G M] [hsmooth : ContMDiffSMul I J ∞ G M]

/-- Invariance of an origin form under the differential of its stabilizer. -/
def IsIsotropyInvariant (o : M)
    (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ) : Prop :=
  ∀ g : G, g • o = o → ∀ v w : TangentSpace J o,
    B (actionTangent (J := J) g o v) (actionTangent (J := J) g o w) = B v w

variable [MulAction.IsPretransitive G M]

/-- A representative carrying the chosen origin to the given point. -/
def homogeneousRepresentative (o x : M) : G :=
  Classical.choose (MulAction.exists_smul_eq G o x)

omit [TopologicalSpace G] [TopologicalSpace M] in
@[simp]
theorem homogeneousRepresentative_smul (o x : M) :
    homogeneousRepresentative (G := G) o x • o = x :=
  Classical.choose_spec (MulAction.exists_smul_eq G o x)

/-- Transport the origin form back by a chosen representative. -/
def homogeneousInner (o : M)
    (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ) (x : M) :
    TangentSpace J x →L[ℝ] TangentSpace J x →L[ℝ] ℝ :=
  let D := actionTangent (J := J) (homogeneousRepresentative (G := G) o x)⁻¹ x
  (ContinuousLinearMap.precomp ℝ D).comp (B.comp D)

include hsmooth

/-- The transported form is independent of the chosen representative. -/
theorem homogeneousInner_apply_of_smul_eq (o : M)
    (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) o B)
    {g : G} {x : M} (hg : g • o = x) (v w : TangentSpace J x) :
    homogeneousInner (G := G) o B x v w =
      B (actionTangent (J := J) g⁻¹ x v) (actionTangent (J := J) g⁻¹ x w) := by
  let a := homogeneousRepresentative (G := G) o x
  have ha : a • o = x := homogeneousRepresentative_smul o x
  have hk : (a⁻¹ * g) • o = o := by rw [mul_smul, hg, ← ha, inv_smul_smul]
  have ht (u : TangentSpace J x) :
      actionTangent (J := J) (a⁻¹ * g) o (actionTangent (J := J) g⁻¹ x u) =
        actionTangent (J := J) a⁻¹ x u := by
    rw [actionTangent_mul (I := I)]
    change actionTangent (J := J) a⁻¹ (g • o)
      (actionTangent (J := J) g o (actionTangent (J := J) g⁻¹ x u)) = _
    rw [← hg, actionTangent_apply_inv (I := I), hg]
  have hi := hB (a⁻¹ * g) hk
    (actionTangent (J := J) g⁻¹ x v) (actionTangent (J := J) g⁻¹ x w)
  rw [ht, ht] at hi
  exact hi

/-- The extended form recovers exactly the prescribed origin form. -/
@[simp]
theorem homogeneousInner_origin (o : M)
    (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) o B) (v w : TangentSpace J o) :
    homogeneousInner (G := G) o B o v w = B v w := by
  rw [homogeneousInner_apply_of_smul_eq (I := I) o B hB (one_smul G o),
    inv_one, actionTangent_one]
  rfl

/-- The extension is invariant under every element of the acting group. -/
theorem homogeneousInner_invariant (o : M)
    (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) o B)
    (g : G) (x : M) (v w : TangentSpace J x) :
    homogeneousInner (G := G) o B (g • x)
      (actionTangent (J := J) g x v) (actionTangent (J := J) g x w) =
        homogeneousInner (G := G) o B x v w := by
  let a := homogeneousRepresentative (G := G) o x
  have ha : a • o = x := homogeneousRepresentative_smul o x
  have hga : (g * a) • o = g • x := by rw [mul_smul, ha]
  rw [homogeneousInner_apply_of_smul_eq (I := I) o B hB hga,
    homogeneousInner_apply_of_smul_eq (I := I) o B hB ha]
  have ht (u : TangentSpace J x) :
      actionTangent (J := J) (g * a)⁻¹ (g • x) (actionTangent (J := J) g x u) =
        actionTangent (J := J) a⁻¹ x u := by
    rw [mul_inv_rev, actionTangent_mul (I := I)]
    change actionTangent (J := J) a⁻¹ (g⁻¹ • g • x)
      (actionTangent (J := J) g⁻¹ (g • x) (actionTangent (J := J) g x u)) = _
    rw [actionTangent_inv_apply (I := I), inv_smul_smul]
  rw [ht, ht]

omit hsmooth [TopologicalSpace G] in
/-- Symmetry of the origin form is retained at every point. -/
theorem homogeneousInner_symm (o : M)
    (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : ∀ v w, B v w = B w v) (x : M) (v w : TangentSpace J x) :
    homogeneousInner (G := G) o B x v w = homogeneousInner (G := G) o B x w v :=
  hB _ _

/-- Positivity is retained because each action map is a diffeomorphism. -/
theorem homogeneousInner_pos (o : M)
    (B : TangentSpace J o →L[ℝ] TangentSpace J o →L[ℝ] ℝ)
    (hB : ∀ v, v ≠ 0 → 0 < B v v) (x : M) (v : TangentSpace J x) (hv : v ≠ 0) :
    0 < homogeneousInner (G := G) o B x v v := by
  apply hB
  intro hzero
  apply hv
  apply (actionTangentEquiv (I := I) (J := J)
    (homogeneousRepresentative (G := G) o x)⁻¹ x).injective
  change actionTangent (J := J) (homogeneousRepresentative (G := G) o x)⁻¹ x v =
    actionTangent (J := J) (homogeneousRepresentative (G := G) o x)⁻¹ x 0
  rw [map_zero]
  exact hzero

end LieGroups

import LieGroups.HomogeneousMetricSmooth
import LieGroups.QuotientBundle

/-!
# Invariant metrics on the constructed homogeneous quotient

The quotient's constructed local sections supply the metric construction's
regularity input. Only a positive symmetric origin form and its invariance under
the stabilizer are supplied; no metric or metric smoothness is assumed.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section
open scoped Manifold ContDiff

namespace LieGroups.HomogeneousQuotient

variable {E H G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H}
  [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {K : Subgroup G} (Q : HomogeneousQuotient I G K)

local instance : ChartedSpace Q.model (G ⧸ K) := Q.chartedSpace
local instance : IsManifold 𝓘(ℝ, Q.model) ∞ (G ⧸ K) := Q.isManifold
local instance : ContMDiffSMul I 𝓘(ℝ, Q.model) ∞ G (G ⧸ K) := Q.smoothAction

omit [FiniteDimensional ℝ E] [LieGroup I ∞ G] in
/-- The actual quotient projection is the orbit map at the identity coset. -/
theorem orbitMap_hasContMDiffLocalSections :
    Manifold.HasContMDiffLocalSections I 𝓘(ℝ, Q.model) ∞
      (fun g : G => g • (QuotientGroup.mk (1 : G) : G ⧸ K)) := by
  have h : (fun g : G => g • (QuotientGroup.mk (1 : G) : G ⧸ K)) =
      (QuotientGroup.mk : G → G ⧸ K) := by
    funext g
    change QuotientGroup.mk (g * 1) = QuotientGroup.mk g
    rw [mul_one]
  rw [h]
  exact Q.localSections

variable [T2Space (G ⧸ K)]

/-- A metric on the ordinary quotient topology and the constructed quotient
atlas, with the prescribed positive stabilizer-invariant origin form. -/
def riemannianMetric
    (B : TangentSpace 𝓘(ℝ, Q.model) (QuotientGroup.mk (1 : G) : G ⧸ K) →L[ℝ]
      TangentSpace 𝓘(ℝ, Q.model) (QuotientGroup.mk (1 : G) : G ⧸ K) →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) (QuotientGroup.mk (1 : G) : G ⧸ K) B)
    (hsymm : ∀ v w, B v w = B w v) (hpos : ∀ v, v ≠ 0 → 0 < B v v) :
    DifferentialGeometry.SmoothRiemannianMetric 𝓘(ℝ, Q.model) (G ⧸ K) :=
  homogeneousRiemannianMetric (I := I) (QuotientGroup.mk (1 : G) : G ⧸ K)
    B hB hsymm hpos Q.orbitMap_hasContMDiffLocalSections

@[simp]
theorem riemannianMetric_origin
    (B : TangentSpace 𝓘(ℝ, Q.model) (QuotientGroup.mk (1 : G) : G ⧸ K) →L[ℝ]
      TangentSpace 𝓘(ℝ, Q.model) (QuotientGroup.mk (1 : G) : G ⧸ K) →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) (QuotientGroup.mk (1 : G) : G ⧸ K) B)
    (hsymm : ∀ v w, B v w = B w v) (hpos : ∀ v, v ≠ 0 → 0 < B v v)
    (v w : TangentSpace 𝓘(ℝ, Q.model) (QuotientGroup.mk (1 : G) : G ⧸ K)) :
    (Q.riemannianMetric B hB hsymm hpos).inner (QuotientGroup.mk (1 : G) : G ⧸ K) v w =
      B v w :=
  homogeneousRiemannianMetric_origin _ _ _ _ _ _ _ _

theorem riemannianMetric_invariant
    (B : TangentSpace 𝓘(ℝ, Q.model) (QuotientGroup.mk (1 : G) : G ⧸ K) →L[ℝ]
      TangentSpace 𝓘(ℝ, Q.model) (QuotientGroup.mk (1 : G) : G ⧸ K) →L[ℝ] ℝ)
    (hB : IsIsotropyInvariant (G := G) (QuotientGroup.mk (1 : G) : G ⧸ K) B)
    (hsymm : ∀ v w, B v w = B w v) (hpos : ∀ v, v ≠ 0 → 0 < B v v)
    (g : G) (x : G ⧸ K) (v w : TangentSpace 𝓘(ℝ, Q.model) x) :
    (Q.riemannianMetric B hB hsymm hpos).inner (g • x)
      (actionTangent (J := 𝓘(ℝ, Q.model)) g x v)
      (actionTangent (J := 𝓘(ℝ, Q.model)) g x w) =
        (Q.riemannianMetric B hB hsymm hpos).inner x v w :=
  homogeneousRiemannianMetric_invariant _ _ _ _ _ _ _ _ _ _

end LieGroups.HomogeneousQuotient

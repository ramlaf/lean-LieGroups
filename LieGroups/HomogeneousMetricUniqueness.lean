import LieGroups.HomogeneousMetricSmooth

/-!
# Uniqueness of an invariant homogeneous metric

An invariant metric is determined by its value at the origin of a transitive
action. Consequently the constructed metric is the unique invariant extension
of its prescribed origin form.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false

namespace LieGroups

variable {E F H H' G M : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H}
  [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'}
  [Group G] [TopologicalSpace G] [ChartedSpace H G]
  [TopologicalSpace M] [ChartedSpace H' M] [IsManifold J ∞ M]
  [MulAction G M] [hsmooth : ContMDiffSMul I J ∞ G M] [MulAction.IsPretransitive G M]

include hsmooth

/-- Two invariant smooth Riemannian metrics agreeing at the origin agree everywhere. -/
theorem invariantRiemannianMetric_eq_of_origin (o : M)
    (g₁ g₂ : DifferentialGeometry.SmoothRiemannianMetric J M)
    (h₁ : ∀ (a : G) (x : M) (v w : TangentSpace J x),
      g₁.inner (a • x) (actionTangent (J := J) a x v) (actionTangent (J := J) a x w) =
        g₁.inner x v w)
    (h₂ : ∀ (a : G) (x : M) (v w : TangentSpace J x),
      g₂.inner (a • x) (actionTangent (J := J) a x v) (actionTangent (J := J) a x w) =
        g₂.inner x v w)
    (h₀ : ∀ v w : TangentSpace J o, g₁.inner o v w = g₂.inner o v w) : g₁ = g₂ := by
  apply DifferentialGeometry.SmoothRiemannianMetric.ext_inner
  intro x v w
  obtain ⟨a, ha⟩ := MulAction.exists_smul_eq G o x
  subst x
  let d := actionTangentEquiv (I := I) (J := J) a o
  have hleft := h₁ a o (d.symm v) (d.symm w)
  have hright := h₂ a o (d.symm v) (d.symm w)
  change g₁.inner (a • o) (d (d.symm v)) (d (d.symm w)) = _ at hleft
  change g₂.inner (a • o) (d (d.symm v)) (d (d.symm w)) = _ at hright
  rw [d.apply_symm_apply, d.apply_symm_apply] at hleft hright
  exact hleft.trans ((h₀ (d.symm v) (d.symm w)).trans hright.symm)

end LieGroups

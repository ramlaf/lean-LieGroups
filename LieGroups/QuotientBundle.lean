import LieGroups.QuotientManifold
import LieGroups.Manifold.QuotientSliceConstruction
import Mathlib.LinearAlgebra.Isomorphisms

/-!
# Bundled homogeneous quotient structures

The underlying space is the actual coset quotient with its existing quotient topology.
The bundle stores the constructed smooth structure, projection, local sections, and action.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
  (G : Type*) [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

/-- A smooth homogeneous quotient, on the ordinary coset quotient topology. The charted
space and all regularity data are outputs of the transverse-slice construction. -/
structure HomogeneousQuotient (K : Subgroup G) where
  /-- The transverse model, realized as a subspace of the ambient model. -/
  model : Submodule ℝ E
  [chartedSpace : ChartedSpace model (G ⧸ K)]
  [isManifold : IsManifold 𝓘(ℝ, model) ∞ (G ⧸ K)]
  /-- Smoothness of the ordinary coset projection. -/
  projection_smooth : ContMDiff I 𝓘(ℝ, model) ∞ (QuotientGroup.mk : G → G ⧸ K)
  /-- Smooth local right inverses of the coset projection. -/
  localSections : Manifold.HasContMDiffLocalSections I 𝓘(ℝ, model) ∞
    (QuotientGroup.mk : G → G ⧸ K)
  /-- Surjectivity of the differential at every representative. -/
  differential_surjective : ∀ x : G,
    Function.Surjective (mfderiv I 𝓘(ℝ, model) (QuotientGroup.mk : G → G ⧸ K) x)
  /-- Actual submersion normal forms with a common complement. -/
  submersion : _root_.Manifold.IsSubmersion I 𝓘(ℝ, model) ∞
    (QuotientGroup.mk : G → G ⧸ K)
  [smoothAction : ContMDiffSMul I 𝓘(ℝ, model) ∞ G (G ⧸ K)]

variable {I G}

namespace HomogeneousQuotient

variable {K : Subgroup G}

/-- Package the quotient structure obtained from one actual transverse identity slice. -/
def ofSlice [FiniteDimensional ℝ E] [I.Boundaryless]
    (P : Submodule ℝ E)
    (S : Manifold.QuotientSlice (I := I) (P := P) (QuotientGroup.mk : G → G ⧸ K))
    (h1 : (1 : G) ∈ S.source) : HomogeneousQuotient I G K where
  model := P
  chartedSpace := (S.quotientAtlas h1).chartedSpace
  isManifold := inferInstanceAs (IsManifold 𝓘(ℝ, P) ∞ (S.QuotientSpace h1))
  projection_smooth := (S.quotientAtlas h1).contMDiff_projection
  localSections := (S.quotientAtlas h1).hasContMDiffLocalSections
  differential_surjective := (S.quotientAtlas h1).mfderiv_projection_surjective
  submersion := (S.quotientAtlas h1).isSubmersion_projection
  smoothAction := inferInstanceAs (ContMDiffSMul I 𝓘(ℝ, P) ∞ G (S.QuotientSpace h1))

/-- The quotient tangent space is canonically the ambient tangent space modulo the kernel
of the quotient differential. Identifying this kernel with the isotropy tangent space is
the separate subgroup comparison. -/
def tangentQuotientEquiv (Q : HomogeneousQuotient I G K) (x : G) :
    letI := Q.chartedSpace
    (TangentSpace I x ⧸
      (mfderiv I 𝓘(ℝ, Q.model) (QuotientGroup.mk : G → G ⧸ K) x).ker) ≃ₗ[ℝ]
      TangentSpace 𝓘(ℝ, Q.model) (QuotientGroup.mk x : G ⧸ K) := by
  letI := Q.chartedSpace
  exact (mfderiv I 𝓘(ℝ, Q.model) (QuotientGroup.mk : G → G ⧸ K) x).toLinearMap
    |>.quotKerEquivOfSurjective (Q.differential_surjective x)

omit [LieGroup I ∞ G] in
/-- The tangent-space identification sends the class of a vector to the quotient differential. -/
theorem tangentQuotientEquiv_mk (Q : HomogeneousQuotient I G K) (x : G)
    (v : TangentSpace I x) :
    letI := Q.chartedSpace
    Q.tangentQuotientEquiv x (Submodule.Quotient.mk v) =
      mfderiv I 𝓘(ℝ, Q.model) (QuotientGroup.mk : G → G ⧸ K) x v := by
  rfl

variable {D : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ D H'}
  {N : Type*} [TopologicalSpace N] [ChartedSpace H' N]

omit [LieGroup I ∞ G] in
/-- Smoothness descends from the ambient group to the constructed quotient. -/
theorem contMDiff_iff_comp_projection (Q : HomogeneousQuotient I G K) {f : G ⧸ K → N} :
    letI := Q.chartedSpace
    ContMDiff 𝓘(ℝ, Q.model) J ∞ f ↔
      ContMDiff I J ∞ (f ∘ (QuotientGroup.mk : G → G ⧸ K)) := by
  let := Q.chartedSpace
  exact Q.localSections.contMDiff_iff_comp Q.projection_smooth

end HomogeneousQuotient

variable [FiniteDimensional ℝ E] [I.Boundaryless] [T2Space G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'} [J.Boundaryless]
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]
  [T2Space K]

/-- An embedded Lie subgroup supplies a homogeneous quotient, together with a linear
splitting recording that the quotient model has the expected complementary dimension. -/
theorem exists_homogeneousQuotient_of_embeddedLieSubgroup
    (S : EmbeddedLieSubgroup I G J K) :
    ∃ Q : HomogeneousQuotient I G S.toImmersedLieSubgroup.subgroup,
      Nonempty ((Q.model × F) ≃L[ℝ] E) := by
  obtain ⟨P, L, hL⟩ := Manifold.exists_subgroup_transverse_model S.toImmersedLieSubgroup
  obtain ⟨A, hA1, _, _, _⟩ :=
    Manifold.exists_quotientSlice_of_embeddedLieSubgroup_complement S L hL
  exact ⟨HomogeneousQuotient.ofSlice P A hA1, ⟨L⟩⟩

/-- The smooth structure, quotient submersion, local sections, and smooth transitive action
are constructed from ordinary embedded Lie subgroup data. -/
theorem nonempty_homogeneousQuotient_of_embeddedLieSubgroup
    (S : EmbeddedLieSubgroup I G J K) :
    Nonempty (HomogeneousQuotient I G S.toImmersedLieSubgroup.subgroup) := by
  obtain ⟨Q, _⟩ := exists_homogeneousQuotient_of_embeddedLieSubgroup S
  exact ⟨Q⟩

end LieGroups

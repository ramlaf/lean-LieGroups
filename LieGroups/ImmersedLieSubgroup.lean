import LieGroups.ConnectedSubgroup
import LieGroups.Manifold.ImmersionLocalInverse

/-!
# Immersed Lie subgroups with their intrinsic manifolds

An immersed Lie subgroup is represented by an injective immersive group homomorphism
from a supplied Lie group. Its source keeps its own topology: it need not carry the
subspace topology of its image. `EmbeddedLieSubgroup` additionally requires a topological
embedding. The tangent Lie subalgebra is the range of the differentiated inclusion.

These structures record genuine manifold regularity. They do not assert existence of
an integrating group for an arbitrary Lie subalgebra.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open scoped Manifold ContDiff

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
  (G : Type*) [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] (J : ModelWithCorners ℝ F H')
  (K : Type*) [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]

/-- A Lie subgroup presented by an injective smooth immersion from its intrinsic Lie group. -/
structure ImmersedLieSubgroup [LieGroup I ∞ G] [LieGroup J ∞ K] where
  toMonoidHom : K →* G
  injective : Function.Injective toMonoidHom
  isImmersion : Manifold.IsImmersion J I ∞ (fun x => toMonoidHom x)

/-- An immersed Lie subgroup whose intrinsic topology agrees with its image topology. -/
structure EmbeddedLieSubgroup extends ImmersedLieSubgroup I G J K where
  isEmbedding : Topology.IsEmbedding (fun x => toMonoidHom x)

variable {I G J K}

namespace ImmersedLieSubgroup

/-- The actual immersion hypothesis supplies smoothness of the inclusion. -/
theorem contMDiff (S : ImmersedLieSubgroup I G J K) :
    ContMDiff J I ∞ (fun x => S.toMonoidHom x) :=
  S.isImmersion.contMDiff

/-- The underlying abstract subgroup of the ambient group. -/
def subgroup (S : ImmersedLieSubgroup I G J K) : Subgroup G := S.toMonoidHom.range

@[simp] theorem mem_subgroup (S : ImmersedLieSubgroup I G J K) (g : G) :
    g ∈ S.subgroup ↔ ∃ k : K, S.toMonoidHom k = g := Iff.rfl

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

/-- The tangent Lie subalgebra, defined using the differentiated inclusion. -/
noncomputable def lieAlgebra [CompleteSpace E] [CompleteSpace F]
    (S : ImmersedLieSubgroup I G J K) : LieSubalgebra ℝ (GroupLieAlgebra I G) :=
  (homLieHom S.toMonoidHom S.contMDiff).range

@[simp] theorem mem_lieAlgebra [CompleteSpace E] [CompleteSpace F]
    (S : ImmersedLieSubgroup I G J K) (v : GroupLieAlgebra I G) :
    v ∈ S.lieAlgebra ↔ ∃ w : GroupLieAlgebra J K,
      homLieDifferential S.toMonoidHom w = v := Iff.rfl

/-- The immersion normal form makes the differentiated inclusion injective. -/
theorem homLieDifferential_injective [J.Boundaryless]
    (S : ImmersedLieSubgroup I G J K) :
    Function.Injective (homLieDifferential (I := J) (J := I) S.toMonoidHom) :=
  Manifold.mfderiv_injective_of_isImmersionAt (S.isImmersion.isImmersionAt (1 : K))

/-- The intrinsic Lie algebra is canonically equivalent to the ambient tangent subalgebra. -/
noncomputable def lieAlgebraEquiv [CompleteSpace E] [CompleteSpace F] [J.Boundaryless]
    (S : ImmersedLieSubgroup I G J K) :
    GroupLieAlgebra J K ≃ₗ⁅ℝ⁆ S.lieAlgebra :=
  (homLieHom S.toMonoidHom S.contMDiff).equivRangeOfInjective
    S.homLieDifferential_injective

/-- Intrinsic connectedness implies connectedness of the subgroup's ambient image. -/
theorem isConnected_subgroup [ConnectedSpace K] (S : ImmersedLieSubgroup I G J K) :
    IsConnected (S.subgroup : Set G) :=
  isConnected_range S.contMDiff.continuous

/-- A connected finite-dimensional immersed subgroup is generated by its tangent exponentials. -/
theorem subgroup_eq_lieSubalgebraSubgroup [CompleteSpace E] [FiniteDimensional ℝ F]
    [BoundarylessManifold I G] [T2Space G]
    [BoundarylessManifold J K] [T2Space K] [ConnectedSpace K]
    (S : ImmersedLieSubgroup I G J K) :
    S.subgroup = lieSubalgebraSubgroup S.lieAlgebra :=
  range_eq_lieSubalgebraSubgroup S.toMonoidHom S.contMDiff

variable {D : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
  {H'' : Type*} [TopologicalSpace H''] {L : ModelWithCorners ℝ D H''}
  {Q : Type*} [Group Q] [TopologicalSpace Q] [ChartedSpace H'' Q] [LieGroup L ∞ Q]

/-- Connected finite-dimensional immersed subgroups with the same tangent Lie algebra
have the same image, even when their intrinsic source manifolds differ. -/
theorem subgroup_eq_of_lieAlgebra_eq [CompleteSpace E]
    [FiniteDimensional ℝ F] [FiniteDimensional ℝ D]
    [BoundarylessManifold I G] [T2Space G]
    [BoundarylessManifold J K] [T2Space K] [ConnectedSpace K]
    [BoundarylessManifold L Q] [T2Space Q] [ConnectedSpace Q]
    (S : ImmersedLieSubgroup I G J K) (T : ImmersedLieSubgroup I G L Q)
    (h : S.lieAlgebra = T.lieAlgebra) : S.subgroup = T.subgroup :=
  range_eq_of_homLieHom_range_eq S.toMonoidHom T.toMonoidHom S.contMDiff T.contMDiff h

/-- An identity presentation gives the ambient group as an immersed Lie subgroup. -/
def refl : ImmersedLieSubgroup I G I G where
  toMonoidHom := MonoidHom.id G
  injective := Function.injective_id
  isImmersion := Manifold.IsImmersion.id

@[simp] theorem subgroup_refl : (refl (I := I) (G := G)).subgroup = ⊤ := by
  ext x
  simp [mem_subgroup, refl]

@[simp] theorem lieAlgebra_refl [CompleteSpace E] :
    (refl (I := I) (G := G)).lieAlgebra = ⊤ := by
  ext v
  simp only [mem_lieAlgebra, refl, homLieDifferential_id, ContinuousLinearMap.id_apply,
    exists_eq, LieSubalgebra.mem_top]

end ImmersedLieSubgroup

namespace EmbeddedLieSubgroup

/-- An identity presentation is also embedded. -/
def refl : EmbeddedLieSubgroup I G I G where
  toImmersedLieSubgroup := ImmersedLieSubgroup.refl
  isEmbedding := Topology.IsEmbedding.id

end EmbeddedLieSubgroup

end LieGroups

import LieGroups.ConnectedGeneration
import LieGroups.HomomorphismLieAlgebra

/-!
# Uniqueness of integration on a connected Lie group

Smooth group homomorphisms with the same identity differential agree on every
exponential. Exponential generation then makes them equal on a connected source.
Simple connectedness is needed for existence, not for this uniqueness statement.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open scoped ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G] [T2Space G] [ConnectedSpace G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]
  [BoundarylessManifold J K] [T2Space K]

/-- A smooth homomorphism on a connected finite-dimensional Lie group is
determined by its differential at the identity. -/
theorem hom_eq_of_homLieDifferential_eq (f g : G →* K)
    (hf : ContMDiff I J ∞ (fun x => f x)) (hg : ContMDiff I J ∞ (fun x => g x))
    (h : homLieDifferential (I := I) (J := J) f = homLieDifferential g) : f = g := by
  have heq : f.eqLocus g = ⊤ := by
    apply subgroup_eq_top_of_lieExp_mem (I := I)
    intro v
    change f (lieExp v) = g (lieExp v)
    rw [lieExp_map f hf, lieExp_map g hg, h]
  ext x
  exact (show x ∈ f.eqLocus g from heq.symm ▸ Subgroup.mem_top x)

/-- Equality of the bundled Lie-algebra differentials also determines the
entire smooth group homomorphism. -/
theorem hom_eq_of_homLieHom_eq (f g : G →* K)
    (hf : ContMDiff I J ∞ (fun x => f x)) (hg : ContMDiff I J ∞ (fun x => g x))
    (h : homLieHom f hf = homLieHom g hg) : f = g := by
  apply hom_eq_of_homLieDifferential_eq f g hf hg
  ext v
  exact congrArg (fun q => q v) h

end LieGroups

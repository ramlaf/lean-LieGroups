/-!
# Smooth slices constructed from closedness

The integer-power limit theorem and finite-dimensional compactness exclude small
transverse exponentials in a closed subgroup. The inverse function theorem for
the product of tangent and transverse exponentials then straightens the subgroup.
No smooth structure on the subgroup is assumed.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Function Set Filter
open scoped Topology ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G] [T2Space G]

/-- A sufficiently small transverse exponential belongs to a closed subgroup
only when its transverse input is zero. -/
theorem exists_subgroup_transverse_exponential_ball (K : Subgroup G)
    (hK : IsClosed (K : Set G)) (Q : Submodule ℝ E)
    (hQ : Disjoint (subgroupTangentModel (I := I) K) Q) :
    ∃ ε > 0, ∀ x ∈ Q, ‖x‖ < ε →
      lieExp ((lieAlgebraModelEquiv (I := I) (G := G)).symm x) ∈ K → x = 0 := by
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  apply Analysis.exists_ball_inter_submodule_eq_zero_of_direction_limits
    (subgroupTangentModel (I := I) K) Q hQ
    {x | lieExp (e.symm x) ∈ K}
  intro u v hu hu0 hlim hdir
  apply (mem_subgroupTangentModel K v).mpr
  apply mem_subgroupTangentSet_of_oneParameterCurve
  intro t
  rw [← lieExp_smul]
  have hscale : Tendsto (fun n => ‖u n‖) atTop (𝓝 0) := by simpa using hlim.norm
  have hv : Tendsto (fun n => ‖u n‖⁻¹ • e.symm (u n)) atTop (𝓝 (e.symm v)) := by
    simpa only [Function.comp_def, map_smul] using e.symm.continuous.continuousAt.tendsto.comp hdir
  exact lieExp_smul_mem_of_scaled_tendsto K hK hscale
    (Eventually.of_forall (fun n => norm_ne_zero_iff.mpr (hu0 n))) hv
    (Eventually.of_forall hu) t

set_option backward.isDefEq.respectTransparency false in
/-- Every ordinary closed subgroup admits a genuine ambient smooth slice,
with horizontal model the subspace of its ambient curve velocities. -/
theorem exists_closedSubgroupChart (K : Subgroup G) (hK : IsClosed (K : Set G)) :
    ∃ Q : Submodule ℝ E,
      Nonempty (ClosedSubgroupChart I K (subgroupTangentModel (I := I) K) Q) := by
  let P := subgroupTangentModel (I := I) K
  obtain ⟨Q, hQ⟩ := P.exists_isCompl
  let L : (P × Q) ≃L[ℝ] E := (P.prodEquivOfIsCompl Q hQ).toContinuousLinearEquiv
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  have hleft (p : P) : L (p, 0) = (p : E) := by simp [L]
  have hright (q : Q) : L (0, q) = (q : E) := by simp [L]
  obtain ⟨D, hD0, hD1, hDEq⟩ :=
    Manifold.exists_lieExp_multiplication_chart_model (I := I) (G := G) L
  have hDEq' : EqOn (fun p : P × Q => lieExp (e.symm (p.1 : E)) *
      lieExp (e.symm (p.2 : E))) D D.source := by
    simpa only [hleft, hright] using hDEq
  obtain ⟨ε, hε, hsmall⟩ := exists_subgroup_transverse_exponential_ball K hK Q hQ.disjoint
  let V : Set (P × Q) := {p | ‖(p.2 : E)‖ < ε}
  have hV : IsOpen V := isOpen_lt (continuous_subtype_val.comp continuous_snd).norm continuous_const
  let O := D.toOpenPartialHomeomorph.restrOpen V hV
  let Φ : PartialDiffeomorph 𝓘(ℝ, P × Q) I (P × Q) G ∞ := {
    toPartialEquiv := O.toPartialEquiv
    open_source := O.open_source
    open_target := O.open_target
    contMDiffOn_toFun := D.contMDiffOn_toFun.mono (fun _ hx => hx.1)
    contMDiffOn_invFun := D.contMDiffOn_invFun.mono (fun _ hx => hx.1)
  }
  have hΦ0 : (0 : P × Q) ∈ Φ.source := ⟨hD0, by simpa [V] using hε⟩
  have hΦ1 : Φ 0 = 1 := hD1
  have hΦK (p : P × Q) (hp : p ∈ Φ.source) : Φ p ∈ K ↔ p.2 = 0 := by
    have hpD : p ∈ D.source := hp.1
    have hE : lieExp (e.symm (p.1 : E)) * lieExp (e.symm (p.2 : E)) = Φ p :=
      hDEq' hpD
    have hpK : lieExp (e.symm (p.1 : E)) ∈ K := by
      have hv := (mem_subgroupTangentModel K (p.1 : E)).mp p.1.property
      simpa only [one_smul] using lieExp_smul_mem_of_mem_subgroupTangentSet K hK hv 1
    constructor
    · intro hmem
      have hqK : lieExp (e.symm (p.2 : E)) ∈ K := by
        have hh := K.mul_mem (K.inv_mem hpK) hmem
        rw [← hE, inv_mul_cancel_left] at hh
        exact hh
      exact Subtype.ext (hsmall _ p.2.property hp.2 hqK)
    · intro hq
      rw [hq] at hE
      simp only [Submodule.coe_zero, map_zero, lieExp_zero, mul_one] at hE
      exact hE ▸ hpK
  refine ⟨Q, ⟨{
    chart := Φ.symm
    one_mem_source := hΦ1 ▸ Φ.map_source hΦ0
    chart_one := ?_
    mem_iff := ?_
  }⟩⟩
  · change Φ.toPartialEquiv.symm 1 = 0
    rw [← hΦ1]
    exact Φ.left_inv hΦ0
  · intro g hg
    have hp := hΦK (Φ.toPartialEquiv.symm g) (Φ.map_target hg)
    rwa [Φ.right_inv hg] at hp

end LieGroups

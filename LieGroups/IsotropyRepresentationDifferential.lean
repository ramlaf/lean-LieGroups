/-!
# The differential of the tangent isotropy representation

The actual tangent representation has infinitesimal action induced by the ambient
Lie bracket. Adjoint covariance identifies its one-parameter derivatives.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-22.
-/

noncomputable section
open scoped ContDiff Manifold Topology
set_option backward.isDefEq.respectTransparency false

namespace LieGroups

variable {E F H H' G M V : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H}
  [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'}
  [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [TopologicalSpace M] [ChartedSpace H' M] [IsManifold J ∞ M]
  [MulAction G M] [ContMDiffSMul I J ∞ G M]
  [NormedAddCommGroup V] [NormedSpace ℝ V]
  {D H'' L : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
  [TopologicalSpace H''] {I' : ModelWithCorners ℝ D H''}
  [Group L] [TopologicalSpace L] [ChartedSpace H'' L] [LieGroup I' ∞ L]

variable [FiniteDimensional ℝ E] [I.Boundaryless] [T2Space G]
  [SimplyConnectedSpace G] [FiniteDimensional ℝ D]
  [BoundarylessManifold I' L] [T2Space L]

/-- The infinitesimal tangent isotropy action is the ambient Lie bracket, pushed
through the actual orbit differential. The derivative identity is proved from
adjoint covariance, rather than supplied as a hypothesis. -/
theorem representationDifferential_fixedPointTangentRepresentationOfHom
    (f : L →* G) (hf : ContMDiff I' I ∞ (fun k => f k)) (o : M)
    (hfix : ∀ k : L, f k • o = o) (e : V ≃L[ℝ] TangentSpace J o)
    (X : GroupLieAlgebra I' L) (Y : GroupLieAlgebra I G) :
    representationDifferential
        (fixedPointTangentRepresentationOfHom f hf o hfix e) X
        (e.symm (orbitLieDifferential (I := I) (J := J) o Y)) =
      e.symm (orbitLieDifferential (I := I) (J := J) o
        ⁅homLieDifferential (I := I') (J := I) f X, Y⁆) := by
  let ρ := fixedPointTangentRepresentationOfHom f hf o hfix e
  let a := lieAlgebraModelEquiv (I := I) (G := G)
  let P : E →L[ℝ] V := e.symm.toContinuousLinearMap.comp
    ((orbitLieDifferential (I := I) (J := J) o).comp a.symm.toContinuousLinearMap)
  have hP (Z : GroupLieAlgebra I G) : P (a Z) =
      e.symm (orbitLieDifferential (I := I) (J := J) o Z) := by simp [P]
  have hρ := (contMDiff_fixedPointTangentRepresentationOfHom f hf o hfix e).mdifferentiable
    (by simp : (∞ : ℕ∞ω) ≠ 0)
  have hl := (hasDerivAt_representation_oneParameterCurve_zero ρ hρ X).clm_apply
    (hasDerivAt_const 0 (e.symm (orbitLieDifferential (I := I) (J := J) o Y)))
  have hr := P.hasFDerivAt.comp_hasDerivAt 0
    (hasDerivAt_lieAdjoint_oneParameterCurve_zero
      (homLieDifferential (I := I') (J := I) f X) Y)
  have heq : (fun t => ρ (oneParameterCurve X t)
      (e.symm (orbitLieDifferential (I := I) (J := J) o Y))) =
      (fun t => P (a (lieAdjoint (I := I)
        (oneParameterCurve (homLieDifferential (I := I') (J := I) f X) t) Y))) := by
    funext t
    rw [hP]
    change fixedPointTangentRepresentationOfHom f hf o hfix e (oneParameterCurve X t) _ = _
    rw [fixedPointTangentRepresentationOfHom_orbitLieDifferential,
      oneParameterCurve_map f hf]
  rw [heq] at hl
  have h := hl.unique hr
  simp only [map_zero, add_zero] at h
  change representationDifferential ρ X
      (e.symm (orbitLieDifferential (I := I) (J := J) o Y)) =
    P (a ⁅homLieDifferential (I := I') (J := I) f X, Y⁆) at h
  rw [hP] at h
  exact h


/-- Bracket skewness integrates to preservation of the origin bilinear form
under a connected isotropy group, provided the orbit differential spans the
origin tangent space. -/
theorem bilinear_fixedPointTangentRepresentationOfHom_of_bracket [ConnectedSpace L]
    (f : L →* G) (hf : ContMDiff I' I ∞ (fun k => f k)) (o : M)
    (hfix : ∀ k : L, f k • o = o) (e : V ≃L[ℝ] TangentSpace J o)
    (B : V →L[ℝ] V →L[ℝ] ℝ)
    (hsurj : Function.Surjective
      (fun Y : GroupLieAlgebra I G =>
        e.symm (orbitLieDifferential (I := I) (J := J) o Y)))
    (hskew : ∀ (X : GroupLieAlgebra I' L) (Y Z : GroupLieAlgebra I G),
      B (e.symm (orbitLieDifferential (I := I) (J := J) o
          ⁅homLieDifferential (I := I') (J := I) f X, Y⁆))
          (e.symm (orbitLieDifferential (I := I) (J := J) o Z)) +
        B (e.symm (orbitLieDifferential (I := I) (J := J) o Y))
          (e.symm (orbitLieDifferential (I := I) (J := J) o
            ⁅homLieDifferential (I := I') (J := I) f X, Z⁆)) = 0)
    (k : L) (u v : V) :
    B (fixedPointTangentRepresentationOfHom f hf o hfix e k u)
        (fixedPointTangentRepresentationOfHom f hf o hfix e k v) = B u v := by
  apply bilinear_representation_of_infinitesimal
    (fixedPointTangentRepresentationOfHom f hf o hfix e)
    ((contMDiff_fixedPointTangentRepresentationOfHom f hf o hfix e).mdifferentiable (by simp))
  intro X u v
  obtain ⟨Y, rfl⟩ := hsurj u
  obtain ⟨Z, rfl⟩ := hsurj v
  rw [representationDifferential_fixedPointTangentRepresentationOfHom,
    representationDifferential_fixedPointTangentRepresentationOfHom]
  exact hskew X Y Z

end LieGroups

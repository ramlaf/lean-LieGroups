import LieGroups.LieSubalgebraIntegration
import LieGroups.Manifold.QuotientSlice
import Mathlib.Algebra.Lie.Prod

/-!
# Graph Lie subalgebras of group Lie algebras

The tangent Lie algebra of a product group identifies with the product tangent Lie
algebra. The graph of a Lie homomorphism is therefore a Lie subalgebra to which the
connected immersed-subgroup theorem applies.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open scoped Topology ContDiff Manifold

namespace LieGroups

set_option backward.isDefEq.respectTransparency false

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {HE : Type*} [TopologicalSpace HE] {I : ModelWithCorners ℝ E HE}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace HE G] [LieGroup I ∞ G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {HF : Type*} [TopologicalSpace HF] {J : ModelWithCorners ℝ F HF}
  {H : Type*} [Group H] [TopologicalSpace H] [ChartedSpace HF H] [LieGroup J ∞ H]

/-- The differential of the first product projection. -/
def productSourceLieHom : GroupLieAlgebra (I.prod J) (G × H) →ₗ⁅ℝ⁆ GroupLieAlgebra I G :=
  homLieHom (MonoidHom.fst G H) contMDiff_fst

/-- The differential of the second product projection. -/
def productTargetLieHom : GroupLieAlgebra (I.prod J) (G × H) →ₗ⁅ℝ⁆ GroupLieAlgebra J H :=
  homLieHom (MonoidHom.snd G H) contMDiff_snd

@[simp] theorem productSourceLieHom_apply (v : GroupLieAlgebra (I.prod J) (G × H)) :
    productSourceLieHom (I := I) (J := J) v = v.1 := by
  change homLieDifferential (I := I.prod J) (J := I) (MonoidHom.fst G H) v = v.1
  rw [homLieDifferential, MonoidHom.coe_fst, mfderiv_fst]
  rfl

@[simp] theorem productTargetLieHom_apply (v : GroupLieAlgebra (I.prod J) (G × H)) :
    productTargetLieHom (I := I) (J := J) v = v.2 := by
  change homLieDifferential (I := I.prod J) (J := J) (MonoidHom.snd G H) v = v.2
  rw [homLieDifferential, MonoidHom.coe_snd, mfderiv_snd]
  rfl

/-- The graph of a Lie algebra homomorphism inside the product group's Lie algebra. -/
def lieHomomorphismGraph (φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J H) :
    LieSubalgebra ℝ (GroupLieAlgebra (I.prod J) (G × H)) where
  carrier := {v | productTargetLieHom (I := I) (J := J) v =
    φ (productSourceLieHom (I := I) (J := J) v)}
  add_mem' {v w} hv hw := by
    change productTargetLieHom (v + w) = φ (productSourceLieHom (v + w))
    change productTargetLieHom v = φ (productSourceLieHom v) at hv
    change productTargetLieHom w = φ (productSourceLieHom w) at hw
    rw [map_add, map_add, map_add, hv, hw]
  zero_mem' := by change productTargetLieHom 0 = φ (productSourceLieHom 0); simp
  smul_mem' t v hv := by
    change productTargetLieHom (t • v) = φ (productSourceLieHom (t • v))
    change productTargetLieHom v = φ (productSourceLieHom v) at hv
    rw [map_smul, map_smul, map_smul, hv]
  lie_mem' {v w} hv hw := by
    change productTargetLieHom ⁅v, w⁆ = φ (productSourceLieHom ⁅v, w⁆)
    change productTargetLieHom v = φ (productSourceLieHom v) at hv
    change productTargetLieHom w = φ (productSourceLieHom w) at hw
    rw [LieHom.map_lie, LieHom.map_lie, φ.map_lie, hv, hw]

@[simp] theorem mem_lieHomomorphismGraph
    (φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J H)
    (v : GroupLieAlgebra (I.prod J) (G × H)) :
    v ∈ lieHomomorphismGraph φ ↔ v.2 = φ v.1 := by
  change productTargetLieHom v = φ (productSourceLieHom v) ↔ _
  rw [productTargetLieHom_apply, productSourceLieHom_apply]

end LieGroups

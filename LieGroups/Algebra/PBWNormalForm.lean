import LieGroups.Algebra.EnvelopingWords
import LieGroups.Algebra.WordStraightening
import Mathlib.LinearAlgebra.Finsupp.Supported

/-!
# A terminating ordered-word normalization procedure

Choose one adjacent descent in each unordered word, and recursively replace it
by the swapped word and its bracket corrections. Shortlex decreases at every
recursive call. The output has ordered support and does not increase word length.
No independence of the chosen descent or PBW independence is assumed here.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module
open scoped BigOperators

namespace LieGroups

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] [LinearOrder ι]

/-- An adjacent descending pair in a word, together with its prefix and suffix. -/
structure PBWAdjacentDescent (w : List ι) where
  «prefix» : List ι
  left : ι
  right : ι
  suffix : List ι
  eq_word : w = «prefix» ++ left :: right :: suffix
  lt : right < left

namespace PBWAdjacentDescent

variable {w : List ι} (d : PBWAdjacentDescent w)

/-- The word after swapping the specified descending pair. -/
def swapped : List ι := d.prefix ++ d.right :: d.left :: d.suffix

/-- The shorter word replacing the pair by one basis letter. -/
def contract (k : ι) : List ι := d.prefix ++ k :: d.suffix

theorem swapped_shortlex : List.Shortlex (· < ·) d.swapped w := by
  rcases d with ⟨p, a, c, s, rfl, hlt⟩
  exact shortlex_swap_descent p s hlt

theorem contract_shortlex (k : ι) : List.Shortlex (· < ·) (d.contract k) w := by
  rcases d with ⟨p, a, c, s, rfl, _hlt⟩
  exact shortlex_contract_pair p s a c k

theorem swapped_length : d.swapped.length = w.length := by
  rcases d with ⟨p, a, c, s, rfl, _hlt⟩
  simp only [swapped, List.length_append, List.length_cons]

theorem contract_length_lt (k : ι) : (d.contract k).length < w.length := by
  rcases d with ⟨p, a, c, s, rfl, _hlt⟩
  simp only [contract, List.length_append, List.length_cons]
  omega

include d in
theorem not_ordered : ¬ w.Pairwise (· ≤ ·) := by
  rcases d with ⟨p, a, c, s, rfl, hlt⟩
  intro hw
  have htail := (List.pairwise_append.mp hw).2.1
  have hac := (List.pairwise_cons.mp htail).1 c (by simp)
  exact (not_le_of_gt hlt) hac

end PBWAdjacentDescent

/-- A fixed adjacent descent selected from each unordered word. -/
def pbwChosenDescent (w : List ι) (hw : ¬ w.Pairwise (· ≤ ·)) : PBWAdjacentDescent w := by
  classical
  have h : Nonempty (PBWAdjacentDescent w) := by
    obtain ⟨p, a, c, s, heq, hlt⟩ := exists_adjacent_descent w hw
    exact ⟨⟨p, a, c, s, heq, hlt⟩⟩
  exact Classical.choice h

/-- The formal right side of one adjacent-descent rewrite. -/
def pbwReduceDescent (b : Basis ι R L) {w : List ι} (d : PBWAdjacentDescent w) :
    List ι →₀ R :=
  Finsupp.single d.swapped 1 +
    ∑ k ∈ (b.repr ⁅b d.left, b d.right⁆).support,
      b.repr ⁅b d.left, b d.right⁆ k • Finsupp.single (d.contract k) 1

private def pbwNormalFormStep (b : Basis ι R L) (w : List ι)
    (rec : ∀ v, List.Shortlex (· < ·) v w → (List ι →₀ R)) : List ι →₀ R :=
  if hw : w.Pairwise (· ≤ ·) then Finsupp.single w 1 else
    let d := pbwChosenDescent w hw
    rec d.swapped d.swapped_shortlex +
      ∑ k ∈ (b.repr ⁅b d.left, b d.right⁆).support,
        b.repr ⁅b d.left, b d.right⁆ k • rec (d.contract k) (d.contract_shortlex k)

/-- The shortlex well-founded relation used for PBW word normalization. -/
theorem pbwWordWellFounded [WellFoundedLT ι] :
    WellFounded (List.Shortlex ((· < ·) : ι → ι → Prop)) :=
  List.Shortlex.wf wellFounded_lt

/-- A recursively constructed ordered normal form using the selected descent.
Choice independence is a separate theorem. -/
def pbwNormalForm [WellFoundedLT ι] (b : Basis ι R L) : List ι → (List ι →₀ R) :=
  pbwWordWellFounded.fix (pbwNormalFormStep b)

private theorem pbwNormalForm_unfold [WellFoundedLT ι] (b : Basis ι R L) (w : List ι) :
    pbwNormalForm b w = pbwNormalFormStep b w (fun v _ => pbwNormalForm b v) := by
  unfold pbwNormalForm
  exact WellFounded.fix_eq _ _ w

/-- Ordered words are fixed by the normalization procedure. -/
theorem pbwNormalForm_eq_ordered [WellFoundedLT ι] (b : Basis ι R L) {w : List ι}
    (hw : w.Pairwise (· ≤ ·)) : pbwNormalForm b w = Finsupp.single w 1 := by
  rw [pbwNormalForm_unfold, pbwNormalFormStep, dite_eq_left hw]

/-- The recursive equation for the chosen adjacent descent. -/
theorem pbwNormalForm_eq_chosen [WellFoundedLT ι] (b : Basis ι R L) (w : List ι)
    (hw : ¬ w.Pairwise (· ≤ ·)) :
    pbwNormalForm b w =
      pbwNormalForm b (pbwChosenDescent w hw).swapped +
        ∑ k ∈ (b.repr ⁅b (pbwChosenDescent w hw).left,
            b (pbwChosenDescent w hw).right⁆).support,
          b.repr ⁅b (pbwChosenDescent w hw).left, b (pbwChosenDescent w hw).right⁆ k •
            pbwNormalForm b ((pbwChosenDescent w hw).contract k) := by
  rw [pbwNormalForm_unfold, pbwNormalFormStep, dite_eq_right hw]

/-- Linear extension of the recursively constructed word normal forms. -/
def pbwNormalFormLinear [WellFoundedLT ι] (b : Basis ι R L) :
    (List ι →₀ R) →ₗ[R] (List ι →₀ R) :=
  Finsupp.linearCombination R (pbwNormalForm b)

@[simp]
theorem pbwNormalFormLinear_single [WellFoundedLT ι] (b : Basis ι R L) (w : List ι) (r : R) :
    pbwNormalFormLinear b (Finsupp.single w r) = r • pbwNormalForm b w := by
  exact Finsupp.linearCombination_single R r w

/-- Applying the linear normal form to the chosen rewrite gives the same value. -/
theorem pbwNormalFormLinear_reduce_chosen [WellFoundedLT ι] (b : Basis ι R L) (w : List ι)
    (hw : ¬ w.Pairwise (· ≤ ·)) :
    pbwNormalFormLinear b (pbwReduceDescent b (pbwChosenDescent w hw)) = pbwNormalForm b w := by
  rw [pbwNormalForm_eq_chosen b w hw]
  simp only [pbwReduceDescent, map_add, map_sum, map_smul, pbwNormalFormLinear_single, one_smul]

/-- The normal-form output is supported on ordered words of bounded length. -/
theorem pbwNormalForm_mem_supported [WellFoundedLT ι] (b : Basis ι R L) (w : List ι) :
    pbwNormalForm b w ∈ Finsupp.supported R R
      {v : List ι | v.Pairwise (· ≤ ·) ∧ v.length ≤ w.length} := by
  have hWF : WellFounded (List.Shortlex ((· < ·) : ι → ι → Prop)) := pbwWordWellFounded
  induction w using hWF.induction with
  | h w ih =>
    by_cases hw : w.Pairwise (· ≤ ·)
    · rw [pbwNormalForm_eq_ordered b hw]
      exact Finsupp.single_mem_supported R 1 ⟨hw, le_rfl⟩
    · rw [pbwNormalForm_eq_chosen b w hw]
      let d := pbwChosenDescent w hw
      have hd (v : List ι) (hv : List.Shortlex (· < ·) v w) (hvl : v.length ≤ w.length) :
          pbwNormalForm b v ∈ Finsupp.supported R R
            {u : List ι | u.Pairwise (· ≤ ·) ∧ u.length ≤ w.length} := by
        apply Finsupp.supported_mono (s := {u : List ι |
          u.Pairwise (· ≤ ·) ∧ u.length ≤ v.length}) ?_ (ih v hv)
        intro u hu
        exact ⟨hu.1, hu.2.trans hvl⟩
      apply Submodule.add_mem
      · exact hd d.swapped d.swapped_shortlex d.swapped_length.le
      · apply Submodule.sum_mem
        intro k _
        apply Submodule.smul_mem
        exact hd (d.contract k) (d.contract_shortlex k) (d.contract_length_lt k).le

/-- Every nonzero output coefficient belongs to an ordered word, and no output
word is longer than the input. -/
theorem pbwNormalForm_support [WellFoundedLT ι] (b : Basis ι R L) (w : List ι)
    {v : List ι} (hv : v ∈ (pbwNormalForm b w).support) :
    v.Pairwise (· ≤ ·) ∧ v.length ≤ w.length :=
  (Finsupp.mem_supported R (pbwNormalForm b w)).mp (pbwNormalForm_mem_supported b w) hv

/-- The linear normalization fixes every formal combination of ordered words. -/
theorem pbwNormalFormLinear_eq_self [WellFoundedLT ι] (b : Basis ι R L)
    (f : List ι →₀ R) (hf : ∀ w ∈ f.support, w.Pairwise (· ≤ ·)) :
    pbwNormalFormLinear b f = f := by
  classical
  change f.sum (fun w r => r • pbwNormalForm b w) = f
  conv_rhs => rw [← f.sum_single]
  apply Finset.sum_congr rfl
  intro w hw
  change f w • pbwNormalForm b w = Finsupp.single w (f w)
  rw [pbwNormalForm_eq_ordered b (hf w hw)]
  simp only [Finsupp.smul_single, smul_eq_mul, mul_one]

/-- Normalization is idempotent, since its output already has ordered support. -/
theorem pbwNormalFormLinear_normalForm [WellFoundedLT ι] (b : Basis ι R L) (w : List ι) :
    pbwNormalFormLinear b (pbwNormalForm b w) = pbwNormalForm b w := by
  apply pbwNormalFormLinear_eq_self
  intro v hv
  exact (pbwNormalForm_support b w hv).1

end LieGroups

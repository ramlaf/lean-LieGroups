import LieGroups.Algebra.Ado.General
import Mathlib.Algebra.Algebra.Equiv
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-!
# Ado's theorem

Every finite-dimensional Lie algebra over a field of characteristic zero has a
faithful finite-dimensional representation. The underlying proof is adapted
from Miyahara Kō's Apache-licensed formalization; see `Ado/README.md` for its
source, revision, and the compatibility changes.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

universe uK uL

variable (K : Type uK) (L : Type uL) [Field K] [CharZero K]
  [LieRing L] [LieAlgebra K L] [FiniteDimensional K L]

/-- A chosen faithful finite-dimensional module supplied by Ado's theorem. -/
abbrev AdoModule := AdoSpace K L

/-- Ado's faithful representation, constructed from the Lie algebra alone. -/
def adoRepresentation : L →ₗ⁅K⁆ Module.End K (AdoModule K L) :=
  LieModule.toEnd K L (AdoModule K L)

theorem adoRepresentation_injective : Function.Injective (adoRepresentation K L) :=
  LieModule.IsFaithful.injective_toEnd (R := K) (L := L) (M := AdoModule K L)

/-- Ado's theorem with the representation space expressed as a finite
coordinate space over the original field. -/
theorem exists_faithful_finiteDimensional_representation :
    ∃ (n : ℕ) (ρ : L →ₗ⁅K⁆ Module.End K (Fin n → K)), Function.Injective ρ := by
  let V := AdoModule K L
  let e : V ≃ₗ[K] (Fin (Module.finrank K V) → K) := (Module.finBasis K V).equivFun
  refine ⟨Module.finrank K V,
    (e.conjAlgEquiv K).toLieEquiv.toLieHom.comp (adoRepresentation K L), ?_⟩
  exact (e.conjAlgEquiv K).injective.comp (adoRepresentation_injective K L)

end LieGroups

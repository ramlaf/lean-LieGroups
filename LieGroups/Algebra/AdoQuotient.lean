import LieGroups.Algebra.AdoSemidirect
import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# Quotients of the enveloping semidirect representation

A subspace stable under left multiplication by Lie generators and under all
extended derivations gives an actual quotient representation. Evaluation at
one and at the Lie generators proves faithfulness when the subspace contains
no nonzero Lie generator. The existence of suitable finite-codimensional
subspaces is a separate part of Ado's theorem.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable {R L V : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [AddCommGroup V] [Module R V]

/-- Descend an actual Lie representation through an invariant vector subspace. -/
def quotientLieRepresentation (ρ : L →ₗ⁅R⁆ Module.End R V)
    (J : Submodule R V) (hJ : ∀ x : L, ∀ v ∈ J, ρ x v ∈ J) :
    L →ₗ⁅R⁆ Module.End R (V ⧸ J) where
  toFun x := J.mapQ J (ρ x) (fun v hv => hJ x v hv)
  map_add' x y := by
    apply Submodule.linearMap_qext
    apply LinearMap.ext
    intro v
    change J.mkQ (ρ (x + y) v) = J.mkQ (ρ x v) + J.mkQ (ρ y v)
    rw [map_add, LinearMap.add_apply, map_add]
  map_smul' t x := by
    apply Submodule.linearMap_qext
    apply LinearMap.ext
    intro v
    change J.mkQ (ρ (t • x) v) = t • J.mkQ (ρ x v)
    rw [map_smul, LinearMap.smul_apply, map_smul]
  map_lie' := by
    intro x y
    apply Submodule.linearMap_qext
    apply LinearMap.ext
    intro v
    change J.mkQ (ρ ⁅x, y⁆ v) = J.mkQ (ρ x (ρ y v)) - J.mkQ (ρ y (ρ x v))
    rw [LieHom.map_lie]
    change J.mkQ (ρ x (ρ y v) - ρ y (ρ x v)) = _
    exact map_sub _ _ _

@[simp]
theorem quotientLieRepresentation_mk (ρ : L →ₗ⁅R⁆ Module.End R V)
    (J : Submodule R V) (hJ : ∀ x : L, ∀ v ∈ J, ρ x v ∈ J) (x : L) (v : V) :
    quotientLieRepresentation ρ J hJ x (J.mkQ v) = J.mkQ (ρ x v) := rfl

variable (R L)

local notation "U" => UniversalEnvelopingAlgebra R L
local notation "ι" => UniversalEnvelopingAlgebra.ι R

/-- Quotient the enveloping semidirect action by a subspace stable under its
two defining operations. -/
def envelopingSemidirectQuotientRepresentation (J : Submodule R U)
    (hleft : ∀ x : L, ∀ u ∈ J, ι x * u ∈ J)
    (hderiv : ∀ D : LieDerivation R L L, ∀ u ∈ J, envelopingDerivationLinear D u ∈ J) :
    DerivationSemidirect R L →ₗ⁅R⁆ Module.End R (U ⧸ J) :=
  quotientLieRepresentation (envelopingSemidirectRepresentation R L) J
    (fun p u hu => J.add_mem (hleft p.left u hu) (hderiv p.right u hu))

@[simp]
theorem envelopingSemidirectQuotientRepresentation_mk (J : Submodule R U)
    (hleft : ∀ x : L, ∀ u ∈ J, ι x * u ∈ J)
    (hderiv : ∀ D : LieDerivation R L L, ∀ u ∈ J, envelopingDerivationLinear D u ∈ J)
    (p : DerivationSemidirect R L) (u : U) :
    envelopingSemidirectQuotientRepresentation R L J hleft hderiv p (J.mkQ u) =
      J.mkQ (ι p.left * u + envelopingDerivationLinear p.right u) := rfl

/-- The quotient representation is faithful as soon as its quotient projection
separates the original Lie generators. No additional representation is supplied. -/
theorem envelopingSemidirectQuotientRepresentation_injective (J : Submodule R U)
    (hleft : ∀ x : L, ∀ u ∈ J, ι x * u ∈ J)
    (hderiv : ∀ D : LieDerivation R L L, ∀ u ∈ J, envelopingDerivationLinear D u ∈ J)
    (hsep : ∀ x : L, ι x ∈ J → x = 0) :
    Function.Injective (envelopingSemidirectQuotientRepresentation R L J hleft hderiv) := by
  apply (LieHom.ker_eq_bot _).mp
  apply le_antisymm _ bot_le
  intro p hp
  change p = 0
  have hpzero := LieHom.mem_ker.mp hp
  have hpl : p.left = 0 := by
    apply hsep
    have h := congrArg (fun f : Module.End R (U ⧸ J) => f (J.mkQ 1)) hpzero
    change J.mkQ (ι p.left * 1 + envelopingDerivationLinear p.right 1) = 0 at h
    rw [envelopingDerivationLinear_one, mul_one, add_zero] at h
    exact (Submodule.Quotient.mk_eq_zero J).mp h
  have hpr : p.right = 0 := by
    apply LieDerivation.ext
    intro x
    change p.right x = 0
    apply hsep
    have h := congrArg (fun f : Module.End R (U ⧸ J) => f (J.mkQ (ι x))) hpzero
    change J.mkQ (ι p.left * ι x + envelopingDerivationLinear p.right (ι x)) = 0 at h
    rw [hpl, map_zero, zero_mul, zero_add, envelopingDerivationLinear_ι] at h
    exact (Submodule.Quotient.mk_eq_zero J).mp h
  exact LieAlgebra.SemiDirectSum.ext hpl hpr

end LieGroups

import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.Algebra.Lie.Abelian
import Mathlib.Algebra.Lie.Prod
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.RingTheory.Artinian.Module

/-!
# Representation separation and universal enveloping algebras

Every associative representation factors through the universal enveloping
algebra, so its kernel contains the kernel of the canonical Lie homomorphism.
This proves injectivity for Lie algebras with an actual faithful representation
and bounds the canonical kernel by the center without invoking PBW.

For a finite-dimensional Lie algebra, a separating family of representations
has a finite separating subfamily. The block diagonal representation on the
finite product is then faithful. These statements isolate concrete prerequisites
for general faithful-representation existence; they do not assume or prove PBW
or the general existence of a separating family of finite-dimensional modules.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

/-- The canonical enveloping kernel is killed by every associative
representation, directly from the universal property. -/
theorem universalEnveloping_ker_le_ker
    {A : Type*} [Ring A] [Algebra R A] (ρ : L →ₗ⁅R⁆ A) :
    (UniversalEnvelopingAlgebra.ι R : L →ₗ⁅R⁆ UniversalEnvelopingAlgebra R L).ker ≤ ρ.ker := by
  intro x hx
  rw [LieHom.mem_ker] at hx ⊢
  rw [← UniversalEnvelopingAlgebra.lift_ι_apply R ρ x, hx, map_zero]

/-- An actual injective associative representation proves injectivity of the
canonical enveloping map without a PBW assumption. -/
theorem universalEnveloping_ι_injective_of_injective_lieHom
    {A : Type*} [Ring A] [Algebra R A] (ρ : L →ₗ⁅R⁆ A) (hρ : Function.Injective ρ) :
    Function.Injective (UniversalEnvelopingAlgebra.ι R : L → UniversalEnvelopingAlgebra R L) := by
  apply (UniversalEnvelopingAlgebra.ι R).ker_eq_bot.mp
  apply le_antisymm _ bot_le
  exact (universalEnveloping_ker_le_ker ρ).trans (ρ.ker_eq_bot.mpr hρ).le

/-- The adjoint representation detects every noncentral element of the kernel;
only the center can obstruct injectivity before PBW is proved. -/
theorem universalEnveloping_ker_le_center :
    (UniversalEnvelopingAlgebra.ι R : L →ₗ⁅R⁆ UniversalEnvelopingAlgebra R L).ker ≤
      LieAlgebra.center R L := by
  have h := universalEnveloping_ker_le_ker (LieAlgebra.ad R L)
  simpa only [LieAlgebra.ad_ker_eq_self_module_ker,
    LieAlgebra.self_module_ker_eq_center] using h

/-- A center-free Lie algebra embeds into its universal enveloping algebra,
using its actual adjoint representation. -/
theorem universalEnveloping_ι_injective_of_center_eq_bot
    (h : LieAlgebra.center R L = ⊥) :
    Function.Injective (UniversalEnvelopingAlgebra.ι R : L → UniversalEnvelopingAlgebra R L) := by
  apply (UniversalEnvelopingAlgebra.ι R).ker_eq_bot.mp
  exact le_antisymm (h ▸ universalEnveloping_ker_le_center) bot_le

/-- To prove injectivity of the enveloping map it suffices for an actual
associative representation to separate elements of the center. -/
theorem universalEnveloping_ι_injective_of_separates_center
    {A : Type*} [Ring A] [Algebra R A] (ρ : L →ₗ⁅R⁆ A)
    (hρ : ∀ x ∈ LieAlgebra.center R L, ρ x = 0 → x = 0) :
    Function.Injective (UniversalEnvelopingAlgebra.ι R : L → UniversalEnvelopingAlgebra R L) := by
  apply (UniversalEnvelopingAlgebra.ι R).ker_eq_bot.mp
  apply le_antisymm _ bot_le
  intro x hx
  change x = 0
  exact hρ x (universalEnveloping_ker_le_center hx)
    (LieHom.mem_ker.mp (universalEnveloping_ker_le_ker ρ hx))

/-- Combining the adjoint representation with a representation that separates
the center gives an actual injective Lie homomorphism. -/
theorem lieHom_prod_ad_injective_of_separates_center
    {A : Type*} [Ring A] [Algebra R A] (ρ : L →ₗ⁅R⁆ A)
    (hρ : ∀ x ∈ LieAlgebra.center R L, ρ x = 0 → x = 0) :
    Function.Injective ((LieAlgebra.ad R L).prod ρ) := by
  apply ((LieAlgebra.ad R L).prod ρ).ker_eq_bot.mp
  apply le_antisymm _ bot_le
  intro x hx
  change x = 0
  rw [LieHom.mem_ker] at hx
  have hx_ad : x ∈ (LieAlgebra.ad R L).ker :=
    LieHom.mem_ker.mpr (congrArg Prod.fst hx)
  have hx_center : x ∈ LieAlgebra.center R L := by
    simpa only [LieAlgebra.ad_ker_eq_self_module_ker,
      LieAlgebra.self_module_ker_eq_center] using hx_ad
  exact hρ x hx_center (congrArg Prod.snd hx)

variable {ι : Type*} {V : ι → Type*} [∀ i, AddCommGroup (V i)] [∀ i, Module R (V i)]

/-- The block diagonal representation on a finite product of modules. -/
def finiteProductRepresentation (s : Finset ι) (ρ : ∀ i, L →ₗ⁅R⁆ Module.End R (V i)) :
    L →ₗ⁅R⁆ Module.End R (∀ i : s, V i.1) where
  toFun x := LinearMap.pi fun i => (ρ i.1 x).comp (LinearMap.proj i)
  map_add' x y := by
    ext v i
    exact congrArg (fun f : Module.End R (V i.1) => f (v i)) ((ρ i.1).map_add x y)
  map_smul' t x := by
    ext v i
    exact congrArg (fun f : Module.End R (V i.1) => f (v i)) ((ρ i.1).map_smul t x)
  map_lie' {x y} := by
    ext v i
    exact congrArg (fun f : Module.End R (V i.1) => f (v i)) ((ρ i.1).map_lie x y)

@[simp] theorem finiteProductRepresentation_apply (s : Finset ι)
    (ρ : ∀ i, L →ₗ⁅R⁆ Module.End R (V i)) (x : L) (v : ∀ i : s, V i.1) (i : s) :
    finiteProductRepresentation s ρ x v i = ρ i.1 x (v i) := rfl

section Artinian

variable [IsArtinian R L]

/-- For an Artinian Lie algebra, in particular a finite-dimensional Lie algebra
over a field, a point-separating family has a finite separating subfamily. -/
theorem exists_finite_separating_representations
    (ρ : ∀ i, L →ₗ⁅R⁆ Module.End R (V i))
    (hρ : ∀ x : L, (∀ i, ρ i x = 0) → x = 0) :
    ∃ s : Finset ι, ∀ x : L, (∀ i ∈ s, ρ i x = 0) → x = 0 := by
  obtain ⟨s, hs⟩ := Finset.exists_inf_le (fun i => (ρ i).ker.toSubmodule)
  refine ⟨s, fun x hx => hρ x fun i => ?_⟩
  have hmem : x ∈ s.inf (fun i => (ρ i).ker.toSubmodule) :=
    Submodule.mem_finsetInf.mpr fun i hi => (LieHom.mem_ker).mpr (hx i hi)
  exact (LieHom.mem_ker).mp (hs i hmem)

end Artinian

/-- A separating finite family gives an actual faithful block diagonal
representation on the product module. -/
theorem finiteProductRepresentation_injective_of_separates
    (s : Finset ι) (ρ : ∀ i, L →ₗ⁅R⁆ Module.End R (V i))
    (hρ : ∀ x : L, (∀ i ∈ s, ρ i x = 0) → x = 0) :
    Function.Injective (finiteProductRepresentation s ρ) := by
  classical
  apply (finiteProductRepresentation s ρ).ker_eq_bot.mp
  apply le_antisymm _ bot_le
  intro x hx
  change x = 0
  rw [LieHom.mem_ker] at hx
  apply hρ x
  intro i hi
  ext v
  have h := congrArg
    (fun F : Module.End R (∀ j : s, V j.1) =>
      F (Function.update 0 ⟨i, hi⟩ v) ⟨i, hi⟩) hx
  simpa only [finiteProductRepresentation_apply, Function.update_self,
    LinearMap.zero_apply, Pi.zero_apply] using h

/-- Point separation on an Artinian Lie algebra is enough to construct one
faithful representation on a finite product of the supplied modules. -/
theorem exists_faithful_finiteProductRepresentation [IsArtinian R L]
    (ρ : ∀ i, L →ₗ⁅R⁆ Module.End R (V i))
    (hρ : ∀ x : L, (∀ i, ρ i x = 0) → x = 0) :
    ∃ s : Finset ι, Function.Injective (finiteProductRepresentation s ρ) := by
  obtain ⟨s, hs⟩ := exists_finite_separating_representations ρ hρ
  exact ⟨s, finiteProductRepresentation_injective_of_separates s ρ hs⟩

/-- Only separation of central elements is needed: Artinianity reduces that
condition to finitely many representations, and the adjoint detects the rest. -/
theorem exists_faithful_adjoint_finiteProduct_representation [IsArtinian R L]
    (ρ : ∀ i, L →ₗ⁅R⁆ Module.End R (V i))
    (hρ : ∀ x ∈ LieAlgebra.center R L, (∀ i, ρ i x = 0) → x = 0) :
    ∃ s : Finset ι, Function.Injective
      ((LieAlgebra.ad R L).prod (finiteProductRepresentation s ρ)) := by
  classical
  let ρc := fun i => (ρ i).comp (LieAlgebra.center R L).incl
  have hc : ∀ x : LieAlgebra.center R L, (∀ i, ρc i x = 0) → x = 0 := by
    intro x hx
    apply Subtype.ext
    exact hρ x x.property hx
  obtain ⟨s, hs⟩ := exists_finite_separating_representations ρc hc
  refine ⟨s, lieHom_prod_ad_injective_of_separates_center
    (finiteProductRepresentation s ρ) fun x hx hxρ => ?_⟩
  have hz : (⟨x, hx⟩ : LieAlgebra.center R L) = 0 := by
    apply hs
    intro i hi
    ext v
    change ρ i x v = 0
    have h := congrArg
      (fun F : Module.End R (∀ j : s, V j.1) =>
        F (Function.update 0 ⟨i, hi⟩ v) ⟨i, hi⟩) hxρ
    simpa only [finiteProductRepresentation_apply, Function.update_self,
      LinearMap.zero_apply, Pi.zero_apply] using h
  exact congrArg Subtype.val hz

end LieGroups

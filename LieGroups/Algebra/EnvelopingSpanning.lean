import LieGroups.Algebra.EnvelopingWords
import LieGroups.Algebra.WordStraightening

/-!
# Ordered monomials span the universal enveloping algebra

Adjacent commutation and well-founded shortlex induction straighten every word,
without increasing its length. This proves the spanning assertion, including its
degree bound, over any commutative coefficient ring and an ordered free basis.
It does not assert linear independence, injectivity of the canonical Lie map,
or the full PBW theorem.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module

namespace LieGroups

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [LinearOrder ι] [WellFoundedLT ι]

/-- The span of weakly ordered enveloping monomials of length at most `n`. -/
def orderedEnvelopingSpan (b : Basis ι R L) (n : ℕ) :
    Submodule R (UniversalEnvelopingAlgebra R L) :=
  Submodule.span R {x | ∃ w : List ι, w.Pairwise (· ≤ ·) ∧ w.length ≤ n ∧
    envelopingWord b w = x}

/-- Straightening a word preserves its degree bound. -/
theorem envelopingWord_mem_orderedEnvelopingSpan (b : Basis ι R L) (w : List ι)
    (n : ℕ) (hn : w.length ≤ n) : envelopingWord b w ∈ orderedEnvelopingSpan b n := by
  classical
  have hall : ∀ m, w.length ≤ m → envelopingWord b w ∈ orderedEnvelopingSpan b m :=
    wordStraightening_induction
      (P := fun v => ∀ m, v.length ≤ m → envelopingWord b v ∈ orderedEnvelopingSpan b m)
      (by
        intro v hv m hm
        exact Submodule.subset_span ⟨v, hv, hm, rfl⟩)
      (by
        intro p a c s _ hswap hshort m hm
        rw [envelopingWord_swap b p s a c]
        apply Submodule.add_mem
        · exact hswap m (by simpa only [List.length_append, List.length_cons] using hm)
        · apply Submodule.sum_mem
          intro k _
          apply Submodule.smul_mem
          apply hshort k m
          simp only [List.length_append, List.length_cons] at hm ⊢
          omega) w
  exact hall n hn

/-- The ordered monomials, with arbitrary finite length, span the actual
universal enveloping algebra. This is the spanning half of PBW. -/
theorem span_orderedEnvelopingWord (b : Basis ι R L) :
    Submodule.span R {x | ∃ w : List ι, w.Pairwise (· ≤ ·) ∧ envelopingWord b w = x} = ⊤ := by
  apply top_unique
  rw [← span_range_envelopingWord b]
  apply Submodule.span_le.mpr
  rintro x ⟨w, rfl⟩
  apply Submodule.span_mono (s := {x | ∃ v : List ι,
    v.Pairwise (· ≤ ·) ∧ v.length ≤ w.length ∧ envelopingWord b v = x}) ?_
    (envelopingWord_mem_orderedEnvelopingSpan b w w.length le_rfl)
  rintro y ⟨v, hv, _, rfl⟩
  exact ⟨v, hv, rfl⟩

end LieGroups

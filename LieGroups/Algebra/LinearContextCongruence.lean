import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.RingTheory.Congruence.Basic

/-!
# Descending linear normal forms through algebra congruences

A linear map need not preserve multiplication. Equality of its values in every
left and right multiplicative context nevertheless defines a ring congruence.
This lets a contextual normal-form identity descend through the actual
congruence quotient defining an enveloping algebra.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

variable {R A W : Type*} [CommRing R] [Ring A] [Algebra R A]
  [AddCommGroup W] [Module R W]

/-- Two algebra elements are context-equivalent if a linear map cannot
distinguish them after multiplication on either side. -/
def linearContextCongruence (F : A →ₗ[R] W) : RingCon A where
  r a b := ∀ p q : A, F (p * a * q) = F (p * b * q)
  iseqv := ⟨fun _ _ _ => rfl, fun h p q => (h p q).symm,
    fun h₁ h₂ p q => (h₁ p q).trans (h₂ p q)⟩
  add' := by
    intro a b c d hab hcd p q
    simp only [mul_add, add_mul, map_add]
    exact congrArg₂ (· + ·) (hab p q) (hcd p q)
  mul' := by
    intro a b c d hab hcd p q
    have h₁ := hab p (c * q)
    have h₂ := hcd (p * b) q
    simp only [mul_assoc] at h₁ h₂ ⊢
    exact h₁.trans h₂

/-- The empty context recovers ordinary equality under the linear map. -/
theorem linearContextCongruence_eq (F : A →ₗ[R] W) {a b : A}
    (h : linearContextCongruence F a b) : F a = F b := by
  simpa only [one_mul, mul_one] using h 1 1

/-- A linear map descends when the quotient congruence preserves every context. -/
def descendLinearContext (c : RingCon A) (F : A →ₗ[R] W)
    (h : c ≤ linearContextCongruence F) : c.Quotient →ₗ[R] W where
  toFun := Quotient.lift F (fun _ _ hab => linearContextCongruence_eq F (h hab))
  map_add' x y := by
    refine Quotient.inductionOn₂ x y fun a b => ?_
    change F (a + b) = F a + F b
    exact map_add F a b
  map_smul' r x := by
    refine Quotient.inductionOn x fun a => ?_
    change F (r • a) = r • F a
    exact map_smul F r a

@[simp]
theorem descendLinearContext_mk (c : RingCon A) (F : A →ₗ[R] W)
    (h : c ≤ linearContextCongruence F) (a : A) :
    descendLinearContext c F h (c.mkₐ R a) = F a := rfl

variable {L : Type*} [LieRing L] [LieAlgebra R L]

/-- A linear map on the tensor algebra descends to the actual universal
enveloping algebra once it respects the defining relation in every context. -/
def universalEnvelopingLinearDescend (F : TensorAlgebra R L →ₗ[R] W)
    (hF : ∀ x y : L, ∀ p q : TensorAlgebra R L,
      F (p * (TensorAlgebra.ι R ⁅x, y⁆ + TensorAlgebra.ι R y * TensorAlgebra.ι R x) * q) =
        F (p * (TensorAlgebra.ι R x * TensorAlgebra.ι R y) * q)) :
    UniversalEnvelopingAlgebra R L →ₗ[R] W :=
  descendLinearContext (UniversalEnvelopingAlgebra.ringCon R L) F (by
    rw [UniversalEnvelopingAlgebra.ringCon, RingCon.ringConGen_le]
    intro a b hab
    cases hab with
    | lie_compat x y => exact hF x y)

@[simp]
theorem universalEnvelopingLinearDescend_mk (F : TensorAlgebra R L →ₗ[R] W)
    (hF : ∀ x y : L, ∀ p q : TensorAlgebra R L,
      F (p * (TensorAlgebra.ι R ⁅x, y⁆ + TensorAlgebra.ι R y * TensorAlgebra.ι R x) * q) =
        F (p * (TensorAlgebra.ι R x * TensorAlgebra.ι R y) * q)) (a : TensorAlgebra R L) :
    universalEnvelopingLinearDescend F hF (UniversalEnvelopingAlgebra.mkAlgHom R L a) =
      F a := rfl

end LieGroups

import Mathlib.Algebra.Lie.Derivation.Basic
import Mathlib.Algebra.Lie.Abelian
import Mathlib.Tactic.Module

/-!
# Faithful affine representations from Lie derivations

A derivation `D` gives the representation
`x ↦ ((t, y) ↦ (0, t • D x + ⁅x, y⁆))` on `R × L`.
Its kernel is precisely the intersection of the center with the kernel of `D`.
Consequently, a derivation injective on the center supplies a faithful
representation without a representation or an integrating group as an input.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

namespace LieGroups

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

attribute [local instance] LieRing.ofAssociativeRing

/-- The affine endomorphism associated to a derivation and an algebra element. -/
def derivationAffineEndomorphism (D : LieDerivation R L L) (x : L) :
    Module.End R (R × L) where
  toFun p := (0, p.1 • D x + ⁅x, p.2⁆)
  map_add' p q := by
    apply Prod.ext
    · simp
    change (p.1 + q.1) • D x + ⁅x, p.2 + q.2⁆ =
      (p.1 • D x + ⁅x, p.2⁆) + (q.1 • D x + ⁅x, q.2⁆)
    rw [add_smul, lie_add]
    abel
  map_smul' t p := by
    apply Prod.ext
    · simp
    change (t * p.1) • D x + ⁅x, t • p.2⁆ = t • (p.1 • D x + ⁅x, p.2⁆)
    rw [lie_smul, smul_add, mul_smul]

@[simp]
theorem derivationAffineEndomorphism_apply (D : LieDerivation R L L) (x : L) (p : R × L) :
    derivationAffineEndomorphism D x p = (0, p.1 • D x + ⁅x, p.2⁆) := rfl

/-- A Lie derivation determines an actual affine representation. -/
def derivationAffineRepresentation (D : LieDerivation R L L) :
    L →ₗ⁅R⁆ Module.End R (R × L) where
  toFun := derivationAffineEndomorphism D
  map_add' x y := by
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · simp
    change p.1 • D (x + y) + ⁅x + y, p.2⁆ =
      (p.1 • D x + ⁅x, p.2⁆) + (p.1 • D y + ⁅y, p.2⁆)
    rw [map_add, smul_add, add_lie]
    abel
  map_smul' t x := by
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · simp
    change p.1 • D (t • x) + ⁅t • x, p.2⁆ = t • (p.1 • D x + ⁅x, p.2⁆)
    rw [map_smul, smul_lie]
    module
  map_lie' {x y} := by
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · simp [LieRing.of_associative_ring_bracket, Module.End.mul_apply]
    change p.1 • D ⁅x, y⁆ + ⁅⁅x, y⁆, p.2⁆ =
      ((0 : R) • D x + ⁅x, p.1 • D y + ⁅y, p.2⁆⁆) -
        ((0 : R) • D y + ⁅y, p.1 • D x + ⁅x, p.2⁆⁆)
    rw [LieDerivation.apply_lie_eq_sub, smul_sub, lie_lie]
    simp only [zero_smul, zero_add, lie_add, lie_smul]
    abel

@[simp]
theorem derivationAffineRepresentation_apply (D : LieDerivation R L L) (x : L) (p : R × L) :
    derivationAffineRepresentation D x p = (0, p.1 • D x + ⁅x, p.2⁆) := rfl

/-- Evaluation of the affine representation at `(1, 0)` recovers the derivation. -/
@[simp]
theorem derivationAffineRepresentation_apply_one_zero (D : LieDerivation R L L) (x : L) :
    (derivationAffineRepresentation D x (1, 0)).2 = D x := by
  simp

/-- The affine representation vanishes exactly on central elements killed by the derivation. -/
theorem mem_ker_derivationAffineRepresentation_iff (D : LieDerivation R L L) (x : L) :
    x ∈ (derivationAffineRepresentation D).ker ↔ D x = 0 ∧ x ∈ LieAlgebra.center R L := by
  constructor
  · intro hx
    have hρ : derivationAffineRepresentation D x = 0 := hx
    have hD := congrArg (fun f : Module.End R (R × L) => (f (1, 0)).2) hρ
    have hcomm (y : L) : ⁅x, y⁆ = 0 := by
      have h := congrArg (fun f : Module.End R (R × L) => (f (0, y)).2) hρ
      simpa only [derivationAffineRepresentation_apply, zero_smul, zero_add,
        LinearMap.zero_apply, Prod.snd_zero] using h
    refine ⟨by simpa using hD, ?_⟩
    change ∀ y : L, ⁅y, x⁆ = 0
    intro y
    rw [← lie_skew, hcomm, neg_zero]
  · rintro ⟨hD, hc⟩
    change ∀ y : L, ⁅y, x⁆ = 0 at hc
    change derivationAffineRepresentation D x = 0
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · rfl
    change p.1 • D x + ⁅x, p.2⁆ = 0
    rw [hD, smul_zero, zero_add, ← lie_skew, hc, neg_zero]

/-- The kernel as an ordinary submodule is `ker D ∩ center L`. -/
theorem ker_derivationAffineRepresentation_toSubmodule (D : LieDerivation R L L) :
    (derivationAffineRepresentation D).ker.toSubmodule =
      D.toLinearMap.ker ⊓ (LieAlgebra.center R L).toSubmodule := by
  ext x
  exact mem_ker_derivationAffineRepresentation_iff D x

/-- Injectivity on central elements suffices for the affine representation to be faithful. -/
theorem derivationAffineRepresentation_injective_of_center
    (D : LieDerivation R L L)
    (hD : ∀ x ∈ LieAlgebra.center R L, D x = 0 → x = 0) :
    Function.Injective (derivationAffineRepresentation D) := by
  intro x y hxy
  have hz : x - y ∈ (derivationAffineRepresentation D).ker := by
    change derivationAffineRepresentation D (x - y) = 0
    rw [map_sub, hxy, sub_self]
  obtain ⟨hDz, hcz⟩ := (mem_ker_derivationAffineRepresentation_iff D (x - y)).mp hz
  exact sub_eq_zero.mp (hD (x - y) hcz hDz)

/-- The central-kernel criterion is also necessary. -/
theorem derivationAffineRepresentation_injective_iff (D : LieDerivation R L L) :
    Function.Injective (derivationAffineRepresentation D) ↔
      ∀ x ∈ LieAlgebra.center R L, D x = 0 → x = 0 := by
  constructor
  · intro h x hc hD
    have hx := (mem_ker_derivationAffineRepresentation_iff D x).mpr ⟨hD, hc⟩
    apply h
    exact hx.trans (map_zero (derivationAffineRepresentation D)).symm
  · exact derivationAffineRepresentation_injective_of_center D

/-- In particular, a nonsingular derivation produces a faithful affine representation. -/
theorem derivationAffineRepresentation_injective
    (D : LieDerivation R L L) (hD : Function.Injective D) :
    Function.Injective (derivationAffineRepresentation D) := by
  apply derivationAffineRepresentation_injective_of_center D
  intro x _ hx
  exact hD (hx.trans (map_zero D).symm)

end LieGroups

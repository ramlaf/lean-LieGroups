import Mathlib.Data.List.Shortlex
import Mathlib.Data.List.Pairwise

/-!
# Well-founded induction for ordered-word straightening

An unordered word has an adjacent descent. Swapping that descent decreases the
shortlex order, and replacing its two letters by any single letter decreases
length. These reductions justify the spanning half of the PBW argument without
assuming linear independence or a normal-form/confluence theorem.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

namespace LieGroups

variable {ι : Type*} [LinearOrder ι]

/-- A word that is not weakly increasing contains an adjacent descending pair. -/
theorem exists_adjacent_descent (w : List ι) (hw : ¬ w.Pairwise (· ≤ ·)) :
    ∃ p a b s, w = p ++ a :: b :: s ∧ b < a := by
  induction w with
  | nil => simp at hw
  | cons a t ih =>
    cases t with
    | nil => simp at hw
    | cons b s =>
      by_cases hab : a ≤ b
      · have ht : ¬ (b :: s).Pairwise (· ≤ ·) := by
          intro h
          exact hw (List.Pairwise.cons_cons_of_trans hab h)
        obtain ⟨p, x, y, v, hv, hxy⟩ := ih ht
        exact ⟨a :: p, x, y, v, by simp only [List.cons_append, ← hv], hxy⟩
      · exact ⟨[], a, b, s, rfl, lt_of_not_ge hab⟩

/-- Swapping an adjacent descent strictly decreases shortlex order. -/
theorem shortlex_swap_descent (p s : List ι) {a b : ι} (hab : b < a) :
    List.Shortlex (· < ·) (p ++ b :: a :: s) (p ++ a :: b :: s) := by
  apply List.Shortlex.append_left (s := p)
  apply List.Shortlex.of_lex (by simp)
  exact List.Lex.rel hab

/-- Replacing two letters by a single letter strictly decreases shortlex order. -/
theorem shortlex_contract_pair (p s : List ι) (a b k : ι) :
    List.Shortlex (· < ·) (p ++ k :: s) (p ++ a :: b :: s) := by
  apply List.Shortlex.of_length_lt
  simp only [List.length_append, List.length_cons]
  omega

/-- To prove a property for every word, it suffices to prove it for ordered words
and propagate it backwards through an adjacent swap and all shorter contractions.
This is a termination principle, not a uniqueness-of-normal-forms assertion. -/
theorem wordStraightening_induction [WellFoundedLT ι] (P : List ι → Prop)
    (ordered : ∀ w, w.Pairwise (· ≤ ·) → P w)
    (swap : ∀ p a b s, b < a → P (p ++ b :: a :: s) →
      (∀ k, P (p ++ k :: s)) → P (p ++ a :: b :: s)) (w : List ι) : P w := by
  have hWF := List.Shortlex.wf (wellFounded_lt : WellFounded ((· < ·) : ι → ι → Prop))
  induction w using hWF.induction with
  | h w ih =>
    by_cases hw : w.Pairwise (· ≤ ·)
    · exact ordered w hw
    · obtain ⟨p, a, b, s, rfl, hab⟩ := exists_adjacent_descent w hw
      exact swap p a b s hab (ih _ (shortlex_swap_descent p s hab))
        (fun k => ih _ (shortlex_contract_pair p s a b k))

end LieGroups

import Mathlib.Algebra.Lie.Solvable
import Mathlib.Algebra.Lie.SemiDirect
import Mathlib.LinearAlgebra.Dual.Lemmas
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-!
# Splitting a solvable Lie algebra over a codimension-one ideal

A nonzero solvable Lie algebra has a surjective character. Choosing a vector on
which the character is one gives its kernel a derivation and identifies the
original algebra with a semidirect sum of that kernel and the scalar field.
This is the algebraic induction step used in solvable Lie-group integration.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable {𝕜 L : Type*} [Field 𝕜] [LieRing L] [LieAlgebra 𝕜 L]

/-- Every nonzero solvable Lie algebra has a surjective character into the
one-dimensional abelian Lie algebra. -/
theorem exists_surjective_character_of_solvable [LieAlgebra.IsSolvable L] [Nontrivial L] :
    ∃ χ : L →ₗ⁅𝕜⁆ 𝕜, Function.Surjective χ := by
  let P := (LieAlgebra.derivedSeries 𝕜 L 1).toSubmodule
  have hP : P < ⊤ := by
    exact_mod_cast LieAlgebra.derivedSeries_lt_top_of_solvable (R := 𝕜) (L := L)
  obtain ⟨f, hf, hPf⟩ := P.exists_dual_map_eq_bot_of_lt_top hP inferInstance
  have hf_lie (x y : L) : f ⁅x, y⁆ = 0 := by
    have hxy : ⁅x, y⁆ ∈ P := by
      change ⁅x, y⁆ ∈ ⁅(⊤ : LieIdeal 𝕜 L), (⊤ : LieIdeal 𝕜 L)⁆
      exact LieSubmodule.lie_mem_lie (by trivial) (by trivial)
    have hmem : f ⁅x, y⁆ ∈ P.map f := Submodule.mem_map_of_mem hxy
    simpa only [hPf, Submodule.mem_bot] using hmem
  refine ⟨{ toLinearMap := f, map_lie' := ?_ }, LinearMap.surjective hf⟩
  intro x y
  change f ⁅x, y⁆ = f x * f y - f y * f x
  rw [hf_lie, mul_comm (f x) (f y), sub_self]

/-- Restricting the adjoint of an ambient vector to a character kernel gives a
derivation of that ideal. -/
def characterKernelDerivation (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) :
    LieDerivation 𝕜 χ.ker χ.ker where
  toLinearMap :=
    { toFun y := ⟨⁅x, (y : L)⁆, χ.ker.lie_mem y.property⟩
      map_add' y z := by ext; exact lie_add x (y : L) (z : L)
      map_smul' t y := by ext; exact lie_smul t x (y : L) }
  leibniz' y z := by
    ext
    change ⁅x, ⁅(y : L), (z : L)⁆⁆ = ⁅(y : L), ⁅x, (z : L)⁆⁆ - ⁅(z : L), ⁅x, (y : L)⁆⁆
    rw [leibniz_lie, ← lie_skew (z : L) ⁅x, (y : L)⁆]
    abel

@[simp]
theorem characterKernelDerivation_coe (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) (y : χ.ker) :
    (characterKernelDerivation χ x y : L) = ⁅x, (y : L)⁆ := rfl

/-- The scalar line acts on a character kernel by multiples of one adjoint
derivation. -/
def characterKernelAction (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) :
    𝕜 →ₗ⁅𝕜⁆ LieDerivation 𝕜 χ.ker χ.ker where
  toLinearMap := LinearMap.toSpanSingleton 𝕜 _ (characterKernelDerivation χ x)
  map_lie' := by
    intro t s
    change (t * s - s * t) • characterKernelDerivation χ x =
      ⁅t • characterKernelDerivation χ x, s • characterKernelDerivation χ x⁆
    simp only [mul_comm t s, sub_self, zero_smul, lie_smul, smul_lie, lie_self, smul_zero]

@[simp]
theorem characterKernelAction_apply (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) (t : 𝕜) :
    characterKernelAction χ x t = t • characterKernelDerivation χ x := rfl

/-- A normalized character splits the Lie algebra as a semidirect sum with its
codimension-one kernel. The forward map is `(y,t) ↦ y + t • x`. -/
def characterKernelSplit (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) (hx : χ x = 1) :
    LieAlgebra.SemiDirectSum χ.ker 𝕜 (characterKernelAction χ x) ≃ₗ⁅𝕜⁆ L where
  toFun y := (y.left : L) + y.right • x
  invFun y :=
    ⟨⟨y - χ y • x, by
      rw [LieHom.mem_ker]
      simp only [map_sub, map_smul, hx, smul_eq_mul, mul_one, sub_self]⟩, χ y⟩
  left_inv y := by
    obtain ⟨y, t⟩ := y
    have hy : χ (y : L) = 0 := LieHom.mem_ker.mp y.property
    apply LieAlgebra.SemiDirectSum.ext
    · apply Subtype.ext
      change (y : L) + t • x - χ ((y : L) + t • x) • x = y
      simp only [map_add, map_smul, hy, hx, smul_eq_mul, mul_one, zero_add]
      abel
    · change χ ((y : L) + t • x) = t
      simp only [map_add, map_smul, hy, hx, smul_eq_mul, mul_one, zero_add]
  right_inv y := by
    change y - χ y • x + χ y • x = y
    abel
  map_add' y z := by
    change (y.left : L) + z.left + (y.right + z.right) • x =
      ((y.left : L) + y.right • x) + ((z.left : L) + z.right • x)
    rw [add_smul]
    abel
  map_smul' t y := by
    change t • (y.left : L) + (t * y.right) • x = t • ((y.left : L) + y.right • x)
    rw [smul_add, smul_smul]
  map_lie' := by
    intro y z
    change ⁅(y.left : L), (z.left : L)⁆ + y.right • ⁅x, (z.left : L)⁆ -
        z.right • ⁅x, (y.left : L)⁆ + (y.right * z.right - z.right * y.right) • x =
      ⁅(y.left : L) + y.right • x, (z.left : L) + z.right • x⁆
    rw [mul_comm y.right z.right, sub_self, zero_smul, add_zero]
    simp only [add_lie, lie_add, smul_lie, lie_smul, lie_self, smul_zero]
    rw [← lie_skew (y.left : L) x]
    simp only [add_zero, smul_neg]
    abel

@[simp]
theorem characterKernelSplit_apply (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) (hx : χ x = 1)
    (y : LieAlgebra.SemiDirectSum χ.ker 𝕜 (characterKernelAction χ x)) :
    characterKernelSplit χ x hx y = (y.left : L) + y.right • x := rfl

@[simp]
theorem characterKernelSplit_symm_right (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) (hx : χ x = 1) (y : L) :
    ((characterKernelSplit χ x hx).symm y).right = χ y := rfl

/-- The kernel of a normalized character has codimension one. -/
theorem finrank_characterKernel_add_one [FiniteDimensional 𝕜 L]
    (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) (hx : χ x = 1) :
    Module.finrank 𝕜 χ.ker + 1 = Module.finrank 𝕜 L := by
  let e := (LieAlgebra.SemiDirectSum.toProdl (characterKernelAction χ x)).symm.trans
    (characterKernelSplit χ x hx).toLinearEquiv
  calc
    Module.finrank 𝕜 χ.ker + 1 = Module.finrank 𝕜 (χ.ker × 𝕜) := by
      rw [Module.finrank_prod, Module.finrank_self]
    _ = Module.finrank 𝕜 L := e.finrank_eq

/-- The dimension strictly decreases when passing to the kernel of a normalized
character. -/
theorem finrank_characterKernel_lt [FiniteDimensional 𝕜 L]
    (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) (hx : χ x = 1) :
    Module.finrank 𝕜 χ.ker < Module.finrank 𝕜 L := by
  rw [← finrank_characterKernel_add_one χ x hx]
  exact Nat.lt_succ_self _

/-- The algebraic induction step for integrating a nonzero finite-dimensional
solvable Lie algebra: a smaller solvable ideal, one derivation, and the actual
semidirect-sum identification. -/
theorem exists_character_kernel_split_of_solvable [FiniteDimensional 𝕜 L]
    [LieAlgebra.IsSolvable L] [Nontrivial L] :
    ∃ (χ : L →ₗ⁅𝕜⁆ 𝕜) (x : L) (_hx : χ x = 1),
      Function.Surjective χ ∧
      Module.finrank 𝕜 χ.ker < Module.finrank 𝕜 L ∧
      Nonempty (LieAlgebra.SemiDirectSum χ.ker 𝕜 (characterKernelAction χ x) ≃ₗ⁅𝕜⁆ L) := by
  obtain ⟨χ, hχ⟩ := exists_surjective_character_of_solvable (𝕜 := 𝕜) (L := L)
  obtain ⟨x, hx⟩ := hχ 1
  exact ⟨χ, x, hx, hχ, finrank_characterKernel_lt χ x hx, ⟨characterKernelSplit χ x hx⟩⟩

end LieGroups

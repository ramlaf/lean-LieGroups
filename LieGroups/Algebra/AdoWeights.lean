import LieGroups.Algebra.AdoAugmentation
import LieGroups.Algebra.PBW

/-!
# Weighted PBW separation for augmentation quotients

A positive, bounded weight on a Lie basis, whose bracket coordinates have at
least the sum of the input weights, ensures that sufficiently high augmentation
powers contain no nonzero Lie generator. PBW supplies the linear projection
onto the singleton monomials used in the separation argument.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module

namespace LieGroups

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

attribute [local instance] LieRing.ofAssociativeRing

local notation "U" => UniversalEnvelopingAlgebra R L

/-- The weight of a word is the sum of its letter weights. -/
def lieWordWeight (weight : ι → ℕ) (w : List ι) : ℕ := (w.map weight).sum

@[simp]
theorem lieWordWeight_nil (weight : ι → ℕ) : lieWordWeight weight [] = 0 := rfl

@[simp]
theorem lieWordWeight_cons (weight : ι → ℕ) (i : ι) (w : List ι) :
    lieWordWeight weight (i :: w) = weight i + lieWordWeight weight w := rfl

@[simp]
theorem lieWordWeight_append (weight : ι → ℕ) (p s : List ι) :
    lieWordWeight weight (p ++ s) = lieWordWeight weight p + lieWordWeight weight s := by
  simp only [lieWordWeight, List.map_append, List.sum_append]

variable [LinearOrder ι] [WellFoundedLT ι]

/-- A weighted Lie basis has no bracket coordinate of weight below the sum
of the two input weights. -/
def LieBasisWeightCompatible (b : Basis ι R L) (weight : ι → ℕ) : Prop :=
  ∀ i j k, b.repr ⁅b i, b j⁆ k ≠ 0 → weight i + weight j ≤ weight k

/-- The span of ordered PBW monomials of weight at least `n`. -/
def weightedEnvelopingTail (b : Basis ι R L) (weight : ι → ℕ) (n : ℕ) :
    Submodule R U :=
  Submodule.span R {u | ∃ w : List ι, w.Pairwise (· ≤ ·) ∧
    n ≤ lieWordWeight weight w ∧ envelopingWord b w = u}

/-- Straightening preserves a lower weight bound for a compatible weighted
basis. Correction terms have at least the original weight. -/
theorem envelopingWord_mem_weightedTail (b : Basis ι R L) (weight : ι → ℕ)
    (hweight : LieBasisWeightCompatible b weight) (w : List ι) (n : ℕ)
    (hn : n ≤ lieWordWeight weight w) :
    envelopingWord b w ∈ weightedEnvelopingTail b weight n := by
  classical
  have hall : ∀ m, m ≤ lieWordWeight weight w →
      envelopingWord b w ∈ weightedEnvelopingTail b weight m :=
    wordStraightening_induction
      (P := fun v => ∀ m, m ≤ lieWordWeight weight v →
        envelopingWord b v ∈ weightedEnvelopingTail b weight m)
      (by
        intro v hv m hm
        exact Submodule.subset_span ⟨v, hv, hm, rfl⟩)
      (by
        intro p a c s _ hswap hshort m hm
        rw [envelopingWord_swap b p s a c]
        apply Submodule.add_mem
        · apply hswap m
          simp only [lieWordWeight_append, lieWordWeight_cons] at hm ⊢
          omega
        · apply Submodule.sum_mem
          intro k hk
          apply Submodule.smul_mem
          apply hshort k m
          have hbr := hweight a c k (Finsupp.mem_support_iff.mp hk)
          simp only [lieWordWeight_append, lieWordWeight_cons] at hm ⊢
          omega) w
  exact hall n hn

omit [LinearOrder ι] [WellFoundedLT ι] in
theorem length_le_lieWordWeight (weight : ι → ℕ) (hpos : ∀ i, 1 ≤ weight i)
    (w : List ι) : w.length ≤ lieWordWeight weight w := by
  induction w with
  | nil => exact le_rfl
  | cons i w ih =>
      simpa only [List.length_cons, lieWordWeight_cons, Nat.add_comm] using
        Nat.add_le_add (hpos i) ih

/-- An unweighted augmentation tail lies in the corresponding weighted tail
when every letter has positive weight. -/
theorem envelopingAugmentationPower_le_weightedTail (b : Basis ι R L)
    (weight : ι → ℕ) (hweight : LieBasisWeightCompatible b weight)
    (hpos : ∀ i, 1 ≤ weight i) (n : ℕ) :
    envelopingAugmentationPower b n ≤ weightedEnvelopingTail b weight n := by
  apply Submodule.span_le.mpr
  rintro u ⟨w, hw, rfl⟩
  exact envelopingWord_mem_weightedTail b weight hweight w n
    (hw.trans (length_le_lieWordWeight weight hpos w))

/-- The PBW projection retaining precisely the singleton monomials. -/
def envelopingLieProjection (b : Basis ι R L) : U →ₗ[R] L :=
  (pbwBasis b).constr R (fun w => match w.val with
    | [i] => b i
    | _ => 0)

theorem envelopingLieProjection_ordered (b : Basis ι R L) (w : PBWOrderedWord ι) :
    envelopingLieProjection b (envelopingWord b w.val) =
      match w.val with
      | [i] => b i
      | _ => 0 := by
  rw [← pbwBasis_apply]
  exact (pbwBasis b).constr_basis R _ w

@[simp]
theorem envelopingLieProjection_ι (b : Basis ι R L) (x : L) :
    envelopingLieProjection b (UniversalEnvelopingAlgebra.ι R x) = x := by
  have h : (envelopingLieProjection b).comp
      (UniversalEnvelopingAlgebra.ι R).toLinearMap = LinearMap.id := by
    apply b.ext
    intro i
    change envelopingLieProjection b (UniversalEnvelopingAlgebra.ι R (b i)) = b i
    rw [← envelopingWord_singleton b i]
    exact envelopingLieProjection_ordered b ⟨[i], by simp⟩
  exact congrArg (fun f : L →ₗ[R] L => f x) h

/-- A tail above all individual letter weights is annihilated by the PBW
projection onto the Lie generators. -/
theorem weightedEnvelopingTail_le_ker_lieProjection (b : Basis ι R L)
    (weight : ι → ℕ) (n : ℕ) (hbound : ∀ i, weight i < n) :
    weightedEnvelopingTail b weight n ≤ (envelopingLieProjection b).ker := by
  apply Submodule.span_le.mpr
  rintro u ⟨w, hw, hn, rfl⟩
  change envelopingLieProjection b (envelopingWord b w) = 0
  rw [envelopingLieProjection_ordered b ⟨w, hw⟩]
  cases w with
  | nil => rfl
  | cons i w =>
      cases w with
      | nil =>
          have hi := hbound i
          simp only [lieWordWeight_cons, lieWordWeight_nil, add_zero] at hn
          omega
      | cons j w => rfl

/-- A sufficiently high augmentation tail meets the original Lie algebra
trivially when the given basis has compatible positive bounded weights. -/
theorem envelopingι_eq_zero_of_mem_augmentationPower_of_weights
    (b : Basis ι R L) (weight : ι → ℕ)
    (hweight : LieBasisWeightCompatible b weight) (hpos : ∀ i, 1 ≤ weight i)
    (n : ℕ) (hbound : ∀ i, weight i < n) (x : L)
    (hx : UniversalEnvelopingAlgebra.ι R x ∈ envelopingAugmentationPower b n) :
    x = 0 := by
  have htail := envelopingAugmentationPower_le_weightedTail b weight hweight hpos n hx
  have hzero := weightedEnvelopingTail_le_ker_lieProjection b weight n hbound htail
  change envelopingLieProjection b (UniversalEnvelopingAlgebra.ι R x) = 0 at hzero
  simpa only [envelopingLieProjection_ι] using hzero

/-- For a compatible positive bounded weighted basis, the already constructed
augmentation quotient action is faithful. Its carrier is finite over `R` if
the basis index is finite. -/
theorem envelopingAugmentationRepresentation_injective_of_weights
    (b : Basis ι R L) (weight : ι → ℕ)
    (hweight : LieBasisWeightCompatible b weight) (hpos : ∀ i, 1 ≤ weight i)
    (n : ℕ) (hbound : ∀ i, weight i < n) :
    Function.Injective (envelopingAugmentationRepresentation b n) :=
  envelopingAugmentationRepresentation_injective b n
    (envelopingι_eq_zero_of_mem_augmentationPower_of_weights b weight hweight hpos n hbound)

end LieGroups

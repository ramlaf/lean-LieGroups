import Mathlib.Algebra.Lie.Nilpotent

/-!
# Sums of intrinsically nilpotent Lie ideals

Here nilpotence of an ideal means nilpotence of its own Lie algebra. This differs
from nilpotence for the action of the whole ambient Lie algebra on that ideal.
Relative lower-central series remain ambient invariant, allowing a direct proof
that sums of intrinsically nilpotent ideals are intrinsically nilpotent.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

namespace LieGroups

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

/-- Relative lower-central series of a sum satisfy a two-index degree bound. -/
theorem lcs_sup_add_le (I J : LieIdeal R L) (M : Type*) [AddCommGroup M] [Module R M]
    [LieRingModule L M] [LieModule R L M] (a b : ℕ) :
    (I ⊔ J).lcs M (a + b) ≤ I.lcs M a ⊔ J.lcs M b := by
  induction a generalizing b with
  | zero => simp only [LieIdeal.lcs_zero, top_sup_eq]; exact le_top
  | succ a iha =>
    induction b with
    | zero => simp only [LieIdeal.lcs_zero, sup_top_eq]; exact le_top
    | succ b ihb =>
      have ihb' : (I ⊔ J).lcs M (a + (b + 1)) ≤ I.lcs M (a + 1) ⊔ J.lcs M b := by
        rw [show a + (b + 1) = (a + 1) + b by omega]
        exact ihb
      rw [show (a + 1) + (b + 1) = (a + (b + 1)) + 1 by omega,
        LieIdeal.lcs_succ, LieSubmodule.sup_lie]
      apply sup_le
      · apply (LieSubmodule.mono_lie_right I (iha (b + 1))).trans
        rw [LieSubmodule.lie_sup]
        apply sup_le
        · rw [← LieIdeal.lcs_succ]
          exact le_sup_left
        · exact ((J.lcs M (b + 1)).lie_le_right I).trans le_sup_right
      · apply (LieSubmodule.mono_lie_right J ihb').trans
        rw [LieSubmodule.lie_sup]
        apply sup_le
        · exact ((I.lcs M (a + 1)).lie_le_right J).trans le_sup_left
        · rw [← LieIdeal.lcs_succ]
          exact le_sup_right

/-- After its first bracket, the action of an ideal on the ambient algebra is
controlled by its own relative lower-central series. -/
theorem lcs_ambient_le_map_lcs_self (I : LieIdeal R L) (k : ℕ) :
    I.lcs L (k + 1) ≤ (I.lcs I k).map (LieSubmodule.incl I) := by
  induction k with
  | zero =>
      simpa only [LieIdeal.lcs_zero, LieIdeal.lcs_succ, LieModuleHom.map_top,
        LieSubmodule.range_incl] using
        (LieSubmodule.lie_le_left I (⊤ : LieIdeal R L))
  | succ k ih =>
      rw [I.lcs_succ L (k + 1), I.lcs_succ I k, LieSubmodule.map_bracket_eq]
      exact LieSubmodule.mono_lie_right I ih

/-- Vanishing of relative series can be checked in the intrinsic acting-ideal module. -/
theorem lcs_eq_bot_iff_lowerCentralSeries_eq_bot (I : LieIdeal R L) (M : Type*)
    [AddCommGroup M] [Module R M] [LieRingModule L M] [LieModule R L M] (k : ℕ) :
    I.lcs M k = ⊥ ↔ LieModule.lowerCentralSeries R I M k = ⊥ := by
  constructor
  · intro h
    apply LieSubmodule.toSubmodule_injective
    simpa only [LieIdeal.coe_lcs_eq, LieSubmodule.bot_toSubmodule] using
      congrArg LieSubmodule.toSubmodule h
  · intro h
    apply LieSubmodule.toSubmodule_injective
    simpa only [LieIdeal.coe_lcs_eq, LieSubmodule.bot_toSubmodule] using
      congrArg LieSubmodule.toSubmodule h

/-- An intrinsically nilpotent ideal acts nilpotently on its ambient Lie algebra.
The acting algebra here is the ideal, not the ambient algebra. -/
theorem ideal_action_isNilpotent_of_lieRing_isNilpotent (I : LieIdeal R L)
    (hI : LieRing.IsNilpotent I) : LieModule.IsNilpotent I L := by
  let : LieRing.IsNilpotent I := hI
  obtain ⟨k, hk⟩ := LieModule.IsNilpotent.nilpotent R I I
  have hk' : I.lcs I k = ⊥ := (lcs_eq_bot_iff_lowerCentralSeries_eq_bot I I k).mpr hk
  have hambient : I.lcs L (k + 1) = ⊥ := by
    apply le_bot_iff.mp
    simpa only [hk', LieSubmodule.map_bot] using lcs_ambient_le_map_lcs_self I k
  apply (LieModule.isNilpotent_iff R I L).mpr
  refine ⟨k + 1, ?_⟩
  exact (lcs_eq_bot_iff_lowerCentralSeries_eq_bot I L (k + 1)).mp hambient

/-- Nilpotent actions of two ideals on a common module combine to give a
nilpotent action of their sum. -/
theorem lieModule_isNilpotent_sup (I J : LieIdeal R L) (M : Type*)
    [AddCommGroup M] [Module R M] [LieRingModule L M] [LieModule R L M]
    (hI : LieModule.IsNilpotent I M) (hJ : LieModule.IsNilpotent J M) :
    LieModule.IsNilpotent (I ⊔ J : LieIdeal R L) M := by
  let := hI
  let := hJ
  obtain ⟨a, ha⟩ := LieModule.IsNilpotent.nilpotent R I M
  obtain ⟨b, hb⟩ := LieModule.IsNilpotent.nilpotent R J M
  have ha' : I.lcs M a = ⊥ := (lcs_eq_bot_iff_lowerCentralSeries_eq_bot I M a).mpr ha
  have hb' : J.lcs M b = ⊥ := (lcs_eq_bot_iff_lowerCentralSeries_eq_bot J M b).mpr hb
  have hsum : (I ⊔ J).lcs M (a + b) = ⊥ := by
    apply le_bot_iff.mp
    simpa only [ha', hb', bot_sup_eq] using lcs_sup_add_le I J M a b
  apply (LieModule.isNilpotent_iff R (I ⊔ J : LieIdeal R L) M).mpr
  refine ⟨a + b, ?_⟩
  exact (lcs_eq_bot_iff_lowerCentralSeries_eq_bot (I ⊔ J) M (a + b)).mp hsum

/-- Restricting a nilpotent action on the ambient algebra to the ideal itself
recovers intrinsic nilpotence. -/
theorem lieRing_isNilpotent_of_ideal_action (I : LieIdeal R L)
    (hI : LieModule.IsNilpotent I L) : LieRing.IsNilpotent I := by
  let := hI
  let f : I →ₗ⁅R⁆ I := LieHom.id
  let g : I →ₗ[R] L := I.incl.toLinearMap
  have hfg : ∀ x y : I, ⁅f x, g y⁆ = g ⁅x, y⁆ := by
    intro x y
    rfl
  exact Subtype.val_injective.lieModuleIsNilpotent (f := f) (g := g) hfg

/-- The sum of two intrinsically nilpotent Lie ideals is intrinsically nilpotent. -/
theorem lieRing_isNilpotent_sup (I J : LieIdeal R L)
    (hI : LieRing.IsNilpotent I) (hJ : LieRing.IsNilpotent J) :
    LieRing.IsNilpotent (I ⊔ J : LieIdeal R L) := by
  apply lieRing_isNilpotent_of_ideal_action
  exact lieModule_isNilpotent_sup I J L
    (ideal_action_isNilpotent_of_lieRing_isNilpotent I hI)
    (ideal_action_isNilpotent_of_lieRing_isNilpotent J hJ)

variable (R L) in
/-- The classical nilradical: the supremum of ideals nilpotent as Lie algebras
in their own right. It is distinct from Mathlib's ambient-module construction. -/
noncomputable def classicalNilradical : LieIdeal R L :=
  sSup {I : LieIdeal R L | LieRing.IsNilpotent I}

/-- Over a Noetherian module, finite sums suffice to construct the classical
nilradical, which is consequently itself an intrinsically nilpotent ideal. -/
theorem classicalNilradical_isNilpotent [IsNoetherian R L] :
    LieRing.IsNilpotent (classicalNilradical R L) := by
  have hwf := CompleteLattice.WellFoundedGT.isSupClosedCompact (LieIdeal R L) inferInstance
  apply hwf {I : LieIdeal R L | LieRing.IsNilpotent I}
    ⟨⊥, by change LieRing.IsNilpotent (⊥ : LieIdeal R L); infer_instance⟩
  intro I hI J hJ
  exact lieRing_isNilpotent_sup I J hI hJ

/-- Every intrinsically nilpotent ideal lies in the classical nilradical. -/
theorem le_classicalNilradical (I : LieIdeal R L) (hI : LieRing.IsNilpotent I) :
    I ≤ classicalNilradical R L := le_sSup hI

/-- Intrinsic nilpotence passes to any smaller ideal. -/
theorem lieRing_isNilpotent_of_le {I J : LieIdeal R L} (hIJ : I ≤ J)
    (hJ : LieRing.IsNilpotent J) : LieRing.IsNilpotent I := by
  let := hJ
  exact (LieIdeal.inclusion_injective hIJ).lieAlgebra_isNilpotent

/-- The classical nilradical is the largest intrinsically nilpotent ideal. -/
theorem lieRing_isNilpotent_iff_le_classicalNilradical [IsNoetherian R L]
    (I : LieIdeal R L) : LieRing.IsNilpotent I ↔ I ≤ classicalNilradical R L :=
  ⟨le_classicalNilradical I,
    fun h => lieRing_isNilpotent_of_le h classicalNilradical_isNilpotent⟩

variable {L' : Type*} [LieRing L'] [LieAlgebra R L']

/-- Pulling an ideal back along a Lie equivalence preserves intrinsic nilpotence. -/
theorem lieRing_isNilpotent_comap_lieEquiv (e : L ≃ₗ⁅R⁆ L') (I : LieIdeal R L')
    (hI : LieRing.IsNilpotent I) : LieRing.IsNilpotent (I.comap e.toLieHom) := by
  let := hI
  let f : I.comap e.toLieHom →ₗ⁅R⁆ I := {
    toFun x := ⟨e x, x.property⟩
    map_add' x y := by apply Subtype.ext; exact map_add e (x : L) (y : L)
    map_smul' r x := by apply Subtype.ext; exact map_smul e r (x : L)
    map_lie' {x y} := by apply Subtype.ext; exact LieEquiv.map_lie e (x : L) (y : L)
  }
  have hf : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    apply e.injective
    exact congrArg Subtype.val h
  exact hf.lieAlgebra_isNilpotent

/-- The classical nilradical is transported exactly by every Lie equivalence. -/
theorem classicalNilradical_comap_lieEquiv [IsNoetherian R L] [IsNoetherian R L']
    (e : L ≃ₗ⁅R⁆ L') :
    (classicalNilradical R L').comap e.toLieHom = classicalNilradical R L := by
  apply le_antisymm
  · exact le_classicalNilradical _
      (lieRing_isNilpotent_comap_lieEquiv e _ classicalNilradical_isNilpotent)
  · have hJ : (classicalNilradical R L).comap e.symm.toLieHom ≤ classicalNilradical R L' :=
      le_classicalNilradical _
        (lieRing_isNilpotent_comap_lieEquiv e.symm _ classicalNilradical_isNilpotent)
    intro x hx
    change e x ∈ classicalNilradical R L'
    apply hJ
    change e.symm (e x) ∈ classicalNilradical R L
    simpa only [e.symm_apply_apply] using hx

/-- Membership in the classical nilradical is invariant under Lie equivalences. -/
theorem mem_classicalNilradical_lieEquiv_iff [IsNoetherian R L] [IsNoetherian R L']
    (e : L ≃ₗ⁅R⁆ L') (x : L) :
    e x ∈ classicalNilradical R L' ↔ x ∈ classicalNilradical R L := by
  change x ∈ (classicalNilradical R L').comap e.toLieHom ↔ _
  rw [classicalNilradical_comap_lieEquiv]

/-- Equivalently, every Lie equivalence maps the classical nilradical onto the
classical nilradical. In particular it is an automorphism-invariant ideal. -/
theorem classicalNilradical_map_lieEquiv [IsNoetherian R L] [IsNoetherian R L']
    (e : L ≃ₗ⁅R⁆ L') :
    (classicalNilradical R L).map e.toLieHom = classicalNilradical R L' := by
  apply LieIdeal.map_of_image
  apply Set.Subset.antisymm
  · rintro y ⟨x, hx, rfl⟩
    exact (mem_classicalNilradical_lieEquiv_iff e x).mpr hx
  · intro y hy
    exact ⟨e.symm y, (mem_classicalNilradical_lieEquiv_iff e.symm y).mpr hy,
      e.apply_symm_apply y⟩

end LieGroups

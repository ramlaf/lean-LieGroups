import Mathlib.LinearAlgebra.Basis.VectorSpace
import Mathlib.LinearAlgebra.Basis.Prod
import Mathlib.LinearAlgebra.Projection

/-!
# Bases adapted to finite descending filtrations

A descending vector-space filtration which starts at the whole space and
reaches zero has a basis with positive bounded weights. Membership in each
filtered subspace is expressed by vanishing of the lower-weight coordinates.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module

namespace LieGroups

universe uK uV

variable {K : Type uK} [Field K]

/-- A finite descending filtration has an adapted weighted basis. No
finite-dimensionality assumption is needed for this finite-flag statement. -/
theorem exists_basis_weights_of_finite_filtration
    {V : Type uV} [AddCommGroup V] [Module K V]
    (f : ℕ → Submodule K V) (hanti : Antitone f) (hzero : f 0 = ⊤)
    (n : ℕ) (hn : f n = ⊥) :
    ∃ (ι : Type uV) (b : Basis ι K V) (weight : ι → ℕ),
      (∀ i, 1 ≤ weight i ∧ weight i ≤ n) ∧
      ∀ k x, x ∈ f k ↔ ∀ i, weight i ≤ k → b.repr x i = 0 := by
  induction n generalizing V with
  | zero =>
      have hV (x : V) : x = 0 := by
        have hx : x ∈ f 0 := by rw [hzero]; exact Submodule.mem_top
        simpa only [hn, Submodule.mem_bot] using hx
      let b := Basis.ofVectorSpace K V
      refine ⟨_, b, fun _ => 1, ?_, ?_⟩
      · intro i
        exact False.elim (b.ne_zero i (hV (b i)))
      · intro k x
        constructor
        · intro _ i _
          rw [hV x, map_zero, Finsupp.zero_apply]
        · intro _
          rw [hV x]
          exact Submodule.zero_mem _
  | succ n ih =>
      let P := f 1
      let g : ℕ → Submodule K P := fun k => (f (k + 1)).comap P.subtype
      have hganti : Antitone g := by
        intro k l hkl
        exact Submodule.comap_mono (hanti (Nat.add_le_add_right hkl 1))
      have hgzero : g 0 = ⊤ := by
        ext x
        simp only [g, zero_add, Submodule.mem_comap, Submodule.mem_top, iff_true]
        exact x.property
      have hgn : g n = ⊥ := by
        change (f (n + 1)).comap P.subtype = ⊥
        rw [hn, Submodule.comap_bot, P.ker_subtype]
      obtain ⟨ι, bP, weightP, hweightP, hcoordP⟩ := ih g hganti hgzero hgn
      obtain ⟨Q, hPQ⟩ := P.exists_isCompl
      let bQ := Basis.ofVectorSpace K Q
      let e := P.prodEquivOfIsCompl Q hPQ
      let b := (bP.prod bQ).map e
      let weight : ι ⊕ Basis.ofVectorSpaceIndex K Q → ℕ :=
        Sum.elim (fun i => weightP i + 1) (fun _ => 1)
      refine ⟨_, b, weight, ?_, ?_⟩
      · intro i
        cases i with
        | inl i =>
            have hi := hweightP i
            change 1 ≤ weightP i + 1 ∧ weightP i + 1 ≤ n + 1
            omega
        | inr i => exact ⟨le_rfl, Nat.succ_le_succ (Nat.zero_le n)⟩
      · intro k x
        cases k with
        | zero =>
            constructor
            · intro _ i hi
              cases i with
              | inl i => change weightP i + 1 ≤ 0 at hi; omega
              | inr i => change 1 ≤ 0 at hi; omega
            · intro _
              rw [hzero]
              exact Submodule.mem_top
        | succ k =>
            constructor
            · intro hx
              have hxP : x ∈ P := hanti (Nat.succ_le_succ (Nat.zero_le k)) hx
              have he : e.symm x = (⟨x, hxP⟩, 0) :=
                P.prodEquivOfIsCompl_symm_apply_left Q hPQ ⟨x, hxP⟩
              have hxg : (⟨x, hxP⟩ : P) ∈ g k := hx
              intro i hi
              cases i with
              | inl i =>
                  change bP.repr (e.symm x).1 i = 0
                  rw [he]
                  exact (hcoordP k ⟨x, hxP⟩).mp hxg i (by
                    change weightP i + 1 ≤ k + 1 at hi
                    omega)
              | inr i =>
                  change bQ.repr (e.symm x).2 i = 0
                  rw [he, map_zero, Finsupp.zero_apply]
            · intro hx
              have hright : (e.symm x).2 = 0 := by
                apply bQ.repr.injective
                rw [map_zero]
                apply Finsupp.ext
                intro i
                change bQ.repr (e.symm x).2 i = 0
                exact hx (Sum.inr i) (Nat.succ_le_succ (Nat.zero_le k))
              have hleft : (e.symm x).1 ∈ g k := by
                apply (hcoordP k (e.symm x).1).mpr
                intro i hi
                exact hx (Sum.inl i) (Nat.add_le_add_right hi 1)
              have hval : ((e.symm x).1 : V) = x := by
                have he := e.apply_symm_apply x
                change ((e.symm x).1 : V) + ((e.symm x).2 : V) = x at he
                simpa only [hright, Submodule.coe_zero, add_zero] using he
              change ((e.symm x).1 : V) ∈ f (k + 1) at hleft
              rwa [hval] at hleft

end LieGroups

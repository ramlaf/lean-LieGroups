import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.Algebra.Lie.Derivation.Basic
import Mathlib.Algebra.DualNumber

/-!
# Extending Lie derivations to the universal enveloping algebra

The dual-number universal property extends a Lie derivation to an associative
derivation of the actual universal enveloping algebra. This construction does
not require PBW or a faithful representation. It is an algebraic prerequisite
for the derivation-stable finite quotients used in Ado's theorem.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "U" => UniversalEnvelopingAlgebra R L
local notation "ι" => UniversalEnvelopingAlgebra.ι R

private def envelopingDerivationGraph (D : LieDerivation R L L) :
    L →ₗ⁅R⁆ DualNumber U where
  toFun x := (ι x, ι (D x))
  map_add' x y := by
    apply TrivSqZeroExt.ext
    · change ι (x + y) = ι x + ι y
      exact map_add _ _ _
    · change ι (D (x + y)) = ι (D x) + ι (D y)
      rw [map_add, map_add]
  map_smul' t x := by
    apply TrivSqZeroExt.ext
    · change ι (t • x) = t • ι x
      exact map_smul _ _ _
    · change ι (D (t • x)) = t • ι (D x)
      rw [map_smul, map_smul]
  map_lie' := by
    intro x y
    apply TrivSqZeroExt.ext
    · change ι ⁅x, y⁆ = ι x * ι y - ι y * ι x
      exact (UniversalEnvelopingAlgebra.ι R).map_lie x y
    · change ι (D ⁅x, y⁆) =
        (ι x * ι (D y) + ι (D x) * ι y) -
          (ι y * ι (D x) + ι (D y) * ι x)
      rw [D.apply_lie_eq_sub, map_sub, LieHom.map_lie, LieHom.map_lie]
      change (ι x * ι (D y) - ι (D y) * ι x) -
        (ι y * ι (D x) - ι (D x) * ι y) = _
      abel

private theorem envelopingDerivationLift_fst (D : LieDerivation R L L) (u : U) :
    (UniversalEnvelopingAlgebra.lift R (envelopingDerivationGraph D) u).fst = u := by
  have h : (TrivSqZeroExt.fstHom R U U).comp
      (UniversalEnvelopingAlgebra.lift R (envelopingDerivationGraph D)) = AlgHom.id R U := by
    apply UniversalEnvelopingAlgebra.hom_ext
    ext x
    change (UniversalEnvelopingAlgebra.lift R (envelopingDerivationGraph D) (ι x)).fst = ι x
    rw [UniversalEnvelopingAlgebra.lift_ι_apply]
    rfl
  exact congrArg (fun f : U →ₐ[R] U => f u) h

/-- The linear endomorphism extending a Lie derivation to the universal
enveloping algebra. It satisfies the noncommutative associative Leibniz rule. -/
def envelopingDerivationLinear (D : LieDerivation R L L) : Module.End R U where
  toFun u := (UniversalEnvelopingAlgebra.lift R (envelopingDerivationGraph D) u).snd
  map_add' u v := by
    rw [map_add]
    rfl
  map_smul' t u := by
    rw [map_smul]
    rfl

@[simp]
theorem envelopingDerivationLinear_ι (D : LieDerivation R L L) (x : L) :
    envelopingDerivationLinear D (ι x) = ι (D x) := by
  change (UniversalEnvelopingAlgebra.lift R (envelopingDerivationGraph D) (ι x)).snd = _
  rw [UniversalEnvelopingAlgebra.lift_ι_apply]
  rfl

@[simp]
theorem envelopingDerivationLinear_one (D : LieDerivation R L L) :
    envelopingDerivationLinear D 1 = 0 := by
  change (UniversalEnvelopingAlgebra.lift R (envelopingDerivationGraph D) 1).snd = 0
  rw [map_one]
  rfl

/-- The extended derivation obeys the associative Leibniz rule, including for
noncommutative enveloping algebras. -/
theorem envelopingDerivationLinear_mul (D : LieDerivation R L L) (u v : U) :
    envelopingDerivationLinear D (u * v) =
      u * envelopingDerivationLinear D v + envelopingDerivationLinear D u * v := by
  change (UniversalEnvelopingAlgebra.lift R (envelopingDerivationGraph D) (u * v)).snd = _
  rw [map_mul, DualNumber.snd_mul, envelopingDerivationLift_fst, envelopingDerivationLift_fst]
  rfl

/-- The associative derivation also gives a Lie derivation of the enveloping
algebra equipped with its commutator bracket. -/
def envelopingLieDerivation (D : LieDerivation R L L) : LieDerivation R U U where
  toLinearMap := envelopingDerivationLinear D
  leibniz' u v := by
    change envelopingDerivationLinear D (u * v - v * u) =
      (u * envelopingDerivationLinear D v - envelopingDerivationLinear D v * u) -
        (v * envelopingDerivationLinear D u - envelopingDerivationLinear D u * v)
    rw [map_sub, envelopingDerivationLinear_mul, envelopingDerivationLinear_mul]
    abel

@[simp]
theorem envelopingLieDerivation_ι (D : LieDerivation R L L) (x : L) :
    envelopingLieDerivation D (ι x) = ι (D x) := envelopingDerivationLinear_ι D x

private def associativeDerivationGraph (δ : Module.End R U) (hδ_one : δ 1 = 0)
    (hδ_mul : ∀ u v : U, δ (u * v) = u * δ v + δ u * v) : U →ₐ[R] DualNumber U where
  toFun u := (u, δ u)
  map_one' := TrivSqZeroExt.ext rfl hδ_one
  map_mul' u v := TrivSqZeroExt.ext rfl (hδ_mul u v)
  map_zero' := TrivSqZeroExt.ext rfl (map_zero δ)
  map_add' u v := TrivSqZeroExt.ext rfl (map_add δ u v)
  commutes' t := by
    apply TrivSqZeroExt.ext
    · rfl
    change δ (algebraMap R U t) = 0
    rw [Algebra.algebraMap_eq_smul_one, map_smul, hδ_one, smul_zero]

/-- The associative extension is unique. Agreement on the canonical Lie
generators determines a derivation of the whole enveloping algebra. -/
theorem envelopingDerivationLinear_unique (D : LieDerivation R L L)
    (δ : Module.End R U) (hδ_one : δ 1 = 0)
    (hδ_mul : ∀ u v : U, δ (u * v) = u * δ v + δ u * v)
    (hδ_ι : ∀ x : L, δ (ι x) = ι (D x)) : δ = envelopingDerivationLinear D := by
  let F := associativeDerivationGraph δ hδ_one hδ_mul
  have hF : F = UniversalEnvelopingAlgebra.lift R (envelopingDerivationGraph D) := by
    apply UniversalEnvelopingAlgebra.hom_ext
    apply LieHom.ext
    intro x
    change F (ι x) = UniversalEnvelopingAlgebra.lift R (envelopingDerivationGraph D) (ι x)
    rw [UniversalEnvelopingAlgebra.lift_ι_apply]
    apply TrivSqZeroExt.ext
    · rfl
    · exact hδ_ι x
  apply LinearMap.ext
  intro u
  exact congrArg (fun f : U →ₐ[R] DualNumber U => (f u).snd) hF

@[simp]
theorem envelopingDerivationLinear_zero :
    envelopingDerivationLinear (0 : LieDerivation R L L) = 0 := by
  symm
  apply envelopingDerivationLinear_unique
  · rfl
  · intro u v
    simp
  · intro x
    simp

theorem envelopingDerivationLinear_add (D E : LieDerivation R L L) :
    envelopingDerivationLinear (D + E) =
      envelopingDerivationLinear D + envelopingDerivationLinear E := by
  symm
  apply envelopingDerivationLinear_unique
  · simp
  · intro u v
    change envelopingDerivationLinear D (u * v) + envelopingDerivationLinear E (u * v) =
      u * (envelopingDerivationLinear D v + envelopingDerivationLinear E v) +
        (envelopingDerivationLinear D u + envelopingDerivationLinear E u) * v
    rw [envelopingDerivationLinear_mul, envelopingDerivationLinear_mul, mul_add, add_mul]
    abel
  · intro x
    change envelopingDerivationLinear D (ι x) + envelopingDerivationLinear E (ι x) =
      ι ((D + E) x)
    rw [envelopingDerivationLinear_ι, envelopingDerivationLinear_ι]
    change ι (D x) + ι (E x) = ι (D x + E x)
    exact (map_add (UniversalEnvelopingAlgebra.ι R) _ _).symm

theorem envelopingDerivationLinear_smul (t : R) (D : LieDerivation R L L) :
    envelopingDerivationLinear (t • D) = t • envelopingDerivationLinear D := by
  symm
  apply envelopingDerivationLinear_unique
  · simp
  · intro u v
    change t • envelopingDerivationLinear D (u * v) =
      u * (t • envelopingDerivationLinear D v) + (t • envelopingDerivationLinear D u) * v
    simp only [envelopingDerivationLinear_mul, smul_add, mul_smul_comm, smul_mul_assoc]
  · intro x
    change t • envelopingDerivationLinear D (ι x) = ι ((t • D) x)
    rw [envelopingDerivationLinear_ι]
    change t • ι (D x) = ι (t • D x)
    exact (map_smul (UniversalEnvelopingAlgebra.ι R) _ _).symm

/-- Extension respects commutators of derivations. -/
theorem envelopingDerivationLinear_lie (D E : LieDerivation R L L) :
    envelopingDerivationLinear ⁅D, E⁆ =
      ⁅envelopingDerivationLinear D, envelopingDerivationLinear E⁆ := by
  symm
  apply envelopingDerivationLinear_unique
  · change envelopingDerivationLinear D (envelopingDerivationLinear E 1) -
      envelopingDerivationLinear E (envelopingDerivationLinear D 1) = 0
    rw [envelopingDerivationLinear_one, envelopingDerivationLinear_one,
      map_zero, map_zero, sub_self]
  · intro u v
    change envelopingDerivationLinear D (envelopingDerivationLinear E (u * v)) -
        envelopingDerivationLinear E (envelopingDerivationLinear D (u * v)) =
      u * (envelopingDerivationLinear D (envelopingDerivationLinear E v) -
        envelopingDerivationLinear E (envelopingDerivationLinear D v)) +
      (envelopingDerivationLinear D (envelopingDerivationLinear E u) -
        envelopingDerivationLinear E (envelopingDerivationLinear D u)) * v
    simp only [envelopingDerivationLinear_mul, map_add, mul_sub, sub_mul]
    abel
  · intro x
    change envelopingDerivationLinear D (envelopingDerivationLinear E (ι x)) -
      envelopingDerivationLinear E (envelopingDerivationLinear D (ι x)) = ι (⁅D, E⁆ x)
    simp only [envelopingDerivationLinear_ι, LieDerivation.lie_apply]
    exact (map_sub (UniversalEnvelopingAlgebra.ι R) _ _).symm

/-- All Lie derivations act on the enveloping algebra by their constructed
associative extensions. -/
def envelopingDerivationAction : LieDerivation R L L →ₗ⁅R⁆ Module.End R U where
  toFun := envelopingDerivationLinear
  map_add' := envelopingDerivationLinear_add
  map_smul' := envelopingDerivationLinear_smul
  map_lie' := envelopingDerivationLinear_lie _ _

@[simp]
theorem envelopingDerivationAction_ι (D : LieDerivation R L L) (x : L) :
    envelopingDerivationAction D (ι x) = ι (D x) := envelopingDerivationLinear_ι D x

end LieGroups

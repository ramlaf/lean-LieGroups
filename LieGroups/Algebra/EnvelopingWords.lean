import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.LinearAlgebra.Basis.Basic
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Words in an enveloping algebra

Products of basis generators span the actual universal enveloping algebra.
Swapping adjacent generators replaces a word by the reversed adjacent pair and
a finite linear combination of shorter words given by the bracket coordinates.
These statements assert spanning and the defining commutator relation only;
they do not assert linear independence or injectivity of the canonical Lie map.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open scoped BigOperators
open Module

namespace LieGroups

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

attribute [local instance] LieRing.ofAssociativeRing

/-- The product of the enveloping-algebra generators indexed by a word. -/
def envelopingWord (b : Basis ι R L) (w : List ι) : UniversalEnvelopingAlgebra R L :=
  (w.map (fun i => UniversalEnvelopingAlgebra.ι R (b i))).prod

@[simp]
theorem envelopingWord_nil (b : Basis ι R L) : envelopingWord b [] = 1 := rfl

@[simp]
theorem envelopingWord_cons (b : Basis ι R L) (i : ι) (w : List ι) :
    envelopingWord b (i :: w) = UniversalEnvelopingAlgebra.ι R (b i) * envelopingWord b w := rfl

@[simp]
theorem envelopingWord_singleton (b : Basis ι R L) (i : ι) :
    envelopingWord b [i] = UniversalEnvelopingAlgebra.ι R (b i) := by
  simp

theorem envelopingWord_append (b : Basis ι R L) (p s : List ι) :
    envelopingWord b (p ++ s) = envelopingWord b p * envelopingWord b s := by
  simp only [envelopingWord, List.map_append, List.prod_append]

/-- Expand the canonical generator in the coordinates of a basis. -/
theorem envelopingι_eq_sum (b : Basis ι R L) (x : L) :
    UniversalEnvelopingAlgebra.ι R x =
      ∑ k ∈ (b.repr x).support, b.repr x k • envelopingWord b [k] := by
  classical
  have h := congrArg (UniversalEnvelopingAlgebra.ι R) (b.linearCombination_repr x)
  simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum, map_smul,
    envelopingWord_singleton] at h ⊢
  exact h.symm

/-- The defining commutator relation, inserted into an arbitrary prefix and
suffix. Every correction term is shorter by one letter. -/
theorem envelopingWord_swap (b : Basis ι R L) (p s : List ι) (a c : ι) :
    envelopingWord b (p ++ a :: c :: s) =
      envelopingWord b (p ++ c :: a :: s) +
        ∑ k ∈ (b.repr ⁅b a, b c⁆).support,
          b.repr ⁅b a, b c⁆ k • envelopingWord b (p ++ k :: s) := by
  classical
  have hcomm : UniversalEnvelopingAlgebra.ι R (b a) *
      UniversalEnvelopingAlgebra.ι R (b c) =
      UniversalEnvelopingAlgebra.ι R (b c) * UniversalEnvelopingAlgebra.ι R (b a) +
        UniversalEnvelopingAlgebra.ι R ⁅b a, b c⁆ := by
    have h := LieHom.map_lie (UniversalEnvelopingAlgebra.ι R) (b a) (b c)
    rw [Ring.lie_def, eq_sub_iff_add_eq] at h
    simpa only [add_comm] using h.symm
  simp only [envelopingWord_append, envelopingWord_cons]
  calc
    _ = envelopingWord b p *
        ((UniversalEnvelopingAlgebra.ι R (b a) *
          UniversalEnvelopingAlgebra.ι R (b c)) * envelopingWord b s) := by
      rw [mul_assoc]
    _ = envelopingWord b p *
        ((UniversalEnvelopingAlgebra.ι R (b c) *
            UniversalEnvelopingAlgebra.ι R (b a) +
          UniversalEnvelopingAlgebra.ι R ⁅b a, b c⁆) * envelopingWord b s) := by
      rw [hcomm]
    _ = envelopingWord b p * (UniversalEnvelopingAlgebra.ι R (b c) *
          (UniversalEnvelopingAlgebra.ι R (b a) * envelopingWord b s)) +
        envelopingWord b p *
          (UniversalEnvelopingAlgebra.ι R ⁅b a, b c⁆ * envelopingWord b s) := by
      simp only [add_mul, mul_add, mul_assoc]
    _ = _ := by
      rw [envelopingι_eq_sum b ⁅b a, b c⁆]
      simp only [envelopingWord_singleton, Finset.sum_mul, Finset.mul_sum,
        smul_mul_assoc, mul_smul_comm]

/-- All basis words, without any ordering restriction, span the actual
universal enveloping algebra. -/
theorem span_range_envelopingWord (b : Basis ι R L) :
    Submodule.span R (Set.range (envelopingWord b)) = ⊤ := by
  classical
  let S : Submodule R (UniversalEnvelopingAlgebra R L) :=
    Submodule.span R (Set.range (envelopingWord b))
  have hword (w : List ι) : envelopingWord b w ∈ S :=
    Submodule.subset_span (Set.mem_range_self w)
  have hone : (1 : UniversalEnvelopingAlgebra R L) ∈ S := by
    simpa only [envelopingWord_nil] using hword []
  have hmul {x y : UniversalEnvelopingAlgebra R L} (hx : x ∈ S) (hy : y ∈ S) :
      x * y ∈ S := by
    induction hx, hy using Submodule.span_induction₂ with
    | mem_mem x y hx hy =>
        obtain ⟨p, rfl⟩ := hx
        obtain ⟨s, rfl⟩ := hy
        rw [← envelopingWord_append]
        exact hword (p ++ s)
    | zero_left y hy => simpa only [zero_mul] using S.zero_mem
    | zero_right x hx => simpa only [mul_zero] using S.zero_mem
    | add_left x₁ x₂ y hx₁ hx₂ hy h₁ h₂ =>
        simpa only [add_mul] using S.add_mem h₁ h₂
    | add_right x y₁ y₂ hx hy₁ hy₂ h₁ h₂ =>
        simpa only [mul_add] using S.add_mem h₁ h₂
    | smul_left r x y hx hy h => simpa only [smul_mul_assoc] using S.smul_mem r h
    | smul_right r x y hx hy h => simpa only [mul_smul_comm] using S.smul_mem r h
  apply top_unique
  intro x hx
  clear hx
  obtain ⟨t, rfl⟩ := (UniversalEnvelopingAlgebra.ringCon R L).mkₐ_surjective (α := R) x
  change UniversalEnvelopingAlgebra.mkAlgHom R L t ∈ S
  induction t using TensorAlgebra.induction with
  | algebraMap r =>
      rw [AlgHom.commutes]
      simpa only [Algebra.smul_def, mul_one] using S.smul_mem r hone
  | ι x =>
      change UniversalEnvelopingAlgebra.ι R x ∈ S
      rw [envelopingι_eq_sum b x]
      exact S.sum_mem fun k _ => S.smul_mem _ (hword [k])
  | mul x y hx hy =>
      rw [map_mul]
      exact hmul hx hy
  | add x y hx hy =>
      rw [map_add]
      exact S.add_mem hx hy

end LieGroups

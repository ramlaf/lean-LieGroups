import LieGroups.Algebra.PBWNormalForm
import Mathlib.LinearAlgebra.TensorAlgebra.Basis

/-!
# Tensor-algebra coordinates for word normalization

The genuine word basis of the tensor algebra extends the recursively constructed
word normal form to a linear map. Evaluation in the universal enveloping algebra
recovers the original word and the tensor-to-enveloping quotient map. This does
not assume that normalization respects every defining relation.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module
open scoped BigOperators

namespace LieGroups

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

/-- A product of basis generators in the actual tensor algebra. -/
def tensorWord (b : Basis ι R L) (w : List ι) : TensorAlgebra R L :=
  (w.map (fun i => TensorAlgebra.ι R (b i))).prod

@[simp]
theorem tensorWord_nil (b : Basis ι R L) : tensorWord b [] = 1 := rfl

@[simp]
theorem tensorWord_cons (b : Basis ι R L) (i : ι) (w : List ι) :
    tensorWord b (i :: w) = TensorAlgebra.ι R (b i) * tensorWord b w := rfl

@[simp]
theorem tensorWord_singleton (b : Basis ι R L) (i : ι) :
    tensorWord b [i] = TensorAlgebra.ι R (b i) := by
  simp

theorem tensorWord_append (b : Basis ι R L) (p s : List ι) :
    tensorWord b (p ++ s) = tensorWord b p * tensorWord b s := by
  simp only [tensorWord, List.map_append, List.prod_append]

private theorem freeAlgebra_basisFreeMonoid_eq_lift (w : FreeMonoid ι) :
    FreeAlgebra.basisFreeMonoid R ι w = FreeMonoid.lift (FreeAlgebra.ι R) w := by
  change MonoidAlgebra.lift R (FreeAlgebra R ι) (FreeMonoid ι)
    (FreeMonoid.lift (FreeAlgebra.ι R)) (MonoidAlgebra.single w 1) = _
  rw [MonoidAlgebra.lift_single, one_smul]

/-- Products of tensor generators are exactly Mathlib's free-monoid basis elements. -/
theorem tensorWord_eq_basis (b : Basis ι R L) (w : List ι) :
    tensorWord b w = b.tensorAlgebra (FreeMonoid.ofList w) := by
  rw [Basis.tensorAlgebra, Basis.map_apply, freeAlgebra_basisFreeMonoid_eq_lift,
    FreeMonoid.lift_ofList]
  change tensorWord b w = (TensorAlgebra.equivFreeAlgebra b).symm
    ((w.map (FreeAlgebra.ι R)).prod)
  simp only [map_list_prod, List.map_map, Function.comp_def,
    TensorAlgebra.equivFreeAlgebra_symm_ι, tensorWord]

/-- The actual tensor-to-enveloping quotient map sends tensor words to enveloping words. -/
@[simp]
theorem mkAlgHom_tensorWord (b : Basis ι R L) (w : List ι) :
    UniversalEnvelopingAlgebra.mkAlgHom R L (tensorWord b w) = envelopingWord b w := by
  induction w with
  | nil => simp
  | cons i w ih =>
      rw [tensorWord_cons, map_mul, ih, envelopingWord_cons]
      rfl

variable [LinearOrder ι] [WellFoundedLT ι]

/-- Linear extension of word normal forms along the genuine tensor-algebra basis. -/
def pbwTensorNormalForm (b : Basis ι R L) : TensorAlgebra R L →ₗ[R] (List ι →₀ R) :=
  b.tensorAlgebra.constr R (fun w => pbwNormalForm b w.toList)

@[simp]
theorem pbwTensorNormalForm_basis (b : Basis ι R L) (w : FreeMonoid ι) :
    pbwTensorNormalForm b (b.tensorAlgebra w) = pbwNormalForm b w.toList := by
  simp only [pbwTensorNormalForm, Basis.constr_basis]

@[simp]
theorem pbwTensorNormalForm_word (b : Basis ι R L) (w : List ι) :
    pbwTensorNormalForm b (tensorWord b w) = pbwNormalForm b w := by
  rw [tensorWord_eq_basis, pbwTensorNormalForm_basis, FreeMonoid.toList_ofList]

/-- Evaluation of formal basis-word combinations in the enveloping algebra. -/
def pbwWordEvaluation (b : Basis ι R L) :
    (List ι →₀ R) →ₗ[R] UniversalEnvelopingAlgebra R L :=
  Finsupp.linearCombination R (envelopingWord b)

omit [LinearOrder ι] [WellFoundedLT ι] in
@[simp]
theorem pbwWordEvaluation_single (b : Basis ι R L) (w : List ι) (r : R) :
    pbwWordEvaluation b (Finsupp.single w r) = r • envelopingWord b w :=
  Finsupp.linearCombination_single R r w

omit [WellFoundedLT ι] in
/-- Every chosen-descent reduction has its original value in the enveloping algebra. -/
theorem pbwWordEvaluation_reduceDescent (b : Basis ι R L) {w : List ι}
    (d : PBWAdjacentDescent w) :
    pbwWordEvaluation b (pbwReduceDescent b d) = envelopingWord b w := by
  rcases d with ⟨p, a, c, s, rfl, _hlt⟩
  simp only [pbwReduceDescent, map_add, map_sum, map_smul,
    pbwWordEvaluation_single, one_smul, PBWAdjacentDescent.swapped,
    PBWAdjacentDescent.contract]
  exact (envelopingWord_swap b p s a c).symm

/-- Normalizing a word preserves its value in the actual enveloping algebra. -/
theorem pbwWordEvaluation_normalForm (b : Basis ι R L) (w : List ι) :
    pbwWordEvaluation b (pbwNormalForm b w) = envelopingWord b w := by
  have hWF : WellFounded (List.Shortlex ((· < ·) : ι → ι → Prop)) := pbwWordWellFounded
  induction w using hWF.induction with
  | h w ih =>
    by_cases hw : w.Pairwise (· ≤ ·)
    · rw [pbwNormalForm_eq_ordered b hw, pbwWordEvaluation_single, one_smul]
    · let d := pbwChosenDescent w hw
      rw [pbwNormalForm_eq_chosen b w hw, map_add, map_sum]
      change pbwWordEvaluation b (pbwNormalForm b d.swapped) +
        (∑ k ∈ (b.repr ⁅b d.left, b d.right⁆).support,
          pbwWordEvaluation b (b.repr ⁅b d.left, b d.right⁆ k •
            pbwNormalForm b (d.contract k))) = envelopingWord b w
      rw [ih d.swapped d.swapped_shortlex]
      calc
        _ = envelopingWord b d.swapped +
            ∑ k ∈ (b.repr ⁅b d.left, b d.right⁆).support,
              b.repr ⁅b d.left, b d.right⁆ k • envelopingWord b (d.contract k) := by
          congr 1
          apply Finset.sum_congr rfl
          intro k _
          rw [map_smul, ih (d.contract k) (d.contract_shortlex k)]
        _ = envelopingWord b (d.prefix ++ d.left :: d.right :: d.suffix) :=
          (envelopingWord_swap b d.prefix d.suffix d.left d.right).symm
        _ = envelopingWord b w := congrArg (envelopingWord b) d.eq_word.symm

/-- Evaluating tensor normal forms is exactly the actual enveloping-algebra quotient map. -/
theorem pbwWordEvaluation_comp_tensorNormalForm (b : Basis ι R L) :
    (pbwWordEvaluation b).comp (pbwTensorNormalForm b) =
      (UniversalEnvelopingAlgebra.mkAlgHom R L).toLinearMap := by
  apply b.tensorAlgebra.ext
  intro w
  rw [LinearMap.comp_apply, pbwTensorNormalForm_basis, pbwWordEvaluation_normalForm]
  rw [← mkAlgHom_tensorWord b w.toList, tensorWord_eq_basis, FreeMonoid.ofList_toList]
  rfl

end LieGroups

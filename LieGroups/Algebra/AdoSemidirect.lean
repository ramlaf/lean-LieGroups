import LieGroups.Algebra.AdoDerivation
import Mathlib.Algebra.Lie.SemiDirect

/-!
# The semidirect action on the universal enveloping algebra

The Lie algebra and its derivations act together on the enveloping algebra:
the former by left multiplication and the latter by their unique associative
extensions. This action is the starting point for the finite quotient modules
in Ado's theorem.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable (R L : Type*) [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "U" => UniversalEnvelopingAlgebra R L
local notation "ι" => UniversalEnvelopingAlgebra.ι R

/-- The Lie algebra acted on by its full derivation algebra. -/
abbrev DerivationSemidirect :=
  LieAlgebra.SemiDirectSum L (LieDerivation R L L)
    (LieHom.id : LieDerivation R L L →ₗ⁅R⁆ LieDerivation R L L)

private def envelopingSemidirectEndomorphism (p : DerivationSemidirect R L) : Module.End R U where
  toFun u := ι p.left * u + envelopingDerivationLinear p.right u
  map_add' u v := by
    rw [mul_add, map_add]
    abel
  map_smul' t u := by
    rw [mul_smul_comm, map_smul, smul_add]
    rfl

/-- Left multiplication and derivations combine into an actual representation
of the semidirect Lie algebra. -/
def envelopingSemidirectRepresentation : DerivationSemidirect R L →ₗ⁅R⁆ Module.End R U where
  toFun := envelopingSemidirectEndomorphism R L
  map_add' p q := by
    apply LinearMap.ext
    intro u
    change ι (p.left + q.left) * u + envelopingDerivationLinear (p.right + q.right) u =
      (ι p.left * u + envelopingDerivationLinear p.right u) +
        (ι q.left * u + envelopingDerivationLinear q.right u)
    rw [map_add, add_mul, envelopingDerivationLinear_add, LinearMap.add_apply]
    abel
  map_smul' t p := by
    apply LinearMap.ext
    intro u
    change ι (t • p.left) * u + envelopingDerivationLinear (t • p.right) u =
      t • (ι p.left * u + envelopingDerivationLinear p.right u)
    rw [map_smul, smul_mul_assoc, envelopingDerivationLinear_smul, LinearMap.smul_apply,
      smul_add]
  map_lie' := by
    intro p q
    apply LinearMap.ext
    intro u
    change ι (⁅p.left, q.left⁆ + p.right q.left - q.right p.left) * u +
        envelopingDerivationLinear ⁅p.right, q.right⁆ u =
      (ι p.left * (ι q.left * u + envelopingDerivationLinear q.right u) +
          envelopingDerivationLinear p.right
            (ι q.left * u + envelopingDerivationLinear q.right u)) -
        (ι q.left * (ι p.left * u + envelopingDerivationLinear p.right u) +
          envelopingDerivationLinear q.right
            (ι p.left * u + envelopingDerivationLinear p.right u))
    rw [map_sub, map_add, LieHom.map_lie, envelopingDerivationLinear_lie]
    change ((ι p.left * ι q.left - ι q.left * ι p.left) +
          ι (p.right q.left) - ι (q.right p.left)) * u +
        (envelopingDerivationLinear p.right (envelopingDerivationLinear q.right u) -
          envelopingDerivationLinear q.right (envelopingDerivationLinear p.right u)) = _
    rw [map_add, map_add, envelopingDerivationLinear_mul, envelopingDerivationLinear_mul,
      envelopingDerivationLinear_ι, envelopingDerivationLinear_ι]
    simp only [add_mul, sub_mul, mul_add, mul_assoc]
    abel

@[simp]
theorem envelopingSemidirectRepresentation_apply (p : DerivationSemidirect R L) (u : U) :
    envelopingSemidirectRepresentation R L p u =
      ι p.left * u + envelopingDerivationLinear p.right u := rfl

@[simp]
theorem envelopingSemidirectRepresentation_one (p : DerivationSemidirect R L) :
    envelopingSemidirectRepresentation R L p 1 = ι p.left := by
  rw [envelopingSemidirectRepresentation_apply, envelopingDerivationLinear_one, mul_one, add_zero]

end LieGroups

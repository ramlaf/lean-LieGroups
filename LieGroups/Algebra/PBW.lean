import LieGroups.Algebra.PBWDescent
import LieGroups.Algebra.PBWCriterion
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-!
# The Poincaré–Birkhoff–Witt basis theorem

For a Lie algebra with a well-ordered free basis over a commutative ring, weakly
ordered monomials form a basis of its actual universal enveloping algebra.
The proof uses the constructed normal form, contextual confluence, and descent
through the defining congruence. No representation or independence hypothesis
is supplied. In particular, the canonical Lie map is injective.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [LinearOrder ι] [WellFoundedLT ι]

/-- Ordered monomials in a free basis are linearly independent in the actual
universal enveloping algebra. -/
theorem linearIndependent_orderedEnvelopingWord (b : Basis ι R L) :
    LinearIndependent R (fun w : PBWOrderedWord ι => envelopingWord b w.val) :=
  orderedEnvelopingWord_linearIndependent_of_normalForm b (pbwEnvelopingNormalForm b)
    (pbwEnvelopingNormalForm_ordered b)

/-- The Poincaré–Birkhoff–Witt basis of the actual universal enveloping algebra. -/
def pbwBasis (b : Basis ι R L) : Basis (PBWOrderedWord ι) R (UniversalEnvelopingAlgebra R L) :=
  pbwBasisOfNormalForm b (pbwEnvelopingNormalForm b) (pbwEnvelopingNormalForm_ordered b)

@[simp]
theorem pbwBasis_apply (b : Basis ι R L) (w : PBWOrderedWord ι) :
    pbwBasis b w = envelopingWord b w.val :=
  pbwBasisOfNormalForm_apply _ _ _ _

/-- PBW proves injectivity of the canonical Lie homomorphism for every Lie
algebra with the given free basis; no faithful representation is assumed. -/
theorem universalEnveloping_ι_injective (b : Basis ι R L) :
    Function.Injective (UniversalEnvelopingAlgebra.ι R : L → UniversalEnvelopingAlgebra R L) :=
  universalEnveloping_ι_injective_of_normalForm b (pbwEnvelopingNormalForm b)
    (pbwEnvelopingNormalForm_ordered b)

/-- Every finite-dimensional Lie algebra over a field embeds in its actual
universal enveloping algebra. -/
theorem universalEnveloping_ι_injective_finiteDimensional
    {K M : Type*} [Field K] [LieRing M] [LieAlgebra K M] [FiniteDimensional K M] :
    Function.Injective (UniversalEnvelopingAlgebra.ι K : M → UniversalEnvelopingAlgebra K M) :=
  universalEnveloping_ι_injective (Module.finBasis K M)

end LieGroups

import LieGroups.Algebra.PBWDisjoint

/-!
# Choice independence of PBW normal forms

Shortlex induction compares two possible first descents. Disjoint descents
commute, and overlapping descents agree by the Jacobi correction identity.
Consequently the recursively constructed normal form respects commutation in
every word context, independently of the descent chosen by the recursion.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open Module

namespace LieGroups

variable {R L ι M : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [AddCommGroup M] [Module R M] [LinearOrder ι]

/-- Any two first reductions agree once all smaller-word commutations hold. -/
theorem pbw_descent_values_eq_of_below (b : Basis ι R L) (N : List ι → M)
    {w : List ι} (d e : PBWAdjacentDescent w) (hbelow : PBWSwapBelow b N w) :
    N d.swapped + pbwInsertion b N d.prefix d.suffix ⁅b d.left, b d.right⁆ =
      N e.swapped + pbwInsertion b N e.prefix e.suffix ⁅b e.left, b e.right⁆ := by
  rcases d with ⟨p, a, c, s, rfl, hca⟩
  rcases e with ⟨q, d, e, t, heq, hed⟩
  change N (p ++ c :: a :: s) + pbwInsertion b N p s ⁅b a, b c⁆ =
    N (q ++ e :: d :: t) + pbwInsertion b N q t ⁅b d, b e⁆
  rcases adjacentPair_overlap p q a c d e s t heq with
      hsame | ⟨m, hq, hs⟩ | ⟨hq, hd, hs⟩ | ⟨m, hp, ht⟩ | ⟨hp, ha, ht⟩
  · rcases hsame with ⟨rfl, rfl, rfl, rfl⟩
    rfl
  · subst q
    subst s
    exact pbw_disjoint_branch_eq b N p m t a c d e hca hed hbelow
  · subst q
    subst d
    subst s
    simpa only [List.append_assoc, List.cons_append, List.nil_append] using
      pbw_overlap_branch_eq b N p t a c e hca hed hbelow
  · subst p
    subst t
    have hb : PBWSwapBelow b N (q ++ d :: e :: (m ++ a :: c :: s)) := by
      simpa only [List.append_assoc, List.cons_append] using hbelow
    simpa only [List.append_assoc, List.cons_append] using
      (pbw_disjoint_branch_eq b N q m s d e a c hed hca hb).symm
  · subst p
    subst a
    subst t
    have hb : PBWSwapBelow b N (q ++ d :: e :: c :: s) := by
      simpa only [List.append_assoc, List.cons_append, List.nil_append] using hbelow
    simpa only [List.append_assoc, List.cons_append, List.nil_append] using
      (pbw_overlap_branch_eq b N q s d e c hed hca hb).symm

variable [WellFoundedLT ι]

/-- The linear normal form of a formal reduction is its word-value expression. -/
theorem pbwNormalFormLinear_reduce_value (b : Basis ι R L) {w : List ι}
    (d : PBWAdjacentDescent w) :
    pbwNormalFormLinear b (pbwReduceDescent b d) =
      pbwNormalForm b d.swapped +
        pbwInsertion b (pbwNormalForm b) d.prefix d.suffix ⁅b d.left, b d.right⁆ := by
  simp only [pbwReduceDescent, map_add, map_sum, map_smul,
    pbwNormalFormLinear_single, one_smul, pbwInsertion_apply, PBWAdjacentDescent.contract]

/-- Every descending adjacent pair gives the same normal form as the descent
actually chosen by the recursive definition. -/
theorem pbwNormalForm_reduce_descent (b : Basis ι R L) {w : List ι}
    (d : PBWAdjacentDescent w) :
    pbwNormalFormLinear b (pbwReduceDescent b d) = pbwNormalForm b w := by
  have hall : ∀ w : List ι, ∀ d : PBWAdjacentDescent w,
      pbwNormalFormLinear b (pbwReduceDescent b d) = pbwNormalForm b w := by
    intro w
    induction w using (pbwWordWellFounded (ι := ι)).induction with
    | h w ih =>
      intro d
      have hbelow : PBWSwapBelow b (pbwNormalForm b) w := by
        intro p a c s hca hlt
        let e : PBWAdjacentDescent (p ++ a :: c :: s) := ⟨p, a, c, s, rfl, hca⟩
        have he := ih _ hlt e
        rw [pbwNormalFormLinear_reduce_value] at he
        exact he.symm
      have hw : ¬w.Pairwise (· ≤ ·) := by
        intro ho
        rw [d.eq_word] at ho
        have ht : (d.left :: d.right :: d.suffix).Pairwise (· ≤ ·) :=
          (List.pairwise_append.mp ho).2.1
        exact (not_le_of_gt d.lt) (List.pairwise_cons_cons_iff_of_trans.mp ht).1
      let e := pbwChosenDescent w hw
      calc
        pbwNormalFormLinear b (pbwReduceDescent b d) =
            pbwNormalForm b d.swapped +
              pbwInsertion b (pbwNormalForm b) d.prefix d.suffix ⁅b d.left, b d.right⁆ :=
          pbwNormalFormLinear_reduce_value b d
        _ = pbwNormalForm b e.swapped +
              pbwInsertion b (pbwNormalForm b) e.prefix e.suffix ⁅b e.left, b e.right⁆ :=
          pbw_descent_values_eq_of_below b (pbwNormalForm b) d e hbelow
        _ = pbwNormalFormLinear b (pbwReduceDescent b e) :=
          (pbwNormalFormLinear_reduce_value b e).symm
        _ = pbwNormalForm b w := pbwNormalFormLinear_reduce_chosen b w hw
  exact hall w d

/-- The normal form respects the contextual commutation relation for every
pair of letters, regardless of their order. -/
theorem pbwNormalForm_swap (b : Basis ι R L) (p s : List ι) (a c : ι) :
    pbwNormalForm b (p ++ a :: c :: s) =
      pbwNormalForm b (p ++ c :: a :: s) +
        pbwInsertion b (pbwNormalForm b) p s ⁅b a, b c⁆ := by
  have hdesc (i j : ι) (hji : j < i) :
      pbwNormalForm b (p ++ i :: j :: s) =
        pbwNormalForm b (p ++ j :: i :: s) +
          pbwInsertion b (pbwNormalForm b) p s ⁅b i, b j⁆ := by
    let d : PBWAdjacentDescent (p ++ i :: j :: s) := ⟨p, i, j, s, rfl, hji⟩
    have h := pbwNormalForm_reduce_descent b d
    rw [pbwNormalFormLinear_reduce_value] at h
    exact h.symm
  have h := pbw_commutator_of_descents b (pbwNormalForm b) p s hdesc a c
  simpa only [add_comm] using sub_eq_iff_eq_add.mp h

end LieGroups

import LieGroups.Algebra.WhiteheadTrivial
import Mathlib.Algebra.Lie.Extension
import Mathlib.Algebra.Module.Projective

/-!
# Splitting central extensions of Killing Lie algebras

The trivial-coefficient Whitehead lemma corrects a linear section into a Lie
section. Centrality and exactness are the only assumptions on the extension.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

variable {K L M : Type*} [Field K] [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [LieAlgebra.IsKilling K L]
  [LieRing M] [LieAlgebra K M] [FiniteDimensional K M]

/-- A central extension of a finite-dimensional Killing Lie algebra admits a
Lie algebra section. -/
theorem exists_lieSection_of_central_extension (E : LieAlgebra.Extension K M L)
    (hcentral : ∀ (x : E.L) (m : M), ⁅x, E.incl m⁆ = 0) :
    ∃ s : L →ₗ⁅K⁆ E.L, Function.LeftInverse E.proj s := by
  let : IsLieAbelian M := ⟨fun x y => E.incl_injective <| by
    rw [LieHom.map_lie, hcentral, map_zero]⟩
  let := E.ringModuleOf
  let := E.lieModuleOf
  let : LieModule.IsTrivial L M := ⟨fun x m => by
    change E.toKer.symm
      ⁅E.proj_surjective.hasRightInverse.choose x, E.toKer m⁆ = 0
    calc
      _ = E.toKer.symm 0 := by
        congr 1
        ext
        exact hcentral _ m
      _ = 0 := map_zero _⟩
  obtain ⟨s, hs⟩ := E.proj.toLinearMap.exists_rightInverse_of_surjective
    (LinearMap.range_eq_top.mpr E.proj_surjective)
  have hs' : Function.LeftInverse E.proj s := fun x =>
    congrArg (fun f : L →ₗ[K] L => f x) hs
  let c := E.twoCocycleOf hs'
  obtain ⟨f, hf⟩ := trivialCocycle_eq_bracket_linear c.val.val
    ((LieModule.Cohomology.mem_twoCocycle_iff_of_trivial K L M c.val).mp c.property)
  have hc (x y : L) : E.incl (c.val x y) = ⁅s x, s y⁆ - s ⁅x, y⁆ := by
    change (E.toKer (E.toKer.symm
      ⟨⁅s x, s y⁆ - s ⁅x, y⁆, _⟩) : E.L) = _
    simp
  let t : L →ₗ[K] E.L := s + E.incl.toLinearMap.comp f
  refine ⟨{ toLinearMap := t, map_lie' := ?_ }, ?_⟩
  · intro x y
    change s ⁅x, y⁆ + E.incl (f ⁅x, y⁆) =
      ⁅s x + E.incl (f x), s y + E.incl (f y)⁆
    rw [lie_add, add_lie, add_lie, hcentral, hcentral]
    have hleft : ⁅E.incl (f x), s y⁆ = 0 := by
      rw [← lie_skew, hcentral, neg_zero]
    rw [hleft, zero_add, add_zero, add_zero, ← hf]
    change s ⁅x, y⁆ + E.incl (c.val x y) = ⁅s x, s y⁆
    rw [hc]
    abel
  · intro x
    change E.proj (s x + E.incl (f x)) = x
    rw [map_add, E.proj_incl, add_zero, hs']

end LieGroups

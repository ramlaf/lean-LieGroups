import Mathlib.Algebra.Lie.Cochain
import Mathlib.Algebra.Lie.Derivation.Killing
import Mathlib.Algebra.Lie.CartanCriterion
import Mathlib.LinearAlgebra.BilinearForm.Properties

/-!
# Whitehead's second lemma with trivial coefficients

Killing duality converts a scalar cocycle into a derivation. Innerness of
derivations then identifies the cocycle as a bracket-linear functional, hence a
coboundary for the trivial action.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open Module

namespace LieGroups

variable {K L : Type*} [Field K] [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [LieAlgebra.IsKilling K L]

/-- The derivation corresponding through Killing duality to a scalar cocycle. -/
def killingCocycleDerivation (c : L →ₗ[K] L →ₗ[K] K)
    (hc : ∀ x y z, c x ⁅y, z⁆ = c ⁅x, y⁆ z + c y ⁅x, z⁆) :
    LieDerivation K L L := by
  let B := killingForm K L
  let hB := LieAlgebra.IsKilling.killingForm_nondegenerate K L
  let f : L →ₗ[K] L := (B.toDual hB).symm.toLinearMap.comp c
  refine { toLinearMap := f, leibniz' := ?_ }
  intro x y
  apply (B.toDual hB).injective
  ext z
  change B (f ⁅x, y⁆) z = B (⁅x, f y⁆ - ⁅y, f x⁆) z
  have hf (u v : L) : B (f u) v = c u v := by
    simp only [f, LinearMap.comp_apply, LinearEquiv.coe_toLinearMap,
      LinearMap.BilinForm.apply_toDual_symm_apply]
  rw [map_sub, LinearMap.sub_apply]
  change B (f ⁅x, y⁆) z =
    LieModule.traceForm K L L ⁅x, f y⁆ z - LieModule.traceForm K L L ⁅y, f x⁆ z
  rw [LieModule.traceForm_apply_lie_apply', LieModule.traceForm_apply_lie_apply']
  change B (f ⁅x, y⁆) z = -B (f y) ⁅x, z⁆ - -B (f x) ⁅y, z⁆
  rw [hf, hf, hf]
  linear_combination -(hc x y z)

/-- The constructed derivation has the prescribed scalar pairing. -/
theorem killingCocycleDerivation_pair (c : L →ₗ[K] L →ₗ[K] K)
    (hc : ∀ x y z, c x ⁅y, z⁆ = c ⁅x, y⁆ z + c y ⁅x, z⁆) (x y : L) :
    killingForm K L (killingCocycleDerivation c hc x) y = c x y := by
  change killingForm K L
    (((killingForm K L).toDual
      (LieAlgebra.IsKilling.killingForm_nondegenerate K L)).symm (c x)) y = c x y
  exact LinearMap.BilinForm.apply_toDual_symm_apply _ _

/-- A scalar cocycle on a finite-dimensional Killing Lie algebra is a linear
functional of the bracket. No cohomology-vanishing hypothesis is supplied. -/
theorem scalarCocycle_eq_bracket_linear (c : L →ₗ[K] L →ₗ[K] K)
    (hc : ∀ x y z, c x ⁅y, z⁆ = c ⁅x, y⁆ z + c y ⁅x, z⁆) :
    ∃ f : L →ₗ[K] K, ∀ x y, c x y = f ⁅x, y⁆ := by
  let D := killingCocycleDerivation c hc
  obtain ⟨a, ha⟩ := LieDerivation.IsKilling.exists_eq_ad D
  refine ⟨killingForm K L a, fun x y => ?_⟩
  have hDx : D x = ⁅a, x⁆ := by
    calc
      D x = LieDerivation.ad K L a x :=
        (congrArg (fun d : LieDerivation K L L => d x) ha).symm
      _ = ⁅a, x⁆ := lie_skew a x
  calc
    c x y = killingForm K L (D x) y :=
      (killingCocycleDerivation_pair c hc x y).symm
    _ = killingForm K L ⁅a, x⁆ y := by rw [hDx]
    _ = killingForm K L a ⁅x, y⁆ :=
      LieModule.traceForm_apply_lie_apply K L L a x y

/-- A vector-valued cocycle with trivial action is bracket-linear. The target
only needs to be a finite-dimensional vector space. -/
theorem trivialCocycle_eq_bracket_linear {M : Type*} [AddCommGroup M] [Module K M]
    [FiniteDimensional K M] (c : L →ₗ[K] L →ₗ[K] M)
    (hc : ∀ x y z, c x ⁅y, z⁆ = c ⁅x, y⁆ z + c y ⁅x, z⁆) :
    ∃ f : L →ₗ[K] M, ∀ x y, c x y = f ⁅x, y⁆ := by
  classical
  let b := Module.finBasis K M
  have hcoord (i : Fin (Module.finrank K M)) :
      ∃ f : L →ₗ[K] K, ∀ x y, b.coord i (c x y) = f ⁅x, y⁆ := by
    apply scalarCocycle_eq_bracket_linear (c.compr₂ (b.coord i))
    intro x y z
    change b.coord i (c x ⁅y, z⁆) =
      b.coord i (c ⁅x, y⁆ z) + b.coord i (c y ⁅x, z⁆)
    rw [hc, map_add]
  choose f hf using hcoord
  refine ⟨∑ i, (f i).smulRight (b i), fun x y => ?_⟩
  simp only [LinearMap.sum_apply, LinearMap.smulRight_apply, ← hf]
  exact (b.sum_repr (c x y)).symm

/-- Whitehead's second lemma for finite-dimensional trivial coefficients,
expressed using Mathlib's actual low-degree coboundary map. -/
theorem exists_coboundary_of_trivial_twoCocycle {M : Type*} [AddCommGroup M]
    [Module K M] [FiniteDimensional K M] [LieRingModule L M] [LieModule K L M]
    [LieModule.IsTrivial L M] (c : LieModule.Cohomology.twoCocycle K L M) :
    ∃ f : LieModule.Cohomology.oneCochain K L M,
      LieModule.Cohomology.d₁₂ K L M f = c.val := by
  obtain ⟨f, hf⟩ := trivialCocycle_eq_bracket_linear c.val.val
    ((LieModule.Cohomology.mem_twoCocycle_iff_of_trivial K L M c.val).mp c.property)
  refine ⟨-f, ?_⟩
  ext x y
  change LieModule.Cohomology.d₁₂ K L M (-f) x y = c.val x y
  rw [LieModule.Cohomology.d₁₂_apply_apply_ofTrivial]
  simpa using (hf x y).symm

end LieGroups

import Mathlib.Data.List.Basic

/-!
# Comparing two adjacent pairs in the same word

Two marked adjacent pairs either coincide, are disjoint, or overlap in one
letter. The explicit prefix/suffix equalities below avoid reasoning about
positions when resolving ambiguities in enveloping-algebra word reduction.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

namespace LieGroups

variable {ι : Type*}

/-- The five relative positions of two adjacent pairs in one word, with the
prefix and suffix equalities needed for contextual rewriting. -/
theorem adjacentPair_overlap (p q : List ι) (a b c d : ι) (s t : List ι)
    (h : p ++ a :: b :: s = q ++ c :: d :: t) :
    (p = q ∧ a = c ∧ b = d ∧ s = t) ∨
      (∃ r, q = p ++ a :: b :: r ∧ s = r ++ c :: d :: t) ∨
      (q = p ++ [a] ∧ c = b ∧ s = d :: t) ∨
      (∃ r, p = q ++ c :: d :: r ∧ t = r ++ a :: b :: s) ∨
      (p = q ++ [c] ∧ a = d ∧ t = b :: s) := by
  induction p generalizing q with
  | nil =>
    cases q with
    | nil =>
      simp only [List.nil_append, List.cons.injEq] at h
      exact Or.inl ⟨rfl, h⟩
    | cons x q =>
      cases q with
      | nil =>
        simp only [List.nil_append, List.cons_append, List.cons.injEq] at h
        obtain ⟨rfl, rfl, hs⟩ := h
        exact Or.inr (Or.inr (Or.inl ⟨rfl, rfl, hs⟩))
      | cons y r =>
        simp only [List.nil_append, List.cons_append, List.cons.injEq] at h
        obtain ⟨rfl, rfl, hs⟩ := h
        exact Or.inr (Or.inl ⟨r, rfl, hs⟩)
  | cons x p ih =>
    cases q with
    | nil =>
      cases p with
      | nil =>
        simp only [List.nil_append, List.cons_append, List.cons.injEq] at h
        obtain ⟨rfl, rfl, ht⟩ := h
        exact Or.inr (Or.inr (Or.inr (Or.inr ⟨rfl, rfl, ht.symm⟩)))
      | cons y r =>
        simp only [List.nil_append, List.cons_append, List.cons.injEq] at h
        obtain ⟨rfl, rfl, ht⟩ := h
        exact Or.inr (Or.inr (Or.inr (Or.inl ⟨r, rfl, ht.symm⟩)))
    | cons y q =>
      simp only [List.cons_append, List.cons.injEq] at h
      obtain ⟨rfl, h⟩ := h
      rcases ih q h with h | ⟨r, hq, hs⟩ | ⟨hq, hc, hs⟩ | ⟨r, hp, ht⟩ | ⟨hp, ha, ht⟩
      · exact Or.inl ⟨congrArg (List.cons x) h.1, h.2⟩
      · exact Or.inr (Or.inl ⟨r, by simp only [List.cons_append, hq], hs⟩)
      · exact Or.inr (Or.inr (Or.inl ⟨by simp only [List.cons_append, hq], hc, hs⟩))
      · exact Or.inr (Or.inr (Or.inr
          (Or.inl ⟨r, by simp only [List.cons_append, hp], ht⟩)))
      · exact Or.inr (Or.inr (Or.inr
          (Or.inr ⟨by simp only [List.cons_append, hp], ha, ht⟩)))

end LieGroups

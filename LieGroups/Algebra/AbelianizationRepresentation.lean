import Mathlib.Algebra.Lie.Solvable
import Mathlib.Algebra.Lie.Quotient
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-!
# Combining the adjoint action with abelianization translations

The adjoint representation misses precisely the center. Translations by the
abelianization detect the remaining central elements whenever the center meets
the derived ideal trivially. The resulting representation is explicit, and its
module is finite-dimensional whenever the original Lie algebra is.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable (𝕜 L : Type*) [Field 𝕜] [LieRing L] [LieAlgebra 𝕜 L]

/-- The vector-space abelianization of a Lie algebra. -/
abbrev LieAbelianization := L ⧸ LieAlgebra.derivedSeries 𝕜 L 1

/-- Projection to the abelianization as a linear map. -/
def lieAbelianizationProjection : L →ₗ[𝕜] LieAbelianization 𝕜 L :=
  (LieAlgebra.derivedSeries 𝕜 L 1).toSubmodule.mkQ

@[simp]
theorem lieAbelianizationProjection_eq_zero_iff (x : L) :
    lieAbelianizationProjection 𝕜 L x = 0 ↔ x ∈ LieAlgebra.derivedSeries 𝕜 L 1 :=
  Submodule.Quotient.mk_eq_zero _

/-- Every bracket vanishes under projection to the abelianization. -/
@[simp]
theorem lieAbelianizationProjection_lie (x y : L) :
    lieAbelianizationProjection 𝕜 L ⁅x, y⁆ = 0 := by
  rw [lieAbelianizationProjection_eq_zero_iff]
  change ⁅x, y⁆ ∈ ⁅(⊤ : LieIdeal 𝕜 L), (⊤ : LieIdeal 𝕜 L)⁆
  exact LieSubmodule.lie_mem_lie (by trivial) (by trivial)

/-- The module for the adjoint representation together with abelianization
translations. Its coordinates are `(t,y,q)`. -/
abbrev AdjointAbelianizationModule := 𝕜 × (L × LieAbelianization 𝕜 L)

/-- The endomorphism `(t,y,q) ↦ (0,[x,y],t • π(x))`. -/
def adjointAbelianizationEndomorphism (x : L) :
    Module.End 𝕜 (AdjointAbelianizationModule 𝕜 L) where
  toFun p := (0, ⁅x, p.2.1⁆, p.1 • lieAbelianizationProjection 𝕜 L x)
  map_add' p q := by
    apply Prod.ext
    · simp
    apply Prod.ext
    · exact lie_add _ _ _
    · exact add_smul _ _ _
  map_smul' t p := by
    apply Prod.ext
    · simp
    apply Prod.ext
    · exact lie_smul _ _ _
    · exact mul_smul _ _ _

@[simp]
theorem adjointAbelianizationEndomorphism_apply (x : L)
    (p : AdjointAbelianizationModule 𝕜 L) :
    adjointAbelianizationEndomorphism 𝕜 L x p =
      (0, ⁅x, p.2.1⁆, p.1 • lieAbelianizationProjection 𝕜 L x) := rfl

/-- The adjoint representation combined with the translation representation of
the abelianization. Its kernel is the intersection of the center and derived
ideal. -/
def adjointAbelianizationRepresentation :
    L →ₗ⁅𝕜⁆ Module.End 𝕜 (AdjointAbelianizationModule 𝕜 L) where
  toFun := adjointAbelianizationEndomorphism 𝕜 L
  map_add' x y := by
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · simp
    apply Prod.ext
    · exact add_lie _ _ _
    · exact congrArg (fun q => p.1 • q) (map_add (lieAbelianizationProjection 𝕜 L) x y) |>.trans
        (smul_add _ _ _)
  map_smul' t x := by
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · simp
    apply Prod.ext
    · exact smul_lie _ _ _
    · change p.1 • lieAbelianizationProjection 𝕜 L (t • x) =
        t • (p.1 • lieAbelianizationProjection 𝕜 L x)
      rw [map_smul, smul_comm]
  map_lie' := by
    intro x y
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · change (0 : 𝕜) = 0 - 0
      simp
    apply Prod.ext
    · change ⁅⁅x, y⁆, p.2.1⁆ = ⁅x, ⁅y, p.2.1⁆⁆ - ⁅y, ⁅x, p.2.1⁆⁆
      exact lie_lie _ _ _
    · change p.1 • lieAbelianizationProjection 𝕜 L ⁅x, y⁆ =
        (0 : 𝕜) • lieAbelianizationProjection 𝕜 L x -
          (0 : 𝕜) • lieAbelianizationProjection 𝕜 L y
      simp

@[simp]
theorem adjointAbelianizationRepresentation_apply (x : L)
    (p : AdjointAbelianizationModule 𝕜 L) :
    adjointAbelianizationRepresentation 𝕜 L x p =
      (0, ⁅x, p.2.1⁆, p.1 • lieAbelianizationProjection 𝕜 L x) := rfl

/-- The representation misses exactly the central elements lying in the derived
ideal. -/
theorem adjointAbelianizationRepresentation_ker :
    (adjointAbelianizationRepresentation 𝕜 L).ker =
      LieAlgebra.center 𝕜 L ⊓ LieAlgebra.derivedSeries 𝕜 L 1 := by
  ext x
  rw [LieHom.mem_ker, LieSubmodule.mem_inf]
  constructor
  · intro hx
    have hxy (y : L) : ⁅x, y⁆ = 0 := by
      have h := congrArg
        (fun f : Module.End 𝕜 (AdjointAbelianizationModule 𝕜 L) => (f (0, y, 0)).2.1) hx
      simpa only [adjointAbelianizationRepresentation_apply, LinearMap.zero_apply,
        Prod.fst_zero, Prod.snd_zero] using h
    have hq : lieAbelianizationProjection 𝕜 L x = 0 := by
      have h := congrArg
        (fun f : Module.End 𝕜 (AdjointAbelianizationModule 𝕜 L) => (f (1, 0, 0)).2.2) hx
      simpa only [adjointAbelianizationRepresentation_apply, one_smul, LinearMap.zero_apply,
        Prod.snd_zero] using h
    refine ⟨?_, (lieAbelianizationProjection_eq_zero_iff 𝕜 L x).mp hq⟩
    rwa [← LieAlgebra.self_module_ker_eq_center, LieModule.mem_ker]
  · rintro ⟨hc, hd⟩
    have hxy : ∀ y : L, ⁅x, y⁆ = 0 := by
      rwa [← LieAlgebra.self_module_ker_eq_center, LieModule.mem_ker] at hc
    have hq := (lieAbelianizationProjection_eq_zero_iff 𝕜 L x).mpr hd
    apply LinearMap.ext
    intro p
    apply Prod.ext
    · rfl
    apply Prod.ext
    · exact hxy _
    · change p.1 • lieAbelianizationProjection 𝕜 L x = 0
      rw [hq, smul_zero]

/-- The representation is faithful exactly when the center and derived ideal
have zero intersection. -/
theorem adjointAbelianizationRepresentation_injective_iff :
    Function.Injective (adjointAbelianizationRepresentation 𝕜 L) ↔
      LieAlgebra.center 𝕜 L ⊓ LieAlgebra.derivedSeries 𝕜 L 1 = ⊥ := by
  rw [← LieHom.ker_eq_bot, adjointAbelianizationRepresentation_ker]

/-- Trivial intersection of the center with the derived ideal supplies an
explicit faithful representation. -/
theorem adjointAbelianizationRepresentation_injective
    (h : Disjoint (LieAlgebra.center 𝕜 L) (LieAlgebra.derivedSeries 𝕜 L 1)) :
    Function.Injective (adjointAbelianizationRepresentation 𝕜 L) :=
  (adjointAbelianizationRepresentation_injective_iff 𝕜 L).mpr h.eq_bot

/-- The representation module is finite-dimensional when the Lie algebra is. -/
theorem adjointAbelianizationModule_finiteDimensional [FiniteDimensional 𝕜 L] :
    FiniteDimensional 𝕜 (AdjointAbelianizationModule 𝕜 L) := inferInstance

end LieGroups

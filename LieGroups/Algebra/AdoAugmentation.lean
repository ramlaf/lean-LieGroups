import LieGroups.Algebra.AdoQuotient
import LieGroups.Algebra.EnvelopingWords
import Mathlib.Data.Set.Finite.List
import Mathlib.RingTheory.Finiteness.Basic

/-!
# Finite augmentation quotients of an enveloping algebra

The span of words of length at least `n` is preserved by left multiplication
and by every extended Lie derivation. Its quotient is a finite module whenever
the Lie algebra has a finite basis. These quotients need not separate the Lie
generators; that additional assertion requires a nilpotent weight argument.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module

namespace LieGroups

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

attribute [local instance] LieRing.ofAssociativeRing

local notation "U" => UniversalEnvelopingAlgebra R L

/-- The `n`th augmentation tail, described by products of basis generators. -/
def envelopingAugmentationPower (b : Basis ι R L) (n : ℕ) : Submodule R U :=
  Submodule.span R {u | ∃ w : List ι, n ≤ w.length ∧ envelopingWord b w = u}

theorem envelopingWord_mem_augmentationPower (b : Basis ι R L) (w : List ι)
    {n : ℕ} (hn : n ≤ w.length) :
    envelopingWord b w ∈ envelopingAugmentationPower b n :=
  Submodule.subset_span ⟨w, hn, rfl⟩

theorem envelopingAugmentationPower_antitone (b : Basis ι R L) :
    Antitone (envelopingAugmentationPower b) := by
  intro n m hnm
  apply Submodule.span_mono
  rintro u ⟨w, hw, rfl⟩
  exact ⟨w, hnm.trans hw, rfl⟩

@[simp]
theorem envelopingAugmentationPower_zero (b : Basis ι R L) :
    envelopingAugmentationPower b 0 = ⊤ := by
  apply top_unique
  rw [← span_range_envelopingWord b]
  apply Submodule.span_le.mpr
  rintro u ⟨w, rfl⟩
  exact envelopingWord_mem_augmentationPower b w (Nat.zero_le _)

/-- Multiplication adds lower bounds for augmentation degree. -/
theorem mul_mem_envelopingAugmentationPower (b : Basis ι R L) {n m : ℕ}
    {u v : U} (hu : u ∈ envelopingAugmentationPower b n)
    (hv : v ∈ envelopingAugmentationPower b m) :
    u * v ∈ envelopingAugmentationPower b (n + m) := by
  induction hu, hv using Submodule.span_induction₂ with
  | mem_mem u v hu hv =>
      obtain ⟨p, hp, rfl⟩ := hu
      obtain ⟨s, hs, rfl⟩ := hv
      rw [← envelopingWord_append]
      exact envelopingWord_mem_augmentationPower b (p ++ s)
        (by simpa only [List.length_append] using Nat.add_le_add hp hs)
  | zero_left v hv =>
      simpa only [zero_mul] using (envelopingAugmentationPower b (n + m)).zero_mem
  | zero_right u hu =>
      simpa only [mul_zero] using (envelopingAugmentationPower b (n + m)).zero_mem
  | add_left u₁ u₂ v hu₁ hu₂ hv h₁ h₂ =>
      simpa only [add_mul] using (envelopingAugmentationPower b (n + m)).add_mem h₁ h₂
  | add_right u v₁ v₂ hu hv₁ hv₂ h₁ h₂ =>
      simpa only [mul_add] using (envelopingAugmentationPower b (n + m)).add_mem h₁ h₂
  | smul_left r u v hu hv h =>
      simpa only [smul_mul_assoc] using (envelopingAugmentationPower b (n + m)).smul_mem r h
  | smul_right r u v hu hv h =>
      simpa only [mul_smul_comm] using (envelopingAugmentationPower b (n + m)).smul_mem r h

/-- Every canonical Lie generator has augmentation degree at least one. -/
theorem envelopingι_mem_augmentationPower_one (b : Basis ι R L) (x : L) :
    UniversalEnvelopingAlgebra.ι R x ∈ envelopingAugmentationPower b 1 := by
  classical
  rw [envelopingι_eq_sum b x]
  apply Submodule.sum_mem
  intro i _
  exact Submodule.smul_mem _ _ (envelopingWord_mem_augmentationPower b [i] le_rfl)

/-- Each augmentation tail is stable under left multiplication by any element. -/
theorem mul_left_mem_envelopingAugmentationPower (b : Basis ι R L) (n : ℕ)
    (u : U) {v : U} (hv : v ∈ envelopingAugmentationPower b n) :
    u * v ∈ envelopingAugmentationPower b n := by
  have hu : u ∈ envelopingAugmentationPower b 0 := by
    rw [envelopingAugmentationPower_zero]
    exact Submodule.mem_top
  simpa only [zero_add] using mul_mem_envelopingAugmentationPower b hu hv

/-- Each augmentation tail is also stable under right multiplication. -/
theorem mul_right_mem_envelopingAugmentationPower (b : Basis ι R L) (n : ℕ)
    {u : U} (hu : u ∈ envelopingAugmentationPower b n) (v : U) :
    u * v ∈ envelopingAugmentationPower b n := by
  have hv : v ∈ envelopingAugmentationPower b 0 := by
    rw [envelopingAugmentationPower_zero]
    exact Submodule.mem_top
  simpa only [add_zero] using mul_mem_envelopingAugmentationPower b hu hv

/-- Extended derivations do not decrease the length of a generator word. -/
theorem envelopingDerivationLinear_word_mem_augmentationPower (b : Basis ι R L)
    (D : LieDerivation R L L) (w : List ι) :
    envelopingDerivationLinear D (envelopingWord b w) ∈
      envelopingAugmentationPower b w.length := by
  induction w with
  | nil =>
      simp only [envelopingWord_nil, envelopingDerivationLinear_one]
      exact Submodule.zero_mem _
  | cons i w ih =>
      rw [envelopingWord_cons, envelopingDerivationLinear_mul,
        envelopingDerivationLinear_ι]
      apply Submodule.add_mem
      · simpa only [List.length_cons, Nat.add_comm] using
          mul_mem_envelopingAugmentationPower b
            (envelopingι_mem_augmentationPower_one b (b i)) ih
      · simpa only [List.length_cons, Nat.add_comm] using
          mul_mem_envelopingAugmentationPower b
            (envelopingι_mem_augmentationPower_one b (D (b i)))
            (envelopingWord_mem_augmentationPower b w le_rfl)

/-- Every extended Lie derivation preserves every augmentation tail. -/
theorem envelopingDerivationLinear_mem_augmentationPower (b : Basis ι R L)
    (n : ℕ) (D : LieDerivation R L L) {u : U}
    (hu : u ∈ envelopingAugmentationPower b n) :
    envelopingDerivationLinear D u ∈ envelopingAugmentationPower b n := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨w, hw, rfl⟩ := hu
      exact envelopingAugmentationPower_antitone b hw
        (envelopingDerivationLinear_word_mem_augmentationPower b D w)
  | zero => simpa only [map_zero] using (envelopingAugmentationPower b n).zero_mem
  | add u v hu hv ihu ihv =>
      simpa only [map_add] using (envelopingAugmentationPower b n).add_mem ihu ihv
  | smul r u hu ih =>
      simpa only [map_smul] using (envelopingAugmentationPower b n).smul_mem r ih

/-- Words shorter than `n` span the quotient by the `n`th augmentation tail.
Consequently this quotient is finite over the coefficient ring whenever the
given Lie basis is finite. Independence of the words is not needed. -/
instance envelopingAugmentationQuotient_moduleFinite [Finite ι]
    (b : Basis ι R L) (n : ℕ) :
    Module.Finite R (U ⧸ envelopingAugmentationPower b n) := by
  let J := envelopingAugmentationPower b n
  let S : Submodule R U :=
    Submodule.span R {u | ∃ w : List ι, w.length < n ∧ envelopingWord b w = u}
  have hfinite : Set.Finite {u | ∃ w : List ι,
      w.length < n ∧ envelopingWord b w = u} := by
    apply ((List.finite_length_le ι n).image (envelopingWord b)).subset
    rintro u ⟨w, hw, rfl⟩
    exact ⟨w, hw.le, rfl⟩
  have : Module.Finite R S := Module.Finite.span_of_finite R hfinite
  have htop : J ⊔ S = ⊤ := by
    apply top_unique
    rw [← span_range_envelopingWord b]
    apply Submodule.span_le.mpr
    rintro u ⟨w, rfl⟩
    by_cases hw : n ≤ w.length
    · exact (le_sup_left : J ≤ J ⊔ S) (envelopingWord_mem_augmentationPower b w hw)
    · exact (le_sup_right : S ≤ J ⊔ S)
        (Submodule.subset_span ⟨w, Nat.lt_of_not_ge hw, rfl⟩)
  have hsurj : Function.Surjective (J.mkQ.comp S.subtype) := by
    apply LinearMap.range_eq_top.mp
    rw [LinearMap.range_comp, Submodule.range_subtype]
    exact (J.map_mkQ_eq_top S).mpr htop
  exact Module.Finite.of_surjective (J.mkQ.comp S.subtype) hsurj

/-- The actual left multiplication and derivation action on a finite
augmentation quotient. No faithfulness is asserted here. -/
def envelopingAugmentationRepresentation (b : Basis ι R L) (n : ℕ) :
    DerivationSemidirect R L →ₗ⁅R⁆
      Module.End R (U ⧸ envelopingAugmentationPower b n) :=
  envelopingSemidirectQuotientRepresentation R L (envelopingAugmentationPower b n)
    (fun x _ hu => mul_left_mem_envelopingAugmentationPower b n
      (UniversalEnvelopingAlgebra.ι R x) hu)
    (fun D _ hu => envelopingDerivationLinear_mem_augmentationPower b n D hu)

@[simp]
theorem envelopingAugmentationRepresentation_mk (b : Basis ι R L) (n : ℕ)
    (p : DerivationSemidirect R L) (u : U) :
    envelopingAugmentationRepresentation b n p
        ((envelopingAugmentationPower b n).mkQ u) =
      (envelopingAugmentationPower b n).mkQ
        (UniversalEnvelopingAlgebra.ι R p.left * u +
          envelopingDerivationLinear p.right u) := rfl

/-- Separation of Lie generators is precisely the additional condition needed
to obtain a faithful semidirect representation from these finite quotients. -/
theorem envelopingAugmentationRepresentation_injective (b : Basis ι R L) (n : ℕ)
    (hsep : ∀ x : L, UniversalEnvelopingAlgebra.ι R x ∈
      envelopingAugmentationPower b n → x = 0) :
    Function.Injective (envelopingAugmentationRepresentation b n) :=
  envelopingSemidirectQuotientRepresentation_injective R L _ _ _ hsep

end LieGroups

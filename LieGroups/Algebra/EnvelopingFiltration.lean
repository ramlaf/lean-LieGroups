import LieGroups.Algebra.EnvelopingSpanning
import Mathlib.Data.Set.Finite.List
import Mathlib.LinearAlgebra.FiniteDimensional.Defs

/-!
# The finite word-degree filtration of an enveloping algebra

Ordered words of bounded length generate finite modules when the basis index is
finite. The resulting filtration is increasing, contains the unit in degree zero,
is exhaustive, and multiplication adds degree bounds. No independence of ordered
words or finite-dimensional quotient construction is asserted.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module

namespace LieGroups

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [LinearOrder ι]

/-- Increasing the word-degree bound enlarges the filtered submodule. -/
theorem orderedEnvelopingSpan_mono (b : Basis ι R L) : Monotone (orderedEnvelopingSpan b) := by
  intro n m hnm
  apply Submodule.span_mono
  rintro x ⟨w, hw, hn, rfl⟩
  exact ⟨w, hw, hn.trans hnm, rfl⟩

/-- The empty word places the unit in degree zero. -/
theorem one_mem_orderedEnvelopingSpan_zero (b : Basis ι R L) :
    (1 : UniversalEnvelopingAlgebra R L) ∈ orderedEnvelopingSpan b 0 := by
  exact Submodule.subset_span ⟨[], by simp, by simp, envelopingWord_nil b⟩

/-- Degree zero consists of the scalar multiples of the unit. -/
theorem orderedEnvelopingSpan_zero (b : Basis ι R L) :
    orderedEnvelopingSpan b 0 = Submodule.span R {(1 : UniversalEnvelopingAlgebra R L)} := by
  unfold orderedEnvelopingSpan
  apply congrArg (Submodule.span R)
  ext x
  constructor
  · rintro ⟨w, _hw, hn, rfl⟩
    have hw : w = [] := List.length_eq_zero_iff.mp (Nat.le_zero.mp hn)
    simp only [hw, envelopingWord_nil, Set.mem_singleton_iff]
  · rintro rfl
    exact ⟨[], by simp, by simp, envelopingWord_nil b⟩

/-- Multiplication adds word-degree bounds, including for arbitrary linear
combinations of the ordered spanning words. -/
theorem mul_mem_orderedEnvelopingSpan [WellFoundedLT ι] (b : Basis ι R L) {n m : ℕ}
    {x y : UniversalEnvelopingAlgebra R L}
    (hx : x ∈ orderedEnvelopingSpan b n) (hy : y ∈ orderedEnvelopingSpan b m) :
    x * y ∈ orderedEnvelopingSpan b (n + m) := by
  induction hx, hy using Submodule.span_induction₂ with
  | mem_mem x y hx hy =>
      obtain ⟨p, _hp, hn, rfl⟩ := hx
      obtain ⟨s, _hs, hm, rfl⟩ := hy
      rw [← envelopingWord_append]
      apply envelopingWord_mem_orderedEnvelopingSpan
      simpa only [List.length_append] using Nat.add_le_add hn hm
  | zero_left y hy => simpa only [zero_mul] using (orderedEnvelopingSpan b (n + m)).zero_mem
  | zero_right x hx => simpa only [mul_zero] using (orderedEnvelopingSpan b (n + m)).zero_mem
  | add_left x₁ x₂ y hx₁ hx₂ hy h₁ h₂ =>
      simpa only [add_mul] using (orderedEnvelopingSpan b (n + m)).add_mem h₁ h₂
  | add_right x y₁ y₂ hx hy₁ hy₂ h₁ h₂ =>
      simpa only [mul_add] using (orderedEnvelopingSpan b (n + m)).add_mem h₁ h₂
  | smul_left r x y hx hy h =>
      simpa only [smul_mul_assoc] using (orderedEnvelopingSpan b (n + m)).smul_mem r h
  | smul_right r x y hx hy h =>
      simpa only [mul_smul_comm] using (orderedEnvelopingSpan b (n + m)).smul_mem r h

/-- Every enveloping-algebra element has some finite word-degree bound. -/
theorem iSup_orderedEnvelopingSpan [WellFoundedLT ι] (b : Basis ι R L) :
    (⨆ n : ℕ, orderedEnvelopingSpan b n) = ⊤ := by
  apply top_unique
  rw [← span_range_envelopingWord b]
  apply Submodule.span_le.mpr
  rintro x ⟨w, rfl⟩
  exact (le_iSup (orderedEnvelopingSpan b) w.length)
    (envelopingWord_mem_orderedEnvelopingSpan b w w.length le_rfl)

/-- Each element belongs to an individual finite-degree piece of the filtration. -/
theorem exists_mem_orderedEnvelopingSpan [WellFoundedLT ι] (b : Basis ι R L)
    (x : UniversalEnvelopingAlgebra R L) : ∃ n, x ∈ orderedEnvelopingSpan b n := by
  apply (Submodule.mem_iSup_of_directed _ (orderedEnvelopingSpan_mono b).directed_le).mp
  rw [iSup_orderedEnvelopingSpan]
  exact Submodule.mem_top

/-- There are finitely many ordered spanning words at each bounded degree
when the basis index is finite. -/
theorem finite_orderedEnvelopingGenerators [Finite ι] (b : Basis ι R L) (n : ℕ) :
    Set.Finite {x | ∃ w : List ι, w.Pairwise (· ≤ ·) ∧ w.length ≤ n ∧
      envelopingWord b w = x} := by
  apply ((List.finite_length_le ι n).image (envelopingWord b)).subset
  rintro x ⟨w, _hw, hn, rfl⟩
  exact ⟨w, hn, rfl⟩

/-- Every degree-bounded piece is a finite module over the coefficient ring.
In particular, over a field it is finite-dimensional. -/
instance orderedEnvelopingSpan_moduleFinite [Finite ι] (b : Basis ι R L) (n : ℕ) :
    Module.Finite R (orderedEnvelopingSpan b n) :=
  Module.Finite.span_of_finite R (finite_orderedEnvelopingGenerators b n)

end LieGroups

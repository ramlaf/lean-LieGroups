import LieGroups.Algebra.EnvelopingSpanning
import Mathlib.LinearAlgebra.Finsupp.VectorSpace
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas

/-!
# Recovering PBW from an actual linear normal form

A linear map out of the enveloping algebra that fixes ordered words proves their
linear independence. Combined with the established spanning theorem it gives a
basis and injectivity of the canonical Lie map. The normal-form construction and
its descent through the defining relations are proved separately.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] [LinearOrder ι]

/-- The weakly increasing words indexing a PBW basis. -/
def PBWOrderedWord (ι : Type*) [LinearOrder ι] := {w : List ι // w.Pairwise (· ≤ ·)}

/-- A descended linear normal form proves independence of the ordered monomials. -/
theorem orderedEnvelopingWord_linearIndependent_of_normalForm (b : Basis ι R L)
    (N : UniversalEnvelopingAlgebra R L →ₗ[R] (List ι →₀ R))
    (hN : ∀ w : List ι, w.Pairwise (· ≤ ·) → N (envelopingWord b w) = Finsupp.single w 1) :
    LinearIndependent R (fun w : PBWOrderedWord ι => envelopingWord b w.val) := by
  apply LinearIndependent.of_comp N
  have heq : N ∘ (fun w : PBWOrderedWord ι => envelopingWord b w.val) =
      fun w => Finsupp.single w.val (1 : R) := by
    funext w
    exact hN w.val w.property
  rw [heq]
  exact (Finsupp.linearIndependent_single_one (R := R) (ι := List ι)).comp
    (fun w : PBWOrderedWord ι => w.val) Subtype.val_injective

/-- The already proved spanning assertion in the subtype indexing used by PBW. -/
theorem span_range_orderedEnvelopingWord [WellFoundedLT ι] (b : Basis ι R L) :
    Submodule.span R (Set.range (fun w : PBWOrderedWord ι => envelopingWord b w.val)) = ⊤ := by
  have heq : Set.range (fun w : PBWOrderedWord ι => envelopingWord b w.val) =
      {x | ∃ w : List ι, w.Pairwise (· ≤ ·) ∧ envelopingWord b w = x} := by
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨w.val, w.property, rfl⟩
    · rintro ⟨w, hw, rfl⟩
      exact ⟨⟨w, hw⟩, rfl⟩
  rw [heq, span_orderedEnvelopingWord]

/-- A descended normal form and the spanning theorem produce the PBW basis. -/
def pbwBasisOfNormalForm [WellFoundedLT ι] (b : Basis ι R L)
    (N : UniversalEnvelopingAlgebra R L →ₗ[R] (List ι →₀ R))
    (hN : ∀ w : List ι, w.Pairwise (· ≤ ·) → N (envelopingWord b w) = Finsupp.single w 1) :
    Basis (PBWOrderedWord ι) R (UniversalEnvelopingAlgebra R L) :=
  Basis.mk (orderedEnvelopingWord_linearIndependent_of_normalForm b N hN)
    (by rw [span_range_orderedEnvelopingWord])

@[simp]
theorem pbwBasisOfNormalForm_apply [WellFoundedLT ι] (b : Basis ι R L)
    (N : UniversalEnvelopingAlgebra R L →ₗ[R] (List ι →₀ R))
    (hN : ∀ w : List ι, w.Pairwise (· ≤ ·) → N (envelopingWord b w) = Finsupp.single w 1)
    (w : PBWOrderedWord ι) : pbwBasisOfNormalForm b N hN w = envelopingWord b w.val :=
  Basis.mk_apply _ _ _

/-- In particular, a descended linear normal form proves the canonical Lie
homomorphism injective, without assuming faithfulness of any representation. -/
theorem universalEnveloping_ι_injective_of_normalForm (b : Basis ι R L)
    (N : UniversalEnvelopingAlgebra R L →ₗ[R] (List ι →₀ R))
    (hN : ∀ w : List ι, w.Pairwise (· ≤ ·) → N (envelopingWord b w) = Finsupp.single w 1) :
    Function.Injective (UniversalEnvelopingAlgebra.ι R : L → UniversalEnvelopingAlgebra R L) := by
  let singletonWord : ι → PBWOrderedWord ι := fun i => ⟨[i], by simp⟩
  have hi : Function.Injective singletonWord := by
    intro i j hij
    have h := congrArg (fun w : PBWOrderedWord ι => w.val) hij
    simpa only [singletonWord, List.cons.injEq, and_true] using h
  have hli := (orderedEnvelopingWord_linearIndependent_of_normalForm b N hN).comp
    singletonWord hi
  change LinearIndependent R (fun i => envelopingWord b [i]) at hli
  have hli' : LinearIndependent R ((UniversalEnvelopingAlgebra.ι R).toLinearMap ∘ b) := by
    simpa only [Function.comp_def, envelopingWord_singleton, LieHom.coe_toLinearMap] using hli
  exact LinearMap.injective_of_linearIndependent b.span_eq hli'

end LieGroups

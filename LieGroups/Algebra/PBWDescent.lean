import LieGroups.Algebra.PBWTensor
import LieGroups.Algebra.PBWConfluence
import LieGroups.Algebra.LinearContextCongruence

/-!
# Descending the constructed PBW normal form

The actual contextual commutation theorem extends bilinearly from basis letters
and then from tensor words to arbitrary contexts. The resulting linear normal
form descends through the defining congruence to the actual enveloping algebra.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [LinearOrder ι] [WellFoundedLT ι]

private def tensorContext (F : TensorAlgebra R L →ₗ[R] (List ι →₀ R))
    (p q : TensorAlgebra R L) : TensorAlgebra R L →ₗ[R] (List ι →₀ R) :=
  F.comp (((LinearMap.mul R (TensorAlgebra R L)).flip q).comp
    (LinearMap.mul R (TensorAlgebra R L) p))

private def tensorLieRelation : L →ₗ[R] L →ₗ[R] TensorAlgebra R L :=
  (LinearMap.llcomp R L L (TensorAlgebra R L) (TensorAlgebra.ι R)).comp
      (LieAlgebra.ad R L).toLinearMap +
    ((LinearMap.mul R (TensorAlgebra R L)).compl₁₂ (TensorAlgebra.ι R)
      (TensorAlgebra.ι R)).flip -
    (LinearMap.mul R (TensorAlgebra R L)).compl₁₂ (TensorAlgebra.ι R) (TensorAlgebra.ι R)

private theorem tensorLieRelation_apply (x y : L) :
    tensorLieRelation (R := R) x y =
      TensorAlgebra.ι R ⁅x, y⁆ + TensorAlgebra.ι R y * TensorAlgebra.ι R x -
        TensorAlgebra.ι R x * TensorAlgebra.ι R y := rfl

private theorem tensorNormalForm_insert (b : Basis ι R L) (p s : List ι) (x : L) :
    pbwTensorNormalForm b (tensorWord b p * TensorAlgebra.ι R x * tensorWord b s) =
      pbwInsertion b (pbwNormalForm b) p s x := by
  have h : (tensorContext (pbwTensorNormalForm b) (tensorWord b p) (tensorWord b s)).comp
      (TensorAlgebra.ι R) = pbwInsertion b (pbwNormalForm b) p s := by
    apply b.ext
    intro i
    rw [pbwInsertion_basis]
    change pbwTensorNormalForm b
      (tensorWord b p * TensorAlgebra.ι R (b i) * tensorWord b s) = _
    rw [mul_assoc, ← tensorWord_cons, ← tensorWord_append]
    exact pbwTensorNormalForm_word b _
  exact congrArg (fun f : L →ₗ[R] (List ι →₀ R) => f x) h

private theorem tensorNormalForm_relation_words (b : Basis ι R L) (p s : List ι)
    (x y : L) :
    pbwTensorNormalForm b (tensorWord b p * tensorLieRelation (R := R) x y *
      tensorWord b s) = 0 := by
  let F := tensorContext (pbwTensorNormalForm b) (tensorWord b p) (tensorWord b s)
  have h : (LinearMap.llcomp R L (TensorAlgebra R L) (List ι →₀ R) F).comp
      tensorLieRelation = 0 := by
    apply b.ext
    intro i
    apply b.ext
    intro j
    change pbwTensorNormalForm b
      (tensorWord b p * tensorLieRelation (R := R) (b i) (b j) * tensorWord b s) = 0
    rw [tensorLieRelation_apply]
    simp only [mul_sub, sub_mul, mul_add, add_mul, map_sub, map_add]
    rw [tensorNormalForm_insert]
    have hword (a c : ι) : pbwTensorNormalForm b
        (tensorWord b p * (TensorAlgebra.ι R (b a) * TensorAlgebra.ι R (b c)) *
          tensorWord b s) = pbwNormalForm b (p ++ a :: c :: s) := by
      rw [mul_assoc, mul_assoc, ← tensorWord_cons, ← tensorWord_cons, ← tensorWord_append]
      exact pbwTensorNormalForm_word b _
    rw [hword, hword, pbwNormalForm_swap b p s i j]
    abel
  exact congrArg (fun B : L →ₗ[R] L →ₗ[R] (List ι →₀ R) => B x y) h

/-- The tensor normal form annihilates every defining relation in every
arbitrary tensor context. No confluence hypothesis is supplied. -/
theorem pbwTensorNormalForm_relation (b : Basis ι R L) (x y : L)
    (p q : TensorAlgebra R L) :
    pbwTensorNormalForm b
        (p * (TensorAlgebra.ι R ⁅x, y⁆ + TensorAlgebra.ι R y * TensorAlgebra.ι R x) * q) =
      pbwTensorNormalForm b (p * (TensorAlgebra.ι R x * TensorAlgebra.ι R y) * q) := by
  let F := pbwTensorNormalForm b
  let C : TensorAlgebra R L →ₗ[R] TensorAlgebra R L →ₗ[R] (List ι →₀ R) :=
    ((LinearMap.llcomp R (TensorAlgebra R L) (TensorAlgebra R L) (List ι →₀ R) F).comp
      (LinearMap.mul R (TensorAlgebra R L))).compl₁₂
      ((LinearMap.mul R (TensorAlgebra R L)).flip (tensorLieRelation (R := R) x y))
      (LinearMap.id)
  have hC : C = 0 := by
    apply b.tensorAlgebra.ext
    intro u
    apply b.tensorAlgebra.ext
    intro v
    change pbwTensorNormalForm b
      (b.tensorAlgebra u * tensorLieRelation (R := R) x y * b.tensorAlgebra v) = 0
    rw [← FreeMonoid.ofList_toList u, ← FreeMonoid.ofList_toList v,
      ← tensorWord_eq_basis, ← tensorWord_eq_basis]
    exact tensorNormalForm_relation_words b u.toList v.toList x y
  have h := congrArg
    (fun B : TensorAlgebra R L →ₗ[R] TensorAlgebra R L →ₗ[R] (List ι →₀ R) => B p q) hC
  change pbwTensorNormalForm b (p * tensorLieRelation (R := R) x y * q) = 0 at h
  rw [tensorLieRelation_apply] at h
  simpa only [mul_sub, sub_mul, map_sub, sub_eq_zero] using h

/-- The constructed normal form on the actual universal enveloping algebra. -/
def pbwEnvelopingNormalForm (b : Basis ι R L) :
    UniversalEnvelopingAlgebra R L →ₗ[R] (List ι →₀ R) :=
  universalEnvelopingLinearDescend (pbwTensorNormalForm b) (pbwTensorNormalForm_relation b)

@[simp]
theorem pbwEnvelopingNormalForm_word (b : Basis ι R L) (w : List ι) :
    pbwEnvelopingNormalForm b (envelopingWord b w) = pbwNormalForm b w := by
  rw [← mkAlgHom_tensorWord b w]
  exact pbwTensorNormalForm_word b w

/-- The descended normal form fixes every ordered monomial. -/
theorem pbwEnvelopingNormalForm_ordered (b : Basis ι R L) (w : List ι)
    (hw : w.Pairwise (· ≤ ·)) :
    pbwEnvelopingNormalForm b (envelopingWord b w) = Finsupp.single w 1 := by
  rw [pbwEnvelopingNormalForm_word, pbwNormalForm_eq_ordered b hw]

end LieGroups

import LieGroups.Algebra.WordStraightening
import LieGroups.Algebra.PBWNormalForm
import LieGroups.Algebra.WordOverlaps
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.LinearAlgebra.Basis.Basic
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Critical-pair identities for PBW straightening

Linear insertion of Lie-algebra elements into word contexts packages the
lower-degree correction terms. Jacobi then resolves the overlapping triple
correction once lower-degree commutation has been established.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open Module

namespace LieGroups

attribute [local instance] LieRing.ofAssociativeRing

variable {R L ι M : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [AddCommGroup M] [Module R M]

/-- Extend insertion of one basis letter linearly to an arbitrary Lie-algebra
element, retaining a prefix and suffix. -/
def pbwInsertion (b : Basis ι R L) (N : List ι → M) (p s : List ι) : L →ₗ[R] M :=
  (Finsupp.linearCombination R (fun k => N (p ++ k :: s))).comp b.repr.toLinearMap

theorem pbwInsertion_apply (b : Basis ι R L) (N : List ι → M) (p s : List ι) (x : L) :
    pbwInsertion b N p s x =
      ∑ k ∈ (b.repr x).support, b.repr x k • N (p ++ k :: s) := by
  simp only [pbwInsertion, LinearMap.comp_apply, LinearEquiv.coe_toLinearMap,
    Finsupp.linearCombination_apply, Finsupp.sum]

@[simp] theorem pbwInsertion_basis (b : Basis ι R L) (N : List ι → M)
    (p s : List ι) (i : ι) : pbwInsertion b N p s (b i) = N (p ++ i :: s) := by
  classical
  simp [pbwInsertion, Finsupp.linearCombination_apply]

/-- Extend two inserted letters bilinearly, allowing a fixed middle word. -/
def pbwInsertionTwo (b : Basis ι R L) (N : List ι → M) (p m s : List ι) :
    L →ₗ[R] L →ₗ[R] M :=
  (Finsupp.linearCombination R (fun i => pbwInsertion b N (p ++ i :: m) s)).comp
    b.repr.toLinearMap

@[simp] theorem pbwInsertionTwo_basis_left (b : Basis ι R L) (N : List ι → M)
    (p m s : List ι) (i : ι) (y : L) :
    pbwInsertionTwo b N p m s (b i) y = pbwInsertion b N (p ++ i :: m) s y := by
  classical
  simp [pbwInsertionTwo, Finsupp.linearCombination_apply]

@[simp] theorem pbwInsertionTwo_basis_right (b : Basis ι R L) (N : List ι → M)
    (p m s : List ι) (x : L) (j : ι) :
    pbwInsertionTwo b N p m s x (b j) = pbwInsertion b N p (m ++ j :: s) x := by
  have h : (pbwInsertionTwo b N p m s).flip (b j) = pbwInsertion b N p (m ++ j :: s) := by
    apply b.ext
    intro i
    simp [List.append_assoc]
  exact congrArg (fun f : L →ₗ[R] M => f x) h

/-- Basis commutation extends bilinearly to arbitrary elements inserted in the
two positions. This is used only on strictly lower-degree words. -/
theorem pbwInsertionTwo_commutator (b : Basis ι R L) (N : List ι → M) (p s : List ι)
    (h : ∀ i j, N (p ++ i :: j :: s) - N (p ++ j :: i :: s) =
      pbwInsertion b N p s ⁅b i, b j⁆) (x y : L) :
    pbwInsertionTwo b N p [] s x y - pbwInsertionTwo b N p [] s y x =
      pbwInsertion b N p s ⁅x, y⁆ := by
  let B : L →ₗ[R] L →ₗ[R] M :=
    (LinearMap.llcomp R L L M (pbwInsertion b N p s)).comp (LieAlgebra.ad R L).toLinearMap
  have hB : pbwInsertionTwo b N p [] s - (pbwInsertionTwo b N p [] s).flip = B := by
    apply b.ext
    intro i
    apply b.ext
    intro j
    simpa [B, List.append_assoc, LieAlgebra.ad_apply] using h i j
  simpa [B, LieAlgebra.ad_apply] using
    congrArg (fun F : L →ₗ[R] L →ₗ[R] M => F x y) hB

/-- The lower-degree discrepancy between the two reductions of an overlapping
triple is exactly Jacobi, so the correction sums agree. -/
theorem pbw_overlap_corrections (b : Basis ι R L) (N : List ι → M) (p s : List ι)
    (h : ∀ i j, N (p ++ i :: j :: s) - N (p ++ j :: i :: s) =
      pbwInsertion b N p s ⁅b i, b j⁆) (x y z : L) :
    pbwInsertionTwo b N p [] s ⁅y, z⁆ x + pbwInsertionTwo b N p [] s y ⁅x, z⁆ +
        pbwInsertionTwo b N p [] s ⁅x, y⁆ z =
      pbwInsertionTwo b N p [] s x ⁅y, z⁆ + pbwInsertionTwo b N p [] s ⁅x, z⁆ y +
        pbwInsertionTwo b N p [] s z ⁅x, y⁆ := by
  have h₁ := pbwInsertionTwo_commutator b N p s h ⁅y, z⁆ x
  have h₂ := pbwInsertionTwo_commutator b N p s h y ⁅x, z⁆
  have h₃ := pbwInsertionTwo_commutator b N p s h ⁅x, y⁆ z
  have hj : ⁅⁅y, z⁆, x⁆ + ⁅y, ⁅x, z⁆⁆ + ⁅⁅x, y⁆, z⁆ = 0 := by
    rw [← lie_skew ⁅y, z⁆ x, leibniz_lie]
    abel
  apply sub_eq_zero.mp
  calc
    _ = (pbwInsertionTwo b N p [] s ⁅y, z⁆ x - pbwInsertionTwo b N p [] s x ⁅y, z⁆) +
        (pbwInsertionTwo b N p [] s y ⁅x, z⁆ - pbwInsertionTwo b N p [] s ⁅x, z⁆ y) +
        (pbwInsertionTwo b N p [] s ⁅x, y⁆ z - pbwInsertionTwo b N p [] s z ⁅x, y⁆) := by abel
    _ = pbwInsertion b N p s ⁅⁅y, z⁆, x⁆ + pbwInsertion b N p s ⁅y, ⁅x, z⁆⁆ +
        pbwInsertion b N p s ⁅⁅x, y⁆, z⁆ := by rw [h₁, h₂, h₃]
    _ = 0 := by rw [← map_add, ← map_add, hj, map_zero]

/-- Extend a commutation identity to a linearly inserted letter on its left. -/
theorem pbwInsertion_swap_right (b : Basis ι R L) (N : List ι → M)
    (p m s : List ι) (a c : ι)
    (h : ∀ i, N ((p ++ i :: m) ++ a :: c :: s) =
      N ((p ++ i :: m) ++ c :: a :: s) +
        pbwInsertion b N (p ++ i :: m) s ⁅b a, b c⁆) (x : L) :
    pbwInsertion b N p (m ++ a :: c :: s) x =
      pbwInsertion b N p (m ++ c :: a :: s) x +
        pbwInsertionTwo b N p m s x ⁅b a, b c⁆ := by
  have he : pbwInsertion b N p (m ++ a :: c :: s) =
      pbwInsertion b N p (m ++ c :: a :: s) +
        (pbwInsertionTwo b N p m s).flip ⁅b a, b c⁆ := by
    apply b.ext
    intro i
    simpa [List.append_assoc] using h i
  exact congrArg (fun f : L →ₗ[R] M => f x) he

/-- Extend a commutation identity to a linearly inserted letter on its right. -/
theorem pbwInsertion_swap_left (b : Basis ι R L) (N : List ι → M)
    (p m s : List ι) (a c : ι)
    (h : ∀ i, N (p ++ a :: c :: (m ++ i :: s)) =
      N (p ++ c :: a :: (m ++ i :: s)) +
        pbwInsertion b N p (m ++ i :: s) ⁅b a, b c⁆) (y : L) :
    pbwInsertion b N (p ++ a :: c :: m) s y =
      pbwInsertion b N (p ++ c :: a :: m) s y +
        pbwInsertionTwo b N p m s ⁅b a, b c⁆ y := by
  have he : pbwInsertion b N (p ++ a :: c :: m) s =
      pbwInsertion b N (p ++ c :: a :: m) s +
        pbwInsertionTwo b N p m s ⁅b a, b c⁆ := by
    apply b.ext
    intro i
    simpa [List.append_assoc] using h i
  exact congrArg (fun f : L →ₗ[R] M => f y) he

variable [LinearOrder ι]

/-- Commutation for descents gives the antisymmetric commutator identity for
all pairs, including equal and already ordered letters. -/
theorem pbw_commutator_of_descents (b : Basis ι R L) (N : List ι → M) (p s : List ι)
    (h : ∀ i j, j < i → N (p ++ i :: j :: s) =
      N (p ++ j :: i :: s) + pbwInsertion b N p s ⁅b i, b j⁆) (i j : ι) :
    N (p ++ i :: j :: s) - N (p ++ j :: i :: s) = pbwInsertion b N p s ⁅b i, b j⁆ := by
  rcases lt_trichotomy j i with hji | rfl | hij
  · rw [h i j hji]
    abel
  · simp
  · have hh := h j i hij
    rw [← lie_skew (b j) (b i), map_neg] at hh
    rw [hh]
    abel

/-- The local commutation invariant available below a word in shortlex
induction. It is discharged by the normal-form recursion induction hypothesis. -/
def PBWSwapBelow (b : Basis ι R L) (N : List ι → M) (w : List ι) : Prop :=
  ∀ p a c s, c < a → List.Shortlex (· < ·) (p ++ a :: c :: s) w →
    N (p ++ a :: c :: s) = N (p ++ c :: a :: s) + pbwInsertion b N p s ⁅b a, b c⁆

/-- Changing the first differing letter to a smaller one decreases shortlex
when the tails have the same length. -/
theorem pbw_shortlex_change_head (p u v : List ι) {a c : ι} (hca : c < a)
    (hlen : u.length = v.length) :
    List.Shortlex (· < ·) (p ++ c :: u) (p ++ a :: v) := by
  apply List.Shortlex.of_lex
  · simp only [List.length_append, List.length_cons, hlen]
  · exact List.Lex.append_left (· < ·) (List.Lex.rel hca) p

/-- The two branches obtained by reducing a descending triple have the same
value, assuming commutation only for strictly smaller words. -/
theorem pbw_overlap_branch_eq (b : Basis ι R L) (N : List ι → M) (p s : List ι)
    (i j k : ι) (hji : j < i) (hkj : k < j)
    (hbelow : PBWSwapBelow b N (p ++ i :: j :: k :: s)) :
    N (p ++ j :: i :: k :: s) + pbwInsertion b N p (k :: s) ⁅b i, b j⁆ =
      N (p ++ i :: k :: j :: s) + pbwInsertion b N (p ++ [i]) s ⁅b j, b k⁆ := by
  have hki : k < i := hkj.trans hji
  have hs₁ : List.Shortlex (· < ·) ((p ++ [j]) ++ i :: k :: s)
      (p ++ i :: j :: k :: s) := by
    simpa only [List.append_assoc, List.cons_append, List.nil_append] using
      shortlex_swap_descent p (k :: s) hji
  have h₁ := hbelow (p ++ [j]) i k s hki hs₁
  have hs₂ : List.Shortlex (· < ·) (p ++ j :: k :: i :: s)
      (p ++ i :: j :: k :: s) :=
    pbw_shortlex_change_head p (k :: i :: s) (j :: k :: s) hji (by simp)
  have h₂ := hbelow p j k (i :: s) hkj hs₂
  have hs₃ : List.Shortlex (· < ·) (p ++ i :: k :: j :: s)
      (p ++ i :: j :: k :: s) := by
    simpa only [List.append_assoc, List.cons_append, List.nil_append] using
      shortlex_swap_descent (p ++ [i]) s hkj
  have h₃ := hbelow p i k (j :: s) hki hs₃
  have hs₄ : List.Shortlex (· < ·) ((p ++ [k]) ++ i :: j :: s)
      (p ++ i :: j :: k :: s) := by
    simpa only [List.append_assoc, List.cons_append, List.nil_append] using
      pbw_shortlex_change_head p (i :: j :: s) (j :: k :: s) hki (by simp)
  have h₄ := hbelow (p ++ [k]) i j s hji hs₄
  have hpair (a c : ι) : N (p ++ a :: c :: s) - N (p ++ c :: a :: s) =
      pbwInsertion b N p s ⁅b a, b c⁆ := by
    apply pbw_commutator_of_descents b N p s
    intro a c hca
    apply hbelow p a c s hca
    apply List.Shortlex.of_length_lt
    simp only [List.length_append, List.length_cons]
    omega
  have hc := pbw_overlap_corrections b N p s hpair (b i) (b j) (b k)
  have hcor :
      pbwInsertion b N p (i :: s) ⁅b j, b k⁆ +
        pbwInsertion b N (p ++ [j]) s ⁅b i, b k⁆ +
        pbwInsertion b N p (k :: s) ⁅b i, b j⁆ =
      pbwInsertion b N (p ++ [i]) s ⁅b j, b k⁆ +
        pbwInsertion b N p (j :: s) ⁅b i, b k⁆ +
        pbwInsertion b N (p ++ [k]) s ⁅b i, b j⁆ := by
    simpa only [pbwInsertionTwo_basis_left, pbwInsertionTwo_basis_right,
      List.nil_append] using hc
  simp only [List.append_assoc, List.cons_append, List.nil_append] at h₁ h₄
  rw [h₁, h₂, h₃, h₄]
  calc
    _ = N (p ++ k :: j :: i :: s) +
        (pbwInsertion b N p (i :: s) ⁅b j, b k⁆ +
          pbwInsertion b N (p ++ [j]) s ⁅b i, b k⁆ +
          pbwInsertion b N p (k :: s) ⁅b i, b j⁆) := by abel
    _ = N (p ++ k :: j :: i :: s) +
        (pbwInsertion b N (p ++ [i]) s ⁅b j, b k⁆ +
          pbwInsertion b N p (j :: s) ⁅b i, b k⁆ +
          pbwInsertion b N (p ++ [k]) s ⁅b i, b j⁆) := congrArg _ hcor
    _ = _ := by abel

end LieGroups

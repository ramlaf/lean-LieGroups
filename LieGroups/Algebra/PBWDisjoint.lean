import LieGroups.Algebra.PBWCriticalPairs

/-!
# Disjoint adjacent descents in PBW normalization

Under commutation for smaller words, the two possible first reductions of
disjoint adjacent descents have the same value. The common double correction is
the bilinear insertion of the two brackets.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

open Module

namespace LieGroups

variable {R L ι M : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [AddCommGroup M] [Module R M] [LinearOrder ι]

/-- Resolving disjoint descending pairs uses smaller-word commutations and
bilinearity of the common bracket correction. -/
theorem pbw_disjoint_branch_eq (b : Basis ι R L) (N : List ι → M)
    (p m s : List ι) (a c d e : ι) (hca : c < a) (hed : e < d)
    (h : PBWSwapBelow b N (p ++ a :: c :: (m ++ d :: e :: s))) :
    N (p ++ c :: a :: (m ++ d :: e :: s)) +
        pbwInsertion b N p (m ++ d :: e :: s) ⁅b a, b c⁆ =
      N ((p ++ a :: c :: m) ++ e :: d :: s) +
        pbwInsertion b N (p ++ a :: c :: m) s ⁅b d, b e⁆ := by
  have h₁ := h (p ++ c :: a :: m) d e s hed (by
    simpa only [List.append_assoc, List.cons_append] using
      shortlex_swap_descent p (m ++ d :: e :: s) hca)
  have h₂ := h p a c (m ++ e :: d :: s) hca (by
    simpa only [List.append_assoc, List.cons_append] using
      shortlex_swap_descent (p ++ a :: c :: m) s hed)
  have h₃ := pbwInsertion_swap_right b N p m s d e (fun k =>
    h (p ++ k :: m) d e s hed (by
      apply List.Shortlex.of_length_lt
      simp only [List.length_append, List.length_cons]
      omega)) ⁅b a, b c⁆
  have h₄ := pbwInsertion_swap_left b N p m s a c (fun k =>
    h p a c (m ++ k :: s) hca (by
      apply List.Shortlex.of_length_lt
      simp only [List.length_append, List.length_cons]
      omega)) ⁅b d, b e⁆
  simp only [List.append_assoc, List.cons_append] at h₁ h₂ h₃ h₄ ⊢
  rw [h₁, h₂, h₃, h₄]
  abel

end LieGroups

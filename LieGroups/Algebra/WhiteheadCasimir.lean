import Mathlib.Algebra.Lie.TraceForm
import Mathlib.LinearAlgebra.BilinearForm.Properties

/-!
# Casimir contraction of Lie algebra cocycles

The dual-basis cancellation is proved for an actual invariant nondegenerate
form. It supplies the algebraic contraction used in Whitehead's first lemma.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section

namespace LieGroups

open Module

variable {K L : Type*} [Field K] [LieRing L] [LieAlgebra K L]
  {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The canonical dual-basis tensor of an invariant form is invariant. This
version applies any bilinear map to that tensor. -/
theorem sum_bilinear_ad_dualBasis_eq_zero (b : Basis ι K L)
    (B : LinearMap.BilinForm K L) (hB : B.Nondegenerate) (hsym : B.IsSymm)
    (hinv : B.lieInvariant L) {N : Type*} [AddCommGroup N] [Module K N]
    (F : L →ₗ[K] L →ₗ[K] N) (x : L) :
    (∑ i, F ⁅x, b i⁆ (B.dualBasis hB b i)) +
      (∑ i, F (b i) ⁅x, B.dualBasis hB b i⁆) = 0 := by
  let d := B.dualBasis hB b
  have hrepr (y : L) (i : ι) : b.repr y i = B y (d i) := by
    simpa only [d, LinearMap.BilinForm.dualBasis_dualBasis hB hsym]
      using (LinearMap.BilinForm.dualBasis_repr_apply hB d y i)
  have hcoeff (i j : ι) : b.repr ⁅x, b i⁆ j = -d.repr ⁅x, d j⁆ i := by
    rw [hrepr, LinearMap.BilinForm.dualBasis_repr_apply, hinv, hsym.eq (b i)]
  have hleft (i : ι) : F ⁅x, b i⁆ (d i) =
      ∑ j, b.repr ⁅x, b i⁆ j • F (b j) (d i) := by
    conv_lhs => rw [← b.sum_repr ⁅x, b i⁆]
    simp only [map_sum, map_smul, LinearMap.sum_apply, LinearMap.smul_apply]
  have hright (i : ι) : F (b i) ⁅x, d i⁆ =
      ∑ j, d.repr ⁅x, d i⁆ j • F (b i) (d j) := by
    conv_lhs => rw [← d.sum_repr ⁅x, d i⁆]
    simp only [map_sum, map_smul]
  change (∑ i, F ⁅x, b i⁆ (d i)) + (∑ i, F (b i) ⁅x, d i⁆) = 0
  simp_rw [hleft, hright]
  rw [Finset.sum_comm (f := fun i j => b.repr ⁅x, b i⁆ j • F (b j) (d i)),
    ← Finset.sum_add_distrib]
  apply Finset.sum_eq_zero
  intro i _
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_eq_zero
  intro j _
  rw [hcoeff, neg_smul, neg_add_cancel]

end LieGroups

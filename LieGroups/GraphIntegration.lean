import LieGroups.LieHomomorphismGraph

/-!
# Connected immersed integrations of graphs

The two projections of an immersed graph integration are smooth homomorphisms.
The first has bijective identity differential, while the second differential is
obtained by composing the first with the prescribed Lie homomorphism.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open scoped Topology ContDiff Manifold

namespace LieGroups
set_option backward.isDefEq.respectTransparency false

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {HE : Type*} [TopologicalSpace HE] {I : ModelWithCorners ℝ E HE}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace HE G] [LieGroup I ∞ G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {HF : Type*} [TopologicalSpace HF] {J : ModelWithCorners ℝ F HF}
  {H : Type*} [Group H] [TopologicalSpace H] [ChartedSpace HF H] [LieGroup J ∞ H]

/-- A connected immersed integration of the graph of a Lie algebra homomorphism. -/
abbrev LieHomomorphismGraphIntegration
    (φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J H) :=
  LieSubalgebraIntegration (lieHomomorphismGraph φ)

namespace LieHomomorphismGraphIntegration

variable {φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J H}
  (A : LieHomomorphismGraphIntegration φ)

/-- Projection of the integrated graph to the source group. -/
def sourceHom : A.Carrier →* G :=
  (MonoidHom.fst G H).comp A.presentation.toMonoidHom

/-- Projection of the integrated graph to the target group. -/
def targetHom : A.Carrier →* H :=
  (MonoidHom.snd G H).comp A.presentation.toMonoidHom

/-- The first graph projection is smooth. -/
theorem contMDiff_sourceHom :
    ContMDiff 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)) I ∞ A.sourceHom :=
  contMDiff_fst.comp A.presentation.contMDiff

/-- The second graph projection is smooth. -/
theorem contMDiff_targetHom :
    ContMDiff 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)) J ∞ A.targetHom :=
  contMDiff_snd.comp A.presentation.contMDiff

private theorem sourceDifferential_apply
    (v : GroupLieAlgebra 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)) A.Carrier) :
    homLieDifferential (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
      (J := I) A.sourceHom v =
      (homLieDifferential
        (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
      (J := I.prod J) A.presentation.toMonoidHom v).1 := by
  rw [sourceHom, homLieDifferential_comp A.presentation.toMonoidHom
    (MonoidHom.fst G H) A.presentation.contMDiff contMDiff_fst]
  simp only [ContinuousLinearMap.comp_apply, homLieDifferential, MonoidHom.coe_fst,
    mfderiv_fst]
  rfl

private theorem targetDifferential_apply
    (v : GroupLieAlgebra 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)) A.Carrier) :
    homLieDifferential (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
      (J := J) A.targetHom v =
      (homLieDifferential
        (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
      (J := I.prod J) A.presentation.toMonoidHom v).2 := by
  rw [targetHom, homLieDifferential_comp A.presentation.toMonoidHom
    (MonoidHom.snd G H) A.presentation.contMDiff contMDiff_snd]
  simp only [ContinuousLinearMap.comp_apply, homLieDifferential, MonoidHom.coe_snd,
    mfderiv_snd]
  rfl

/-- The identity differentials of the two projections satisfy the prescribed graph relation. -/
theorem differential_relation
    (v : GroupLieAlgebra 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)) A.Carrier) :
    homLieDifferential (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
      (J := J) A.targetHom v =
      φ (homLieDifferential (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
        (J := I) A.sourceHom v) := by
  have hv : homLieDifferential (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
      (J := I.prod J) A.presentation.toMonoidHom v ∈ A.presentation.lieAlgebra :=
    ⟨v, rfl⟩
  rw [A.lieAlgebra_eq, mem_lieHomomorphismGraph] at hv
  change (homLieDifferential (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
      (J := I.prod J) A.presentation.toMonoidHom v).2 =
    φ (homLieDifferential (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
      (J := I.prod J) A.presentation.toMonoidHom v).1 at hv
  rw [A.sourceDifferential_apply, A.targetDifferential_apply]
  exact hv

/-- The first graph projection has bijective identity differential. -/
theorem sourceDifferential_bijective :
    Function.Bijective (homLieDifferential
      (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ))) (J := I) A.sourceHom) := by
  constructor
  · intro v w hvw
    apply A.presentation.homLieDifferential_injective
    apply Prod.ext
    · exact (A.sourceDifferential_apply v).symm.trans (hvw.trans (A.sourceDifferential_apply w))
    · have h := congrArg φ hvw
      rw [← A.differential_relation v, ← A.differential_relation w,
        A.targetDifferential_apply, A.targetDifferential_apply] at h
      exact h
  · intro v
    have hv : (v, φ v) ∈ A.presentation.lieAlgebra := by
      rw [A.lieAlgebra_eq, mem_lieHomomorphismGraph]
    obtain ⟨w, hw⟩ := hv
    refine ⟨w, ?_⟩
    rw [A.sourceDifferential_apply]
    change homLieDifferential
      (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)))
      (J := I.prod J) A.presentation.toMonoidHom w = (v, φ v) at hw
    exact congrArg (fun z : GroupLieAlgebra (I.prod J) (G × H) => z.1) hw

/-- The first graph projection is surjective onto a connected source group. -/
theorem sourceHom_surjective [BoundarylessManifold I G] [T2Space G] [ConnectedSpace G] :
    Function.Surjective A.sourceHom := by
  have hr : A.sourceHom.range = ⊤ := by
    apply subgroup_eq_top_of_lieExp_mem (I := I)
    intro v
    obtain ⟨w, hw⟩ := A.sourceDifferential_bijective.surjective v
    exact ⟨lieExp w, (lieExp_map A.sourceHom A.contMDiff_sourceHom w).trans (congrArg lieExp hw)⟩
  intro g
  have hg : g ∈ A.sourceHom.range := by rw [hr]; trivial
  exact hg

end LieHomomorphismGraphIntegration

/-- Every Lie algebra homomorphism has a connected immersed graph integration. -/
theorem nonempty_lieHomomorphismGraphIntegration [I.Boundaryless] [J.Boundaryless]
    [T2Space G] [T2Space H]
    (φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J H) :
    Nonempty (LieHomomorphismGraphIntegration φ) :=
  nonempty_lieSubalgebraIntegration (lieHomomorphismGraph φ)

end LieGroups

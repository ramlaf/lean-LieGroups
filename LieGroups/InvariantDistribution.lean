import LieGroups.OneParameterSubgroup
import Mathlib.Algebra.Lie.Subalgebra
import Mathlib.Geometry.Manifold.LocalDiffeomorph
import Mathlib.LinearAlgebra.Basis.Basic
import Mathlib.LinearAlgebra.Dimension.Finrank

/-!
# The left-invariant tangent distribution of a Lie subalgebra

Left translation identifies each fiber with the prescribed Lie subalgebra. In particular,
the fibers have constant dimension and a basis gives pointwise bases of smooth invariant fields.
Brackets of invariant sections and of their smooth scalar multiples lie in the distribution.
`InvariantDistributionInvolutive.lean` proves smooth coefficient extraction and local involutivity
for arbitrary distribution-valued fields. Integral-leaf existence is a separate construction.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Set Module
open scoped ContDiff Manifold

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

/-- The differential of left translation identifies the Lie algebra with the tangent space
at the translating element. The target base point is `g * 1 = g`. -/
noncomputable def leftTranslationTangentEquiv (g : G) :
    GroupLieAlgebra I G ≃L[ℝ] TangentSpace I g := by
  let L : Diffeomorph I I G G ∞ := {
    toEquiv := Equiv.mulLeft g
    contMDiff_toFun := contMDiff_mul_left
    contMDiff_invFun := contMDiff_mul_left
  }
  exact L.mfderivToContinuousLinearEquiv (by simp) 1

omit [CompleteSpace E] in
/-- The left-translation identification evaluates an invariant vector field. -/
@[simp] theorem leftTranslationTangentEquiv_apply (g : G) (v : GroupLieAlgebra I G) :
    leftTranslationTangentEquiv (I := I) g v = mulInvariantVectorField v g := rfl

/-- The tangent subspace obtained by translating a Lie subalgebra to a group point. -/
noncomputable def invariantDistribution (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (g : G) :
    Submodule ℝ (TangentSpace I g) :=
  S.toSubmodule.map (leftTranslationTangentEquiv (I := I) g).toLinearMap

/-- Membership in a translated fiber is exactly being the value of an invariant field
whose identity value belongs to the Lie subalgebra. -/
theorem mem_invariantDistribution_iff (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (g : G) (w : TangentSpace I g) :
    w ∈ invariantDistribution S g ↔
      ∃ v : GroupLieAlgebra I G, v ∈ S ∧ mulInvariantVectorField v g = w := Iff.rfl

/-- The invariant field of a Lie-subalgebra vector is a section of the distribution. -/
theorem mulInvariantVectorField_mem_invariantDistribution
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) {v : GroupLieAlgebra I G} (hv : v ∈ S)
    (g : G) : mulInvariantVectorField v g ∈ invariantDistribution S g :=
  (mem_invariantDistribution_iff S g _).2 ⟨v, hv, rfl⟩

/-- At the identity, the translated subspace is the original Lie subalgebra. -/
@[simp] theorem invariantDistribution_one (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    invariantDistribution S (1 : G) = S.toSubmodule := by
  ext v
  simp only [mem_invariantDistribution_iff, mulInvariantVectorField_one, exists_eq_right]
  rfl

/-- Left translation gives a canonical linear identification of the subalgebra with every
fiber of its invariant distribution. -/
noncomputable def invariantDistributionEquiv (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (g : G) : S ≃ₗ[ℝ] invariantDistribution S g :=
  (leftTranslationTangentEquiv (I := I) g).toLinearEquiv.submoduleMap S.toSubmodule

@[simp] theorem invariantDistributionEquiv_apply
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (g : G) (v : S) :
    (invariantDistributionEquiv S g v : TangentSpace I g) =
      mulInvariantVectorField (v : GroupLieAlgebra I G) g := rfl

/-- All fibers have the same `finrank` as the Lie subalgebra. -/
theorem finrank_invariantDistribution (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (g : G) :
    Module.finrank ℝ (invariantDistribution S g) = Module.finrank ℝ S :=
  (invariantDistributionEquiv S g).finrank_eq.symm

/-- On a finite-dimensional group, each translated fiber is finite-dimensional. -/
theorem finiteDimensional_invariantDistribution [FiniteDimensional ℝ E]
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (g : G) :
    FiniteDimensional ℝ (invariantDistribution S g) := by
  let L := (leftTranslationTangentEquiv (I := I) g).symm.trans
    (lieAlgebraModelEquiv (I := I) (G := G))
  exact FiniteDimensional.of_injective
    (L.toLinearMap.comp (invariantDistribution S g).subtype)
    (L.injective.comp Subtype.val_injective)

/-- In finite dimensions, the common fiber dimension is bounded by the ambient model dimension. -/
theorem finrank_invariantDistribution_le [FiniteDimensional ℝ E]
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (g : G) :
    Module.finrank ℝ (invariantDistribution S g) ≤ Module.finrank ℝ E := by
  let : FiniteDimensional ℝ (GroupLieAlgebra I G) :=
    FiniteDimensional.of_injective (lieAlgebraModelEquiv (I := I) (G := G)).toLinearMap
      (lieAlgebraModelEquiv (I := I) (G := G)).injective
  rw [finrank_invariantDistribution]
  calc
    Module.finrank ℝ S ≤ Module.finrank ℝ (GroupLieAlgebra I G) := S.toSubmodule.finrank_le
    _ = Module.finrank ℝ E := (lieAlgebraModelEquiv (I := I) (G := G)).toLinearEquiv.finrank_eq

/-- A basis of the subalgebra gives a basis in every translated fiber. -/
noncomputable def invariantDistributionBasis {ι : Type*}
    {S : LieSubalgebra ℝ (GroupLieAlgebra I G)} (b : Basis ι ℝ S) (g : G) :
    Basis ι ℝ (invariantDistribution S g) := b.map (invariantDistributionEquiv S g)

@[simp] theorem invariantDistributionBasis_apply {ι : Type*}
    {S : LieSubalgebra ℝ (GroupLieAlgebra I G)} (b : Basis ι ℝ S) (g : G) (i : ι) :
    (invariantDistributionBasis b g i : TangentSpace I g) =
      mulInvariantVectorField (b i : GroupLieAlgebra I G) g := rfl

/-- Each section in the invariant frame is smooth. -/
theorem contMDiff_invariantDistributionBasis {ι : Type*}
    {S : LieSubalgebra ℝ (GroupLieAlgebra I G)} (b : Basis ι ℝ S) (i : ι) :
    ContMDiff I I.tangent ∞ (fun g : G =>
      (⟨g, (invariantDistributionBasis b g i : TangentSpace I g)⟩ : TangentBundle I G)) :=
  contMDiff_infty_mulInvariantVectorField (b i : GroupLieAlgebra I G)

/-- Differentiating left translation transports each fiber onto the corresponding fiber. -/
theorem invariantDistribution_map_mul_left
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (g h : G) :
    (invariantDistribution S h).map (mfderiv I I (g * ·) h).toLinearMap =
      invariantDistribution S (g * h) := by
  ext w
  constructor
  · rintro ⟨z, hz, rfl⟩
    obtain ⟨v, hv, rfl⟩ := (mem_invariantDistribution_iff S h z).1 hz
    change mfderiv I I (g * ·) h (mulInvariantVectorField v h) ∈ _
    rw [mfderiv_mul_left_mulInvariantVectorField]
    exact mulInvariantVectorField_mem_invariantDistribution S hv _
  · intro hw
    obtain ⟨v, hv, rfl⟩ := (mem_invariantDistribution_iff S (g * h) w).1 hw
    exact ⟨mulInvariantVectorField v h,
      mulInvariantVectorField_mem_invariantDistribution S hv h,
      mfderiv_mul_left_mulInvariantVectorField g h v⟩

/-- The bracket of invariant sections with values in the subalgebra stays in the distribution.
This is bracket closure of the invariant frame; integral-leaf existence is a separate theorem. -/
theorem mlieBracket_invariant_mem_invariantDistribution
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) {v w : GroupLieAlgebra I G}
    (hv : v ∈ S) (hw : w ∈ S) (g : G) :
    VectorField.mlieBracket I (mulInvariantVectorField v) (mulInvariantVectorField w) g ∈
      invariantDistribution S g := by
  rw [← mulInvariantVector_mlieBracket, ← GroupLieAlgebra.bracket_def]
  exact mulInvariantVectorField_mem_invariantDistribution S (S.lie_mem hv hw) g

/-- Smooth scalar multiples of invariant sections also have bracket in the distribution,
by the two Leibniz rules. Only differentiability of the coefficients at the point is needed. -/
theorem mlieBracket_smul_invariant_mem_invariantDistribution
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) {v w : GroupLieAlgebra I G}
    (hv : v ∈ S) (hw : w ∈ S) {a b : G → ℝ} {g : G}
    (ha : MDifferentiableAt I 𝓘(ℝ, ℝ) a g)
    (hb : MDifferentiableAt I 𝓘(ℝ, ℝ) b g) :
    VectorField.mlieBracket I (a • mulInvariantVectorField v)
      (b • mulInvariantVectorField w) g ∈ invariantDistribution S g := by
  rw [VectorField.mlieBracket_smul_left ha
    ((contMDiff_infty_mulInvariantVectorField v).mdifferentiableAt (by simp)),
    VectorField.mlieBracket_smul_right hb
      ((contMDiff_infty_mulInvariantVectorField w).mdifferentiableAt (by simp))]
  exact (invariantDistribution S g).add_mem
    ((invariantDistribution S g).smul_mem _
      (mulInvariantVectorField_mem_invariantDistribution S hv g))
    ((invariantDistribution S g).smul_mem _ ((invariantDistribution S g).add_mem
      ((invariantDistribution S g).smul_mem _
        (mulInvariantVectorField_mem_invariantDistribution S hw g))
      ((invariantDistribution S g).smul_mem _
        (mlieBracket_invariant_mem_invariantDistribution S hv hw g))))

end LieGroups

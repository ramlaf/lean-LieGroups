import LieGroups.GraphIntegration

/-!
# Local diffeomorphisms from invertible homomorphism differentials

Naturality of the exponential expresses a smooth homomorphism in exponential
coordinates as its identity differential. Invertibility gives a local inverse;
translation supplies one at every point.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open Set
open scoped Topology ContDiff Manifold

namespace LieGroups
set_option backward.isDefEq.respectTransparency false

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {HE : Type*} [TopologicalSpace HE] {I : ModelWithCorners ℝ E HE}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace HE G] [LieGroup I ∞ G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {HF : Type*} [TopologicalSpace HF] {J : ModelWithCorners ℝ F HF}
  {H : Type*} [Group H] [TopologicalSpace H] [ChartedSpace HF H] [LieGroup J ∞ H]
  [BoundarylessManifold I G] [BoundarylessManifold J H] [T2Space G] [T2Space H]

/-- A smooth homomorphism with bijective identity differential is a local
smooth diffeomorphism at the identity. -/
theorem isLocalDiffeomorphAt_one_hom_of_bijective_differential
    (f : G →* H) (hf : ContMDiff I J ∞ f)
    (hdf : Function.Bijective (homLieDifferential (I := I) (J := J) f)) :
    IsLocalDiffeomorphAt I J ∞ f (1 : G) := by
  let eG := lieAlgebraModelEquiv (I := I) (G := G)
  let eH := lieAlgebraModelEquiv (I := J) (G := H)
  let A : E →L[ℝ] F := eH.toContinuousLinearMap.comp
    ((homLieDifferential (I := I) (J := J) f).comp eG.symm.toContinuousLinearMap)
  have hA : Function.Bijective A := eH.bijective.comp (hdf.comp eG.symm.bijective)
  let L : E ≃L[ℝ] F := (LinearEquiv.ofBijective A.toLinearMap hA).toContinuousLinearEquiv
  let X : E → H := fun v => f (lieExp (eG.symm v))
  have hX : ContMDiff 𝓘(ℝ, E) J ∞ X := hf.comp lieExp_contMDiff_model
  have hX0 : X 0 = 1 := by simp [X]
  have hXEq : X = fun v => lieExp (eH.symm (A v)) := by
    funext v
    change f (lieExp (eG.symm v)) = _
    rw [lieExp_map f hf]
    congr 1
    exact (eH.symm_apply_apply _).symm
  have hd : fderiv ℝ (fun v => extChartAt J (X 0) (X v)) 0 = L := by
    rw [hX0, hXEq]
    exact Manifold.lieExp_model_comp_fderiv_zero A
  obtain ⟨Ψ, hΨ0, hΨeq⟩ := Manifold.exists_partialDiffeomorph_of_chart_fderiv hX L hd
  obtain ⟨Φ, hΦ0, hΦ1, hΦeq⟩ := exists_lieExp_localDiffeomorph_model (I := I) (G := G)
  have h1 : (1 : G) ∈ Φ.target := hΦ1 ▸ Φ.map_source hΦ0
  have hi1 : Φ.symm (1 : G) = 0 := by
    rw [← hΦ1]
    exact Φ.left_inv hΦ0
  let Ω := Φ.symm.trans Ψ
  refine ⟨Ω, ⟨h1, ?_⟩, ?_⟩
  · change Φ.symm (1 : G) ∈ Ψ.source
    rwa [hi1]
  intro g hg
  have hv : Φ.symm g ∈ Φ.source := Φ.map_target hg.1
  change f g = Ψ (Φ.symm g)
  have he : X (Φ.symm g) = Ψ (Φ.symm g) := hΨeq hg.2
  rw [← he]
  change f g = f (lieExp (eG.symm (Φ.symm g)))
  congr 1
  exact ((hΦeq hv).trans (Φ.right_inv hg.1)).symm

/-- A smooth homomorphism with bijective identity differential is a local smooth
diffeomorphism everywhere. -/
theorem isLocalDiffeomorph_hom_of_bijective_differential
    (f : G →* H) (hf : ContMDiff I J ∞ f)
    (hdf : Function.Bijective (homLieDifferential (I := I) (J := J) f)) :
    IsLocalDiffeomorph I J ∞ f := by
  obtain ⟨Ω, hΩ1, hΩeq⟩ := isLocalDiffeomorphAt_one_hom_of_bijective_differential f hf hdf
  intro a
  let DL : Diffeomorph I I G G ∞ := {
    toEquiv := Equiv.mulLeft a⁻¹
    contMDiff_toFun := contMDiff_mul_left
    contMDiff_invFun := contMDiff_mul_left
  }
  let DR : Diffeomorph J J H H ∞ := {
    toEquiv := Equiv.mulLeft (f a)
    contMDiff_toFun := contMDiff_mul_left
    contMDiff_invFun := contMDiff_mul_left
  }
  let Ωa := (DL.toPartialDiffeomorph.trans Ω).trans DR.toPartialDiffeomorph
  refine ⟨Ωa, ⟨⟨mem_univ _, ?_⟩, mem_univ _⟩, ?_⟩
  · change a⁻¹ * a ∈ Ω.source
    simpa only [inv_mul_cancel] using hΩ1
  intro g hg
  change f g = f a * Ω (a⁻¹ * g)
  have he : f (a⁻¹ * g) = Ω (a⁻¹ * g) := hΩeq hg.1.2
  rw [← he, map_mul, map_inv, mul_inv_cancel_left]

namespace LieHomomorphismGraphIntegration

variable {φ : GroupLieAlgebra I G →ₗ⁅ℝ⁆ GroupLieAlgebra J H}

omit [BoundarylessManifold J H] [T2Space H] in
/-- The first projection of a graph integration is a local diffeomorphism. -/
theorem isLocalDiffeomorph_sourceHom (A : LieHomomorphismGraphIntegration φ) :
    IsLocalDiffeomorph 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ)) I ∞
      A.sourceHom :=
  isLocalDiffeomorph_hom_of_bijective_differential
    (I := 𝓘(ℝ, lieSubalgebraModelSubmodule (lieHomomorphismGraph φ))) (J := I) A.sourceHom
    A.contMDiff_sourceHom A.sourceDifferential_bijective

end LieHomomorphismGraphIntegration
end LieGroups

import LieGroups.ClosedSubgroupSlice
import LieGroups.ClosedSubgroupAtlas
import LieGroups.EmbeddedSubgroupTangent

/-!
# The closed-subgroup theorem

An ordinary closed subgroup receives a smooth slice constructed from its ambient
curve tangent space. The slice supplies its embedded Lie-group structure with
the original subspace topology.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open scoped ContDiff Manifold

noncomputable section

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] (I : ModelWithCorners ℝ E H)
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

/-- A closed subgroup with a constructed ambient slice. The horizontal model is
the actual space of ambient curve velocities, in fixed model coordinates. -/
structure ClosedLieSubgroup (K : Subgroup G) where
  isClosed : IsClosed (K : Set G)
  transverse : Submodule ℝ E
  slice : ClosedSubgroupChart I K (subgroupTangentModel (I := I) K) transverse

variable {I}

/-- Closedness alone constructs the local data for an embedded Lie subgroup. -/
theorem nonempty_closedLieSubgroup [FiniteDimensional ℝ E]
    [BoundarylessManifold I G] [T2Space G]
    (K : Subgroup G) (hK : IsClosed (K : Set G)) :
    Nonempty (ClosedLieSubgroup I K) := by
  obtain ⟨Q, ⟨C⟩⟩ := exists_closedSubgroupChart (I := I) K hK
  exact ⟨{ isClosed := hK, transverse := Q, slice := C }⟩

namespace ClosedLieSubgroup

variable {K : Subgroup G} (C : ClosedLieSubgroup I K)

/-- The original subgroup subtype, with the smooth atlas constructed from its
slice and with its original subspace topology. -/
abbrev Carrier := C.slice.Space

/-- Inclusion of the constructed subgroup into the ambient group. -/
abbrev inclusion : C.Carrier →* G := C.slice.inclusion

/-- The constructed subgroup inclusion is smooth. -/
theorem contMDiff_inclusion :
    ContMDiff 𝓘(ℝ, subgroupTangentModel (I := I) K) I ∞ C.inclusion :=
  C.slice.contMDiff_inclusion

/-- The inclusion retains precisely the ambient subspace topology. -/
theorem isEmbedding_inclusion : Topology.IsEmbedding C.inclusion :=
  C.slice.isEmbedding_inclusion

/-- The closed subgroup with its constructed manifold is an embedded Lie subgroup. -/
def presentation [I.Boundaryless] :
    EmbeddedLieSubgroup I G 𝓘(ℝ, subgroupTangentModel (I := I) K) C.Carrier :=
  C.slice.embeddedLieSubgroup

/-- The constructed inclusion has exactly the original subgroup as its image. -/
theorem presentation_subgroup [I.Boundaryless] :
    C.presentation.toImmersedLieSubgroup.subgroup = K := by
  ext g
  change (∃ x : C.Carrier, C.inclusion x = g) ↔ g ∈ K
  constructor
  · rintro ⟨x, rfl⟩
    exact x.property
  · intro hg
    exact ⟨⟨g, hg⟩, rfl⟩

variable [FiniteDimensional ℝ E] [I.Boundaryless] [T2Space G]

/-- Ambient velocities in a closed subgroup form its actual tangent Lie algebra. -/
theorem subgroupTangentSet_eq_lieAlgebra :
    subgroupTangentSet (I := I) K =
      (C.presentation.toImmersedLieSubgroup.lieAlgebra : Set (GroupLieAlgebra I G)) := by
  calc
    _ = subgroupTangentSet (I := I) C.presentation.toImmersedLieSubgroup.subgroup :=
      congrArg (subgroupTangentSet (I := I)) C.presentation_subgroup.symm
    _ = _ := C.presentation.subgroupTangentSet_eq_lieAlgebra

/-- The differential image of the constructed embedded inclusion is exactly
the submodule of ambient curve velocities. -/
theorem presentation_lieAlgebra_toSubmodule :
    C.presentation.toImmersedLieSubgroup.lieAlgebra.toSubmodule =
      subgroupTangentSubmodule (I := I) K := by
  ext v
  change v ∈ (C.presentation.toImmersedLieSubgroup.lieAlgebra : Set (GroupLieAlgebra I G)) ↔
    v ∈ subgroupTangentSet (I := I) K
  rw [C.subgroupTangentSet_eq_lieAlgebra]

/-- The Lie algebra of the constructed subgroup has the specified coordinate model. -/
theorem presentation_lieAlgebra_model :
    C.presentation.toImmersedLieSubgroup.lieAlgebra.toSubmodule.map
      (lieAlgebraModelEquiv (I := I) (G := G)).toLinearMap =
        subgroupTangentModel (I := I) K := by
  rw [C.presentation_lieAlgebra_toSubmodule]
  rfl

/-- The closed subgroup's ambient tangent Lie algebra, obtained from its actual
embedded inclusion. -/
noncomputable def lieAlgebra : LieSubalgebra ℝ (GroupLieAlgebra I G) :=
  C.presentation.toImmersedLieSubgroup.lieAlgebra

/-- The constructed tangent Lie algebra has the intrinsic ambient-curve characterization. -/
theorem mem_lieAlgebra (v : GroupLieAlgebra I G) :
    v ∈ C.lieAlgebra ↔ v ∈ subgroupTangentSet (I := I) K := by
  change v ∈ (C.presentation.toImmersedLieSubgroup.lieAlgebra : Set (GroupLieAlgebra I G)) ↔ _
  rw [C.subgroupTangentSet_eq_lieAlgebra]

/-- The tangent Lie algebra of a closed subgroup consists exactly of those
velocities whose full one-parameter subgroups stay in the subgroup. -/
theorem mem_lieAlgebra_iff_lieExp (v : GroupLieAlgebra I G) :
    v ∈ C.lieAlgebra ↔ ∀ t : ℝ, lieExp (t • v) ∈ K := by
  rw [C.mem_lieAlgebra]
  constructor
  · intro hv t
    exact lieExp_smul_mem_of_mem_subgroupTangentSet K C.isClosed hv t
  · intro hv
    apply mem_subgroupTangentSet_of_oneParameterCurve K v
    intro t
    simpa only [lieExp_smul] using hv t

/-- The tangent Lie algebra does not depend on the choices of slices or complements. -/
theorem lieAlgebra_eq (D : ClosedLieSubgroup I K) : C.lieAlgebra = D.lieAlgebra := by
  ext v
  rw [C.mem_lieAlgebra, D.mem_lieAlgebra]

end ClosedLieSubgroup

/-- Every ordinary closed subgroup has an embedded Lie-group presentation on
its original subtype topology and with exactly its ambient curve tangent space. -/
theorem exists_closedLieSubgroup_presentation [FiniteDimensional ℝ E]
    [I.Boundaryless] [T2Space G] (K : Subgroup G) (hK : IsClosed (K : Set G)) :
    ∃ C : ClosedLieSubgroup I K,
      C.presentation.toImmersedLieSubgroup.subgroup = K ∧
      C.presentation.toImmersedLieSubgroup.lieAlgebra.toSubmodule =
        subgroupTangentSubmodule (I := I) K := by
  obtain ⟨C⟩ := nonempty_closedLieSubgroup (I := I) K hK
  exact ⟨C, C.presentation_subgroup, C.presentation_lieAlgebra_toSubmodule⟩

end LieGroups

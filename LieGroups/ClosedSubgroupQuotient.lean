import LieGroups.ClosedLieSubgroup
import LieGroups.QuotientBundle
import LieGroups.QuotientKernel

/-!
# Homogeneous quotients of ordinary closed subgroups

The closed-subgroup theorem constructs the embedded subgroup, and its transverse
slice constructs the smooth homogeneous quotient. Both manifolds retain their
original subspace and quotient topologies.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open scoped ContDiff Manifold

noncomputable section

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [T2Space G]

/-- Ordinary closed-subgroup data construct the full homogeneous quotient
structure, with a complement to the subgroup's actual tangent space. -/
theorem exists_homogeneousQuotient_of_isClosed (K : Subgroup G) (hK : IsClosed (K : Set G)) :
    ∃ Q : HomogeneousQuotient I G K,
      Nonempty ((Q.model × subgroupTangentModel (I := I) K) ≃L[ℝ] E) := by
  obtain ⟨C⟩ := nonempty_closedLieSubgroup (I := I) K hK
  have h := exists_homogeneousQuotient_of_embeddedLieSubgroup C.presentation
  exact (congrArg (fun S : Subgroup G => ∃ Q : HomogeneousQuotient I G S,
    Nonempty ((Q.model × subgroupTangentModel (I := I) K) ≃L[ℝ] E))
      C.presentation_subgroup).mp h

/-- The smooth quotient manifold, submersion, local sections, and transitive
smooth action exist for every closed subgroup, without supplied manifold data. -/
theorem nonempty_homogeneousQuotient_of_isClosed (K : Subgroup G)
    (hK : IsClosed (K : Set G)) : Nonempty (HomogeneousQuotient I G K) := by
  obtain ⟨Q, _⟩ := exists_homogeneousQuotient_of_isClosed (I := I) K hK
  exact ⟨Q⟩

namespace HomogeneousQuotient

variable {K : Subgroup G} (Q : HomogeneousQuotient I G K)

/-- At the identity, the quotient projection kills exactly the tangent space
of the ordinary closed subgroup. -/
theorem ker_mfderiv_one_eq_subgroupTangentSubmodule (hK : IsClosed (K : Set G))
    (L : (Q.model × subgroupTangentModel (I := I) K) ≃L[ℝ] E) :
    letI := Q.chartedSpace
    (mfderiv I 𝓘(ℝ, Q.model) (QuotientGroup.mk : G → G ⧸ K) (1 : G)).ker =
      subgroupTangentSubmodule (I := I) K := by
  obtain ⟨C⟩ := nonempty_closedLieSubgroup (I := I) K hK
  let R : Subgroup G → Prop := fun S => ∀ Q' : HomogeneousQuotient I G S,
    ∀ L' : (Q'.model × subgroupTangentModel (I := I) K) ≃L[ℝ] E,
    letI := Q'.chartedSpace
    (mfderiv I 𝓘(ℝ, Q'.model) (QuotientGroup.mk : G → G ⧸ S) (1 : G)).ker =
      subgroupTangentSubmodule (I := I) K
  have hR : R C.presentation.toImmersedLieSubgroup.subgroup := by
    intro Q' L'
    exact (C.presentation.toImmersedLieSubgroup.ker_quotientDifferential_eq_lieAlgebra Q' L').trans
      C.presentation_lieAlgebra_toSubmodule
  exact (congrArg R C.presentation_subgroup).mp hR Q L

/-- The origin tangent space of a closed homogeneous quotient is the ambient
Lie algebra modulo the actual isotropy tangent subspace. -/
def lieAlgebraQuotientEquiv (hK : IsClosed (K : Set G))
    (L : (Q.model × subgroupTangentModel (I := I) K) ≃L[ℝ] E) :
    letI := Q.chartedSpace
    (GroupLieAlgebra I G ⧸ subgroupTangentSubmodule (I := I) K) ≃ₗ[ℝ]
      TangentSpace 𝓘(ℝ, Q.model) (QuotientGroup.mk (1 : G) : G ⧸ K) := by
  let := Q.chartedSpace
  exact (Submodule.quotEquivOfEq _ _
    (Q.ker_mfderiv_one_eq_subgroupTangentSubmodule hK L).symm).trans
      (Q.tangentQuotientEquiv 1)

/-- The tangent quotient identification sends the class of a Lie-algebra vector
to the actual differential of the quotient projection. -/
theorem lieAlgebraQuotientEquiv_mk (hK : IsClosed (K : Set G))
    (L : (Q.model × subgroupTangentModel (I := I) K) ≃L[ℝ] E)
    (v : GroupLieAlgebra I G) :
    letI := Q.chartedSpace
    Q.lieAlgebraQuotientEquiv hK L (Submodule.Quotient.mk v) =
      mfderiv I 𝓘(ℝ, Q.model) (QuotientGroup.mk : G → G ⧸ K) (1 : G) v := by
  let := Q.chartedSpace
  simp only [lieAlgebraQuotientEquiv, LinearEquiv.trans_apply, Submodule.quotEquivOfEq_mk,
    tangentQuotientEquiv_mk]

end HomogeneousQuotient

end LieGroups

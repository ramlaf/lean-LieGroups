import LieGroups.ActionAdjoint
import LieGroups.Manifold.ParametricMFDeriv
import LieGroups.IsotropyInnerProduct

/-!
# The tangent representation at a fixed point

Differentiating a smooth action at a point fixed by the whole acting group gives
an actual linear representation. A continuous linear frame identifies the tangent
space with a normed model without changing its topology.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-22.
-/

noncomputable section

open scoped ContDiff Manifold Topology
set_option backward.isDefEq.respectTransparency false

namespace LieGroups

variable {E F H H' G M V : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H}
  [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'}
  [Group G] [TopologicalSpace G] [ChartedSpace H G]
  [LieGroup I ∞ G]
  [TopologicalSpace M] [ChartedSpace H' M] [IsManifold J ∞ M]
  [MulAction G M] [ContMDiffSMul I J ∞ G M]
  [NormedAddCommGroup V] [NormedSpace ℝ V]

/-- The tangent representation of an action at a fixed point, expressed in a
continuous linear frame. -/
def fixedPointTangentRepresentation (o : M) (hfix : ∀ g : G, g • o = o)
    (e : V ≃L[ℝ] TangentSpace J o) : G →* (V →L[ℝ] V) where
  toFun g := e.symm.toContinuousLinearMap.comp
    ((show TangentSpace J o →L[ℝ] TangentSpace J o from actionTangent (J := J) g o).comp
      e.toContinuousLinearMap)
  map_one' := by
    ext v
    simp [actionTangent_one]
  map_mul' g h := by
    ext v
    change e.symm (actionTangent (J := J) (g * h) o (e v)) =
      e.symm (actionTangent (J := J) g o (e (e.symm (actionTangent (J := J) h o (e v)))))
    rw [e.apply_symm_apply, actionTangent_mul (I := I)]
    change e.symm (actionTangent (J := J) g (h • o)
      (actionTangent (J := J) h o (e v))) = _
    rw [hfix h]

omit [LieGroup I ∞ G] [IsManifold J ∞ M] in
@[simp]
theorem fixedPointTangentRepresentation_apply (o : M) (hfix : ∀ g : G, g • o = o)
    (e : V ≃L[ℝ] TangentSpace J o) (g : G) (v : V) :
    fixedPointTangentRepresentation (I := I) o hfix e g v =
      e.symm (actionTangent (J := J) g o (e v)) := rfl

/-- The tangent representation is smooth as a map into continuous linear maps. -/
theorem contMDiff_fixedPointTangentRepresentation
    (o : M) (hfix : ∀ g : G, g • o = o) (e : V ≃L[ℝ] TangentSpace J o) :
    ContMDiff I 𝓘(ℝ, V →L[ℝ] V) ∞
      (fun g => fixedPointTangentRepresentation (I := I) o hfix e g) := by
  let eraw : V ≃L[ℝ] F := e
  have hd : ContMDiff I 𝓘(ℝ, F →L[ℝ] F) ∞
      (fun g : G => (show F →L[ℝ] F from actionTangent (J := J) g o)) := by
    intro a
    have hc := (contMDiff_smul (I := I) (I' := J) (n := ∞) (a, o)).mfderiv
      (m := (∞ : ℕ∞ω)) (fun g x => g • x) (fun _ => o) contMDiffAt_const (by simp)
    apply hc.congr_of_eventuallyEq
    filter_upwards [] with g
    symm
    change inTangentCoordinates J J (fun _ : G => o) (fun g : G => g • o)
      (fun g => mfderiv J J (fun x : M => g • x) o) a g = _
    rw [inTangentCoordinates_eq (fun _ : G => o) (fun g : G => g • o)
      (fun g => mfderiv J J (fun x : M => g • x) o)]
    · have hout : (tangentBundleCore J M).coordChange (achart H' (g • o))
          (achart H' (a • o)) (g • o) = ContinuousLinearMap.id ℝ F := by
        rw [hfix g, hfix a]
        ext v
        exact (tangentBundleCore J M).coordChange_self _ _ (mem_achart_source H' o) v
      have hin : (tangentBundleCore J M).coordChange (achart H' o)
          (achart H' o) o = ContinuousLinearMap.id ℝ F := by
        ext v
        exact (tangentBundleCore J M).coordChange_self _ _ (mem_achart_source H' o) v
      rw [hout, hin]
      rfl
    · exact mem_chart_source H' o
    · simpa only [hfix] using mem_chart_source H' o
  exact (contMDiff_const (c := eraw.symm.toContinuousLinearMap)).clm_comp
    (hd.clm_comp (contMDiff_const (c := eraw.toContinuousLinearMap)))

section Restriction

variable {D H'' L : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
  [TopologicalSpace H''] {I' : ModelWithCorners ℝ D H''}
  [Group L] [TopologicalSpace L] [ChartedSpace H'' L] [LieGroup I' ∞ L]

/-- The tangent isotropy representation for a smooth homomorphism into the acting
group whose image fixes the chosen origin. In particular, this applies to a Lie
subgroup inclusion. -/
def fixedPointTangentRepresentationOfHom (f : L →* G)
    (hf : ContMDiff I' I ∞ (fun k => f k)) (o : M)
    (hfix : ∀ k : L, f k • o = o) (e : V ≃L[ℝ] TangentSpace J o) :
    L →* (V →L[ℝ] V) := by
  letI : MulAction L M := MulAction.compHom M f
  letI : ContMDiffSMul I' J ∞ L M := MulAction.contMDiffSMul_compHom hf
  exact fixedPointTangentRepresentation (I := I') o hfix e

omit [LieGroup I ∞ G] [IsManifold J ∞ M] [LieGroup I' ∞ L] in
@[simp]
theorem fixedPointTangentRepresentationOfHom_apply (f : L →* G)
    (hf : ContMDiff I' I ∞ (fun k => f k)) (o : M)
    (hfix : ∀ k : L, f k • o = o) (e : V ≃L[ℝ] TangentSpace J o)
    (k : L) (v : V) :
    fixedPointTangentRepresentationOfHom f hf o hfix e k v =
      e.symm (actionTangent (J := J) (f k) o (e v)) := rfl

omit [LieGroup I ∞ G] in
/-- Smoothness of the isotropy representation obtained through a subgroup map. -/
theorem contMDiff_fixedPointTangentRepresentationOfHom (f : L →* G)
    (hf : ContMDiff I' I ∞ (fun k => f k)) (o : M)
    (hfix : ∀ k : L, f k • o = o) (e : V ≃L[ℝ] TangentSpace J o) :
    ContMDiff I' 𝓘(ℝ, V →L[ℝ] V) ∞
      (fun k => fixedPointTangentRepresentationOfHom f hf o hfix e k) := by
  let : MulAction L M := MulAction.compHom M f
  let : ContMDiffSMul I' J ∞ L M := MulAction.contMDiffSMul_compHom hf
  exact contMDiff_fixedPointTangentRepresentation (I := I') o hfix e

omit [IsManifold J ∞ M] [LieGroup I' ∞ L] in
/-- The tangent isotropy representation intertwines the orbit differential with
the ambient adjoint action. -/
theorem fixedPointTangentRepresentationOfHom_orbitLieDifferential (f : L →* G)
    (hf : ContMDiff I' I ∞ (fun k => f k)) (o : M)
    (hfix : ∀ k : L, f k • o = o) (e : V ≃L[ℝ] TangentSpace J o)
    (k : L) (Y : GroupLieAlgebra I G) :
    fixedPointTangentRepresentationOfHom f hf o hfix e k
        (e.symm (orbitLieDifferential (I := I) (J := J) o Y)) =
      e.symm (orbitLieDifferential (I := I) (J := J) o
        (lieAdjoint (I := I) (f k) Y)) := by
  rw [fixedPointTangentRepresentationOfHom_apply, e.apply_symm_apply,
    actionTangent_orbitLieDifferential (I := I)]
  rw [hfix k]


end Restriction

end LieGroups

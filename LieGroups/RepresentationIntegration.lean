import LieGroups.LieAlgebraIntegration
import LieGroups.LinearLieAlgebra
import LieGroups.TwoStepRepresentation
import Mathlib.Algebra.Lie.Semisimple.Basic
import LieGroups.Algebra.AffineRepresentation
import LieGroups.Algebra.AbelianizationRepresentation
import LieGroups.Algebra.UniversalEnveloping

/-!
# Simply connected integration from faithful representations

An injective finite-dimensional representation constructs an actual simply
connected integration by taking its image in the general linear group's Lie
algebra. The adjoint representation supplies such an integration when the center
vanishes. An explicit affine representation supplies it when triple brackets
vanish, including two-step nilpotent and abelian Lie algebras.

Derivations detecting the center, or disjointness of the center and derived ideal,
give further explicit faithful representations. A family separating central
elements can also be reduced to finitely many modules and combined with the
adjoint representation. All representation modules are purely algebraic inputs;
compatible norms are chosen inside the integration construction.

The general existence of a finite-dimensional faithful representation is not
assumed or asserted here.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open scoped ContDiff Manifold

namespace LieGroups

universe uL uV uI

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

attribute [local instance] LieRing.ofAssociativeRing

variable {L : Type uL} [LieRing L] [LieAlgebra ℝ L] [FiniteDimensional ℝ L]
  {V : Type uV} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]

/-- A faithful finite-dimensional representation constructs a simply connected
Hausdorff Lie group integrating the original Lie algebra. -/
theorem nonempty_lieAlgebraIntegration_of_faithful_representation
    (ρ : L →ₗ⁅ℝ⁆ Module.End ℝ V) (hρ : Function.Injective ρ) :
    Nonempty (LieAlgebraIntegration.{uL, uV} L) := by
  let : NormedAddCommGroup V := finiteDimensionalNormedAddCommGroup V
  let : NormedSpace ℝ V := finiteDimensionalNormedSpace V
  let ψ := (generalLinearLieAlgebraEquiv (V := V)).symm.toLieHom.comp ρ
  apply nonempty_lieAlgebraIntegration_of_injective_lieHom ψ
  exact (generalLinearLieAlgebraEquiv (V := V)).symm.injective.comp hρ

/-- A faithful action on a finite-dimensional Lie module supplies the
representation needed by the integration construction. -/
theorem nonempty_lieAlgebraIntegration_of_faithful_module
    [LieRingModule L V] [LieModule ℝ L V] [LieModule.IsFaithful ℝ L V] :
    Nonempty (LieAlgebraIntegration.{uL, uV} L) :=
  nonempty_lieAlgebraIntegration_of_faithful_representation
    (LieModule.toEnd ℝ L V) (LieModule.IsFaithful.injective_toEnd (R := ℝ) (L := L) (M := V))

/-- A center-free finite-dimensional real Lie algebra has a constructed simply
connected integrating group, supplied by its faithful adjoint representation. -/
theorem nonempty_lieAlgebraIntegration_of_center_eq_bot
    (h : LieAlgebra.center ℝ L = ⊥) : Nonempty (LieAlgebraIntegration.{uL, uL} L) := by
  let : LieModule.IsFaithful ℝ L L := (LieAlgebra.isFaithful_self_iff ℝ L).mpr h
  exact nonempty_lieAlgebraIntegration_of_faithful_module (L := L) (V := L)

/-- In particular, a finite-dimensional real Lie algebra with trivial solvable
radical has a constructed simply connected integrating group. -/
theorem nonempty_lieAlgebraIntegration_of_hasTrivialRadical
    [LieAlgebra.HasTrivialRadical ℝ L] : Nonempty (LieAlgebraIntegration.{uL, uL} L) :=
  nonempty_lieAlgebraIntegration_of_faithful_module (L := L) (V := L)

/-- Vanishing triple brackets give a constructed simply connected integration
using the explicit faithful representation on `ℝ × L`. -/
theorem nonempty_lieAlgebraIntegration_of_tripleLie_eq_zero
    (h₂ : ∀ x y z : L, ⁅x, ⁅y, z⁆⁆ = 0) :
    Nonempty (LieAlgebraIntegration.{uL, uL} L) :=
  nonempty_lieAlgebraIntegration_of_faithful_representation
    (twoStepRepresentation h₂) (twoStepRepresentation_injective h₂)

/-- The usual lower-central-series bound for two-step nilpotent Lie algebras
therefore supplies an actual simply connected integration. -/
theorem nonempty_lieAlgebraIntegration_of_lowerCentralSeries_two_eq_bot
    (h₂ : LieModule.lowerCentralSeries ℝ L L 2 = ⊥) :
    Nonempty (LieAlgebraIntegration.{uL, uL} L) :=
  nonempty_lieAlgebraIntegration_of_tripleLie_eq_zero
    (tripleLie_eq_zero_of_lowerCentralSeries_two_eq_bot h₂)

/-- Every finite-dimensional abelian real Lie algebra has a constructed simply
connected integration. -/
theorem nonempty_lieAlgebraIntegration_of_isLieAbelian [IsLieAbelian L] :
    Nonempty (LieAlgebraIntegration.{uL, uL} L) := by
  apply nonempty_lieAlgebraIntegration_of_tripleLie_eq_zero
  intro x y z
  exact trivial_lie_zero L L x ⁅y, z⁆

/-- A derivation detecting every nonzero central element constructs a simply
connected integration through its faithful affine representation. -/
theorem nonempty_lieAlgebraIntegration_of_derivation_injective_on_center
    (D : LieDerivation ℝ L L)
    (hD : ∀ x ∈ LieAlgebra.center ℝ L, D x = 0 → x = 0) :
    Nonempty (LieAlgebraIntegration.{uL, uL} L) :=
  nonempty_lieAlgebraIntegration_of_faithful_representation
    (derivationAffineRepresentation D)
    (derivationAffineRepresentation_injective_of_center D hD)

/-- A nonsingular derivation supplies its own faithful affine representation,
and hence an actual simply connected integrating group. -/
theorem nonempty_lieAlgebraIntegration_of_injective_derivation
    (D : LieDerivation ℝ L L) (hD : Function.Injective D) :
    Nonempty (LieAlgebraIntegration.{uL, uL} L) :=
  nonempty_lieAlgebraIntegration_of_faithful_representation
    (derivationAffineRepresentation D) (derivationAffineRepresentation_injective D hD)

/-- Adjoint action together with translation on the abelianization constructs an
integration when the center and derived ideal have trivial intersection. -/
theorem nonempty_lieAlgebraIntegration_of_disjoint_center_derived
    (h : Disjoint (LieAlgebra.center ℝ L) (LieAlgebra.derivedSeries ℝ L 1)) :
    Nonempty (LieAlgebraIntegration.{uL, uL} L) :=
  nonempty_lieAlgebraIntegration_of_faithful_representation
    (adjointAbelianizationRepresentation ℝ L)
    (adjointAbelianizationRepresentation_injective ℝ L h)

section SeparatingFamily

variable {ι : Type uI} {W : ι → Type uV} [∀ i, AddCommGroup (W i)]
  [∀ i, Module ℝ (W i)] [∀ i, FiniteDimensional ℝ (W i)]

/-- A point-separating family of finite-dimensional modules constructs an
integration: only finitely many of the given representations are needed. -/
theorem nonempty_lieAlgebraIntegration_of_separating_representations
    (ρ : ∀ i, L →ₗ⁅ℝ⁆ Module.End ℝ (W i))
    (hρ : ∀ x : L, (∀ i, ρ i x = 0) → x = 0) :
    Nonempty (LieAlgebraIntegration.{uL, max uI uV} L) := by
  obtain ⟨s, hs⟩ := exists_faithful_finiteProductRepresentation ρ hρ
  exact nonempty_lieAlgebraIntegration_of_faithful_representation
    (finiteProductRepresentation s ρ) hs

/-- It is enough for the family to separate central elements. The adjoint
representation detects every other element, and a finite block sum then
constructs an actual simply connected integrating group. -/
theorem nonempty_lieAlgebraIntegration_of_representations_separating_center
    (ρ : ∀ i, L →ₗ⁅ℝ⁆ Module.End ℝ (W i))
    (hρ : ∀ x ∈ LieAlgebra.center ℝ L, (∀ i, ρ i x = 0) → x = 0) :
    Nonempty (LieAlgebraIntegration.{uL, max uL uI uV} L) := by
  obtain ⟨s, hs⟩ := exists_faithful_adjoint_finiteProduct_representation ρ hρ
  let P := ∀ i : s, W i.1
  let κ : L →ₗ⁅ℝ⁆ Module.End ℝ (L × P) :=
    (LinearMap.prodMapAlgHom ℝ L P).toLieHom.comp
      ((LieAlgebra.ad ℝ L).prod (finiteProductRepresentation s ρ))
  apply nonempty_lieAlgebraIntegration_of_faithful_representation κ
  intro x y hxy
  apply hs
  apply Prod.ext
  · apply LinearMap.ext
    intro v
    exact congrArg (fun F : Module.End ℝ (L × P) => (F (v, 0)).1) hxy
  · apply LinearMap.ext
    intro v
    exact congrArg (fun F : Module.End ℝ (L × P) => (F (0, v)).2) hxy

end SeparatingFamily

end LieGroups

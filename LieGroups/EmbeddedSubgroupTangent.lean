import LieGroups.ImmersedLieSubgroup
import LieGroups.Manifold.ImmersionLocalInverse
import LieGroups.SubgroupTangent

/-!
# Ambient curve tangents of embedded Lie subgroups

An embedded subgroup has a smooth inverse locally within its image. Thus an ambient
differentiable curve in the image lifts locally through the source identity, and its velocity
belongs to the range of the inclusion's identity differential.

Together with the one-parameter curves in the source, this identifies the ambient curve tangent
set with the tangent Lie subalgebra for embedded subgroups. The topological embedding hypothesis
is essential to this lifting argument; this theorem does not assert the corresponding equality
for arbitrary immersed subgroup presentations.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Filter
open scoped ContDiff Manifold Topology

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K]

set_option backward.isDefEq.respectTransparency false in
/-- An immersion inducing its source topology lifts ambient curves locally within its range.
Consequently their velocities lie in the identity differential range. Only a boundaryless
source model is needed; no completeness or Hausdorff assumptions enter this direction. -/
theorem subgroupTangentSet_range_subset_range_homLieDifferential [J.Boundaryless]
    (f : K →* G) (hf : _root_.Manifold.IsImmersion J I ∞ (fun x => f x))
    (hind : Topology.IsInducing (fun x => f x)) :
    subgroupTangentSet (I := I) f.range ⊆
      Set.range (homLieDifferential (I := J) (J := I) f) := by
  rintro v ⟨γ, hγ, hmem, hdiff, hderiv⟩
  obtain ⟨r, hr1, hr, _, hrange⟩ :=
    Manifold.exists_contMDiffAt_localInverseWithinRange_of_isImmersionAt
      (hf.isImmersionAt (1 : K)) hind
  have hrone : r (1 : G) = 1 := by simpa only [map_one] using hr1
  have hrsmooth : ContMDiffAt I J ∞ r (1 : G) := by
    simpa only [map_one] using hr
  have hγrange : Tendsto γ (𝓝 0) (𝓝[Set.range (fun x => f x)] (1 : G)) := by
    apply tendsto_nhdsWithin_iff.mpr
    refine ⟨?_, Filter.Eventually.of_forall (fun t => hmem t)⟩
    have hcont : Tendsto γ (𝓝 0) (𝓝 (γ 0)) := hdiff.continuousAt
    simpa only [hγ] using hcont
  have hrange' : ((fun x => f x) ∘ r) =ᶠ[𝓝[Set.range (fun x => f x)] (1 : G)] id := by
    simpa only [map_one] using hrange
  have hcomp : ((fun x => f x) ∘ (r ∘ γ)) =ᶠ[𝓝 0] γ :=
    hrange'.comp_tendsto hγrange
  have hδzero : (r ∘ γ) 0 = 1 := by simp only [comp_apply, hγ, hrone]
  have hδdiff : MDifferentiableAt 𝓘(ℝ, ℝ) J (r ∘ γ) 0 := by
    apply MDifferentiableAt.comp 0 _ hdiff
    simpa only [hγ] using hrsmooth.mdifferentiableAt (by simp)
  let w : GroupLieAlgebra J K :=
    mfderiv 𝓘(ℝ, ℝ) J (r ∘ γ) 0 ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)
  refine ⟨w, ?_⟩
  have hchain := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, ℝ)) (I' := J) (I'' := I)
    (x := (0 : ℝ)) (f := r ∘ γ) (g := fun x => f x)
    (hf.contMDiff.mdifferentiable (by simp) 1) hδdiff hδzero
    ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)
  have hsame :
      mfderiv 𝓘(ℝ, ℝ) I ((fun x => f x) ∘ (r ∘ γ)) 0
          ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1) =
        mfderiv 𝓘(ℝ, ℝ) I γ 0 ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1) := by
    exact congrArg (fun T : TangentSpace 𝓘(ℝ, ℝ) (0 : ℝ) →L[ℝ]
      TangentSpace I (((fun x => f x) ∘ (r ∘ γ)) 0) =>
        T ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)) hcomp.mfderiv_eq
  exact hchain.symm.trans (hsame.trans hderiv)

variable [LieGroup I ∞ G] [LieGroup J ∞ K] [CompleteSpace E] [CompleteSpace F]

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

namespace EmbeddedLieSubgroup

/-- Every ambient curve velocity in an embedded subgroup belongs to its tangent Lie
subalgebra. The source topology enters through the embedding, and boundarylessness through
the smooth local inverse. -/
theorem subgroupTangentSet_subset_lieAlgebra [J.Boundaryless]
    (S : EmbeddedLieSubgroup I G J K) :
    subgroupTangentSet (I := I) S.toImmersedLieSubgroup.subgroup ⊆
      (S.toImmersedLieSubgroup.lieAlgebra : Set (GroupLieAlgebra I G)) :=
  subgroupTangentSet_range_subset_range_homLieDifferential S.toMonoidHom
    S.isImmersion S.isEmbedding.isInducing

/-- For an embedded Lie subgroup, ambient curve velocities agree exactly with the tangent
Lie subalgebra defined by the identity differential of its inclusion. -/
theorem subgroupTangentSet_eq_lieAlgebra [J.Boundaryless] [T2Space K]
    (S : EmbeddedLieSubgroup I G J K) :
    subgroupTangentSet (I := I) S.toImmersedLieSubgroup.subgroup =
      (S.toImmersedLieSubgroup.lieAlgebra : Set (GroupLieAlgebra I G)) := by
  apply Set.Subset.antisymm S.subgroupTangentSet_subset_lieAlgebra
  exact range_homLieDifferential_subset_subgroupTangentSet S.toMonoidHom
    S.toImmersedLieSubgroup.contMDiff

end EmbeddedLieSubgroup

end LieGroups

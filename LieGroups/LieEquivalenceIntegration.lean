import LieGroups.LieHomomorphismIntegration

/-!
# Integrating Lie-algebra equivalences

Integrations of a Lie equivalence and its inverse are inverse group maps by
connected-source uniqueness. This constructs a smooth group equivalence with
the prescribed differential, without supplying a group equivalence as input.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open scoped ContDiff Manifold

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {K : Type*} [Group K] [TopologicalSpace K] [ChartedSpace H' K] [LieGroup J ∞ K]

/-- A smooth group equivalence integrating a prescribed Lie-algebra equivalence. -/
structure LieEquivalenceIntegration
    (e : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ GroupLieAlgebra J K) where
  toMulEquiv : G ≃* K
  contMDiff_toFun : ContMDiff I J ∞ (fun x => toMulEquiv x)
  contMDiff_invFun : ContMDiff J I ∞ (fun x => toMulEquiv.symm x)
  equivLieEquiv_eq : equivLieEquiv toMulEquiv contMDiff_toFun contMDiff_invFun = e

namespace LieEquivalenceIntegration

variable {e : GroupLieAlgebra I G ≃ₗ⁅ℝ⁆ GroupLieAlgebra J K}

@[ext] theorem ext (f g : LieEquivalenceIntegration e)
    (h : ∀ x, f.toMulEquiv x = g.toMulEquiv x) : f = g := by
  have he : f.toMulEquiv = g.toMulEquiv := MulEquiv.ext h
  cases f
  cases g
  cases he
  rfl

/-- The actual identity differential is the prescribed equivalence. -/
theorem homLieDifferential_apply (f : LieEquivalenceIntegration e)
    (v : GroupLieAlgebra I G) :
    homLieDifferential (I := I) (J := J) f.toMulEquiv.toMonoidHom v = e v :=
  congrArg (fun q => q v) f.equivLieEquiv_eq

instance [BoundarylessManifold I G] [T2Space G] [ConnectedSpace G]
    [BoundarylessManifold J K] [T2Space K] : Subsingleton (LieEquivalenceIntegration e) where
  allEq f g := by
    apply ext
    have he := hom_eq_of_homLieDifferential_eq
      f.toMulEquiv.toMonoidHom g.toMulEquiv.toMonoidHom f.contMDiff_toFun g.contMDiff_toFun
      (ContinuousLinearMap.ext fun v =>
        (f.homLieDifferential_apply v).trans (g.homLieDifferential_apply v).symm)
    exact fun x => congrArg (fun h : G →* K => h x) he

variable [BoundarylessManifold I G] [T2Space G] [ConnectedSpace G]
  [BoundarylessManifold J K] [T2Space K] [ConnectedSpace K]

/-- Integrating a Lie equivalence in both directions constructs inverse smooth
group homomorphisms, hence an equivalence with that prescribed differential. -/
def ofInverseIntegrations (f : LieHomomorphismIntegration e.toLieHom)
    (g : LieHomomorphismIntegration e.symm.toLieHom) : LieEquivalenceIntegration e := by
  have hgf : g.toMonoidHom.comp f.toMonoidHom = MonoidHom.id G := by
    apply hom_eq_of_homLieHom_eq (I := I) (J := I)
      (g.toMonoidHom.comp f.toMonoidHom) (MonoidHom.id G)
      (g.contMDiff.comp f.contMDiff) contMDiff_id
    rw [homLieHom_comp (I := I) (J := J) (L := I)
      f.toMonoidHom g.toMonoidHom f.contMDiff g.contMDiff,
      f.homLieHom_eq, g.homLieHom_eq, homLieHom_id]
    ext v
    exact e.symm_apply_apply v
  have hfg : f.toMonoidHom.comp g.toMonoidHom = MonoidHom.id K := by
    apply hom_eq_of_homLieHom_eq (I := J) (J := J)
      (f.toMonoidHom.comp g.toMonoidHom) (MonoidHom.id K)
      (f.contMDiff.comp g.contMDiff) contMDiff_id
    rw [homLieHom_comp (I := J) (J := I) (L := J)
      g.toMonoidHom f.toMonoidHom g.contMDiff f.contMDiff,
      f.homLieHom_eq, g.homLieHom_eq, homLieHom_id]
    ext v
    exact e.apply_symm_apply v
  let h : G ≃* K := {
    toFun := f.toMonoidHom
    invFun := g.toMonoidHom
    left_inv := fun x => congrArg (fun q : G →* G => q x) hgf
    right_inv := fun x => congrArg (fun q : K →* K => q x) hfg
    map_mul' := f.toMonoidHom.map_mul
  }
  refine ⟨h, f.contMDiff, g.contMDiff, ?_⟩
  ext v
  exact congrArg (fun q => q v) f.homLieHom_eq

end LieEquivalenceIntegration

end LieGroups

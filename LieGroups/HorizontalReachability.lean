import LieGroups.ConnectedSubgroup
import LieGroups.InvariantDistribution
import Mathlib.Logic.Relation

/-!
# Horizontal reachability in a left-invariant distribution

Smooth curves tangent to a Lie-subalgebra distribution generate an equivalence
relation. Left translation preserves this relation, so the identity class is an
actual subgroup. Its construction uses the given ambient group and differential
conditions on curves; no integrating manifold or leaf-existence hypothesis is
supplied. Local Frobenius charts can subsequently identify these classes with
their horizontal plaque-chain leaves.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open Function Set
open scoped ContDiff Manifold Topology

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

/-- A smooth ambient curve whose velocities belong to the translated subalgebra.
Only values on the specified time domain matter. -/
def IsHorizontalCurveOn (S : LieSubalgebra ℝ (GroupLieAlgebra I G))
    (γ : ℝ → G) (U : Set ℝ) : Prop :=
  ContMDiffOn 𝓘(ℝ, ℝ) I ∞ γ U ∧ ∀ t ∈ U,
    mfderiv 𝓘(ℝ, ℝ) I γ t ((NormedSpace.fromTangentSpace t).symm 1) ∈
      invariantDistribution S (γ t)

/-- Left translation preserves horizontal smooth curves on open time domains. -/
theorem IsHorizontalCurveOn.mul_left
    {S : LieSubalgebra ℝ (GroupLieAlgebra I G)} {γ : ℝ → G} {U : Set ℝ}
    (hγ : IsHorizontalCurveOn S γ U) (hU : IsOpen U) (a : G) :
    IsHorizontalCurveOn S (fun t => a * γ t) U := by
  have hmulSmooth : ContMDiff I I ∞ (a * ·) := contMDiff_mul_left
  refine ⟨hmulSmooth.comp_contMDiffOn hγ.1, ?_⟩
  intro t ht
  have hγt : MDifferentiableAt 𝓘(ℝ, ℝ) I γ t :=
    ((hγ.1 t ht).contMDiffAt (hU.mem_nhds ht)).mdifferentiableAt (by simp)
  have hmul : MDifferentiableAt I I (a * ·) (γ t) :=
    hmulSmooth.contMDiffAt.mdifferentiableAt (by simp)
  change (mfderiv 𝓘(ℝ, ℝ) I ((a * ·) ∘ γ) t)
    ((NormedSpace.fromTangentSpace t).symm 1) ∈ _
  rw [mfderiv_comp t hmul hγt, ContinuousLinearMap.comp_apply]
  rw [← invariantDistribution_map_mul_left S a (γ t)]
  exact ⟨_, hγ.2 t ht, rfl⟩

/-- Two points on a single horizontal curve with connected open time domain. -/
def HorizontalCurveRel (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (x y : G) : Prop :=
  ∃ (γ : ℝ → G) (U : Set ℝ) (s t : ℝ), IsOpen U ∧ IsPreconnected U ∧
    s ∈ U ∧ t ∈ U ∧ IsHorizontalCurveOn S γ U ∧ γ s = x ∧ γ t = y

/-- A horizontal curve segment remains horizontal after left translation. -/
theorem horizontalCurveRel_mul_left
    {S : LieSubalgebra ℝ (GroupLieAlgebra I G)} {x y : G}
    (h : HorizontalCurveRel S x y) (a : G) : HorizontalCurveRel S (a * x) (a * y) := by
  obtain ⟨γ, U, s, t, hU, hc, hs, ht, hγ, hxs, hyt⟩ := h
  exact ⟨fun r => a * γ r, U, s, t, hU, hc, hs, ht, hγ.mul_left hU a,
    congrArg (a * ·) hxs, congrArg (a * ·) hyt⟩

/-- Reachability by a finite chain of horizontal smooth curve segments. -/
def HorizontalReachable (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) : G → G → Prop :=
  Relation.EqvGen (HorizontalCurveRel S)

/-- Horizontal reachability is an equivalence relation. -/
theorem horizontalReachable_equivalence (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    Equivalence (HorizontalReachable S) := Relation.EqvGen.is_equivalence _

/-- Left translation preserves entire horizontal reachability classes. -/
theorem horizontalReachable_mul_left
    {S : LieSubalgebra ℝ (GroupLieAlgebra I G)} {x y : G}
    (h : HorizontalReachable S x y) (a : G) : HorizontalReachable S (a * x) (a * y) := by
  induction h with
  | rel x y h => exact Relation.EqvGen.rel _ _ (horizontalCurveRel_mul_left h a)
  | refl x => exact Relation.EqvGen.refl _
  | symm x y h ih => exact Relation.EqvGen.symm _ _ ih
  | trans x y z hxy hyz ihxy ihyz => exact Relation.EqvGen.trans _ _ _ ihxy ihyz

/-- Left translation identifies horizontal reachability relations in both directions. -/
theorem horizontalReachable_mul_left_iff
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (a x y : G) :
    HorizontalReachable S (a * x) (a * y) ↔ HorizontalReachable S x y := by
  constructor
  · intro h
    simpa only [inv_mul_cancel_left] using horizontalReachable_mul_left h a⁻¹
  · exact fun h => horizontalReachable_mul_left h a

/-- The identity horizontal reachability class is a subgroup. Its intrinsic leaf
topology and smooth structure are separate constructions. -/
def horizontalLeafSubgroup (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) : Subgroup G where
  carrier := {x | HorizontalReachable S 1 x}
  one_mem' := Relation.EqvGen.refl _
  mul_mem' := by
    intro x y hx hy
    exact Relation.EqvGen.trans _ _ _ hx
      (by simpa only [HorizontalReachable, mul_one] using horizontalReachable_mul_left hy x)
  inv_mem' := by
    intro x hx
    have h : HorizontalReachable S x⁻¹ 1 := by
      simpa only [mul_one, inv_mul_cancel] using horizontalReachable_mul_left hx x⁻¹
    exact Relation.EqvGen.symm _ _ h

@[simp] theorem mem_horizontalLeafSubgroup
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (x : G) :
    x ∈ horizontalLeafSubgroup S ↔ HorizontalReachable S 1 x := Iff.rfl

/-- Every horizontal reachability class is the left coset of the identity class. -/
theorem horizontalReachable_iff_inv_mul_mem
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) (x y : G) :
    HorizontalReachable S x y ↔ x⁻¹ * y ∈ horizontalLeafSubgroup S := by
  rw [mem_horizontalLeafSubgroup]
  simpa only [inv_mul_cancel] using
    (horizontalReachable_mul_left_iff S x⁻¹ x y).symm

variable [BoundarylessManifold I G] [T2Space G]

/-- The one-parameter subgroup of a Lie-subalgebra vector is horizontal. -/
theorem isHorizontalCurveOn_oneParameterCurve
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) {v : GroupLieAlgebra I G} (hv : v ∈ S) :
    IsHorizontalCurveOn S (oneParameterCurve v) Set.univ := by
  refine ⟨(oneParameterCurve_contMDiff v).contMDiffOn, ?_⟩
  intro t _
  rw [(oneParameterCurve_isMIntegralCurve v t).mfderiv]
  change (1 : ℝ) • mulInvariantVectorField v (oneParameterCurve v t) ∈ _
  rw [one_smul]
  exact mulInvariantVectorField_mem_invariantDistribution S hv _

/-- Every exponential of the prescribed subalgebra lies in the identity horizontal class. -/
theorem lieExp_mem_horizontalLeafSubgroup
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) {v : GroupLieAlgebra I G} (hv : v ∈ S) :
    lieExp v ∈ horizontalLeafSubgroup S := by
  apply Relation.EqvGen.rel
  exact ⟨oneParameterCurve v, Set.univ, 0, 1, isOpen_univ, isPreconnected_univ,
    Set.mem_univ _, Set.mem_univ _, isHorizontalCurveOn_oneParameterCurve S hv,
    oneParameterCurve_zero v, rfl⟩

/-- The canonical exponential-generated subgroup is contained in the identity horizontal leaf. -/
theorem lieSubalgebraSubgroup_le_horizontalLeafSubgroup
    (S : LieSubalgebra ℝ (GroupLieAlgebra I G)) :
    lieSubalgebraSubgroup S ≤ horizontalLeafSubgroup S := by
  apply (lieSubalgebraSubgroup_le_iff S _).2
  exact fun _ hv => lieExp_mem_horizontalLeafSubgroup S hv

end LieGroups

/-!
# The Lie group on the universal covering space

The underlying space is the actual based-path universal cover from
`DifferentialGeometry`. Its group operations are the unique continuous lifts of
multiplication and inversion that preserve the point above the identity.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Function Filter Set
open scoped ContDiff Manifold Topology

noncomputable section

namespace LieGroups

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

private theorem simplyConnectedSpace_prod {A B : Type*}
    [TopologicalSpace A] [TopologicalSpace B]
    [SimplyConnectedSpace A] [SimplyConnectedSpace B] : SimplyConnectedSpace (A × B) := by
  apply simply_connected_iff_paths_homotopic.mpr
  refine ⟨inferInstance, fun x y => ⟨fun p q => ?_⟩⟩
  rw [← Path.Homotopic.prod_projLeft_projRight p,
    ← Path.Homotopic.prod_projLeft_projRight q]
  congr 1 <;> exact Subsingleton.elim _ _

/-- The universal cover, based at the identity of the group. -/
def UniversalCoverGroup (G : Type*) [Group G] [TopologicalSpace G] : Type _ :=
  @DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover G _ ⟨1⟩

namespace UniversalCoverGroup

variable {G : Type*} [Group G] [TopologicalSpace G]

private abbrev baseInhabited : Inhabited G := ⟨1⟩

instance : TopologicalSpace (UniversalCoverGroup G) :=
  @DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.topology G _ baseInhabited

/-- The endpoint projection from the based-path universal cover. -/
def projection : UniversalCoverGroup G → G := Sigma.fst

/-- The constant path above the group identity. -/
def identity : UniversalCoverGroup G :=
  ⟨1, Path.Homotopic.Quotient.mk (Path.refl 1)⟩

@[simp] theorem projection_identity : projection (identity : UniversalCoverGroup G) = 1 := rfl

variable [LocallyPathConnectedSpace G]
  [DifferentialGeometry.Geometry.Riemannian.Topology.SemilocallySimplyConnectedSpace G]

theorem isCoveringMap_projection : IsCoveringMap (projection : UniversalCoverGroup G → G) :=
  @DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.proj_isCoveringMap G _
    baseInhabited _ _

instance : LocallyPathConnectedSpace (UniversalCoverGroup G) := by
  let : Inhabited G := baseInhabited
  let : ChartedSpace G (UniversalCoverGroup G) :=
    DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.instChartedSpace
  exact ChartedSpace.locallyPathConnectedSpace G (UniversalCoverGroup G)

instance : PathConnectedSpace (UniversalCoverGroup G) :=
  @DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.pathConnectedSpace G _
    baseInhabited _

instance : SimplyConnectedSpace (UniversalCoverGroup G) :=
  @DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.simplyConnectedSpace G _
    baseInhabited _ _

instance {H : Type*} [TopologicalSpace H] [ChartedSpace H G] :
    ChartedSpace H (UniversalCoverGroup G) := by
  letI : Inhabited G := baseInhabited
  exact DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.instChartedSpace

instance {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
    [ChartedSpace H G] [IsManifold I ∞ G] : IsManifold I ∞ (UniversalCoverGroup G) := by
  let : Inhabited G := baseInhabited
  exact DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.instIsManifold

instance [T2Space G] : T2Space (UniversalCoverGroup G) := by
  let : Inhabited G := baseInhabited
  exact DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.instT2Space

variable [IsTopologicalGroup G]

private instance : SimplyConnectedSpace (UniversalCoverGroup G × UniversalCoverGroup G) :=
  simplyConnectedSpace_prod

private def multiplicationBase : C(UniversalCoverGroup G × UniversalCoverGroup G, G) :=
  ⟨fun x => projection x.1 * projection x.2,
    (isCoveringMap_projection.continuous.comp continuous_fst).mul
      (isCoveringMap_projection.continuous.comp continuous_snd)⟩

private theorem exists_multiplicationLift :
    ∃! f : C(UniversalCoverGroup G × UniversalCoverGroup G, UniversalCoverGroup G),
      f (identity, identity) = identity ∧ projection ∘ f = multiplicationBase :=
  isCoveringMap_projection.existsUnique_continuousMap_lifts multiplicationBase
    (identity, identity) identity (by simp [multiplicationBase])

private def multiplicationLift : C(UniversalCoverGroup G × UniversalCoverGroup G,
    UniversalCoverGroup G) := exists_multiplicationLift.choose

private theorem multiplicationLift_identity :
    multiplicationLift (identity, identity) = (identity : UniversalCoverGroup G) :=
  exists_multiplicationLift.choose_spec.1.1

private theorem projection_multiplicationLift (a b : UniversalCoverGroup G) :
    projection (multiplicationLift (a, b)) = projection a * projection b :=
  congrFun exists_multiplicationLift.choose_spec.1.2 (a, b)

private def inversionLift : C(UniversalCoverGroup G, UniversalCoverGroup G) :=
  (isCoveringMap_projection.existsUnique_continuousMap_lifts
    ⟨fun x => (projection x)⁻¹, isCoveringMap_projection.continuous.inv⟩
    identity identity (by simp)).choose

private theorem inversionLift_identity :
    inversionLift identity = (identity : UniversalCoverGroup G) :=
  (isCoveringMap_projection.existsUnique_continuousMap_lifts
    ⟨fun x => (projection x)⁻¹, isCoveringMap_projection.continuous.inv⟩
    identity identity (by simp)).choose_spec.1.1

private theorem projection_inversionLift (a : UniversalCoverGroup G) :
    projection (inversionLift a) = (projection a)⁻¹ :=
  congrFun (isCoveringMap_projection.existsUnique_continuousMap_lifts
    ⟨fun x => (projection x)⁻¹, isCoveringMap_projection.continuous.inv⟩
    identity identity (by simp)).choose_spec.1.2 a

instance : One (UniversalCoverGroup G) := ⟨identity⟩
instance : Mul (UniversalCoverGroup G) := ⟨fun a b => multiplicationLift (a, b)⟩
instance : Inv (UniversalCoverGroup G) := ⟨inversionLift⟩

omit [LocallyPathConnectedSpace G]
    [DifferentialGeometry.Geometry.Riemannian.Topology.SemilocallySimplyConnectedSpace G]
    [IsTopologicalGroup G] in
@[simp] theorem projection_one : projection (1 : UniversalCoverGroup G) = 1 := rfl

@[simp] theorem projection_mul (a b : UniversalCoverGroup G) :
    projection (a * b) = projection a * projection b := projection_multiplicationLift a b

@[simp] theorem projection_inv (a : UniversalCoverGroup G) :
    projection a⁻¹ = (projection a)⁻¹ := projection_inversionLift a

private theorem continuous_multiplication :
    Continuous (fun x : UniversalCoverGroup G × UniversalCoverGroup G => x.1 * x.2) :=
  multiplicationLift.continuous

private theorem continuous_inversion : Continuous (fun a : UniversalCoverGroup G => a⁻¹) :=
  inversionLift.continuous

private theorem identity_mul_identity : (1 : UniversalCoverGroup G) * 1 = 1 :=
  multiplicationLift_identity

private theorem inv_identity : (1 : UniversalCoverGroup G)⁻¹ = 1 := inversionLift_identity

private theorem one_mul_eq (a : UniversalCoverGroup G) : 1 * a = a := by
  have h := isCoveringMap_projection.eq_of_comp_eq
    (continuous_multiplication.comp (continuous_const.prodMk continuous_id)) continuous_id
    (by ext x; simp) (1 : UniversalCoverGroup G) identity_mul_identity
  exact congrFun h a

private theorem mul_one_eq (a : UniversalCoverGroup G) : a * 1 = a := by
  have h := isCoveringMap_projection.eq_of_comp_eq
    (continuous_multiplication.comp (continuous_id.prodMk continuous_const)) continuous_id
    (by ext x; simp) (1 : UniversalCoverGroup G) identity_mul_identity
  exact congrFun h a

private theorem mul_assoc_eq (a b c : UniversalCoverGroup G) : (a * b) * c = a * (b * c) := by
  have h := isCoveringMap_projection.eq_of_comp_eq
    (continuous_multiplication.comp
      ((continuous_multiplication.comp
        (continuous_fst.prodMk (continuous_fst.comp continuous_snd))).prodMk
          (continuous_snd.comp continuous_snd)))
    (continuous_multiplication.comp
      (continuous_fst.prodMk (continuous_multiplication.comp continuous_snd)))
    (by ext x; simp [mul_assoc]) ((1, 1, 1) :
      UniversalCoverGroup G × UniversalCoverGroup G × UniversalCoverGroup G)
    (by change (1 * 1) * 1 = 1 * (1 * 1); rw [identity_mul_identity])
  exact congrFun h (a, b, c)

private theorem inv_mul_eq (a : UniversalCoverGroup G) : a⁻¹ * a = 1 := by
  have h := isCoveringMap_projection.eq_of_comp_eq
    (continuous_multiplication.comp (continuous_inversion.prodMk continuous_id))
    (show Continuous (fun _ : UniversalCoverGroup G => (1 : UniversalCoverGroup G)) from
      continuous_const)
    (by ext x; simp) (1 : UniversalCoverGroup G)
    (by change (1 : UniversalCoverGroup G)⁻¹ * 1 = 1; rw [inv_identity, identity_mul_identity])
  exact congrFun h a

/-- The group law on the actual universal covering space is constructed by lifting. -/
instance : Group (UniversalCoverGroup G) where
  mul_assoc := mul_assoc_eq
  one_mul := one_mul_eq
  mul_one := mul_one_eq
  inv_mul_cancel := inv_mul_eq

instance : IsTopologicalGroup (UniversalCoverGroup G) where
  continuous_mul := continuous_multiplication
  continuous_inv := continuous_inversion

/-- The universal covering projection is a group homomorphism. -/
def projectionHom : UniversalCoverGroup G →* G where
  toFun := projection
  map_one' := projection_one
  map_mul' := projection_mul

variable {E H : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  [ChartedSpace H G] [LieGroup I ∞ G]

omit [IsTopologicalGroup G] in
/-- The universal cover inherits smoothness by its actual covering atlas. -/
theorem contMDiff_projection : ContMDiff I I ∞ (projection : UniversalCoverGroup G → G) := by
  let : Inhabited G := baseInhabited
  exact DifferentialGeometry.Geometry.Riemannian.Topology.UniversalCover.proj_contMDiff

omit [IsTopologicalGroup G] in
/-- The projection of the constructed covering group is a local diffeomorphism. -/
theorem isLocalDiffeomorph_projection :
    IsLocalDiffeomorph I I ∞ (projection : UniversalCoverGroup G → G) := by
  let : Inhabited G := baseInhabited
  exact Manifold.universalCoverProjection_isLocalDiffeomorph

/-- The lifted group operations are smooth because their projections are the
smooth base-group operations. -/
instance : LieGroup I ∞ (UniversalCoverGroup G) where
  contMDiff_mul := Manifold.contMDiff_of_comp_localDiffeomorph
    (isLocalDiffeomorph_projection (I := I) (G := G)) continuous_multiplication (by
      have h : ContMDiff (I.prod I) I ∞
          (fun x : UniversalCoverGroup G × UniversalCoverGroup G =>
            projection x.1 * projection x.2) :=
        ((contMDiff_projection (I := I) (G := G)).comp contMDiff_fst).mul
          ((contMDiff_projection (I := I) (G := G)).comp contMDiff_snd)
      convert h using 1
      ext x
      exact projection_mul x.1 x.2)
  contMDiff_inv := Manifold.contMDiff_of_comp_localDiffeomorph
    (isLocalDiffeomorph_projection (I := I) (G := G)) continuous_inversion (by
      have h := (contMDiff_projection (I := I) (G := G)).inv
      convert h using 1
      ext x
      exact projection_inv x)

/-- The differential of the universal covering homomorphism identifies the
covering group's Lie algebra with the base Lie algebra. -/
def projectionLieEquiv [CompleteSpace E] :
    GroupLieAlgebra I (UniversalCoverGroup G) ≃ₗ⁅ℝ⁆ GroupLieAlgebra I G :=
  LieEquiv.ofBijective
    (homLieHom (I := I) (J := I) projectionHom (contMDiff_projection (I := I)))
    (((isLocalDiffeomorph_projection (I := I) (G := G)) 1).mfderivToContinuousLinearEquiv
      (by simp)).bijective

@[simp] theorem projectionLieEquiv_apply [CompleteSpace E]
    (v : GroupLieAlgebra I (UniversalCoverGroup G)) :
    projectionLieEquiv (I := I) v =
      homLieDifferential (I := I) (J := I) projectionHom v := rfl

end UniversalCoverGroup
end LieGroups

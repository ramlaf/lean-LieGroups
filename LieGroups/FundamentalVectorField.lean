import LieGroups.OneParameterSubgroup
import Mathlib.Geometry.Manifold.Algebra.SMul

/-!
# Fundamental vector fields of smooth left actions

The fundamental field of a Lie algebra vector is the differential at the identity of
the orbit map. The convention is the derivative of `exp(t v) • x`, with positive time.
For left actions this convention gives an antihomomorphism of Lie algebras.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

open Function
open scoped ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ F H'}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H' M] [MulAction G M]

/-- The infinitesimal action at a point, defined by the actual orbit derivative. -/
noncomputable def orbitLieDifferential (x : M) :
    GroupLieAlgebra I G →L[ℝ] TangentSpace J x :=
  mfderiv I J (fun g : G => g • x) (1 : G)

/-- The fundamental field for a left action uses the positive-time convention. -/
noncomputable def fundamentalVectorField (v : GroupLieAlgebra I G) (x : M) :
    TangentSpace J x :=
  orbitLieDifferential (I := I) (J := J) x v

@[simp] theorem fundamentalVectorField_zero (x : M) :
    fundamentalVectorField (I := I) (J := J) (0 : GroupLieAlgebra I G) x = 0 :=
  map_zero _

@[simp] theorem fundamentalVectorField_add (v w : GroupLieAlgebra I G) (x : M) :
    fundamentalVectorField (I := I) (J := J) (v + w) x =
      fundamentalVectorField (I := I) (J := J) v x +
      fundamentalVectorField (I := I) (J := J) w x :=
  map_add _ _ _

@[simp] theorem fundamentalVectorField_smul (c : ℝ) (v : GroupLieAlgebra I G) (x : M) :
    fundamentalVectorField (I := I) (J := J) (c • v) x =
      c • fundamentalVectorField (I := I) (J := J) v x :=
  map_smul _ _ _

@[simp] theorem fundamentalVectorField_neg (v : GroupLieAlgebra I G) (x : M) :
    fundamentalVectorField (I := I) (J := J) (-v) x =
      -fundamentalVectorField (I := I) (J := J) v x :=
  map_neg _ _

/-- The infinitesimal action, bundled as a linear map into vector fields. -/
noncomputable def fundamentalVectorFieldLinear :
    GroupLieAlgebra I G →ₗ[ℝ] ((x : M) → TangentSpace J x) where
  toFun := fundamentalVectorField
  map_add' v w := funext (fundamentalVectorField_add v w)
  map_smul' c v := funext (fundamentalVectorField_smul c v)

variable [LieGroup I ∞ G] [IsManifold J ∞ M] [ContMDiffSMul I J ∞ G M]

omit [LieGroup I ∞ G] [IsManifold J ∞ M] in
/-- The orbit map of a smooth action is smooth. -/
theorem contMDiff_orbitMap (x : M) :
    ContMDiff I J ∞ (fun g : G => g • x) :=
  contMDiff_id.smul contMDiff_const

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Fundamental fields of a smooth action are smooth sections of the tangent bundle. -/
theorem contMDiff_fundamentalVectorField (v : GroupLieAlgebra I G) :
    ContMDiff J J.tangent ∞
      (fun x : M => (⟨x, fundamentalVectorField (I := I) (J := J) v x⟩ :
        TangentBundle J M)) := by
  let fv : M → TangentBundle I G := fun _ => Bundle.TotalSpace.mk' E 1 v
  have sfv : ContMDiff J I.tangent ∞ fv := contMDiff_const
  let fz : M → TangentBundle J M := fun x => Bundle.TotalSpace.mk' F x 0
  have sfz : ContMDiff J J.tangent ∞ fz := Bundle.contMDiff_zeroSection _ _
  let F₂ := (equivTangentBundleProd I G J M).symm
  let F₃ := tangentMap (I.prod J) J (fun p : G × M => p.1 • p.2)
  have S₂ : ContMDiff (I.tangent.prod J.tangent) (I.prod J).tangent ∞ F₂ :=
    contMDiff_equivTangentBundleProd_symm
  have S₃ : ContMDiff (I.prod J).tangent J.tangent ∞ F₃ :=
    (contMDiff_smul (I := I) (I' := J) (n := ∞)).contMDiff_tangentMap (by simp)
  convert! (S₃.comp S₂).comp (sfv.prodMk sfz) with x
  · simp [F₂, F₃, fv, fz]
  · simp only [comp_apply, tangentMap, F₃, F₂, fv, fz]
    rw [mfderiv_prod_eq_add_apply
      ((contMDiff_smul (I := I) (I' := J) (n := ∞)).mdifferentiableAt (by simp))]
    simp +instances [fundamentalVectorField, orbitLieDifferential]
    rfl

set_option backward.isDefEq.respectTransparency false in
omit [IsManifold J ∞ M] in
/-- The orbit map relates a right-invariant group field to the fundamental action field. -/
theorem mfderiv_orbitMap_mul_right (x : M) (v : GroupLieAlgebra I G) (g : G) :
    mfderiv I J (fun h : G => h • x) g
      (mfderiv I I (fun h : G => h * g) 1 v) =
      fundamentalVectorField (I := I) (J := J) v (g • x) := by
  have h := mfderiv_comp_apply_of_eq (I := I) (I' := I) (I'' := J)
    (f := fun h : G => h * g) (g := fun h : G => h • x) (x := (1 : G))
    ((contMDiff_orbitMap x).mdifferentiable (by simp) g)
    mdifferentiableAt_mul_right (one_mul g) v
  have hcomp : (fun h : G => (h * g) • x) = (fun h : G => h • (g • x)) := by
    funext h
    exact mul_smul h g x
  change mfderiv I J (fun h : G => (h * g) • x) 1 v = _ at h
  rw [hcomp] at h
  exact h.symm

variable [CompleteSpace E] [BoundarylessManifold I G] [T2Space G]

set_option backward.isDefEq.respectTransparency false in
private theorem oneParameterCurve_mfderiv_zero (v : GroupLieAlgebra I G) :
    mfderiv 𝓘(ℝ, ℝ) I (oneParameterCurve v) 0 (1 : ℝ) = v := by
  have h := (oneParameterCurve_isMIntegralCurve v 0).mfderiv
  have he := congrArg (fun T => T (1 : ℝ)) h
  change mfderiv 𝓘(ℝ, ℝ) I (oneParameterCurve v) 0 (1 : ℝ) =
    (1 : ℝ) • mulInvariantVectorField v (oneParameterCurve v 0) at he
  rw [one_smul, oneParameterCurve_zero, mulInvariantVectorField_one] at he
  exact he

set_option backward.isDefEq.respectTransparency false in
private theorem oneParameterCurve_left_velocity_eq_right (v : GroupLieAlgebra I G) (t : ℝ) :
    mulInvariantVectorField v (oneParameterCurve v t) =
      mfderiv I I (fun h : G => h * oneParameterCurve v t) 1 v := by
  have hcomm : (fun s : ℝ => oneParameterCurve v t * oneParameterCurve v s) =
      (fun s : ℝ => oneParameterCurve v s * oneParameterCurve v t) := by
    funext s
    rw [← oneParameterCurve_add, ← oneParameterCurve_add, add_comm t s]
  have hl := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, ℝ)) (I' := I) (I'' := I)
    (f := oneParameterCurve v) (g := fun h : G => oneParameterCurve v t * h)
    (x := (0 : ℝ)) mdifferentiableAt_mul_left
    (oneParameterCurve_mdifferentiable v 0) (oneParameterCurve_zero v) (1 : ℝ)
  have hr := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, ℝ)) (I' := I) (I'' := I)
    (f := oneParameterCurve v) (g := fun h : G => h * oneParameterCurve v t)
    (x := (0 : ℝ)) mdifferentiableAt_mul_right
    (oneParameterCurve_mdifferentiable v 0) (oneParameterCurve_zero v) (1 : ℝ)
  simp only [oneParameterCurve_mfderiv_zero, Function.comp_def] at hl hr
  rw [hcomm] at hl
  exact hl.symm.trans hr

set_option backward.isDefEq.respectTransparency false in
omit [IsManifold J ∞ M] in
/-- Acting by the one-parameter subgroup gives a global integral curve of the
fundamental field through each point. In particular every fundamental field is complete. -/
theorem oneParameterCurve_smul_isMIntegralCurve (v : GroupLieAlgebra I G) (x : M) :
    IsMIntegralCurve (fun t => oneParameterCurve v t • x)
      (fundamentalVectorField (I := I) (J := J) v) := by
  intro t
  have hc := ((contMDiff_orbitMap (I := I) (J := J) x).mdifferentiable
    (by simp) (oneParameterCurve v t)).hasMFDerivAt.comp t
      (oneParameterCurve_isMIntegralCurve v t)
  simp only [ContinuousLinearMap.smulRight_one_eq_toSpanSingleton,
    ContinuousLinearMap.comp_toSpanSingleton, oneParameterCurve_left_velocity_eq_right,
    mfderiv_orbitMap_mul_right] at hc
  exact hc

omit [TopologicalSpace M] in
/-- The integral curve supplied by the action has the prescribed initial value. -/
@[simp] theorem oneParameterCurve_smul_zero (v : GroupLieAlgebra I G) (x : M) :
    oneParameterCurve v 0 • x = x := by simp

set_option backward.isDefEq.respectTransparency false in
omit [IsManifold J ∞ M] in
/-- Fundamental fields are precisely the positive-time velocities of action orbits. -/
theorem hasMFDerivAt_oneParameterCurve_smul_zero (v : GroupLieAlgebra I G) (x : M) :
    HasMFDerivAt 𝓘(ℝ, ℝ) J (fun t => oneParameterCurve v t • x) 0
      ((1 : ℝ →L[ℝ] ℝ).smulRight
        (fundamentalVectorField (I := I) (J := J) v x)) := by
  have h := oneParameterCurve_smul_isMIntegralCurve (I := I) (J := J) v x 0
  dsimp only at h
  rw [oneParameterCurve_zero, one_smul] at h
  exact h

end LieGroups

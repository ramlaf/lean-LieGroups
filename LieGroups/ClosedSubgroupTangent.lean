import LieGroups.SubgroupTangent

/-!
# The linear space of velocities in a subgroup

Multiplication of curves and scalar reparametrization show that ambient velocities in
any subgroup form a real vector subspace. Closedness is not needed for this assertion.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open scoped ContDiff Manifold

namespace LieGroups

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]

set_option backward.isDefEq.respectTransparency false in
/-- Multiplication of two curves in a subgroup adds their velocities at the identity. -/
theorem add_mem_subgroupTangentSet (K : Subgroup G)
    {v w : GroupLieAlgebra I G} (hv : v ∈ subgroupTangentSet (I := I) K)
    (hw : w ∈ subgroupTangentSet (I := I) K) :
    v + w ∈ subgroupTangentSet (I := I) K := by
  obtain ⟨γ, hγ0, hγK, hγ, hγv⟩ := hv
  obtain ⟨η, hη0, hηK, hη, hηw⟩ := hw
  refine ⟨fun t => γ t * η t, by simp [hγ0, hη0],
    fun t => K.mul_mem (hγK t) (hηK t),
    ((contMDiff_mul I ∞).mdifferentiableAt (by simp)).comp 0 (hγ.prodMk hη), ?_⟩
  have hm := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, ℝ)) (I' := I.prod I) (I'' := I)
    (x := (0 : ℝ)) (f := fun t => (γ t, η t)) (g := fun p : G × G => p.1 * p.2)
    ((contMDiff_mul I ∞).mdifferentiableAt (by simp)) (hγ.prodMk hη)
    (show (γ 0, η 0) = ((1 : G), 1) by simp [hγ0, hη0])
    ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)
  rw [mfderiv_prod_eq_add_apply ((contMDiff_mul I ∞).mdifferentiableAt (by simp)),
    mfderiv_prodMk hγ hη] at hm
  change _ = mfderiv I I (fun z : G => z * 1) 1
    (mfderiv 𝓘(ℝ, ℝ) I γ 0 ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)) +
    mfderiv I I (fun z : G => 1 * z) 1
    (mfderiv 𝓘(ℝ, ℝ) I η 0 ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)) at hm
  rw [show (fun z : G => z * 1) = id by funext z; exact mul_one z,
    show (fun z : G => 1 * z) = id by funext z; exact one_mul z, mfderiv_id] at hm
  let Dγ : ℝ →L[ℝ] E := mfderiv 𝓘(ℝ, ℝ) I γ 0
  let Dη : ℝ →L[ℝ] E := mfderiv 𝓘(ℝ, ℝ) I η 0
  let Dmul : ℝ →L[ℝ] E := mfderiv 𝓘(ℝ, ℝ) I (fun t => γ t * η t) 0
  have hm' : Dmul 1 = Dγ 1 + Dη 1 := hm
  have hγv' : Dγ 1 = v := hγv
  have hηw' : Dη 1 = w := hηw
  have hres : Dmul 1 = (v : E) + (w : E) := hm'.trans (congrArg₂ (· + ·) hγv' hηw')
  exact hres

omit [LieGroup I ∞ G] in
set_option backward.isDefEq.respectTransparency false in
/-- Scalar reparametrization multiplies an ambient subgroup velocity by the scalar. -/
theorem smul_mem_subgroupTangentSet (K : Subgroup G) (c : ℝ)
    {v : GroupLieAlgebra I G} (hv : v ∈ subgroupTangentSet (I := I) K) :
    c • v ∈ subgroupTangentSet (I := I) K := by
  obtain ⟨γ, hγ0, hγK, hγ, hγv⟩ := hv
  let f : ℝ → ℝ := fun t => c * t
  have hfd : HasDerivAt f c 0 := by
    simpa [f] using (hasDerivAt_id (0 : ℝ)).const_mul c
  have hf := hfd.differentiableAt.mdifferentiableAt
  have hzero : f 0 = 0 := by simp [f]
  refine ⟨γ ∘ f, by simp [f, hγ0], fun t => hγK (f t),
    hγ.comp_of_eq 0 hf hzero, ?_⟩
  have hcomp := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, ℝ)) (I' := 𝓘(ℝ, ℝ)) (I'' := I)
    (x := (0 : ℝ)) (f := f) (g := γ) hγ hf hzero
    ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)
  let Df : ℝ →L[ℝ] ℝ := mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, ℝ) f 0
  let Dγ : ℝ →L[ℝ] E := mfderiv 𝓘(ℝ, ℝ) I γ 0
  let Dcomp : ℝ →L[ℝ] E := mfderiv 𝓘(ℝ, ℝ) I (γ ∘ f) 0
  have hDf : Df = fderiv ℝ f 0 := mfderiv_eq_fderiv
  have hdf : Df 1 = c := by rw [hDf, fderiv_apply_one_eq_deriv]; exact hfd.deriv
  have hcomp' : Dcomp 1 = Dγ (Df 1) := hcomp
  have hγv' : Dγ 1 = v := hγv
  have hlin : Dγ c = c • Dγ 1 := by
    simpa only [smul_eq_mul, mul_one] using Dγ.map_smul c (1 : ℝ)
  have hres := (hcomp'.trans (congrArg Dγ hdf)).trans
    (hlin.trans (congrArg (fun x : E => c • x) hγv'))
  exact hres

/-- The vector subspace of velocities of ambient differentiable curves in a subgroup. -/
def subgroupTangentSubmodule (K : Subgroup G) : Submodule ℝ (GroupLieAlgebra I G) where
  carrier := subgroupTangentSet (I := I) K
  zero_mem' := zero_mem_subgroupTangentSet K
  add_mem' := add_mem_subgroupTangentSet K
  smul_mem' := smul_mem_subgroupTangentSet K

@[simp] theorem mem_subgroupTangentSubmodule (K : Subgroup G) (v : GroupLieAlgebra I G) :
    v ∈ subgroupTangentSubmodule (I := I) K ↔ v ∈ subgroupTangentSet (I := I) K := Iff.rfl

/-- Ambient subgroup velocities, expressed in the fixed normed model space. -/
noncomputable def subgroupTangentModel (K : Subgroup G) : Submodule ℝ E :=
  (subgroupTangentSubmodule (I := I) K).map
    (lieAlgebraModelEquiv (I := I) (G := G)).toLinearMap

/-- Membership in the model subspace is exactly ambient curve tangency. -/
theorem mem_subgroupTangentModel (K : Subgroup G) (x : E) :
    x ∈ subgroupTangentModel (I := I) K ↔
      (lieAlgebraModelEquiv (I := I) (G := G)).symm x ∈ subgroupTangentSet (I := I) K := by
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  change x ∈ (subgroupTangentSubmodule (I := I) K).map e.toLinearMap ↔ _
  constructor
  · rintro ⟨v, hv, h⟩
    change e v = x at h
    rw [← h, e.symm_apply_apply]
    exact hv
  · intro hx
    exact ⟨e.symm x, hx, e.apply_symm_apply x⟩

end LieGroups

/-!
# Exponential limits in closed subgroups

Integer powers of small exponentials recover every exponential in a limiting
direction. Closedness, rather than a supplied subgroup manifold, puts that limit
in the subgroup. This is the analytic ingredient of the closed-subgroup theorem.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open Filter Set
open scoped Topology ContDiff Manifold

namespace LieGroups

/-- Integer rounding approximates a fixed real number as the mesh tends to zero. -/
theorem tendsto_floor_div_mul {α : Type*} {l : Filter α} {c : α → ℝ}
    (hc : Tendsto c l (𝓝 0)) (hne : ∀ᶠ a in l, c a ≠ 0) (t : ℝ) :
    Tendsto (fun a => (⌊t / c a⌋ : ℝ) * c a) l (𝓝 t) := by
  have hbound : ∀ᶠ a in l, ‖(⌊t / c a⌋ : ℝ) * c a - t‖ ≤ ‖c a‖ := by
    filter_upwards [hne] with a ha
    have hfloor : |(⌊t / c a⌋ : ℝ) - t / c a| ≤ 1 := by
      rw [abs_le]
      constructor
      · have h := Int.lt_floor_add_one (t / c a); linarith
      · have h := Int.floor_le (t / c a); linarith
    have heq : (⌊t / c a⌋ : ℝ) * c a - t =
        ((⌊t / c a⌋ : ℝ) - t / c a) * c a := by field_simp
    rw [heq, norm_mul, Real.norm_eq_abs, Real.norm_eq_abs]
    exact (mul_le_mul_of_nonneg_right hfloor (abs_nonneg _)).trans_eq (one_mul _)
  have hz : Tendsto (fun a => (⌊t / c a⌋ : ℝ) * c a - t) l (𝓝 0) :=
    squeeze_zero_norm' hbound (by simpa using hc.norm)
  simpa using hz.add_const t

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [BoundarylessManifold I G] [T2Space G]

/-- The exponential is continuous in the actual tangent-space norm topology. -/
theorem continuous_lieExp : Continuous (lieExp (I := I) (G := G)) := by
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  have h := (lieExp_contMDiff_model (I := I) (G := G)).continuous.comp e.continuous
  change Continuous (fun v => lieExp (e.symm (e v))) at h
  simpa only [e.symm_apply_apply] using h

/-- Every limiting direction of small exponentials in a closed subgroup generates
a one-parameter subgroup in it. The scales may have either sign. -/
theorem lieExp_smul_mem_of_scaled_tendsto (K : Subgroup G) (hK : IsClosed (K : Set G))
    {α : Type*} {l : Filter α} [l.NeBot] {u : α → GroupLieAlgebra I G} {c : α → ℝ}
    {v : GroupLieAlgebra I G} (hc : Tendsto c l (𝓝 0))
    (hne : ∀ᶠ a in l, c a ≠ 0)
    (hv : Tendsto (fun a => (c a)⁻¹ • u a) l (𝓝 v))
    (hu : ∀ᶠ a in l, lieExp (u a) ∈ K) (t : ℝ) : lieExp (t • v) ∈ K := by
  have hscale := (tendsto_floor_div_mul hc hne t).smul hv
  have hvec : Tendsto (fun a => (⌊t / c a⌋ : ℝ) • u a) l (𝓝 (t • v)) := by
    apply hscale.congr'
    filter_upwards [hne] with a ha
    simp only [smul_smul, mul_assoc, mul_inv_cancel₀ ha, mul_one]
  apply hK.mem_of_tendsto (continuous_lieExp.continuousAt.tendsto.comp hvec)
  filter_upwards [hu] with a ha
  rw [Function.comp_apply, lieExp_int_smul]
  exact K.zpow_mem ha _

set_option backward.isDefEq.respectTransparency false in
/-- Every ambient curve velocity of a closed subgroup generates a one-parameter
subgroup in it, even when the witnessing curve is only differentiable at zero. -/
theorem lieExp_smul_mem_of_mem_subgroupTangentSet (K : Subgroup G)
    (hK : IsClosed (K : Set G)) {v : GroupLieAlgebra I G}
    (hv : v ∈ subgroupTangentSet (I := I) K) (t : ℝ) : lieExp (t • v) ∈ K := by
  obtain ⟨γ, hγ0, hγK, hγd, hγv⟩ := hv
  let e := lieAlgebraModelEquiv (I := I) (G := G)
  obtain ⟨φ, hφ0, hφ1, hφexp⟩ := exists_lieExp_localDiffeomorph_model (I := I) (G := G)
  change EqOn (fun w : E => lieExp (e.symm w)) φ φ.source at hφexp
  have h1 : (1 : G) ∈ φ.target := by rw [← hφ1]; exact φ.map_source hφ0
  have hlog0 : φ.toPartialEquiv.symm 1 = 0 := by
    rw [← hφ1]; exact φ.left_inv hφ0
  have hlogd : MDifferentiableAt I 𝓘(ℝ, E) φ.toPartialEquiv.symm 1 :=
    (φ.contMDiffOn_invFun.contMDiffAt (φ.open_target.mem_nhds h1)).mdifferentiableAt (by simp)
  have hline : (φ.toPartialEquiv.symm ∘ oneParameterCurve v) =ᶠ[𝓝 (0 : ℝ)]
      (fun s : ℝ => s • e v) := by
    have hnear : ∀ᶠ s in 𝓝 (0 : ℝ), s • e v ∈ φ.source :=
      (continuousAt_id.smul continuousAt_const).preimage_mem_nhds
        (by simpa using φ.open_source.mem_nhds hφ0)
    filter_upwards [hnear] with s hs
    have he : oneParameterCurve v s = φ (s • e v) := by
      rw [← lieExp_smul]
      simpa only [map_smul, e.symm_apply_apply] using hφexp hs
    change φ.toPartialEquiv.symm (oneParameterCurve v s) = s • e v
    rw [he]
    exact φ.left_inv hs
  have hld : HasDerivAt (φ.toPartialEquiv.symm ∘ oneParameterCurve v) (e v) 0 := by
    simpa only [one_smul] using
      ((hasDerivAt_id (0 : ℝ)).smul_const (e v)).congr_of_eventuallyEq hline
  have hlogv : mfderiv I 𝓘(ℝ, E) φ.toPartialEquiv.symm 1 v = e v := by
    have hc := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, ℝ)) (I' := I) (I'' := 𝓘(ℝ, E))
      (f := oneParameterCurve v) (g := φ.toPartialEquiv.symm) 0 hlogd
      (oneParameterCurve_mdifferentiable v 0) (oneParameterCurve_zero v)
        ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)
    have hδv : mfderiv 𝓘(ℝ, ℝ) I (oneParameterCurve v) 0
        ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1) = v := by
      rw [(oneParameterCurve_hasMFDerivAt_zero v).mfderiv]
      change (1 : ℝ) • v = v
      exact one_smul ℝ v
    rw [hδv] at hc
    have hh : mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, E)
        (φ.toPartialEquiv.symm ∘ oneParameterCurve v) 0
          ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1) = e v := by
      rw [hld.hasFDerivAt.hasMFDerivAt.mfderiv]
      change (1 : ℝ) • e v = e v
      exact one_smul ℝ (e v)
    exact hc.symm.trans hh
  have hlogγd : MDifferentiableAt 𝓘(ℝ, ℝ) 𝓘(ℝ, E)
      (φ.toPartialEquiv.symm ∘ γ) 0 := by
    apply MDifferentiableAt.comp 0 _ hγd
    rwa [hγ0]
  have hγlog : HasDerivAt (φ.toPartialEquiv.symm ∘ γ) (e v) 0 := by
    have hc := mfderiv_comp_apply_of_eq (I := 𝓘(ℝ, ℝ)) (I' := I) (I'' := 𝓘(ℝ, E))
      (f := γ) (g := φ.toPartialEquiv.symm) 0 hlogd hγd hγ0
        ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)
    rw [hγv, hlogv] at hc
    rw [← hc]
    exact hlogγd.hasMFDerivAt.hasFDerivAt.hasDerivAt
  have hslope : Tendsto (fun s : ℝ => s⁻¹ • φ.toPartialEquiv.symm (γ s))
      (𝓝[≠] 0) (𝓝 (e v)) := by
    simpa only [Function.comp_apply, zero_add, hγ0, hlog0, sub_zero] using
      hγlog.tendsto_slope_zero
  have hlimit : Tendsto (fun s : ℝ => s⁻¹ • e.symm (φ.toPartialEquiv.symm (γ s)))
      (𝓝[≠] 0) (𝓝 v) := by
    simpa only [Function.comp_def, map_smul, e.symm_apply_apply] using
      e.symm.continuous.continuousAt.tendsto.comp hslope
  apply lieExp_smul_mem_of_scaled_tendsto K hK
    (u := fun s : ℝ => e.symm (φ.toPartialEquiv.symm (γ s)))
    (c := id) (l := 𝓝[≠] (0 : ℝ)) (tendsto_id'.mpr nhdsWithin_le_nhds)
    (by filter_upwards [self_mem_nhdsWithin] with s hs; exact hs) hlimit _ t
  have hnear : ∀ᶠ s in 𝓝 (0 : ℝ), γ s ∈ φ.target :=
    hγd.continuousAt.preimage_mem_nhds (by rw [hγ0]; exact φ.open_target.mem_nhds h1)
  filter_upwards [hnear.filter_mono nhdsWithin_le_nhds] with s hs
  have he : lieExp (e.symm (φ.toPartialEquiv.symm (γ s))) =
      φ (φ.toPartialEquiv.symm (γ s)) := hφexp (φ.map_target hs)
  rw [φ.right_inv hs] at he
  change lieExp (e.symm (φ.toPartialEquiv.symm (γ s))) ∈ K
  rw [he]
  exact hγK s

end LieGroups

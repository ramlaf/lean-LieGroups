import LieGroups.ActionTangent
import LieGroups.FundamentalVectorField
import LieGroups.HomomorphismDifferential

/-!
# Adjoint covariance of the infinitesimal action

Differentiating the action law identifies tangent transport of a fundamental
field with the fundamental field of the adjoint-transformed Lie algebra vector.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-22.
-/

open scoped ContDiff Manifold

namespace LieGroups

variable {E F H H' G M : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H}
  [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace H']
  {J : ModelWithCorners ℝ F H'}
  [Group G] [TopologicalSpace G] [ChartedSpace H G] [LieGroup I ∞ G]
  [TopologicalSpace M] [ChartedSpace H' M] [MulAction G M]
  [ContMDiffSMul I J ∞ G M]

set_option backward.isDefEq.respectTransparency false in
/-- The orbit differential intertwines action tangent transport and the adjoint
action. This follows from the actual action law and conjugation derivatives. -/
theorem actionTangent_orbitLieDifferential (g : G) (x : M)
    (Y : GroupLieAlgebra I G) :
    actionTangent (J := J) g x (orbitLieDifferential (I := I) (J := J) x Y) =
      orbitLieDifferential (I := I) (J := J) (g • x) (lieAdjoint (I := I) g Y) := by
  have ha := (ContMDiffSMul.contMDiff_const_smul (I := I) (I' := J) (M := M) g).mdifferentiable
    (by simp : (∞ : ℕ∞ω) ≠ 0)
  have ho := (contMDiff_orbitMap (G := G) (I := I) (J := J) x).mdifferentiable (by simp)
  have ho' := (contMDiff_orbitMap (G := G) (I := I) (J := J) (g • x)).mdifferentiable (by simp)
  have hc := (contMDiff_conjugation (I := I) g).mdifferentiable (by simp)
  have hl := mfderiv_comp_apply_of_eq (I := I) (I' := J) (I'' := J)
    (f := fun h : G => h • x) (g := fun y : M => g • y) (x := (1 : G))
    (ha x) (ho 1) (one_smul G x) Y
  have hr := mfderiv_comp_apply_of_eq (I := I) (I' := I) (I'' := J)
    (f := fun h : G => (MulAut.conj g) h) (g := fun h : G => h • (g • x))
    (x := (1 : G)) (ho' 1) (hc 1) (map_one (MulAut.conj g)) Y
  have heq : (fun h : G => g • (h • x)) =
      (fun h : G => (MulAut.conj g) h • (g • x)) := by
    funext h
    simp only [MulAut.conj_apply, ← mul_smul]
    congr 1
    simp only [mul_assoc, inv_mul_cancel, mul_one]
  simp only [Function.comp_def] at hl hr
  rw [heq] at hl
  exact hl.symm.trans hr

/-- Equivalent covariance statement for fundamental fields. -/
theorem actionTangent_fundamentalVectorField (g : G) (x : M)
    (Y : GroupLieAlgebra I G) :
    actionTangent (J := J) g x (fundamentalVectorField (I := I) (J := J) Y x) =
      fundamentalVectorField (I := I) (J := J) (lieAdjoint (I := I) g Y) (g • x) :=
  actionTangent_orbitLieDifferential g x Y

end LieGroups

import BFRF.HomogeneousIsotropySubgroup
import LieGroups.EmbeddedSubgroupTangent

/-!
# Embedded Lie subgroup adapter for BFRF isotropy data

The ambient curve velocities in BFRF agree with the generic `LieGroups.subgroupTangentSet`.
For a supplied embedded Lie subgroup, the tangent-isotropy condition therefore identifies
its differential Lie subalgebra. Two connected finite-dimensional embedded presentations
with this condition have the same underlying subgroup.

This proves uniqueness under genuine embedded Lie subgroup hypotheses. It does not prove
BFRF's `UniqueConnectedIsotropySubgroup`, which quantifies over arbitrary connected abstract
subgroups without this regularity, and does not construct an integrating subgroup.

Run `python3 scripts/check_bfrf_compatibility.py` to check this optional module against the
actual sibling BFRF sources without adding a cyclic dependency to the core library.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

noncomputable section
open scoped Manifold ContDiff

namespace BFRF.Homogeneous

universe u

variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]
  {μ : Bracket (K × P)} {hjac : μ.Jacobi}

local instance bfrfSubgroupCompleteModel : CompleteSpace (K × P) :=
  FiniteDimensional.complete ℝ (K × P)
local instance bfrfSubgroupLEInfty : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

/-- BFRF's explicitly transported curve derivatives define exactly the generic ambient
curve tangent set. -/
theorem subgroupTangentSet_eq_generic (A : IntegratedLieGroup.{u} μ hjac)
    (S : Subgroup A.G) :
    subgroupTangentSet A S = LieGroups.subgroupTangentSet (I := 𝓘(ℝ, K × P)) S := by
  ext v
  exact (LieGroups.mem_subgroupTangentSet_iff_cast S v).symm

variable {A : IntegratedLieGroup.{u} μ hjac}
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  {L : Type*} [Group L] [TopologicalSpace L] [ChartedSpace F L]
  [LieGroup 𝓘(ℝ, F) ∞ L] [T2Space L]

/-- On an embedded Lie subgroup, BFRF's ambient-curve tangent-isotropy condition is precisely
the expected identity of Lie subalgebras under the chosen integration identification. -/
theorem hasIsotropyTangent_iff_lieAlgebra_eq [CompleteSpace F]
    (hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0)
    (S : LieGroups.EmbeddedLieSubgroup 𝓘(ℝ, K × P) A.G 𝓘(ℝ, F) L) :
    HasIsotropyTangent A hKK S.toImmersedLieSubgroup.subgroup ↔
      S.toImmersedLieSubgroup.lieAlgebra =
        (BracketLie.isotropy μ hjac hKK).comap A.lieEquiv.toLieHom := by
  unfold HasIsotropyTangent
  rw [subgroupTangentSet_eq_generic, S.subgroupTangentSet_eq_lieAlgebra]
  constructor
  · intro h
    ext v
    exact h v
  · intro h v
    change v ∈ S.toImmersedLieSubgroup.lieAlgebra ↔
      v ∈ (BracketLie.isotropy μ hjac hKK).comap A.lieEquiv.toLieHom
    rw [h]

variable [FiniteDimensional ℝ F]
  {D : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D] [FiniteDimensional ℝ D]
  {Q : Type*} [Group Q] [TopologicalSpace Q] [ChartedSpace D Q]
  [LieGroup 𝓘(ℝ, D) ∞ Q] [T2Space Q]

local instance bfrfSubgroupCompleteSource : CompleteSpace F := FiniteDimensional.complete ℝ F
local instance bfrfSubgroupCompleteOther : CompleteSpace D := FiniteDimensional.complete ℝ D

/-- Two connected embedded subgroup presentations satisfying BFRF's tangent-isotropy
condition have the same underlying subgroup. Their intrinsic model spaces may differ.
Connectedness is stated on the actual ambient subgroup sets, as in BFRF's interface. -/
theorem embeddedSubgroup_eq_of_hasIsotropyTangent [T2Space A.G]
    (hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0)
    (S : LieGroups.EmbeddedLieSubgroup 𝓘(ℝ, K × P) A.G 𝓘(ℝ, F) L)
    (T : LieGroups.EmbeddedLieSubgroup 𝓘(ℝ, K × P) A.G 𝓘(ℝ, D) Q)
    (hSconn : IsConnected (S.toImmersedLieSubgroup.subgroup : Set A.G))
    (hTconn : IsConnected (T.toImmersedLieSubgroup.subgroup : Set A.G))
    (hS : HasIsotropyTangent A hKK S.toImmersedLieSubgroup.subgroup)
    (hT : HasIsotropyTangent A hKK T.toImmersedLieSubgroup.subgroup) :
    S.toImmersedLieSubgroup.subgroup = T.toImmersedLieSubgroup.subgroup := by
  let : ConnectedSpace L := {
    isPreconnected_univ := S.isEmbedding.isInducing.isPreconnected_image.mp
      (by simpa only [Set.image_univ, LieGroups.ImmersedLieSubgroup.subgroup,
        MonoidHom.coe_range] using hSconn.isPreconnected)
    toNonempty := inferInstance }
  let : ConnectedSpace Q := {
    isPreconnected_univ := T.isEmbedding.isInducing.isPreconnected_image.mp
      (by simpa only [Set.image_univ, LieGroups.ImmersedLieSubgroup.subgroup,
        MonoidHom.coe_range] using hTconn.isPreconnected)
    toNonempty := inferInstance }
  exact S.toImmersedLieSubgroup.subgroup_eq_of_lieAlgebra_eq T.toImmersedLieSubgroup
    (((hasIsotropyTangent_iff_lieAlgebra_eq hKK S).mp hS).trans
      ((hasIsotropyTangent_iff_lieAlgebra_eq hKK T).mp hT).symm)

end BFRF.Homogeneous

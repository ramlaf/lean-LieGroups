import BFRF.HomomorphismLieAlgebra
import LieGroups.LieII

/-!
# Lie II for BFRF's prescribed integration interface

Lie II constructs BFRF's actual `IntegratedLieEquiv` for every prescribed
Lie-algebra equivalence between supplied simply connected integrating groups,
with its differential expressed in the chosen bracket coordinates. This
optional adapter is checked against the original BFRF sources.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open scoped Manifold ContDiff

namespace BFRF.Homogeneous

universe u
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E]

local instance bfrfLieIICompleteModel : CompleteSpace E := FiniteDimensional.complete ℝ E
local instance bfrfLieIILEInfty : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {μ ν : Bracket E} {hμ : μ.Jacobi} {hν : ν.Jacobi}
  {A : IntegratedLieGroup.{u} μ hμ} {B : IntegratedLieGroup.{u} ν hν}
  {e : BracketLie μ hμ ≃ₗ⁅ℝ⁆ BracketLie ν hν}

namespace IntegratedLieEquiv

/-- Express the constructed smooth integration in BFRF's prescribed
Lie-algebra coordinates, including its actual identity differential. -/
def ofLieEquivalenceIntegration
    (f : LieGroups.LieEquivalenceIntegration (A.lieEquiv.trans (e.trans B.lieEquiv.symm))) :
    IntegratedLieEquiv A B e := by
  let Φ : SmoothGroupEquiv A B := {
    toMulEquiv := f.toMulEquiv
    smooth_toFun := f.contMDiff_toFun
    smooth_invFun := f.contMDiff_invFun
  }
  refine ⟨Φ, ?_⟩
  intro v
  rw [SmoothGroupEquiv.derivAtOne_eq_homLieDifferential]
  change B.lieEquiv (LieGroups.homLieDifferential f.toMulEquiv.toMonoidHom v) = _
  rw [f.homLieDifferential_apply]
  simp only [LieEquiv.trans_apply, LieEquiv.apply_symm_apply]

end IntegratedLieEquiv

/-- Every prescribed Lie-algebra equivalence between the supplied simply
connected Hausdorff integrating groups has an actual smooth group integration.
No group equivalence or differential compatibility is an input. -/
theorem nonempty_integratedLieEquiv [T2Space A.G] [T2Space B.G]
    (e : BracketLie μ hμ ≃ₗ⁅ℝ⁆ BracketLie ν hν) :
    Nonempty (IntegratedLieEquiv A B e) := by
  obtain ⟨f⟩ := LieGroups.nonempty_lieEquivalenceIntegration
    (A.lieEquiv.trans (e.trans B.lieEquiv.symm))
  exact ⟨IntegratedLieEquiv.ofLieEquivalenceIntegration f⟩

/-- Choose the integration supplied by Lie II in the exact downstream record. -/
def integrateLieEquiv [T2Space A.G] [T2Space B.G]
    (e : BracketLie μ hμ ≃ₗ⁅ℝ⁆ BracketLie ν hν) : IntegratedLieEquiv A B e :=
  Classical.choice (nonempty_integratedLieEquiv e)

end BFRF.Homogeneous

import BFRF.LieIII
import BFRF.LieSubgroup
import LieGroups.ClosedLieSubalgebraIntegration
import LieGroups.ClosedLieSubgroup

/-!
# Closed-isotropy admissibility

The isotropy Lie subalgebra has a canonical connected immersed integration:
the subgroup generated by its exponentials in the chosen simply connected
integration. Admissibility asks precisely that this subgroup be closed. The
closed-image theorem then proves its ambient-curve tangent identity, so no
isotropy subgroup or geometric realization is supplied as an additional input.

Connected closed isotropy subgroups with this tangent identity are unique.
This does not claim uniqueness among arbitrary connected abstract subgroups.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-27.
-/

noncomputable section
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false

namespace BFRF.Homogeneous

universe u
variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]
  {μ : Bracket (K × P)} {hμ : μ.Jacobi}

local instance bfrfAdmissibleCompleteModel : CompleteSpace (K × P) :=
  FiniteDimensional.complete ℝ _
local instance bfrfAdmissibleLEInfty : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable (A : IntegratedLieGroup.{u} μ hμ)
  (hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0)

/-- The actual isotropy Lie subalgebra in the constructed group's tangent Lie algebra. -/
def isotropyLieSubalgebra : LieSubalgebra ℝ (GroupLieAlgebra 𝓘(ℝ, K × P) A.G) :=
  (BracketLie.isotropy μ hμ hKK).comap A.lieEquiv.toLieHom

variable [T2Space A.G]

/-- The canonical connected subgroup integrating the prescribed isotropy Lie algebra. -/
def canonicalIsotropySubgroup : Subgroup A.G :=
  LieGroups.lieSubalgebraSubgroup (isotropyLieSubalgebra A hKK)

/-- Closed-isotropy admissibility is the remaining global geometric condition. -/
def IsAdmissible : Prop := IsClosed (canonicalIsotropySubgroup A hKK : Set A.G)

/-- The canonical isotropy subgroup is connected before admissibility is imposed. -/
theorem canonicalIsotropySubgroup_connected :
    IsConnected (canonicalIsotropySubgroup A hKK : Set A.G) :=
  LieGroups.isConnected_lieSubalgebraSubgroup (isotropyLieSubalgebra A hKK)

/-- Admissibility identifies the canonical subgroup's actual ambient-curve tangent space. -/
theorem canonicalIsotropySubgroup_hasIsotropyTangent (hA : IsAdmissible A hKK) :
    HasIsotropyTangent A hKK (canonicalIsotropySubgroup A hKK) := by
  intro v
  rw [subgroupTangentSet_eq_generic, canonicalIsotropySubgroup,
    LieGroups.subgroupTangentSet_lieSubalgebraSubgroup_of_isClosed
      (isotropyLieSubalgebra A hKK) hA]
  rfl

/-- Closedness of canonical isotropy constructs the exact downstream isotropy record. -/
def integratedIsotropySubgroupOfAdmissible (hA : IsAdmissible A hKK) :
    IntegratedIsotropySubgroup A hKK where
  Kμ := canonicalIsotropySubgroup A hKK
  connected := canonicalIsotropySubgroup_connected A hKK
  closed := hA
  tangent_isotropy := canonicalIsotropySubgroup_hasIsotropyTangent A hKK hA

/-- Every connected closed isotropy subgroup is the canonical exponential-generated subgroup. -/
theorem canonicalIsotropySubgroup_eq_integrated (KA : IntegratedIsotropySubgroup A hKK) :
    canonicalIsotropySubgroup A hKK = KA.Kμ := by
  obtain ⟨C⟩ := LieGroups.nonempty_closedLieSubgroup
    (I := 𝓘(ℝ, K × P)) KA.Kμ KA.closed
  let : ConnectedSpace C.Carrier := isConnected_iff_connectedSpace.mp KA.connected
  have hLie : C.presentation.toImmersedLieSubgroup.lieAlgebra =
      isotropyLieSubalgebra A hKK := by
    ext v
    change v ∈ C.lieAlgebra ↔ A.lieEquiv v ∈ BracketLie.isotropy μ hμ hKK
    rw [C.mem_lieAlgebra, ← subgroupTangentSet_eq_generic A KA.Kμ]
    exact KA.tangent_isotropy v
  have h := C.presentation.toImmersedLieSubgroup.subgroup_eq_lieSubalgebraSubgroup
  rw [C.presentation_subgroup, hLie] at h
  exact h.symm

/-- Admissibility is equivalent to existence of the old downstream isotropy record. -/
theorem isAdmissible_iff_nonempty_integratedIsotropySubgroup :
    IsAdmissible A hKK ↔ Nonempty (IntegratedIsotropySubgroup A hKK) := by
  constructor
  · exact fun h => ⟨integratedIsotropySubgroupOfAdmissible A hKK h⟩
  · rintro ⟨KA⟩
    change IsClosed (canonicalIsotropySubgroup A hKK : Set A.G)
    rw [canonicalIsotropySubgroup_eq_integrated A hKK KA]
    exact KA.closed

/-- Connected closed isotropy records have the same underlying subgroup. -/
theorem integratedIsotropySubgroup_eq (KA KB : IntegratedIsotropySubgroup A hKK) :
    KA.Kμ = KB.Kμ := by
  rw [← canonicalIsotropySubgroup_eq_integrated A hKK KA,
    ← canonicalIsotropySubgroup_eq_integrated A hKK KB]

/-- The uniqueness theorem for ambient subgroups states closedness explicitly. -/
theorem closedSubgroup_eq_of_hasIsotropyTangent
    (H : Subgroup A.G) (hconn : IsConnected (H : Set A.G))
    (hclosed : IsClosed (H : Set A.G)) (htangent : HasIsotropyTangent A hKK H)
    (KA : IntegratedIsotropySubgroup A hKK) : H = KA.Kμ :=
  integratedIsotropySubgroup_eq A hKK
    ⟨H, hconn, hclosed, htangent⟩ KA

variable {ν : Bracket (K × P)} {hν : ν.Jacobi}
  {B : IntegratedLieGroup.{u} ν hν} [T2Space B.G]
  {e : BracketLie μ hμ ≃ₗ⁅ℝ⁆ BracketLie ν hν}
  {hKKB : ∀ k l : K, (ν.eval (k, 0) (l, 0)).2 = 0}

omit [T2Space A.G] in
/-- A smooth integrated Lie equivalence preserving isotropy Lie algebras
automatically carries the chosen closed isotropy groups onto one another. -/
theorem IntegratedLieEquiv.isotropyCompatible_of_isotropy_map
    (Φ : IntegratedLieEquiv A B e)
    (KA : IntegratedIsotropySubgroup A hKK)
    (KB : IntegratedIsotropySubgroup B hKKB)
    (he : (BracketLie.isotropy μ hμ hKK).map e.toLieHom =
      BracketLie.isotropy ν hν hKKB) : Φ.IsotropyCompatible KA KB :=
  integratedIsotropySubgroup_eq B hKKB (KA.map Φ he) KB

/-- Closed-isotropy admissibility transports across actual smooth integrated
Lie equivalences preserving the isotropy Lie subalgebra. -/
theorem IsAdmissible.map (hA : IsAdmissible A hKK)
    (Φ : IntegratedLieEquiv A B e)
    (he : (BracketLie.isotropy μ hμ hKK).map e.toLieHom =
      BracketLie.isotropy ν hν hKKB) : IsAdmissible B hKKB :=
  (isAdmissible_iff_nonempty_integratedIsotropySubgroup B hKKB).mpr
    ⟨(integratedIsotropySubgroupOfAdmissible A hKK hA).map Φ he⟩

end BFRF.Homogeneous

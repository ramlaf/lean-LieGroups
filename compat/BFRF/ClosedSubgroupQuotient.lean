import BFRF.HomogeneousQuotient
import BFRF.LieSubgroup
import LieGroups.ClosedLieSubgroup
import LieGroups.QuotientTangent

/-!
# Constructing BFRF homogeneous quotient realizations

Ordinary closed isotropy data now suffice for BFRF's actual quotient interface.
The subgroup atlas, quotient atlas, smooth action, tangent identification, and
smooth descent are all constructed by the generic Lie-group theorems.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open scoped Manifold ContDiff

namespace BFRF.Homogeneous

universe u
variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]
  {μ : Bracket (K × P)} {hμ : μ.Jacobi}
  {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
  {A : IntegratedLieGroup.{u} μ hμ}

local instance bfrfQuotientCompleteModel : CompleteSpace (K × P) :=
  FiniteDimensional.complete ℝ (K × P)
local instance bfrfQuotientLEInfty : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

/-- The quotient realization together with the local smooth sections and
Hausdorff topology supplied by the closed-subgroup construction. -/
structure RegularHomogeneousQuotientRealization
    (A : IntegratedLieGroup.{u} μ hμ) (KA : IntegratedIsotropySubgroup A hKK)
    extends HomogeneousQuotientRealization A KA where
  localSections : LieGroups.Manifold.HasContMDiffLocalSections
    𝓘(ℝ, K × P) 𝓘(ℝ, P) ∞ π
  [hausdorff : T2Space M]

attribute [instance] RegularHomogeneousQuotientRealization.hausdorff

private theorem exists_isotropy_complement
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
    [CompleteSpace F]
    {L : Type*} [Group L] [TopologicalSpace L] [ChartedSpace F L]
    [LieGroup 𝓘(ℝ, F) ∞ L]
    (S : LieGroups.ImmersedLieSubgroup 𝓘(ℝ, K × P) A.G 𝓘(ℝ, F) L)
    (hS : S.lieAlgebra = (BracketLie.isotropy μ hμ hKK).comap A.lieEquiv.toLieHom) :
    ∃ R : (P × F) ≃L[ℝ] (K × P),
      (∀ v, R (0, v) = LieGroups.Manifold.subgroupDifferentialModel S v) ∧
      ∀ p, (LieGroups.lieAlgebraModelEquiv (I := 𝓘(ℝ, K × P)) (G := A.G)).symm
        (R (p, 0)) = A.lieEquiv.symm (⟨(0, p)⟩ : BracketLie μ hμ) := by
  let e := LieGroups.lieAlgebraModelEquiv (I := 𝓘(ℝ, K × P)) (G := A.G)
  let f := LieGroups.lieAlgebraModelEquiv (I := 𝓘(ℝ, F)) (G := L)
  let B := LieGroups.Manifold.subgroupDifferentialModel S
  let D : (K × P) ≃L[ℝ] (K × P) :=
    ((e.symm.toLinearEquiv.trans A.lieEquiv.toLinearEquiv).trans
      (BracketLie.toLinearEquiv μ hμ)).toContinuousLinearEquiv
  have hB : Function.Injective B := e.injective.comp
    (S.homLieDifferential_injective.comp f.symm.injective)
  have hrange (y : K × P) : y ∈ LinearMap.range B.toLinearMap ↔ (D y).2 = 0 := by
    have hy : y ∈ LinearMap.range B.toLinearMap ↔ e.symm y ∈ S.lieAlgebra := by
      constructor
      · rintro ⟨v, hv⟩
        change B v = y at hv
        rw [← hv]
        refine ⟨f.symm v, ?_⟩
        change LieGroups.homLieDifferential S.toMonoidHom (f.symm v) =
          e.symm (e (LieGroups.homLieDifferential S.toMonoidHom (f.symm v)))
        exact (e.symm_apply_apply _).symm
      · rintro ⟨v, hv⟩
        refine ⟨f v, ?_⟩
        change e (LieGroups.homLieDifferential S.toMonoidHom (f.symm (f v))) = y
        change LieGroups.homLieDifferential S.toMonoidHom v = e.symm y at hv
        rw [f.symm_apply_apply, hv, e.apply_symm_apply]
    rw [hy, hS]
    rfl
  obtain ⟨R, hR, hRP⟩ := LieGroups.exists_transverse_equiv_of_range B hB D hrange
  refine ⟨R, hR, ?_⟩
  intro p
  rw [hRP]
  change e.symm (e (A.lieEquiv.symm (⟨(0, p)⟩ : BracketLie μ hμ))) = _
  exact e.symm_apply_apply _

/-- A closed isotropy subgroup in a Hausdorff finite-dimensional integrating group
constructs BFRF's full homogeneous quotient realization. -/
theorem nonempty_regularHomogeneousQuotientRealization [T2Space A.G]
    (KA : IntegratedIsotropySubgroup A hKK) :
    Nonempty (RegularHomogeneousQuotientRealization A KA) := by
  obtain ⟨C⟩ := LieGroups.nonempty_closedLieSubgroup
    (I := 𝓘(ℝ, K × P)) KA.Kμ KA.closed
  let : CompleteSpace (LieGroups.subgroupTangentModel (I := 𝓘(ℝ, K × P)) KA.Kμ) :=
    FiniteDimensional.complete ℝ _
  let S := C.presentation
  have hSsub : S.toImmersedLieSubgroup.subgroup = KA.Kμ := C.presentation_subgroup
  have ht : HasIsotropyTangent A hKK S.toImmersedLieSubgroup.subgroup := by
    rw [hSsub]
    exact KA.tangent_isotropy
  have hS := (hasIsotropyTangent_iff_lieAlgebra_eq hKK S).mp ht
  obtain ⟨R, hR, hRP⟩ := exists_isotropy_complement S.toImmersedLieSubgroup hS
  obtain ⟨B, hB1, hB0, hBsec, _⟩ :=
    LieGroups.Manifold.exists_quotientSlice_of_embeddedLieSubgroup_complement S R hR
  have hBsec0 : B.section_ 0 = 1 := by
    rw [hBsec]
    change LieGroups.lieExp
      ((LieGroups.lieAlgebraModelEquiv (I := 𝓘(ℝ, K × P)) (G := A.G)).symm (R 0)) = 1
    simp
  let Q := B.quotientAtlas hB1
  let : IsClosed (S.toImmersedLieSubgroup.subgroup : Set A.G) := by
    rw [hSsub]
    exact KA.closed
  refine ⟨{
    M := Q.Space
    π := Q.projection
    π_smooth := Q.contMDiff_projection
    π_surjective := Q.hasContMDiffLocalSections.surjective
    act := (· • ·)
    act_one := one_smul A.G
    act_mul := mul_smul
    act_smooth := contMDiff_smul
    π_equivariant := fun _ _ => rfl
    fibre_iff := ?_
    tangentEquiv := B.sectionTangentEquiv hB1 hB0 hBsec0
    dπ_tangent := ?_
    smooth_descend := fun f hf => Q.hasContMDiffLocalSections.contMDiff_of_comp hf
    localSections := Q.hasContMDiffLocalSections
    hausdorff := inferInstanceAs (T2Space (B.QuotientSpace hB1))
  }⟩
  · intro g₁ g₂
    change (QuotientGroup.mk g₁ : A.G ⧸ S.toImmersedLieSubgroup.subgroup) =
      QuotientGroup.mk g₂ ↔ g₂⁻¹ * g₁ ∈ KA.Kμ
    apply Iff.trans (eq_comm.trans QuotientGroup.eq)
    rw [hSsub]
  · intro p
    let T := (R : (P × LieGroups.subgroupTangentModel (I := 𝓘(ℝ, K × P)) KA.Kμ)
      →L[ℝ] (K × P)).comp (ContinuousLinearMap.inl ℝ P _)
    have h := B.mfderiv_projection_exp_section hB1 hB0 T hBsec hBsec0 p
    change mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) Q.projection 1
      ((LieGroups.lieAlgebraModelEquiv (I := 𝓘(ℝ, K × P)) (G := A.G)).symm
        (R (p, 0))) = _ at h
    rwa [hRP] at h

/-- A closed isotropy subgroup in a Hausdorff finite-dimensional integrating group
constructs BFRF's original homogeneous quotient interface. -/
theorem nonempty_homogeneousQuotientRealization [T2Space A.G]
    (KA : IntegratedIsotropySubgroup A hKK) :
    Nonempty (HomogeneousQuotientRealization A KA) := by
  obtain ⟨Q⟩ := nonempty_regularHomogeneousQuotientRealization KA
  exact ⟨Q.toHomogeneousQuotientRealization⟩

end BFRF.Homogeneous

import BFRF.IsotropyMetric

/-!
# Constructed global homogeneous realizations

A change of frame relabels the Lie-algebra identification of the original
simply connected integration. Transporting the actual closed isotropy subgroup
then gives compatible quotient manifolds and normalized invariant metrics at
every time. No uniqueness assertion about arbitrary connected subgroups is
needed: the target isotropy is the image of the initial isotropy.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-27.
-/

noncomputable section
open Set DifferentialGeometry
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false

namespace BFRF.Homogeneous

universe u
variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]

local instance globalCompleteModel : CompleteSpace (K × P) :=
  FiniteDimensional.complete ℝ _
local instance globalLEInfty : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

namespace IntegratedLieGroup

set_option maxHeartbeats 1000000 in
/-- Realize a transported bracket on the original simply connected Lie group,
with its Lie-algebra identification transported by the change of frame. -/
def blockTransport {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    (A : IntegratedLieGroup.{u} μ hμ) (hp : P ≃L[ℝ] P) :
    IntegratedLieGroup.{u} (Bracket.transport (blockChange hp).toLinearEquiv μ)
      (hμ.transport (blockChange hp).toLinearEquiv) where
  G := A.G
  lieEquiv := A.lieEquiv.trans (blockChangeLieEquiv μ hμ hp)

instance blockTransportT2Space {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    (A : IntegratedLieGroup.{u} μ hμ) [T2Space A.G] (hp : P ≃L[ℝ] P) :
    T2Space (A.blockTransport hp).G := inferInstanceAs (T2Space A.G)

set_option maxHeartbeats 1000000 in
/-- The identity smooth group map integrates the transported identification. -/
def integratedBlockTransport {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    (A : IntegratedLieGroup.{u} μ hμ) (hp : P ≃L[ℝ] P) :
    IntegratedBlockChange μ hμ hp A (A.blockTransport hp) where
  groupEquiv := {
    toMulEquiv := MulEquiv.refl A.G
    smooth_toFun := contMDiff_id
    smooth_invFun := contMDiff_id }
  deriv_compat := by
    intro v
    change (blockChangeLieEquiv μ hμ hp)
      (A.lieEquiv ((SmoothGroupEquiv.refl A).derivAtOne v)) = _
    rw [SmoothGroupEquiv.derivAtOne_refl]
    rfl

end IntegratedLieGroup

namespace IntegratedIsotropySubgroup

/-- Carry the initial isotropy along the identity integration of a block
change. Its closedness and connectedness are transported, not assumed anew. -/
def blockTransport {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ hμ}
    (KA : IntegratedIsotropySubgroup A hKK) (hp : P ≃L[ℝ] P) :
    IntegratedIsotropySubgroup (A.blockTransport hp)
      (BracketLie.isotropy_hKK_transport_blockChange μ hKK hp) :=
  KA.map (A.integratedBlockTransport hp)
    (BracketLie.isotropy_map_blockTransport μ hμ hKK hp)

@[simp] theorem blockTransport_subgroup {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ hμ}
    (KA : IntegratedIsotropySubgroup A hKK) (hp : P ≃L[ℝ] P) :
    (KA.blockTransport hp).Kμ = KA.Kμ := by
  change KA.Kμ.map (MonoidHom.id A.G) = KA.Kμ
  exact Subgroup.map_id _

end IntegratedIsotropySubgroup

namespace RegularHomogeneousQuotientRealization

set_option maxHeartbeats 1000000 in
/-- Coherently realize a transported bracket on the original quotient manifold.
Only its tangent identification changes, by the inverse frame change. In
particular the quotient carrier, atlas, projection, action, and local sections
are independent of time. -/
def blockTransport {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
    (QA : RegularHomogeneousQuotientRealization A KA) (hp : P ≃L[ℝ] P) :
    RegularHomogeneousQuotientRealization (A.blockTransport hp) (KA.blockTransport hp) := by
  have hd (X : P) :
      (A.blockTransport hp).lieEquiv.symm
        (⟨(0, X)⟩ : BracketLie
          (Bracket.transport (blockChange hp).toLinearEquiv μ)
          (hμ.transport (blockChange hp).toLinearEquiv)) =
      A.lieEquiv.symm (⟨(0, hp.symm X)⟩ : BracketLie μ hμ) := by
    apply (A.blockTransport hp).lieEquiv.injective
    rw [LieEquiv.coe_toLieHom, LieEquiv.apply_symm_apply]
    change _ = blockChangeLieEquiv μ hμ hp
      (A.lieEquiv (A.lieEquiv.symm (⟨(0, hp.symm X)⟩ : BracketLie μ hμ)))
    rw [LieEquiv.apply_symm_apply]
    apply (BracketLie.toLinearEquiv _ _).injective
    change (0, X) = (0, hp (hp.symm X))
    rw [hp.apply_symm_apply]
  exact {
    M := QA.M
    topology := QA.topology
    charted := QA.charted
    manifold := QA.manifold
    π := QA.π
    π_smooth := QA.π_smooth
    π_surjective := QA.π_surjective
    act := QA.act
    act_one := QA.act_one
    act_mul := QA.act_mul
    act_smooth := QA.act_smooth
    π_equivariant := QA.π_equivariant
    fibre_iff := by
      intro g h
      rw [IntegratedIsotropySubgroup.blockTransport_subgroup]
      exact QA.fibre_iff g h
    tangentEquiv := hp.symm.trans QA.tangentEquiv
    dπ_tangent := by
      intro X
      rw [hd]
      exact QA.dπ_tangent (hp.symm X)
    smooth_descend := QA.smooth_descend
    localSections := QA.localSections
    hausdorff := QA.hausdorff }

@[simp] theorem quotientDiffeomorph_blockTransport_apply
    {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
    (QA : RegularHomogeneousQuotientRealization A KA) (hp : P ≃L[ℝ] P)
    (x : QA.M) :
    quotientDiffeomorph QA.toHomogeneousQuotientRealization
      (QA.blockTransport hp).toHomogeneousQuotientRealization
      (A.integratedBlockTransport hp) (show
        (A.integratedBlockTransport hp).IsotropyCompatible KA (KA.blockTransport hp)
        from rfl) x = x := by
  obtain ⟨g, rfl⟩ := QA.π_surjective x
  exact quotientDiffeomorph_π _ _ _ _ g

/-- The quotient comparison as a map between the common quotient manifolds. -/
def blockTransportDiffeomorph
    {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
    (QA : RegularHomogeneousQuotientRealization A KA) (hp : P ≃L[ℝ] P) :
    QA.M ≃ₘ⟮𝓘(ℝ, P), 𝓘(ℝ, P)⟯ QA.M :=
  quotientDiffeomorph QA.toHomogeneousQuotientRealization
    (QA.blockTransport hp).toHomogeneousQuotientRealization
    (A.integratedBlockTransport hp) (show
      (A.integratedBlockTransport hp).IsotropyCompatible KA (KA.blockTransport hp)
      from rfl)

@[simp] theorem blockTransportDiffeomorph_apply
    {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
    (QA : RegularHomogeneousQuotientRealization A KA) (hp : P ≃L[ℝ] P)
    (x : QA.M) : QA.blockTransportDiffeomorph hp x = x :=
  QA.quotientDiffeomorph_blockTransport_apply hp x

/-- In the coherent quotient presentation the comparison maps are jointly
smooth in time and space, for every frame family: their common-carrier maps
are the identity. This statement does not identify distinct quotient types. -/
theorem contMDiff_blockTransportDiffeomorph
    {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
    (QA : RegularHomogeneousQuotientRealization A KA) (hp : ℝ → P ≃L[ℝ] P) :
    ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, P)) 𝓘(ℝ, P) ∞
      (fun tx : ℝ × QA.M => QA.blockTransportDiffeomorph (hp tx.1) tx.2) := by
  simpa only [QA.blockTransportDiffeomorph_apply] using
    (contMDiff_snd : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, P)) 𝓘(ℝ, P) ∞
      (fun tx : ℝ × QA.M => tx.2))

end RegularHomogeneousQuotientRealization

set_option maxHeartbeats 1000000 in
/-- Global quotient and metric data with actual isotropy compatibility.
The regular quotient retains its constructed local sections and Hausdorff
topology. Unlike `GlobalBFRealization`, this record makes no unrestricted
connected-subgroup uniqueness assumption. -/
structure ConstructedGlobalBFRealization (μ₀ : Bracket (K × P)) (hjac : μ₀.Jacobi)
    (hKK : ∀ k l : K, (μ₀.eval (k, 0) (l, 0)).2 = 0)
    (hp : ℝ → P ≃L[ℝ] P)
    {A : IntegratedLieGroup.{u} μ₀ hjac}
    {KA : IntegratedIsotropySubgroup A hKK}
    (QA : HomogeneousQuotientRealization A KA) (a b : ℝ) where
  B : ∀ t : Ioo a b, IntegratedLieGroup.{u}
    (Bracket.transport (blockChange (hp t.1)).toLinearEquiv μ₀)
    (hjac.transport (blockChange (hp t.1)).toLinearEquiv)
  groupT2 : ∀ t : Ioo a b, T2Space (B t).G
  KB : ∀ t : Ioo a b, IntegratedIsotropySubgroup (B t)
    (BracketLie.isotropy_hKK_transport_blockChange μ₀ hKK (hp t.1))
  regularQB : ∀ t : Ioo a b, RegularHomogeneousQuotientRealization (B t) (KB t)
  Φ : ∀ t : Ioo a b, IntegratedBlockChange μ₀ hjac (hp t.1) A (B t)
  isotropyCompatible : ∀ t : Ioo a b, (Φ t).IsotropyCompatible KA (KB t)
  targetMetric : ∀ t : Ioo a b,
    SmoothRiemannianMetric 𝓘(ℝ, P) (regularQB t).M
  target_invariant : ∀ t : Ioo a b,
    letI := (regularQB t).hausdorff
    (regularQB t).toHomogeneousQuotientRealization.IsInvariantMetric (targetMetric t)
  target_origin : ∀ t : Ioo a b, ∀ X Y : P,
    (targetMetric t).inner (regularQB t).toHomogeneousQuotientRealization.o
      ((regularQB t).tangentEquiv X) ((regularQB t).tangentEquiv Y) = inner ℝ X Y

namespace ConstructedGlobalBFRealization

variable {μ₀ : Bracket (K × P)} {hjac : μ₀.Jacobi}
  {hKK : ∀ k l : K, (μ₀.eval (k, 0) (l, 0)).2 = 0}
  {hp : ℝ → P ≃L[ℝ] P}
  {A : IntegratedLieGroup.{u} μ₀ hjac}
  {KA : IntegratedIsotropySubgroup A hKK}
  {QA : HomogeneousQuotientRealization A KA} {a b : ℝ}
  (R : ConstructedGlobalBFRealization μ₀ hjac hKK hp QA a b)

/-- The underlying BFRF quotient interface. -/
abbrev QB (t : Ioo a b) := (R.regularQB t).toHomogeneousQuotientRealization

/-- Hausdorffness is retained from the actual closed-subgroup quotient. -/
theorem t2 (t : Ioo a b) : T2Space (R.QB t).M := (R.regularQB t).hausdorff

/-- Lauret's equivariant diffeomorphism to the constructed target quotient. -/
def φ (t : Ioo a b) : QA.M ≃ₘ⟮𝓘(ℝ, P), 𝓘(ℝ, P)⟯ (R.QB t).M :=
  quotientDiffeomorph QA (R.QB t) (R.Φ t) (R.isotropyCompatible t)

@[simp] theorem φ_origin (t : Ioo a b) : R.φ t QA.o = (R.QB t).o :=
  quotientDiffeomorph_o QA (R.QB t) (R.Φ t) (R.isotropyCompatible t)

theorem φ_equivariant (t : Ioo a b) (g : A.G) (x : QA.M) :
    R.φ t (QA.act g x) =
      (R.QB t).act ((R.Φ t).groupEquiv.toMulEquiv g) (R.φ t x) :=
  quotientDiffeomorph_equivariant QA (R.QB t) (R.Φ t)
    (R.isotropyCompatible t) g x

theorem φ_mfderiv_origin (t : Ioo a b) (X : P) :
    (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) (R.φ t : QA.M → (R.QB t).M) QA.o)
      (QA.tangentEquiv X) = (R.QB t).tangentEquiv (hp t.1 X) :=
  IntegratedBlockChange.quotientDiffeomorph_mfderiv_o μ₀ hjac hKK (hp t.1)
    (R.Φ t) QA (R.QB t) (R.isotropyCompatible t) X

/-- The constructed normalized metric pulls back to any invariant metric with
the transported origin form. -/
theorem pullback_metric_eq [T2Space QA.M] (t : Ioo a b)
    (g : SmoothRiemannianMetric 𝓘(ℝ, P) QA.M) (hInv : QA.IsInvariantMetric g)
    (hOrigin : ∀ X Y : P,
      g.inner QA.o (QA.tangentEquiv X) (QA.tangentEquiv Y) =
        transportedMetric (hp t.1) X Y) :
    Diffeomorph.pullbackMetric (R.targetMetric t) (R.φ t) = g := by
  let := R.t2 t
  exact IntegratedBlockChange.quotientDiffeomorph_pullback_metric_eq
    μ₀ hjac hKK (hp t.1) (R.Φ t) QA (R.QB t) (R.isotropyCompatible t)
    g (R.targetMetric t) hInv (R.target_invariant t) hOrigin (R.target_origin t)

end ConstructedGlobalBFRealization

set_option maxHeartbeats 2000000 in
/-- Construct the global targets coherently on the original quotient carrier.
The actual quotient comparison maps are identity maps in this presentation;
the normalized tangent frames retain the prescribed block changes. -/
def coherentGlobalBFRealization
    {μ₀ : Bracket (K × P)} {hjac : μ₀.Jacobi}
    {hKK : ∀ k l : K, (μ₀.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ₀ hjac} [T2Space A.G]
    {KA : IntegratedIsotropySubgroup A hKK}
    (QA : RegularHomogeneousQuotientRealization A KA)
    (hp : ℝ → P ≃L[ℝ] P) {a b : ℝ}
    (hmetric : ∀ t ∈ Ioo a b,
      IsMetricIsotropy (Bracket.transport (blockChange (hp t)).toLinearEquiv μ₀)) :
    ConstructedGlobalBFRealization μ₀ hjac hKK hp
      QA.toHomogeneousQuotientRealization a b := by
  let Q := fun t : Ioo a b => QA.blockTransport (hp t.1)
  let g := fun t : Ioo a b =>
    (Q t).toHomogeneousQuotientRealization.riemannianMetric
      ((Q t).toHomogeneousQuotientRealization.originInner_isIsotropyInvariant
        (hmetric t.1 t.2)) (Q t).localSections
  exact {
    B := fun t => A.blockTransport (hp t.1)
    groupT2 := fun _ => inferInstanceAs (T2Space A.G)
    KB := fun t => KA.blockTransport (hp t.1)
    regularQB := Q
    Φ := fun t => A.integratedBlockTransport (hp t.1)
    isotropyCompatible := fun _ => rfl
    targetMetric := g
    target_invariant := fun t =>
      (Q t).toHomogeneousQuotientRealization.riemannianMetric_isInvariant _ _
    target_origin := fun t =>
      (Q t).toHomogeneousQuotientRealization.riemannianMetric_origin _ _ }

@[simp] theorem coherentGlobalBFRealization_φ_apply
    {μ₀ : Bracket (K × P)} {hjac : μ₀.Jacobi}
    {hKK : ∀ k l : K, (μ₀.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ₀ hjac} [T2Space A.G]
    {KA : IntegratedIsotropySubgroup A hKK}
    (QA : RegularHomogeneousQuotientRealization A KA)
    (hp : ℝ → P ≃L[ℝ] P) {a b : ℝ}
    (hmetric : ∀ t ∈ Ioo a b,
      IsMetricIsotropy (Bracket.transport (blockChange (hp t)).toLinearEquiv μ₀))
    (t : Ioo a b) (x : QA.M) :
    (coherentGlobalBFRealization QA hp hmetric).φ t x = x :=
  QA.quotientDiffeomorph_blockTransport_apply (hp t.1) x

set_option maxHeartbeats 2000000 in
/-- Construct every global target from the initial Hausdorff integration and
closed connected isotropy. Metric isotropy is the sole condition on the
transported brackets: target groups, isotropy, quotients, metrics, and descent
maps are outputs. -/
theorem nonempty_constructedGlobalBFRealization
    {μ₀ : Bracket (K × P)} {hjac : μ₀.Jacobi}
    {hKK : ∀ k l : K, (μ₀.eval (k, 0) (l, 0)).2 = 0}
    {A : IntegratedLieGroup.{u} μ₀ hjac} [T2Space A.G]
    {KA : IntegratedIsotropySubgroup A hKK}
    (QA : HomogeneousQuotientRealization A KA)
    (hp : ℝ → P ≃L[ℝ] P) {a b : ℝ}
    (hmetric : ∀ t ∈ Ioo a b,
      IsMetricIsotropy (Bracket.transport (blockChange (hp t)).toLinearEquiv μ₀)) :
    Nonempty (ConstructedGlobalBFRealization μ₀ hjac hKK hp QA a b) := by
  let B := fun t : Ioo a b => A.blockTransport (hp t.1)
  let Φ := fun t : Ioo a b => A.integratedBlockTransport (hp t.1)
  let KB := fun t : Ioo a b => KA.map (Φ t)
    (BracketLie.isotropy_map_blockTransport μ₀ hjac hKK (hp t.1))
  have hT2 (t : Ioo a b) : T2Space (B t).G := inferInstanceAs (T2Space A.G)
  have hTargets (t : Ioo a b) := by
    let := hT2 t
    exact HomogeneousQuotientRealization.exists_metric_fundamentalFields
      (A := B t) (KA := KB t) (hmetric t.1 t.2)
  choose Q g F hInv hvalue hOrigin hKilling hBracket using hTargets
  exact ⟨{
    B := B
    groupT2 := hT2
    KB := KB
    regularQB := Q
    Φ := Φ
    isotropyCompatible := fun _ => rfl
    targetMetric := g
    target_invariant := hInv
    target_origin := hOrigin }⟩

end BFRF.Homogeneous

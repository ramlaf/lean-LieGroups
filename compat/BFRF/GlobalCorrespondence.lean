/-- A genuine invariant Ricci flow determines the global BF–RF correspondence.
The fields, Killing equations, negative bracket identity, target integrations,
closed isotropy, quotient atlases, and target metrics are all constructed. -/
theorem homogeneous_global_bf_rf_of_invariant_ricci_flow
    (hred : PreservesTangent μ) (hmetric : IsMetricIsotropy μ)
    (QA : RegularHomogeneousQuotientRealization A KA)
    {D : RealTimeInterval}
    (S : SolutionOn (I := 𝓘(ℝ, P)) (M := QA.M) D)
    (hEq : MetricVariationEquationOn S)
    {a b t₀ : ℝ} (ht₀ : t₀ ∈ Ioo a b) (hreg : Ioo a b ⊆ D.regular)
    (hinitial : ∀ X Y : P,
      (S.family.metric t₀).inner QA.toHomogeneousQuotientRealization.o
        (QA.tangentEquiv X) (QA.tangentEquiv Y) = inner ℝ X Y)
    (hInv : ∀ t ∈ Ioo a b,
      QA.toHomogeneousQuotientRealization.IsInvariantMetric (S.family.metric t))
    (hR : ContinuousOn (fun t => basepointRicciOp (S.family.metric t)
      QA.toHomogeneousQuotientRealization.o QA.tangentEquiv.toLinearEquiv) (Ioo a b)) :
    Nonempty (GlobalBFRFCorrespondence QA S.family.metric a b t₀) := by
  have hKilling : ∀ t ∈ Ioo a b, ∀ v x (U V : TangentSpace 𝓘(ℝ, P) x),
      lieDerivMetric (S.family.metric t)
        (QA.toHomogeneousQuotientRealization.fundamentalFields v) x U V = 0 := by
    intro t ht v x U V
    exact QA.toHomogeneousQuotientRealization.lieDerivMetric_fundamentalFields_of_invariant
      (S.family.metric t) (hInv t ht) v x U V
  have hBF := isBracketFlowOnFixedRealization_of_metricVariationEquationOn
    μ hμ hKK hred hmetric S hEq QA.toHomogeneousQuotientRealization.o
    QA.tangentEquiv.toLinearEquiv QA.toHomogeneousQuotientRealization.fundamentalFields
    QA.toHomogeneousQuotientRealization.fundamentalFields_origin
    QA.toHomogeneousQuotientRealization.mlieBracket_fundamentalFields
    ht₀ hreg hinitial hKilling hR
  exact globalBFRFCorrespondence_of_bracketFlow
    hred hmetric QA S.family.metric ht₀ hR hInv hBF

set_option maxHeartbeats 4000000 in
/-- Closed-isotropy admissibility supplies the initial realization, and every
normalized invariant Ricci flow on it has constructed global BF–RF targets.
No integrating group, isotropy record, quotient, metric, fundamental field,
subgroup-uniqueness hypothesis, or smooth-descent hypothesis is supplied. -/
theorem lauret_global_bf_rf_of_admissible_bracket
    (μ : Bracket (K × P)) (hμ : μ.Jacobi)
    (hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0)
    (hred : PreservesTangent μ) (hmetric : IsMetricIsotropy μ)
    (hA : IsAdmissible (integratedLieGroup (μ := μ) (hμ := hμ)) hKK) :
    ∃ R : InitialHomogeneousRealization μ hμ hKK,
      ∀ {D : RealTimeInterval}
        (S : SolutionOn (I := 𝓘(ℝ, P)) (M := R.regularQA.M) D),
        MetricVariationEquationOn S →
        ∀ {a b t₀ : ℝ}, t₀ ∈ Ioo a b → Ioo a b ⊆ D.regular →
        (∀ X Y : P,
          (S.family.metric t₀).inner R.regularQA.toHomogeneousQuotientRealization.o
            (R.regularQA.tangentEquiv X) (R.regularQA.tangentEquiv Y) = inner ℝ X Y) →
        (∀ t ∈ Ioo a b,
          R.regularQA.toHomogeneousQuotientRealization.IsInvariantMetric (S.family.metric t)) →
        ContinuousOn (fun t => basepointRicciOp (S.family.metric t)
          R.regularQA.toHomogeneousQuotientRealization.o R.regularQA.tangentEquiv.toLinearEquiv)
          (Ioo a b) →
        Nonempty (GlobalBFRFCorrespondence R.regularQA S.family.metric a b t₀) := by
  obtain ⟨R⟩ := nonempty_initialHomogeneousRealization μ hμ hKK hmetric hA
  refine ⟨R, ?_⟩
  intro D S hEq a b t₀ ht₀ hreg hinitial hInv hR
  exact homogeneous_global_bf_rf_of_invariant_ricci_flow
    hred hmetric R.regularQA S hEq ht₀ hreg hinitial hInv hR

end BFRF.Homogeneous

/-- The fixed-realization equivalence uses the constructed fundamental fields;
no field evaluation or bracket identities are supplied. -/
theorem homogeneous_bf_rf_equivalence_on_constructed_quotient
    (hred : PreservesTangent μ) (hmetric : IsMetricIsotropy μ)
    (QA : RegularHomogeneousQuotientRealization A KA)
    (g : ℝ → SmoothRiemannianMetric 𝓘(ℝ, P) QA.M)
    {a b t₀ : ℝ} (ht₀ : t₀ ∈ Ioo a b)
    (hR : ContinuousOn (fun t => basepointRicciOp (g t)
      QA.toHomogeneousQuotientRealization.o QA.tangentEquiv.toLinearEquiv) (Ioo a b)) :
    IsRicciFlowOnFixedRealization g QA.toHomogeneousQuotientRealization.o
      QA.tangentEquiv.toLinearEquiv QA.toHomogeneousQuotientRealization.fundamentalFields
      a b t₀ ↔
    IsBracketFlowOnFixedRealization μ g QA.toHomogeneousQuotientRealization.o
      QA.tangentEquiv.toLinearEquiv QA.toHomogeneousQuotientRealization.fundamentalFields
      a b t₀ :=
  homogeneous_bf_rf_equivalence_on_fixed_realization μ hμ hKK hred hmetric
    g QA.toHomogeneousQuotientRealization.o QA.tangentEquiv.toLinearEquiv
    QA.toHomogeneousQuotientRealization.fundamentalFields
    QA.toHomogeneousQuotientRealization.fundamentalFields_origin
    QA.toHomogeneousQuotientRealization.mlieBracket_fundamentalFields ht₀ hR


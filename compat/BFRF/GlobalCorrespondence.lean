variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]

local instance correspondenceCompleteModel : CompleteSpace (K × P) :=
  FiniteDimensional.complete ℝ _
local instance correspondenceCompleteTangent : CompleteSpace P :=
  FiniteDimensional.complete ℝ _
local instance correspondenceLEInfty : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

/-- All initial geometric data, constructed from an admissible bracket. -/
structure InitialHomogeneousRealization (μ : Bracket (K × P)) (hμ : μ.Jacobi)
    (hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0) where
  A : IntegratedLieGroup.{0} μ hμ
  [groupT2 : T2Space A.G]
  KA : IntegratedIsotropySubgroup A hKK
  regularQA : RegularHomogeneousQuotientRealization A KA
  metric : SmoothRiemannianMetric 𝓘(ℝ, P) regularQA.M
  F : (K × P) →ₗ[ℝ]
    Cₛ^∞⟮𝓘(ℝ, P); P, (TangentSpace 𝓘(ℝ, P) : regularQA.M → Type _)⟯
  invariant : regularQA.toHomogeneousQuotientRealization.IsInvariantMetric metric
  field_origin : ∀ v, F v regularQA.toHomogeneousQuotientRealization.o =
    regularQA.tangentEquiv v.2
  metric_origin : ∀ X Y : P,
    metric.inner regularQA.toHomogeneousQuotientRealization.o
      (regularQA.tangentEquiv X) (regularQA.tangentEquiv Y) = inner ℝ X Y
  field_killing : ∀ v x (U V : TangentSpace 𝓘(ℝ, P) x),
    lieDerivMetric metric (F v) x U V = 0
  field_bracket : ∀ v w x,
    VectorField.mlieBracket 𝓘(ℝ, P) (F v) (F w) x = -F (μ.eval v w) x

attribute [instance] InitialHomogeneousRealization.groupT2

/-- The initial group, isotropy, quotient, metric, and fields all exist from
Jacobi, isotropy closure under brackets, metric isotropy, and closedness of the
canonical exponential-generated isotropy subgroup. -/
theorem nonempty_initialHomogeneousRealization
    (μ : Bracket (K × P)) (hμ : μ.Jacobi)
    (hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0)
    (hmetric : IsMetricIsotropy μ)
    (hA : IsAdmissible (integratedLieGroup (μ := μ) (hμ := hμ)) hKK) :
    Nonempty (InitialHomogeneousRealization μ hμ hKK) := by
  let A := integratedLieGroup (μ := μ) (hμ := hμ)
  let KA := integratedIsotropySubgroupOfAdmissible A hKK hA
  obtain ⟨QA, g, F, hInv, hvalue, hOrigin, hKilling, hBracket⟩ :=
    HomogeneousQuotientRealization.exists_metric_fundamentalFields
      (A := A) (KA := KA) hmetric
  exact ⟨{
    A := A
    groupT2 := inferInstance
    KA := KA
    regularQA := QA
    metric := g
    F := F
    invariant := hInv
    field_origin := hvalue
    metric_origin := hOrigin
    field_killing := hKilling
    field_bracket := hBracket }⟩

namespace InitialHomogeneousRealization

/-- An invariant metric with the prescribed origin normalization is the
constructed initial metric. -/
theorem eq_metric_of_invariant_normalized
    {μ : Bracket (K × P)} {hμ : μ.Jacobi}
    {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
    (R : InitialHomogeneousRealization μ hμ hKK)
    (g : SmoothRiemannianMetric 𝓘(ℝ, P) R.regularQA.M)
    (hInv : R.regularQA.toHomogeneousQuotientRealization.IsInvariantMetric g)
    (hOrigin : ∀ X Y : P,
      g.inner R.regularQA.toHomogeneousQuotientRealization.o
        (R.regularQA.tangentEquiv X) (R.regularQA.tangentEquiv Y) = inner ℝ X Y) :
    g = R.metric := by
  apply invariant_metric_eq_of_eq_at_origin R.regularQA.toHomogeneousQuotientRealization
    g R.metric hInv R.invariant
  intro v w
  obtain ⟨X, rfl⟩ := R.regularQA.tangentEquiv.surjective v
  obtain ⟨Y, rfl⟩ := R.regularQA.tangentEquiv.surjective w
  rw [hOrigin, R.metric_origin]

end InitialHomogeneousRealization

variable {μ : Bracket (K × P)} {hμ : μ.Jacobi}
  {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
  {A : IntegratedLieGroup.{u} μ hμ} [T2Space A.G]
  {KA : IntegratedIsotropySubgroup A hKK}

/-- The normalized finite-dimensional correspondence. Its global realization
is constructed below, rather than stored as supplied geometric data. -/
structure GlobalBFRFCorrespondence
    (QA : RegularHomogeneousQuotientRealization A KA)
    (g : ℝ → SmoothRiemannianMetric 𝓘(ℝ, P) QA.M) (a b t₀ : ℝ) where
  hp : ℝ → P ≃L[ℝ] P
  frame_initial : hp t₀ = ContinuousLinearEquiv.refl ℝ P
  invariant : ∀ t ∈ Ioo a b,
    QA.toHomogeneousQuotientRealization.IsInvariantMetric (g t)
  ricciFlow : IsRicciFlowOnFixedRealization g QA.toHomogeneousQuotientRealization.o
    QA.tangentEquiv.toLinearEquiv QA.toHomogeneousQuotientRealization.fundamentalFields a b t₀
  metric_origin : ∀ t ∈ Ioo a b, ∀ X Y : P,
    (g t).inner QA.toHomogeneousQuotientRealization.o
      (QA.tangentEquiv X) (QA.tangentEquiv Y) = transportedMetric (hp t) X Y
  ricci_conjugacy : ∀ t ∈ Ioo a b,
    ricciOp (Bracket.transport (blockChange (hp t)).toLinearEquiv μ) =
      (hp t).toLinearEquiv.conj
        (basepointRicciOp (g t) QA.toHomogeneousQuotientRealization.o
          QA.tangentEquiv.toLinearEquiv).toLinearMap
  frame_ode : ∀ t ∈ Ioo a b,
    HasDerivAt (fun s => (hp s).toContinuousLinearMap)
      (LinearMap.toContinuousLinearMap
        (-((ricciOp (Bracket.transport (blockChange (hp t)).toLinearEquiv μ)).comp
          (hp t).toLinearEquiv.toLinearMap))) t
  bracket_ode : ∀ t ∈ Ioo a b, ∀ v w : K × P,
    HasDerivAt (fun s => (Bracket.transport (blockChange (hp s)).toLinearEquiv μ).eval v w)
      (-((Bracket.pi
        (ricciBlock (Bracket.transport (blockChange (hp t)).toLinearEquiv μ))
        (Bracket.transport (blockChange (hp t)).toLinearEquiv μ)).eval v w)) t
  preservation : ∀ t ∈ Ioo a b,
    let ν := Bracket.transport (blockChange (hp t)).toLinearEquiv μ
    ν.Jacobi ∧ (∀ k l : K, (ν.eval (k, 0) (l, 0)).2 = 0) ∧
      PreservesTangent ν ∧ IsMetricIsotropy ν ∧
      (Function.Injective (isotropyAction μ) → Function.Injective (isotropyAction ν))

namespace GlobalBFRFCorrespondence

variable {QA : RegularHomogeneousQuotientRealization A KA}
  {g : ℝ → SmoothRiemannianMetric 𝓘(ℝ, P) QA.M} {a b t₀ : ℝ}
  (C : GlobalBFRFCorrespondence QA g a b t₀)

omit [T2Space A.G] in
/-- The transported brackets retain infinitesimal metric isotropy. -/
theorem metric_isotropy (t : ℝ) (ht : t ∈ Ioo a b) :
    IsMetricIsotropy (Bracket.transport (blockChange (C.hp t)).toLinearEquiv μ) :=
  (C.preservation t ht).2.2.2.1

omit [T2Space A.G] in
/-- The normalized frame also satisfies the equivalent right-composition ODE
in the fixed initial tangent frame. -/
theorem frame_ode_right (t : ℝ) (ht : t ∈ Ioo a b) :
    HasDerivAt (fun s => (C.hp s).toContinuousLinearMap)
      (-(C.hp t).toContinuousLinearMap.comp
        (basepointRicciOp (g t) QA.toHomogeneousQuotientRealization.o
          QA.tangentEquiv.toLinearEquiv)) t := by
  apply (C.frame_ode t ht).congr_deriv
  rw [C.ricci_conjugacy t ht]
  apply ContinuousLinearMap.ext
  intro X
  change -(C.hp t ((basepointRicciOp (g t) QA.toHomogeneousQuotientRealization.o
    QA.tangentEquiv.toLinearEquiv) ((C.hp t).symm (C.hp t X)))) = _
  rw [ContinuousLinearEquiv.symm_apply_apply]
  rfl

/-- All target groups, isotropy subgroups, quotients, and normalized metrics
are constructed coherently from the normalized frame. -/
def realization : ConstructedGlobalBFRealization μ hμ hKK C.hp
    QA.toHomogeneousQuotientRealization a b :=
  coherentGlobalBFRealization QA C.hp C.metric_isotropy

@[simp] theorem φ_origin (t : Ioo a b) :
    C.realization.φ t QA.toHomogeneousQuotientRealization.o = (C.realization.QB t).o :=
  C.realization.φ_origin t

theorem φ_equivariant (t : Ioo a b) (z : A.G) (x : QA.M) :
    C.realization.φ t (QA.act z x) =
      (C.realization.QB t).act ((C.realization.Φ t).groupEquiv.toMulEquiv z)
        (C.realization.φ t x) :=
  C.realization.φ_equivariant t z x

theorem φ_mfderiv_origin (t : Ioo a b) (X : P) :
    mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P)
      (C.realization.φ t : QA.M → (C.realization.QB t).M)
        QA.toHomogeneousQuotientRealization.o (QA.tangentEquiv X) =
      (C.realization.QB t).tangentEquiv (C.hp t.1 X) :=
  C.realization.φ_mfderiv_origin t X

/-- Lauret's metric pullback formula holds for the actually constructed targets. -/
theorem pullback_metric_eq (t : Ioo a b) :
    Diffeomorph.pullbackMetric (C.realization.targetMetric t) (C.realization.φ t) = g t.1 :=
  C.realization.pullback_metric_eq t (g t.1) (C.invariant t.1 t.2)
    (C.metric_origin t.1 t.2)

/-- On the coherent common carrier, the actual quotient comparison is the identity. -/
@[simp] theorem φ_apply (t : Ioo a b) (x : QA.M) : C.realization.φ t x = x :=
  coherentGlobalBFRealization_φ_apply QA C.hp C.metric_isotropy t x

/-- In the coherent common-carrier presentation, the target metric equals
the original Ricci-flow metric, so it inherits any time regularity of that family. -/
theorem targetMetric_eq (t : Ioo a b) : C.realization.targetMetric t = g t.1 := by
  have hφ : C.realization.φ t = _root_.Diffeomorph.refl 𝓘(ℝ, P) QA.M ∞ := by
    ext x
    exact C.φ_apply t x
  have h := C.pullback_metric_eq t
  rw [hφ, Diffeomorph.pullbackMetric_refl] at h
  exact h

/-- The total comparison family restricts to the actual quotient comparison
at every time in the flow interval. -/
theorem comparison_eq (t : Ioo a b) (x : QA.M) :
    QA.blockTransportDiffeomorph (C.hp t.1) x = C.realization.φ t x := by
  rw [QA.blockTransportDiffeomorph_apply, C.φ_apply]

omit [T2Space A.G] in
/-- The coherent comparison family is jointly smooth in time and space. -/
theorem contMDiff_comparison :
    ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, P)) 𝓘(ℝ, P) ∞
      (fun tx : ℝ × QA.M => QA.blockTransportDiffeomorph (C.hp tx.1) tx.2) :=
  QA.contMDiff_blockTransportDiffeomorph C.hp

end GlobalBFRFCorrespondence


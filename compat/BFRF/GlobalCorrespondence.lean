omit [T2Space A.G] in
/-- A normalized bracket-flow witness constructs every global target and all
classical comparison formulas on the original quotient carrier. -/
theorem globalBFRFCorrespondence_of_bracketFlow
    (hred : PreservesTangent μ) (hmetric : IsMetricIsotropy μ)
    (QA : RegularHomogeneousQuotientRealization A KA)
    (g : ℝ → SmoothRiemannianMetric 𝓘(ℝ, P) QA.M)
    {a b t₀ : ℝ} (ht₀ : t₀ ∈ Ioo a b)
    (hR : ContinuousOn (fun t => basepointRicciOp (g t)
      QA.toHomogeneousQuotientRealization.o QA.tangentEquiv.toLinearEquiv) (Ioo a b))
    (hInv : ∀ t ∈ Ioo a b,
      QA.toHomogeneousQuotientRealization.IsInvariantMetric (g t))
    (hBF : IsBracketFlowOnFixedRealization μ g QA.toHomogeneousQuotientRealization.o
      QA.tangentEquiv.toLinearEquiv QA.toHomogeneousQuotientRealization.fundamentalFields
      a b t₀) : Nonempty (GlobalBFRFCorrespondence QA g a b t₀) := by
  have hRF := (homogeneous_bf_rf_equivalence_on_constructed_quotient
    hred hmetric QA g ht₀ hR).mpr hBF
  obtain ⟨hp, h₀, hMetric, hRicci, hFrame, hBracket, _, hPreservation⟩ := hBF
  exact ⟨{
    hp := hp
    frame_initial := h₀
    invariant := hInv
    ricciFlow := hRF
    metric_origin := hMetric
    ricci_conjugacy := hRicci
    frame_ode := hFrame
    bracket_ode := hBracket
    preservation := hPreservation }⟩

set_option maxHeartbeats 3000000 in
/-- The base-point metric ODE and actual group invariance supply the global
BF–RF correspondence, with all fundamental fields and global targets constructed. -/
theorem homogeneous_global_bf_rf_of_invariant_basepoint_ricci_flow
    (hred : PreservesTangent μ) (hmetric : IsMetricIsotropy μ)
    (QA : RegularHomogeneousQuotientRealization A KA)
    (g : ℝ → SmoothRiemannianMetric 𝓘(ℝ, P) QA.M)
    {a b t₀ : ℝ} (ht₀ : t₀ ∈ Ioo a b)
    (hinitial : ∀ X Y : P,
      (g t₀).inner QA.toHomogeneousQuotientRealization.o
        (QA.tangentEquiv X) (QA.tangentEquiv Y) = inner ℝ X Y)
    (hInv : ∀ t ∈ Ioo a b,
      QA.toHomogeneousQuotientRealization.IsInvariantMetric (g t))
    (hR : ContinuousOn (fun t => basepointRicciOp (g t)
      QA.toHomogeneousQuotientRealization.o QA.tangentEquiv.toLinearEquiv) (Ioo a b))
    (hODE : ∀ t ∈ Ioo a b,
      HasDerivAt (fun s => basepointMetric (g s)
        QA.toHomogeneousQuotientRealization.o QA.tangentEquiv.toLinearEquiv)
        (metricLiftODE (basepointRicciOp (g t)
          QA.toHomogeneousQuotientRealization.o QA.tangentEquiv.toLinearEquiv)
          (basepointMetric (g t) QA.toHomogeneousQuotientRealization.o
            QA.tangentEquiv.toLinearEquiv)) t) :
    Nonempty (GlobalBFRFCorrespondence QA g a b t₀) := by
  have hRF : IsRicciFlowOnFixedRealization g QA.toHomogeneousQuotientRealization.o
      QA.tangentEquiv.toLinearEquiv QA.toHomogeneousQuotientRealization.fundamentalFields
      a b t₀ := by
    refine ⟨hinitial, ?_, hODE⟩
    intro t ht v x U V
    exact QA.toHomogeneousQuotientRealization.lieDerivMetric_fundamentalFields_of_invariant
      (g t) (hInv t ht) v x U V
  exact globalBFRFCorrespondence_of_bracketFlow hred hmetric QA g ht₀ hR hInv
    ((homogeneous_bf_rf_equivalence_on_constructed_quotient hred hmetric QA g ht₀ hR).mp hRF)


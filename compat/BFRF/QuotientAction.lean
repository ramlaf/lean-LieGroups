import BFRF.HomogeneousQuotient
import Mathlib.Geometry.Manifold.Algebra.SMul

/-!
# The smooth action carried by a BFRF quotient realization

The older quotient interface records the action and its laws as fields. These
named instances expose those same data to generic smooth-action constructions.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-22.
-/

noncomputable section
open scoped Manifold ContDiff

namespace BFRF.Homogeneous.HomogeneousQuotientRealization

universe u
variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]
  {μ : Bracket (K × P)} {hμ : μ.Jacobi}
  {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
  {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
  (Q : HomogeneousQuotientRealization A KA)

/-- The action already recorded by the realization. -/
abbrev mulAction : MulAction A.G Q.M where
  smul := Q.act
  one_smul := Q.act_one
  mul_smul := Q.act_mul

attribute [local instance] mulAction

/-- Joint smoothness of the recorded action. -/
theorem contMDiffSMul : ContMDiffSMul 𝓘(ℝ, K × P) 𝓘(ℝ, P) ∞ A.G Q.M :=
  ⟨Q.act_smooth⟩

@[simp] theorem smul_eq_act (g : A.G) (x : Q.M) : g • x = Q.act g x := rfl

/-- The orbit map at the origin is exactly the quotient projection. -/
@[simp] theorem smul_origin_eq_projection (g : A.G) : g • Q.o = Q.π g := by
  change Q.act g (Q.π 1) = Q.π g
  simpa using (Q.π_equivariant g 1).symm

/-- The action is transitive, as follows from surjectivity of the projection. -/
theorem isPretransitive : MulAction.IsPretransitive A.G Q.M where
  exists_smul_eq x y := by
    obtain ⟨g, rfl⟩ := Q.π_surjective x
    obtain ⟨h, rfl⟩ := Q.π_surjective y
    refine ⟨h * g⁻¹, ?_⟩
    change Q.act (h * g⁻¹) (Q.π g) = Q.π h
    rw [← Q.π_equivariant]
    simp

/-- The stabilizer of the distinguished origin is the supplied isotropy subgroup. -/
theorem stabilizer_iff (g : A.G) : g • Q.o = Q.o ↔ g ∈ KA.Kμ := by
  rw [Q.smul_origin_eq_projection]
  change Q.π g = Q.π 1 ↔ _
  simpa using Q.fibre_iff g 1

end BFRF.Homogeneous.HomogeneousQuotientRealization

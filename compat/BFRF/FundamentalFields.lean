import BFRF.QuotientAction
import BFRF.HomogeneousInvariantMetric
import LieGroups.FundamentalVectorFieldBracket
import LieGroups.FundamentalVectorFieldKilling

/-!
# Fundamental fields on BFRF homogeneous quotients

We construct the fields from the actual smooth action. The supplied identification
of the isotropy tangent shows that the whole origin evaluation is projection to
the `P` summand, including vanishing in isotropy directions.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-22.
-/

noncomputable section
open scoped Manifold ContDiff

namespace BFRF.Homogeneous.HomogeneousQuotientRealization

universe u
variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]
  {μ : Bracket (K × P)} {hμ : μ.Jacobi}
  {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
  {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
  (Q : HomogeneousQuotientRealization A KA)

local instance : CompleteSpace (K × P) := FiniteDimensional.complete ℝ (K × P)
local instance : CompleteSpace P := FiniteDimensional.complete ℝ P
local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩
local instance : MulAction A.G Q.M := Q.mulAction
local instance : ContMDiffSMul 𝓘(ℝ, K × P) 𝓘(ℝ, P) ∞ A.G Q.M := Q.contMDiffSMul

/-- The actual smooth fundamental fields, indexed by the original bracket space. -/
def fundamentalFields : (K × P) →ₗ[ℝ]
    Cₛ^∞⟮𝓘(ℝ, P); P, (TangentSpace 𝓘(ℝ, P) : Q.M → Type _)⟯ where
  toFun a := ⟨LieGroups.fundamentalVectorField (I := 𝓘(ℝ, K × P))
      (A.lieEquiv.symm ((BracketLie.toLinearEquiv μ hμ).symm a)),
    LieGroups.contMDiff_fundamentalVectorField _⟩
  map_add' a b := by
    ext x
    change LieGroups.fundamentalVectorField (I := 𝓘(ℝ, K × P)) (J := 𝓘(ℝ, P))
      (A.lieEquiv.symm ((BracketLie.toLinearEquiv μ hμ).symm (a + b))) x = _
    rw [map_add, map_add]
    exact LieGroups.fundamentalVectorField_add _ _ x
  map_smul' c a := by
    ext x
    change LieGroups.fundamentalVectorField (I := 𝓘(ℝ, K × P)) (J := 𝓘(ℝ, P))
      (A.lieEquiv.symm ((BracketLie.toLinearEquiv μ hμ).symm (c • a))) x =
      c • LieGroups.fundamentalVectorField (I := 𝓘(ℝ, K × P)) (J := 𝓘(ℝ, P))
        (A.lieEquiv.symm ((BracketLie.toLinearEquiv μ hμ).symm a)) x
    rw [map_smul, map_smul]
    exact LieGroups.fundamentalVectorField_smul c _ x

@[simp] theorem fundamentalFields_apply (a : K × P) (x : Q.M) :
    Q.fundamentalFields a x =
      LieGroups.fundamentalVectorField (I := 𝓘(ℝ, K × P))
        (A.lieEquiv.symm ((BracketLie.toLinearEquiv μ hμ).symm a)) x := rfl

/-- The quotient projection kills the velocities of curves inside isotropy. -/
theorem mfderiv_projection_eq_zero_of_subgroupTangent
    (v : GroupLieAlgebra 𝓘(ℝ, K × P) A.G)
    (hv : v ∈ subgroupTangentSet A KA.Kμ) :
    mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) Q.π 1 v = 0 := by
  obtain ⟨γ, hγ, hmem, hdiff, hderiv⟩ := hv
  have hconst : Q.π ∘ γ = fun _ : ℝ => Q.o := by
    funext t
    exact (Q.fibre_iff (γ t) 1).mpr (by simpa using hmem t)
  have hc := mfderiv_comp 0 (Q.π_smooth.mdifferentiableAt (by simp)) hdiff
  have he := congrArg (fun f => f ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)) hc
  rw [hconst, mfderiv_const] at he
  change (0 : TangentSpace 𝓘(ℝ, P) Q.o) =
    mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) Q.π (γ 0)
      (mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, K × P) γ 0
        ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)) at he
  change (hγ ▸ mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, K × P) γ 0)
    ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1) = v at hderiv
  have hcast (c : A.G) (hc : c = 1)
      (d : TangentSpace 𝓘(ℝ, ℝ) (0 : ℝ) →L[ℝ] TangentSpace 𝓘(ℝ, K × P) c) :
      mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) Q.π c
        (d ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)) =
      mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) Q.π 1
        ((hc ▸ d) ((NormedSpace.fromTangentSpace (0 : ℝ)).symm 1)) := by
    cases hc
    rfl
  rw [hcast (γ 0) hγ, hderiv] at he
  exact he.symm

/-- Every isotropy direction gives zero at the quotient origin. -/
@[simp] theorem fundamentalFields_isotropy_origin (k : K) :
    Q.fundamentalFields (k, 0) Q.o = 0 := by
  change mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) (fun g : A.G => g • Q.o) 1
    (A.lieEquiv.symm (⟨(k, 0)⟩ : BracketLie μ hμ)) = 0
  have horbit : (fun g : A.G => g • Q.o) = Q.π :=
    funext Q.smul_origin_eq_projection
  rw [horbit]
  apply Q.mfderiv_projection_eq_zero_of_subgroupTangent
  apply (KA.tangent_isotropy _).mpr
  simp only [LieEquiv.apply_symm_apply]
  rfl

/-- The origin evaluation of the constructed fields is the prescribed tangent
identification on the second summand. -/
@[simp] theorem fundamentalFields_origin (a : K × P) :
    Q.fundamentalFields a Q.o = Q.tangentEquiv a.2 := by
  have hsplit : a = (a.1, 0) + (0, a.2) := by ext <;> simp
  rw [hsplit, map_add]
  change Q.fundamentalFields (a.1, 0) Q.o +
    Q.fundamentalFields (0, a.2) Q.o = _
  rw [Q.fundamentalFields_isotropy_origin, zero_add]
  change mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) (fun g : A.G => g • Q.o) 1
    (A.lieEquiv.symm (⟨(0, a.2)⟩ : BracketLie μ hμ)) = _
  have horbit : (fun g : A.G => g • Q.o) = Q.π :=
    funext Q.smul_origin_eq_projection
  rw [horbit]
  change mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) Q.π 1
    (A.lieEquiv.symm (⟨(0, a.2)⟩ : BracketLie μ hμ)) = Q.tangentEquiv (0 + a.2)
  rw [zero_add]
  exact Q.dπ_tangent a.2

/-- The full orbit differential at the origin, with the integrated Lie algebra
identification applied to an arbitrary group tangent vector. -/
theorem orbitLieDifferential_origin
    (v : GroupLieAlgebra 𝓘(ℝ, K × P) A.G) :
    LieGroups.orbitLieDifferential (I := 𝓘(ℝ, K × P)) (J := 𝓘(ℝ, P)) Q.o v =
      Q.tangentEquiv (A.lieEquiv v).val.2 := by
  have h := Q.fundamentalFields_origin (A.lieEquiv v).val
  change LieGroups.orbitLieDifferential (I := 𝓘(ℝ, K × P)) (J := 𝓘(ℝ, P)) Q.o
    (A.lieEquiv.symm (A.lieEquiv v)) = _ at h
  simpa only [LieEquiv.symm_apply_apply] using h

/-- The projection differential is the second component under the integrated
Lie algebra identification, followed by the prescribed origin tangent map. -/
theorem mfderiv_projection_origin
    (v : GroupLieAlgebra 𝓘(ℝ, K × P) A.G) :
    mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) Q.π 1 v =
      Q.tangentEquiv (A.lieEquiv v).val.2 := by
  have h := Q.orbitLieDifferential_origin v
  change mfderiv 𝓘(ℝ, K × P) 𝓘(ℝ, P) (fun g : A.G => g • Q.o) 1 v = _ at h
  have horbit : (fun g : A.G => g • Q.o) = Q.π :=
    funext Q.smul_origin_eq_projection
  rwa [horbit] at h

/-- The constructed fields satisfy the negative bracket convention for a left
action with positive-time fundamental fields. -/
theorem mlieBracket_fundamentalFields (a b : K × P) (x : Q.M) :
    VectorField.mlieBracket 𝓘(ℝ, P)
      (Q.fundamentalFields a) (Q.fundamentalFields b) x =
      -Q.fundamentalFields (μ.eval a b) x := by
  have h := LieGroups.mlieBracket_fundamentalVectorField
    (I := 𝓘(ℝ, K × P)) (J := 𝓘(ℝ, P))
    (A.lieEquiv.symm ((BracketLie.toLinearEquiv μ hμ).symm a))
    (A.lieEquiv.symm ((BracketLie.toLinearEquiv μ hμ).symm b)) x
  change VectorField.mlieBracket 𝓘(ℝ, P)
    (Q.fundamentalFields a) (Q.fundamentalFields b) x = _ at h
  convert h using 1
  rw [← A.lieEquiv.symm.map_lie]
  rfl

/-- Fundamental fields of a preserved metric satisfy the Killing equation. -/
theorem lieDerivMetric_fundamentalFields_eq_zero [T2Space A.G] [T2Space Q.M]
    (g : DifferentialGeometry.SmoothRiemannianMetric 𝓘(ℝ, P) Q.M)
    (hg : ∀ (a : A.G) (x : Q.M) (v w : TangentSpace 𝓘(ℝ, P) x),
      g.inner (Q.act a x) (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) (Q.act a) x v)
        (mfderiv 𝓘(ℝ, P) 𝓘(ℝ, P) (Q.act a) x w) = g.inner x v w)
    (a : K × P) (x : Q.M) (v w : TangentSpace 𝓘(ℝ, P) x) :
    DifferentialGeometry.PDE.DeTurck.lieDerivMetric g
      (Q.fundamentalFields a) x v w = 0 :=
  LieGroups.lieDerivMetric_fundamentalVectorField_eq_zero g hg
    (A.lieEquiv.symm ((BracketLie.toLinearEquiv μ hμ).symm a)) x v w

/-- BFRF's pullback formulation of invariance gives the Killing input required by
the homogeneous geometric Ricci calculations. -/
theorem lieDerivMetric_fundamentalFields_of_invariant [T2Space A.G] [T2Space Q.M]
    (g : DifferentialGeometry.SmoothRiemannianMetric 𝓘(ℝ, P) Q.M)
    (hg : Q.IsInvariantMetric g)
    (a : K × P) (x : Q.M) (v w : TangentSpace 𝓘(ℝ, P) x) :
    DifferentialGeometry.PDE.DeTurck.lieDerivMetric g
      (Q.fundamentalFields a) x v w = 0 := by
  apply Q.lieDerivMetric_fundamentalFields_eq_zero g
  intro b y u z
  have h := congrArg (fun m : DifferentialGeometry.SmoothRiemannianMetric 𝓘(ℝ, P) Q.M =>
    m.inner y u z) (hg b)
  rw [DifferentialGeometry.Diffeomorph.pullbackMetric_inner] at h
  exact h

end BFRF.Homogeneous.HomogeneousQuotientRealization

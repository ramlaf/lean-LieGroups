import BFRF.HomogeneousLieGroupIntegration
import LieGroups.HomomorphismLieAlgebra

/-!
# Differentiation adapter for BFRF integration data

This optional downstream module imports the actual BFRF integration structures. It is
kept outside the core library to avoid a dependency cycle. Run
`python3 scripts/check_bfrf_compatibility.py` to compile it against the sibling BFRF
checkout and the current LieGroups library.

A supplied smooth group equivalence induces a Lie algebra equivalence under the chosen
identifications. The adapter constructs `IntegratedLieEquiv` for this induced equivalence.
For a separately prescribed equivalence, an equality with the induced one is still required;
no Lie II existence theorem is asserted.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-16.
-/

noncomputable section
open scoped Manifold ContDiff

namespace BFRF.Homogeneous

universe u
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E]

local instance bfrfDifferentialCompleteModel : CompleteSpace E := FiniteDimensional.complete ℝ E
local instance bfrfDifferentialLEInfty : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable {μ ν ξ : Bracket E} {hμ : μ.Jacobi} {hν : ν.Jacobi} {hξ : ξ.Jacobi}
  {A : IntegratedLieGroup.{u} μ hμ} {B : IntegratedLieGroup.{u} ν hν}
  {C : IntegratedLieGroup.{u} ξ hξ}

namespace SmoothGroupEquiv

/-- The explicit identity-tangent-space cast agrees with the reusable differential. -/
theorem derivAtOne_eq_homLieDifferential (Φ : SmoothGroupEquiv A B) :
    Φ.derivAtOne = LieGroups.homLieDifferential
      (I := 𝓘(ℝ, E)) (J := 𝓘(ℝ, E)) Φ.toMulEquiv.toMonoidHom := by
  have hcast (y : B.G) (hy : y = 1)
      (T : GroupLieAlgebra 𝓘(ℝ, E) A.G →L[ℝ] TangentSpace 𝓘(ℝ, E) y) :
      (hy ▸ T : GroupLieAlgebra 𝓘(ℝ, E) A.G →L[ℝ] GroupLieAlgebra 𝓘(ℝ, E) B.G) = T := by
    cases hy
    rfl
  exact hcast _ Φ.toMulEquiv.map_one _

/-- The Lie equivalence induced by a supplied smooth group equivalence, expressed
using the chosen bracket-algebra identifications. -/
def inducedLieEquiv (Φ : SmoothGroupEquiv A B) :
    BracketLie μ hμ ≃ₗ⁅ℝ⁆ BracketLie ν hν :=
  LieGroups.coordinateLieEquiv Φ.toMulEquiv Φ.smooth_toFun Φ.smooth_invFun
    A.lieEquiv B.lieEquiv

@[simp] theorem inducedLieEquiv_apply (Φ : SmoothGroupEquiv A B)
    (x : BracketLie μ hμ) :
    Φ.inducedLieEquiv x = B.lieEquiv (Φ.derivAtOne (A.lieEquiv.symm x)) := by
  rw [derivAtOne_eq_homLieDifferential]
  rfl

/-- The induced Lie equivalence automatically satisfies BFRF's differential compatibility. -/
theorem inducedLieEquiv_compat (Φ : SmoothGroupEquiv A B)
    (v : GroupLieAlgebra 𝓘(ℝ, E) A.G) :
    B.lieEquiv (Φ.derivAtOne v) = Φ.inducedLieEquiv (A.lieEquiv v) := by
  rw [inducedLieEquiv_apply, LieEquiv.symm_apply_apply]

@[simp] theorem inducedLieEquiv_refl (A : IntegratedLieGroup.{u} μ hμ) :
    (refl A).inducedLieEquiv = LieEquiv.refl := by
  ext x
  simp only [inducedLieEquiv_apply, derivAtOne_refl, ContinuousLinearMap.id_apply,
    LieEquiv.apply_symm_apply, LieEquiv.refl_apply]

@[simp] theorem inducedLieEquiv_symm (Φ : SmoothGroupEquiv A B) :
    Φ.symm.inducedLieEquiv = Φ.inducedLieEquiv.symm := by
  apply LieEquiv.ext
  intro x
  apply Φ.inducedLieEquiv.injective
  change Φ.inducedLieEquiv (Φ.symm.inducedLieEquiv x) =
    Φ.inducedLieEquiv (Φ.inducedLieEquiv.symm x)
  simp only [LieEquiv.apply_symm_apply, inducedLieEquiv_apply, LieEquiv.symm_apply_apply]
  have h := congrArg (fun T : GroupLieAlgebra 𝓘(ℝ, E) B.G →L[ℝ]
      GroupLieAlgebra 𝓘(ℝ, E) B.G => T (B.lieEquiv.symm x)) (derivAtOne_comp_symm Φ)
  change Φ.derivAtOne (Φ.symm.derivAtOne (B.lieEquiv.symm x)) = B.lieEquiv.symm x at h
  rw [h, LieEquiv.apply_symm_apply]

theorem inducedLieEquiv_trans (Φ : SmoothGroupEquiv A B) (Ψ : SmoothGroupEquiv B C) :
    (Φ.trans Ψ).inducedLieEquiv = Φ.inducedLieEquiv.trans Ψ.inducedLieEquiv := by
  ext x
  simp only [inducedLieEquiv_apply, derivAtOne_trans, ContinuousLinearMap.comp_apply,
    LieEquiv.trans_apply, LieEquiv.symm_apply_apply]

/-- Compatibility with a prescribed equivalence is exactly equality with the induced one. -/
theorem inducedLieEquiv_eq_iff (Φ : SmoothGroupEquiv A B)
    (e : BracketLie μ hμ ≃ₗ⁅ℝ⁆ BracketLie ν hν) :
    Φ.inducedLieEquiv = e ↔ ∀ v : GroupLieAlgebra 𝓘(ℝ, E) A.G,
      B.lieEquiv (Φ.derivAtOne v) = e (A.lieEquiv v) := by
  simp only [derivAtOne_eq_homLieDifferential]
  exact LieGroups.coordinateLieEquiv_eq_iff Φ.toMulEquiv Φ.smooth_toFun Φ.smooth_invFun
    A.lieEquiv B.lieEquiv e

end SmoothGroupEquiv

namespace IntegratedLieEquiv

/-- Every supplied smooth group equivalence integrates its induced Lie equivalence. -/
def ofSmoothGroupEquiv (Φ : SmoothGroupEquiv A B) :
    IntegratedLieEquiv A B Φ.inducedLieEquiv where
  groupEquiv := Φ
  deriv_compat := Φ.inducedLieEquiv_compat

/-- Construct integration data for a prescribed equivalence after identifying its differential. -/
def ofInducedLieEquivEq (Φ : SmoothGroupEquiv A B)
    (e : BracketLie μ hμ ≃ₗ⁅ℝ⁆ BracketLie ν hν) (he : Φ.inducedLieEquiv = e) :
    IntegratedLieEquiv A B e where
  groupEquiv := Φ
  deriv_compat := (Φ.inducedLieEquiv_eq_iff e).mp he

/-- Existing integration data determine the prescribed Lie equivalence uniquely. -/
theorem inducedLieEquiv_eq {e : BracketLie μ hμ ≃ₗ⁅ℝ⁆ BracketLie ν hν}
    (Φ : IntegratedLieEquiv A B e) : Φ.groupEquiv.inducedLieEquiv = e :=
  (Φ.groupEquiv.inducedLieEquiv_eq_iff e).mpr Φ.deriv_compat

end IntegratedLieEquiv

end BFRF.Homogeneous

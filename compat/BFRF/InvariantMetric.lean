import BFRF.ClosedSubgroupQuotient
import BFRF.HomogeneousInvariantMetric
import BFRF.QuotientAction
import LieGroups.HomogeneousMetricSmooth

/-!
# Constructing the normalized metric on a BFRF quotient

The closed-subgroup quotient retains its actual smooth local sections. Once the
origin inner product is invariant under isotropy, the generic homogeneous metric
construction supplies BFRF's smooth invariant metric and its normalization.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-22.
-/

noncomputable section
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false

namespace BFRF.Homogeneous.HomogeneousQuotientRealization

universe u
variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]
  {μ : Bracket (K × P)} {hμ : μ.Jacobi}
  {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
  {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
  (Q : HomogeneousQuotientRealization A KA)

local instance bfrfMetricMulAction : MulAction A.G Q.M := Q.mulAction
local instance bfrfMetricSmoothAction :
    ContMDiffSMul 𝓘(ℝ, K × P) 𝓘(ℝ, P) ∞ A.G Q.M := Q.contMDiffSMul
local instance bfrfMetricPretransitive : MulAction.IsPretransitive A.G Q.M := Q.isPretransitive

/-- The prescribed inner product at the origin, transported by the tangent
identification already present in BFRF's quotient interface. -/
def originInner : TangentSpace 𝓘(ℝ, P) Q.o →L[ℝ]
    TangentSpace 𝓘(ℝ, P) Q.o →L[ℝ] ℝ :=
  (ContinuousLinearMap.precomp ℝ Q.tangentEquiv.symm.toContinuousLinearMap).comp
    ((innerSL ℝ).comp Q.tangentEquiv.symm.toContinuousLinearMap)

@[simp] theorem originInner_apply (v w : TangentSpace 𝓘(ℝ, P) Q.o) :
    Q.originInner v w = inner ℝ (Q.tangentEquiv.symm v) (Q.tangentEquiv.symm w) := rfl

@[simp] theorem originInner_tangentEquiv (X Y : P) :
    Q.originInner (Q.tangentEquiv X) (Q.tangentEquiv Y) = inner ℝ X Y := by
  change inner ℝ (Q.tangentEquiv.symm (Q.tangentEquiv X))
    (Q.tangentEquiv.symm (Q.tangentEquiv Y)) = _
  simp only [ContinuousLinearEquiv.symm_apply_apply]

theorem originInner_symm (v w : TangentSpace 𝓘(ℝ, P) Q.o) :
    Q.originInner v w = Q.originInner w v := real_inner_comm _ _

theorem originInner_pos (v : TangentSpace 𝓘(ℝ, P) Q.o) (hv : v ≠ 0) :
    0 < Q.originInner v v := by
  rw [Q.originInner_apply]
  exact real_inner_self_pos.mpr (Q.tangentEquiv.symm.map_ne_zero_iff.mpr hv)

variable [T2Space Q.M]

/-- Construct the smooth invariant metric from the normalized origin form and
the quotient's actual smooth local sections. -/
def riemannianMetric
    (hB : LieGroups.IsIsotropyInvariant (G := A.G) Q.o Q.originInner)
    (hsections : LieGroups.Manifold.HasContMDiffLocalSections
      𝓘(ℝ, K × P) 𝓘(ℝ, P) ∞ Q.π) :
    DifferentialGeometry.SmoothRiemannianMetric 𝓘(ℝ, P) Q.M :=
  LieGroups.homogeneousRiemannianMetric (I := 𝓘(ℝ, K × P)) Q.o Q.originInner hB
    Q.originInner_symm Q.originInner_pos (by
      simpa only [Q.smul_origin_eq_projection] using hsections)

@[simp] theorem riemannianMetric_origin
    (hB : LieGroups.IsIsotropyInvariant (G := A.G) Q.o Q.originInner)
    (hsections : LieGroups.Manifold.HasContMDiffLocalSections
      𝓘(ℝ, K × P) 𝓘(ℝ, P) ∞ Q.π) (X Y : P) :
    (Q.riemannianMetric hB hsections).inner Q.o
      (Q.tangentEquiv X) (Q.tangentEquiv Y) = inner ℝ X Y := by
  exact (LieGroups.homogeneousRiemannianMetric_origin (I := 𝓘(ℝ, K × P)) Q.o
    Q.originInner hB Q.originInner_symm Q.originInner_pos
    (by simpa only [Q.smul_origin_eq_projection] using hsections)
    (Q.tangentEquiv X) (Q.tangentEquiv Y)).trans (Q.originInner_tangentEquiv X Y)

/-- The constructed metric satisfies BFRF's pullback formulation of invariance. -/
theorem riemannianMetric_isInvariant
    (hB : LieGroups.IsIsotropyInvariant (G := A.G) Q.o Q.originInner)
    (hsections : LieGroups.Manifold.HasContMDiffLocalSections
      𝓘(ℝ, K × P) 𝓘(ℝ, P) ∞ Q.π) :
    Q.IsInvariantMetric (Q.riemannianMetric hB hsections) := by
  intro a
  apply DifferentialGeometry.SmoothRiemannianMetric.ext_inner
  intro x v w
  rw [DifferentialGeometry.Diffeomorph.pullbackMetric_inner]
  exact LieGroups.homogeneousRiemannianMetric_invariant
    (I := 𝓘(ℝ, K × P)) Q.o Q.originInner hB Q.originInner_symm Q.originInner_pos
    (by simpa only [Q.smul_origin_eq_projection] using hsections) a x v w

end BFRF.Homogeneous.HomogeneousQuotientRealization

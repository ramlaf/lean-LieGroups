import BFRF.HomogeneousLieGroupIntegration
import LieGroups.LieIII

/-!
# Constructed BFRF integrations

A faithful finite-dimensional representation constructs BFRF's actual
`IntegratedLieGroup` record. The generic construction also supplies this record
for center-free brackets and brackets with vanishing triple brackets. The
manifold model is changed from the tagged Lie algebra back to the prescribed
space `E`, using the differential of an actual smooth group equivalence.

Ado's theorem supplies the faithful representation for every finite-dimensional
real Lie algebra, so the unrestricted constructor takes only the bracket and
its Jacobi proof.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open scoped Manifold ContDiff

namespace BFRF.Homogeneous

attribute [local instance] LieRing.ofAssociativeRing

universe uE uV uG

variable {E : Type uE} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] {μ : Bracket E} {hμ : μ.Jacobi}

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩
local instance : CompleteSpace E := FiniteDimensional.complete ℝ E

local instance bracketLieNormedAddCommGroup : NormedAddCommGroup (BracketLie μ hμ) :=
  LieGroups.lieAlgebraNormedAddCommGroup (BracketLie μ hμ)

local instance bracketLieNormedSpace : NormedSpace ℝ (BracketLie μ hμ) :=
  LieGroups.lieAlgebraNormedSpace (BracketLie μ hμ)

local instance : CompleteSpace (BracketLie μ hμ) := FiniteDimensional.complete ℝ _

namespace IntegratedLieGroup

/-- Rechart an actual generic integration into BFRF's prescribed vector-space
model. This helper retains the constructed carrier and group operations. -/
def ofLieAlgebraIntegration (A : LieGroups.LieAlgebraIntegration.{uE, uG} (BracketLie μ hμ)) :
    IntegratedLieGroup.{uG} μ hμ := by
  let e := (BracketLie.toLinearEquiv μ hμ).toContinuousLinearEquiv
  exact {
    G := LieGroups.Manifold.Recharted e A.Carrier
    group := inferInstance
    topology := inferInstance
    charted := inferInstance
    manifold := inferInstance
    lieGroup := inferInstance
    simplyConnected := inferInstance
    lieEquiv := (LieGroups.Manifold.Recharted.lieEquiv e A.Carrier).trans A.lieEquiv
  }

instance ofLieAlgebraIntegrationT2Space
    (A : LieGroups.LieAlgebraIntegration.{uE, uG} (BracketLie μ hμ)) :
    T2Space (ofLieAlgebraIntegration A).G := by
  change T2Space (LieGroups.Manifold.Recharted
    (BracketLie.toLinearEquiv μ hμ).toContinuousLinearEquiv A.Carrier)
  infer_instance

end IntegratedLieGroup

/-- Lie III constructs BFRF's actual integration record from the bracket and
its Jacobi identity, with no supplied representation or integrating group. -/
def integratedLieGroup : IntegratedLieGroup.{0} μ hμ :=
  IntegratedLieGroup.ofLieAlgebraIntegration
    (LieGroups.lieAlgebraIntegration (BracketLie μ hμ))

instance integratedLieGroupT2Space : T2Space (integratedLieGroup (μ := μ) (hμ := hμ)).G := by
  unfold integratedLieGroup
  infer_instance

/-- Every finite-dimensional real Lie bracket has the exact downstream
simply connected integration record. -/
theorem nonempty_integratedLieGroup : Nonempty (IntegratedLieGroup.{0} μ hμ) :=
  ⟨integratedLieGroup⟩

variable {V : Type uV} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]

/-- Construct the exact downstream integration record from a faithful
finite-dimensional representation of the prescribed bracket. -/
def integratedLieGroupOfFaithfulRepresentation
    (ρ : BracketLie μ hμ →ₗ⁅ℝ⁆ Module.End ℝ V) (hρ : Function.Injective ρ) :
    IntegratedLieGroup.{uV} μ hμ :=
  IntegratedLieGroup.ofLieAlgebraIntegration (Classical.choice
    (LieGroups.nonempty_lieAlgebraIntegration_of_faithful_representation ρ hρ))

instance integratedLieGroupOfFaithfulRepresentationT2Space
    (ρ : BracketLie μ hμ →ₗ⁅ℝ⁆ Module.End ℝ V) (hρ : Function.Injective ρ) :
    T2Space (integratedLieGroupOfFaithfulRepresentation ρ hρ).G := by
  unfold integratedLieGroupOfFaithfulRepresentation
  infer_instance

/-- BFRF integration data exist whenever a faithful finite-dimensional
representation is supplied. No integrating group is supplied. -/
theorem nonempty_integratedLieGroup_of_faithful_representation
    (ρ : BracketLie μ hμ →ₗ⁅ℝ⁆ Module.End ℝ V) (hρ : Function.Injective ρ) :
    Nonempty (IntegratedLieGroup.{uV} μ hμ) :=
  ⟨integratedLieGroupOfFaithfulRepresentation ρ hρ⟩

/-- A center-free bracket constructs its actual simply connected integration
using its faithful adjoint representation. -/
def integratedLieGroupOfCenterEqBot (h : LieAlgebra.center ℝ (BracketLie μ hμ) = ⊥) :
    IntegratedLieGroup.{uE} μ hμ :=
  IntegratedLieGroup.ofLieAlgebraIntegration (Classical.choice
    (LieGroups.nonempty_lieAlgebraIntegration_of_center_eq_bot h))

instance integratedLieGroupOfCenterEqBotT2Space
    (h : LieAlgebra.center ℝ (BracketLie μ hμ) = ⊥) :
    T2Space (integratedLieGroupOfCenterEqBot h).G := by
  unfold integratedLieGroupOfCenterEqBot
  infer_instance

/-- The actual BFRF integration interface is inhabited for center-free brackets. -/
theorem nonempty_integratedLieGroup_of_center_eq_bot
    (h : LieAlgebra.center ℝ (BracketLie μ hμ) = ⊥) :
    Nonempty (IntegratedLieGroup.{uE} μ hμ) := ⟨integratedLieGroupOfCenterEqBot h⟩

/-- Vanishing triple brackets construct a simply connected integration, including
brackets with nontrivial center. -/
def integratedLieGroupOfTripleLieEqZero
    (h₂ : ∀ x y z : E, μ.eval x (μ.eval y z) = 0) : IntegratedLieGroup.{uE} μ hμ := by
  have h₂' (x y z : BracketLie μ hμ) : ⁅x, ⁅y, z⁆⁆ = 0 := by
    apply BracketLie.ext
    exact h₂ x.val y.val z.val
  exact IntegratedLieGroup.ofLieAlgebraIntegration (Classical.choice
    (LieGroups.nonempty_lieAlgebraIntegration_of_tripleLie_eq_zero h₂'))

instance integratedLieGroupOfTripleLieEqZeroT2Space
    (h₂ : ∀ x y z : E, μ.eval x (μ.eval y z) = 0) :
    T2Space (integratedLieGroupOfTripleLieEqZero (hμ := hμ) h₂).G := by
  unfold integratedLieGroupOfTripleLieEqZero
  infer_instance

/-- The exact BFRF record exists for every bracket with vanishing triple
brackets, using only the bracket and its Jacobi identity as algebraic data. -/
theorem nonempty_integratedLieGroup_of_tripleLie_eq_zero
    (h₂ : ∀ x y z : E, μ.eval x (μ.eval y z) = 0) :
    Nonempty (IntegratedLieGroup.{uE} μ hμ) := ⟨integratedLieGroupOfTripleLieEqZero h₂⟩

/-- The standard two-step lower-central-series bound also constructs the actual
downstream integration record. -/
theorem nonempty_integratedLieGroup_of_lowerCentralSeries_two_eq_bot
    (h₂ : LieModule.lowerCentralSeries ℝ (BracketLie μ hμ) (BracketLie μ hμ) 2 = ⊥) :
    Nonempty (IntegratedLieGroup.{uE} μ hμ) := by
  obtain ⟨A⟩ := LieGroups.nonempty_lieAlgebraIntegration_of_lowerCentralSeries_two_eq_bot h₂
  exact ⟨IntegratedLieGroup.ofLieAlgebraIntegration A⟩

/-- A center disjoint from the derived ideal constructs the prescribed BFRF
integration through the adjoint and abelianization representation. -/
def integratedLieGroupOfDisjointCenterDerived
    (h : Disjoint (LieAlgebra.center ℝ (BracketLie μ hμ))
      (LieAlgebra.derivedSeries ℝ (BracketLie μ hμ) 1)) : IntegratedLieGroup.{uE} μ hμ :=
  IntegratedLieGroup.ofLieAlgebraIntegration (Classical.choice
    (LieGroups.nonempty_lieAlgebraIntegration_of_disjoint_center_derived h))

instance integratedLieGroupOfDisjointCenterDerivedT2Space
    (h : Disjoint (LieAlgebra.center ℝ (BracketLie μ hμ))
      (LieAlgebra.derivedSeries ℝ (BracketLie μ hμ) 1)) :
    T2Space (integratedLieGroupOfDisjointCenterDerived h).G := by
  unfold integratedLieGroupOfDisjointCenterDerived
  infer_instance

/-- The exact downstream integration record exists when the center meets the
derived ideal trivially. -/
theorem nonempty_integratedLieGroup_of_disjoint_center_derived
    (h : Disjoint (LieAlgebra.center ℝ (BracketLie μ hμ))
      (LieAlgebra.derivedSeries ℝ (BracketLie μ hμ) 1)) :
    Nonempty (IntegratedLieGroup.{uE} μ hμ) := ⟨integratedLieGroupOfDisjointCenterDerived h⟩

/-- A derivation detecting nonzero central elements constructs BFRF's actual
integration record. -/
def integratedLieGroupOfDerivationInjectiveOnCenter
    (D : LieDerivation ℝ (BracketLie μ hμ) (BracketLie μ hμ))
    (hD : ∀ x ∈ LieAlgebra.center ℝ (BracketLie μ hμ), D x = 0 → x = 0) :
    IntegratedLieGroup.{uE} μ hμ :=
  IntegratedLieGroup.ofLieAlgebraIntegration (Classical.choice
    (LieGroups.nonempty_lieAlgebraIntegration_of_derivation_injective_on_center D hD))

instance integratedLieGroupOfDerivationInjectiveOnCenterT2Space
    (D : LieDerivation ℝ (BracketLie μ hμ) (BracketLie μ hμ))
    (hD : ∀ x ∈ LieAlgebra.center ℝ (BracketLie μ hμ), D x = 0 → x = 0) :
    T2Space (integratedLieGroupOfDerivationInjectiveOnCenter D hD).G := by
  unfold integratedLieGroupOfDerivationInjectiveOnCenter
  infer_instance

/-- A derivation injective on the center suffices for the exact BFRF integration
interface, with no integrating group as an input. -/
theorem nonempty_integratedLieGroup_of_derivation_injective_on_center
    (D : LieDerivation ℝ (BracketLie μ hμ) (BracketLie μ hμ))
    (hD : ∀ x ∈ LieAlgebra.center ℝ (BracketLie μ hμ), D x = 0 → x = 0) :
    Nonempty (IntegratedLieGroup.{uE} μ hμ) :=
  ⟨integratedLieGroupOfDerivationInjectiveOnCenter D hD⟩

/-- A nonsingular derivation constructs a simply connected integration of the
prescribed bracket. -/
def integratedLieGroupOfInjectiveDerivation
    (D : LieDerivation ℝ (BracketLie μ hμ) (BracketLie μ hμ)) (hD : Function.Injective D) :
    IntegratedLieGroup.{uE} μ hμ :=
  IntegratedLieGroup.ofLieAlgebraIntegration (Classical.choice
    (LieGroups.nonempty_lieAlgebraIntegration_of_injective_derivation D hD))

instance integratedLieGroupOfInjectiveDerivationT2Space
    (D : LieDerivation ℝ (BracketLie μ hμ) (BracketLie μ hμ)) (hD : Function.Injective D) :
    T2Space (integratedLieGroupOfInjectiveDerivation D hD).G := by
  unfold integratedLieGroupOfInjectiveDerivation
  infer_instance

/-- A nonsingular derivation suffices for the exact downstream integration
record. -/
theorem nonempty_integratedLieGroup_of_injective_derivation
    (D : LieDerivation ℝ (BracketLie μ hμ) (BracketLie μ hμ)) (hD : Function.Injective D) :
    Nonempty (IntegratedLieGroup.{uE} μ hμ) := ⟨integratedLieGroupOfInjectiveDerivation D hD⟩

end BFRF.Homogeneous

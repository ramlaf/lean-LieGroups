import BFRF.InvariantMetric
import BFRF.FundamentalFields
import LieGroups.IsotropyRepresentationDifferential

/-!
# The actual isotropy representation of a BFRF quotient

Closed isotropy has its constructed Lie-group atlas on the original subgroup
topology. Its derivative action at the quotient origin gives a smooth linear
representation on the prescribed tangent space.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-22.
-/

noncomputable section
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false

namespace BFRF.Homogeneous.HomogeneousQuotientRealization

universe u
variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]
  {μ : Bracket (K × P)} {hμ : μ.Jacobi}
  {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
  {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
  (Q : HomogeneousQuotientRealization A KA)

local instance bfrfIsotropyMulAction : MulAction A.G Q.M := Q.mulAction
local instance bfrfIsotropySmoothAction :
    ContMDiffSMul 𝓘(ℝ, K × P) 𝓘(ℝ, P) ∞ A.G Q.M := Q.contMDiffSMul
local instance bfrfIsotropyCompleteModel : CompleteSpace (K × P) :=
  FiniteDimensional.complete ℝ _
local instance bfrfIsotropyLEInfty : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

variable (C : LieGroups.ClosedLieSubgroup 𝓘(ℝ, K × P) KA.Kμ)

/-- The subgroup's constructed atlas retains connectedness of the supplied
isotropy subgroup, because its topology is the original subtype topology. -/
theorem isotropyConnectedSpace : ConnectedSpace C.Carrier :=
  isConnected_iff_connectedSpace.mp KA.connected

/-- Every element of the actual isotropy group fixes the quotient origin. -/
theorem isotropy_fixes_origin (a : C.Carrier) : C.inclusion a • Q.o = Q.o :=
  (Q.stabilizer_iff _).mpr a.property

/-- The actual derivative representation of the constructed isotropy group. -/
def isotropyTangentRepresentation : C.Carrier →* (P →L[ℝ] P) :=
  LieGroups.fixedPointTangentRepresentationOfHom C.inclusion C.contMDiff_inclusion
    Q.o (Q.isotropy_fixes_origin C) Q.tangentEquiv

@[simp] theorem isotropyTangentRepresentation_apply (a : C.Carrier) (X : P) :
    Q.isotropyTangentRepresentation C a X = Q.tangentEquiv.symm
      (LieGroups.actionTangent (J := 𝓘(ℝ, P)) (C.inclusion a) Q.o (Q.tangentEquiv X)) := rfl

/-- Smoothness is established for the actual derivative representation. -/
theorem contMDiff_isotropyTangentRepresentation :
    ContMDiff 𝓘(ℝ, LieGroups.subgroupTangentModel (I := 𝓘(ℝ, K × P)) KA.Kμ)
      𝓘(ℝ, P →L[ℝ] P) ∞ (fun a => Q.isotropyTangentRepresentation C a) :=
  LieGroups.contMDiff_fixedPointTangentRepresentationOfHom C.inclusion
    C.contMDiff_inclusion Q.o (Q.isotropy_fixes_origin C) Q.tangentEquiv

variable [T2Space A.G]

local instance bfrfIsotropyCompleteSubgroup : CompleteSpace
    (LieGroups.subgroupTangentModel (I := 𝓘(ℝ, K × P)) KA.Kμ) :=
  FiniteDimensional.complete ℝ _

/-- The actual differential of isotropy inclusion lies in the prescribed
isotropy summand under the integration's Lie-algebra identification. -/
theorem inclusion_differential_tangent_component
    (X : GroupLieAlgebra
      𝓘(ℝ, LieGroups.subgroupTangentModel (I := 𝓘(ℝ, K × P)) KA.Kμ) C.Carrier) :
    (A.lieEquiv (LieGroups.homLieDifferential C.inclusion X)).val.2 = 0 := by
  apply (KA.tangent_isotropy _).mp
  rw [subgroupTangentSet_eq_generic]
  exact (C.mem_lieAlgebra _).mp ⟨X, rfl⟩

/-- The actual isotropy representation differentiates to the algebraic isotropy
action specified by the original bracket. -/
theorem isotropyTangentRepresentation_differential
    (X : GroupLieAlgebra
      𝓘(ℝ, LieGroups.subgroupTangentModel (I := 𝓘(ℝ, K × P)) KA.Kμ) C.Carrier)
    (Y : P) :
    LieGroups.representationDifferential (Q.isotropyTangentRepresentation C) X Y =
      isotropyAction μ
        (A.lieEquiv (LieGroups.homLieDifferential C.inclusion X)).val.1 Y := by
  let V : GroupLieAlgebra 𝓘(ℝ, K × P) A.G :=
    A.lieEquiv.symm (⟨(0, Y)⟩ : BracketLie μ hμ)
  have h := LieGroups.representationDifferential_fixedPointTangentRepresentationOfHom
    C.inclusion C.contMDiff_inclusion Q.o (Q.isotropy_fixes_origin C) Q.tangentEquiv X V
  change LieGroups.representationDifferential (Q.isotropyTangentRepresentation C) X
    (Q.tangentEquiv.symm (LieGroups.orbitLieDifferential Q.o V)) = _ at h
  have hV : Q.tangentEquiv.symm (LieGroups.orbitLieDifferential Q.o V) = Y := by
    rw [Q.orbitLieDifferential_origin]
    simp only [V, LieEquiv.apply_symm_apply, ContinuousLinearEquiv.symm_apply_apply]
  rw [hV, Q.orbitLieDifferential_origin] at h
  have h' := h.trans (Q.tangentEquiv.symm_apply_apply
    (A.lieEquiv ⁅LieGroups.homLieDifferential C.inclusion X, V⁆).val.2)
  rw [A.lieEquiv.map_lie] at h'
  change LieGroups.representationDifferential (Q.isotropyTangentRepresentation C) X Y =
    (μ.eval (A.lieEquiv (LieGroups.homLieDifferential C.inclusion X)).val
      (A.lieEquiv V).val).2 at h'
  have hzero := inclusion_differential_tangent_component C X
  have hpair : (A.lieEquiv (LieGroups.homLieDifferential C.inclusion X)).val =
      ((A.lieEquiv (LieGroups.homLieDifferential C.inclusion X)).val.1, 0) :=
    Prod.ext rfl hzero
  rw [hpair] at h'
  simpa only [V, LieEquiv.apply_symm_apply, isotropyAction_apply] using h'

/-- Infinitesimal metric isotropy integrates on the actual connected isotropy
group, preserving the prescribed tangent inner product. -/
theorem isotropyTangentRepresentation_preserves_inner
    (hmetric : IsMetricIsotropy μ) (a : C.Carrier) (X Y : P) :
    inner ℝ (Q.isotropyTangentRepresentation C a X)
      (Q.isotropyTangentRepresentation C a Y) = inner ℝ X Y := by
  let : ConnectedSpace C.Carrier := isotropyConnectedSpace C
  apply LieGroups.inner_representation_of_skew (Q.isotropyTangentRepresentation C)
    ((Q.contMDiff_isotropyTangentRepresentation C).mdifferentiable (by simp))
  intro V U W
  rw [Q.isotropyTangentRepresentation_differential C,
    Q.isotropyTangentRepresentation_differential C]
  exact hmetric _ U W

/-- Metric isotropy and connected closed isotropy imply actual stabilizer
invariance of the normalized origin form. No representation identity is assumed. -/
theorem originInner_isIsotropyInvariant (hmetric : IsMetricIsotropy μ) :
    LieGroups.IsIsotropyInvariant (G := A.G) Q.o Q.originInner := by
  obtain ⟨C⟩ := LieGroups.nonempty_closedLieSubgroup
    (I := 𝓘(ℝ, K × P)) KA.Kμ KA.closed
  intro a ha v w
  let k : C.Carrier := ⟨a, (Q.stabilizer_iff a).mp ha⟩
  have h := Q.isotropyTangentRepresentation_preserves_inner C hmetric k
    (Q.tangentEquiv.symm v) (Q.tangentEquiv.symm w)
  have h' : inner ℝ (Q.tangentEquiv.symm
      (LieGroups.actionTangent (J := 𝓘(ℝ, P)) (C.inclusion k) Q.o v))
      (Q.tangentEquiv.symm
        (LieGroups.actionTangent (J := 𝓘(ℝ, P)) (C.inclusion k) Q.o w)) =
      inner ℝ (Q.tangentEquiv.symm v) (Q.tangentEquiv.symm w) := by
    simpa only [Q.isotropyTangentRepresentation_apply,
      ContinuousLinearEquiv.apply_symm_apply] using h
  exact h'

/-- Closed connected isotropy with infinitesimal metric invariance supplies the
actual quotient, normalized invariant metric, and smooth fundamental fields
required by BFRF's geometric Ricci calculations. -/
theorem exists_metric_fundamentalFields (hmetric : IsMetricIsotropy μ) :
    ∃ R : RegularHomogeneousQuotientRealization A KA,
      let Q := R.toHomogeneousQuotientRealization
      ∃ g : DifferentialGeometry.SmoothRiemannianMetric 𝓘(ℝ, P) Q.M,
        ∃ F : (K × P) →ₗ[ℝ]
            Cₛ^∞⟮𝓘(ℝ, P); P, (TangentSpace 𝓘(ℝ, P) : Q.M → Type _)⟯,
          Q.IsInvariantMetric g ∧
          (∀ a : K × P, F a Q.o = Q.tangentEquiv a.2) ∧
          (∀ X Y : P, g.inner Q.o (Q.tangentEquiv X) (Q.tangentEquiv Y) = inner ℝ X Y) ∧
          (∀ (a : K × P) (x : Q.M) (v w : TangentSpace 𝓘(ℝ, P) x),
            DifferentialGeometry.PDE.DeTurck.lieDerivMetric g (F a) x v w = 0) ∧
          (∀ (a b : K × P) (x : Q.M),
            VectorField.mlieBracket 𝓘(ℝ, P) (F a) (F b) x = -F (μ.eval a b) x) := by
  obtain ⟨R⟩ := nonempty_regularHomogeneousQuotientRealization KA
  let Q := R.toHomogeneousQuotientRealization
  let g := Q.riemannianMetric (Q.originInner_isIsotropyInvariant hmetric) R.localSections
  have hInv : Q.IsInvariantMetric g := Q.riemannianMetric_isInvariant _ _
  refine ⟨R, g, Q.fundamentalFields, hInv, Q.fundamentalFields_origin, ?_, ?_,
    Q.mlieBracket_fundamentalFields⟩
  · exact Q.riemannianMetric_origin _ _
  · exact Q.lieDerivMetric_fundamentalFields_of_invariant g hInv

end BFRF.Homogeneous.HomogeneousQuotientRealization

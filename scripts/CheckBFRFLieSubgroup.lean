import BFRF.LieSubgroup

/-!
# BFRF embedded subgroup compatibility checks and axiom audit

Run `python3 scripts/check_bfrf_compatibility.py` after `lake build`.
These checks use BFRF's actual isotropy structures. Ambient Hausdorffness is needed for
connected-subgroup uniqueness, but the tangent-identification example does not assume it.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

noncomputable section
open BFRF.Homogeneous
open scoped Manifold ContDiff

variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]
  {μ : BFRF.Bracket (K × P)} {hjac : μ.Jacobi}
  {A : IntegratedLieGroup μ hjac}
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {L : Type*} [Group L] [TopologicalSpace L] [ChartedSpace F L]
  [LieGroup 𝓘(ℝ, F) ∞ L] [T2Space L]

local instance : CompleteSpace (K × P) := FiniteDimensional.complete ℝ (K × P)
local instance : CompleteSpace F := FiniteDimensional.complete ℝ F
local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

-- The actual downstream tangent predicate determines the embedded subgroup Lie algebra.
example (hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0)
    (S : LieGroups.EmbeddedLieSubgroup 𝓘(ℝ, K × P) A.G 𝓘(ℝ, F) L)
    (hS : HasIsotropyTangent A hKK S.toImmersedLieSubgroup.subgroup) :
    S.toImmersedLieSubgroup.lieAlgebra =
      (BracketLie.isotropy μ hjac hKK).comap A.lieEquiv.toLieHom :=
  (hasIsotropyTangent_iff_lieAlgebra_eq hKK S).mp hS

variable {D : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D] [FiniteDimensional ℝ D]
  {Q : Type*} [Group Q] [TopologicalSpace Q] [ChartedSpace D Q]
  [LieGroup 𝓘(ℝ, D) ∞ Q] [T2Space Q]

-- The two intrinsic model spaces are arbitrary and need not have the same type.
example [T2Space A.G] [ConnectedSpace L] [ConnectedSpace Q]
    (hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0)
    (S : LieGroups.EmbeddedLieSubgroup 𝓘(ℝ, K × P) A.G 𝓘(ℝ, F) L)
    (T : LieGroups.EmbeddedLieSubgroup 𝓘(ℝ, K × P) A.G 𝓘(ℝ, D) Q)
    (hS : HasIsotropyTangent A hKK S.toImmersedLieSubgroup.subgroup)
    (hT : HasIsotropyTangent A hKK T.toImmersedLieSubgroup.subgroup) :
    S.toImmersedLieSubgroup.subgroup = T.toImmersedLieSubgroup.subgroup :=
  embeddedSubgroup_eq_of_hasIsotropyTangent hKK S T
    S.toImmersedLieSubgroup.isConnected_subgroup T.toImmersedLieSubgroup.isConnected_subgroup hS hT

#print axioms BFRF.Homogeneous.subgroupTangentSet_eq_generic

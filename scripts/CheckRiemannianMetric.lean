-/

noncomputable section

open Bundle LieGroups.Manifold
open scoped ContDiff Manifold Topology

namespace RiemannianMetricCheck

private theorem modelSpace_trivialization_snd
    {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (x y : V) (v : TangentSpace 𝓘(ℝ, V) y) :
    (trivializationAt V (TangentSpace 𝓘(ℝ, V)) x (TotalSpace.mk' V y v)).2 = v := by
  rw [← Trivialization.continuousLinearMapAt_apply_of_mem ℝ
    (trivializationAt V (TangentSpace 𝓘(ℝ, V)) x) (by exact Set.mem_univ y) v,
    TangentBundle.continuousLinearMapAt_model_space]
  rfl

private theorem modelSpace_vectorField_smooth
    {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (Y : Cₛ^∞⟮𝓘(ℝ, V); V, (TangentSpace 𝓘(ℝ, V) : V → Type _)⟯) :
    ContMDiff 𝓘(ℝ, V) 𝓘(ℝ, V) ∞ (fun x => Y x) := by
  intro x
  have h := (contMDiffAt_section x).mp (Y.contMDiff x)
  simpa only [modelSpace_trivialization_snd] using h

def conformalForm (x : ℝ) : TangentSpace 𝓘(ℝ, ℝ) x →L[ℝ]
    TangentSpace 𝓘(ℝ, ℝ) x →L[ℝ] ℝ :=
  (1 + x * x) • ContinuousLinearMap.mul ℝ ℝ

theorem conformalForm_symmetric (x : ℝ) (v w : TangentSpace 𝓘(ℝ, ℝ) x) :
    conformalForm x v w = conformalForm x w v := by
  let u : ℝ := v
  let z : ℝ := w
  change (1 + x * x) * (u * z) = (1 + x * x) * (z * u)
  ring

theorem conformalForm_positive (x : ℝ) (v : TangentSpace 𝓘(ℝ, ℝ) x) (hv : v ≠ 0) :
    0 < conformalForm x v v := by
  let u : ℝ := v
  change 0 < (1 + x * x) * (u * u)
  have h : u ≠ 0 := hv
  have hx : 0 < 1 + x * x := by nlinarith [sq_nonneg x]
  have hu : 0 < u * u := mul_self_pos.mpr h
  exact mul_pos hx hu

theorem conformalForm_pairings
    (Y Z : Cₛ^∞⟮𝓘(ℝ, ℝ); ℝ, (TangentSpace 𝓘(ℝ, ℝ) : ℝ → Type _)⟯) :
    ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, ℝ) ∞ (fun x => conformalForm x (Y x) (Z x)) := by
  let U : ℝ → ℝ := fun x => Y x
  let V : ℝ → ℝ := fun x => Z x
  change ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, ℝ) ∞
    (fun x : ℝ => (1 + x * x) * (U x * V x))
  exact (contMDiff_const.add (contMDiff_id.mul contMDiff_id)).mul
    ((modelSpace_vectorField_smooth Y).mul (modelSpace_vectorField_smooth Z))

def conformalMetric : DifferentialGeometry.SmoothRiemannianMetric 𝓘(ℝ, ℝ) ℝ :=
  smoothRiemannianMetricOfPairings conformalForm conformalForm_symmetric
    conformalForm_positive conformalForm_pairings

theorem conformalMetric_inner (x v w : ℝ) :
    conformalMetric.inner x v w = (1 + x * x) * v * w := by
  change (1 + x * x) * (v * w) = _
  ring

example : conformalMetric.inner 0 (1 : ℝ) (1 : ℝ) = 1 := by
  rw [conformalMetric_inner]
  norm_num
example : conformalMetric.inner 1 (1 : ℝ) (1 : ℝ) = 2 := by
  rw [conformalMetric_inner]
  norm_num

abbrev ZeroSpace := EuclideanSpace ℝ (Fin 0)

def zeroDimensionalMetric : DifferentialGeometry.SmoothRiemannianMetric
    𝓘(ℝ, ZeroSpace) ZeroSpace :=
  smoothRiemannianMetricOfPairings (fun _ => 0)
    (by intro x v w; rfl)
    (by
      intro x v hv
      have hv0 : v = 0 := Subsingleton.elim (α := ZeroSpace) v 0
      exact (hv hv0).elim)
    (by intro Y Z; exact contMDiff_const)

example (x : ZeroSpace) (v w : TangentSpace 𝓘(ℝ, ZeroSpace) x) :
    zeroDimensionalMetric.inner x v w = 0 := rfl

theorem translatedDerivative_smooth :
    ContMDiffAt 𝓘(ℝ, ℝ) 𝓘(ℝ, ℝ) ∞
      (fun a : ℝ => mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, ℝ) (fun x : ℝ => x - a) a (1 : ℝ)) 0 := by
  apply contMDiffAt_parametricMFDeriv_apply_const
    (fun a x : ℝ => x - a) id (fun _ => (1 : ℝ)) 0 0
  · exact contMDiffAt_snd.sub contMDiffAt_fst
  · exact contMDiffAt_id
  · apply contMDiffAt_totalSpace.mpr
    refine ⟨contMDiffAt_id, ?_⟩
    apply (contMDiffAt_const (c := (1 : ℝ))).congr_of_eventuallyEq
    filter_upwards with x
    exact modelSpace_trivialization_snd (0 : ℝ) x (1 : ℝ)
  · filter_upwards with a
    exact sub_self a

#print axioms conformalMetric
#print axioms zeroDimensionalMetric
#print axioms translatedDerivative_smooth

end RiemannianMetricCheck

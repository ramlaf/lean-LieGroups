import LieGroups
import Mathlib.Geometry.Manifold.MFDeriv.FDeriv

/-!
# A homomorphism between additive groups of different dimensions

The map `(x, y) ↦ 2 * x + y` checks that differentiation and exponential
naturality apply to noninvertible homomorphisms between different model spaces.
The doubling equivalence checks the induced Lie algebra equivalence and its inverse.
Run `lake env lean scripts/CheckHomomorphismDifferential.lean` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-16.
-/

open LieGroups
open scoped ContDiff Manifold

namespace HomomorphismDifferentialCheck

noncomputable section

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

local instance {E : Type*} [NormedAddCommGroup E] :
    NormedAddCommGroup (Multiplicative E) := inferInstanceAs (NormedAddCommGroup E)
local instance {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] :
    NormedSpace ℝ (Multiplicative E) := inferInstanceAs (NormedSpace ℝ E)
local instance {E : Type*} [NormedAddCommGroup E] [CompleteSpace E] :
    CompleteSpace (Multiplicative E) := inferInstanceAs (CompleteSpace E)

local instance {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] :
    LieGroup 𝓘(ℝ, Multiplicative E) ∞ (Multiplicative E) where
  contMDiff_mul := by
    change ContMDiff _ _ ∞ (fun p : Multiplicative E × Multiplicative E => p.1 + p.2)
    exact contMDiff_fst.add contMDiff_snd
  contMDiff_inv := contDiff_neg.contMDiff

def weightedSumLinear : (ℝ × ℝ) →L[ℝ] ℝ :=
  (2 : ℝ) • ContinuousLinearMap.fst ℝ ℝ ℝ + ContinuousLinearMap.snd ℝ ℝ ℝ

def weightedSum : Multiplicative (ℝ × ℝ) →* Multiplicative ℝ :=
  weightedSumLinear.toLinearMap.toAddMonoidHom.toMultiplicative

theorem weightedSum_smooth :
    ContMDiff 𝓘(ℝ, Multiplicative (ℝ × ℝ)) 𝓘(ℝ, Multiplicative ℝ) ∞ weightedSum :=
  weightedSumLinear.contDiff.contMDiff

theorem weightedSum_differential (v : Multiplicative (ℝ × ℝ)) :
    homLieDifferential (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ)))
      (J := 𝓘(ℝ, Multiplicative ℝ)) weightedSum v = 2 * v.1 + v.2 := by
  unfold homLieDifferential
  rw [mfderiv_eq_fderiv]
  change (fderiv ℝ weightedSumLinear (0 : ℝ × ℝ)) v = _
  rw [weightedSumLinear.fderiv]
  rfl

set_option backward.isDefEq.respectTransparency false in
example (v : Multiplicative (ℝ × ℝ)) :
    weightedSum (lieExp (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ))) v) =
      lieExp (I := 𝓘(ℝ, Multiplicative ℝ)) (2 * v.1 + v.2) := by
  rw [lieExp_map weightedSum weightedSum_smooth, weightedSum_differential]

def doubling : Multiplicative ℝ ≃* Multiplicative ℝ where
  toFun x := (2 : ℝ) • x
  invFun x := (1 / 2 : ℝ) • x
  left_inv x := by change (1 / 2 : ℝ) * (2 * x.toAdd) = x.toAdd; ring
  right_inv x := by change (2 : ℝ) * (1 / 2 * x.toAdd) = x.toAdd; ring
  map_mul' x y := by change (2 : ℝ) * (x.toAdd + y.toAdd) = 2 * x.toAdd + 2 * y.toAdd; ring

theorem doubling_smooth :
    ContMDiff 𝓘(ℝ, Multiplicative ℝ) 𝓘(ℝ, Multiplicative ℝ) ∞ doubling :=
  (contDiff_id.const_smul (2 : ℝ)).contMDiff

theorem doubling_symm_smooth :
    ContMDiff 𝓘(ℝ, Multiplicative ℝ) 𝓘(ℝ, Multiplicative ℝ) ∞ doubling.symm :=
  (contDiff_id.const_smul (1 / 2 : ℝ)).contMDiff

theorem doubling_differential (v : Multiplicative ℝ) :
    homLieDifferential (I := 𝓘(ℝ, Multiplicative ℝ))
      (J := 𝓘(ℝ, Multiplicative ℝ)) doubling.toMonoidHom v = (2 : ℝ) • v := by
  unfold homLieDifferential
  rw [mfderiv_eq_fderiv]
  change (fderiv ℝ (fun x : Multiplicative ℝ => (2 : ℝ) • x) 0) v = _
  exact congrArg (fun T : Multiplicative ℝ →L[ℝ] Multiplicative ℝ => T v)
    ((hasFDerivAt_id (𝕜 := ℝ) (0 : Multiplicative ℝ)).const_smul (2 : ℝ)).fderiv

set_option backward.isDefEq.respectTransparency false in
example (v : Multiplicative (ℝ × ℝ)) :
    homLieHom (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ)))
      (J := 𝓘(ℝ, Multiplicative ℝ)) (doubling.toMonoidHom.comp weightedSum)
      (doubling_smooth.comp weightedSum_smooth) v =
        4 * v.1 + 2 * v.2 := by
  rw [homLieHom_comp weightedSum doubling.toMonoidHom
    weightedSum_smooth doubling_smooth]
  simp only [LieHom.comp_apply, homLieHom_apply, doubling_differential, weightedSum_differential]
  change 2 * (2 * v.1 + v.2) = 4 * v.1 + 2 * v.2
  ring

set_option backward.isDefEq.respectTransparency false in
example (v w : GroupLieAlgebra 𝓘(ℝ, Multiplicative (ℝ × ℝ)) (Multiplicative (ℝ × ℝ))) :
    homLieHom weightedSum weightedSum_smooth ⁅v, w⁆ =
      ⁅(2 * v.1 + v.2 : GroupLieAlgebra 𝓘(ℝ, Multiplicative ℝ) (Multiplicative ℝ)),
        (2 * w.1 + w.2 : GroupLieAlgebra 𝓘(ℝ, Multiplicative ℝ) (Multiplicative ℝ))⁆ := by
  rw [LieHom.map_lie]
  simp only [homLieHom_apply, weightedSum_differential]

set_option backward.isDefEq.respectTransparency false in
example (v : Multiplicative ℝ) :
    (equivLieEquiv doubling doubling_smooth doubling_symm_smooth).symm ((2 : ℝ) • v) = v := by
  have h := (equivLieEquiv doubling doubling_smooth doubling_symm_smooth).symm_apply_apply v
  simpa only [equivLieEquiv_apply, doubling_differential] using h

-- Changing the source identification by the same doubling makes the coordinate map identity.
example :
    coordinateLieEquiv doubling doubling_smooth doubling_symm_smooth
      (equivLieEquiv doubling doubling_smooth doubling_symm_smooth) LieEquiv.refl =
        LieEquiv.refl := by
  ext v
  exact (equivLieEquiv doubling doubling_smooth doubling_symm_smooth).apply_symm_apply v

end

end HomomorphismDifferentialCheck

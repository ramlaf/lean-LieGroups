import LieGroups
import LieGroups.EmbeddedSubgroupTangent
import LieGroups.InvariantDistribution
import LieGroups.InvariantDistributionInvolutive
import LieGroups.Analysis.FlowBox
import LieGroups.LieSubalgebraIntegration
import Mathlib.Geometry.Manifold.MFDeriv.FDeriv

/-!
# Concrete checks for connected and immersed Lie subgroups

Scaled parametrizations of the real coordinate axis have equal differential
images and therefore equal subgroup images. A projection from the plane and the
identity of the line check that sources of different dimensions are supported.
The coordinate axis also checks the actual immersion and embedding interfaces.
Its invariant distribution is computed at arbitrary points of the plane and has
rank one, rather than the rank of the full ambient tangent bundle.
The rotating plane field checks smooth flow-box coordinates on a proper open domain.
Constructed integrations of the proper axis, zero algebra, and full algebra check
existence, their actual subgroup images, and the intrinsic source instances.

Run `lake env lean scripts/CheckLieSubgroup.lean` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-18.
-/

open LieGroups
open scoped ContDiff Manifold

namespace LieSubgroupCheck

noncomputable section

set_option backward.isDefEq.respectTransparency false

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

local instance {E : Type*} [NormedAddCommGroup E] :
    NormedAddCommGroup (Multiplicative E) := inferInstanceAs (NormedAddCommGroup E)
local instance {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] :
    NormedSpace ℝ (Multiplicative E) := inferInstanceAs (NormedSpace ℝ E)
local instance {E : Type*} [NormedAddCommGroup E] [CompleteSpace E] :
    CompleteSpace (Multiplicative E) := inferInstanceAs (CompleteSpace E)
local instance {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] : FiniteDimensional ℝ (Multiplicative E) :=
  inferInstanceAs (FiniteDimensional ℝ E)
local instance {E : Type*} [TopologicalSpace E] :
    ChartedSpace (Multiplicative E) (Multiplicative E) := chartedSpaceSelf _

local instance {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] :
    LieGroup 𝓘(ℝ, Multiplicative E) ∞ (Multiplicative E) where
  contMDiff_mul := by
    change ContMDiff _ _ ∞ (fun p : Multiplicative E × Multiplicative E => p.1 + p.2)
    exact contMDiff_fst.add contMDiff_snd
  contMDiff_inv := contDiff_neg.contMDiff

def axisLinear (c : ℝ) : ℝ →L[ℝ] ℝ × ℝ :=
  c • ContinuousLinearMap.inl ℝ ℝ ℝ

def axis (c : ℝ) : Multiplicative ℝ →* Multiplicative (ℝ × ℝ) :=
  (axisLinear c).toLinearMap.toAddMonoidHom.toMultiplicative

theorem axis_smooth (c : ℝ) :
    ContMDiff 𝓘(ℝ, Multiplicative ℝ) 𝓘(ℝ, Multiplicative (ℝ × ℝ)) ∞ (axis c) :=
  (axisLinear c).contDiff.contMDiff

theorem axis_differential (c : ℝ) (v : Multiplicative ℝ) :
    homLieDifferential (I := 𝓘(ℝ, Multiplicative ℝ))
      (J := 𝓘(ℝ, Multiplicative (ℝ × ℝ))) (axis c) v =
        Multiplicative.ofAdd (c * v.toAdd, 0) := by
  unfold homLieDifferential
  rw [mfderiv_eq_fderiv]
  change (fderiv ℝ (axisLinear c) (0 : ℝ)) v = _
  rw [(axisLinear c).fderiv]
  simp [axisLinear]
  rfl

theorem scaled_axis_differential_ranges :
    (homLieHom (axis 1) (axis_smooth 1)).range =
      (homLieHom (axis 2) (axis_smooth 2)).range := by
  ext v
  simp only [LieHom.mem_range, homLieHom_apply, axis_differential]
  constructor
  · rintro ⟨w, rfl⟩
    refine ⟨(w.toAdd / 2 : ℝ), ?_⟩
    change ((2 : ℝ) * (w.toAdd / 2), (0 : ℝ)) = (1 * w.toAdd, 0)
    ext <;> dsimp
    ring
  · rintro ⟨w, rfl⟩
    refine ⟨(2 * w.toAdd : ℝ), ?_⟩
    change ((1 : ℝ) * (2 * w.toAdd), (0 : ℝ)) = (2 * w.toAdd, 0)
    ext <;> dsimp
    ring

example : (axis 1).range = (axis 2).range :=
  range_eq_of_homLieHom_range_eq (axis 1) (axis 2)
    (axis_smooth 1) (axis_smooth 2) scaled_axis_differential_ranges

-- This generated candidate is the proper coordinate-axis subgroup of the plane.
theorem mem_generated_axis_iff (p : Multiplicative (ℝ × ℝ)) :
    p ∈ lieSubalgebraSubgroup (homLieHom (axis 1) (axis_smooth 1)).range ↔ p.toAdd.2 = 0 := by
  rw [← range_eq_lieSubalgebraSubgroup (axis 1) (axis_smooth 1)]
  change (∃ t : Multiplicative ℝ, axis 1 t = p) ↔ p.toAdd.2 = 0
  constructor
  · rintro ⟨t, rfl⟩
    simp [axis, axisLinear, Multiplicative.ofAdd, Multiplicative.toAdd]
  · intro hp
    refine ⟨Multiplicative.ofAdd p.toAdd.1, ?_⟩
    apply Multiplicative.ext
    simp [axis, axisLinear, Multiplicative.ofAdd, Multiplicative.toAdd]
    exact Prod.ext rfl hp.symm

def projection : Multiplicative (ℝ × ℝ) →* Multiplicative ℝ :=
  (ContinuousLinearMap.fst ℝ ℝ ℝ).toLinearMap.toAddMonoidHom.toMultiplicative

theorem projection_smooth :
    ContMDiff 𝓘(ℝ, Multiplicative (ℝ × ℝ)) 𝓘(ℝ, Multiplicative ℝ) ∞ projection :=
  (ContinuousLinearMap.fst ℝ ℝ ℝ).contDiff.contMDiff

theorem projection_differential (v : Multiplicative (ℝ × ℝ)) :
    homLieDifferential (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ)))
      (J := 𝓘(ℝ, Multiplicative ℝ)) projection v = v.1 := by
  unfold homLieDifferential
  rw [mfderiv_eq_fderiv]
  change (fderiv ℝ (ContinuousLinearMap.fst ℝ ℝ ℝ) (0 : ℝ × ℝ)) v = _
  rw [ContinuousLinearMap.fderiv]
  rfl

example : projection.range = (MonoidHom.id (Multiplicative ℝ)).range := by
  apply range_eq_of_homLieHom_range_eq projection (MonoidHom.id (Multiplicative ℝ))
    projection_smooth (contMDiff_id (I := 𝓘(ℝ, Multiplicative ℝ)))
  ext v
  simp only [LieHom.mem_range, homLieHom_apply, projection_differential,
    homLieDifferential_id, ContinuousLinearMap.id_apply]
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨w.1, rfl⟩
  · rintro ⟨w, rfl⟩
    exact ⟨(w, 0), rfl⟩

theorem axis_isImmersion :
    _root_.Manifold.IsImmersion 𝓘(ℝ, Multiplicative ℝ)
      𝓘(ℝ, Multiplicative (ℝ × ℝ)) ∞ (axis 1) := by
  apply _root_.Manifold.IsImmersionOfComplement.isImmersion (F := ℝ)
  intro x
  apply _root_.Manifold.IsImmersionAtOfComplement.mk_of_continuousAt
    (axis_smooth 1).continuous.continuousAt
    (ContinuousLinearEquiv.refl ℝ (ℝ × ℝ))
    (chartAt (Multiplicative ℝ) x) (chartAt (Multiplicative (ℝ × ℝ)) (axis 1 x))
    (mem_chart_source _ _) (mem_chart_source _ _)
    (IsManifold.chart_mem_maximalAtlas _) (IsManifold.chart_mem_maximalAtlas _)
  intro y hy
  simp [axis, axisLinear, Function.comp_def]
  rfl

def axisEmbedded : EmbeddedLieSubgroup 𝓘(ℝ, Multiplicative (ℝ × ℝ))
    (Multiplicative (ℝ × ℝ)) 𝓘(ℝ, Multiplicative ℝ) (Multiplicative ℝ) where
  toMonoidHom := axis 1
  injective := by
    intro x y h
    have hfst := congrArg (fun p : Multiplicative (ℝ × ℝ) => p.toAdd.1) h
    change (1 : ℝ) * x.toAdd = 1 * y.toAdd at hfst
    change x.toAdd = y.toAdd
    simpa using hfst
  isImmersion := axis_isImmersion
  isEmbedding := by
    have hcomp : projection ∘ axis 1 = id := by
      funext x
      apply Multiplicative.ext
      simp [projection, axis, axisLinear, Function.comp_def,
        Multiplicative.ofAdd, Multiplicative.toAdd]
    apply Topology.IsEmbedding.of_comp (axis_smooth 1).continuous projection_smooth.continuous
    rw [hcomp]
    exact Topology.IsEmbedding.id

example :
    subgroupTangentSet (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ)))
      axisEmbedded.toImmersedLieSubgroup.subgroup =
        (axisEmbedded.toImmersedLieSubgroup.lieAlgebra :
          Set (GroupLieAlgebra 𝓘(ℝ, Multiplicative (ℝ × ℝ)) (Multiplicative (ℝ × ℝ)))) :=
  axisEmbedded.subgroupTangentSet_eq_lieAlgebra

abbrev axisAlgebra := (homLieHom (axis 1) (axis_smooth 1)).range

theorem mem_axisAlgebra_iff
    (v : GroupLieAlgebra 𝓘(ℝ, Multiplicative (ℝ × ℝ)) (Multiplicative (ℝ × ℝ))) :
    v ∈ axisAlgebra ↔ v.toAdd.2 = 0 := by
  change (∃ t, homLieHom (axis 1) (axis_smooth 1) t = v) ↔ _
  simp only [homLieHom_apply, axis_differential, one_mul]
  constructor
  · rintro ⟨t, rfl⟩
    rfl
  · intro hv
    refine ⟨Multiplicative.ofAdd v.toAdd.1, ?_⟩
    apply Multiplicative.ext
    exact Prod.ext rfl hv.symm

-- This source manifold is constructed by the integration theorem, independently
-- of the explicit axis presentation above, and has precisely the proper axis image.
def axisIntegration : LieSubalgebraIntegration axisAlgebra :=
  Classical.choice (nonempty_lieSubalgebraIntegration axisAlgebra)

example (p : Multiplicative (ℝ × ℝ)) :
    p ∈ axisIntegration.presentation.subgroup ↔ p.toAdd.2 = 0 := by
  rw [axisIntegration.subgroup_eq_lieSubalgebraSubgroup]
  exact mem_generated_axis_iff p

example : LieGroup 𝓘(ℝ, lieSubalgebraModelSubmodule axisAlgebra) ∞ axisIntegration.Carrier :=
  inferInstance

example : ConnectedSpace axisIntegration.Carrier := inferInstance

example : T2Space axisIntegration.Carrier := inferInstance

-- Rank zero goes through the same construction and has the trivial image.
def zeroIntegration : LieSubalgebraIntegration
    (⊥ : LieSubalgebra ℝ
      (GroupLieAlgebra 𝓘(ℝ, Multiplicative (ℝ × ℝ)) (Multiplicative (ℝ × ℝ)))) :=
  Classical.choice (nonempty_lieSubalgebraIntegration _)

example : zeroIntegration.presentation.subgroup = ⊥ := by
  rw [zeroIntegration.subgroup_eq_lieSubalgebraSubgroup]
  apply le_antisymm _ bot_le
  apply (lieSubalgebraSubgroup_le_iff _ _).mpr
  intro v hv
  have hvzero : v = 0 := hv
  rw [hvzero, lieExp_zero]
  exact Subgroup.one_mem _

-- Full rank gives an integration whose image is the entire connected plane.
def fullIntegration : LieSubalgebraIntegration
    (⊤ : LieSubalgebra ℝ
      (GroupLieAlgebra 𝓘(ℝ, Multiplicative (ℝ × ℝ)) (Multiplicative (ℝ × ℝ)))) :=
  Classical.choice (nonempty_lieSubalgebraIntegration _)

example : fullIntegration.presentation.subgroup = ⊤ := by
  rw [fullIntegration.subgroup_eq_lieSubalgebraSubgroup]
  apply subgroup_eq_top_of_lieExp_mem (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ)))
  intro v
  exact lieExp_mem_lieSubalgebraSubgroup _ (show v ∈ (⊤ : LieSubalgebra ℝ _) from trivial)

theorem plane_invariantField
    (v : GroupLieAlgebra 𝓘(ℝ, Multiplicative (ℝ × ℝ)) (Multiplicative (ℝ × ℝ)))
    (p : Multiplicative (ℝ × ℝ)) : mulInvariantVectorField v p = v := by
  unfold mulInvariantVectorField
  rw [mfderiv_eq_fderiv]
  change (fderiv ℝ (fun q : ℝ × ℝ => p.toAdd + q) (0 : ℝ × ℝ)) v.toAdd = v.toAdd
  erw [fderiv_const_add, fderiv_id]
  rfl

-- The translated fiber remains the proper horizontal line at every ambient point.
theorem mem_axisDistribution_iff (p : Multiplicative (ℝ × ℝ))
    (v : TangentSpace 𝓘(ℝ, Multiplicative (ℝ × ℝ)) p) :
    v ∈ invariantDistribution axisAlgebra p ↔ v.toAdd.2 = 0 := by
  rw [mem_invariantDistribution_iff]
  simp only [plane_invariantField, exists_eq_right, mem_axisAlgebra_iff]

example (p : Multiplicative (ℝ × ℝ)) :
    Module.finrank ℝ (invariantDistribution axisAlgebra p) = 1 := by
  rw [finrank_invariantDistribution]
  have hinj : Function.Injective (homLieHom (axis 1) (axis_smooth 1)) :=
    axisEmbedded.toImmersedLieSubgroup.homLieDifferential_injective
  let e := (homLieHom (axis 1) (axis_smooth 1)).equivRangeOfInjective hinj
  calc
    Module.finrank ℝ axisAlgebra =
        Module.finrank ℝ (GroupLieAlgebra 𝓘(ℝ, Multiplicative ℝ) (Multiplicative ℝ)) :=
      e.toLinearEquiv.finrank_eq.symm
    _ = 1 := by
      change Module.finrank ℝ ℝ = 1
      exact Module.finrank_self ℝ

-- The horizontal field x∂x is not invariant. Full involutivity still keeps its
-- bracket with ∂x in the horizontal line, without supplying frame coefficients.
example (p : Multiplicative (ℝ × ℝ)) :
    (VectorField.mlieBracket 𝓘(ℝ, Multiplicative (ℝ × ℝ))
      (fun q : Multiplicative (ℝ × ℝ) => q.toAdd.1 •
        mulInvariantVectorField (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ)))
          (Multiplicative.ofAdd ((1 : ℝ), (0 : ℝ))) q)
      (mulInvariantVectorField (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ)))
        (Multiplicative.ofAdd ((1 : ℝ), (0 : ℝ)))) p).toAdd.2 = 0 := by
  let v : GroupLieAlgebra 𝓘(ℝ, Multiplicative (ℝ × ℝ)) (Multiplicative (ℝ × ℝ)) :=
    Multiplicative.ofAdd ((1 : ℝ), (0 : ℝ))
  let X := mulInvariantVectorField (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ))) v
  let a : Multiplicative (ℝ × ℝ) → ℝ := fun q => q.toAdd.1
  have ha : ContMDiff 𝓘(ℝ, Multiplicative (ℝ × ℝ)) 𝓘(ℝ, ℝ) ∞ a :=
    (ContinuousLinearMap.fst ℝ ℝ ℝ).contDiff.contMDiff
  have hX := contMDiff_infty_mulInvariantVectorField (I := 𝓘(ℝ, Multiplicative (ℝ × ℝ))) v
  have hv : v ∈ axisAlgebra := (mem_axisAlgebra_iff v).2 rfl
  have hXS (q) : X q ∈ invariantDistribution axisAlgebra q :=
    mulInvariantVectorField_mem_invariantDistribution axisAlgebra hv q
  have hVS (q) : a q • X q ∈ invariantDistribution axisAlgebra q :=
    (invariantDistribution axisAlgebra q).smul_mem _ (hXS q)
  exact (mem_axisDistribution_iff p _).mp
    (mlieBracket_mem_invariantDistribution axisAlgebra (ha.smul_section hX) hX hVS hXS p)

-- Around (1,0), the nonconstant rotating field admits time-first coordinates
-- entirely inside the right half-plane. Swapping the input coordinates sends
-- the first coordinate vector to the initial vertical field value.
example :
    ∃ e : OpenPartialHomeomorph (ℝ × ℝ) (ℝ × ℝ),
      (0 : ℝ × ℝ) ∈ e.source ∧ e 0 = (1, 0) ∧
      e.target ⊆ {p : ℝ × ℝ | 0 < p.1} ∧
      ContDiffOn ℝ ∞ e e.source ∧ ContDiffOn ℝ ∞ e.symm e.target ∧
      HasFDerivAt e
        (ContinuousLinearEquiv.prodComm ℝ ℝ ℝ : (ℝ × ℝ) →L[ℝ] ℝ × ℝ) 0 ∧
      ∀ p ∈ e.source, fderiv ℝ e p (1, 0) = (-(e p).2, (e p).1) := by
  apply LieGroups.Analysis.exists_contDiffOn_flowBox_of_equiv
    (X := fun p : ℝ × ℝ => (-p.2, p.1))
    (s := {p : ℝ × ℝ | 0 < p.1}) (x₀ := (1, 0))
    (isOpen_lt continuous_const continuous_fst) (by norm_num)
    (contDiff_snd.neg.prodMk contDiff_fst).contDiffOn
    (ContinuousLinearEquiv.prodComm ℝ ℝ ℝ)
  simp

end

end LieSubgroupCheck

import BFRF.FundamentalFields

/-!
# Constructed fundamental fields for the BFRF geometric interface

The example has exactly the origin evaluation, Killing, and negative bracket
inputs consumed by the geometric Ricci computations. All three are produced by
the same fields constructed from the quotient action.

Run `python3 scripts/check_bfrf_compatibility.py` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-22.
-/

noncomputable section
open BFRF.Homogeneous
open scoped Manifold ContDiff

universe u
variable {K P : Type*} [NormedAddCommGroup K] [NormedSpace ℝ K]
  [FiniteDimensional ℝ K] [NormedAddCommGroup P] [InnerProductSpace ℝ P]
  [FiniteDimensional ℝ P]
  {μ : BFRF.Bracket (K × P)} {hμ : μ.Jacobi}
  {hKK : ∀ k l : K, (μ.eval (k, 0) (l, 0)).2 = 0}
  {A : IntegratedLieGroup.{u} μ hμ} {KA : IntegratedIsotropySubgroup A hKK}
  (Q : HomogeneousQuotientRealization A KA)

example (k : K) : Q.fundamentalFields (k, 0) Q.o = 0 :=
  Q.fundamentalFields_isotropy_origin k

example [T2Space A.G] [T2Space Q.M]
    (g : DifferentialGeometry.SmoothRiemannianMetric 𝓘(ℝ, P) Q.M)
    (hg : Q.IsInvariantMetric g) :
    ∃ F : (K × P) →ₗ[ℝ]
      Cₛ^∞⟮𝓘(ℝ, P); P, (TangentSpace 𝓘(ℝ, P) : Q.M → Type _)⟯,
      (∀ a, F a Q.o = Q.tangentEquiv a.2) ∧
      (∀ a x v w, DifferentialGeometry.PDE.DeTurck.lieDerivMetric g (F a) x v w = 0) ∧
      ∀ a b x, VectorField.mlieBracket 𝓘(ℝ, P) (F a) (F b) x =
        -F (μ.eval a b) x :=
  ⟨Q.fundamentalFields, Q.fundamentalFields_origin,
    Q.lieDerivMetric_fundamentalFields_of_invariant g hg,
    Q.mlieBracket_fundamentalFields⟩


/-!
# Nonabelian checks for the representation route to integration

The Heisenberg Lie algebra is defined directly from its bracket, without an
integrating group as input. Its faithful two-step representation constructs a
simply connected integrating group. The two-dimensional affine Lie algebra
checks the separate center-free construction.

Run `lake env lean scripts/CheckLieIII.lean` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open LieGroups
open scoped ContDiff Manifold

namespace LieIIICheck

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

def Heisenberg := ℝ × ℝ × ℝ

instance : LieRing Heisenberg where
  toAddCommGroup := inferInstanceAs (AddCommGroup (ℝ × ℝ × ℝ))
  bracket x y := (0, 0, x.1 * y.2.1 - x.2.1 * y.1)
  add_lie x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    change (x.1 + y.1) * z.2.1 - (x.2.1 + y.2.1) * z.1 =
      (x.1 * z.2.1 - x.2.1 * z.1) + (y.1 * z.2.1 - y.2.1 * z.1)
    ring
  lie_add x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    change x.1 * (y.2.1 + z.2.1) - x.2.1 * (y.1 + z.1) =
      (x.1 * y.2.1 - x.2.1 * y.1) + (x.1 * z.2.1 - x.2.1 * z.1)
    ring
  lie_self x := by
    apply Prod.ext
    · rfl
    apply Prod.ext
    · rfl
    change x.1 * x.2.1 - x.2.1 * x.1 = 0
    ring
  leibniz_lie x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    change x.1 * 0 - x.2.1 * 0 =
      (0 * z.2.1 - 0 * z.1) + (y.1 * 0 - y.2.1 * 0)
    ring

instance : LieAlgebra ℝ Heisenberg where
  toModule := inferInstanceAs (Module ℝ (ℝ × ℝ × ℝ))
  lie_smul t x y := by
    apply Prod.ext
    · change (0 : ℝ) = t * 0
      ring
    apply Prod.ext
    · change (0 : ℝ) = t * 0
      ring
    change x.1 * (t * y.2.1) - x.2.1 * (t * y.1) =
      t * (x.1 * y.2.1 - x.2.1 * y.1)
    ring

instance : FiniteDimensional ℝ Heisenberg :=
  inferInstanceAs (FiniteDimensional ℝ (ℝ × ℝ × ℝ))

theorem heisenberg_triple (x y z : Heisenberg) : ⁅x, ⁅y, z⁆⁆ = 0 := by
  apply Prod.ext
  · rfl
  apply Prod.ext
  · rfl
  change x.1 * 0 - x.2.1 * 0 = 0
  ring

def firstGenerator : Heisenberg := (1, 0, 0)
def secondGenerator : Heisenberg := (0, 1, 0)
def centralGenerator : Heisenberg := (0, 0, 1)

theorem heisenberg_bracket_nonzero : ⁅firstGenerator, secondGenerator⁆ ≠ 0 := by
  intro h
  have hc := congrArg (fun x : Heisenberg => x.2.2) h
  change (1 : ℝ) * 1 - 0 * 0 = 0 at hc
  norm_num at hc

example : ⁅firstGenerator, secondGenerator⁆ = centralGenerator := by
  change ((0 : ℝ), (0 : ℝ), (1 : ℝ) * 1 - 0 * 0) = (0, 0, 1)
  norm_num

example : Function.Injective (twoStepRepresentation heisenberg_triple) :=
  twoStepRepresentation_injective heisenberg_triple

example (x : Heisenberg) :
    (twoStepRepresentation heisenberg_triple x (1, 0)).2 = x :=
  twoStepRepresentation_apply_one_zero heisenberg_triple x

local instance : LieRing (Module.End ℝ (ℝ × Heisenberg)) := LieRing.ofAssociativeRing
local instance : LieAlgebra ℝ (Module.End ℝ (ℝ × Heisenberg)) :=
  LieAlgebra.ofAssociativeAlgebra

example (x y : Heisenberg) :
    twoStepRepresentation heisenberg_triple ⁅x, y⁆ =
      ⁅twoStepRepresentation heisenberg_triple x,
        twoStepRepresentation heisenberg_triple y⁆ := LieHom.map_lie _ x y

def heisenbergIntegration : LieAlgebraIntegration Heisenberg :=
  (nonempty_lieAlgebraIntegration_of_tripleLie_eq_zero heisenberg_triple).some

section
attribute [local instance] lieAlgebraNormedAddCommGroup lieAlgebraNormedSpace

example : Group heisenbergIntegration.Carrier := inferInstance
example : LieGroup 𝓘(ℝ, Heisenberg) ∞ heisenbergIntegration.Carrier := inferInstance
example : SimplyConnectedSpace heisenbergIntegration.Carrier := inferInstance
example : T2Space heisenbergIntegration.Carrier := inferInstance

example : Nonempty (GroupLieAlgebra 𝓘(ℝ, Heisenberg) heisenbergIntegration.Carrier
    ≃ₗ⁅ℝ⁆ Heisenberg) := ⟨heisenbergIntegration.lieEquiv⟩

example (x y : GroupLieAlgebra 𝓘(ℝ, Heisenberg) heisenbergIntegration.Carrier) :
    heisenbergIntegration.lieEquiv ⁅x, y⁆ =
      ⁅heisenbergIntegration.lieEquiv x, heisenbergIntegration.lieEquiv y⁆ :=
  LieEquiv.map_lie _ x y

end

def Affine := ℝ × ℝ

instance : LieRing Affine where
  toAddCommGroup := inferInstanceAs (AddCommGroup (ℝ × ℝ))
  bracket x y := (0, x.1 * y.2 - x.2 * y.1)
  add_lie x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    change (x.1 + y.1) * z.2 - (x.2 + y.2) * z.1 =
      (x.1 * z.2 - x.2 * z.1) + (y.1 * z.2 - y.2 * z.1)
    ring
  lie_add x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    change x.1 * (y.2 + z.2) - x.2 * (y.1 + z.1) =
      (x.1 * y.2 - x.2 * y.1) + (x.1 * z.2 - x.2 * z.1)
    ring
  lie_self x := by
    apply Prod.ext
    · rfl
    change x.1 * x.2 - x.2 * x.1 = 0
    ring
  leibniz_lie x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    change x.1 * (y.1 * z.2 - y.2 * z.1) - x.2 * 0 =
      (0 * z.2 - (x.1 * y.2 - x.2 * y.1) * z.1) +
        (y.1 * (x.1 * z.2 - x.2 * z.1) - y.2 * 0)
    ring

instance : LieAlgebra ℝ Affine where
  toModule := inferInstanceAs (Module ℝ (ℝ × ℝ))
  lie_smul t x y := by
    apply Prod.ext
    · change (0 : ℝ) = t * 0
      ring
    change x.1 * (t * y.2) - x.2 * (t * y.1) =
      t * (x.1 * y.2 - x.2 * y.1)
    ring

instance : FiniteDimensional ℝ Affine := inferInstanceAs (FiniteDimensional ℝ (ℝ × ℝ))

theorem affine_center_eq_bot : LieAlgebra.center ℝ Affine = ⊥ := by
  apply SetLike.ext
  intro x
  change (∀ y : Affine, ⁅y, x⁆ = 0) ↔ x = 0
  constructor
  · intro h
    have h₁ := congrArg (fun v : Affine => v.2) (h (1, 0))
    have h₂ := congrArg (fun v : Affine => v.2) (h (0, 1))
    change (1 : ℝ) * x.2 - 0 * x.1 = 0 at h₁
    change (0 : ℝ) * x.2 - 1 * x.1 = 0 at h₂
    apply Prod.ext
    · change x.1 = 0
      linarith
    · change x.2 = 0
      linarith
  · rintro rfl y
    exact lie_zero y

def affineDiagonal : Affine := (1, 0)
def affineTranslation : Affine := (0, 1)

theorem affine_bracket_nonzero : ⁅affineDiagonal, affineTranslation⁆ ≠ 0 := by
  intro h
  have hc := congrArg (fun x : Affine => x.2) h
  change (1 : ℝ) * 1 - 0 * 0 = 0 at hc
  norm_num at hc

def affineIntegration : LieAlgebraIntegration Affine :=
  (nonempty_lieAlgebraIntegration_of_center_eq_bot affine_center_eq_bot).some

section
attribute [local instance] lieAlgebraNormedAddCommGroup lieAlgebraNormedSpace

example : SimplyConnectedSpace affineIntegration.Carrier := inferInstance
example : LieGroup 𝓘(ℝ, Affine) ∞ affineIntegration.Carrier := inferInstance
example : Nonempty (GroupLieAlgebra 𝓘(ℝ, Affine) affineIntegration.Carrier
    ≃ₗ⁅ℝ⁆ Affine) := ⟨affineIntegration.lieEquiv⟩

end


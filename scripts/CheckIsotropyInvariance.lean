import LieGroups.IsotropyInnerProduct
import Mathlib.Tactic.Ring

/-!
# A nontrivial representation preserving a bilinear form

The real additive group acts on the plane by shears. Its infinitesimal action
preserves the standard alternating form; connectedness then gives global
preservation through the Stage 9 theorem. This checks a form with no positivity
or symmetry assumption and a genuinely nonconstant representation.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section

open LieGroups
open scoped ContDiff Manifold

namespace IsotropyInvarianceCheck

abbrev Line := Multiplicative ℝ
abbrev Plane := ℝ × ℝ

local instance : NormedAddCommGroup Line := inferInstanceAs (NormedAddCommGroup ℝ)
local instance : NormedSpace ℝ Line := inferInstanceAs (NormedSpace ℝ ℝ)
local instance : FiniteDimensional ℝ Line := inferInstanceAs (FiniteDimensional ℝ ℝ)
local instance : LieGroup 𝓘(ℝ, Line) ∞ Line where
  contMDiff_mul := by
    change ContMDiff _ _ ∞ (fun p : Line × Line => p.1 + p.2)
    exact contMDiff_fst.add contMDiff_snd
  contMDiff_inv := contDiff_neg.contMDiff

def shearGenerator : Plane →L[ℝ] Plane :=
  (ContinuousLinearMap.snd ℝ ℝ ℝ).prod 0

@[simp] theorem shearGenerator_apply (u : Plane) : shearGenerator u = (u.2, 0) := rfl

def shear : Line →* (Plane →L[ℝ] Plane) where
  toFun t := 1 + Multiplicative.toAdd t • shearGenerator
  map_one' := by change 1 + (0 : ℝ) • shearGenerator = 1; simp
  map_mul' s t := by
    apply ContinuousLinearMap.ext
    intro u
    apply Prod.ext <;>
      simp [shearGenerator, mul_apply_eq_comp, ContinuousLinearMap.prod_apply]
    ring

@[simp] theorem shear_apply (t : Line) (u : Plane) :
    shear t u = (u.1 + Multiplicative.toAdd t * u.2, u.2) := by
  apply Prod.ext <;> simp [shear, shearGenerator]

def alternatingForm : Plane →L[ℝ] Plane →L[ℝ] ℝ :=
  ((ContinuousLinearMap.fst ℝ ℝ ℝ).smulRight (ContinuousLinearMap.snd ℝ ℝ ℝ)) -
    ((ContinuousLinearMap.snd ℝ ℝ ℝ).smulRight (ContinuousLinearMap.fst ℝ ℝ ℝ))

@[simp] theorem alternatingForm_apply (u v : Plane) :
    alternatingForm u v = u.1 * v.2 - u.2 * v.1 := rfl

theorem shear_differentiable :
    MDifferentiable 𝓘(ℝ, Line) 𝓘(ℝ, Plane →L[ℝ] Plane) (fun t => shear t) := by
  let c : Line →L[ℝ] ℝ := ContinuousLinearMap.id ℝ ℝ
  have h : ContDiff ℝ ∞ (fun t : Line => (1 : Plane →L[ℝ] Plane) + c t • shearGenerator) :=
    contDiff_const.add (c.contDiff.smul contDiff_const)
  exact h.contMDiff.mdifferentiable (by simp)

theorem shear_differential (X : GroupLieAlgebra 𝓘(ℝ, Line) Line) :
    representationDifferential (I := 𝓘(ℝ, Line)) shear X =
      (Multiplicative.toAdd (X : Line) : ℝ) • shearGenerator := by
  unfold representationDifferential
  rw [mfderiv_eq_fderiv]
  let c : Line →L[ℝ] (Plane →L[ℝ] Plane) :=
    ContinuousLinearMap.toSpanSingleton ℝ shearGenerator
  change (fderiv ℝ (fun t : Line => 1 + c t) (0 : Line)) X = _
  rw [(c.hasFDerivAt.const_add 1).fderiv]
  rfl

theorem shear_infinitesimal_invariant
    (X : GroupLieAlgebra 𝓘(ℝ, Line) Line) (u v : Plane) :
    alternatingForm (representationDifferential shear X u) v +
      alternatingForm u (representationDifferential shear X v) = 0 := by
  rw [shear_differential]
  simp [alternatingForm, shearGenerator]
  ring

theorem shear_preserves_alternatingForm (t : Line) (u v : Plane) :
    alternatingForm (shear t u) (shear t v) = alternatingForm u v :=
  bilinear_representation_of_infinitesimal shear shear_differentiable alternatingForm
    shear_infinitesimal_invariant t u v

theorem shear_nontrivial : shear (Multiplicative.ofAdd 1) (0, 1) ≠ (0, 1) := by
  simp

#print axioms shear_preserves_alternatingForm

end IsotropyInvarianceCheck

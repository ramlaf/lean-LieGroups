import LieGroups.RepresentationIntegration
import Mathlib.Algebra.Algebra.Prod
import Mathlib.Algebra.Algebra.Tower
import Mathlib.Tactic.NormNum

/-!
# Integration from individually nonfaithful representations

The two coordinate characters of the abelian plane are individually
noninjective. Together they separate points and construct an actual simply
connected integrating group through the finite-family criterion.

Run `lake env lean scripts/CheckRepresentationSeparation.lean` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open LieGroups
open scoped ContDiff Manifold

namespace RepresentationSeparationCheck

attribute [local instance] LieRing.ofAssociativeRing

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

def Plane := ℝ × ℝ

instance : CommRing Plane := inferInstanceAs (CommRing (ℝ × ℝ))
instance : Algebra ℝ Plane := inferInstanceAs (Algebra ℝ (ℝ × ℝ))
instance : FiniteDimensional ℝ Plane := inferInstanceAs (FiniteDimensional ℝ (ℝ × ℝ))

/-- A one-dimensional module sees one coordinate of the abelian plane. -/
def coordinateRepresentation (b : Bool) : Plane →ₗ⁅ℝ⁆ Module.End ℝ ℝ :=
  ((Algebra.lsmul ℝ ℝ ℝ).comp
    (if b then AlgHom.snd ℝ ℝ ℝ else AlgHom.fst ℝ ℝ ℝ)).toLieHom

@[simp] theorem coordinateRepresentation_false_apply (x : Plane) (t : ℝ) :
    coordinateRepresentation false x t = x.1 * t := rfl

@[simp] theorem coordinateRepresentation_true_apply (x : Plane) (t : ℝ) :
    coordinateRepresentation true x t = x.2 * t := rfl

theorem coordinateRepresentation_false_not_injective :
    ¬Function.Injective (coordinateRepresentation false) := by
  intro h
  have he : coordinateRepresentation false ((0, 1) : Plane) =
      coordinateRepresentation false 0 := by
    apply LinearMap.ext
    intro t
    change (0 : ℝ) * t = 0 * t
    rfl
  have hc := congrArg Prod.snd (h he)
  change (1 : ℝ) = 0 at hc
  norm_num at hc

theorem coordinateRepresentation_true_not_injective :
    ¬Function.Injective (coordinateRepresentation true) := by
  intro h
  have he : coordinateRepresentation true ((1, 0) : Plane) =
      coordinateRepresentation true 0 := by
    apply LinearMap.ext
    intro t
    change (0 : ℝ) * t = 0 * t
    rfl
  have hc := congrArg Prod.fst (h he)
  change (1 : ℝ) = 0 at hc
  norm_num at hc

/-- Although neither coordinate representation is faithful, the family is. -/
theorem coordinateRepresentations_separate (x : Plane)
    (hx : ∀ b, coordinateRepresentation b x = 0) : x = 0 := by
  have h₁ := congrArg (fun f : Module.End ℝ ℝ => f 1) (hx false)
  have h₂ := congrArg (fun f : Module.End ℝ ℝ => f 1) (hx true)
  apply Prod.ext
  · change x.1 = 0
    simpa using h₁
  · change x.2 = 0
    simpa using h₂

example : ∃ s : Finset Bool,
    Function.Injective (finiteProductRepresentation s coordinateRepresentation) :=
  exists_faithful_finiteProductRepresentation coordinateRepresentation coordinateRepresentations_separate

def planeIntegration : LieAlgebraIntegration Plane :=
  (nonempty_lieAlgebraIntegration_of_separating_representations
    coordinateRepresentation coordinateRepresentations_separate).some

def planeIntegrationFromCenter : LieAlgebraIntegration Plane :=
  (nonempty_lieAlgebraIntegration_of_representations_separating_center
    coordinateRepresentation (fun x _ hx => coordinateRepresentations_separate x hx)).some

local instance : NormedAddCommGroup Plane := lieAlgebraNormedAddCommGroup Plane
local instance : NormedSpace ℝ Plane := lieAlgebraNormedSpace Plane

example : Group planeIntegration.Carrier := inferInstance
example : LieGroup 𝓘(ℝ, Plane) ∞ planeIntegration.Carrier := inferInstance
example : SimplyConnectedSpace planeIntegration.Carrier := inferInstance
example : T2Space planeIntegration.Carrier := inferInstance
example : Nonempty (GroupLieAlgebra 𝓘(ℝ, Plane) planeIntegration.Carrier ≃ₗ⁅ℝ⁆ Plane) :=
  ⟨planeIntegration.lieEquiv⟩

example : LieGroup 𝓘(ℝ, Plane) ∞ planeIntegrationFromCenter.Carrier := inferInstance
example : SimplyConnectedSpace planeIntegrationFromCenter.Carrier := inferInstance
example : T2Space planeIntegrationFromCenter.Carrier := inferInstance

/-- The same center-separation input also proves actual enveloping injectivity. -/
example : Function.Injective
    (UniversalEnvelopingAlgebra.ι ℝ : Plane → UniversalEnvelopingAlgebra ℝ Plane) := by
  obtain ⟨s, hs⟩ := exists_finite_separating_representations
    coordinateRepresentation coordinateRepresentations_separate
  apply universalEnveloping_ι_injective_of_separates_center
    (finiteProductRepresentation s coordinateRepresentation)
  intro x _ hx
  exact (finiteProductRepresentation_injective_of_separates s coordinateRepresentation hs)
    (hx.trans (map_zero _).symm)


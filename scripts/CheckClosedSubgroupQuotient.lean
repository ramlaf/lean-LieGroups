import LieGroups.ClosedLieSubgroup
import LieGroups.ClosedSubgroupQuotient
import Mathlib.Geometry.Manifold.Instances.UnitsOfNormedAlgebra

/-!
# Closed subgroups and a genuinely nonnormal homogeneous quotient

The stabilizer of the first coordinate vector in GL(2, ℝ) is closed, proper,
nontrivial, and nonnormal. Its embedded manifold and quotient are constructed
from closedness. This exercises nontrivial isotropy without a quotient group.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open LieGroups
open scoped ContDiff Manifold

noncomputable section

namespace ClosedSubgroupQuotientCheck

abbrev Plane := ℝ × ℝ
abbrev EndPlane := Plane →L[ℝ] Plane
abbrev GL₂ := EndPlaneˣ

def isotropy : Subgroup GL₂ := MulAction.stabilizer GL₂ ((1, 0) : Plane)

theorem isotropy_closed : IsClosed (isotropy : Set GL₂) := by
  change IsClosed {g : GL₂ | g • ((1, 0) : Plane) = (1, 0)}
  have h : ContMDiff 𝓘(ℝ, EndPlane) 𝓘(ℝ, Plane) ∞
      (fun g : GL₂ => g • ((1, 0) : Plane)) := contMDiff_id.smul contMDiff_const
  exact isClosed_eq h.continuous continuous_const

def flipSecond : GL₂ :=
  ((ContinuousLinearEquiv.refl ℝ ℝ).prodCongr (ContinuousLinearEquiv.neg ℝ)).toUnit

def swapAxes : GL₂ := (ContinuousLinearEquiv.prodComm ℝ ℝ ℝ).toUnit

theorem flipSecond_mem : flipSecond ∈ isotropy := by
  change ((1 : ℝ), -(0 : ℝ)) = (1, 0)
  simp

theorem swapAxes_not_mem : swapAxes ∉ isotropy := by
  change ¬ ((0 : ℝ), (1 : ℝ)) = (1, 0)
  simp

theorem isotropy_ne_top : isotropy ≠ ⊤ := by
  intro h
  exact swapAxes_not_mem (h.symm ▸ Subgroup.mem_top swapAxes)

theorem isotropy_ne_bot : isotropy ≠ ⊥ := by
  intro h
  have he : flipSecond = 1 := Subgroup.mem_bot.mp (h ▸ flipSecond_mem)
  have hv := congrArg (fun g : GL₂ => (g : EndPlane) ((0, 1) : Plane)) he
  change ((0 : ℝ), -(1 : ℝ)) = (0, 1) at hv
  have := congrArg Prod.snd hv
  norm_num at this

theorem isotropy_not_normal : ¬ isotropy.Normal := by
  intro h
  have hm := h.conj_mem flipSecond flipSecond_mem swapAxes
  change ((-(1 : ℝ)), (0 : ℝ)) = (1, 0) at hm
  have := congrArg Prod.fst hm
  norm_num at this

def closedIsotropy : ClosedLieSubgroup 𝓘(ℝ, EndPlane) isotropy :=
  Classical.choice (nonempty_closedLieSubgroup (I := 𝓘(ℝ, EndPlane)) isotropy isotropy_closed)

example : LieGroup 𝓘(ℝ, subgroupTangentModel (I := 𝓘(ℝ, EndPlane)) isotropy)
    ∞ closedIsotropy.Carrier := inferInstance

example : Topology.IsEmbedding closedIsotropy.inclusion := closedIsotropy.isEmbedding_inclusion

example : _root_.Manifold.IsImmersion
    𝓘(ℝ, subgroupTangentModel (I := 𝓘(ℝ, EndPlane)) isotropy) 𝓘(ℝ, EndPlane)
    ∞ closedIsotropy.inclusion := closedIsotropy.presentation.isImmersion

example : Nonempty (HomogeneousQuotient 𝓘(ℝ, EndPlane) GL₂ isotropy) :=
  nonempty_homogeneousQuotient_of_isClosed isotropy isotropy_closed

def quotient : HomogeneousQuotient 𝓘(ℝ, EndPlane) GL₂ isotropy :=
  Classical.choice (nonempty_homogeneousQuotient_of_isClosed isotropy isotropy_closed)

example : letI := quotient.chartedSpace
    _root_.Manifold.IsSubmersion 𝓘(ℝ, EndPlane) 𝓘(ℝ, quotient.model) ∞
      (QuotientGroup.mk : GL₂ → GL₂ ⧸ isotropy) := quotient.submersion

example : letI := quotient.chartedSpace
    ContMDiffSMul 𝓘(ℝ, EndPlane) 𝓘(ℝ, quotient.model) ∞ GL₂ (GL₂ ⧸ isotropy) :=
  quotient.smoothAction

example : T2Space (GL₂ ⧸ isotropy) := by
  let := isotropy_closed
  infer_instance

example : SecondCountableTopology (GL₂ ⧸ isotropy) := by
  let : SecondCountableTopology GL₂ :=
    Units.isOpenEmbedding_val.isEmbedding.secondCountableTopology
  infer_instance

example : letI := quotient.chartedSpace
    Manifold.HasContMDiffLocalSections 𝓘(ℝ, EndPlane) 𝓘(ℝ, quotient.model) ∞
      (QuotientGroup.mk : GL₂ → GL₂ ⧸ isotropy) := quotient.localSections

example (f : GL₂ ⧸ isotropy → ℝ) : letI := quotient.chartedSpace
    ContMDiff 𝓘(ℝ, quotient.model) 𝓘(ℝ, ℝ) ∞ f ↔
      ContMDiff 𝓘(ℝ, EndPlane) 𝓘(ℝ, ℝ) ∞ (f ∘ QuotientGroup.mk) :=
  quotient.contMDiff_iff_comp_projection

end ClosedSubgroupQuotientCheck

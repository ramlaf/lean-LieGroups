import LieGroups.LieII
import Mathlib.Geometry.Manifold.MFDeriv.FDeriv
import Mathlib.Analysis.Convex.Contractible

/-!
# Concrete checks for Lie's second theorem

The projection from the real plane to the real line has nontrivial kernel and
unequal source and target dimensions. Lie II constructs its integration from its
prescribed Lie-algebra map, and uniqueness identifies the result with the explicit
projection. A nonidentity scalar Lie equivalence checks the constructed smooth
group equivalence, its inverse, and its prescribed differential.

Run `lake env lean scripts/CheckLieII.lean` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open LieGroups
open scoped ContDiff Manifold

namespace LieIICheck
set_option backward.isDefEq.respectTransparency false

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

local instance {E : Type*} [NormedAddCommGroup E] :
    NormedAddCommGroup (Multiplicative E) := inferInstanceAs (NormedAddCommGroup E)
local instance {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] :
    NormedSpace ℝ (Multiplicative E) := inferInstanceAs (NormedSpace ℝ E)
local instance {E : Type*} [NormedAddCommGroup E] [CompleteSpace E] :
    CompleteSpace (Multiplicative E) := inferInstanceAs (CompleteSpace E)
local instance {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] : FiniteDimensional ℝ (Multiplicative E) :=
  inferInstanceAs (FiniteDimensional ℝ E)
local instance {E : Type*} [TopologicalSpace E] :
    ChartedSpace (Multiplicative E) (Multiplicative E) := chartedSpaceSelf _

local instance {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] :
    LieGroup 𝓘(ℝ, Multiplicative E) ∞ (Multiplicative E) where
  contMDiff_mul := by
    change ContMDiff _ _ ∞ (fun p : Multiplicative E × Multiplicative E => p.1 + p.2)
    exact contMDiff_fst.add contMDiff_snd
  contMDiff_inv := contDiff_neg.contMDiff

abbrev Line := Multiplicative ℝ
abbrev Plane := Multiplicative (ℝ × ℝ)
abbrev lineModel := 𝓘(ℝ, Line)
abbrev planeModel := 𝓘(ℝ, Plane)

example : SimplyConnectedSpace Plane := inferInstance
example : SimplyConnectedSpace Line := inferInstance

def projection : Plane →* Line :=
  (ContinuousLinearMap.fst ℝ ℝ ℝ).toLinearMap.toAddMonoidHom.toMultiplicative

theorem projection_smooth : ContMDiff planeModel lineModel ∞ projection :=
  (ContinuousLinearMap.fst ℝ ℝ ℝ).contDiff.contMDiff

def projectionLieHom : GroupLieAlgebra planeModel Plane →ₗ⁅ℝ⁆ GroupLieAlgebra lineModel Line :=
  homLieHom projection projection_smooth

theorem projectionLieHom_apply (v : GroupLieAlgebra planeModel Plane) :
    projectionLieHom v = v.toAdd.1 := by
  change homLieDifferential (I := planeModel) (J := lineModel) projection v = _
  unfold homLieDifferential
  rw [mfderiv_eq_fderiv]
  change (fderiv ℝ (ContinuousLinearMap.fst ℝ ℝ ℝ) (0 : ℝ × ℝ)) v = _
  rw [ContinuousLinearMap.fderiv]
  rfl

example : ¬ Function.Injective projectionLieHom := by
  intro hinj
  have he := hinj (show projectionLieHom (Multiplicative.ofAdd ((0 : ℝ), (1 : ℝ))) =
      projectionLieHom (Multiplicative.ofAdd ((0 : ℝ), (0 : ℝ))) by
    rw [projectionLieHom_apply, projectionLieHom_apply]
    rfl)
  have hz := congrArg (fun v : Plane => v.toAdd.2) he
  change (1 : ℝ) = 0 at hz
  norm_num at hz

-- Existence supplies the smooth map; no integration is an input.
def constructedProjection : LieHomomorphismIntegration projectionLieHom :=
  integrateLieHom projectionLieHom

example : ContMDiff planeModel lineModel ∞ constructedProjection.toMonoidHom :=
  constructedProjection.contMDiff

example (v : GroupLieAlgebra planeModel Plane) :
    homLieDifferential (I := planeModel) (J := lineModel)
      constructedProjection.toMonoidHom v = v.toAdd.1 := by
  have he := congrArg (fun q => q v) constructedProjection.homLieHom_eq
  exact he.trans (projectionLieHom_apply v)

theorem constructedProjection_eq : constructedProjection.toMonoidHom = projection :=
  hom_eq_of_homLieHom_eq constructedProjection.toMonoidHom projection
    constructedProjection.contMDiff projection_smooth constructedProjection.homLieHom_eq

example (x y : ℝ) : constructedProjection.toMonoidHom (Multiplicative.ofAdd (x, y)) = x := by
  rw [constructedProjection_eq]
  rfl

example : ∃! f : ContMDiffMonoidMorphism planeModel lineModel ∞ Plane Line,
    homLieHom f.toMonoidHom f.contMDiff_toFun = projectionLieHom :=
  existsUnique_smoothHom_of_lieHom projectionLieHom

-- Multiplication by two is a nonidentity equivalence of the additive real group.
def scaleEquiv : Line ≃* Line :=
  (LinearEquiv.smulOfNeZero ℝ ℝ 2 (by norm_num)).toAddEquiv.toMultiplicative

theorem scaleEquiv_smooth : ContMDiff lineModel lineModel ∞ scaleEquiv :=
  ((2 : ℝ) • ContinuousLinearMap.id ℝ ℝ).contDiff.contMDiff

theorem scaleEquiv_symm_smooth : ContMDiff lineModel lineModel ∞ scaleEquiv.symm :=
  ((2 : ℝ)⁻¹ • ContinuousLinearMap.id ℝ ℝ).contDiff.contMDiff

def scaleLieEquiv : GroupLieAlgebra lineModel Line ≃ₗ⁅ℝ⁆ GroupLieAlgebra lineModel Line :=
  equivLieEquiv scaleEquiv scaleEquiv_smooth scaleEquiv_symm_smooth

theorem scaleLieEquiv_apply (v : GroupLieAlgebra lineModel Line) :
    scaleLieEquiv v = (2 : ℝ) • v := by
  change homLieDifferential (I := lineModel) (J := lineModel) scaleEquiv.toMonoidHom v = _
  unfold homLieDifferential
  rw [mfderiv_eq_fderiv]
  change (fderiv ℝ ((2 : ℝ) • ContinuousLinearMap.id ℝ ℝ) (0 : ℝ)) v = _
  rw [ContinuousLinearMap.fderiv]
  rfl

def constructedScale : LieEquivalenceIntegration scaleLieEquiv :=
  integrateLieEquiv scaleLieEquiv

example : ContMDiff lineModel lineModel ∞ constructedScale.toMulEquiv :=
  constructedScale.contMDiff_toFun

example : ContMDiff lineModel lineModel ∞ constructedScale.toMulEquiv.symm :=
  constructedScale.contMDiff_invFun

example (v : GroupLieAlgebra lineModel Line) :
    homLieDifferential (I := lineModel) (J := lineModel)
      constructedScale.toMulEquiv.toMonoidHom v = (2 : ℝ) • v :=
  (constructedScale.homLieDifferential_apply v).trans (scaleLieEquiv_apply v)

theorem constructedScale_eq : constructedScale.toMulEquiv = scaleEquiv := by
  apply MulEquiv.toMonoidHom_injective
  exact hom_eq_of_homLieDifferential_eq
    constructedScale.toMulEquiv.toMonoidHom scaleEquiv.toMonoidHom
    constructedScale.contMDiff_toFun scaleEquiv_smooth
    (ContinuousLinearMap.ext fun v => constructedScale.homLieDifferential_apply v)

example (x : Line) : constructedScale.toMulEquiv x = Multiplicative.ofAdd ((2 : ℝ) * x.toAdd) := by
  rw [constructedScale_eq]
  rfl

example (x : Line) : constructedScale.toMulEquiv.symm x = Multiplicative.ofAdd ((2 : ℝ)⁻¹ * x.toAdd) := by
  rw [constructedScale_eq]
  rfl

end LieIICheck

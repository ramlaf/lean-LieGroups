local instance : LieGroup 𝓘(ℝ, Multiplicative ℝ) ∞ (Multiplicative ℝ) where
  contMDiff_mul := by
    change ContMDiff _ _ ∞ (fun p : Multiplicative ℝ × Multiplicative ℝ => p.1 + p.2)
    exact contMDiff_fst.add contMDiff_snd

set_option backward.isDefEq.respectTransparency false in
theorem oneParameterCurve_eq_smul (v : Multiplicative ℝ) (t : ℝ) :
    oneParameterCurve (I := 𝓘(ℝ, Multiplicative ℝ)) (G := Multiplicative ℝ) v t = t • v := by
  have h : IsMIntegralCurve (I := 𝓘(ℝ, Multiplicative ℝ))
      (fun t : ℝ => t • v) (mulInvariantVectorField (G := Multiplicative ℝ) v) := by
    intro s
    have hv : mulInvariantVectorField (I := 𝓘(ℝ, Multiplicative ℝ)) v (s • v) = v := by
      unfold mulInvariantVectorField
      rw [mfderiv_eq_fderiv]
      change (fderiv ℝ (fun x : Multiplicative ℝ => s • v + x) 0) v = v
      have hd : HasFDerivAt (fun x : Multiplicative ℝ => s • v + x)
          (ContinuousLinearMap.id ℝ (Multiplicative ℝ)) 0 :=
        (hasFDerivAt_id (𝕜 := ℝ) (0 : Multiplicative ℝ)).const_add (s • v)
      exact congrArg (fun f : Multiplicative ℝ →L[ℝ] Multiplicative ℝ => f v) hd.fderiv
    rw [hv]
    simpa only [id_eq, one_smul, ContinuousLinearMap.smulRight_one_eq_toSpanSingleton] using
      ((hasDerivAt_id s).smul_const v).hasFDerivAt.hasMFDerivAt
  exact (congrFun (oneParameterCurve_unique h (by simp; rfl)) t).symm


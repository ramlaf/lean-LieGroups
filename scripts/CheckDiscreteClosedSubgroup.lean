import LieGroups.ClosedSubgroupQuotient
import Mathlib.Analysis.Normed.Group.Uniform
import Mathlib.Topology.Connected.TotallyDisconnected

/-!
# The integer lattice as an ordinary closed subgroup

The subgroup `ℤ ⊆ ℝ` is closed, discrete, and not connected. The closed-subgroup
and homogeneous-quotient constructors below start with this ordinary subgroup;
no manifold structure on the integer lattice or its quotient is supplied.

Run `lake env lean scripts/CheckDiscreteClosedSubgroup.lean` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

open LieGroups
open scoped ContDiff Manifold

noncomputable section

namespace DiscreteClosedSubgroupCheck

local instance : NormedAddCommGroup (Multiplicative ℝ) :=
  inferInstanceAs (NormedAddCommGroup ℝ)
local instance : NormedSpace ℝ (Multiplicative ℝ) := inferInstanceAs (NormedSpace ℝ ℝ)
local instance : FiniteDimensional ℝ (Multiplicative ℝ) :=
  inferInstanceAs (FiniteDimensional ℝ ℝ)
local instance : ChartedSpace (Multiplicative ℝ) (Multiplicative ℝ) := chartedSpaceSelf _
local instance : LieGroup 𝓘(ℝ, Multiplicative ℝ) ∞ (Multiplicative ℝ) where
  contMDiff_mul := by
    change ContMDiff _ _ ∞ (fun p : Multiplicative ℝ × Multiplicative ℝ => p.1 + p.2)
    exact contMDiff_fst.add contMDiff_snd
  contMDiff_inv := contDiff_neg.contMDiff

abbrev realLineModel := 𝓘(ℝ, Multiplicative ℝ)

/-- The ordinary integer lattice in the additive real Lie group. -/
def integerLattice : Subgroup (Multiplicative ℝ) :=
  (Int.castAddHom ℝ).range.toSubgroup

theorem integerLattice_isClosed : IsClosed (integerLattice : Set (Multiplicative ℝ)) := by
  change IsClosed (Set.range ((↑) : ℤ → ℝ))
  exact Real.isClosed_range_intCast

/-- The inherited subgroup topology is discrete. -/
instance integerLattice_discrete : DiscreteTopology integerLattice := by
  let e := Real.isClosedEmbedding_intCast.isEmbedding.toHomeomorph
  exact e.symm.isEmbedding.discreteTopology

/-- This example has more than one connected component. -/
theorem integerLattice_not_preconnected : ¬ PreconnectedSpace integerLattice := by
  intro h
  let := h
  let : Subsingleton integerLattice := subsingleton_of_preconnected_totallyDisconnected
  let a : integerLattice := ⟨Multiplicative.ofAdd (0 : ℝ), ⟨0, by simp⟩⟩
  let b : integerLattice := ⟨Multiplicative.ofAdd (1 : ℝ), ⟨1, by simp⟩⟩
  have heq := Subsingleton.elim a b
  have hreal := congrArg (fun x : integerLattice => (x : Multiplicative ℝ).toAdd) heq
  norm_num [a, b] at hreal

theorem integerLattice_has_embedded_presentation :
    ∃ C : ClosedLieSubgroup realLineModel integerLattice,
      C.presentation.toImmersedLieSubgroup.subgroup = integerLattice := by
  obtain ⟨C⟩ := nonempty_closedLieSubgroup (I := realLineModel)
    integerLattice integerLattice_isClosed
  exact ⟨C, C.presentation_subgroup⟩

theorem integerLattice_has_smooth_quotient :
    Nonempty (HomogeneousQuotient realLineModel (Multiplicative ℝ) integerLattice) :=
  nonempty_homogeneousQuotient_of_isClosed integerLattice integerLattice_isClosed

/-- The construction supplies local sections and the actual isotropy kernel,
including for this disconnected closed subgroup. -/
theorem integerLattice_quotient_sections_and_kernel :
    ∃ Q : HomogeneousQuotient realLineModel (Multiplicative ℝ) integerLattice,
      letI := Q.chartedSpace
      LieGroups.Manifold.HasContMDiffLocalSections realLineModel 𝓘(ℝ, Q.model) ∞
          (QuotientGroup.mk : Multiplicative ℝ → Multiplicative ℝ ⧸ integerLattice) ∧
        (mfderiv realLineModel 𝓘(ℝ, Q.model)
          (QuotientGroup.mk : Multiplicative ℝ → Multiplicative ℝ ⧸ integerLattice) 1).ker =
            subgroupTangentSubmodule (I := realLineModel) integerLattice := by
  obtain ⟨Q, ⟨L⟩⟩ := exists_homogeneousQuotient_of_isClosed (I := realLineModel)
    integerLattice integerLattice_isClosed
  exact ⟨Q, Q.localSections,
    Q.ker_mfderiv_one_eq_subgroupTangentSubmodule integerLattice_isClosed L⟩

#print axioms integerLattice_has_embedded_presentation
#print axioms integerLattice_has_smooth_quotient
#print axioms integerLattice_quotient_sections_and_kernel

end DiscreteClosedSubgroupCheck

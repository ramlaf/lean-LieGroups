import LieGroups.HomogeneousMetricSmooth
import LieGroups.FundamentalVectorFieldKilling
import Mathlib.Geometry.Manifold.Algebra.LieGroup
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Positivity

/-!
# An invariant metric with nontrivial isotropy

The additive plane acts transitively on a line through its first coordinate.
The second coordinate fixes every point. The prescribed origin form is twice
the usual Euclidean inner product.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section

open LieGroups
open scoped ContDiff Manifold Topology
set_option backward.isDefEq.respectTransparency false

namespace HomogeneousMetricCheck

def Line := ℝ
abbrev ActingGroup := Multiplicative (ℝ × ℝ)

instance : NormedAddCommGroup Line := inferInstanceAs (NormedAddCommGroup ℝ)
instance : NormedSpace ℝ Line := inferInstanceAs (NormedSpace ℝ ℝ)
instance : FiniteDimensional ℝ Line := inferInstanceAs (FiniteDimensional ℝ ℝ)

local instance : NormedAddCommGroup ActingGroup :=
  inferInstanceAs (NormedAddCommGroup (ℝ × ℝ))
local instance : NormedSpace ℝ ActingGroup := inferInstanceAs (NormedSpace ℝ (ℝ × ℝ))
local instance : LieGroup 𝓘(ℝ, ActingGroup) ∞ ActingGroup where
  contMDiff_mul := by
    change ContMDiff _ _ ∞ (fun p : ActingGroup × ActingGroup => p.1 + p.2)
    exact contMDiff_fst.add contMDiff_snd
  contMDiff_inv := contDiff_neg.contMDiff

def firstCoordinate : ActingGroup →L[ℝ] Line := ContinuousLinearMap.fst ℝ ℝ ℝ

def realCoordinate : Line →L[ℝ] ℝ := ContinuousLinearMap.id ℝ ℝ

def sectionLinear : Line →L[ℝ] ActingGroup := ContinuousLinearMap.inl ℝ ℝ ℝ

def sectionMap (x : Line) : ActingGroup := sectionLinear x

@[simp]
theorem firstCoordinate_sectionMap (x : Line) : firstCoordinate (sectionMap x) = x := rfl

instance : MulAction ActingGroup Line where
  smul g x := firstCoordinate g + x
  one_smul x := by
    change firstCoordinate (0 : ActingGroup) + x = x
    rw [map_zero, zero_add]
  mul_smul g h x := by
    change firstCoordinate (g + h) + x = firstCoordinate g + (firstCoordinate h + x)
    rw [map_add, add_assoc]

instance : ContMDiffSMul 𝓘(ℝ, ActingGroup) 𝓘(ℝ, Line) ∞ ActingGroup Line where
  contMDiff_smul := by
    have h : ContMDiff 𝓘(ℝ, ActingGroup) 𝓘(ℝ, Line) ∞ firstCoordinate :=
      firstCoordinate.contDiff.contMDiff
    exact (h.comp contMDiff_fst).add contMDiff_snd

instance : MulAction.IsPretransitive ActingGroup Line where
  exists_smul_eq x y := ⟨sectionMap (y - x), by
    change firstCoordinate (sectionMap (y - x)) + x = y
    rw [firstCoordinate_sectionMap, sub_add_cancel]⟩

theorem sectionMap_smooth : ContMDiff 𝓘(ℝ, Line) 𝓘(ℝ, ActingGroup) ∞ sectionMap :=
  sectionLinear.contDiff.contMDiff

theorem sectionMap_smul (x : Line) : sectionMap x • (0 : Line) = x := by
  change firstCoordinate (sectionMap x) + 0 = x
  rw [firstCoordinate_sectionMap, add_zero]

theorem actionTangent_eq (g : ActingGroup) (x : Line) :
    actionTangent (J := 𝓘(ℝ, Line)) g x = ContinuousLinearMap.id ℝ Line := by
  unfold actionTangent
  rw [mfderiv_eq_fderiv]
  exact ((hasFDerivAt_id (𝕜 := ℝ) x).const_add (firstCoordinate g)).fderiv

def originForm : TangentSpace 𝓘(ℝ, Line) (0 : Line) →L[ℝ]
    TangentSpace 𝓘(ℝ, Line) (0 : Line) →L[ℝ] ℝ :=
  (2 : ℝ) • ContinuousLinearMap.mul ℝ ℝ

theorem originForm_apply (v w : Line) :
    originForm v w = 2 * realCoordinate v * realCoordinate w := by
  change 2 * (realCoordinate v * realCoordinate w) = _
  ring

theorem originForm_isotropyInvariant :
    IsIsotropyInvariant (G := ActingGroup) (J := 𝓘(ℝ, Line)) 0 originForm := by
  intro g hg v w
  rw [actionTangent_eq]
  rfl

theorem originForm_symmetric (v w : TangentSpace 𝓘(ℝ, Line) (0 : Line)) :
    originForm v w = originForm w v := by
  rw [originForm_apply, originForm_apply]
  ring

theorem originForm_positive (v : TangentSpace 𝓘(ℝ, Line) (0 : Line)) (hv : v ≠ 0) :
    0 < originForm v v := by
  rw [originForm_apply]
  have h : 0 < realCoordinate v ^ 2 := sq_pos_of_ne_zero hv
  nlinarith

theorem orbitMap_hasSmoothLocalSections :
    Manifold.HasContMDiffLocalSections 𝓘(ℝ, ActingGroup) 𝓘(ℝ, Line) ∞
      (fun g : ActingGroup => g • (0 : Line)) := by
  intro x
  exact ⟨sectionMap, sectionMap_smooth x,
    Filter.Eventually.of_forall sectionMap_smul⟩

def metric : DifferentialGeometry.SmoothRiemannianMetric 𝓘(ℝ, Line) Line :=
  homogeneousRiemannianMetric (I := 𝓘(ℝ, ActingGroup)) (G := ActingGroup)
    0 originForm originForm_isotropyInvariant originForm_symmetric originForm_positive
    orbitMap_hasSmoothLocalSections

theorem metric_origin (v w : Line) :
    metric.inner 0 v w = 2 * realCoordinate v * realCoordinate w := by
  exact (homogeneousRiemannianMetric_origin (I := 𝓘(ℝ, ActingGroup))
    0 originForm originForm_isotropyInvariant originForm_symmetric originForm_positive
    orbitMap_hasSmoothLocalSections v w).trans (originForm_apply v w)

theorem metric_invariant (g : ActingGroup) (x : Line) (v w : TangentSpace 𝓘(ℝ, Line) x) :
    metric.inner (g • x) v w = metric.inner x v w := by
  have h := homogeneousRiemannianMetric_invariant (I := 𝓘(ℝ, ActingGroup))
      0 originForm originForm_isotropyInvariant originForm_symmetric originForm_positive
      orbitMap_hasSmoothLocalSections g x v w
  rw [actionTangent_eq] at h
  exact h

theorem metric_value (x : Line) (v w : TangentSpace 𝓘(ℝ, Line) x) :
    metric.inner x v w = 2 * realCoordinate v * realCoordinate w := by
  have h := metric_invariant (sectionMap x) 0 v w
  rw [sectionMap_smul] at h
  exact h.trans (metric_origin v w)

def unitVector : Line := (1 : ℝ)

theorem norm_unitVector : ‖unitVector‖ = 1 := by
  change ‖(1 : ℝ)‖ = 1
  exact norm_one

theorem metric_unitVector : metric.inner 0 unitVector unitVector = 2 := by
  rw [metric_origin]
  change (2 : ℝ) * 1 * 1 = 2
  ring

/-- The metric construction retains the original norm and topology on the model. -/
theorem metric_differs_from_model_norm :
    metric.inner 0 unitVector unitVector ≠ ‖unitVector‖ ^ 2 := by
  rw [metric_unitVector, norm_unitVector]
  norm_num

theorem nontrivial_stabilizer :
    (Multiplicative.ofAdd (0, 1) : ActingGroup) ≠ 1 ∧
      ∀ x : Line, (Multiplicative.ofAdd (0, 1) : ActingGroup) • x = x := by
  constructor
  · intro h
    have := congrArg (fun g : ActingGroup => (Multiplicative.toAdd g).2) h
    norm_num at this
  · intro x
    change firstCoordinate (Multiplicative.ofAdd (0, 1)) + x = x
    exact zero_add x

/-- The infinitesimal action is the actual first-coordinate translation velocity. -/
theorem fundamentalVectorField_value
    (v : GroupLieAlgebra 𝓘(ℝ, ActingGroup) ActingGroup) (x : Line) :
    fundamentalVectorField (I := 𝓘(ℝ, ActingGroup)) (J := 𝓘(ℝ, Line)) v x =
      firstCoordinate v := by
  change (mfderiv 𝓘(ℝ, ActingGroup) 𝓘(ℝ, Line)
    (fun g : ActingGroup => firstCoordinate g + x) 1) v = firstCoordinate v
  rw [mfderiv_eq_fderiv]
  have h : HasFDerivAt (fun g : ActingGroup => firstCoordinate g + x) firstCoordinate 1 :=
    firstCoordinate.hasFDerivAt.add_const x
  rw [h.fderiv]
  rfl

def translationVelocity : GroupLieAlgebra 𝓘(ℝ, ActingGroup) ActingGroup :=
  sectionLinear unitVector

theorem translation_fundamental_nonzero (x : Line) :
    fundamentalVectorField (I := 𝓘(ℝ, ActingGroup)) (J := 𝓘(ℝ, Line))
      translationVelocity x ≠ 0 := by
  rw [fundamentalVectorField_value]
  change (1 : ℝ) ≠ 0
  exact one_ne_zero

/-- The metric constructed from the origin form satisfies the actual Killing equation
for every action velocity, including the nonzero translation direction. -/
theorem metric_fundamental_killing
    (v : GroupLieAlgebra 𝓘(ℝ, ActingGroup) ActingGroup) (x : Line)
    (u z : TangentSpace 𝓘(ℝ, Line) x) :
    DifferentialGeometry.PDE.DeTurck.lieDerivMetric metric
      (fundamentalVectorFieldSection (I := 𝓘(ℝ, ActingGroup)) v) x u z = 0 := by
  apply lieDerivMetric_fundamentalVectorField_eq_zero metric
  intro a y p q
  change metric.inner (a • y)
    (actionTangent (J := 𝓘(ℝ, Line)) a y p)
    (actionTangent (J := 𝓘(ℝ, Line)) a y q) = metric.inner y p q
  rw [actionTangent_eq]
  exact metric_invariant a y p q


import LieGroups.FundamentalVectorFieldBracket
import LieGroups.LinearLieAlgebra
import LieGroups.AdjointDifferential
import LieGroups.IsotropyRepresentation
import Mathlib.Tactic.NormNum

/-!
# Fundamental fields of the general linear group

The actual smooth general linear group acts on the plane by evaluation. Upper and lower
matrix units give noncommuting fundamental fields. Their vector-field bracket at the
first basis vector is the negative of their operator commutator, checking the sign.

Run `lake env lean scripts/CheckFundamentalVectorFields.lean` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-20.
-/

noncomputable section

open LieGroups
open scoped ContDiff Manifold

namespace FundamentalVectorFieldCheck

abbrev Plane := ℝ × ℝ
abbrev Operators := Plane →L[ℝ] Plane
abbrev GeneralLinear := Operatorsˣ
abbrev GroupModel := 𝓘(ℝ, Operators)
abbrev PlaneModel := 𝓘(ℝ, Plane)
abbrev Velocity := GroupLieAlgebra GroupModel GeneralLinear

attribute [local instance] LieRing.ofAssociativeRing
local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

example : LieGroup GroupModel ∞ GeneralLinear := inferInstance
example : ContMDiffSMul GroupModel PlaneModel ∞ GeneralLinear Plane := inferInstance

set_option backward.isDefEq.respectTransparency false in
theorem fundamental_eq_operator (v : Velocity) (x : Plane) :
    fundamentalVectorField (I := GroupModel) (J := PlaneModel) v x =
      unitsLieAlgebraEquiv v x := by
  let ev : Operators →L[ℝ] Plane := ContinuousLinearMap.apply ℝ Plane x
  have he : MDifferentiableAt 𝓘(ℝ, Operators) PlaneModel ev (1 : Operators) :=
    (ev.contDiff (n := ∞)).contMDiff.mdifferentiableAt (by simp)
  have hu : MDifferentiableAt GroupModel 𝓘(ℝ, Operators)
      (Units.val : GeneralLinear → Operators) 1 :=
    (Units.contMDiff_val (𝕜 := ℝ) (n := ∞)).mdifferentiableAt (by simp)
  have hcomp := mfderiv_comp (I := GroupModel) (I' := 𝓘(ℝ, Operators))
    (I'' := PlaneModel) (1 : GeneralLinear) he hu
  change mfderiv GroupModel PlaneModel (fun g : GeneralLinear => g • x) 1 v = _
  change mfderiv GroupModel PlaneModel
    ((ev : Operators → Plane) ∘ (Units.val : GeneralLinear → Operators)) 1 v = _
  rw [hcomp]
  change (mfderiv 𝓘(ℝ, Operators) PlaneModel ev (1 : Operators))
    (mfderiv GroupModel 𝓘(ℝ, Operators) Units.val 1 v) = _
  rw [mfderiv_eq_fderiv, ContinuousLinearMap.fderiv]
  have hcoords := congrArg (fun f : Velocity →L[ℝ] Operators => f v)
    (units_lieAlgebraModelEquiv_eq_mfderiv_val (A := Operators))
  change ev (mfderiv GroupModel 𝓘(ℝ, Operators) Units.val 1 v) =
    lieAlgebraModelEquiv v x
  exact congrArg (fun a : Operators => a x) hcoords.symm

def upper : Operators := (ContinuousLinearMap.snd ℝ ℝ ℝ).prod 0
def lower : Operators := (0 : Plane →L[ℝ] ℝ).prod (ContinuousLinearMap.fst ℝ ℝ ℝ)

@[simp] theorem upper_apply (x : Plane) : upper x = (x.2, 0) := rfl
@[simp] theorem lower_apply (x : Plane) : lower x = (0, x.1) := rfl

def upperVelocity : Velocity := unitsLieAlgebraEquiv.symm upper
def lowerVelocity : Velocity := unitsLieAlgebraEquiv.symm lower

@[simp] theorem upper_fundamental (x : Plane) :
    fundamentalVectorField (I := GroupModel) (J := PlaneModel) upperVelocity x =
      (x.2, 0) := by
  rw [fundamental_eq_operator]
  simp [upperVelocity]
  rfl

@[simp] theorem lower_fundamental (x : Plane) :
    fundamentalVectorField (I := GroupModel) (J := PlaneModel) lowerVelocity x =
      (0, x.1) := by
  rw [fundamental_eq_operator]
  simp [lowerVelocity]
  rfl

theorem upper_fundamental_nonzero :
    fundamentalVectorField (I := GroupModel) (J := PlaneModel) (M := Plane)
      upperVelocity ((0, 1) : Plane) ≠ 0 := by
  rw [upper_fundamental]
  intro h
  have hfirst := congrArg (fun y : Plane => y.1) h
  change (1 : ℝ) = 0 at hfirst
  norm_num at hfirst

theorem bracket_at_firstBasis :
    VectorField.mlieBracket PlaneModel
      (fundamentalVectorField (I := GroupModel) (J := PlaneModel) (M := Plane) upperVelocity)
      (fundamentalVectorField (I := GroupModel) (J := PlaneModel) (M := Plane) lowerVelocity)
      ((1, 0) : Plane) = ((-1 : ℝ), (0 : ℝ)) := by
  rw [mlieBracket_fundamentalVectorField, fundamental_eq_operator, LieEquiv.map_lie]
  simp only [upperVelocity, lowerVelocity, LieEquiv.apply_symm_apply]
  change -(upper (lower (1, 0)) - lower (upper (1, 0))) = ((-1 : ℝ), (0 : ℝ))
  simp

theorem bracket_nonzero :
    VectorField.mlieBracket PlaneModel
      (fundamentalVectorField (I := GroupModel) (J := PlaneModel) (M := Plane) upperVelocity)
      (fundamentalVectorField (I := GroupModel) (J := PlaneModel) (M := Plane) lowerVelocity)
      ((1, 0) : Plane) ≠ 0 := by
  rw [bracket_at_firstBasis]
  intro h
  have hfirst := congrArg (fun y : Plane => y.1) h
  change (-1 : ℝ) = 0 at hfirst
  norm_num at hfirst

/-- The actual tangent representation at the origin recovers the given GL action. -/
theorem fixedPoint_representation_eq (g : GeneralLinear) (v : Plane) :
    fixedPointTangentRepresentation (I := GroupModel) (J := PlaneModel)
      (0 : Plane) (fun h => smul_zero h) (ContinuousLinearEquiv.refl ℝ Plane) g v =
      g • v := by
  change mfderiv PlaneModel PlaneModel (fun x : Plane => g • x) 0 v = _
  change mfderiv PlaneModel PlaneModel (g : Operators) 0 v = _
  rw [mfderiv_eq_fderiv, ContinuousLinearMap.fderiv]
  rfl

/-- Conjugation has the positive commutator derivative, whereas the fundamental
field bracket above has its negative. The derivative is nonzero. -/
theorem adjoint_derivative_at_firstBasis :
    HasDerivAt (fun t => lieAlgebraModelEquiv
      (lieAdjoint (I := GroupModel) (oneParameterCurve upperVelocity t) lowerVelocity)
        ((1, 0) : Plane)) ((1, 0) : Plane) 0 := by
  have hinj : Function.Injective
      (homLieDifferential (I := GroupModel) (J := GroupModel)
        (MonoidHom.id GeneralLinear)) := by
    rw [homLieDifferential_id]
    exact Function.injective_id
  have h := hasDerivAt_lieAdjoint_oneParameterCurve_zero_of_faithful_differential
    (MonoidHom.id GeneralLinear) contMDiff_id hinj upperVelocity lowerVelocity
  have hv := h.clm_apply (hasDerivAt_const 0 ((1, 0) : Plane))
  have he : lieAlgebraModelEquiv ⁅upperVelocity, lowerVelocity⁆ = upper * lower - lower * upper := by
    change unitsLieAlgebraEquiv ⁅upperVelocity, lowerVelocity⁆ = _
    rw [LieEquiv.map_lie]
    simp only [upperVelocity, lowerVelocity, LieEquiv.apply_symm_apply, Ring.lie_def]
  simpa only [he, map_zero, add_zero, sub_apply,
    mul_apply_eq_comp, upper_apply, lower_apply, Prod.mk_sub_mk, sub_zero] using hv

example : ContMDiff PlaneModel PlaneModel.tangent ∞
    (fun x : Plane => (⟨x,
      fundamentalVectorField (I := GroupModel) (J := PlaneModel) upperVelocity x⟩ :
      TangentBundle PlaneModel Plane)) :=
  contMDiff_fundamentalVectorField upperVelocity

example (x : Plane) :
    HasMFDerivAt 𝓘(ℝ, ℝ) PlaneModel (fun t => oneParameterCurve upperVelocity t • x) 0
      ((1 : ℝ →L[ℝ] ℝ).smulRight ((x.2, 0) : Plane)) := by
  simpa only [upper_fundamental] using
    hasMFDerivAt_oneParameterCurve_smul_zero (J := PlaneModel) upperVelocity x

#print axioms fundamental_eq_operator
#print axioms upper_fundamental_nonzero
#print axioms bracket_at_firstBasis
#print axioms bracket_nonzero
#print axioms fixedPoint_representation_eq
#print axioms adjoint_derivative_at_firstBasis

end FundamentalVectorFieldCheck

import LieGroups.RepresentationIntegration
import LieGroups.Algebra.AbelianizationRepresentation
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith

/-!
# Integration beyond the center-free and two-step cases

The direct sum of the two-dimensional affine Lie algebra and a central line
has nontrivial center and a nonzero triple bracket. Its center is disjoint from
its derived ideal, so the adjoint and abelianization representation constructs
an actual simply connected integrating group.

Run `lake env lean scripts/CheckAbelianizationIntegration.lean` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open LieGroups
open scoped Manifold ContDiff

namespace AbelianizationIntegrationCheck

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

def AffineCentral := ℝ × ℝ × ℝ

instance : LieRing AffineCentral where
  toAddCommGroup := inferInstanceAs (AddCommGroup (ℝ × ℝ × ℝ))
  bracket x y := (0, x.1 * y.2.1 - x.2.1 * y.1, 0)
  add_lie x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change (x.1 + y.1) * z.2.1 - (x.2.1 + y.2.1) * z.1 =
        (x.1 * z.2.1 - x.2.1 * z.1) + (y.1 * z.2.1 - y.2.1 * z.1)
      ring
    · change (0 : ℝ) = 0 + 0
      ring
  lie_add x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change x.1 * (y.2.1 + z.2.1) - x.2.1 * (y.1 + z.1) =
        (x.1 * y.2.1 - x.2.1 * y.1) + (x.1 * z.2.1 - x.2.1 * z.1)
      ring
    · change (0 : ℝ) = 0 + 0
      ring
  lie_self x := by
    apply Prod.ext
    · rfl
    apply Prod.ext
    · change x.1 * x.2.1 - x.2.1 * x.1 = 0
      ring
    · rfl
  leibniz_lie x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change x.1 * (y.1 * z.2.1 - y.2.1 * z.1) - x.2.1 * 0 =
        (0 * z.2.1 - (x.1 * y.2.1 - x.2.1 * y.1) * z.1) +
          (y.1 * (x.1 * z.2.1 - x.2.1 * z.1) - y.2.1 * 0)
      ring
    · change (0 : ℝ) = 0 + 0
      ring

instance : LieAlgebra ℝ AffineCentral where
  toModule := inferInstanceAs (Module ℝ (ℝ × ℝ × ℝ))
  lie_smul t x y := by
    apply Prod.ext
    · change (0 : ℝ) = t * 0
      ring
    apply Prod.ext
    · change x.1 * (t * y.2.1) - x.2.1 * (t * y.1) =
        t * (x.1 * y.2.1 - x.2.1 * y.1)
      ring
    · change (0 : ℝ) = t * 0
      ring

instance : FiniteDimensional ℝ AffineCentral :=
  inferInstanceAs (FiniteDimensional ℝ (ℝ × ℝ × ℝ))

def diagonal : AffineCentral := (1, 0, 0)
def translation : AffineCentral := (0, 1, 0)
def central : AffineCentral := (0, 0, 1)

theorem central_mem : central ∈ LieAlgebra.center ℝ AffineCentral := by
  change ∀ y : AffineCentral, ⁅y, central⁆ = 0
  intro y
  apply Prod.ext
  · rfl
  apply Prod.ext
  · change y.1 * 0 - y.2.1 * 0 = 0
    ring
  · rfl

theorem central_ne_zero : central ≠ 0 := by
  intro h
  have hc := congrArg (fun x : AffineCentral => x.2.2) h
  change (1 : ℝ) = 0 at hc
  norm_num at hc

theorem center_ne_bot : LieAlgebra.center ℝ AffineCentral ≠ ⊥ := by
  intro h
  apply central_ne_zero
  have hm := central_mem
  rw [h] at hm
  exact (LieSubmodule.mem_bot _).mp hm

theorem triple_bracket_nonzero : ⁅diagonal, ⁅diagonal, translation⁆⁆ ≠ 0 := by
  intro h
  have hc := congrArg (fun x : AffineCentral => x.2.1) h
  change (1 : ℝ) * (1 * 1 - 0 * 0) - 0 * 0 = 0 at hc
  norm_num at hc

private def translationSubmodule : Submodule ℝ AffineCentral where
  carrier := {x | x.1 = 0 ∧ x.2.2 = 0}
  zero_mem' := ⟨rfl, rfl⟩
  add_mem' {x y} hx hy := by
    change x.1 + y.1 = 0 ∧ x.2.2 + y.2.2 = 0
    simp only [hx.1, hx.2, hy.1, hy.2, add_zero, and_self]
  smul_mem' t {x} hx := by
    change t * x.1 = 0 ∧ t * x.2.2 = 0
    simp only [hx.1, hx.2, mul_zero, and_self]

private theorem derived_coordinates {x : AffineCentral}
    (hx : x ∈ LieAlgebra.derivedSeries ℝ AffineCentral 1) : x.1 = 0 ∧ x.2.2 = 0 := by
  have h : (LieAlgebra.derivedSeries ℝ AffineCentral 1).toSubmodule ≤ translationSubmodule := by
    change (LieAlgebra.derivedSeries ℝ AffineCentral 1).toLieSubalgebra.toSubmodule ≤ _
    rw [LieAlgebra.coe_derivedSeries_one_eq]
    apply Submodule.span_le.mpr
    rintro _ ⟨y, z, rfl⟩
    exact ⟨rfl, rfl⟩
  exact h hx

private theorem center_coordinates {x : AffineCentral}
    (hx : x ∈ LieAlgebra.center ℝ AffineCentral) : x.1 = 0 ∧ x.2.1 = 0 := by
  change ∀ y : AffineCentral, ⁅y, x⁆ = 0 at hx
  have hb := congrArg (fun v : AffineCentral => v.2.1) (hx diagonal)
  have ha := congrArg (fun v : AffineCentral => v.2.1) (hx translation)
  change (1 : ℝ) * x.2.1 - 0 * x.1 = 0 at hb
  change (0 : ℝ) * x.2.1 - 1 * x.1 = 0 at ha
  constructor <;> linarith

theorem center_disjoint_derived : Disjoint (LieAlgebra.center ℝ AffineCentral)
    (LieAlgebra.derivedSeries ℝ AffineCentral 1) := by
  apply disjoint_iff.mpr
  ext x
  change (x ∈ LieAlgebra.center ℝ AffineCentral ∧
    x ∈ LieAlgebra.derivedSeries ℝ AffineCentral 1) ↔ x = 0
  constructor
  · rintro ⟨hc, hd⟩
    obtain ⟨ha, hb⟩ := center_coordinates hc
    obtain ⟨_, hz⟩ := derived_coordinates hd
    apply Prod.ext
    · exact ha
    apply Prod.ext
    · exact hb
    · exact hz
  · rintro rfl
    exact ⟨zero_mem _, zero_mem _⟩

example : Function.Injective (adjointAbelianizationRepresentation ℝ AffineCentral) :=
  adjointAbelianizationRepresentation_injective ℝ AffineCentral center_disjoint_derived

def affineCentralIntegration : LieAlgebraIntegration AffineCentral :=
  (nonempty_lieAlgebraIntegration_of_disjoint_center_derived center_disjoint_derived).some

section
attribute [local instance] lieAlgebraNormedAddCommGroup lieAlgebraNormedSpace

example : LieGroup 𝓘(ℝ, AffineCentral) ∞ affineCentralIntegration.Carrier := inferInstance
example : SimplyConnectedSpace affineCentralIntegration.Carrier := inferInstance
example : T2Space affineCentralIntegration.Carrier := inferInstance
example : Nonempty (GroupLieAlgebra 𝓘(ℝ, AffineCentral) affineCentralIntegration.Carrier
    ≃ₗ⁅ℝ⁆ AffineCentral) := ⟨affineCentralIntegration.lieEquiv⟩

end

#print axioms center_ne_bot
#print axioms triple_bracket_nonzero
#print axioms center_disjoint_derived
#print axioms affineCentralIntegration

end AbelianizationIntegrationCheck

import LieGroups.RepresentationIntegration
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith

/-!
# A three-step nonabelian integration from a nonsingular derivation

The four-dimensional Engel Lie algebra is supplied only as a vector space with
bracket. Its grading derivation is nonsingular, so the affine representation
constructs a simply connected integrating group. A nonzero triple bracket proves
this example lies beyond the two-step construction; all quadruple brackets vanish.

Run `lake env lean scripts/CheckAffineIntegration.lean` after `lake build`.

AI-assistance disclosure: generated by OpenAI Codex on 2026-10-19.
-/

noncomputable section
open LieGroups
open scoped ContDiff Manifold

namespace AffineIntegrationCheck

local instance : ENat.LEInfty (minSmoothness ℝ 3) := ⟨by simp⟩

def Engel := ℝ × ℝ × ℝ × ℝ

instance : LieRing Engel where
  toAddCommGroup := inferInstanceAs (AddCommGroup (ℝ × ℝ × ℝ × ℝ))
  bracket x y := (0, 0, x.1 * y.2.1 - x.2.1 * y.1,
    x.1 * y.2.2.1 - x.2.2.1 * y.1)
  add_lie x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change (x.1 + y.1) * z.2.1 - (x.2.1 + y.2.1) * z.1 =
        (x.1 * z.2.1 - x.2.1 * z.1) + (y.1 * z.2.1 - y.2.1 * z.1)
      ring
    change (x.1 + y.1) * z.2.2.1 - (x.2.2.1 + y.2.2.1) * z.1 =
      (x.1 * z.2.2.1 - x.2.2.1 * z.1) + (y.1 * z.2.2.1 - y.2.2.1 * z.1)
    ring
  lie_add x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change x.1 * (y.2.1 + z.2.1) - x.2.1 * (y.1 + z.1) =
        (x.1 * y.2.1 - x.2.1 * y.1) + (x.1 * z.2.1 - x.2.1 * z.1)
      ring
    change x.1 * (y.2.2.1 + z.2.2.1) - x.2.2.1 * (y.1 + z.1) =
      (x.1 * y.2.2.1 - x.2.2.1 * y.1) + (x.1 * z.2.2.1 - x.2.2.1 * z.1)
    ring
  lie_self x := by
    apply Prod.ext
    · rfl
    apply Prod.ext
    · rfl
    apply Prod.ext
    · change x.1 * x.2.1 - x.2.1 * x.1 = 0
      ring
    change x.1 * x.2.2.1 - x.2.2.1 * x.1 = 0
    ring
  leibniz_lie x y z := by
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change (0 : ℝ) = 0 + 0
      ring
    apply Prod.ext
    · change x.1 * 0 - x.2.1 * 0 =
        (0 * z.2.1 - 0 * z.1) + (y.1 * 0 - y.2.1 * 0)
      ring
    change x.1 * (y.1 * z.2.1 - y.2.1 * z.1) - x.2.2.1 * 0 =
      (0 * z.2.2.1 - (x.1 * y.2.1 - x.2.1 * y.1) * z.1) +
        (y.1 * (x.1 * z.2.1 - x.2.1 * z.1) - y.2.2.1 * 0)
    ring

instance : LieAlgebra ℝ Engel where
  toModule := inferInstanceAs (Module ℝ (ℝ × ℝ × ℝ × ℝ))
  lie_smul t x y := by
    apply Prod.ext
    · change (0 : ℝ) = t * 0
      ring
    apply Prod.ext
    · change (0 : ℝ) = t * 0
      ring
    apply Prod.ext
    · change x.1 * (t * y.2.1) - x.2.1 * (t * y.1) =
        t * (x.1 * y.2.1 - x.2.1 * y.1)
      ring
    change x.1 * (t * y.2.2.1) - x.2.2.1 * (t * y.1) =
      t * (x.1 * y.2.2.1 - x.2.2.1 * y.1)
    ring

instance : FiniteDimensional ℝ Engel :=
  inferInstanceAs (FiniteDimensional ℝ (ℝ × ℝ × ℝ × ℝ))

def grading : LieDerivation ℝ Engel Engel where
  toLinearMap := {
    toFun x := (x.1, x.2.1, 2 * x.2.2.1, 3 * x.2.2.2)
    map_add' x y := by
      apply Prod.ext
      · rfl
      apply Prod.ext
      · rfl
      apply Prod.ext
      · change 2 * (x.2.2.1 + y.2.2.1) = 2 * x.2.2.1 + 2 * y.2.2.1
        ring
      change 3 * (x.2.2.2 + y.2.2.2) = 3 * x.2.2.2 + 3 * y.2.2.2
      ring
    map_smul' t x := by
      apply Prod.ext
      · rfl
      apply Prod.ext
      · rfl
      apply Prod.ext
      · change 2 * (t * x.2.2.1) = t * (2 * x.2.2.1)
        ring
      change 3 * (t * x.2.2.2) = t * (3 * x.2.2.2)
      ring }
  leibniz' x y := by
    apply Prod.ext
    · change (0 : ℝ) = 0 - 0
      ring
    apply Prod.ext
    · change (0 : ℝ) = 0 - 0
      ring
    apply Prod.ext
    · change 2 * (x.1 * y.2.1 - x.2.1 * y.1) =
        (x.1 * y.2.1 - x.2.1 * y.1) - (y.1 * x.2.1 - y.2.1 * x.1)
      ring
    change 3 * (x.1 * y.2.2.1 - x.2.2.1 * y.1) =
      (x.1 * (2 * y.2.2.1) - x.2.2.1 * y.1) -
        (y.1 * (2 * x.2.2.1) - y.2.2.1 * x.1)
    ring

theorem grading_injective : Function.Injective grading := by
  intro x y h
  have h₁ := congrArg (fun v : Engel => v.1) h
  have h₂ := congrArg (fun v : Engel => v.2.1) h
  have h₃ := congrArg (fun v : Engel => v.2.2.1) h
  have h₄ := congrArg (fun v : Engel => v.2.2.2) h
  change x.1 = y.1 at h₁
  change x.2.1 = y.2.1 at h₂
  change (2 : ℝ) * x.2.2.1 = 2 * y.2.2.1 at h₃
  change (3 : ℝ) * x.2.2.2 = 3 * y.2.2.2 at h₄
  apply Prod.ext h₁
  apply Prod.ext h₂
  apply Prod.ext
  · linarith
  · linarith

def firstGenerator : Engel := (1, 0, 0, 0)
def secondGenerator : Engel := (0, 1, 0, 0)
def lastGenerator : Engel := (0, 0, 0, 1)

theorem triple_eq_last : ⁅firstGenerator, ⁅firstGenerator, secondGenerator⁆⁆ = lastGenerator := by
  apply Prod.ext
  · rfl
  apply Prod.ext
  · rfl
  apply Prod.ext
  · change (1 : ℝ) * 0 - 0 * 0 = 0
    norm_num
  change (1 : ℝ) * (1 * 1 - 0 * 0) - 0 * 0 = 1
  norm_num

theorem triple_ne_zero : ⁅firstGenerator, ⁅firstGenerator, secondGenerator⁆⁆ ≠ 0 := by
  rw [triple_eq_last]
  intro h
  have hc := congrArg (fun v : Engel => v.2.2.2) h
  change (1 : ℝ) = 0 at hc
  norm_num at hc

theorem quadruple_eq_zero (w x y z : Engel) : ⁅w, ⁅x, ⁅y, z⁆⁆⁆ = 0 := by
  apply Prod.ext
  · rfl
  apply Prod.ext
  · rfl
  apply Prod.ext
  · change w.1 * 0 - w.2.1 * 0 = 0
    ring
  change w.1 * (x.1 * 0 - x.2.1 * 0) - w.2.2.1 * 0 = 0
  ring

example : Function.Injective (derivationAffineRepresentation grading) :=
  derivationAffineRepresentation_injective grading grading_injective

example (x : Engel) : (derivationAffineRepresentation grading x (1, 0)).2 = grading x :=
  derivationAffineRepresentation_apply_one_zero grading x

def engelIntegration : LieAlgebraIntegration Engel :=
  (nonempty_lieAlgebraIntegration_of_injective_derivation grading grading_injective).some

section
attribute [local instance] lieAlgebraNormedAddCommGroup lieAlgebraNormedSpace

example : Group engelIntegration.Carrier := inferInstance
example : LieGroup 𝓘(ℝ, Engel) ∞ engelIntegration.Carrier := inferInstance
example : IsManifold 𝓘(ℝ, Engel) ∞ engelIntegration.Carrier := inferInstance
example : SimplyConnectedSpace engelIntegration.Carrier := inferInstance
example : T2Space engelIntegration.Carrier := inferInstance
example : Nonempty (GroupLieAlgebra 𝓘(ℝ, Engel) engelIntegration.Carrier ≃ₗ⁅ℝ⁆ Engel) :=
  ⟨engelIntegration.lieEquiv⟩

example (x y : GroupLieAlgebra 𝓘(ℝ, Engel) engelIntegration.Carrier) :
    engelIntegration.lieEquiv ⁅x, y⁆ =
      ⁅engelIntegration.lieEquiv x, engelIntegration.lieEquiv y⁆ := LieEquiv.map_lie _ x y

end

#print axioms grading_injective
#print axioms triple_ne_zero
#print axioms engelIntegration

end AffineIntegrationCheck

import BFRF.HomomorphismLieAlgebra

/-!
# BFRF integration compatibility checks and axiom audit

Run `python3 scripts/check_bfrf_compatibility.py` after `lake build`.
This imports BFRF's actual integration structures through the optional adapter;
it does not introduce a BFRF dependency into the core LieGroups library.

The examples deliberately add no Hausdorff hypotheses to the supplied integrated groups.
AI-assistance disclosure: generated by OpenAI Codex on 2026-10-16.
-/

open BFRF.Homogeneous
open scoped Manifold ContDiff

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E]
  {μ ν : BFRF.Bracket E} {hμ : μ.Jacobi} {hν : ν.Jacobi}
  {A : IntegratedLieGroup μ hμ} {B : IntegratedLieGroup ν hν}

-- The reusable differential is exactly the one in the downstream record.
example (Φ : SmoothGroupEquiv A B) (v : GroupLieAlgebra 𝓘(ℝ, E) A.G) :
    (IntegratedLieEquiv.ofSmoothGroupEquiv Φ).groupEquiv.derivAtOne v =
      LieGroups.homLieDifferential (I := 𝓘(ℝ, E)) (J := 𝓘(ℝ, E))
        Φ.toMulEquiv.toMonoidHom v := by
  exact congrArg (fun T => T v) Φ.derivAtOne_eq_homLieDifferential

-- Existing integration data can be reconstructed with the same group map.
example {e : BracketLie μ hμ ≃ₗ⁅ℝ⁆ BracketLie ν hν}
    (Φ : IntegratedLieEquiv A B e) :
    (IntegratedLieEquiv.ofInducedLieEquivEq Φ.groupEquiv e Φ.inducedLieEquiv_eq).groupEquiv =
      Φ.groupEquiv := rfl

-- This also supplies the actual prescribed-transport interface, once identified.
example (h : E ≃ₗ[ℝ] E)
    {B : IntegratedLieGroup (BFRF.Bracket.transport h μ) (hμ.transport h)}
    (Φ : SmoothGroupEquiv A B)
    (he : Φ.inducedLieEquiv = transportLieEquiv μ hμ h) :
    IntegratedTransport μ hμ h A B :=
  IntegratedLieEquiv.ofInducedLieEquivEq Φ (transportLieEquiv μ hμ h) he


    map_smul' := by intros; ext <;> simp }

def lower : A :=
  { toFun := fun v => (0, v.1)
    map_add' := by intros; ext <;> simp
    map_smul' := by intros; ext <;> simp }

theorem bracket_nonzero : ⁅upper, lower⁆ ≠ 0 := by
  intro h
  have hc := congrArg (fun f : A => (f (1, 0)).1) h
  norm_num [LieRing.of_associative_ring_bracket, upper, lower] at hc

example : Module.Basis (PBWOrderedWord (Fin (Module.finrank ℝ A))) ℝ

theorem enveloping_bracket_nonzero :
    ⁅UniversalEnvelopingAlgebra.ι ℝ upper, UniversalEnvelopingAlgebra.ι ℝ lower⁆ ≠ 0 := by
  rw [← LieHom.map_lie]
  intro h
  exact bracket_nonzero (universalEnveloping_ι_injective_finiteDimensional
